# opencode auth as a single-line JSON object. Alternative: put auth.json into
# ./.opencode/auth.json (the directory is bind-mounted into the containers).
# Example: {"deepseek":{"type":"api","key":"sk-..."}}
OPENCODE_AUTH_JSON=

# Optional custom opencode config (single-line JSON), e.g. a custom provider.
OPENCODE_CONFIG_JSON=

# Docker image targets:
#   swarm / tools         full MLE-bench stack (default, several GB)
#   swarm-min / tools-min light stack for the offline toy example
SWARM_TARGET=swarm
SWARM_TOOLS_TARGET=tools

# Container UID/GID. Defaults are 1000; set to `id -u` / `id -g` if different.
# SWARM_UID=1000
# SWARM_GID=1000

# Optional image overrides. Normally derived from the targets above.
# SWARM_IMAGE=blackboard-sisyphus-swarm:swarm
# SWARM_TOOLS_IMAGE=blackboard-sisyphus-tools:tools

# Runtime defaults (can also be passed to bin/cli/swarm.sh up).
# Article profile: 3 agents, 12 h, 1x A100, 96 GiB RAM, 32 CPU.
# For the offline toy demo set SWARM_GPU_COUNT=0.
SWARM_TZ=UTC
SWARM_AGENTS=3
SWARM_HOURS=12
SWARM_MODEL=deepseek/deepseek-flash
SWARM_GPU_COUNT=1
SWARM_CPUS=32
SWARM_MEM_LIMIT=96g
SWARM_SHM=8g
SWARM_BOARD_INTERVAL=300
SWARM_AUTO_SAVE=1

# Kaggle credentials for `bin/cli/prepare_data.sh install -c <real-task>`.
# Alternative: put kaggle.json into ./.kaggle/kaggle.json.
KAGGLE_USERNAME=
KAGGLE_KEY=
