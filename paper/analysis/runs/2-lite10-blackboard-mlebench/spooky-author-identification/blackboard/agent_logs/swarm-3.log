        if not dup: keep.append(k)
    P=np.concatenate([allm[n][0] for n in keep],1); PT=np.concatenate([allm[n][1] for n in keep],1)
    X=np.hstack([np.log(P),P]); XT=np.hstack([np.log(PT),PT])
