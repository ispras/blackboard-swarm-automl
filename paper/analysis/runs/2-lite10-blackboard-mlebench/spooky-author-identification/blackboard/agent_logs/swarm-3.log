import numpy as np, pandas as pd, os, glob, warnings, json
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from xgboost import XGBClassifier
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'; OUT=f'{ROOT}/workspaces/mirfak_pi'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y)
EXCL=('partial','stack','blend','candidate','nested','meta','opt','final')
models={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name for e in EXCL): continue
        p=np.load(f)
        if p.shape!=(N,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True)
        models[f'{ws[:2]}:{name}']=p
sc={k:log_loss(y,v,labels=[0,1,2]) for k,v in models.items()}
models={k:v for k,v in models.items() if sc[k]<=0.75}
names=sorted(models,key=lambda k:sc[k]); keep=[]
for k in names:
    lk=np.log(models[k]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(models[j]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep
tf=[n for n in names if any(s in n for s in ['dbl','deberta','roberta','xlnet','bilstm','bert','electra'])]
others=[n for n in names if n not in tf]
print('n',len(names),'tf',len(tf),flush=True)
def lr_cv(sub,C):
    X=np.concatenate([np.log(models[n]) for n in sub],1)
    P=np.concatenate([models[n] for n in sub],1); X=np.hstack([X,P])
    o=np.zeros((N,3))
    for k in range(5):
        itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
        o[iva]=LogisticRegression(C=C,max_iter=4000).fit(X[itr],y[itr]).predict_proba(X[iva])
    return log_loss(y,o,labels=[0,1,2])
for K in [10,15,20,25,30,40,55]:
    sub=tf+sorted(others,key=lambda k:sc[k])[:max(0,K-len(tf))]
    sub=list(dict.fromkeys(sub))
    res=[(round(lr_cv(sub,C),5),C) for C in [0.05,0.1,0.2]]
    print('K',K,'nsub',len(sub),'best',min(res),flush=True)
# all tf only
print('tf only',[(round(lr_cv(tf,C),5),C) for C in [0.05,0.1,0.2]],flush=True)
