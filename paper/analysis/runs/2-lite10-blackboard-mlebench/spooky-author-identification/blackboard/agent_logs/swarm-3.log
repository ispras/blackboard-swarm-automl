import numpy as np, pandas as pd, os, glob, warnings, re, json
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'; OUT=f'{ROOT}/workspaces/mirfak_pi'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); te=pd.read_csv(f'{ROOT}/data/test.csv')
y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y); NT=len(te)
EXCL=('partial','stack','blend','candidate','nested','meta_','opt')
models={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name for e in EXCL): continue
        p=np.load(f); tp=f'{ROOT}/workspaces/{ws}/test_{name}.npy'
        if p.shape!=(N,3) or not os.path.exists(tp): continue
        t=np.load(tp)
        if t.shape!=(NT,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True); t=np.clip(t,1e-9,1); t/=t.sum(1,keepdims=True)
        k=f'{ws[:2]}:{name}'
        if k not in models: models[k]=(p,t)
sc={k:log_loss(y,v[0],labels=[0,1,2]) for k,v in models.items()}
models={k:v for k,v in models.items() if sc[k]<=0.75}
names=sorted(models,key=lambda k:sc[k]); keep=[]
for k in names:
    lk=np.log(models[k][0]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(models[j][0]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep
X=np.concatenate([np.log(models[n][0]) for n in names],1)
print('n',len(names),flush=True)
def mk_lr(C=0.05): return LogisticRegression(C=C,max_iter=3000)
def mk_hgb(): return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=0)
Ws=np.arange(0,1.01,0.1)
nested=np.zeros((N,3)); chosen=[]
for k in range(5):
    itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
    inner=np.zeros((len(itr),3)); lr_oof=np.zeros((len(itr),3)); hg_oof=np.zeros((len(itr),3))
    sk=StratifiedKFold(4,shuffle=True,random_state=11)
    for a,b in sk.split(X[itr],y[itr]):
        lr_oof[b]=mk_lr().fit(X[itr][a],y[itr][a]).predict_proba(X[itr][b])
        hg_oof[b]=mk_hgb().fit(X[itr][a],y[itr][a]).predict_proba(X[itr][b])
    bw=None
    for w in Ws:
        s=log_loss(y[itr], w*lr_oof+(1-w)*hg_oof, labels=[0,1,2])
        if bw is None or s<bw[0]: bw=(s,w)
    w=bw[1]; chosen.append(w)
    lr=mk_lr().fit(X[itr],y[itr]); hg=mk_hgb().fit(X[itr],y[itr])
    nested[iva]=w*lr.predict_proba(X[iva])+(1-w)*hg.predict_proba(X[iva])
    print('outer',k,'w',w,'inner',bw[0],flush=True)
s=log_loss(y,nested,labels=[0,1,2]); print('NESTED LR+HGB',s,'ws',chosen)
# pure LR nested for compare
nr=np.zeros((N,3))
for k in range(5):
    itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
    nr[iva]=mk_lr().fit(X[itr],y[itr]).predict_proba(X[iva])
print('NESTED pure LR',log_loss(y,nr,labels=[0,1,2]))
np.save(f'{OUT}/oof_nested_meta.npy',nested); np.save(f'{OUT}/oof_nested_lr.npy',nr)
json.dump({'nested_lrhgb':float(s),'nested_lr':float(log_loss(y,nr,labels=[0,1,2])),'ws':chosen,'models':names},open(f'{OUT}/nested_meta.json','w'),indent=2)
EOF
