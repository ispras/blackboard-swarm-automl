        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True); t=np.clip(t,1e-9,1); t/=t.sum(1,keepdims=True)
        k=f'{ws[:2]}:{name}'
        if k not in models: models[k]=(p,t)
