import warnings; warnings.filterwarnings('ignore')
import numpy as np, pandas as pd, json, os
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from xgboost import XGBClassifier
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import log_loss
from stack_all import collect, folds, y, te
EPS=1e-15; OUT='/download_job_code/payload/sandbox/workspaces/canopus_kappa'
def norm(p): p=np.clip(p,EPS,1); return p/p.sum(1,keepdims=True)
names_all,O_all,T_all=collect(); DER=('partial','stack','blend','candidate','nested','meta_')
def pool(maxll,thr):
    keep=[]
    for k,n in enumerate(names_all):
        t=n.split('/')[-1]
        if any(x in t for x in DER) or not np.isfinite(O_all[k]).all(): continue
        if log_loss(y,norm(O_all[k]))>maxll: continue
        keep.append(k)
    ind={k:log_loss(y,norm(O_all[k])) for k in keep}; sel=[]
    for k in sorted(keep,key=lambda k:ind[k]):
        if any(np.corrcoef(O_all[k].ravel(),O_all[j].ravel())[0,1]>thr for j in sel): continue
        sel.append(k)
    sel=sorted(sel); return [names_all[k] for k in sel],np.stack([norm(O_all[k]) for k in sel]),np.stack([norm(T_all[k]) for k in sel])
def feat(P):
    L=np.log(P); return np.concatenate([L,P],2).transpose(1,0,2).reshape(len(P[0]),-1)
def xgb_oof(X,cache):
    if os.path.exists(cache): return np.load(cache)
    o=np.zeros((len(y),3))
    for i,j in folds:
        g=XGBClassifier(n_estimators=200,learning_rate=0.03,max_depth=3,subsample=0.8,colsample_bytree=0.6,reg_lambda=1.0,objective='multi:softprob',tree_method='hist',n_jobs=2,random_state=42,verbosity=0)
        g.fit(X[i],y[i]); o[j]=g.predict_proba(X[j])
    np.save(cache,o); return o
res={}
for thr in [0.998,0.999]:
    nm,O,T=pool(0.75,thr); X=feat(O); print('=== thr',thr,'n',len(nm),flush=True)
    lrs={}
    for C in [0.1,0.2,0.3,0.5,1.0]:
        o=np.zeros((len(y),3))
        for i,j in folds:
            m=LogisticRegression(C=C,max_iter=6000).fit(X[i],y[i]); o[j]=m.predict_proba(X[j])
        lrs[C]=o; print(' LR',C,round(log_loss(y,o),5),flush=True)
    xg=xgb_oof(X,f'{OUT}/xgb_oof_{str(thr).replace(".","")}.npy'); print(' XGB',round(log_loss(y,xg),5),flush=True)
    best=(9,None,None)
    for C,lo in lrs.items():
        for w in [0.7,0.75,0.8,0.85,0.9,0.95,1.0]:
            p=norm(w*lo+(1-w)*xg); s=log_loss(y,p)
            if s<best[0]: best=(s,C,w)
    print(' best fixed',best,flush=True)
    # nested weight & C selection
    nested=np.zeros((len(y),3)); ch=[]
    for i,j in folds:
        b=min((log_loss(y[i],norm(w*lrs[C][i]+(1-w)*xg[i])),C,w) for C in lrs for w in [0.7,0.8,0.85,0.9,0.95,1.0])
        ch.append(b); nested[j]=norm(b[2]*lrs[b[1]][j]+(1-b[2])*xg[j])
    print(' nested',round(log_loss(y,nested),5),ch,flush=True)
    res[str(thr)]={'n':len(nm),'lrs':{str(C):log_loss(y,o) for C,o in lrs.items()},'xgb':log_loss(y,xg),'best_fixed':best,'nested':log_loss(y,nested),'chosen':ch,'names':nm}
json.dump(res,open(f'{OUT}/final_tune.json','w'),indent=2)
