import numpy as np, pandas as pd, json, warnings
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from xgboost import XGBClassifier
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'; OUT=f'{ROOT}/workspaces/mirfak_pi'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y)
rec=json.load(open(f'{OUT}/FINAL_results.json')); names=rec['models']
models={}
for n in names:
    a,nm=n.split(':',1); ws={'be':'bellatrix_tau','ca':'canopus_kappa','mi':'mirfak_pi'}[a]
    p=np.load(f'{ROOT}/workspaces/{ws}/oof_{nm}.npy'); p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True); models[n]=p
P=np.concatenate([models[n] for n in names],1); X=np.hstack([np.log(P),P])
oof=np.load(f'{OUT}/oof_verify_allowlist.npy')
# per-class
ll=-np.log(np.clip(oof[np.arange(N),y],1e-15,1))
for c in range(3):
    m=y==c; print('class',c,'n',m.sum(),'mean ll',ll[m].mean(),'acc',(oof[m].argmax(1)==c).mean(),'mean p_true',oof[m,c].mean())
# bagged meta: average predictions over 5 bootstrap fits
def mk(k,seed=0):
    if k=='lr': return LogisticRegression(C=0.05,max_iter=4000)
    if k=='hgb': return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=seed)
    return XGBClassifier(n_estimators=300,max_depth=3,learning_rate=0.05,subsample=0.8,colsample_bytree=0.5,reg_lambda=1.0,n_jobs=2,eval_metric='mlogloss',verbosity=0,random_state=seed)
W={'lr':0.6,'hgb':0.2,'xgb':0.2}
oofs={}
for k in W:
    o=np.zeros((N,3))
    for f in range(5):
        itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
        o[iva]=mk(k).fit(X[itr],y[itr]).predict_proba(X[iva])
    oofs[k]=o
base=sum(W[k]*oofs[k] for k in W); print('3way',log_loss(y,base,labels=[0,1,2]))
# per-row analysis: highest loss rows
idx=np.argsort(-ll)[:15]
print('hard rows ll',np.round(ll[idx],3))
print('their best model confidence',np.round(oof[idx].max(1),3))
# prior-corrected variant: divide by OOF mean pred, multiply by train prior, renorm
prior=np.bincount(y)/N; mp=base.mean(0)
adj=base*(prior/mp); adj/=adj.sum(1,keepdims=True)
print('prior-corrected',log_loss(y,adj,labels=[0,1,2]))
