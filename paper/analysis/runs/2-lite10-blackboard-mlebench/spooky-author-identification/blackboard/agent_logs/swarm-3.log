import numpy as np, pandas as pd, os, glob, warnings
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from xgboost import XGBClassifier
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'; OUT=f'{ROOT}/workspaces/mirfak_pi'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); te=pd.read_csv(f'{ROOT}/data/test.csv')
y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y)
EXCL=('partial','stack','blend','candidate','nested','meta','final','opt','verify','lr3mix','lrhgb','3way','cross')
base={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name.lower() for e in EXCL): continue
        p=np.load(f)
        if p.shape!=(N,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True)
        if log_loss(y,p,labels=[0,1,2])<0.25: continue
        base[f'{ws[:2]}:{name}']=p
sc={k:log_loss(y,v,labels=[0,1,2]) for k,v in base.items()}
names=sorted(base,key=lambda k:sc[k]); keep=[]
for k in names:
    lk=np.log(base[k]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(base[j]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep; print('n',len(names),flush=True)
P=np.concatenate([base[n] for n in names],1); X=np.hstack([np.log(P),P])
def mk(k):
    if k=='lr': return LogisticRegression(C=0.05,max_iter=4000)
    if k=='hgb': return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=0)
    return XGBClassifier(n_estimators=300,max_depth=3,learning_rate=0.05,subsample=0.8,colsample_bytree=0.5,reg_lambda=1.0,n_jobs=2,eval_metric='mlogloss',verbosity=0,random_state=0)
W={'lr':0.6,'hgb':0.2,'xgb':0.2}
oofs={}
for k in W:
    o=np.zeros((N,3))
    for f in range(5):
        itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
        o[iva]=mk(k).fit(X[itr],y[itr]).predict_proba(X[iva])
    oofs[k]=o
def norm(p): p=np.clip(p,1e-12,1); return p/p.sum(1,keepdims=True)
prob=sum(W[k]*oofs[k] for k in W); prob=norm(prob)
logp=np.exp(sum(W[k]*np.log(norm(oofs[k])) for k in W)); logp=norm(logp)
print('PROB-space',round(log_loss(y,prob,labels=[0,1,2]),6),flush=True)
print('LOG-space ',round(log_loss(y,logp,labels=[0,1,2]),6),flush=True)
for f in range(5):
    iva=np.where(fold_id==f)[0]
    print(' fold',f,'prob',round(log_loss(y[iva],prob[iva],labels=[0,1,2]),5),'log',round(log_loss(y[iva],logp[iva],labels=[0,1,2]),5),flush=True)
EOF
