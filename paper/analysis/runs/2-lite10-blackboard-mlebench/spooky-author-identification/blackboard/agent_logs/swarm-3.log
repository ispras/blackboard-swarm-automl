import numpy as np, pandas as pd, os, glob, json, warnings
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'; OUT=f'{ROOT}/workspaces/mirfak_pi'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); te=pd.read_csv(f'{ROOT}/data/test.csv')
y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y); NT=len(te)
EXCL=('partial','stack','blend','candidate','nested','meta_','opt')
models={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name for e in EXCL): continue
        p=np.load(f); tp=f'{ROOT}/workspaces/{ws}/test_{name}.npy'
        if p.shape!=(N,3) or not os.path.exists(tp): continue
        t=np.load(tp)
        if t.shape!=(NT,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True); t=np.clip(t,1e-9,1); t/=t.sum(1,keepdims=True)
        k=f'{ws[:2]}:{name}'
        if k not in models: models[k]=(p,t)
scores={k:log_loss(y,v[0],labels=[0,1,2]) for k,v in models.items()}
models={k:v for k,v in models.items() if scores[k]<=0.75}
names=sorted(models,key=lambda k:scores[k]); keep=[]
for k in names:
    lk=np.log(models[k][0]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(models[j][0]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep
X=np.concatenate([np.log(models[n][0]) for n in names],1)
XT=np.concatenate([np.log(models[n][1]) for n in names],1)
print('n models',len(names))
print('transformer features:',[n for n in names if any(s in n for s in ['dbl','deberta','roberta','xlnet','bilstm'])])

def cv_oof(make):
    oof=np.zeros((N,3))
    for k in range(5):
        itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
        m=make(); m.fit(X[itr],y[itr]); oof[iva]=m.predict_proba(X[iva])
    return oof

oofs={}
for C in [0.03,0.05,0.1,0.2]:
    oofs[f'lr{C}']=cv_oof(lambda C=C: LogisticRegression(C=C,max_iter=3000))
    print('lr',C,log_loss(y,oofs[f'lr{C}'],labels=[0,1,2]))
for lr in [0.03,0.05]:
  for leaf in [15,31]:
    for it in [200,400]:
      key=f'hgb_{lr}_{leaf}_{it}'
      oofs[key]=cv_oof(lambda lr=lr,leaf=leaf,it=it: HistGradientBoostingClassifier(max_iter=it,learning_rate=lr,max_leaf_nodes=leaf,l2_regularization=1.0,random_state=0))
      print(key, log_loss(y,oofs[key],labels=[0,1,2]))
best_lr=min([k for k in oofs if k.startswith('lr')],key=lambda k:log_loss(y,oofs[k],labels=[0,1,2]))
best_hgb=min([k for k in oofs if k.startswith('hgb')],key=lambda k:log_loss(y,oofs[k],labels=[0,1,2]))
print('BEST',best_lr,best_hgb)
best=(9,None)
for w in np.arange(0,1.01,0.1):
    s=log_loss(y, w*oofs[best_lr]+(1-w)*oofs[best_hgb], labels=[0,1,2])
    print('w',round(w,2),round(s,5))
    if s<best[0]: best=(s,w)
print('BEST BLEND',best)
# final test
lrC=float(best_lr[2:]); mlr=LogisticRegression(C=lrC,max_iter=3000).fit(X,y)
import re
m=re.match(r'hgb_([\d.]+)_(\d+)_(\d+)',best_hgb); gl,leaf,it=float(m.group(1)),int(m.group(2)),int(m.group(3))
mh=HistGradientBoostingClassifier(max_iter=it,learning_rate=gl,max_leaf_nodes=leaf,l2_regularization=1.0,random_state=0).fit(X,y)
pl=m.predict_proba(XT); ph=mh.predict_proba(XT)
w=best[1]; pt=w*pl+(1-w)*ph
