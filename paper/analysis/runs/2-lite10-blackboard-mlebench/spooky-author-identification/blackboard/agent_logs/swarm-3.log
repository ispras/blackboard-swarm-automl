import numpy as np, pandas as pd, time
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import log_loss
from scipy.sparse import hstack

tr = pd.read_csv('../../data/train.csv'); te = pd.read_csv('../../data/test.csv')
labels = sorted(tr['author'].unique()); lab2i = {l:i for i,l in enumerate(labels)}
y = tr['author'].map(lab2i).values
oof = np.zeros((len(tr),3)); test_pred = np.zeros((len(te),3))
skf = StratifiedKFold(5, shuffle=True, random_state=42)
t0=time.time()
for f,(ti,vi) in enumerate(skf.split(tr,y)):
    wv = TfidfVectorizer(ngram_range=(1,2), min_df=2, sublinear_tf=True, analyzer='word')
    cv = TfidfVectorizer(ngram_range=(2,5), min_df=2, sublinear_tf=True, analyzer='char_wb')
    Xw = wv.fit_transform(tr.iloc[ti]['text']); Xw_v = wv.transform(tr.iloc[vi]['text']); Xw_t = wv.transform(te['text'])
    Xc = cv.fit_transform(tr.iloc[ti]['text']); Xc_v = cv.transform(tr.iloc[vi]['text']); Xc_t = cv.transform(te['text'])
    Xt = hstack([Xw,Xc]).tocsr(); Xv = hstack([Xw_v,Xc_v]).tocsr(); Xtest = hstack([Xw_t,Xc_t]).tocsr()
    clf = LogisticRegression(C=5, max_iter=2000, n_jobs=4)
    clf.fit(Xt, y[ti])
    oof[vi] = clf.predict_proba(Xv); test_pred += clf.predict_proba(Xtest)/5
    print(f, log_loss(y[vi], oof[vi], labels=range(3)), f'{time.time()-t0:.1f}s', flush=True)
print('OOF', log_loss(y, oof, labels=range(3)))
np.save('oof_tfidf_lr.npy', oof); np.save('test_tfidf_lr.npy', test_pred)
sub = pd.DataFrame({'id': te['id'], 'EAP': test_pred[:,0], 'HPL': test_pred[:,1], 'MWS': test_pred[:,2]})
sub.to_csv('sub_tfidf_lr.csv', index=False)
EOF
