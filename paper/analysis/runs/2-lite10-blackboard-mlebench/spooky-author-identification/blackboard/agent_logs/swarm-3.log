        s=log_loss(y,o,labels=[0,1,2])
        pt=LogisticRegression(C=C,max_iter=4000).fit(X,y).predict_proba(XT)
        corr=np.corrcoef(live.ravel(),pt.ravel())[0,1]; am=(live.argmax(1)==pt.argmax(1)).mean()
        print(f'thr{thr} n{len(keep)} LR C{C}: cv {s:.5f} corr_live {corr:.6f} argmax {am:.4f}',flush=True)
