        o[iva]=mk(k).fit(X[itr],y[itr]).predict_proba(X[iva])
    oofs[k]=o; tests[k]=mk(k).fit(X,y).predict_proba(XT)
oof=sum(W[k]*oofs[k] for k in W); pt=sum(W[k]*tests[k] for k in W)
print('ALLOWLIST n',len(names),'CV',log_loss(y,oof,labels=[0,1,2]))
np.save(f'{OUT}/oof_verify_allowlist.npy',oof); np.save(f'{OUT}/test_verify_allowlist.npy',pt)
# compare to live
