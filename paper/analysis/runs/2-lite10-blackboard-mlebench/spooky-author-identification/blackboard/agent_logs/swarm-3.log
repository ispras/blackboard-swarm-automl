import numpy as np, pandas as pd, os, glob, warnings
from sklearn.linear_model import LogisticRegression
from sklearn.neural_network import MLPClassifier
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'; OUT=f'{ROOT}/workspaces/mirfak_pi'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y)
EXCL=('partial','stack','blend','candidate','nested','meta_','opt')
models={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name for e in EXCL): continue
        p=np.load(f)
        if p.shape!=(N,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True)
        models[f'{ws[:2]}:{name}']=p
scores={k:log_loss(y,v,labels=[0,1,2]) for k,v in models.items()}
models={k:v for k,v in models.items() if scores[k]<=0.75}
names=sorted(models,key=lambda k:scores[k]); keep=[]
for k in names:
    lk=np.log(models[k]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(models[j]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep
X=np.concatenate([np.log(models[n]) for n in names],1)
print('n models',len(names))

def meta(kind,C=0.1):
    if kind=='lr': return LogisticRegression(C=C,max_iter=3000)
    if kind=='mlp': return MLPClassifier(hidden_layer_sizes=(64,),alpha=1e-3,max_iter=400,early_stopping=True,random_state=0)
    if kind=='hgb': return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.05,max_leaf_nodes=15,l2_regularization=1.0,random_state=0)

for kind in ['lr','mlp','hgb']:
    oof=np.zeros((N,3))
    for k in range(5):
        itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
        m=meta(kind); m.fit(X[itr],y[itr]); oof[iva]=m.predict_proba(X[iva])
    print(kind, log_loss(y,oof,labels=[0,1,2]))
# average of LR and MLP/ HGB prob
oofs={}
for kind in ['lr','mlp','hgb']:
    oof=np.zeros((N,3))
    for k in range(5):
        itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
        m=meta(kind); m.fit(X[itr],y[itr]); oof[iva]=m.predict_proba(X[iva])
    oofs[kind]=oof
import itertools
for a,b in itertools.combinations(oofs,2):
    print(a,'+',b, log_loss(y,(oofs[a]+oofs[b])/2,labels=[0,1,2]))
