import numpy as np, pandas as pd, os, glob, warnings
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from xgboost import XGBClassifier
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y)
EXCL=('partial','stack','blend','candidate','nested','meta','final','opt','verify','lr3mix','lrhgb','3way','cross')
base={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name.lower() for e in EXCL): continue
        p=np.load(f)
        if p.shape!=(N,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True)
        if log_loss(y,p,labels=[0,1,2])<0.25: continue
        base[f'{ws[:2]}:{name}']=p
sc={k:log_loss(y,v,labels=[0,1,2]) for k,v in base.items()}
names=sorted(base,key=lambda k:sc[k]); keep=[]
for k in names:
    lk=np.log(base[k]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(base[j]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep; print('n',len(names),flush=True)
P=np.concatenate([base[n] for n in names],1); X=np.hstack([np.log(P),P])
def mk(k,seed=0):
    if k=='lr': return LogisticRegression(C=0.05,max_iter=4000)
    if k=='hgb': return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=seed)
    return XGBClassifier(n_estimators=300,max_depth=3,learning_rate=0.05,subsample=0.8,colsample_bytree=0.5,reg_lambda=1.0,n_jobs=2,eval_metric='mlogloss',verbosity=0,random_state=seed)
W={'lr':0.6,'hgb':0.2,'xgb':0.2}
def run(bags):
    oofs={k:np.zeros((N,3)) for k in W}
    rng=np.random.RandomState(123)
    for f in range(5):
        itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
        for k in W:
            ps=[]
            for b in range(bags):
                if bags==1: idx=itr
                else:
                    idx=rng.choice(itr,size=int(0.9*len(itr)),replace=False)
                ps.append(mk(k,seed=b).fit(X[idx],y[idx]).predict_proba(X[iva]))
            oofs[k][iva]=np.mean(ps,0)
    o=sum(W[k]*oofs[k] for k in W)
    print('bags',bags,'per-model',{k:round(log_loss(y,oofs[k],labels=[0,1,2]),5) for k in W},'3way',round(log_loss(y,o,labels=[0,1,2]),5),flush=True)
    return o
o1=run(1); o3=run(3); o5=run(5)
# per-class temperature on o1 (fold-safe, 3 params) quick grid
def perclass_T(oof):
    out=np.zeros_like(oof)
    for f in range(5):
        itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
        Ts=np.ones(3)
        for c in range(3):
            best=(9,1.0)
            for T in [0.85,0.9,0.95,1.0,1.05,1.1,1.15]:
                lp=np.log(np.clip(oof[itr],1e-12,1))/T; q=np.exp(lp-lp.max(1,keepdims=True)); q/=q.sum(1,keepdims=True)
                s=log_loss(y[itr],q,labels=[0,1,2])
                if s<best[0]: best=(s,T)
            Ts[c]=best[1]
        lp=np.log(np.clip(oof[iva],1e-12,1))/Ts; q=np.exp(lp-lp.max(1,keepdims=True)); q/=q.sum(1,keepdims=True)
        out[iva]=q
    return out,Ts
