models={k:v for k,v in models.items() if sc[k]<=0.75}
names=sorted(models,key=lambda k:sc[k]); keep=[]
for k in names:
    lk=np.log(models[k][0]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(models[j][0]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep
print('n',len(names))
P=np.concatenate([models[n][0] for n in names],1)
PT=np.concatenate([models[n][1] for n in names],1)
L=np.log(P); LT=np.log(PT)
feats={'log':(L,LT),'logprob':(np.hstack([L,P]),np.hstack([LT,PT])),'prob':(P,PT)}
def mk(kind,C=0.05):
    if kind=='lr': return LogisticRegression(C=C,max_iter=4000)
    return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=0)
def cv(X,kind,C=0.05):
    oof=np.zeros((N,3))
    for k in range(5):
        itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
        oof[iva]=mk(kind,C).fit(X[itr],y[itr]).predict_proba(X[iva])
    return oof
res={}
for fn,(X,XT) in feats.items():
    for kind in ['lr','hgb']:
        for C in ([0.03,0.05,0.1] if kind=='lr' else [0.05]):
            o=cv(X,kind,C); s=log_loss(y,o,labels=[0,1,2]); res[(fn,kind,C)]=s
            print(fn,kind,C,round(s,5),flush=True)
# blends for each feature set using best lr/hgb
for fn,(X,XT) in feats.items():
    lrkey=max([k for k in res if k[0]==fn and k[1]=='lr'],key=lambda k:-res[k])
    hgkey=(fn,'hgb',0.05)
    olr=cv(X,'lr',lrkey[2]); ohg=cv(X,'hgb',0.05)
    best=(9,None)
    for w in np.arange(0,1.01,0.1):
        s=log_loss(y,w*olr+(1-w)*ohg,labels=[0,1,2])
        if s<best[0]: best=(s,w)
    print('BLEND',fn,'lrC',lrkey[2],'->',round(best[0],5),'w',round(best[1],2),flush=True)
