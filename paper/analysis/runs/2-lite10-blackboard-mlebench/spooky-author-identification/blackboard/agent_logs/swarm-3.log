import numpy as np, pandas as pd, os, glob, json, warnings, time
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import log_loss
from scipy.optimize import minimize_scalar
warnings.filterwarnings('ignore')

OUT = os.path.dirname(os.path.abspath(__file__))
DATA = '/download_job_code/payload/sandbox/data'
tr = pd.read_csv(f'{DATA}/train.csv')
y = tr['author'].map({'EAP': 0, 'HPL': 1, 'MWS': 2}).values
fold_id = np.load(f'{OUT}/fold_id.npy')
N = len(y)

models = {}
for f in sorted(glob.glob(f'{OUT}/oof_*.npy')):
    name = os.path.basename(f)[4:-4]
    if name.startswith(('stack', 'blend', 'optblend')): continue
    p = np.load(f)
    if p.shape != (N, 3): continue
    tpath = f'{OUT}/test_{name}.npy'
    if not os.path.exists(tpath): continue
    models[name] = (p, np.load(tpath))

def norm(p): return p / p.sum(1, keepdims=True)

def temp_scale(p, y):
    lp = np.log(np.clip(norm(p), 1e-12, 1))
    def f(T):
        q = lp / T
        q = np.exp(q - q.max(1, keepdims=True)); q /= q.sum(1, keepdims=True)
        return log_loss(y, q, labels=[0, 1, 2])
    r = minimize_scalar(f, bounds=(0.3, 5.0), method='bounded')
    return r.x, r.fun

print('=== individual + temperature ===')
for name, (p, t) in models.items():
    base = log_loss(y, np.clip(norm(p), 1e-15, 1), labels=[0, 1, 2])
    T, sc = temp_scale(p, y)
    models[name] = (norm(p), norm(t))
    print(f'{name:16s} raw {base:.5f}  T {T:.3f} -> {sc:.5f}')

names = list(models.keys())

def logfeat(idx):
    return np.concatenate([np.log(np.clip(models[n][0][idx], 1e-6, 1)) for n in names], axis=1)

def probfeat(idx):
    return np.concatenate([models[n][0][idx] for n in names], axis=1)

def cv_stack(feature_fn, C=1.0, kind='log'):
    oof = np.zeros((N, 3))
    for k in range(5):
        itr = np.where(fold_id != k)[0]; iva = np.where(fold_id == k)[0]
        X = feature_fn(np.arange(N))
        clf = LogisticRegression(C=C, max_iter=2000, multi_class='multinomial')
        clf.fit(X[itr], y[itr])
        oof[iva] = clf.predict_proba(X[iva])
    return log_loss(y, oof, labels=[0, 1, 2]), oof

print('=== stacking CV (LR on log-probs / probs) ===')
best = (9, None, None, None, None)
for kind, fn in [('log', logfeat), ('prob', probfeat)]:
    for C in [0.03, 0.1, 0.3, 1.0, 3.0]:
        sc, oof = cv_stack(fn, C=C)
        print(f'{kind} C={C}: {sc:.5f}', flush=True)
        if sc < best[0]: best = (sc, kind, C, fn, oof)
print('BEST STACK', best[:3])
sc, kind, C, fn, oof = best
np.save(f'{OUT}/oof_stack.npy', oof)
# fit full and predict test
Xall = fn(np.arange(N)); Xte = fn(np.arange(N))  # placeholder
# build test features
if kind == 'log':
    Xte = np.concatenate([np.log(np.clip(models[n][1], 1e-6, 1)) for n in names], axis=1)
else:
    Xte = np.concatenate([models[n][1] for n in names], axis=1)
clf = LogisticRegression(C=C, max_iter=2000, multi_class='multinomial')
clf.fit(Xall, y)
pt = clf.predict_proba(Xte)
np.save(f'{OUT}/test_stack.npy', pt)
json.dump({'stack_cv': float(sc), 'kind': kind, 'C': C, 'models': names}, open(f'{OUT}/stack_results.json', 'w'), indent=2)
print(json.dumps({'stack_cv': sc, 'kind': kind, 'C': C}, indent=2))
