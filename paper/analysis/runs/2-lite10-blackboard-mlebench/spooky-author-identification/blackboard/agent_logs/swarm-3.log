        itr=np.where(fold_id!=k)[0]; iva=np.where(fold_id==k)[0]
        o[iva]=mk(kind).fit(X[itr],y[itr]).predict_proba(X[iva])
    oofs[kind]=o; print(kind,'CV',log_loss(y,o,labels=[0,1,2]),flush=True)
ens=sum(W[k]*oofs[k] for k in W); print('WEIGHTED CV',log_loss(y,ens,labels=[0,1,2]),'W',W,flush=True)
# optimize weights on OOF via softmax parametrization (dirichlet-ish), simple grid for 2, scipy for 3
ks=list(W)
def f(w):
    w=np.abs(w); w=w/w.sum()
    return log_loss(y,sum(w[i]*oofs[k] for i,k in enumerate(ks)),labels=[0,1,2])
from scipy.optimize import minimize as _min
r=_min(f,np.array([W[k] for k in ks]),method='Nelder-Mead')
wo=np.abs(r.x); wo/=wo.sum(); print('OPT',dict(zip(ks,np.round(wo,3))),'CV',r.fun,flush=True)
oof_final=sum(wo[i]*oofs[k] for i,k in enumerate(ks))
pt=sum(wo[i]*mk(k).fit(X,y).predict_proba(XT) for i,k in enumerate(ks))
np.save(f'{OUT}/test_final_meta.npy',pt); np.save(f'{OUT}/oof_final_meta.npy',oof_final)
pd.DataFrame({'id':te['id'],'EAP':pt[:,0],'HPL':pt[:,1],'MWS':pt[:,2]}).to_csv(f'{OUT}/sub_final_meta.csv',index=False)
json.dump({'cv':float(log_loss(y,oof_final,labels=[0,1,2])),'weights':dict(zip(ks,map(float,wo))),'n':len(names),'models':names},open(f'{OUT}/final_meta_results.json','w'),indent=2)
print('saved',pt.shape,flush=True)
