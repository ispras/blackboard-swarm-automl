import numpy as np, pandas as pd, os, glob, warnings
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from xgboost import XGBClassifier
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')
ROOT='/download_job_code/payload/sandbox'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); te=pd.read_csv(f'{ROOT}/data/test.csv')
y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy'); N=len(y); NT=len(te)
EXCL=('partial','stack','blend','candidate','nested','meta','opt','final')
models={}
for ws in ['bellatrix_tau','canopus_kappa','mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name=os.path.basename(f)[4:-4]
        if any(e in name for e in EXCL): continue
        p=np.load(f)
        if p.shape!=(N,3): continue
        p=np.clip(p,1e-9,1); p/=p.sum(1,keepdims=True)
        models[f'{ws[:2]}:{name}']=p
sc={k:log_loss(y,v,labels=[0,1,2]) for k,v in models.items()}
models={k:v for k,v in models.items() if sc[k]<=0.75}
names=sorted(models,key=lambda k:sc[k]); keep=[]
for k in names:
    lk=np.log(models[k]).ravel(); dup=False
    for j in keep:
        if np.corrcoef(lk,np.log(models[j]).ravel())[0,1]>0.998: dup=True;break
    if not dup: keep.append(k)
names=keep
P=np.concatenate([models[n] for n in names],1); X0=np.hstack([np.log(P),P])
def feats(df):
    t=df['text'].astype(str)
    nw=t.str.split().str.len().values.astype(float)
    nc=t.str.len().values.astype(float)
    f=np.column_stack([np.log1p(nw),np.log1p(nc),t.str.count(r'[,;:]').values/np.maximum(nw,1),t.str.count(r'[?!]').values, t.str.count(r'"').values])
    return f
Ftr=feats(tr); Fte=feats(te)
# standardize using train
mu=Ftr.mean(0); sd=Ftr.std(0)+1e-9
Ftr=(Ftr-mu)/sd; Fte=(Fte-mu)/sd
def run(X,tag):
    print('===',tag,flush=True)
    for C in [0.05,0.1]:
        o=np.zeros((N,3))
        for f in range(5):
            itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
            o[iva]=LogisticRegression(C=C,max_iter=4000).fit(X[itr],y[itr]).predict_proba(X[iva])
        print('LR',C,round(log_loss(y,o,labels=[0,1,2]),5),flush=True)
    def mk(k):
        if k=='hgb': return HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=0)
        return XGBClassifier(n_estimators=300,max_depth=3,learning_rate=0.05,subsample=0.8,colsample_bytree=0.5,reg_lambda=1.0,n_jobs=2,eval_metric='mlogloss',verbosity=0,random_state=0)
    oo={}
    for k in ['hgb','xgb']:
        o=np.zeros((N,3))
        for f in range(5):
            itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
            o[iva]=mk(k).fit(X[itr],y[itr]).predict_proba(X[iva])
        oo[k]=o; print(k,round(log_loss(y,o,labels=[0,1,2]),5),flush=True)
    lr=np.zeros((N,3))
    for f in range(5):
        itr=np.where(fold_id!=f)[0]; iva=np.where(fold_id==f)[0]
        lr[iva]=LogisticRegression(C=0.05,max_iter=4000).fit(X[itr],y[itr]).predict_proba(X[iva])
    p=0.6*lr+0.2*oo['hgb']+0.2*oo['xgb']; print('3way',round(log_loss(y,p,labels=[0,1,2]),5),flush=True)
run(X0,'base only')
run(np.hstack([X0,Ftr]),'base + length/punct')
