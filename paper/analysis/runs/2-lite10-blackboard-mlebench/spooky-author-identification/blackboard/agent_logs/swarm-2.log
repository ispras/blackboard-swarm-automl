=== mirfak mystack.py ===
import numpy as np, pandas as pd, os, glob, json, warnings, sys
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import log_loss
warnings.filterwarnings('ignore')

ROOT = '/download_job_code/payload/sandbox'
DATA = f'{ROOT}/data'
OUT = f'{ROOT}/workspaces/mirfak_pi'
tr = pd.read_csv(f'{DATA}/train.csv'); te = pd.read_csv(f'{DATA}/test.csv')
y = tr['author'].map({'EAP': 0, 'HPL': 1, 'MWS': 2}).values
fold_id = np.load(f'{ROOT}/workspaces/bellatrix_tau/fold_id.npy')
N = len(y); NT = len(te)

EXCLUDE_PREFIX = ('stack', 'blend', 'optblend', 'dbl5_partial')
models = {}
for ws in ['bellatrix_tau', 'canopus_kappa', 'mirfak_pi']:
    for f in sorted(glob.glob(f'{ROOT}/workspaces/{ws}/oof_*.npy')):
        name = os.path.basename(f)[4:-4]
        if name.startswith(EXCLUDE_PREFIX): continue
        p = np.load(f)
        if p.shape != (N, 3): continue
        tpath = f'{ROOT}/workspaces/{ws}/test_{name}.npy'
        if not os.path.exists(tpath): continue
        t = np.load(tpath)
        if t.shape != (NT, 3): continue
        key = f'{ws[:2]}:{name}'
        if key in models: continue
        p = np.clip(p, 1e-9, 1); p = p / p.sum(1, keepdims=True)
        t = np.clip(t, 1e-9, 1); t = t / t.sum(1, keepdims=True)
        models[key] = (p, t)

print(f'{len(models)} models')
for k, (p, t) in sorted(models.items(), key=lambda kv: log_loss(y, kv[1][0], labels=[0,1,2])):
    print(f'  {k:45s} {log_loss(y, p, labels=[0,1,2]):.5f}')

names = list(models.keys())
Xlog = np.concatenate([np.log(models[n][0]) for n in names], 1)
Xtlog = np.concatenate([np.log(models[n][1]) for n in names], 1)
Xprob = np.concatenate([models[n][0] for n in names], 1)
Xtprob = np.concatenate([models[n][1] for n in names], 1)

def cv_stack(X, C):
    oof = np.zeros((N, 3))
    for k in range(5):
        itr = np.where(fold_id != k)[0]; iva = np.where(fold_id == k)[0]
        clf = LogisticRegression(C=C, max_iter=3000)
        clf.fit(X[itr], y[itr]); oof[iva] = clf.predict_proba(X[iva])
    return log_loss(y, oof, labels=[0,1,2]), oof

res = {}
for kind, X in [('log', Xlog), ('prob', Xprob)]:
    for C in [0.01, 0.03, 0.1, 0.3, 1.0, 3.0, 10.0]:
        s, _ = cv_stack(X, C); res[(kind, C)] = s
        print(f'{kind} C={C}: {s:.5f}', flush=True)

(kind, C) = min(res, key=res.get)
X = Xlog if kind == 'log' else Xprob
Xt = Xtlog if kind == 'log' else Xtprob
s, oof = cv_stack(X, C)
print('BEST', kind, C, s)
clf = LogisticRegression(C=C, max_iter=3000); clf.fit(X, y)
pt = clf.predict_proba(Xt)
# blend with best single transformer if present
np.save(f'{OUT}/oof_mystack.npy', oof); np.save(f'{OUT}/test_mystack.npy', pt)
sub = pd.DataFrame({'id': te['id'], 'EAP': pt[:,0], 'HPL': pt[:,1], 'MWS': pt[:,2]})
sub.to_csv(f'{OUT}/sub_mystack.csv', index=False)
json.dump({'best': [kind, C, float(s)], 'n_models': len(names), 'models': names,
           'all_results': {f'{k[0]}_{k[1]}': float(v) for k, v in res.items()}},
          open(f'{OUT}/mystack_results.json', 'w'), indent=2)
print('saved')
