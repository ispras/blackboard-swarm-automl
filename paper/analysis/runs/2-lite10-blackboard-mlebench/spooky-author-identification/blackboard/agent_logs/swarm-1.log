        if p.shape!=(N,3):continue
        p=np.clip(p,1e-9,1);p/=p.sum(1,keepdims=True)
        ll=log_loss(y,p,labels=[0,1,2])
        if ll<=0.75: mods[f'{ws}:{n}']=(p,ll)
keys=sorted(mods,key=lambda k:mods[k][1]);kept=[]
for k in keys:
    if any(np.corrcoef(mods[k][0].ravel(),mods[kk][0].ravel())[0,1]>0.998 for kk in kept):continue
    kept.append(k)
P=np.concatenate([mods[k][0] for k in kept],axis=1);L=np.log(P);X=np.hstack([L,P])
def cv(X,C,seed):
    o=np.zeros((N,3));skf=StratifiedKFold(5,shuffle=True,random_state=seed)
    for i,j in skf.split(X,y):
        m=LogisticRegression(C=C,max_iter=4000,multi_class='multinomial');m.fit(X[i],y[i]);o[j]=m.predict_proba(X[j])
    return log_loss(y,o,labels=[0,1,2])
for C in [0.05,0.1,0.2,0.3,0.5,1.0]:
    sc=[cv(X,C,s) for s in [42,0,1,7]]
    print('log+prob C',C,'seed42',round(sc[0],5),'mean',round(np.mean(sc),5),'vals',[round(x,5) for x in sc])
