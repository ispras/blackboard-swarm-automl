import numpy as np
from sklearn.metrics import log_loss
import pandas as pd
tr=pd.read_csv('/download_job_code/payload/sandbox/data/train.csv')
y=tr.author.map({'EAP':0,'HPL':1,'MWS':2}).values
for m in ['sgd_both','mnb_word_a03','mnb_char','lr_both_c30']:
    p=np.load(f'oof_{m}.npy')
    print(m, log_loss(y,np.clip(p,1e-15,1)), 'max',p.max(),'min',p.min(), 'meanmax',p.max(1).mean())
# blend excluding sgd_both
import glob, os
allm={}
for f in glob.glob('oof_*.npy'):
    n=os.path.basename(f)[4:-4]
    if n.startswith(('blend','optblend')): continue
    p=np.load(f)
    if p.shape==(len(y),3): allm[n]=p
from scipy.optimize import minimize
def opt(names):
    O=np.stack([allm[n] for n in names])
    def obj(w):
        w=np.abs(w); w/=w.sum()+1e-12
        p=np.tensordot(w,O,axes=1); p/=p.sum(1,keepdims=True)
        return log_loss(y,p,labels=[0,1,2])
    best=None
    rng=np.random.default_rng(1)
    for t in range(6):
        r=minimize(obj, rng.random(len(names)),method='Nelder-Mead',options={'maxiter':4000})
        if best is None or r.fun<best.fun: best=r
    w=np.abs(best.x);w/=w.sum()
    return best.fun, dict(zip(names,np.round(w,3)))
names=[n for n in allm if n!='sgd_both']
print('no sgd_both', opt(names))
names=[n for n in allm if n not in ('sgd_both','nbsvm_word','nbsvm_char','cnb_word','lr_both_c1','lr_both_c3','lr_word')]
print('clean', opt(names))
EOF
