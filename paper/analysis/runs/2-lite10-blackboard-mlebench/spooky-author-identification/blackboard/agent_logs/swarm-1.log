import numpy as np, pandas as pd, glob, os, warnings, time
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.metrics import log_loss
import xgboost as xgb
ROOT='/download_job_code/payload/sandbox'; y=pd.read_csv(f'{ROOT}/data/train.csv').author.map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load('fold_id.npy');N=len(y)
EXCL=('stack','blend','optblend','mystack','crossstack','partial','chosen','sub','candidate','nested','meta','final','lr3mix','lrhgb','3way','honest','pred')
mods={}
for ws in sorted(os.listdir(f'{ROOT}/workspaces')):
    d=f'{ROOT}/workspaces/{ws}'
    for f in sorted(glob.glob(f'{d}/oof_*.npy')):
        n=os.path.basename(f)[4:-4]
        if any(e in n.lower() for e in EXCL): continue
        if not os.path.exists(f'{d}/test_{n}.npy'): continue
        p=np.load(f)
        if p.shape!=(N,3):continue
        p=np.clip(p,1e-9,1);p/=p.sum(1,keepdims=True)
        ll=log_loss(y,p,labels=[0,1,2])
        if ll<=0.75: mods[f'{ws}:{n}']=(p,ll)
keys=sorted(mods,key=lambda k:mods[k][1])
def dedup(thr):
    if thr is None: return keys
    kept=[]
    for k in keys:
        if any(np.corrcoef(mods[k][0].ravel(),mods[kk][0].ravel())[0,1]>thr for kk in kept): continue
        kept.append(k)
    return kept
def cv(kept,fn):
    L=np.concatenate([np.log(mods[k][0]) for k in kept],axis=1);P=np.concatenate([mods[k][0] for k in kept],axis=1);X=np.hstack([L,P])
    o=np.zeros((N,3))
    for f in range(5):
        i=np.where(fold_id!=f)[0];j=np.where(fold_id==f)[0]
        m=fn();m.fit(X[i],y[i]);o[j]=m.predict_proba(X[j])
    return o,log_loss(y,o,labels=[0,1,2])
def lrf(C): return lambda: LogisticRegression(C=C,max_iter=4000,multi_class='multinomial')
def hgf(): return lambda: HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=42)
def xgf(): return lambda: xgb.XGBClassifier(n_estimators=400,learning_rate=0.03,max_depth=5,subsample=0.8,colsample_bytree=0.7,reg_lambda=1.0,n_jobs=4,random_state=42,objective='multi:softprob',num_class=3,tree_method='hist')
def logavg(ws): q=sum(w*np.log(np.clip(a,1e-9,1)) for w,a in ws);q=np.exp(q-q.max(1,keepdims=True));q/=q.sum(1,keepdims=True);return q
t0=time.time()
for thr in [None,0.999,0.998,0.995]:
    kept=dedup(thr);print(f'thr={thr} n={len(kept)}',flush=True)
    lr,lrs=cv(kept,lrf(0.1));h,hs=cv(kept,hgf());xg,xs=cv(kept,xgf())
    print(f'  LR {lrs:.5f} HGB {hs:.5f} XGB {xs:.5f}',flush=True)
    for w in [(0.6,0.2,0.2),(0.6,0.24,0.16),(0.7,0.15,0.15)]:
        sc=log_loss(y,logavg([(w[0],lr),(w[1],h),(w[2],xg)]),labels=[0,1,2])
        print(f'    log3way {w} {sc:.5f}',flush=True)
print('time',time.time()-t0,flush=True)
EOF
