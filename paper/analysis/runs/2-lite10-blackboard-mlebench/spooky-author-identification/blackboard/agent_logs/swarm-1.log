import numpy as np,pandas as pd,glob,os,warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.metrics import log_loss
import xgboost as xgb
ROOT='/download_job_code/payload/sandbox'; y=pd.read_csv(f'{ROOT}/data/train.csv').author.map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load('fold_id.npy');N=len(y)
EXCL=('stack','blend','optblend','mystack','crossstack','partial','chosen','sub','candidate','nested','meta_')
mods={}
for ws in sorted(os.listdir(f'{ROOT}/workspaces')):
    d=f'{ROOT}/workspaces/{ws}'
    for f in sorted(glob.glob(f'{d}/oof_*.npy')):
        n=os.path.basename(f)[4:-4]
        if any(e in n for e in EXCL): continue
        if not os.path.exists(f'{d}/test_{n}.npy'): continue
        p=np.load(f)
        if p.shape!=(N,3):continue
        p=np.clip(p,1e-9,1);p/=p.sum(1,keepdims=True)
        ll=log_loss(y,p,labels=[0,1,2])
        if ll<=0.75: mods[f'{ws}:{n}']=(p,ll)
keys=sorted(mods,key=lambda k:mods[k][1]);kept=[]
for k in keys:
    if any(np.corrcoef(mods[k][0].ravel(),mods[kk][0].ravel())[0,1]>0.998 for kk in kept):continue
    kept.append(k)
L=np.concatenate([np.log(mods[k][0]) for k in kept],axis=1);P=np.concatenate([mods[k][0] for k in kept],axis=1);X=np.hstack([L,P])
def cv(fn):
    o=np.zeros((N,3))
    for f in range(5):
        i=np.where(fold_id!=f)[0];j=np.where(fold_id==f)[0]
        m=fn();m.fit(X[i],y[i]);o[j]=m.predict_proba(X[j])
    return o,log_loss(y,o,labels=[0,1,2])
lr,lrs=cv(lambda:LogisticRegression(C=0.1,max_iter=4000,multi_class='multinomial'))
h,hs=cv(lambda:HistGradientBoostingClassifier(max_iter=200,learning_rate=0.03,max_leaf_nodes=15,l2_regularization=1.0,random_state=42))
xg,xs=cv(lambda:xgb.XGBClassifier(n_estimators=400,learning_rate=0.03,max_depth=5,subsample=0.8,colsample_bytree=0.7,reg_lambda=1.0,n_jobs=4,random_state=42,objective='multi:softprob',num_class=3,tree_method='hist'))
print('LR',round(lrs,5),'HGB',round(hs,5),'XGB',round(xs,5))
def bl(*pairs):
    q=sum(w*np.log(np.clip(a,1e-9,1)) for w,a in pairs);q=np.exp(q-q.max(1,keepdims=True));q/=q.sum(1,keepdims=True);return log_loss(y,q,labels=[0,1,2])
for w in [0.6,0.7,0.8,0.9]:
    print('LR+HGB',w,round(bl((w,lr),(1-w,h)),5))
for w in [0.8,0.9,0.95]:
    print('LR+XGB',w,round(bl((w,lr),(1-w,xg)),5))
for w in [(0.7,0.3,0.0),(0.7,0.2,0.1),(0.6,0.3,0.1),(0.8,0.2,0.0),(0.75,0.25,0.0)]:
    print('3way',w,round(bl((w[0],lr),(w[1],h),(w[2],xg)),5))
