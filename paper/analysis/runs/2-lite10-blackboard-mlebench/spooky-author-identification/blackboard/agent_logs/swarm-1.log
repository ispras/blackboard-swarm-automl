import warnings; warnings.filterwarnings('ignore')
import numpy as np, pandas as pd, os, json, sys
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import log_loss
from stack_all import collect, folds, y, te
EPS=1e-15
ROOT='/download_job_code/payload/sandbox'
OUT=f'{ROOT}/workspaces/canopus_kappa'
FS=f'{ROOT}/final_solution'

def ok(n,O):
    tag=n.split('/')[-1]
    if tag in {'dbl5_partial'}: return False
    if not np.isfinite(O).all(): return False
    p=np.clip(O,EPS,1); p=p/p.sum(1,keepdims=True)
    return log_loss(y,p)<=0.60

def stack_cv(O,C):
    X=np.log(O).transpose(1,0,2).reshape(len(y),-1)
    oof=np.zeros((len(y),3))
    for i,j in folds:
        m=LogisticRegression(C=C,max_iter=5000); m.fit(X[i],y[i]); oof[j]=m.predict_proba(X[j])
    return log_loss(y,oof)

def fit_predict(O,T,C):
    X=np.log(O).transpose(1,0,2).reshape(len(y),-1)
    XT=np.log(T).transpose(1,0,2).reshape(len(te),-1)
    m=LogisticRegression(C=C,max_iter=5000); m.fit(X,y)
    p=m.predict_proba(XT); p=p/p.sum(1,keepdims=True)
    return p

def run(include_stacks):
    names,O,T=collect()
    sel=[]
    for k,(n,o) in enumerate(zip(names,O)):
        tag=n.split('/')[-1]
        if tag in {'stack','optblend'} and not include_stacks: continue
        if tag in {'dbl5_partial'}: continue
        if not ok(n,o): continue
        sel.append(k)
    names=[names[k] for k in sel]; O=O[sel]; T=T[sel]
    best=(9,None,None)
    for C in [0.1,0.3,1.0,3.0,10.0,30.0]:
        s=stack_cv(O,C); print(f'include_stacks={include_stacks} n={len(names)} C={C} -> {s:.5f}',flush=True)
        if s<best[0]: best=(s,C,None)
    return names,O,T,best

if __name__=='__main__':
    res={}
    for inc in [False,True]:
        names,O,T,best=run(inc)
        res[inc]=(names,O,T,best)
    inc=min(res,key=lambda k:res[k][3][0])
    names,O,T,(s,C,_)=res[inc]
    print('CHOSEN include_stacks',inc,'n',len(names),'C',C,'CV',s,flush=True)
    p=fit_predict(O,T,C)
    sub=pd.DataFrame({'id':te['id'],'EAP':p[:,0],'HPL':p[:,1],'MWS':p[:,2]})
    os.makedirs(FS,exist_ok=True)
    sub.to_csv(f'{FS}/submission.csv',index=False)
    json.dump({'include_stacks':inc,'C':C,'cv':s,'n_models':len(names),'models':names},
              open(f'{OUT}/chosen_stack.json','w'),indent=2)
    np.save(f'{OUT}/chosen_oof.npy',O); np.save(f'{OUT}/chosen_test.npy',T)
    print('wrote',f'{FS}/submission.csv',sub.shape,flush=True)
