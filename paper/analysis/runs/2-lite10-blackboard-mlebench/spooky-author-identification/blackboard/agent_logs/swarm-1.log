import numpy as np,pandas as pd,glob,os,warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import log_loss
ROOT='/download_job_code/payload/sandbox'; y=pd.read_csv(f'{ROOT}/data/train.csv').author.map({'EAP':0,'HPL':1,'MWS':2}).values
fold_id=np.load('fold_id.npy');N=len(y)
EXCL=('stack','blend','optblend','mystack','crossstack','partial','chosen','sub','candidate','S1_','S2_','nested','meta_')
models={}
for ws in sorted(os.listdir(f'{ROOT}/workspaces')):
    d=f'{ROOT}/workspaces/{ws}'
    for f in sorted(glob.glob(f'{d}/oof_*.npy')):
        n=os.path.basename(f)[4:-4]
        if any(n.startswith(e) for e in EXCL): continue
        if not os.path.exists(f'{d}/test_{n}.npy'): continue
        p=np.load(f)
        if p.shape!=(N,3): continue
        p=np.clip(p,1e-9,1);p/=p.sum(1,keepdims=True)
        ll=log_loss(y,p,labels=[0,1,2])
        if ll<=0.75: models[f'{ws}:{n}']=(p,ll)
keys=sorted(models,key=lambda k:models[k][1]);kept=[]
for k in keys:
    if any(np.corrcoef(models[k][0].ravel(),models[kk][0].ravel())[0,1]>0.998 for kk in kept): continue
    kept.append(k)
print('kept'); [print(f'  {k} {models[k][1]:.4f}') for k in kept]
def cv(ks,C=0.2):
    X=np.concatenate([np.log(models[k][0]) for k in ks],axis=1);o=np.zeros((N,3))
    for f in range(5):
        i=np.where(fold_id!=f)[0];j=np.where(fold_id==f)[0]
        m=LogisticRegression(C=C,max_iter=4000,multi_class='multinomial');m.fit(X[i],y[i]);o[j]=m.predict_proba(X[j])
    return log_loss(y,o,labels=[0,1,2])
print('all',cv(kept))
nd=[k for k in kept if 'deberta_base_ls' not in k]
print('no deberta',cv(nd))
print('only deberta+top linear',cv([k for k in kept if ('deberta_base_ls' in k) or k.endswith(':logreg') or k.endswith(':lr_both_c30') or k.endswith(':wc_big_C30')]))
print('only deberta',cv([k for k in kept if 'deberta_base_ls' in k]))
for C in [0.05,0.1,0.2,0.5,1]:
    print('C',C,cv(kept,C))
