sw=(((plon>=39)&(plon<=42)&(plat>=-75)&(plat<=-72))|((dlo>=39)&(dlo<=42)&(dlat>=-75)&(dlat<=-72)))
inbox=(plon>=-75)&(plon<=-72)&(plat>=39)&(plat<=42)&(dlo>=-75)&(dlo<=-72)&(dlat>=39)&(dlat<=42)
invalid=(~inbox)&(~sw)
