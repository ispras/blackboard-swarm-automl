hold = np.load(os.path.join(BASE, 'holdout_mask.npy'))
rnd = np.load(os.path.join(BASE, 'sample_rand.npy'))
pf = pq.ParquetFile(os.path.join(BASE, 'features_train.parquet'))
cols = ['fare_amount', 'pickup_longitude', 'pickup_latitude', 'dropoff_longitude', 'dropoff_latitude']
tr = []; ho = []
off = 0
for b in pf.iter_batches(batch_size=1_000_000, columns=cols):
    df = b.to_pandas()
    n = len(df)
    h = hold[off:off+n]; r = rnd[off:off+n]
    fare = df['fare_amount'].to_numpy(np.float32)
    ok = (fare >= 0.5) & (fare <= 500)
    sel = ok & (~h) & (r < 0.35)
    if sel.any():
        d = df.loc[sel]
        tr.append((d['pickup_latitude'].to_numpy(np.float32), d['pickup_longitude'].to_numpy(np.float32),
                   d['dropoff_latitude'].to_numpy(np.float32), d['dropoff_longitude'].to_numpy(np.float32),
                   fare[sel]))
    hsel = h
    if hsel.any():
        d = df.loc[hsel]
        ho.append((d['pickup_latitude'].to_numpy(np.float32), d['pickup_longitude'].to_numpy(np.float32),
                   d['dropoff_latitude'].to_numpy(np.float32), d['dropoff_longitude'].to_numpy(np.float32),
                   fare[hsel]))
    off += n
tr = [np.concatenate([x[i] for x in tr]) for i in range(5)]
ho = [np.concatenate([x[i] for x in ho]) for i in range(5)]
plat, plon, dlat, dlon, ytr = tr
hplat, hplon, hdlat, hdlon, yho = ho
print('train sample', len(ytr), 'hold', len(yho), flush=True)
prior = float(ytr.mean())
clean = (yho >= 0.5) & (yho <= 500) & (hplon >= -75) & (hplon <= -72) & (hdlon >= -75) & (hdlon <= -72) & \
        (hplat >= 39) & (hplat <= 42) & (hdlat >= 39) & (hdlat <= 42)
print('clean hold', clean.sum(), flush=True)

