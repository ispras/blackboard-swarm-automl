import numpy as np, pandas as pd, json, sys
FEAT="/download_job_code/payload/sandbox/workspaces/dubhe_tau/features"
MOD="/download_job_code/payload/sandbox/workspaces/dubhe_tau/models"
tag=sys.argv[1]
p=np.load(f"{MOD}/{tag}_valpred.npy").astype(np.float64)
idx=np.load(f"{MOD}/{tag}_validx.npy")
X=np.load(f"{FEAT}/X_full.npy", mmap_mode="r")
y=np.load(f"{FEAT}/y_full.npy", mmap_mode="r")
yv=np.asarray(y[idx],dtype=np.float64)
Xv=np.asarray(X[idx])
err=p-yv
rmse=lambda e: float(np.sqrt(np.mean(e**2)))
print("N",len(yv),"RMSE",rmse(err))
print("pred range",p.min(),p.max(),"y range",yv.min(),yv.max())
for lo,hi in [(0,5),(5,10),(10,15),(15,20),(20,30),(30,50),(50,100),(100,500)]:
    m=(yv>=lo)&(yv<hi)
    print(f"y[{lo},{hi}) n={m.sum():7d} rmse={rmse(err[m]):7.3f} bias={err[m].mean():7.3f}")
hav=Xv[:,12]
for lo,hi in [(0,1),(1,3),(3,5),(5,10),(10,20),(20,40),(40,1000)]:
    m=(hav>=lo)&(hav<hi)
    print(f"hav[{lo},{hi}) n={m.sum():7d} rmse={rmse(err[m]):7.3f} bias={err[m].mean():7.3f}")
print("worst 15:")
o=np.argsort(-np.abs(err))[:15]
for i in o:
    print(f"  y={yv[i]:8.2f} pred={p[i]:8.2f} err={err[i]:8.2f} hav={hav[i]:.2f} yr={Xv[i,5]:.0f} hr={Xv[i,8]:.0f} pax={Xv[i,4]:.0f}")
# clipped metrics
for c in [30,50,100,200]:
    print(f"clip y to {c}: rmse={rmse(np.clip(p,0,c)-np.clip(yv,0,c)):.3f}")
# exclude top pct errors
for q in [0.999,0.995,0.99]:
    t=np.quantile(np.abs(err),q); m=np.abs(err)<=t
    print(f"trim top {100*(1-q):.1f}%: rmse={rmse(err[m]):.3f} n={m.sum()}")
PY
