import numpy as np, pandas as pd, argparse, json, os
from scipy.optimize import nnls
ROOT="/download_job_code/payload/sandbox"
FEAT=f"{ROOT}/workspaces/dubhe_tau/features"

def load(preds):
    # preds: list of (name, holdout_csv, test_csv)
    ref=pd.read_csv(f"{FEAT}/holdout_reference.csv")
    base=ref.rename(columns={'fare_amount':'y'})
    H={}; T={}
    for name,hcsv,tcsv in preds:
        h=pd.read_csv(hcsv)
        h=h.groupby('key',as_index=False)['pred'].mean()
        base=base.merge(h.rename(columns={'pred':name}),on='key',how='inner')
        if tcsv is not None:
            t=pd.read_csv(tcsv)
            if 'pred' not in t.columns:
                t=t.rename(columns={'fare_amount':'pred'})
            T[name]=t.groupby('key',as_index=False)['pred'].mean()
    names=[n for n,_,_ in preds]
    base=base.dropna(subset=names)
    return base,names,T

def rmse(p,y): return float(np.sqrt(np.mean((np.asarray(p)-np.asarray(y))**2)))

def fit_w(P,y):
    # nonneg weights, no intercept
    w,_=nnls(P,y)
    return w

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--preds',nargs='+',required=True,help='name:holdout_csv:test_csv (test may be "-")')
    ap.add_argument('--out',default=f"{ROOT}/workspaces/dubhe_tau/blend/")
    ap.add_argument('--tag',default='blend')
    a=ap.parse_args(); os.makedirs(a.out,exist_ok=True)
    specs=[]
    for s in a.preds:
        parts=s.split(':'); name=parts[0]; hcsv=parts[1]; tcsv=parts[2] if len(parts)>2 and parts[2]!='-' else None
        specs.append((name,hcsv,tcsv))
    base,names,T=load(specs)
    y=base['y'].values.astype(np.float64); P=base[names].values.astype(np.float64)
    print("blend rows",len(y),"models",names)
    for i,n in enumerate(names): print(f"  {n:22s} rmse={rmse(P[:,i],y):.5f}")
    # 5-fold CV of weight fitting
    rng=np.random.default_rng(0); idx=rng.permutation(len(y)); folds=np.array_split(idx,5)
    pred=np.zeros(len(y))
    for k in range(5):
        te=folds[k]; tr=np.concatenate([folds[j] for j in range(5) if j!=k])
        w=fit_w(P[tr],y[tr]); pred[te]=P[te]@w
    print("CV blend rmse",rmse(pred,y))
    w=fit_w(P,y); print("weights",dict(zip(names,np.round(w,4))),"sum",w.sum())
    print("in-sample blend rmse",rmse(P@w,y))
    json.dump({'names':names,'weights':w.tolist(),'cv_rmse':rmse(pred,y),
               'insample':rmse(P@w,y)},open(f"{a.out}/{a.tag}_weights.json",'w'),indent=2)
    # test blend
    test=pd.read_csv(f"{ROOT}/data/test.csv")[['key']]
    W=np.zeros(len(test)); ws=np.zeros(len(test))
    for i,n in enumerate(names):
        if n in T:
            m=test.merge(T[n].rename(columns={'pred':f'p_{n}'}),on='key',how='left')
            W+=np.nan_to_num(m[f'p_{n}'].values)*w[i]; ws+=np.nan_to_num(m[f'p_{n}'].values)*0+ (w[i] if m[f'p_{n}'].notna().all() else 0)
    # fallback: if some model missing test values, renormalize
    have=np.zeros(len(test))
    pred=np.zeros(len(test))
    for i,n in enumerate(names):
        if n in T:
            m=test.merge(T[n].rename(columns={'pred':f'p_{n}'}),on='key',how='left')
            v=m[f'p_{n}'].values; ok=~np.isnan(v)
            pred[ok]+=v[ok]*w[i]; have[ok]+=w[i]
    pred=np.where(have>0,pred/np.where(have>0,have,1),np.nan)
    out=pd.DataFrame({'key':test['key'],'fare_amount':pred})
    out.to_csv(f"{a.out}/{a.tag}_test_raw.csv",index=False)
    print("saved",f"{a.out}/{a.tag}_test_raw.csv","nan",np.isnan(pred).sum())

