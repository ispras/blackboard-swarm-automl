      "| global mean rmse",rmse(np.full(len(yph),yph.mean()),yph))
ok=pu_full|do_full
pfall=np.where(ok[pho],pp,oth_glob)
print("partial model + fallback rmse",rmse(pfall,yph))
bst.save_model(f"{OUT}/partial_model.json")
json.dump({"az_glob":az_glob,"oth_glob":oth_glob,
           "partial_best_iter":int(bst.best_iteration),
           "partial_rmse":rmse(pp,yph),"partial_rmse_with_fallback":rmse(pfall,yph)},
          open(f"{OUT}/fallback_meta.json","w"),indent=2)
print("saved",OUT)
