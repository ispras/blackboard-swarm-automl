R['do_ok']=(R.dropoff_longitude.between(-75,-72))&(R.dropoff_latitude.between(39,42))&(R.dropoff_longitude!=0)
TR=R[~R.is_ho]
print("train matched",len(TR),flush=True)
g_all=TR.groupby(['dt','passenger_count'])['fare_amount'].agg(['mean','count'])
g_ok=TR[TR.pu_ok&TR.do_ok].groupby(['dt','passenger_count'])['fare_amount'].mean().rename('mean_ok')
g_ok2=TR[TR.pu_ok|TR.do_ok].groupby(['dt','passenger_count'])['fare_amount'].mean().rename('mean_ok2')
az=hf.loc[allz,['fare_amount','passenger_count']].copy(); az['dt']=dts[allz]
az=az.merge(g_all.reset_index(),on=['dt','passenger_count'],how='left').merge(g_ok.reset_index(),on=['dt','passenger_count'],how='left').merge(g_ok2.reset_index(),on=['dt','passenger_count'],how='left')
def rmse(a,b): return float(np.sqrt(np.mean((np.asarray(a)-np.asarray(b))**2)))
y=az['fare_amount'].values
print("baseline mean rmse",rmse(np.full(len(y),y.mean()),y))
for col in ['mean_ok','mean_ok2','mean']:
    ok=az[col].notna().values
    p=az[col].values
    print(col,"matched",int(ok.sum()),"frac",round(float(ok.mean()),3),
          "rmse_matched",round(rmse(p[ok],y[ok]),3) if ok.any() else None,
          "corr",round(float(np.corrcoef(p[ok],y[ok])[0,1]),3) if ok.sum()>2 else None,
          "combined_rmse",round(rmse(np.where(ok,p,y.mean()),y),3))
# best: prefer ok, then ok2, then all
p=np.where(az.mean_ok.notna(),az.mean_ok,np.where(az.mean_ok2.notna(),az.mean_ok2,np.where(az['mean'].notna(),az['mean'],y.mean())))
print("combined best rmse",rmse(p,y))
