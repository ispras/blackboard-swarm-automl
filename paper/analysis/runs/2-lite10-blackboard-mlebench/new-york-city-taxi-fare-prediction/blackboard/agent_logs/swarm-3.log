    uk,codes=np.unique(keys,return_inverse=True); K=len(uk)
    istr=f>=0; cs=codes[istr]; fs=f[istr]; ys=target[istr]
    sum_tot=np.bincount(cs,weights=ys,minlength=K); cnt_tot=np.bincount(cs,minlength=K)
    combo=cs.astype(np.int64)*NF+fs.astype(np.int64)
    sum_f=np.bincount(combo,weights=ys,minlength=K*NF).reshape(K,NF); cnt_f=np.bincount(combo,minlength=K*NF).reshape(K,NF)
    s=sum_tot[codes].copy(); c=cnt_tot[codes].astype(np.float64); m=f>=0
    s[m]-=sum_f[codes[m],f[m]]; c[m]-=cnt_f[codes[m],f[m]]
    return uk,sum_tot,cnt_tot,((s+prior*ALPHA)/(c+ALPHA)).astype(np.float32),np.log1p(cnt_tot[codes]).astype(np.float32)
