import numpy as np, pandas as pd
BASE="/download_job_code/payload/sandbox/workspaces/deneb_phi"; ROOT="/download_job_code/payload/sandbox"
hf=pd.read_parquet(f"{BASE}/holdout_feats.parquet"); hk=pd.read_csv(f"{BASE}/holdout_keys.csv")
print(len(hf),len(hk))
assert len(hf)==len(hk)
plon=hf.pickup_longitude.values;plat=hf.pickup_latitude.values;dlo=hf.dropoff_longitude.values;dlat=hf.dropoff_latitude.values
allz=(plon==0)&(plat==0)&(dlo==0)&(dlat==0)
keys=hk['key'].values
print("allzero holdout",allz.sum())
target=set(keys[allz][:].astype(str))
print("target dts",len(target),list(target)[:2])
rows=[]
reader=pd.read_csv(f"{ROOT}/data/labels.csv",chunksize=2_000_000,
    dtype={'fare_amount':np.float32,'pickup_longitude':np.float32,'pickup_latitude':np.float32,
           'dropoff_longitude':np.float32,'dropoff_latitude':np.float32,'passenger_count':np.float32})
tot=0
for ch in reader:
    tot+=len(ch)
    dt=ch['key'].str.slice(0,19)
    m=dt.isin(target)
    if m.any():
        s=ch.loc[m].copy(); s['dt']=dt[m].values
        s['is_ho']=(pd.util.hash_array(s['key'].values)%100==0)
        rows.append(s)
    if tot%10000000<2000000: print("read",tot,flush=True)
print("done read",tot,"matched rows",sum(len(r) for r in rows) if rows else 0)
if not rows:
    print("NO MATCHES"); raise SystemExit
R=pd.concat(rows,ignore_index=True)
R['pu_ok']=(R.pickup_longitude!=0)&(R.pickup_latitude!=0)&(R.pickup_longitude.between(-75,-72))&(R.pickup_latitude.between(39,42))
R['do_ok']=(R.dropoff_longitude!=0)&(R.dropoff_latitude!=0)&(R.dropoff_longitude.between(-75,-72))&(R.dropoff_latitude.between(39,42))
# train only
TR=R[~R.is_ho].copy()
print("train matched",len(TR),"hold matched",int(R.is_ho.sum()))
hd=hk.copy(); hd['dt']=hd['key'].str.slice(0,19)
hd['pax']=hf.passenger_count.values
hd['y']=hf.fare_amount.values
azh=hd[allz].copy()
# match per row
preds=np.full(len(azh),np.nan); src=np.zeros(len(azh),dtype=int)
tr_by=TR.groupby(['dt','passenger_count'])
for i,(dt,pax) in enumerate(zip(azh['dt'].values,azh['pax'].values)):
    key=(dt,pax)
    if key in tr_by.groups:
        g=TR[(TR.dt==dt)&(TR.passenger_count==pax)]
        v=g[g.pu_ok&g.do_ok]
        if len(v)>0:
            preds[i]=v.fare_amount.mean(); src[i]=1
        else:
            preds[i]=g.fare_amount.mean(); src[i]=2
ok=~np.isnan(preds)
print("matched frac",ok.mean(),"src1",int((src==1).sum()),"src2",int((src==2).sum()))
def rmse(a,b): return float(np.sqrt(np.mean((np.asarray(a)-np.asarray(b))**2)))
y=azh['y'].values
print("baseline mean rmse",rmse(np.full(len(y),y.mean()),y))
if ok.any():
    print("matched subset rmse",rmse(preds[ok],y[ok]),"corr",np.corrcoef(preds[ok],y[ok])[0,1])
    pp=np.where(ok,preds,y.mean())
    print("combined rmse",rmse(pp,y))
