print(pd.Series(cat).value_counts().to_dict())
d['_cat']=cat

ho=mask; tr=~mask
def rmse(p,y): return float(np.sqrt(np.mean((np.asarray(p)-y)**2)))

# ---- allzero fallback: group mean (year,hour,pax) fit on training allzero ----
az_tr=(cat=='allzero')&tr
g=d[az_tr].groupby(['year','hour','passenger_count'])['fare_amount'].agg(['mean','count'])
az_glob=float(d.loc[az_tr,'fare_amount'].mean())
az_ho=(cat=='allzero')&ho
idx=pd.MultiIndex.from_frame(d.loc[az_ho,['year','hour','passenger_count']])
p_az=g['mean'].reindex(idx).to_numpy(); p_az=np.where(np.isnan(p_az),az_glob,p_az)
y_az=fare[az_ho]
print("allzero fallback rmse",rmse(p_az,y_az),"global",az_glob)
g.reset_index().to_csv(f"{OUT}/fallback_allzero.csv",index=False)

# ---- oob / other (non-swap, non-allzero) global mean ----
oth_tr=(cat=='other')&tr
oth_glob=float(d.loc[oth_tr,'fare_amount'].mean())
oth_ho=(cat=='other')&ho
print("other global mean",oth_glob,"train n",oth_tr.sum(),"holdout rmse",
      rmse(np.full(oth_ho.sum(),oth_glob),fare[oth_ho]))

# ---- partialzero dedicated model ----
CEN=(40.7580,-73.9855); JFK=(40.6413,-73.7781); LGA=(40.7769,-73.8740); EWR=(40.6895,-74.1745)
R=6371.0088
def hav(lat1,lon1,lat2,lon2):
    lat1=np.radians(lat1);lat2=np.radians(lat2);dlat=lat2-lat1;dlon=np.radians(lon2-lon1)
    a=np.sin(dlat/2)**2+np.cos(lat1)*np.cos(lat2)*np.sin(dlon/2)**2
    return R*2*np.arcsin(np.sqrt(np.clip(a,0,1)))

def partial_feats(df):
    plon=df.pickup_longitude.values;plat=df.pickup_latitude.values
    dlo=df.dropoff_longitude.values;dlat=df.dropoff_latitude.values
    pu_ok=(plon!=0)&(plat!=0); do_ok=(dlo!=0)&(dlat!=0)
    # choose valid endpoint
    use_pu=pu_ok
    vlat=np.where(use_pu,plat,dlat); vlon=np.where(use_pu,plon,dlo)
    side=use_pu.astype(np.float32)
    okend=pu_ok|do_ok
    dcen=hav(vlat,vlon,*CEN); dj=hav(vlat,vlon,*JFK); dl=hav(vlat,vlon,*LGA); de=hav(vlat,vlon,*EWR)
    amin=np.minimum(np.minimum(dj,dl),de)
    F=np.column_stack([side,okend.astype(np.float32),vlat,vlon,dcen,dj,dl,de,amin,
                       (amin<2).astype(np.float32),
                       df.year.values,df.month.values,df.day.values,df.hour.values,
                       df.minute.values,df.weekday.values,df.passenger_count.values]).astype(np.float32)
    return F
part=(cat=='other')&zero
print("partialzero total",part.sum())
ptr=part&tr; pho=part&ho
Xp=partial_feats(d.loc[ptr]); yp=fare[ptr]
Xph=partial_feats(d.loc[pho]); yph=fare[pho]
print("partial train",Xp.shape,"holdout",Xph.shape,"holdout mean",yph.mean())
dtr=xgb.DMatrix(Xp,label=yp); dho=xgb.DMatrix(Xph,label=yph)
params=dict(objective='reg:squarederror',eval_metric='rmse',tree_method='hist',max_depth=6,
            eta=0.05,subsample=0.8,colsample_bytree=0.9,min_child_weight=30,nthread=4)
bst=xgb.train(params,dtr,600,evals=[(dho,'ho')],early_stopping_rounds=40,verbose_eval=False)
pp=bst.predict(dho)
