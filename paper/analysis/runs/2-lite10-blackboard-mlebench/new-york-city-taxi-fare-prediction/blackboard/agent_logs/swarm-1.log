import sys, pandas as pd, numpy as np
sys.path.insert(0,'workspaces/deneb_phi')
import postprocess as PP
h=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
p=pd.read_csv('workspaces/deneb_phi/lgb_big_holdout_pred.csv')
y=p.fare_amount.values.astype(float); pred=p.pred.values.astype(float)
table,gmean=PP.build_fallback_table('workspaces/deneb_phi/holdout_feats.parquet')
pp,mask=PP.apply_postprocess(pred,h,table,gmean)
def rmse(a,b): return float(np.sqrt(np.mean((np.asarray(a,float)-np.asarray(b,float))**2)))
ni=~PP.invalid_coord_mask(h)
print('raw all',round(rmse(y,pred),4),'clean',round(rmse(y[ni],pred[ni]),4))
print('post all',round(rmse(y,pp),4),'n_invalid',int(mask.sum()))
# test submission
feats=pd.read_parquet('workspaces/deneb_phi/features_test.parquet')
sub=pd.read_csv('workspaces/deneb_phi/lgb_big_submission.csv')
assert (sub.key.values==feats.key.values).all()
tp,_=PP.apply_postprocess(sub.fare_amount.values,feats,table,gmean)
pd.DataFrame({'key':sub.key,'fare_amount':tp}).to_csv('final_solution/submission.csv',index=False)
print('wrote final_solution', tp.min(), tp.mean(), tp.max())
# also save postprocessed holdout preds for blender
pd.DataFrame({'key':p.key,'fare_amount':y,'pred':pp}).to_csv('workspaces/deneb_phi/lgb_big_holdout_pred_pp.csv',index=False)
EOF
