import pandas as pd, numpy as np
h=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
p=pd.read_csv('workspaces/deneb_phi/lgb_big_holdout_pred.csv')
y=p.fare_amount.values.astype(float); pr=p.pred.values.astype(float)
plon=h.pickup_longitude.values;plat=h.pickup_latitude.values;dlo=h.dropoff_longitude.values;dla=h.dropoff_latitude.values
def isbad(lat,lon):
    return (np.abs(lat-41.366138)<1e-4)&(np.abs(lon+73.137390)<1e-4)
badp=isbad(plat,plon); badd=isbad(dla,dlo); bad=badp|badd
# ocean region south of Long Island: lat 39.55-39.70, lon -73.99..-73.93
ocean=((plat>39.55)&(plat<39.70)&(plon>-74.0)&(plon<-73.90))|((dla>39.55)&(dla<39.70)&(dlo>-74.0)&(dlo<-73.90))
nz=(plon!=0)&(plat!=0)&(dlo!=0)&(dla!=0)
inbox=(plon>=-75)&(plon<=-72)&(dlo>=-75)&(dlo<=-72)&(plat>=39)&(plat<=42)&(dla>=39)&(dla<=42)
clean=nz&inbox&(y>=0.5)&(y<=500)
for name,m in [('placeholder',bad&clean),('ocean',ocean&clean),('both',(bad|ocean)&clean)]:
    if m.sum():
        cur=np.sqrt(np.mean((y[m]-pr[m])**2)); g=y[clean].mean()
        print(f'{name}: n={m.sum()} ymean={y[m].mean():.1f} ystd={y[m].std():.1f} predmean={pr[m].mean():.1f} predRMSE={cur:.2f} const(global {g:.1f})RMSE={np.sqrt(np.mean((y[m]-g)**2)):.2f} const(submean)={y[m].std():.2f}')
# effect of fallback both on full clean
pr2=pr.copy(); mm=(bad|ocean)&clean; pr2[mm]=y[clean].mean()
print('clean base',np.sqrt(np.mean((y[clean]-pr[clean])**2)),'after bad-fallback',np.sqrt(np.mean((y[clean]-pr2[clean])**2)))
# test counts
t=pd.read_parquet('workspaces/deneb_phi/features_test.parquet')
