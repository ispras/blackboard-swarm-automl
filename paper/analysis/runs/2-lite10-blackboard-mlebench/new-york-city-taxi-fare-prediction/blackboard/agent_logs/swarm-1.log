import sys, numpy as np, pandas as pd, lightgbm as lgb
sys.path.insert(0,'workspaces/deneb_phi'); sys.path.insert(0,'workspaces/dubhe_tau')
import stacking as S
from sklearn.model_selection import KFold
from scipy.optimize import nnls
hf=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
names='xgb_te2,xgb_te,xgb_te3,nn_te,nn_emb'.split(',')
H,T,names=S.load_all(names)
raw=['haversine','hour','weekday','year','month','airport_min','is_airport','passenger_count','bearing','p50','p90']
# member-level stats as meta
H['mmean']=H[names].mean(axis=1); H['mstd']=H[names].std(axis=1)
for c in ['haversine','hour','weekday','year','month','airport_min','is_airport','passenger_count','bearing']:
    H[c]=hf[c].to_numpy()
H['log_hav']=np.log1p(H['haversine'])
fit=H[names].notna().all(axis=1)&H['clean'].to_numpy()
y=H.loc[fit,'y'].to_numpy(float)
A=H.loc[fit,names].to_numpy(float)
def rmse(a,b): return float(np.sqrt(np.mean((np.asarray(a,float)-np.asarray(b,float))**2)))
kf=KFold(5,shuffle=True,random_state=7)
# baseline NNLS
o_n=np.zeros(len(y))
for tr,va in kf.split(A):
    w,_=nnls(A[tr],y[tr]); o_n[va]=A[va]@w
print('NNLS CV',round(rmse(y,o_n),5))
for use_meta,label in [(False,'LGBM meta member-only'),(True,'LGBM meta + features')]:
    cols=names+(['haversine','log_hav','hour','weekday','year','month','airport_min','is_airport','passenger_count','bearing','mmean','mstd'] if use_meta else [])
    X=H.loc[fit,cols].to_numpy(float)
    o=np.zeros(len(y))
    for tr,va in kf.split(X):
        m=lgb.LGBMRegressor(objective='regression',num_leaves=31,learning_rate=0.03,n_estimators=600,
            min_child_samples=500,feature_fraction=0.9,bagging_fraction=0.8,bagging_freq=1,verbose=-1,num_threads=8)
        m.fit(X[tr],y[tr],eval_set=[(X[va],y[va])],callbacks=[lgb.early_stopping(50,verbose=False)])
        o[va]=m.predict(X[va])
    print(label,'CV',round(rmse(y,o),5))
EOF
