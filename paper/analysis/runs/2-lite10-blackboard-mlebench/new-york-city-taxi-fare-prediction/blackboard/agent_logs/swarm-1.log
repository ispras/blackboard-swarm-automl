import glob, numpy as np, pandas as pd, pyarrow.parquet as pq
files=sorted(glob.glob('workspaces/procyon_alpha/feat/train_*.parquet'))
keys=[]
for f in files:
    t=pq.read_table(f, columns=['key','hashmod'])
    df=t.to_pandas(); df=df[df['hashmod']==0]
    keys.append(df['key'].to_numpy())
keys=np.concatenate(keys)
print('val keys',len(keys),'unique',len(np.unique(keys)))
np.save('workspaces/procyon_alpha/val_keys.npy', keys)
y=np.load('workspaces/procyon_alpha/mmap/yval.npy')
assert len(y)==len(keys)
for tag in ['v2_full','v2_22m']:
    p=np.load(f'workspaces/procyon_alpha/lgb_{tag}_valpred.npy')
    assert len(p)==len(keys), (tag,len(p),len(keys))
    pd.DataFrame({'key':keys,'fare_amount':y,'pred':p}).to_csv(f'workspaces/procyon_alpha/lgb_{tag}_holdout_pred.csv',index=False)
    print(tag,'rmse',float(np.sqrt(np.mean((p-y)**2))))
# test
t=pq.read_table('workspaces/procyon_alpha/feat/test.parquet', columns=['key'])
tk=t.column('key').to_pandas().to_numpy()
for tag in ['v2_full','v2_22m']:
    fn=f'workspaces/procyon_alpha/lgb_{tag}_testpred.npy'
    import os
    if not os.path.exists(fn): 
        print('missing',fn); continue
    p=np.load(fn)
    pd.DataFrame({'key':tk,'fare_amount':p}).to_csv(f'workspaces/procyon_alpha/lgb_{tag}_test.csv',index=False)
    print(tag,'test',len(p))
