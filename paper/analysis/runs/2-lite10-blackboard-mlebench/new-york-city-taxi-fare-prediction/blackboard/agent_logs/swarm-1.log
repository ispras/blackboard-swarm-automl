    for tr,va in kf.split(A):
        r=Ridge(alpha=1.0).fit(A[tr],y[tr]); o_r[va]=r.predict(A[va])
        w,_=nnls(A[tr],y[tr]); o_n[va]=A[va]@w
    print(f'seed{seed}: Ridge {rmse(y,o_r):.5f}  NNLS {rmse(y,o_n):.5f}  diff {rmse(y,o_n)-rmse(y,o_r):+.5f}')
