h=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
p=pd.read_csv('workspaces/deneb_phi/lgb_v2_holdout_pred.csv')
assert len(h)==len(p)
y=h.fare_amount.values.astype(np.float64); pred=p.pred.values.astype(np.float64)
def rmse(a,b): return float(np.sqrt(np.mean((a-b)**2)))
zero=((h.pickup_latitude==0)|(h.pickup_longitude==0)|(h.dropoff_latitude==0)|(h.dropoff_longitude==0)).values
oob=(~((h.pickup_longitude.between(-75,-72))&(h.dropoff_longitude.between(-75,-72))&(h.pickup_latitude.between(39,42))&(h.dropoff_latitude.between(39,42)))).values
same=(h.haversine<0.01).values
valid=(y>=0.5)&(y<=500)&(~oob)
print('n zero',zero.sum(),'oob',oob.sum(),'same',same.sum(),'valid',valid.sum())
print('zero actual mean/median', y[zero].mean(), np.median(y[zero]), 'pred mean', pred[zero].mean(), 'rmse', rmse(y[zero],pred[zero]))
print('oob actual mean/median', y[oob].mean(), np.median(y[oob]), 'pred mean', pred[oob].mean(), 'rmse', rmse(y[oob],pred[oob]))
print('same actual mean', y[same].mean(), 'pred mean', pred[same].mean(),'rmse',rmse(y[same],pred[same]))
print('BASE all', rmse(y,pred), 'valid', rmse(y[valid],pred[valid]))
# fallback for zero/oob: replace pred with global mean of valid fares (from train approx)
gmean=y[valid].mean(); gmed=np.median(y[valid])
print('gmean',gmean,'gmed',gmed)
for name,mask in [('zero',zero),('oob',oob),('zero|oob',zero|oob)]:
    for fb,val in [('gmean',gmean),('gmed',gmed),('optmean',y[mask].mean()),('optmed',np.median(y[mask]))]:
        pr=pred.copy(); pr[mask]=val
        print(f'  fallback {name:8s} {fb:8s}={val:.2f} -> all {rmse(y,pr):.4f} valid {rmse(y[valid],pr[valid]):.4f}')
# hour-conditioned mean for zero
print('--- by-hour mean of zero rows vs valid ---')
for hh in range(24):
    m=zero&(h.hour==hh)
    if m.sum()>3:
        print(hh, m.sum(), round(y[m].mean(),1), 'validhourmean', round(y[valid&(h.hour==hh)].mean(),1))
# global calibration
A=np.vstack([pred,np.ones_like(pred)]).T
coef,_,_,_=np.linalg.lstsq(A,y,rcond=None)
cal=pred*coef[0]+coef[1]
print('calib coef',coef,'rmse cal',rmse(y,cal),'valid',rmse(y[valid],cal[valid]))
# clipping
for lo,hi in [(0,None),(2.5,None),(2.5,80),(2.5,60),(0,60),(1,50)]:
    pr=np.clip(pred,lo,hi if hi else 1e9)
    print('clip',lo,hi,'all',round(rmse(y,pr),4),'valid',round(rmse(y[valid],pr[valid]),4))
# rounding
for step in [0.5,1.0]:
    pr=np.round(pred/step)*step
    print('round',step,'all',round(rmse(y,pr),4),'valid',round(rmse(y[valid],pr[valid]),4))
