[0m$ [0mcd /download_job_code/payload/sandbox; pyenv shell sis-black; python - <<'EOF'
import sys, numpy as np, pandas as pd
sys.path.insert(0,'workspaces/deneb_phi'); sys.path.insert(0,'workspaces/dubhe_tau')
import stacking as S, postprocess_final as DPP
from sklearn.linear_model import Ridge
from sklearn.model_selection import KFold
from scipy.optimize import nnls
hf=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
def run(names, tag):
    H,T,names=S.load_all(names)
    for c in ['month','day','minute','pickup_longitude','pickup_latitude','dropoff_longitude','dropoff_latitude']:
        H[c]=hf[c].to_numpy()
    fit=H[names].notna().all(axis=1)&H['clean'].to_numpy()
    A=H.loc[fit,names].to_numpy(float); y=H.loc[fit,'y'].to_numpy(float)
    def rmse(a,b): return float(np.sqrt(np.mean((np.asarray(a,float)-np.asarray(b,float))**2)))
    kf=KFold(5,shuffle=True,random_state=7); o=np.zeros(len(y))
    for tr,va in kf.split(A):
        w,_=nnls(A[tr],y[tr]); o[va]=A[va]@w
    w,_=nnls(A,y)
    # full holdout
    Xall=H[names].to_numpy(float); Xall=np.where(np.isnan(Xall),np.nanmean(Xall[fit],axis=0),Xall)
    ph=Xall@w; yall=H['y'].to_numpy(float)
    pp=DPP.apply_postprocess(ph,H,verbose=False)
    print(f'[{tag}] NNLS CV clean {rmse(y,o):.5f} | in-sample clean {rmse(y,A@w):.5f} | POSTPROC full {rmse(yall,pp):.5f}')
    print('   weights', dict(zip(names,np.round(w,3))))
run('xgb_te2,xgb_te,nn_te,nn_emb'.split(','),'core4')
run('xgb_te2,xgb_te,xgb_b512,nn_te,nn_emb,lgb_big'.split(','),'+gbdt')
run('xgb_te2,xgb_te,xgb_b512,xgb_aug,xgb_full,nn_te,nn_emb,lgb_big,lgb_te2,cat_gpu'.split(','),'all')
EOF
