import pandas as pd, numpy as np
h=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
p=pd.read_csv('workspaces/deneb_phi/lgb_big_holdout_pred.csv')
y=p.fare_amount.values.astype(float); pr=p.pred.values.astype(float); hav=h.haversine.values
plon=h.pickup_longitude.values;plat=h.pickup_latitude.values;dlo=h.dropoff_longitude.values;dla=h.dropoff_latitude.values
inbox=(plon>=-75)&(plon<=-72)&(dlo>=-75)&(dlo<=-72)&(plat>=39)&(plat<=42)&(dla>=39)&(dla<=42)
nz=(plon!=0)&(plat!=0)&(dlo!=0)&(dla!=0)
clean=inbox&nz&(y>=0.5)&(y<=500)
m=clean&(y>100)
print('y>100 clean n',m.sum())
print('hav quantiles',np.quantile(hav[m],[0,.1,.25,.5,.75,.9,1]))
print('frac hav<5',(hav[m]<5).mean(),'hav<10',(hav[m]<10).mean(),'hav>20',(hav[m]>20).mean())
print('pred mean',pr[m].mean(),'y mean',y[m].mean())
# correlation pred/y
print('corr',np.corrcoef(pr[m],np.clip(y[m],0,500))[0,1])
# if we predicted distance-based fare? Let's see linear fit fare vs hav on clean bulk
mm=clean&(y<100)
A=np.vstack([hav[mm],np.ones(mm.sum())]).T
coef=np.linalg.lstsq(A,y[mm],rcond=None)[0]
predlin=hav[m]*coef[0]+coef[1]
print('linear-dist pred on >100 rmse',np.sqrt(np.mean((y[m]-predlin)**2)),'model rmse',np.sqrt(np.mean((y[m]-pr[m])**2)))
# within y 50-100 distance composition
m2=clean&(y>=50)&(y<=100)
print('y50-100 n',m2.sum(),'hav median',np.median(hav[m2]),'frac hav>20',(hav[m2]>20).mean())
