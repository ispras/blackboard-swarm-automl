import sys, json, numpy as np, pandas as pd
sys.path.insert(0,'workspaces/dubhe_tau')
import postprocess_final as DPP
test=pd.read_csv('data/test.csv',dtype={'key':str}); keys=test.key.values
def blend(weights):
    b=np.zeros(len(keys)); ws=0
    for n,w in weights.items():
        d=pd.read_csv(f'workspaces/dubhe_tau/models/{n}_test.csv',dtype={'key':str})
        col='pred' if 'pred' in d.columns else 'fare_amount'
        v=d.set_index('key')[col].reindex(keys).to_numpy(float)
        assert not np.isnan(v).any(), n
        b+=w*v; ws+=w
    b/=ws
    return DPP.apply_postprocess(b,test)
sub=pd.read_csv('final_solution/submission.csv')
for tag in ['final18','V1']:
    j=json.load(open(f'workspaces/dubhe_tau/blend/{tag}_weights.json'))
    w=dict(zip(j['names'],j['weights']))
    p=blend(w)
    d=np.abs(p-sub.fare_amount.values)
    print(tag,'max|d|',d.max(),'n>0.01',(d>0.01).sum(),'cv',j.get('cv_nnls'))
EOF
