import pandas as pd, numpy as np
h=pd.read_parquet('workspaces/deneb_phi/holdout_feats.parquet')
p=pd.read_csv('workspaces/deneb_phi/lgb_big_holdout_pred.csv')
y=p.fare_amount.values.astype(float); pr=p.pred.values.astype(float); hav=h.haversine.values
clean=~(((h.pickup_latitude==0)|(h.pickup_longitude==0)|(h.dropoff_latitude==0)|(h.dropoff_longitude==0)).values)
def rmse(m): return float(np.sqrt(np.mean((y[m]-pr[m])**2)))
for thr in [30,40,50,60,80,100]:
    m=clean&(hav>thr)
    if m.sum()==0: continue
    best=y[m].mean()
    cur=rmse(m)
    alt=float(np.sqrt(np.mean((y[m]-best)**2)))
    print(f'hav>{thr}: n={m.sum()} ymean={y[m].mean():.1f} ystd={y[m].std():.1f} predmean={pr[m].mean():.1f} curRMSE={cur:.2f} constRMSE={alt:.2f}')
# test counts
t=pd.read_parquet('workspaces/deneb_phi/features_test.parquet')
for thr in [30,50,80]:
    print('test hav>',thr,int((t.haversine>thr).sum()))
# combine rule: hav>50 override with const then full clean rmse
m0=clean.copy()
base=rmse(m0)
for thr in [50,60,80]:
    mm=clean&(hav>thr)
    pr2=pr.copy(); pr2[mm]=np.median(y[clean]) if False else y[m0].mean()
    print(f'override hav>{thr} -> global mean: clean RMSE {np.sqrt(np.mean((y[m0]-pr2[m0])**2)):.5f} (base {base:.5f})')
EOF
