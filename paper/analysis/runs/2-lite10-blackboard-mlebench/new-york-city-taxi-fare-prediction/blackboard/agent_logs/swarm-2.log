import numpy as np, pandas as pd
from scipy.optimize import nnls
from sklearn.linear_model import Ridge
from sklearn.model_selection import KFold

base=pd.read_csv('workspaces/procyon_alpha/lgb_v2_full_holdout_pred.csv')[['key','fare_amount','pred']]
base=base.rename(columns={'fare_amount':'y'}).drop_duplicates('key')
M={
 'lgb_proc':'workspaces/procyon_alpha/lgb_v2_full_holdout_pred.csv',
 'xgb_te2':'workspaces/dubhe_tau/models/xgb_te2_holdout_pred.csv',
 'xgb_te':'workspaces/dubhe_tau/models/xgb_te_holdout_pred.csv',
 'xgb_aug_b512':'workspaces/dubhe_tau/models/xgb_aug_b512_holdout_pred.csv',
 'xgb_aug':'workspaces/dubhe_tau/models/xgb_aug_d13_holdout_pred.csv',
 'xgb_full':'workspaces/dubhe_tau/models/xgb_full_d13_holdout_pred.csv',
 'nn_te':'workspaces/dubhe_tau/models/nn_te_holdout_pred.csv',
 'nn_emb':'workspaces/dubhe_tau/models/nn_emb_holdout_pred.csv',
 'lgb_big':'workspaces/deneb_phi/lgb_big_holdout_pred.csv',
 'lgb_te2':'workspaces/deneb_phi/lgb_te2_holdout_pred.csv',
 'cat_gpu':'workspaces/deneb_phi/cat_gpu_holdout_pred.csv',
}
df=base.copy()
for name,fp in M.items():
    d=pd.read_csv(fp)[['key','pred']].drop_duplicates('key').rename(columns={'pred':name})
    df=df.merge(d,on='key',how='inner')
print('common rows',len(df), 'y mean',df.y.mean())
y=df.y.to_numpy(np.float64)

def cv(cols, ridge=False, folds=5, seed=1):
    X=df[cols].to_numpy(np.float64)
    kf=KFold(folds,shuffle=True,random_state=seed)
    oof=np.zeros(len(y)); W=[]
    for tr,te in kf.split(X):
        if ridge:
            m=Ridge(alpha=1.0,positive=False,fit_intercept=True).fit(X[tr],y[tr])
            oof[te]=m.predict(X[te]); W.append(np.r_[m.intercept_,m.coef_])
        else:
            # nnls with intercept via centering
            Xm=X[tr].mean(0); ym=y[tr].mean()
            w,_=nnls(X[tr]-Xm, y[tr]-ym)
            b=ym-Xm@w
            oof[te]=X[te]@w+b; W.append(np.r_[b,w])
    rmse=float(np.sqrt(np.mean((oof-y)**2)))
    Wm=np.mean(W,0)
    return rmse, Wm

sets={
 'te2+te+nn_te+nn_emb':['xgb_te2','xgb_te','nn_te','nn_emb'],
 'te2+te+nn_te+nn_emb+proc':['xgb_te2','xgb_te','nn_te','nn_emb','lgb_proc'],
 'te2+te+proc':['xgb_te2','xgb_te','lgb_proc'],
 'all':list(M.keys()),
 'all_no_proc':[k for k in M if k!='lgb_proc'],
}
for nm,cols in sets.items():
    r,W=cv(cols)
    print(f'{nm:35s} NNLS_CV={r:.5f}')
for nm,cols in sets.items():
    r,W=cv(cols,ridge=True)
    print(f'{nm:35s} Ridge_CV={r:.5f}')

# best set detail
cols=['xgb_te2','xgb_te','nn_te','nn_emb','lgb_proc']
for seed in [1,7,42]:
    r,W=cv(cols,seed=seed)
    print('seed',seed,'NNLS',r,'weights',dict(zip(['b']+cols,np.round(W,4))))
r,W=cv(cols,ridge=True)
print('ridge weights',dict(zip(['b']+cols,np.round(W,4))))
EOF
