MEMB={
 'xgb_te2':'workspaces/dubhe_tau/models/xgb_te2',
 'xgb_te3':'workspaces/dubhe_tau/models/xgb_te3',
 'xgb_te':'workspaces/dubhe_tau/models/xgb_te',
 'xgb_te_res':'workspaces/dubhe_tau/models/xgb_te_res',
 'lgb_proc':f'{OUT}/lgb_v3te_full',
}
cols=list(MEMB)
base=pd.read_csv(f'{OUT}/lgb_v3te_full_holdout_pred.csv')[['key','fare_amount','pred']].rename(columns={'fare_amount':'y'}).drop_duplicates('key')
df=base.copy()
for name in cols:
    d=pd.read_csv(f'{MEMB[name]}_holdout_pred.csv')[['key','pred']].drop_duplicates('key').rename(columns={'pred':name})
    df=df.merge(d,on='key',how='inner')
print('holdout rows',len(df))
X=df[cols].to_numpy(np.float64); y=df.y.to_numpy(np.float64)
Xm=X.mean(0); ym=y.mean(); w,_=nnls(X-Xm,y-ym); b=ym-Xm@w
print('weights',dict(zip(['b']+cols,np.round(np.r_[b,w],4))))
pred=X@w+b
print('holdout blend clean RMSE',float(np.sqrt(np.mean((pred-y)**2))))
# test blend
tk=pd.read_csv('workspaces/procyon_alpha/lgb_v3te_full_test.csv')[['key']]
tdf=tk.copy()
for name in cols:
    d=pd.read_csv(f'{MEMB[name]}_test.csv')
    d=d.drop_duplicates('key').rename(columns={'fare_amount':name})
    tdf=tdf.merge(d[['key',name]],on='key',how='left')
print('test rows',len(tdf),'missing',tdf[cols].isna().sum().to_dict())
Xt=tdf[cols].to_numpy(np.float64)
ptest=Xt@w+b
pd.DataFrame({'key':tdf.key,'fare_amount':ptest}).to_csv(f'{OUT}/procyon_blend_test.csv',index=False)
print('test pred saved stats',ptest.mean(),ptest.min(),ptest.max())
