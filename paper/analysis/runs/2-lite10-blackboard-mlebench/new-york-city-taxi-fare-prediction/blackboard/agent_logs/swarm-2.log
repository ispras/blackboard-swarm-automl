 'xgb_te':'workspaces/dubhe_tau/models/xgb_te_holdout_pred.csv',
 'xgb_te_res':'workspaces/dubhe_tau/models/xgb_te_res_holdout_pred.csv',
 'xgb_aug_b512':'workspaces/dubhe_tau/models/xgb_aug_b512_holdout_pred.csv',
 'nn_te':'workspaces/dubhe_tau/models/nn_te_holdout_pred.csv',
 'nn_emb':'workspaces/dubhe_tau/models/nn_emb_holdout_pred.csv',
 'lgb_big':'workspaces/deneb_phi/lgb_big_holdout_pred.csv',
 'lgb_te2':'workspaces/deneb_phi/lgb_te2_holdout_pred.csv',
 'cat_gpu':'workspaces/deneb_phi/cat_gpu_holdout_pred.csv',
}
df=base.copy()
for name,fp in M.items():
    d=pd.read_csv(fp)[['key','pred']].drop_duplicates('key').rename(columns={'pred':name})
    df=df.merge(d,on='key',how='inner')
print('common rows',len(df))
y=df.y.to_numpy(np.float64)

def cv(cols,ridge=False,seed=1):
    X=df[cols].to_numpy(np.float64)
    kf=KFold(5,shuffle=True,random_state=seed); oof=np.zeros(len(y)); W=[]
    for tr,te in kf.split(X):
        if ridge:
            m=Ridge(alpha=1.0).fit(X[tr],y[tr]); oof[te]=m.predict(X[te]); W.append(np.r_[m.intercept_,m.coef_])
        else:
            Xm=X[tr].mean(0); ym=y[tr].mean(); w,_=nnls(X[tr]-Xm,y[tr]-ym); b=ym-Xm@w
            oof[te]=X[te]@w+b; W.append(np.r_[b,w])
    return float(np.sqrt(np.mean((oof-y)**2))), np.mean(W,0)

sets={
 'deneb4':['xgb_te2','xgb_te','nn_te','nn_emb'],
 'deneb5':['xgb_te2','xgb_te3','xgb_te','nn_emb','nn_te'],
 'deneb4+proc':['xgb_te2','xgb_te','nn_te','nn_emb','lgb_proc'],
 'deneb5+proc':['xgb_te2','xgb_te3','xgb_te','nn_emb','nn_te','lgb_proc'],
 'te2+te3+te+proc':['xgb_te2','xgb_te3','xgb_te','lgb_proc'],
