    for a in [0.3,1.0,3.0,10.0,30.0]:
        vr=[cv(cols,True,s,a) for s in seeds]
        print(f'   Ridge a={a:<5} {np.mean(vr):.5f} (std {np.std(vr):.5f})')
EOF
