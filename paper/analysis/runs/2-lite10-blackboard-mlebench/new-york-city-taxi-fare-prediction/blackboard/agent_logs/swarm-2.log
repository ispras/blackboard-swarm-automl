Xv=np.load(f'{OUT}/mmap/Xval_canon.npy')
fe=pd.DataFrame(Xv,columns=FEAT)
df['hav']=fe['haversine'].values; df['pair']=fe['p_air_min'].values; df['dair']=fe['d_air_min'].values
df['hour']=fe['hour'].values; df['weekday']=fe['weekday'].values
before=len(df); df=df.dropna(subset=cols).reset_index(drop=True); print('rows',before,'->',len(df))
Y=df.y.to_numpy(np.float64)
def fit_nnls(X,yy):
    Xm=X.mean(0); ym=yy.mean(); w,_=nnls(X-Xm,yy-ym); return w, ym-Xm@w
def eval_group(seg, use_lgb):
    c=cols if use_lgb else [x for x in cols if x!='lgb_proc']
    X=df[c].to_numpy(np.float64)
    kf=KFold(5,shuffle=True,random_state=1); oof=np.zeros(len(Y))
    for tr,te in kf.split(X):
        for g in np.unique(seg):
            mtr=tr[seg[tr]==g]; mte=te[seg[te]==g]
            if len(mte)==0: continue
            if len(mtr)<50:
                w,b=fit_nnls(X[tr],Y[tr])
            else:
                w,b=fit_nnls(X[mtr],Y[mtr])
            oof[mte]=X[mte]@w+b
    return float(np.sqrt(np.mean((oof-Y)**2)))
# global baseline
for ul in [True,False]:
    c=cols if ul else [x for x in cols if x!='lgb_proc']; Xg=df[c].to_numpy(np.float64)
    kf=KFold(5,shuffle=True,random_state=1); oof=np.zeros(len(Y))
    for tr,te in kf.split(Xg):
        w,b=fit_nnls(Xg[tr],Y[tr]); oof[te]=Xg[te]@w+b
    print('global use_lgb',ul,'CV',float(np.sqrt(np.mean((oof-Y)**2))))
# segments
hav=df.hav.values
dbins=np.digitize(hav,[1,2,3,5,8,12,20])
air=((df['pair'].values<2)|(df['dair'].values<2)).astype(int)
segs={'dist7':dbins,'air':air,'dist7_air':dbins*2+air,
      'dist3':np.digitize(hav,[2,8]),'dist3_air':np.digitize(hav,[2,8])*2+air}
for nm,seg in segs.items():
    print(nm,'ngroups',len(np.unique(seg)),'CV lgb',eval_group(seg,True),'CV nolgb',eval_group(seg,False))
# calibration check: linear+quadratic on blend
c=cols; Xg=df[c].to_numpy(np.float64)
kf=KFold(5,shuffle=True,random_state=1); oof=np.zeros(len(Y))
for tr,te in kf.split(Xg):
    w,b=fit_nnls(Xg[tr],Y[tr]); oof[te]=Xg[te]@w+b
print('blend raw CV',float(np.sqrt(np.mean((oof-Y)**2))))
# isotonic and quadratic
from sklearn.isotonic import IsotonicRegression
iso_oof=np.zeros(len(Y)); kf=KFold(5,shuffle=True,random_state=1)
for tr,te in kf.split(Xg):
    ir=IsotonicRegression(out_of_bounds='clip').fit(oof[tr],Y[tr]); iso_oof[te]=ir.predict(oof[te])
print('isotonic CV',float(np.sqrt(np.mean((iso_oof-Y)**2))))
quad=np.column_stack([oof,oof**2]); qo=np.zeros(len(Y))
for tr,te in kf.split(quad):
    from numpy.polynomial import polynomial as P
    coef=np.polyfit(quad[tr,0],Y[tr],2); qo[te]=np.polyval(coef,quad[te,0])
print('quadratic-cal CV',float(np.sqrt(np.mean((qo-Y)**2))))
EOF
