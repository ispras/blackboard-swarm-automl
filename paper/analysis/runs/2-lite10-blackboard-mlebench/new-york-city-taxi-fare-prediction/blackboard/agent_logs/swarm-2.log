    d=pd.read_csv(fp)[['key','pred']].drop_duplicates('key').rename(columns={'pred':name})
    df=df.merge(d,on='key',how='inner')
y=df.y.to_numpy(np.float64); print('rows',len(df))
def cv(cols,ridge=False,seed=1,alpha=1.0):
    X=df[cols].to_numpy(np.float64); kf=KFold(5,shuffle=True,random_state=seed); oof=np.zeros(len(y)); W=[]
    for tr,te in kf.split(X):
        if ridge:
            m=Ridge(alpha=alpha).fit(X[tr],y[tr]); oof[te]=m.predict(X[te]); W.append(np.r_[m.intercept_,m.coef_])
        else:
            Xm=X[tr].mean(0); ym=y[tr].mean(); w,_=nnls(X[tr]-Xm,y[tr]-ym); b=ym-Xm@w; oof[te]=X[te]@w+b; W.append(np.r_[b,w])
    return float(np.sqrt(np.mean((oof-y)**2))), np.mean(W,0)
