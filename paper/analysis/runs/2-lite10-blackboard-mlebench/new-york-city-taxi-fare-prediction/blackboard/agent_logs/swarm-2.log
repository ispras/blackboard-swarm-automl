from scipy.optimize import nnls
from sklearn.linear_model import Ridge
from sklearn.model_selection import KFold
base=pd.read_csv('workspaces/procyon_alpha/lgb_v3te_full_holdout_pred.csv')[['key','fare_amount','pred']].rename(columns={'fare_amount':'y'}).drop_duplicates('key')
M={'lgb_proc':'workspaces/procyon_alpha/lgb_v3te_full_holdout_pred.csv',
 'xgb_te2':'workspaces/dubhe_tau/models/xgb_te2_holdout_pred.csv',
 'xgb_te2b':'workspaces/dubhe_tau/models/xgb_te2b_holdout_pred.csv',
 'xgb_te3':'workspaces/dubhe_tau/models/xgb_te3_holdout_pred.csv',
 'xgb_te4':'workspaces/dubhe_tau/models/xgb_te4_holdout_pred.csv',
 'xgb_te':'workspaces/dubhe_tau/models/xgb_te_holdout_pred.csv',
 'xgb_te_res':'workspaces/dubhe_tau/models/xgb_te_res_holdout_pred.csv',
 'nn_te':'workspaces/dubhe_tau/models/nn_te_holdout_pred.csv',
 'nn_emb':'workspaces/dubhe_tau/models/nn_emb_holdout_pred.csv',
 'lgb_te2':'workspaces/deneb_phi/lgb_te2_holdout_pred.csv'}
df=base.copy()
for name,fp in M.items():
    d=pd.read_csv(fp)[['key','pred']].drop_duplicates('key').rename(columns={'pred':name})
    df=df.merge(d,on='key',how='inner')
y=df.y.to_numpy(np.float64); print('rows',len(df))
def cv(cols,ridge=False,seed=1,alpha=1.0):
    X=df[cols].to_numpy(np.float64); kf=KFold(5,shuffle=True,random_state=seed); oof=np.zeros(len(y))
    for tr,te in kf.split(X):
        if ridge:
            m=Ridge(alpha=alpha).fit(X[tr],y[tr]); oof[te]=m.predict(X[te])
        else:
            Xm=X[tr].mean(0); ym=y[tr].mean(); w,_=nnls(X[tr]-Xm,y[tr]-ym); oof[te]=X[te]@w+(ym-Xm@w)
    return float(np.sqrt(np.mean((oof-y)**2)))
seeds=[1,7,42,123,2024]
cands={
 'S2':['xgb_te2','xgb_te3','xgb_te','xgb_te_res','lgb_proc'],
