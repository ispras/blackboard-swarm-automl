}
print('--- single-model clean RMSE ---')
for k in M: print(f'{k:14s} {np.sqrt(np.mean((df[k]-y)**2)):.5f}')
print('--- blends ---')
for nm,cols in sets.items():
    rn,Wn=cv(cols); rr,Wr=cv(cols,ridge=True)
    print(f'{nm:22s} NNLS={rn:.5f} Ridge={rr:.5f}')
    print('   w',dict(zip(['b']+cols,np.round(Wn,4))))
