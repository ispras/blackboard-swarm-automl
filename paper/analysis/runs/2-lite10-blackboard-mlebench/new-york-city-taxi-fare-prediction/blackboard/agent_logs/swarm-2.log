import numpy as np, pandas as pd
from scipy.optimize import nnls
from sklearn.model_selection import KFold
base=pd.read_csv('workspaces/procyon_alpha/lgb_v3te_full_holdout_pred.csv')[['key','fare_amount']].rename(columns={'fare_amount':'y'}).drop_duplicates('key')
M={'xgb_te_res_d15':'workspaces/dubhe_tau/models/xgb_te_res_d15_holdout_pred.csv',
 'xgb_te2_d15':'workspaces/dubhe_tau/models/xgb_te2_d15_holdout_pred.csv','xgb_te3':'workspaces/dubhe_tau/models/xgb_te3_holdout_pred.csv',
 'xgb_te':'workspaces/dubhe_tau/models/xgb_te_holdout_pred.csv','xgb_te2':'workspaces/dubhe_tau/models/xgb_te2_holdout_pred.csv',
 'xgb_te_res':'workspaces/dubhe_tau/models/xgb_te_res_holdout_pred.csv','nn2':'workspaces/dubhe_tau/models/nn2_holdout_pred.csv',
 'nn_te':'workspaces/dubhe_tau/models/nn_te_holdout_pred.csv','nn_emb':'workspaces/dubhe_tau/models/nn_emb_holdout_pred.csv'}
df=base.copy()
for k,fp in M.items():
    d=pd.read_csv(fp)[['key','pred']].drop_duplicates('key').rename(columns={'pred':k}); df=df.merge(d,on='key',how='inner')
y=df.y.to_numpy(np.float64); print('rows',len(df))
def cv(cols,seed):
    X=df[cols].to_numpy(np.float64); kf=KFold(5,shuffle=True,random_state=seed); oof=np.zeros(len(y))
    for tr,te in kf.split(X):
        Xm=X[tr].mean(0); ym=y[tr].mean(); w,_=nnls(X[tr]-Xm,y[tr]-ym); oof[te]=X[te]@w+(ym-Xm@w)
    return float(np.sqrt(np.mean((oof-y)**2)))
sets={'8member':['xgb_te_res_d15','xgb_te2_d15','xgb_te3','xgb_te','xgb_te2','xgb_te_res','nn_emb','nn_te'],
 '7member_nn2':['xgb_te_res_d15','xgb_te2_d15','xgb_te3','xgb_te','xgb_te2','xgb_te_res','nn2'],
 '7member_nn2+both':['xgb_te_res_d15','xgb_te2_d15','xgb_te3','xgb_te','xgb_te2','xgb_te_res','nn2','nn_emb','nn_te']}
seeds=[1,7,42,123,2024]
for nm,cols in sets.items():
    v=[cv(cols,s) for s in seeds]; print(f'{nm:18s} CV {np.mean(v):.5f} +-{np.std(v):.5f}')
EOF
