import common as C
tr=C.load_train();Y=C.make_targets(tr);sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
cv=np.load("cv_cur.npy")
S68=np.load("knn_S_tr.npy").astype(np.float32); S107=np.load("S107_tr.npy").astype(np.float32)
def knn(S,k,p):
    N=S.shape[0]; idx=np.argpartition(-S,kth=k,axis=1)[:,:k]
    out=np.zeros((N,68,5),np.float32)
