import glob,os,numpy as np,sys
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/mirfak_iota')
import common as C
tr=C.load_train(); Y=C.make_targets(tr); sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
