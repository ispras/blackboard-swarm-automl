import numpy as np, common as C
from scipy.optimize import nnls
tr=C.load_train(); Y=C.make_targets(tr)
sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
folds=C.kfold_indices(len(tr),5,42); SC=[0,1,3]
P="/download_job_code/payload/sandbox/workspaces/betelgeuse_mu/preds/"
spec=["lstm256","lstm256s7","lstm384","mscnn256","cnn256","bigru"]
Pm=np.stack([np.load(P+f"oof_{n}.npy")[:,:68,:] for n in spec],0)
M=len(spec)

def ridge_fit(A,y,alpha):
    # A (M,N)
    X=A.T
    mu=X.mean(0); sd=X.std(0)+1e-6
    Xs=(X-mu)/sd
    ym=y.mean()
    w=np.linalg.solve(Xs.T@Xs+alpha*np.eye(M), Xs.T@(y-ym))
    return w,mu,sd,ym

def ridge_pred(w,mu,sd,ym,A):
    return (((A.T-mu)/sd)@w)+ym

def greedy(Pj,t,v,yv,rounds=30):
    # Caruana forward selection with replacement, on flattened
    A=Pj[:,t].reshape(M,-1); y=yv.reshape(-1)
    sel=[]
    cur=np.zeros_like(y); cnt=0
    best=(1e9,None)
    for r in range(rounds):
        cand=[]
        for m in range(M):
            p=(cur*cnt+A[m])/(cnt+1)
            e=np.mean((p-y)**2)
            cand.append(e)
        m=int(np.argmin(cand))
        cur=(cur*cnt+A[m])/(cnt+1); cnt+=1; sel.append(m)
        if cand[m]<best[0]: best=(cand[m],list(sel))
    return best[1]

for method in ["nnls","ridge1","ridge10","ridge100","mean","greedy"]:
    cv=np.zeros_like(Y)
    for j in SC:
        Pj=Pm[...,j]
        for k,(tidx,vidx) in enumerate(folds):
            t=tidx[sn[tidx]]; v=vidx[sn[vidx]]
            yv=Y[t,:,j]
            A=Pj[:,t]
            if method=="nnls":
                w,_=nnls(A.reshape(M,-1).T, yv.reshape(-1))
                pred=np.tensordot(w,Pj[:,v],axes=(0,0))
            elif method=="mean":
                pred=Pj[:,v].mean(0)
            elif method.startswith("ridge"):
                al=float(method[5:])
                w,mu,sd,ym=ridge_fit(A.reshape(M,-1), yv.reshape(-1), al)
                Bv=Pj[:,v].reshape(M,-1)
                pred=ridge_pred(w,mu,sd,ym,Bv).reshape(v.size,68)
            elif method=="greedy":
                sel=greedy(Pj,t,v,yv)
                pred=Pj[sel][:,v].mean(0)
            cv[v,:,j]=pred
    m,r=C.mcrmse(Y[sn],cv[sn])
    print(f"{method:8s} sn1={m:.5f} cols={['%.4f'%x for x in r]}",flush=True)
    np.save(f"bm_{method}.npy",cv)
EOF
