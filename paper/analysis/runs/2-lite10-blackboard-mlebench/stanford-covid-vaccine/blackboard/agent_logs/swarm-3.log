    m=mrows&sn
    mm=C.mcrmse(Y[m],a[m])[0] if m.sum()>50 else float('nan')
    tp=f.replace('oof_','test_')
    print(f"{os.path.basename(f)[4:-4]:26s} cov={''.join(str(int(x)) for x in cov)} sn1={mm:.4f} test={os.path.exists(tp)}")
EOF
