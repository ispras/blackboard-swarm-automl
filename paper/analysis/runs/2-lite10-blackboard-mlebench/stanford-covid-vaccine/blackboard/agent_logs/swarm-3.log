import numpy as np, common as C
tr=C.load_train(); Y=C.make_targets(tr)
sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
folds=C.kfold_indices(len(tr),5,42)
cv=np.load("ens1_cv.npy")
LOOPS=list("SMI BHEX".replace(" ",""))
loop=np.array([[LOOPS.index(c) if c in LOOPS else 0 for c in r["predicted_loop_type"][:68]] for r in tr])
BI={b:i for i,b in enumerate("ACGU")}
base=np.array([[BI.get(c,0) for c in r["sequence"][:68]] for r in tr])
SC=[0,1,3]

def fit_aff(x,y):
    A=np.vstack([x,np.ones_like(x)]).T
    a,b=np.linalg.lstsq(A,y,rcond=None)[0]
    return a,b

def run(mode):
    out=cv.copy()
    for j in SC:
        for t,v in folds:
            t=t[sn[t]]; v=v[sn[v]]
            if mode=="global":
                a,b=fit_aff(cv[t,:,j].ravel(), Y[t,:,j].ravel())
                out[v,:,j]=a*cv[v,:,j]+b
            else:
                grp = loop if mode=="loop" else base
                for g in np.unique(grp):
                    rt,ct=np.where(grp[t]==g); rv,cvv=np.where(grp[v]==g)
                    if ct.size<50 or cvv.size==0:
                        a,b=fit_aff(cv[t,:,j].ravel(), Y[t,:,j].ravel())
                    else:
                        a,b=fit_aff(cv[t[rt],ct,j], Y[t[rt],ct,j])
                    out[v[rv],cvv,j]=a*cv[v[rv],cvv,j]+b
    m,r=C.mcrmse(Y[sn],out[sn]); return m,out

for mode in ["global","loop","base"]:
    m,_=run(mode); print(f"{mode:8s} affine cv sn1={m:.5f}",flush=True)
# per-loop affine fit on full then apply (no CV) -- optimistic reference
# also clipping
for lo in [0.0,0.02,0.05]:
    p=np.clip(cv,lo,None)
    m,_=C.mcrmse(Y[sn],p[sn]); print(f"clip {lo}: {m:.5f}")
EOF
