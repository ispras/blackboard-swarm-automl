import numpy as np, common as C
tr=C.load_train(); Y=C.make_targets(tr)
sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
cv=np.load("bm_nnls.npy")
S68=np.load("knn_S_tr.npy"); S107=np.load("S107_tr.npy")
def knn(S,k,p):
    N=S.shape[0]; idx=np.argpartition(-S,kth=k,axis=1)[:,:k]
    out=np.zeros((N,68,5),np.float32)
    for i in range(N):
        nb=idx[i]; s=S[i,nb]; w=np.where(s>0,s**p,0)
        if w.sum()>0: out[i]=np.tensordot(w,Y[nb],axes=(0,0))/w.sum()
    return out
cfgs={"id68_k5p4":(S68,5,4),"mix_k5p4":(0.7*S68+0.3*S107,5,4),"id68_k8p4":(S68,8,4),"id107_k5p4":(S107,5,4)}
rng=np.random.RandomState(1)
for name,(S,k,p) in cfgs.items():
    K=knn(S,k,p); ident=S.max(1)
    base,_=C.mcrmse(Y[sn],cv[sn])
    # full fit
    best=(1e9,None)
    for thr in [0.75,0.8,0.85,0.9]:
        for wm in [0.1,0.2,0.25,0.3,0.4,0.5]:
            w=np.clip((ident-thr)/(1-thr),0,1)[:,None,None]*wm
            m,_=C.mcrmse(Y[sn],((1-w)*cv+w*K)[sn])
            if m<best[0]: best=(m,thr,wm)
    # split-half
    gains=[]
    for rep in range(30):
        idx=np.where(sn)[0]; rng.shuffle(idx); h=idx[:len(idx)//2]; o=idx[len(idx)//2:]
        b=(1e9,None)
        for thr in [0.75,0.8,0.85,0.9]:
            for wm in [0.1,0.2,0.3,0.4]:
                w=np.clip((ident-thr)/(1-thr),0,1)[:,None,None]*wm
                m,_=C.mcrmse(Y[o],((1-w)*cv+w*K)[o])
                if m<b[0]: b=(m,thr,wm)
        _,thr,wm=b
