import json,sys,numpy as np,common as C
from scipy.optimize import nnls
regpath=sys.argv[1] if len(sys.argv)>1 else "models_v11.json"
tr=C.load_train();Y=C.make_targets(tr);sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
folds=C.kfold_indices(len(tr),5,42);SC=[0,1,3]
reg=json.load(open(regpath));M=len(reg);print("models",M)
Pm=np.stack([np.load(m["oof"])[:,:68,:] for m in reg],0).astype(np.float64)
def fitw(A,y):
    lam=1e-1;m=A.shape[0];Aa=np.vstack([A.T,np.sqrt(lam)*np.eye(m)]);ya=np.concatenate([y,np.zeros(m)])
    return nnls(Aa,ya,maxiter=50000)[0]
cv=np.zeros_like(Y)
for j in SC:
    Pj=Pm[...,j]
    for t,v in folds:
        t=t[sn[t]];v=v[sn[v]];w=fitw(Pj[:,t].reshape(M,-1),Y[t,:,j].reshape(-1))
        cv[v,:,j]=np.tensordot(w,Pj[:,v],axes=(0,0))
np.save("cv_tuned.npy",cv)
print("base",C.mcrmse(Y[sn],cv[sn])[0])
knn=np.load("knn_best_oof.npy");sid=np.load("knn_best_S_tr.npy").max(1)
best=(9,None)
for thr in [0.70,0.75,0.8,0.85,0.9,0.95]:
    row=[]
    for wm in [0.1,0.15,0.2,0.25,0.3,0.4]:
        w=np.clip((sid-thr)/(1-thr),0,1)[:,None,None]*wm
        m=C.mcrmse(Y[sn],((1-w)*cv+w*knn)[sn])[0]
        row.append(round(m,5))
        if m<best[0]: best=(m,thr,wm)
    print(f"thr={thr}: {row}")
print("BEST",best)
EOF
