for f in sorted(glob.glob('/download_job_code/payload/sandbox/workspaces/betelgeuse_mu/preds/oof_*.npy')):
    try: a=np.load(f)[:,:68,:]
    except: continue
    if a.shape[0]!=2160: continue
    cov=[]; mrows=np.zeros(2160,bool)
    for t,v in folds:
        c=float(np.abs(a[v]).sum()>0); cov.append(c)
