rng=np.random.RandomState(0)
gains=[]
for rep in range(20):
    idx=np.where(sn)[0]; rng.shuffle(idx)
    h=idx[:len(idx)//2]; o=idx[len(idx)//2:]
    best=(1e9,None)
    for thr in [0.85,0.9,0.95,0.97,0.99]:
        for wmax in [0.0,0.2,0.4,0.6,0.8]:
