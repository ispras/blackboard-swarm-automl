            p=(1-w)*cv+w*knn
            m,_=C.mcrmse(Y[o],p[o])
            if m<best[0]: best=(m,thr,wmax)
    # eval chosen on other half
    _,thr,wmax=best
    w=np.clip((ident-thr)/(1-thr),0,1)[:,None,None]*wmax
    p=(1-w)*cv+w*knn
    base,_=C.mcrmse(Y[h],cv[h]); gated,_=C.mcrmse(Y[h],p[h])
    gains.append((base,gated,thr,wmax))
g=np.array([(a-b) for a,b,_,_ in gains])
print("mean gain",g.mean(),"std",g.std(),"min",g.min(),"max",g.max(),"frac>0",(g>0).mean())
from collections import Counter
print(Counter([(t,w) for _,_,t,w in gains]))
EOF
