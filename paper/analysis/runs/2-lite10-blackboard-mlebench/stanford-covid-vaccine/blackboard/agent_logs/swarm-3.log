import numpy as np,sys
sys.path.insert(0,'.')
import common as C
tr=C.load_train();Y=C.make_targets(tr);sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
cv=np.load("cv_cur.npy");knn=np.load("knn_best_oof.npy");sid=np.load("knn_best_S_tr.npy").max(1)
SC=[0,1,3];out=cv.copy();tot=[]
for j in SC:
    best=(9,None)
    for thr in [0.75,0.8,0.85,0.9]:
        for wm in [0.1,0.15,0.2,0.25,0.3]:
            w=np.clip((sid-thr)/(1-thr),0,1)[:,None]*wm
            p=np.clip((1-w)*cv[...,j]+w*knn[...,j],0,None)[sn]
            m=float(np.sqrt(np.mean((p-Y[sn][...,j])**2)))
            if m<best[0]: best=(m,thr,wm)
    print(f"col{j} best={best}")
    thr,wm=best[1],best[2]
    w=np.clip((sid-thr)/(1-thr),0,1)[:,None]*wm
    out[...,j]=np.clip((1-w)*cv[...,j]+w*knn[...,j],0,None)
    tot.append(best[0])
m,r=C.mcrmse(Y[sn],out[sn]);print("per-col total",m,r)
wg=np.clip((sid-0.85)/0.15,0,1)[:,None,None]*0.2
g=np.clip((1-wg)*cv+wg*knn,0,None)
print("global",C.mcrmse(Y[sn],g[sn]))
EOF
