import numpy as np, common as C
import lightgbm as lgb

tr=C.load_train(); Y=C.make_targets(tr)
sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
folds=C.kfold_indices(len(tr),5,42); SC=[0,1,3]
P="/download_job_code/payload/sandbox/workspaces/betelgeuse_mu/preds/"
spec=["lstm256","lstm256s7","lstm384","mscnn256","cnn256","bigru"]
OOF=np.stack([np.load(P+f"oof_{n}.npy")[:,:68,:] for n in spec],0).astype(np.float32)
TEST=np.stack([np.load(P+f"test_{n}.npy") for n in spec],0).astype(np.float32)
knn=np.load("knn_oof.npy").astype(np.float32)
knn_te=np.load("knn_test.npy").astype(np.float32)
S=np.load("knn_S_tr.npy"); Ste=np.load("knn_S_te.npy")
idtr=S.max(1).astype(np.float32); idte=Ste.max(1).astype(np.float32)
LOOPS=list("SMI BHEX".replace(" ",""))
BI={b:i for i,b in enumerate("ACGU")}
loop=np.array([[LOOPS.index(c) if c in LOOPS else 0 for c in r["predicted_loop_type"][:68]] for r in tr])
base=np.array([[BI.get(c,0) for c in r["sequence"][:68]] for r in tr])
loop_te=np.array([[LOOPS.index(c) if c in LOOPS else 0 for c in r["predicted_loop_type"][:68]] for r in C.load_test()])
base_te=np.array([[BI.get(c,0) for c in r["sequence"][:68]] for r in C.load_test()])
sntr=np.array([r["signal_to_noise"] for r in tr],dtype=np.float32)
pos=(np.arange(68)/67.0).astype(np.float32)

def feats(oof_preds, knn_p, ident, loopv, basev, snv, posv):
    # oof_preds (M,N,68) for a given column, knn_p (N,68)
    M,N,L=oof_preds.shape
    F=[oof_preds.transpose(1,2,0).reshape(N*L,M)]
    F.append(knn_p.reshape(N*L,1))
    F.append(np.repeat(ident[:,None],L,axis=1).reshape(N*L,1))
    F.append(np.repeat(snv[:,None],L,axis=1).reshape(N*L,1))
    F.append(np.tile(posv[None,:],(N,1)).reshape(N*L,1))
    F.append(oof_preds.mean(0).reshape(N*L,1))
    F.append(oof_preds.std(0).reshape(N*L,1))
    lo=np.zeros((N*L,7),np.float32); lo[np.arange(N*L),loopv.reshape(-1)]=1
    bs=np.zeros((N*L,4),np.float32); bs[np.arange(N*L),basev.reshape(-1)]=1
    F += [lo,bs]
    return np.concatenate(F,1)

params=dict(objective="regression",metric="rmse",num_leaves=63,learning_rate=0.03,
            n_estimators=600,feature_fraction=0.85,bagging_fraction=0.85,bagging_freq=1,
            min_child_samples=40,n_jobs=4,verbose=-1)
cv=np.zeros_like(Y); tests={}
for j in SC:
    Fj_all=feats(OOF[...,j], knn[...,j], idtr, loop, base, sntr, pos)
    Ft=feats(TEST[...,j], knn_te[...,j], idte, loop_te, base_te, np.zeros(240,np.float32), pos)
    yt_all=Y[...,j]
    for t,v in folds:
        t=t[sn[t]]; v=v[sn[v]]
        # row index -> feature index mapping
        ft_idx=(t[:,None]*68+np.arange(68)[None,:]).reshape(-1)
        fv_idx=(v[:,None]*68+np.arange(68)[None,:]).reshape(-1)
        mdl=lgb.LGBMRegressor(**params)
        mdl.fit(Fj_all[ft_idx], yt_all[t].reshape(-1))
        cv[v,:,j]=mdl.predict(Fj_all[fv_idx]).reshape(v.size,68)
    # final model all sn
    fidx=(np.where(sn)[0][:,None]*68+np.arange(68)[None,:]).reshape(-1)
    mdl=lgb.LGBMRegressor(**params)
    mdl.fit(Fj_all[fidx], yt_all[sn].reshape(-1))
    pt=mdl.predict(Ft).reshape(240,68)
    tests[j]=pt
    print("done col",j,flush=True)
m,r=C.mcrmse(Y[sn],cv[sn]); print(f"STACK cv sn1={m:.5f} cols={['%.4f'%x for x in r]}")
np.save("stack_cv.npy",cv)
test=np.zeros((240,107,5),np.float32)
# unscored cols mean of models
for j in range(5):
    if j in SC: test[:,:68,j]=tests[j]
    else: test[:,:,j]=TEST[:,:,j].mean(0)
np.save("stack_test.npy",test)
EOF
