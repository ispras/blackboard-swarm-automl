import numpy as np, common as C
from scipy.optimize import nnls
tr=C.load_train(); Y=C.make_targets(tr)
sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
snv=np.array([r["signal_to_noise"] for r in tr],dtype=np.float64)
folds=C.kfold_indices(len(tr),5,42); SC=[0,1,3]
P="/download_job_code/payload/sandbox/workspaces/betelgeuse_mu/preds/"
spec=["lstm256","lstm256s7","lstm384","mscnn256","cnn256","bigru"]
Pm=np.stack([np.load(P+f"oof_{n}.npy")[:,:68,:] for n in spec],0); M=len(spec)
knn=np.load("knn_oof.npy"); ident=np.load("knn_S_tr.npy").max(1)

def wnnls(A,y,w):
    sw=np.sqrt(w)
    W,_=nnls((A*sw).T, y*sw)
    return W

for pw in [0.0,0.5,1.0,2.0]:
    cv=np.zeros_like(Y)
    for j in SC:
        Pj=Pm[...,j]
        for t,v in folds:
            t=t[sn[t]]; v=v[sn[v]]; yv=Y[t,:,j]
            w=(np.clip(snv[t],0.5,None)**pw)
            w=np.repeat(w,68)
            W=wnnls(Pj[:,t].reshape(M,-1), yv.reshape(-1), w)
            cv[v,:,j]=np.tensordot(W,Pj[:,v],axes=(0,0))
    m,_=C.mcrmse(Y[sn],cv[sn])
    wg=np.clip((ident-0.85)/0.15,0,1)[:,None,None]*0.3
    pg=(1-wg)*cv+wg*knn
    mg,_=C.mcrmse(Y[sn],pg[sn])
    print(f"sn_pow={pw}: cv={m:.5f} gated={mg:.5f}",flush=True)
    np.save(f"wls_{pw}.npy",cv)
EOF
