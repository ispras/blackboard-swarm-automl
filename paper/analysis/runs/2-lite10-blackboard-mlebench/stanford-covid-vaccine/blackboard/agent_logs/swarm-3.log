[0m$ [0mcat > /download_job_code/payload/sandbox/workspaces/mirfak_iota/blend_regime.py <<'EOF'
import json,numpy as np,common as C
from scipy.optimize import nnls
tr=C.load_train(); Y=C.make_targets(tr); sn=np.array([r["SN_filter"] for r in tr],dtype=bool)
folds=C.kfold_indices(len(tr),5,42); SC=[0,1,3]
reg=json.load(open("models_v6.json"))
names=[m["name"] for m in reg]
Pm=np.stack([np.load(m["oof"])[:,:68,:] for m in reg],0).astype(np.float64); M=len(names)
Tm=np.stack([np.load(m["test"]) for m in reg],0)
S=np.load("knn_best_S_tr.npy"); Ste=np.load("knn_best_S_te.npy")
idtr=S.max(1); idte=Ste.max(1)
knn=np.load("knn_best_oof.npy"); knnte=np.load("knn_best_test.npy")

def fitw(A,y):
    lam=1e-1; m=A.shape[0]
    Aa=np.vstack([A.T,np.sqrt(lam)*np.eye(m)]); ya=np.concatenate([y,np.zeros(m)])
    return nnls(Aa,ya,maxiter=50000)[0]

def run(thr_reg):
    hi=idtr>=thr_reg
    cv=np.zeros_like(Y)
    for j in SC:
        Pj=Pm[...,j]
        for t,v in folds:
            t=t[sn[t]]; v=v[sn[v]]
            for mask_t,mask_v in [((hi[t]),(hi[v])),((~hi[t]),(~hi[v]))]:
                if mask_t.sum()<40 or mask_v.sum()==0:
                    # fallback global on this fold
                    w=fitw(Pj[:,t].reshape(M,-1),Y[t,:,j].reshape(-1))
                    cv[v[mask_v],:,j]=np.tensordot(w,Pj[:,v[mask_v]],axes=(0,0))
                else:
                    w=fitw(Pj[:,t[mask_t]].reshape(M,-1),Y[t[mask_t],:,j].reshape(-1))
                    cv[v[mask_v],:,j]=np.tensordot(w,Pj[:,v[mask_v]],axes=(0,0))
    m,_=C.mcrmse(Y[sn],cv[sn])
    wg=np.clip((idtr-0.8)/0.2,0,1)[:,None,None]*0.3
    mg,_=C.mcrmse(Y[sn],((1-wg)*cv+wg*knn)[sn])
    print(f"regime thr={thr_reg}: base={m:.5f} gated={mg:.5f} (hi rows sn={int((hi&sn).sum())})",flush=True)
    return cv
# global reference
cv=np.zeros_like(Y)
for j in SC:
    Pj=Pm[...,j]
    for t,v in folds:
        t=t[sn[t]];v=v[sn[v]]
        w=fitw(Pj[:,t].reshape(M,-1),Y[t,:,j].reshape(-1))
        cv[v,:,j]=np.tensordot(w,Pj[:,v],axes=(0,0))
wg=np.clip((idtr-0.8)/0.2,0,1)[:,None,None]*0.3
mg,_=C.mcrmse(Y[sn],((1-wg)*cv+wg*knn)[sn])
print(f"global: base={C.mcrmse(Y[sn],cv[sn])[0]:.5f} gated={mg:.5f}")
np.save("bm_global_v6.npy",cv)
for thr in [0.99,0.95,0.9]:
    run(thr)
EOF
