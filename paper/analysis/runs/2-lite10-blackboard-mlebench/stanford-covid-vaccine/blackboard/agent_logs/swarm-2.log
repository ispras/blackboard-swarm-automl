def reverse_rows(rows):
    """Return copies with 5'->3' reversed sequence/structure/loop and reversed targets."""
    out = []
    swap = {"(": ")", ")": "("}
    for d in rows:
        e = dict(d)
        e["sequence"] = d["sequence"][::-1]
        e["structure"] = "".join(swap.get(c, c) for c in d["structure"][::-1])
        e["predicted_loop_type"] = d["predicted_loop_type"][::-1]
