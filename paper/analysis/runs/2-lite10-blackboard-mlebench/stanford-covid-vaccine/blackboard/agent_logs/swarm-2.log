import numpy as np
from common import load, build_features
rows=load("train"); X,Y,mask,sn=build_features(rows); snf=np.array([d["SN_filter"] for d in rows]); sel=snf==1; mm=(mask>0)[:,:68]; Y68=Y[:,:68]
cv=np.load('my_ens_final_cv.npy')[:,:68].astype(np.float64)
knn=np.load('../mirfak_iota/knn_best_oof.npy')[:,:68].astype(np.float64)
ident=np.load('../mirfak_iota/knn_best_S_tr.npy').max(1)
def score(p):
    errs=[]
    for j in [0,1,3]:
        d=p[:,:,j][sel][mm[sel]]; y=Y68[:,:,j][sel][mm[sel]]
        errs.append(np.sqrt(((d-y)**2).mean()))
    return np.mean(errs), errs
def gate(p,thr,wmax):
    w=np.clip((ident-thr)/(1-thr),0,1)[:,None,None]*wmax
    return (1-w)*p+w*knn
print('base',[round(x,5) for x in score(cv)])
for thr in [0.8,0.85,0.9]:
    for wmax in [0.2,0.3]:
        print('gate',thr,wmax,[round(x,5) for x in score(gate(cv,thr,wmax))])
# two-regime: w1 for mid, w2 for exact dups
for w1 in [0.2,0.3]:
  for lo2 in [0.97,0.99]:
    for w2 in [0.3,0.5,0.7,1.0]:
        w=np.clip((ident-0.85)/0.15,0,1)[:,None,None]*w1
        w=np.where((ident>=lo2)[:,None,None],w2,w)
        p=(1-w)*cv+w*knn
        print(f'two w1{w1} lo2{lo2} w2{w2}',[round(x,5) for x in score(p)])
# smoothing
def smooth(p,s):
    k=np.exp(-0.5*(np.arange(-3*s,3*s+1)/(s))**2); k/=k.sum()
    q=p.copy()
    for j in [0,1,2,3,4]:
        for i in range(len(p)):
            q[i,:,j]=np.convolve(p[i,:,j],k,mode='same')
    return q
for s in [0.5,0.8,1.2]:
    p=smooth(cv,s); print('smooth',s,[round(x,5) for x in score(p)])
    pg=gate(p,0.85,0.2); print(' smooth+gate',[round(x,5) for x in score(pg)])
# per-column wmax
idg=np.clip((ident-0.85)/0.15,0,1)
for wm in [(0.2,0.2,0.2),(0.3,0.2,0.2),(0.1,0.2,0.2),(0.2,0.3,0.2),(0.2,0.2,0.3)]:
