import sys, os, json, numpy as np
from scipy.optimize import nnls
SB='/download_job_code/payload/sandbox'; MF=os.path.join(SB,'workspaces','mirfak_iota')
os.environ['DATA_DIR']=os.path.join(SB,'data'); sys.path.insert(0,MF)
import common as C
tr=C.load_train(); Y=C.make_targets(tr); sn=np.array([r['SN_filter'] for r in tr],bool)
folds=C.kfold_indices(len(tr),5,42)
reg=json.load(open(MF+'/models_final.json')); models=[(m['name'],m['oof'],m['test']) for m in reg]
be=SB+'/workspaces/betelgeuse_mu/preds'; ca=SB+'/workspaces/castor_zeta'
for tag in ['mscnn384b10','mscnn384b10s13','mscnn448b10','mscnn512b10','lstm256b10','cnn384b10']:
    models.append((f'be_{tag}',f'{be}/oof_{tag}.npy',f'{be}/test_{tag}.npy'))
for tag in ['hb2_s44','hb2_s45','hb2_avg4','ha2_s42','ha2_s43','ha2_avg2','mshb_s42','lshb_s42','lshb_s43','ca_nnls','mshb_avg4','hb2_avg5','mshb_s45','hb2_s46']:
    models.append((f'ca_{tag}',f'{ca}/oof_{tag}.npy',f'{ca}/test_{tag}.npy'))
P=[]; names=[]
for n,o,t in models:
    a=np.load(o)[:,:68,:].astype(np.float64)
    if a.shape[0]!=2160: continue
    names.append(n); P.append(a)
print('N',len(P),flush=True)
def fit(A,y,lam):
    M=A.shape[0]
    Aa=np.vstack([A.T,np.sqrt(lam)*np.eye(M)]); ya=np.concatenate([y,np.zeros(M)])
    w,_=nnls(Aa,ya,maxiter=50000); return w
def cvlam(lam):
    cv=np.zeros_like(Y)
    for j in [0,1,3]:
        Pj=np.stack([p[:,:,j] for p in P],0)
        for tidx,vidx in folds:
            m=sn[tidx]; Pt=Pj[:,tidx[m],:].reshape(len(P),-1); yt=Y[tidx[m],:,j].reshape(-1)
            w=fit(Pt,yt,lam)
            Pv=Pj[:,vidx,:].reshape(len(P),-1)
            cv[vidx,:,j]=(w@Pv).reshape(len(vidx),68)
    return C.mcrmse(Y[sn],cv[sn])
for lam in [0.01,0.03,0.1,0.3,1.0,3.0,10.0]:
    m,r=cvlam(lam); print('lam',lam,round(m,5),[round(x,4) for x in r],flush=True)
