s=open('train.py').read()
# append rich encoder after encode
rich='''

def encode_rich(recs, maxlen=107):
    n = len(recs)
    X = np.zeros((n, maxlen, 24), dtype=np.float32)
    gcset = set('GC')
    for k, r in enumerate(recs):
        structure = r['structure']; seqs = r['sequence']
        pair = {}
        stack = []
        for i, c in enumerate(structure):
            if c == '(':
                stack.append(i)
            elif c == ')' and stack:
                j = stack.pop(); pair[i] = j; pair[j] = i
        for i in range(maxlen):
            X[k, i, SEQ.index(seqs[i])] = 1
            X[k, i, 4 + STRUCT.index(structure[i])] = 1
            X[k, i, 7 + LOOP.index(r['predicted_loop_type'][i])] = 1
            if i in pair:
                j = pair[i]
                X[k, i, 14] = abs(i - j) / maxlen
                X[k, i, 15 + SEQ.index(seqs[j])] = 1
            for wi, w in enumerate((1, 2, 4)):
                lo, hi = max(0, i - w), min(maxlen, i + w + 1)
                X[k, i, 19 + wi] = sum(1 for c in seqs[lo:hi] if c in gcset) / (hi - lo)
            X[k, i, 22] = math.sin(2 * math.pi * i / maxlen)
            X[k, i, 23] = math.cos(2 * math.pi * i / maxlen)
    return X
'''
s=s.replace("\n\ndef encode_y(recs, maxlen=107):", rich+"\n\ndef encode_y(recs, maxlen=107):")
# use rich in main
s=s.replace("""    X = encode(tr); Y, M = encode_y(tr); Xte = encode(te)""",
"""    enc = encode_rich if args.rich else encode
    nin = 24 if args.rich else 15
    X = enc(tr); Y, M = encode_y(tr); Xte = enc(te)""")
s=s.replace("Model(args.model, nin=15,","Model(args.model, nin=nin,")
s=s.replace("""    ap.add_argument('--yclip_hi', type=float, default=1e9)""",
"""    ap.add_argument('--yclip_hi', type=float, default=1e9)
    ap.add_argument('--rich', type=int, default=0)""")
open('train.py','w').write(s)
print('ok')
