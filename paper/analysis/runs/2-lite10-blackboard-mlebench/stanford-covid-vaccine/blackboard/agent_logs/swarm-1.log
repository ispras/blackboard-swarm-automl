for tag in ['hb2_s44','hb2_s45','hb2_avg4','ha2_s42','ha2_s43','ha2_avg2','mshb_s42','lshb_s42','lshb_s43','ca_nnls']:
    models.append((f'ca_{tag}',f'{ca}/oof_{tag}.npy',f'{ca}/test_{tag}.npy'))
names,oofs,tests=[],[],[]
for n,o,t in models:
    a=np.load(o)[:,:68,:].astype(np.float64)
    if a.shape[0]!=2160: continue
    names.append(n); oofs.append(a); tests.append(np.load(t).astype(np.float64))
print('N',len(names),flush=True)
W,cv=E.blend_cv(oofs,Y,sn,folds,True)
print('intercept CV',C.mcrmse(Y[sn],cv[sn])[0],flush=True)
W2,cv2=E.blend_cv(oofs,Y,sn,folds,False)
print('nointercept CV',C.mcrmse(Y[sn],cv2[sn])[0],flush=True)
np.save('candidate_cv_int.npy',cv.astype(np.float32))
# mean of intercept and non
for a in [0.25,0.5,0.75]:
    z=a*cv+(1-a)*cv2; print('mix',a,C.mcrmse(Y[sn],z[sn])[0])
