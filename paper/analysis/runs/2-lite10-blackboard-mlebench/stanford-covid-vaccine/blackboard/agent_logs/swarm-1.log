class Model(nn.Module):
    def __init__(self, kind='lstm', nin=15, hid=128, drop=0.3, nout=5):
        super().__init__()
        self.kind = kind
        if kind in ('transformer', 'mscnn'):
            pass
        elif kind == 'lstm':
            self.conv = nn.Sequential(
                nn.Conv1d(nin, 128, 5, padding=2), nn.BatchNorm1d(128), nn.ReLU(),
                nn.Conv1d(128, hid, 5, padding=2), nn.BatchNorm1d(hid), nn.ReLU())
            self.rnn = nn.LSTM(hid, hid, num_layers=2, batch_first=True,
                               bidirectional=True, dropout=drop)
            self.head = nn.Sequential(nn.Dropout(drop), nn.Linear(2 * hid, nout))
        elif kind == 'cnn':
            def blk(cin, cout, k, d):
                return nn.Sequential(nn.Conv1d(cin, cout, k, padding=d * (k // 2), dilation=d),
                                     nn.BatchNorm1d(cout), nn.ReLU())
            self.net = nn.Sequential(
                blk(nin, hid, 3, 1), blk(hid, hid, 3, 1),
                blk(hid, hid, 3, 2), blk(hid, hid, 3, 4),
                blk(hid, hid, 3, 8), blk(hid, hid, 3, 1),
                nn.Dropout(drop), nn.Conv1d(hid, nout, 1))
        elif kind == 'bigru':
            self.conv = nn.Sequential(
                nn.Conv1d(nin, 128, 3, padding=1), nn.BatchNorm1d(128), nn.ReLU())
            self.rnn = nn.GRU(128, hid, num_layers=3, batch_first=True,
                              bidirectional=True, dropout=drop)
            self.head = nn.Sequential(nn.Dropout(drop), nn.Linear(2 * hid, nout))

    def forward(self, x):
        x = x.transpose(1, 2)
        if self.kind == 'cnn':
            return self.net(x).transpose(1, 2)
        if self.kind == 'transformer':
            z = self.stem(x).transpose(1, 2) + self.pos[:, :x.shape[2]]
            z = self.enc(z)
            return self.head(z)
        if self.kind == 'mscnn':
            z = torch.cat([b(x) for b in self.branches], 1).transpose(1, 2)
            z, _ = self.rnn(z)
            return self.head(z)
        x = self.conv(x).transpose(1, 2)
        x, _ = self.rnn(x)
        return self.head(x)


