rank=pd.Series(sg).groupby(gg).rank(pct=True).values
print('GROUND raw',mcc_best(yg,sg))
print('GROUND minus_mean',mcc_best(yg,sg-mean))
print('GROUND z',mcc_best(yg,(sg-mean)/(std+1e-6)))
print('GROUND rank',mcc_best(yg,rank))
