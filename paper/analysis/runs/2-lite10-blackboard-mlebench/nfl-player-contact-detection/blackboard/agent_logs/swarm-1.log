import pandas as pd, numpy as np, sys
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/castor_alpha")
from evutil import ev, mcc_curve
from thr_opt import best_two
from sklearn.metrics import roc_auc_score
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"
rp=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet")
ap=pd.read_parquet(f"{R}/achernar_sigma/oof_pair_lgbv1.parquet")
print("ach cols",ap.columns.tolist(),ap.shape)
# align
col=[c for c in ap.columns if c in ("pred","prob","oof")][0]
m=rp[["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact","prob"]].rename(columns={"prob":"p_rigel"})
m=m.merge(ap[["contact_id",col]].rename(columns={col:"p_ach"}),on="contact_id",how="left")
print(m.shape,m.p_ach.isna().sum(),flush=True)
y=m.contact.values
for w in [0,0.15,0.25,0.35,0.5,0.65,0.75,1.0]:
    p=(1-w)*m.p_rigel.values+w*m.p_ach.values
    auc=roc_auc_score(y,p); mcc,th=mcc_curve(y,p)
    print(f"w_ach {w:.2f} AUC {auc:.5f} MCC {mcc:.5f} th {th:.5g}",flush=True)
# logit blend
def lg(p): p=np.clip(p,1e-7,1-1e-7); return np.log(p/(1-p))
for w in [0.3,0.4,0.5,0.6,0.7]:
    p=1/(1+np.exp(-((1-w)*lg(m.p_rigel.values)+w*lg(m.p_ach.values))))
    auc=roc_auc_score(y,p); mcc,th=mcc_curve(y,p); print(f"logit w {w} AUC {auc:.5f} MCC {mcc:.5f}",flush=True)
