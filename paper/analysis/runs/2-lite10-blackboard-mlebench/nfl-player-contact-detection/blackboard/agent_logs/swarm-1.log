import pandas as pd, numpy as np, sys, time
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/castor_alpha")
from evutil import mcc_curve
import lightgbm as lgb
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"
rg=pd.read_parquet(f"{R}/rigel_delta/oof_ground.parquet")
ag=pd.read_parquet(f"{R}/achernar_sigma/oof_ground_lgbv1.parquet")
ct=pd.read_parquet(f"{C}/ground_oof_tab.parquet")
cv=pd.read_parquet(f"{C}/ground_oof_video.parquet")
ft=pd.read_parquet(f"{C}/ground_train_feats.parquet")
g=rg[["contact_id","game_play","step","nfl_player_id_1","contact","fold","prob"]].rename(columns={"prob":"p_rigel","nfl_player_id_1":"pid"})
g=g.merge(ag[["contact_id","pred"]].rename(columns={"pred":"p_ach"}),on="contact_id",how="left")
g=g.merge(ct[["contact_id","oof"]].rename(columns={"oof":"p_ctab"}),on="contact_id",how="left")
g=g.merge(cv[["contact_id","pred"]].rename(columns={"pred":"p_cvid"}),on="contact_id",how="left")
g=g.sort_values(["game_play","pid","step"]).reset_index(drop=True)
cols=["p_rigel","p_ach","p_ctab","p_cvid"]
grp=g.groupby(["game_play","pid"],sort=False)
feat={}
for c in cols:
    feat[c]=g[c].values
    feat[c+"_lag1"]=grp[c].shift(1).values
    feat[c+"_lead1"]=grp[c].shift(-1).values
    feat[c+"_lag2"]=grp[c].shift(2).values
    feat[c+"_lead2"]=grp[c].shift(-2).values
    feat[c+"_m5"]=grp[c].transform(lambda x:x.rolling(5,center=True,min_periods=1).mean()).values
    feat[c+"_m11"]=grp[c].transform(lambda x:x.rolling(11,center=True,min_periods=1).mean()).values
    feat[c+"_std5"]=grp[c].transform(lambda x:x.rolling(5,center=True,min_periods=1).std()).values
X=pd.DataFrame(feat)
# add raw context
rawcols=["step","nn_dist","nn2_dist","cnt15","cnt25","bot_rank_s","bot_rank_e","cy_rank_s","cy_rank_e","speed","acceleration","sa","vis_s","vis_e","n_helm_s","n_helm_e","bot_gap_s","bot_gap_e","y_position","x_position","speed_m5","acceleration_m5"]
raw=ft[["contact_id"]+[c for c in rawcols if c in ft.columns]].merge(g[["contact_id"]],on="contact_id",how="right")
for c in raw.columns:
    if c!="contact_id": X[c]=raw[c].values
X=X.fillna(0)
y=g.contact.values; folds=g.fold.values
print("X",X.shape,flush=True)
oof=np.zeros(len(g)); models=[]
for f in sorted(np.unique(folds)):
    tr=folds!=f; va=folds==f
    m=lgb.LGBMClassifier(n_estimators=2000,learning_rate=0.03,num_leaves=63,min_child_samples=80,
        subsample=0.8,colsample_bytree=0.7,reg_lambda=1.0,n_jobs=8,random_state=42)
    m.fit(X[tr],y[tr],eval_set=[(X[va],y[va])],eval_metric="auc",callbacks=[lgb.early_stopping(100)])
    oof[va]=m.predict_proba(X[va])[:,1]
    print("fold",f,"iter",m.best_iteration_,"auc",round(__import__("sklearn.metrics",fromlist=["roc_auc_score"]).roc_auc_score(y[va],oof[va]),5),flush=True)
from sklearn.metrics import roc_auc_score
print("STACK OOF AUC",round(roc_auc_score(y,oof),5),flush=True)
m,th=mcc_curve(y,oof); print("STACK ground MCC",round(m,5),"th",th,flush=True)
pd.DataFrame({"contact_id":g.contact_id,"y":y,"fold":folds,"pred":oof}).to_parquet(f"{C}/ground_oof_stack.parquet",index=False)
# save feature importance
imp=pd.Series(models[0].feature_importances_ if models else m.feature_importances_,index=X.columns).sort_values(ascending=False)
print(imp.head(20).to_string(),flush=True)
