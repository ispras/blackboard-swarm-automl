import pandas as pd,numpy as np,json,sys
sys.path.insert(0,'.')
from postprocess_search import smooth
from final_blend import joint_mcc
R='.';A='../achernar_sigma';C='../castor_alpha'
# pair smoothed OOF from current weights
pw=json.load(open('pair_weights_search.json')); names=pw['names']; w=np.array(pw['weights'])
pref=pd.read_parquet('oof_pair.parquet')[['contact_id','game_play','nfl_player_id_1','nfl_player_id_2','step','contact']]
def L(p,c): return pref[['contact_id']].merge(pd.read_parquet(p)[['contact_id',c]],on='contact_id',how='left')[c].values.astype(np.float64)
seq=np.mean([L(f'oof_pair_seq_s{i}.parquet','prob') for i in range(5)],axis=0)
P=np.stack([L('oof_pair.parquet','prob'),L('oof_pair_h.parquet','prob'),L(f'{A}/oof_pair_lgbv1.parquet','pred'),L(f'{A}/oof_pair_lgbv2.parquet','pred'),L(f'{A}/oof_pair_gstack.parquet','pred'),seq,L('oof_pair_xgb.parquet','prob')],axis=1)
pp=pref.copy(); pp['_p']=P@w
dsp,sp=smooth(pp,pp['_p'].values,3); yp=dsp.contact.values.astype(np.int8)
gp=dsp.game_play.values
for name,p in [('raw',sp)]:
    print('pair',name,mcc_curve:=None) if False else None
def mcc_best(y,p):
    idx=np.argsort(-p); ys=y[idx].astype(np.float64); tp=np.cumsum(ys); fp=np.cumsum(1-ys)
    pos=ys.sum(); neg=len(ys)-pos; fn=pos-tp; tn=neg-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); mm=np.where(den>0,(tp*tn-fp*fn)/den,-1)
    k=int(np.argmax(mm)); return float(mm[k]),float(np.sort(p)[::-1][k])
mean=pd.Series(sp).groupby(gp).transform('mean').values
std=pd.Series(sp).groupby(gp).transform('std').fillna(0).values
rank=pd.Series(sp).groupby(gp).rank(pct=True).values
print('PAIR raw',mcc_best(yp,sp))
print('PAIR minus_mean',mcc_best(yp,sp-mean))
print('PAIR z',mcc_best(yp,(sp-mean)/(std+1e-6)))
print('PAIR rank',mcc_best(yp,rank))
# ground
og=pd.read_parquet('oof_ground.parquet')[['contact_id','game_play','nfl_player_id_1','nfl_player_id_2','step','contact']]
g=pd.read_parquet('ground_oof_best.parquet'); yg=g.contact.values.astype(np.int8); sg=g.prob.values.astype(np.float64); gg=g.game_play.values
