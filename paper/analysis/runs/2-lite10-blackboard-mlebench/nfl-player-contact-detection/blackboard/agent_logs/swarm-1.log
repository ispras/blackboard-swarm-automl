import pandas as pd,numpy as np,sys,json
sys.path.insert(0,'.')
from postprocess_search import _bounds,_roll_mean_center
exec(open('quick_blend_ground.py').read().split('mine = ')[0])
tr=pd.read_parquet('oof_pair.parquet')[['contact_id','game_play','nfl_player_id_1','nfl_player_id_2','step','contact']]
y=tr.contact.values.astype(np.int8)
def L(p,c): return tr[['contact_id']].merge(pd.read_parquet(p)[['contact_id',c]],on='contact_id')[c].values.astype(np.float64)
pw=json.load(open('pair_weights_search.json')); names=pw['names']; w=np.array(pw['weights'])
arrs=[L('oof_pair.parquet','prob'),L('oof_pair_h.parquet','prob'),L('../achernar_sigma/oof_pair_lgbv1.parquet','pred'),L('../achernar_sigma/oof_pair_lgbv2.parquet','pred'),L('../achernar_sigma/oof_pair_gstack.parquet','pred'),np.mean([L(f'oof_pair_seq_s{i}.parquet','prob') for i in range(5)],axis=0),L('oof_pair_xgb.parquet','prob')]
gid=tr.groupby(['game_play','nfl_player_id_1','nfl_player_id_2'],sort=False).ngroup().values.astype(np.int64); gs,ge=_bounds(gid)
def m(p):
    sm=_roll_mean_center(p.astype(np.float32),gs,ge,3).astype(np.float64); return mcc_curve(y,sm)[0]
raw=sum(wi*a for wi,a in zip(w,arrs))
lg=lambda p: np.log(np.clip(p,1e-7,1-1e-7)/(1-np.clip(p,1e-7,1-1e-7)))
logit=1/(1+np.exp(-sum(wi*lg(a) for wi,a in zip(w,arrs))))
# rank transform each to [0,1]
def rank(a):
    r=np.empty_like(a); r[np.argsort(a)]=np.linspace(0,1,len(a)); return r
ranks=sum(wi*rank(a) for wi,a in zip(w,arrs))
print('raw',m(raw),'logit',m(logit),'rank',m(ranks))
PY
