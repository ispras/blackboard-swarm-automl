    tp=tp1+tp2; fp=fp1+fp2; fn=(pos1-tp1)+(pos2-tp2); tn=(len(yp_)-pos1-fp1)+(len(yg_)-pos2-fp2)
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); return (tp*tn-fp*fn)/den if den>0 else 0
