for k in ["track","pairh","ach1","ach2","stackr","pvid"]:
    P[k+"_s"]=P.groupby(keyp,sort=False)[k].transform(lambda x:x.rolling(5,center=True,min_periods=1).mean())
wp={"track":0.083,"pairh":0.385,"ach1":0.116,"ach2":0.415}
P["pbase"]=sum(w*P[k+"_s"] for k,w in wp.items())
def lg(x): x=np.clip(x,1e-7,1-1e-7); return np.log(x/(1-x))
P["pvidblend"]=1/(1+np.exp(-(0.8*lg(P.pbase.values)+0.2*lg(P.pvid_s.values))))
# ground
G=None
for key,path,col in [("track",f"{R}/rigel_delta/testpred_ground.parquet","prob"),("ach1",f"{R}/achernar_sigma/testpred_ground_lgbv1.parquet","pred"),
                     ("ach2",f"{R}/achernar_sigma/testpred_ground_lgbv2.parquet","pred"),("ctab",f"{C}/ground_test_tab.parquet","pred"),
                     ("cvid",f"{C}/ground_test_video.parquet","pred"),("stackr",f"{R}/rigel_delta/ground_test_stack_r.parquet","prob")]:
    if key=="ctab": d=pd.read_parquet(path)[["contact_id","game_play","step","nfl_player_id_1",col]].rename(columns={col:key,"nfl_player_id_1":"nfl_player_id_1"})
    elif key=="cvid": d=pd.read_parquet(path)[["contact_id","game_play","step","nfl_player_id_1",col]].rename(columns={col:key}) if "nfl_player_id_1" in pd.read_parquet(path).columns else pd.read_parquet(path)[["contact_id","game_play","step","pid",col]].rename(columns={col:key,"pid":"nfl_player_id_1"})
    else: d=pd.read_parquet(path)[["contact_id","game_play","step","nfl_player_id_1",col]].rename(columns={col:key})
    G=d if G is None else G.merge(d.drop(columns=["game_play","step","nfl_player_id_1"]),on="contact_id",how="left")
G=G.sort_values(["game_play","nfl_player_id_1","step"]).reset_index(drop=True)
