P["pvidblend"]=1/(1+np.exp(-(0.8*lg(P.pbase.values)+0.2*lg(P.pvid_s.values))))
# ground base
G=pd.read_parquet(f"{R}/rigel_delta/testpred_ground.parquet")[["contact_id","game_play","step","nfl_player_id_1","prob"]].rename(columns={"prob":"track","nfl_player_id_1":"pid"})
