# seq average
seq=None
for s in [1,2,3,4]:
    d=pd.read_parquet(f"{R}/rigel_delta/oof_pair_seq_s{s}.parquet",columns=["contact_id","prob"]).rename(columns={"prob":f"seq{s}"})
    P=P.merge(d,on="contact_id",how="left"); seq=[f"seq{s}" for s in [1,2,3,4]]
P["seq"]=P[seq].mean(1); pm["seq"]=(None,"seq")
P=P.sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True)
kp=["game_play","nfl_player_id_1","nfl_player_id_2"]
for k in pm: P[k+"_s"]=P.groupby(kp,sort=False)[k].transform(lambda x:x.rolling(5,center=True,min_periods=1).mean()).values
yp=P.contact.values
def sp(w):
    p=sum(wi*P[k+"_s"] for wi,k in zip(w,pm))
    th=np.quantile(p,1-0.012); pred=p>=th
    tp=((pred)&(yp==1)).sum(); fp=((pred)&(yp==0)).sum(); fn=((~pred)&(yp==1)).sum(); tn=((~pred)&(yp==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(41); bestp=(-1,None)
for _ in range(900):
