import pandas as pd, numpy as np, sys
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/castor_alpha")
from evutil import mcc_curve
from thr_opt import cand_thresholds, conf_at, mcc_from
R="/download_job_code/payload/sandbox/workspaces/rigel_delta"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"
g=pd.read_parquet(f"{R}/ground_oof_stack_r.parquet").sort_values(["game_play","nfl_player_id_1","step"]).reset_index(drop=True)
g["p"]=g.groupby(["game_play","nfl_player_id_1"],sort=False).prob.transform(lambda x:x.rolling(15,center=True,min_periods=1).mean())
yg=g.contact.values.astype(np.int8); pg=g.p.values
m,th=mcc_curve(yg,pg); print("ground stack_r smooth15 MCC %.5f th %.5g"%(m,th),flush=True)
# run filter
key=g.game_play.astype(str)+"_"+g.nfl_player_id_1.astype(str); codes,_=pd.factorize(key,sort=False)
order=np.argsort(codes,kind="stable"); starts=np.searchsorted(codes[order],np.arange(codes.max()+1),side="left"); ends=np.searchsorted(codes[order],np.arange(codes.max()+1),side="right")
groups=[order[s:e] for s,e in zip(starts,ends)]
def apply_filter(pred,min_len,min_gap,extend):
    out=pred.copy()
    for ii in groups:
        s=pred[ii]
        if extend>0:
            t=s.copy()
            for e in range(1,extend+1):
                t[e:]=np.maximum(t[e:],s[:-e]); t[:-e]=np.maximum(t[:-e],s[e:])
            s=t
        if min_len>1:
            d=np.diff(np.concatenate([[0],s,[0]])); st=np.where(d==1)[0]; en=np.where(d==-1)[0]
            for a,b in zip(st,en):
                if b-a<min_len: s[a:b]=0
        out[ii]=s
    return out
best=(0,None)
for rate in [0.036,0.038,0.040,0.042,0.044,0.046]:
    tth=np.quantile(pg,1-rate); base=(pg>=tth).astype(np.int8)
    tp=((base)&(yg==1)).sum(); fp=((base)&(yg==0)).sum(); fn=((~base)&(yg==1)).sum(); tn=((~base)&(yg==0)).sum()
    print(" rate",rate,"base MCC %.5f"%mcc_from(tp,fp,fn,tn),flush=True)
    for ml in [1,4,6,8,10]:
        for ex in [0,1,2,3]:
            pr=apply_filter(base,ml,1,ex)
            tp=((pr==1)&(yg==1)).sum(); fp=((pr==1)&(yg==0)).sum(); fn=((pr==0)&(yg==1)).sum(); tn=((pr==0)&(yg==0)).sum()
            mm=mcc_from(tp,fp,fn,tn)
            if mm>best[0]: best=(mm,(rate,ml,ex))
print("ground stack_r filter BEST",best,flush=True)
# pair
p=pd.read_parquet(f"{R}/oof_pair_stack_r.parquet").sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True)
for win in [1,3,5]:
    if win==1: pp=p.prob.values
    else: pp=p.groupby(["game_play","nfl_player_id_1","nfl_player_id_2"],sort=False).prob.transform(lambda x:x.rolling(win,center=True,min_periods=1).mean()).values
    m,th=mcc_curve(p.contact.values,pp); print("pair stack_r win",win,"MCC %.5f"%m,"th",th,flush=True)
PY
