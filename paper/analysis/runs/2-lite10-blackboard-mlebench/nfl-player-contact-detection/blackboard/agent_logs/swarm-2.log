import pandas as pd, numpy as np
from sklearn.metrics import roc_auc_score
R="/download_job_code/payload/sandbox"
lab=pd.read_csv(f"{R}/data/train_labels.csv",usecols=["game_play","step","nfl_player_id_1","nfl_player_id_2","contact"])
pair=lab[lab.nfl_player_id_2.astype(str)!="G"].copy()
pair["nfl_player_id_2"]=pair.nfl_player_id_2.astype(int)
rng=np.random.RandomState(0)
idx=rng.choice(len(pair),size=300000,replace=False)
pair=pair.iloc[idx].copy()
h=pd.read_csv(f"{R}/data/train_baseline_helmets.csv",usecols=["game_play","view","frame","nfl_player_id","left","width","top","height"])
h=h[h.view.isin(["Sideline","Endzone"])].copy()
h["cx"]=h.left+h.width/2; h["cy"]=h.top+h.height/2
h=h[h.game_play.isin(pair.game_play.unique())]
h1=h.rename(columns={"nfl_player_id":"q1","cx":"cx1","cy":"cy1","width":"w1"})\) if False else h.rename(columns={"nfl_player_id":"q1","cx":"cx1","cy":"cy1","width":"w1"})
for off in [288,290,292,294,296,298,300,302,304]:
    pp=pair.copy(); pp["frame"]=np.round(off+pp.step.to_numpy()*5.994).astype(int)
    res={}
    for view in ["Sideline","Endzone"]:
        hv=h[h.view==view]
        a=hv.rename(columns={"nfl_player_id":"q1","cx":"cx1","cy":"cy1","width":"w1"})[["game_play","frame","q1","cx1","cy1","w1"]]
        b=hv.rename(columns={"nfl_player_id":"q2","cx":"cx2","cy":"cy2","width":"w2"})[["game_play","frame","q2","cx2","cy2","w2"]]
        m=pp.merge(a,left_on=["game_play","frame","nfl_player_id_1"],right_on=["game_play","frame","q1"],how="left")
        m=m.merge(b,left_on=["game_play","frame","nfl_player_id_2"],right_on=["game_play","frame","q2"],how="left")
        ok=m.cx1.notna()&m.cx2.notna()
        d=np.sqrt((m.cx1-m.cx2)**2+(m.cy1-m.cy2)**2)
        scale=(m.w1+m.w2)/2
        nd=(d/scale)
        mm=m[ok]; ndv=nd[ok]
        if len(mm)>1000 and mm.contact.nunique()>1:
            auc=roc_auc_score(mm.contact,-ndv.fillna(999))
            res[view]=(round(auc,4),int(ok.sum()),round(float(np.nanmedian(ndv[mm.contact==1])),2) if (mm.contact==1).any() else None)
        else: res[view]=(None,int(ok.sum()),None)
    print("off",off,res,flush=True)
