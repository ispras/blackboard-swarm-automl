import pandas as pd, numpy as np, os
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"
ss=pd.read_csv("/download_job_code/payload/sandbox/data/sample_submission.csv")[["contact_id"]]
ss["g"]=ss.contact_id.str.endswith("_G")
# pair
rt=pd.read_parquet(f"{R}/rigel_delta/testpred_pair.parquet")[["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","prob"]].rename(columns={"prob":"p_rigel"})
at=pd.read_parquet(f"{R}/achernar_sigma/testpred_pair_lgbv1.parquet")[["contact_id","pred"]].rename(columns={"pred":"p_ach"})
vt=pd.read_parquet(f"{C}/pair_test_video.parquet")[["contact_id","pred"]].rename(columns={"pred":"p_vid"})
pair=rt.merge(at,on="contact_id",how="left").merge(vt,on="contact_id",how="left")
pair["p"]=0.35*pair.p_rigel+0.65*pair.p_ach
pair=pair.sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True)
pair["p"]=pair.groupby(["game_play","nfl_player_id_1","nfl_player_id_2"],sort=False).p.transform(lambda x:x.rolling(5,center=True,min_periods=1).mean())
pair_vid = pair.copy()
pair_vid["p"]=np.clip(0.8*np.log(np.clip(pair_vid.p,1e-7,1-1e-7)/(1-np.clip(pair_vid.p,1e-7,1-1e-7)))+0.2*np.log(np.clip(pair_vid.p_vid,1e-7,1-1e-7)/(1-np.clip(pair_vid.p_vid,1e-7,1-1e-7))),-30,30)
pair_vid["p"]=1/(1+np.exp(-pair_vid.p))
# ground
rg=pd.read_parquet(f"{R}/rigel_delta/testpred_ground.parquet")[["contact_id","game_play","step","nfl_player_id_1","prob"]].rename(columns={"prob":"a","nfl_player_id_1":"pid"})
ag=pd.read_parquet(f"{R}/achernar_sigma/testpred_ground_lgbv1.parquet")[["contact_id","pred"]].rename(columns={"pred":"b"})
ct=pd.read_parquet(f"{C}/ground_test_tab.parquet")[["contact_id","pred"]].rename(columns={"pred":"c"})
cv=pd.read_parquet(f"{C}/ground_test_video.parquet")[["contact_id","pred"]].rename(columns={"pred":"d"})
gr=rg.merge(ag,on="contact_id",how="left").merge(ct,on="contact_id",how="left").merge(cv,on="contact_id",how="left")
gr["p"]=0.218*gr.a+0.248*gr.b+0.051*gr.c+0.482*gr.d
gr=gr.sort_values(["game_play","pid","step"]).reset_index(drop=True)
gr["p"]=gr.groupby(["game_play","pid"],sort=False).p.transform(lambda x:x.rolling(9,center=True,min_periods=1).mean())
print("pair rows",len(pair),"ground rows",len(gr),"ss",len(ss))
print("pair test raw rate @.3796",float((pair.p>=0.3796).mean()),"ground @.467",float((gr.p>=0.467).mean()))
def write(name,prate, grate, use_vid=False):
    P=pair_vid if use_vid else pair
    pth=np.quantile(P.p.values,1-prate) if prate is not None else 0.3796
    gth=np.quantile(gr.p.values,1-grate) if grate is not None else 0.467
    lab_pd=(P.p>=pth).astype(int); lab_gd=(gr.p>=gth).astype(int)
    out=pd.concat([P[["contact_id"]].assign(contact=lab_pd.values), gr[["contact_id"]].assign(contact=lab_gd.values)],ignore_index=True)
    out=ss.merge(out,on="contact_id",how="left"); out["contact"]=out.contact.fillna(0).astype(int)
    assert len(out)==len(ss) and out.contact.isna().sum()==0
    path=f"{C}/{name}.csv"; out[["contact_id","contact"]].to_csv(path,index=False)
    d=ss.merge(out,on="contact_id")
    print(name,"th_p",round(float(pth),5),"th_g",round(float(gth),5),"overall",round(d.contact.mean(),5),"pair",round(d[~d.g].contact.mean(),5),"ground",round(d[d.g].contact.mean(),5),"npos",int(d.contact.sum()),flush=True)
    return path
write("submission_castor_raw",None,None)
write("submission_castor_rate",0.0115,0.045)
write("submission_castor_mid",0.0105,0.045)
write("submission_castor_vid",0.0115,0.045,use_vid=True)
print("DONE")
