rows=[]
for f in sorted(np.unique(gf)):
    gtr=gf!=f; gva=gf==f; ptr=pf!=f; pva=pf==f
    # thresholds chosen on training folds, optimizing combined MCC on those rows
    m,tg,tp=best_two(gy[gtr],gp[gtr],py[ptr],pp[ptr],k=80)
    # ratio on training folds at these thresholds
    rg_tr=(gp[gtr]>=tg).mean(); rp_tr=(pp[ptr]>=tp).mean()
    # apply raw thresholds to val
