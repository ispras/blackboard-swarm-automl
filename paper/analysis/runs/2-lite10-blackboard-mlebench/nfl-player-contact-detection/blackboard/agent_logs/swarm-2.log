for w in [(0.25,0.30,0.45),(0.0,0.3,0.7),(0.2,0.2,0.6),(0.1,0.2,0.7),(0.0,0.0,1.0),(0.0,1.0,0.0)]:
    g["pblend"]=w[0]*g.p_rigel+w[1]*g.p_ctab+w[2]*g.p_ach
    m,th=mcc_curve(g.contact.values,g.pblend.values)
    print("w",w,"ground MCC %.5f"%m,flush=True)
# smoothing on given blend
w=(0.25,0.30,0.45); g["pblend"]=w[0]*g.p_rigel+w[1]*g.p_ctab+w[2]*g.p_ach
g=g.sort_values(["game_play","nfl_player_id_1","step"]).reset_index(drop=True)
grp=g.groupby(["game_play","nfl_player_id_1"],sort=False)
for win in [3,5,7]:
    sm=grp.pblend.transform(lambda s: s.rolling(win,center=True,min_periods=1).mean())
    m,th=mcc_curve(g.contact.values,sm.values); print("rollmean",win,"ground MCC %.5f"%m,flush=True)
# weighted prev/next
prev=grp.pblend.shift(1).fillna(g.pblend); nxt=grp.pblend.shift(-1).fillna(g.pblend)
for a in [0.15,0.25,0.35,0.45]:
    sm=(1-2*a)*g.pblend+a*prev+a*nxt
    m,th=mcc_curve(g.contact.values,sm.values); print("prevnext a",a,"ground MCC %.5f"%m,flush=True)
# isolation removal / gap fill as postprocess by threshold
def apply_rule(pred, mode):
    s=pd.Series(pred)
    grp2=s.groupby([g.game_play.values,g.nfl_player_id_1.values])
    prev=grp2.shift(1).fillna(0).values; nxt=grp2.shift(-1).fillna(0).values
    if mode=="isolated": return pred*((prev+nxt)>0)
    if mode=="gapfill": return np.maximum(pred,((prev>0)&(nxt>0)).astype(int))
    return pred
for win in [3]:
    sm=grp.pblend.transform(lambda s: s.rolling(win,center=True,min_periods=1).mean())
    m,th=mcc_curve(g.contact.values,sm.values); pred=(sm>=th).astype(int)
    for mode in ["isolated","gapfill"]:
        pr=apply_rule(pred,mode)
        y=g.contact.values
        tp=((pr==1)&(y==1)).sum(); fp=((pr==1)&(y==0)).sum(); fn=((pr==0)&(y==1)).sum(); tn=((pr==0)&(y==0)).sum()
        den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); print(mode,"ground MCC %.5f"%(0 if den==0 else (tp*tn-fp*fn)/den),flush=True)
