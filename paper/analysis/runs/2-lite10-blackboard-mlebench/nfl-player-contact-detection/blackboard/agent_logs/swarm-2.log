import numpy as np
from sklearn.metrics import roc_auc_score

def mcc_curve(y,p):
    y=np.asarray(y,np.int8); p=np.asarray(p,np.float64)
    order=np.argsort(p)
    ys=y[order]; ps=p[order]
    # thresholds at unique values; predicted positive = p >= th
    # iterate from high to low using cumsum from top
    tp=np.cumsum(ys[::-1])[::-1]  # tp if predict all with index>=i
    fp=np.cumsum((1-ys)[::-1])[::-1]
    P=ys.sum(); N=len(ys)-P
    # at each start index i (predict positions i..n-1), threshold = ps[i]; ties problem but fine
    fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)).astype(np.float64)
    mcc=np.where(den>0,(tp*tn-fp*fn)/np.maximum(den,1e-12),0)
    # only consider boundaries where ps changes
    valid=np.ones(len(ps),bool); valid[1:]=ps[1:]!=ps[:-1]
    mcc=np.where(valid,mcc,0)
    i=int(np.argmax(mcc))
    return float(mcc[i]), float(ps[i])

def ev(name,y,p):
    auc=roc_auc_score(y,p); m,th=mcc_curve(y,p)
    print(f"{name} n {len(y)} pos {int(np.sum(y))} AUC {auc:.5f} MCC {m:.5f} th {th:.6g}",flush=True)
    return m,th
