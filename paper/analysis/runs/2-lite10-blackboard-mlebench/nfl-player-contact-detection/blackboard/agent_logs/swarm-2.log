[0m$ [0mcd /download_job_code/payload/sandbox && cat > workspaces/castor_alpha/calib_offset.py <<'PY'
import pandas as pd, numpy as np
from sklearn.metrics import roc_auc_score
R="/download_job_code/payload/sandbox"
lab=pd.read_csv(f"{R}/data/train_labels.csv",usecols=["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact"])
# sample pair rows: stratified-ish
pair=lab[lab.nfl_player_id_2.astype(str)!="G"].copy()
rng=np.random.RandomState(0)
idx=rng.choice(len(pair),size=300000,replace=False)
pair=pair.iloc[idx].copy()
h=pd.read_csv(f"{R}/data/train_baseline_helmets.csv",usecols=["game_play","view","frame","nfl_player_id","left","width","top","height"])
h=h[h.view.isin(["Sideline","Endzone"])].copy()
h["cx"]=h.left+h.width/2; h["cy"]=h.top+h.height/2
# keep only needed plays to reduce
plays=set(pair.game_play.unique()); h=h[h.game_play.isin(plays)]
for off in [288,290,292,294,296,298,300,302,304]:
    fr=np.round(off+pair.step.to_numpy()*5.994).astype(int)
    pp=pair.copy(); pp["frame"]=fr
    res={}
    for view in ["Sideline","Endzone"]:
        hv=h[h.view==view]
        m=pp.merge(hv[["game_play","frame","nfl_player_id","cx","cy","width"]],left_on=["game_play","frame","nfl_player_id_1"],right_on=["game_play","frame","nfl_player_id"],how="left",suffixes=("","_1"))
        m=m.merge(hv[["game_play","frame","nfl_player_id","cx","cy","width"]],left_on=["game_play","frame","nfl_player_id_2"],right_on=["game_play","frame","nfl_player_id"],how="left",suffixes=("_1","_2"))
        ok=m.cx_1.notna()&m.cx_2.notna()
        d=np.sqrt((m.cx_1-m.cx_2)**2+(m.cy_1-m.cy_2)**2)
        scale=(m.width_1+m.width_2)/2
        nd=(d/scale)
        mm=m[ok].copy(); nd=nd[ok]
        if len(mm)>1000 and mm.contact.nunique()>1:
            auc=roc_auc_score(mm.contact,-nd.fillna(999))
            res[view]=(round(auc,4),int(ok.sum()))
        else: res[view]=(None,int(ok.sum()))
    print("off",off,res,flush=True)
PY
