                     ("stackr",f"{R}/rigel_delta/testpred_pair_stack_r.parquet","prob")]:
    d=load_pair(path,col,key)
    P=d if P is None else P.merge(d.drop(columns=["game_play","step","nfl_player_id_1","nfl_player_id_2"]),on="contact_id",how="left")
