import numpy as np

def conf_at(y,p,th):
    pred=p>=th
    tp=int(((pred==1)&(y==1)).sum()); fp=int(((pred==1)&(y==0)).sum())
    fn=int(((pred==0)&(y==1)).sum()); tn=int(((pred==0)&(y==0)).sum())
    return tp,fp,fn,tn

def mcc_from(tp,fp,fn,tn):
    tp,fp,fn,tn=map(float,(tp,fp,fn,tn)); den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))
    return 0.0 if den==0 else (tp*tn-fp*fn)/den

def cand_thresholds(y,p,k=40):
    # candidate thresholds from top-k MCC points (dedup)
    from sklearn.metrics import roc_curve
    order=np.argsort(p); ys=np.asarray(y)[order]; ps=np.asarray(p)[order]
    tp=np.cumsum(ys[::-1])[::-1].astype(float); fp=np.cumsum((1-ys)[::-1])[::-1].astype(float)
    P=float(np.sum(ys)); N=float(len(ys))-P; fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); mcc=np.where(den>0,(tp*tn-fp*fn)/np.maximum(den,1e-12),0)
    valid=np.ones(len(ps),bool); valid[1:]=ps[1:]!=ps[:-1]
    mcc=np.where(valid,mcc,0)
    idx=np.argsort(mcc)[::-1][:k]
    return [float(ps[i]) for i in idx]

def best_two(y1,p1,y2,p2,k=50):
    c1=cand_thresholds(y1,p1,k); c2=cand_thresholds(y2,p2,k)
    C1=[conf_at(y1,p1,t) for t in c1]; C2=[conf_at(y2,p2,t) for t in c2]
    best=(-1,None,None)
    for i,(a,b,c,d) in enumerate(C1):
        for j,(e,f,g,h) in enumerate(C2):
            m=mcc_from(a+e,b+f,c+g,d+h)
            if m>best[0]: best=(m,c1[i],c2[j])
    return best

def add_conf(x,y):
    return tuple(int(a+b) for a,b in zip(x,y))
