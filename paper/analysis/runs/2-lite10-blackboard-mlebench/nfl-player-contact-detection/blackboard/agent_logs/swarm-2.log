gm["ach2"]=pd.read_parquet(f"{R}/achernar_sigma/oof_ground_lgbv2.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"ach2"})
gm["gfus"]=pd.read_parquet(f"{R}/achernar_sigma/oof_ground_gfus.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"gfus"})
gm["ctab"]=pd.read_parquet(f"{C}/ground_oof_tab.parquet",columns=["contact_id","oof"]).rename(columns={"oof":"ctab"})
gm["cvid"]=pd.read_parquet(f"{C}/ground_oof_video.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"cvid"})
gm["stackr"]=pd.read_parquet(f"{R}/rigel_delta/ground_oof_stack_r.parquet",columns=["contact_id","prob"]).rename(columns={"prob":"stackr"})
G=gb.copy()
for k,v in gm.items(): G=G.merge(v,on="contact_id",how="left")
G=G.sort_values(["game_play","nfl_player_id_1","step"]).reset_index(drop=True)
keyg=["game_play","nfl_player_id_1"]
sm={}
for wg in [7,11,15]:
    for k in gm: sm[(k,wg)]=G.groupby(keyg,sort=False)[k].transform(lambda x:x.rolling(wg,center=True,min_periods=1).mean()).values
yg=G.contact.values
def scoreg(w,keys,wg):
    p=np.zeros(len(G))
    for wi,k in zip(w,keys): p+=wi*sm[(k,wg)]
    th=np.quantile(p,1-0.045); pred=p>=th
    tp=((pred)&(yg==1)).sum(); fp=((pred)&(yg==0)).sum(); fn=((~pred)&(yg==1)).sum(); tn=((~pred)&(yg==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(3)
for wg in [7,11,15]:
    keys=list(gm); best=(-1,None)
    for _ in range(500):
        w=rng.dirichlet(np.ones(len(keys))); m,_=scoreg(w,keys,wg)
        if m>best[0]: best=(m,w.copy())
    print("wg",wg,"ground best",round(best[0],5),dict(zip(keys,np.round(best[1],3))),flush=True)
    if wg==15: wbest=best
m,gp=scoreg(wbest[1],list(gm),15)
# joint with pair best 4-model
P=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet")[["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact"]]
