from thr_opt import mcc_from, best_two
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"; A=f"{R}/achernar_sigma"
P=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet")[["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact"]]
pm={}
pm["track"]=(f"{R}/rigel_delta/oof_pair.parquet","prob")
pm["pairh"]=(f"{R}/rigel_delta/oof_pair_h.parquet","prob")
pm["ach1"]=(f"{A}/oof_pair_lgbv1.parquet","pred")
pm["ach2"]=(f"{A}/oof_pair_lgbv2.parquet","pred")
pm["gstack"]=(f"{A}/oof_pair_gstack.parquet","pred")
for k,(p,c) in pm.items():
    d=pd.read_parquet(p,columns=["contact_id",c]).rename(columns={c:k}); P=P.merge(d,on="contact_id",how="left")
P=P.sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True)
keyp=["game_play","nfl_player_id_1","nfl_player_id_2"]
for k in pm: P[k+"_s"]=P.groupby(keyp,sort=False)[k].transform(lambda x:x.rolling(5,center=True,min_periods=1).mean()).values
yp=P.contact.values
def sp(w):
    p=sum(wi*P[k+"_s"] for wi,k in zip(w,pm))
    th=np.quantile(p,1-0.012); pred=p>=th
    tp=((pred)&(yp==1)).sum(); fp=((pred)&(yp==0)).sum(); fn=((~pred)&(yp==1)).sum(); tn=((~pred)&(yp==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(11); bestp=(-1,None)
for _ in range(700):
    w=rng.dirichlet(np.ones(len(pm))); m,_=sp(w)
    if m>bestp[0]: bestp=(m,w.copy())
print("PAIR",round(bestp[0],5),dict(zip(pm,np.round(bestp[1],3))),flush=True)
_,pp=sp(bestp[1])
G=pd.read_parquet(f"{R}/rigel_delta/oof_ground.parquet")[["contact_id","game_play","step","nfl_player_id_1","contact"]]
gm={}
gm["track"]=(f"{R}/rigel_delta/oof_ground.parquet","prob")
gm["ach2"]=(f"{A}/oof_ground_lgbv2.parquet","pred")
gm["gfus"]=(f"{A}/oof_ground_gfus.parquet","pred")
gm["ctab"]=(f"{C}/ground_oof_tab.parquet","oof")
gm["cvid"]=(f"{C}/ground_oof_video.parquet","pred")
gm["stackr"]=(f"{R}/rigel_delta/ground_oof_stack_r.parquet","prob")
gm["gstack"]=(f"{A}/oof_ground_gstack.parquet","pred")
for k,(p,c) in gm.items():
    d=pd.read_parquet(p,columns=["contact_id",c]).rename(columns={c:k}); G=G.merge(d,on="contact_id",how="left")
G=G.sort_values(["game_play","nfl_player_id_1","step"]).reset_index(drop=True)
keyg=["game_play","nfl_player_id_1"]
for k in gm: G[k+"_s"]=G.groupby(keyg,sort=False)[k].transform(lambda x:x.rolling(15,center=True,min_periods=1).mean()).values
yg=G.contact.values
def sg(w):
    p=sum(wi*G[k+"_s"] for wi,k in zip(w,gm))
    th=np.quantile(p,1-0.045); pred=p>=th
    tp=((pred)&(yg==1)).sum(); fp=((pred)&(yg==0)).sum(); fn=((~pred)&(yg==1)).sum(); tn=((~pred)&(yg==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(12); bestg=(-1,None)
for _ in range(700):
    w=rng.dirichlet(np.ones(len(gm))); m,_=sg(w)
    if m>bestg[0]: bestg=(m,w.copy())
print("GROUND",round(bestg[0],5),dict(zip(gm,np.round(bestg[1],3))),flush=True)
_,gp=sg(bestg[1])
m,tg,tp=best_two(yg,gp,yp,pp,k=80)
print("JOINT",round(m,5),"tg",tg,"tp",tp,flush=True)
