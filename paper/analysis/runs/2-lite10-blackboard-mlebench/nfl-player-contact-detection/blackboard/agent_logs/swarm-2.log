import pandas as pd, numpy as np
from sklearn.metrics import roc_auc_score, matthews_corrcoef
R="/download_job_code/payload/sandbox/workspaces"
rg=pd.read_parquet(f"{R}/rigel_delta/oof_ground.parquet")
rp=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet")
ag=pd.read_parquet(f"{R}/achernar_sigma/oof_ground_lgbv1.parquet")
def ev(name,y,p):
    auc=roc_auc_score(y,p); best=(0,0)
    q=np.unique(np.quantile(p,np.linspace(0.5,0.9995,600)))
    for th in q:
        m=matthews_corrcoef(y,(p>=th).astype(int))
        if m>best[0]: best=(m,th)
    print(name,"n",len(y),"pos",int(y.sum()),"AUC %.4f"%auc,"MCC %.4f th %.4g"%(best[0],best[1]))
ev("rigel ground",rg.contact.values,rg.prob.values)
ev("achernar ground",ag.y.values,ag.pred.values)
ev("rigel pair",rp.contact.values,rp.prob.values)
# combined ground=achernar, pair=rigel global threshold scan
m=ag.merge(rp[["contact_id","prob"]].rename(columns={"prob":"pp"}),on="contact_id",how="inner")
print("merged",m.shape)
y=np.concatenate([ag.y.values,rp.contact.values]); p=np.concatenate([ag.pred.values,rp.prob.values])
ev("combined raw",y,p)
# per-subtype scale search for ground multiplier with global threshold
best=(0,0,0)
for gs in [0.5,1,2,3,5,8,12,20,30,50]:
    pp=np.concatenate([ag.pred.values*gs,rp.prob.values]); y2=y
    # threshold via quantiles
    for th in np.unique(np.quantile(pp,np.linspace(0.5,0.9995,300))):
        mm=matthews_corrcoef(y2,(pp>=th).astype(int))
        if mm>best[0]: best=(mm,gs,th)
print("combined scaled best MCC %.4f gs %s th %.4g"%best)
