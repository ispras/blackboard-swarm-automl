import pandas as pd, numpy as np, json, sys
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/castor_alpha")
from thr_opt import mcc_from
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"; A=f"{R}/achernar_sigma"
cfg=json.load(open(f"{R}/../final_solution/blend_final4.json"))
names=cfg["pair_names"]; w=np.array(cfg["pair_weights"])
# pair OOF
P=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet")[["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact"]]
src={"track":(f"{R}/rigel_delta/oof_pair.parquet","prob"),"pairh":(f"{R}/rigel_delta/oof_pair_h.parquet","prob"),
     "ach1":(f"{A}/oof_pair_lgbv1.parquet","pred"),"ach2":(f"{A}/oof_pair_lgbv2.parquet","pred"),
     "gstack":(f"{A}/oof_pair_gstack.parquet","pred"),"xgb":(f"{R}/rigel_delta/oof_pair_xgb.parquet","prob")}
for k,(p,c) in src.items():
    d=pd.read_parquet(p,columns=["contact_id",c]).rename(columns={c:k}); P=P.merge(d,on="contact_id",how="left")
seq=[]
for s in range(5):
    d=pd.read_parquet(f"{R}/rigel_delta/oof_pair_seq_s{s}.parquet",columns=["contact_id","prob"]).rename(columns={"prob":f"s{s}"}); P=P.merge(d,on="contact_id"); seq.append(f"s{s}")
P["seq"]=P[seq].mean(1)
P=P.sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True)
P["pp"]=sum(w[i]*P[names[i]] for i in range(len(names)))
P["pp"]=P.groupby(["game_play","nfl_player_id_1","nfl_player_id_2"],sort=False).pp.transform(lambda x:x.rolling(3,center=True,min_periods=1).mean())
yp=P.contact.values; pp=P.pp.values
from sklearn.metrics import roc_auc_score, matthews_corrcoef
print("pair AUC",round(roc_auc_score(yp,pp),5),"pair MCC",round(matthews_corrcoef(yp,(pp>=np.quantile(pp,1-0.012)).astype(int)),5),flush=True)
# ground OOF
G=pd.read_parquet(f"{R}/rigel_delta/ground_oof_best.parquet")[["game_play","contact","prob"]].rename(columns={"prob":"gp"})
yg=G.contact.values; gp=G.gp.values
print("ground MCC",round(matthews_corrcoef(yg,(gp>=np.quantile(gp,1-0.046)).astype(int)),5),flush=True)
# global thresholds
thp=np.quantile(pp,1-0.012); thg=np.quantile(gp,1-0.046)
# per play indices
plays=sorted(set(P.game_play.unique()) | set(G.game_play.unique()))
p_idx={gp_:np.where(P.game_play.values==gp_)[0] for gp_ in P.game_play.unique()}
g_idx={gp_:np.where(G.game_play.values==gp_)[0] for gp_ in G.game_play.unique()}
pl=list(p_idx.keys())
rng=np.random.RandomState(123); ms=[]
for rep in range(300):
    samp=rng.choice(pl,size=24,replace=True)
    ii=np.concatenate([p_idx[g] for g in samp]); jj=np.concatenate([g_idx[g] for g in samp])
    ppred=pp[ii]>=thp; gpred=gp[jj]>=thg
    yy=np.concatenate([yp[ii],yg[jj]]); pr=np.concatenate([ppred,gpred])
    tp=((pr)&(yy==1)).sum(); fp=((pr)&(yy==0)).sum(); fn=((~pr)&(yy==1)).sum(); tn=((~pr)&(yy==0)).sum()
    ms.append(mcc_from(tp,fp,fn,tn))
ms=np.array(ms)
print("24-play bootstrap MCC: mean %.5f std %.5f q05 %.5f q25 %.5f med %.5f q75 %.5f q95 %.5f"%(ms.mean(),ms.std(),*np.quantile(ms,[.05,.25,.5,.75,.95])),flush=True)
