    "gstack":(f"{A}/oof_pair_gstack.parquet","pred")}
for k,(p,c) in pm.items():
    d=pd.read_parquet(p,columns=["contact_id",c]).rename(columns={c:k}); P=P.merge(d,on="contact_id",how="left")
seqcols=[]
for s in range(5):
    d=pd.read_parquet(f"{R}/rigel_delta/oof_pair_seq_s{s}.parquet",columns=["contact_id","prob"]).rename(columns={"prob":f"seq{s}"})
    P=P.merge(d,on="contact_id",how="left"); seqcols.append(f"seq{s}")
P["seq"]=P[seqcols].mean(1); pm["seq"]=(None,"seq")
P=P.sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True); kp=["game_play","nfl_player_id_1","nfl_player_id_2"]
for k in pm: P[k+"_s"]=P.groupby(kp,sort=False)[k].transform(lambda x:x.rolling(5,center=True,min_periods=1).mean()).values
yp=P.contact.values
def sp(w):
    p=sum(wi*P[k+"_s"] for wi,k in zip(w,pm)); th=np.quantile(p,1-0.012); pred=p>=th
    tp=((pred)&(yp==1)).sum(); fp=((pred)&(yp==0)).sum(); fn=((~pred)&(yp==1)).sum(); tn=((~pred)&(yp==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(201); bestp=(-1,None)
for _ in range(900):
    w=rng.dirichlet(np.ones(len(pm))); m,_=sp(w)
    if m>bestp[0]: bestp=(m,w.copy())
print("PAIR",round(bestp[0],5),dict(zip(pm,np.round(bestp[1],3))),flush=True)
_,pp=sp(bestp[1])
# GROUND
G=pd.read_parquet(f"{R}/rigel_delta/oof_ground.parquet")[["contact_id","game_play","step","nfl_player_id_1","contact"]].rename(columns={"nfl_player_id_1":"pid"})
gm={"track":(f"{R}/rigel_delta/oof_ground.parquet","prob"),"ach2":(f"{A}/oof_ground_lgbv2.parquet","pred"),
    "gfus":(f"{A}/oof_ground_gfus.parquet","pred"),"ctab":(f"{C}/ground_oof_tab.parquet","oof"),
    "cvid":(f"{C}/ground_oof_video.parquet","pred"),"ceff":(f"{C}/ground_oof_video_eff.parquet","pred"),
    "cr34":(f"{C}/ground_oof_video_r34.parquet","pred"),"ccnx":(f"{C}/ground_oof_video_cnx.parquet","pred"),
    "stackr":(f"{R}/rigel_delta/ground_oof_stack_r.parquet","prob"),"gstack":(f"{A}/oof_ground_gstack.parquet","pred"),
    "gstack2":(f"{A}/oof_ground_gstack2.parquet","pred")}
for k,(p,c) in gm.items():
    d=pd.read_parquet(p,columns=["contact_id",c]).rename(columns={c:k}); G=G.merge(d,on="contact_id",how="left")
G=G.sort_values(["game_play","pid","step"]).reset_index(drop=True); kg=["game_play","pid"]
for wg in [11,15,19]:
    for k in gm: G[k+f"_{wg}"]=G.groupby(kg,sort=False)[k].transform(lambda x:x.rolling(wg,center=True,min_periods=1).mean()).values
yg=G.contact.values
def sg(w,wg):
    p=sum(wi*G[k+f"_{wg}"] for wi,k in zip(w,gm)); th=np.quantile(p,1-0.045); pred=p>=th
    tp=((pred)&(yg==1)).sum(); fp=((pred)&(yg==0)).sum(); fn=((~pred)&(yg==1)).sum(); tn=((~pred)&(yg==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
bestg=(-1,None,None)
for wg in [11,15,19]:
    rng=np.random.RandomState(300+wg); b=(-1,None)
    for _ in range(1200):
        w=rng.dirichlet(np.ones(len(gm))); m,_=sg(w,wg)
        if m>b[0]: b=(m,w.copy())
    print("GROUND wg",wg,round(b[0],5),dict(zip(gm,np.round(b[1],3))),flush=True)
    if b[0]>bestg[0]: bestg=(b[0],b[1],wg)
print("BEST GROUND",round(bestg[0],5),"wg",bestg[2],flush=True)
_,gp=sg(bestg[1],bestg[2])
m,tg,tp=best_two(yg,gp,yp,pp,k=100)
print("JOINT",round(m,5),"tg",tg,"tp",tp,flush=True)
json.dump({"pair_models":list(pm),"pair_weights":[float(x) for x in bestp[1]],"ground_models":list(gm),"ground_weights":[float(x) for x in bestg[1]],"ground_smooth":int(bestg[2]),"joint":float(m)},open(f"{C}/final_all_blend.json","w"),indent=1)
pd.DataFrame({"contact_id":G.contact_id,"y":yg,"pred":gp}).to_parquet(f"{C}/ground_oof_ens_all.parquet",index=False)
