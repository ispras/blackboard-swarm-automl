R="/download_job_code/payload/sandbox"; W=f"{R}/workspaces/castor_alpha"; A=f"{R}/workspaces/achernar_sigma"
tcols=["step","dist","dx","dy","rel_speed","closing","speed_sum","same_team","nn_any_1","nn_opp_1","nn_team_1","n_within2_1","n_opp_within2_1","n_within4_1","speed_nn_opp_1","speed_1","acceleration_1","sa_1","speed_rmean5_1","acc_rmean5_1","nn_any_2","nn_opp_2","nn_team_2","n_within2_2","n_opp_within2_2","n_within4_2","speed_nn_opp_2","speed_2","acceleration_2","sa_2","speed_rmean5_2","acc_rmean5_2","x_position_1","y_position_1","x_position_2","y_position_2"]
for split in ["train","test"]:
    h=pd.read_parquet(f"{A}/{split}_helmet_features.parquet")
    t=pd.read_parquet(f"{A}/{split}_tracking_features.parquet",columns=["contact_id"]+tcols)
    print(split,"align",(h.contact_id.values==t.contact_id.values).mean(),h.shape,t.shape,flush=True)
    t=t.drop(columns=["contact_id"])
    # float32
    for c in h.columns:
        if c!="contact_id" and pd.api.types.is_numeric_dtype(h[c]): h[c]=h[c].astype(np.float32)
    for c in t.columns:
        if pd.api.types.is_numeric_dtype(t[c]): t[c]=t[c].astype(np.float32)
    out=pd.concat([h,t],axis=1)
    out.to_parquet(f"{W}/pair_{split}_feats.parquet",index=False)
    print("saved",split,out.shape,flush=True)
print("DONE")
