    "stackr":(f"{R}/rigel_delta/ground_oof_stack_r.parquet","prob"),"gstack":(f"{A}/oof_ground_gstack.parquet","pred")}
for k,(p,c) in gm.items():
    d=pd.read_parquet(p,columns=["contact_id",c]).rename(columns={c:k}); G=G.merge(d,on="contact_id",how="left")
G=G.sort_values(["game_play","pid","step"]).reset_index(drop=True); kg=["game_play","pid"]
for k in gm: G[k+"_s"]=G.groupby(kg,sort=False)[k].transform(lambda x:x.rolling(15,center=True,min_periods=1).mean()).values
yg=G.contact.values
def sg(w):
    p=sum(wi*G[k+"_s"] for wi,k in zip(w,gm))
    th=np.quantile(p,1-0.045); pred=p>=th
    tp=((pred)&(yg==1)).sum(); fp=((pred)&(yg==0)).sum(); fn=((~pred)&(yg==1)).sum(); tn=((~pred)&(yg==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(42); bestg=(-1,None)
for _ in range(900):
    w=rng.dirichlet(np.ones(len(gm))); m,_=sg(w)
    if m>bestg[0]: bestg=(m,w.copy())
print("GROUND",round(bestg[0],5),dict(zip(gm,np.round(bestg[1],3))),flush=True)
_,gp=sg(bestg[1])
m,tg,tp=best_two(yg,gp,yp,pp,k=100)
print("JOINT",round(m,5),"tg",tg,"tp",tp,flush=True)
import json
json.dump({"pair_models":list(pm),"pair_weights":[float(x) for x in bestp[1]],"ground_models":list(gm),"ground_weights":[float(x) for x in bestg[1]],"ground_smooth":15,"joint":float(m)},open(f"{C}/final_r34_blend.json","w"),indent=1)
