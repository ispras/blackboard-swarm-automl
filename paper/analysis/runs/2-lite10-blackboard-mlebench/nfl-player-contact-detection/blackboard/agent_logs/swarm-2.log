    oof[va]=m.predict_proba(X[va])[:,1]
    print("fold",f,"iter",m.best_iteration_,"auc",round(roc_auc_score(y[va],oof[va]),5),flush=True)
print("STACK2 OOF AUC",round(roc_auc_score(y,oof),5),flush=True)
m,th=mcc_curve(y,oof); print("STACK2 ground MCC",round(m,5),"th",th,flush=True)
pd.DataFrame({"contact_id":g.contact_id,"y":y,"fold":folds,"pred":oof}).to_parquet(f"{C}/ground_oof_stack2.parquet",index=False)
