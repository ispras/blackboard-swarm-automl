import pandas as pd, numpy as np, sys
from scipy.stats import rankdata
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/castor_alpha")
from thr_opt import mcc_from, best_two
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"
# PAIR
P=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet")[["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact"]]
pm={}
pm["track"]=pd.read_parquet(f"{R}/rigel_delta/oof_pair.parquet",columns=["contact_id","prob"]).rename(columns={"prob":"track"})
pm["pairh"]=pd.read_parquet(f"{R}/rigel_delta/oof_pair_h.parquet",columns=["contact_id","prob"]).rename(columns={"prob":"pairh"})
pm["ach1"]=pd.read_parquet(f"{R}/achernar_sigma/oof_pair_lgbv1.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"ach1"})
pm["ach2"]=pd.read_parquet(f"{R}/achernar_sigma/oof_pair_lgbv2.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"ach2"})
for k,v in pm.items(): P=P.merge(v,on="contact_id",how="left")
P=P.sort_values(["game_play","nfl_player_id_1","nfl_player_id_2","step"]).reset_index(drop=True)
keyp=["game_play","nfl_player_id_1","nfl_player_id_2"]
Rk={}
for k in pm:
    s=P.groupby(keyp,sort=False)[k].transform(lambda x:x.rolling(5,center=True,min_periods=1).mean()).values
    Rk[k]=rankdata(s,method="average")/len(s)
yp=P.contact.values
def sp(w):
    p=sum(wi*Rk[k] for wi,k in zip(w,pm))
    th=np.quantile(p,1-0.012); pred=p>=th
    tp=((pred)&(yp==1)).sum(); fp=((pred)&(yp==0)).sum(); fn=((~pred)&(yp==1)).sum(); tn=((~pred)&(yp==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(5); bestp=(-1,None)
for _ in range(300):
    w=rng.dirichlet(np.ones(len(pm))); m,_=sp(w)
    if m>bestp[0]: bestp=(m,w.copy())
print("PAIR rank",round(bestp[0],5),dict(zip(pm,np.round(bestp[1],3))),flush=True)
_,pp=sp(bestp[1])
# GROUND
G=pd.read_parquet(f"{R}/rigel_delta/oof_ground.parquet")[["contact_id","game_play","step","nfl_player_id_1","contact"]]
gm={}
gm["track"]=pd.read_parquet(f"{R}/rigel_delta/oof_ground.parquet",columns=["contact_id","prob"]).rename(columns={"prob":"track"})
gm["ach2"]=pd.read_parquet(f"{R}/achernar_sigma/oof_ground_lgbv2.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"ach2"})
gm["gfus"]=pd.read_parquet(f"{R}/achernar_sigma/oof_ground_gfus.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"gfus"})
gm["ctab"]=pd.read_parquet(f"{C}/ground_oof_tab.parquet",columns=["contact_id","oof"]).rename(columns={"oof":"ctab"})
gm["cvid"]=pd.read_parquet(f"{C}/ground_oof_video.parquet",columns=["contact_id","pred"]).rename(columns={"pred":"cvid"})
gm["stackr"]=pd.read_parquet(f"{R}/rigel_delta/ground_oof_stack_r.parquet",columns=["contact_id","prob"]).rename(columns={"prob":"stackr"})
for k,v in gm.items(): G=G.merge(v,on="contact_id",how="left")
G=G.sort_values(["game_play","nfl_player_id_1","step"]).reset_index(drop=True)
keyg=["game_play","nfl_player_id_1"]
Rg={}
for k in gm:
    s=G.groupby(keyg,sort=False)[k].transform(lambda x:x.rolling(15,center=True,min_periods=1).mean()).values
    Rg[k]=rankdata(s,method="average")/len(s)
yg=G.contact.values
def sg(w):
    p=sum(wi*Rg[k] for wi,k in zip(w,gm))
    th=np.quantile(p,1-0.045); pred=p>=th
    tp=((pred)&(yg==1)).sum(); fp=((pred)&(yg==0)).sum(); fn=((~pred)&(yg==1)).sum(); tn=((~pred)&(yg==0)).sum()
    return mcc_from(tp,fp,fn,tn),p
rng=np.random.RandomState(6); bestg=(-1,None)
for _ in range(300):
    w=rng.dirichlet(np.ones(len(gm))); m,_=sg(w)
    if m>bestg[0]: bestg=(m,w.copy())
print("GROUND rank",round(bestg[0],5),dict(zip(gm,np.round(bestg[1],3))),flush=True)
_,gp=sg(bestg[1])
m,tg,tp=best_two(yg,gp,yp,pp,k=80)
print("JOINT rank",round(m,5),"tg",tg,"tp",tp,flush=True)
