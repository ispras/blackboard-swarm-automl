import pandas as pd, numpy as np, sys
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/castor_alpha")
from evutil import mcc_curve
import lightgbm as lgb
from sklearn.metrics import roc_auc_score
R="/download_job_code/payload/sandbox/workspaces"; C="/download_job_code/payload/sandbox/workspaces/castor_alpha"
sr=pd.read_parquet(f"{R}/rigel_delta/ground_oof_stack_r.parquet")[["contact_id","game_play","step","nfl_player_id_1","contact","fold","prob"]].rename(columns={"prob":"pstack","nfl_player_id_1":"pid"})
cv=pd.read_parquet(f"{C}/ground_oof_video.parquet")[["contact_id","pred"]].rename(columns={"pred":"pvid"})
ft=pd.read_parquet(f"{C}/ground_train_feats.parquet")
print("ft cols",[c for c in ft.columns if c in ("position","team","pid","step")],flush=True)
keep=["contact_id"]+[c for c in ["position","team","nn_dist","bot_rank_s","bot_rank_e","speed","step"] if c in ft.columns]
g=sr.merge(cv,on="contact_id").merge(ft[keep],on="contact_id",how="left")
g["pos_code"]=pd.factorize(g.position)[0]
y=g.contact.values.astype(np.int8); fold=g.fold.values
# leave-fold-out player target encoding
prior=y.mean(); K=20.0
te=np.zeros(len(g)); cnt=np.zeros(len(g))
for f in np.unique(fold):
    va=fold==f; tr=~va
    agg=g[tr].groupby("pid").contact.agg(["sum","count"])
    m=g[va][["pid"]].merge(agg,left_on="pid",right_index=True,how="left")
    te[va]=(m["sum"].fillna(0)+prior*K)/(m["count"].fillna(0)+K)
    cnt[va]=m["count"].fillna(0)
g["te"]=te; g["te_cnt"]=cnt
print("TE alone AUC",round(roc_auc_score(y,te),4),flush=True)
# baseline
m,th=mcc_curve(y,g.pstack.values); print("pstack ground MCC",round(m,5),flush=True)
X=pd.DataFrame({"pstack":g.pstack.values,"pvid":g.pvid.values,"te":g.te.values,"te_cnt":g.te_cnt.values,
  "pos_code":g.pos_code.values,"step":g.step.values,"nn_dist":g.nn_dist.values,"bot_s":g.bot_rank_s.values,"bot_e":g.bot_rank_e.values,"speed":g.speed.values})
X=X.fillna(0)
oof=np.zeros(len(g))
for f in np.unique(fold):
    tr=fold!=f; va=fold==f
    m=lgb.LGBMClassifier(n_estimators=800,learning_rate=0.03,num_leaves=63,min_child_samples=80,subsample=0.8,colsample_bytree=0.8,reg_lambda=1.0,n_jobs=6,random_state=7)
    m.fit(X[tr],y[tr],eval_set=[(X[va],y[va])],eval_metric="auc",callbacks=[lgb.early_stopping(80)])
    oof[va]=m.predict_proba(X[va])[:,1]
    print("fold",f,"iter",m.best_iteration_,"auc",round(roc_auc_score(y[va],oof[va]),5),flush=True)
print("STACK+TE AUC",round(roc_auc_score(y,oof),5),flush=True)
m,th=mcc_curve(y,oof); print("STACK+TE ground MCC",round(m,5),flush=True)
PY
