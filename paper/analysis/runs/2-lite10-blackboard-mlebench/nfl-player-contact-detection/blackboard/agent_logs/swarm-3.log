gr=pos[pos.isg].merge(he,on="contact_id",how="left")
print("ground preds",len(gr),"cy_rank mean q",gr.x_cy_rank_mean.quantile([.1,.5,.9]).round(3).to_dict(),"step>=0 all",bool((gr.step>=0).all()))
# steps distribution
print("test step max in sample", pd.read_csv("data/sample_submission.csv").contact_id.str.split("_").str[2].astype(int).max())
