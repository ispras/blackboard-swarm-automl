import pandas as pd, numpy as np
from sklearn.metrics import roc_auc_score
o=pd.read_parquet("oof_ground_lgbv1.parquet")
print(o.shape, o.pred.isna().sum())
def best(y,p):
    qs=np.quantile(p,np.linspace(0.5,0.9999,300)); b=(-1,0)
    for t in qs:
        pr=p>=t; tp=np.sum(pr&(y==1)); fp=np.sum(pr&(y==0)); fn=np.sum((~pr)&(y==1)); tn=np.sum((~pr)&(y==0))
        den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); m=(tp*tn-fp*fn)/den if den>0 else 0
        if m>b[0]: b=(m,t)
    return b
print("ground best MCC", best(o.y.values,o.pred.values), "auc",roc_auc_score(o.y,o.pred))
t=pd.read_parquet("testpred_ground_lgbv1.parquet")
print(t.shape, t.pred.describe())
