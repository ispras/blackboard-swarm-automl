import pandas as pd, numpy as np
from scipy.stats import rankdata
W="workspaces"
def best_at(y,p,rate=0.048):
    th=np.quantile(p,1-rate); pred=p>=th
    tp=np.sum(pred&(y==1));fp=np.sum(pred&(y==0));fn=np.sum((~pred)&(y==1));tn=np.sum((~pred)&(y==0))
    den=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); return (tp*tn-fp*fn)/den if den>0 else 0
