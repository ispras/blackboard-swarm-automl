    m.fit(X.iloc[idx],y[idx],eval_set=(X.iloc[va],y[va]),use_best_model=True)
    oof[va]=m.predict_proba(X.iloc[va])[:,1].astype(np.float32)
    testp+=m.predict_proba(Xte)[:,1]/len(np.unique(foldv))
    log("fold",f,"best",m.get_best_iteration(),"auc",round(roc_auc_score(y[va],oof[va]),5))
log("OOF AUC",roc_auc_score(y,oof))
