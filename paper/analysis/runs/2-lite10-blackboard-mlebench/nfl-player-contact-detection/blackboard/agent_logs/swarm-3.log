import pandas as pd, numpy as np
from scipy.stats import rankdata
W="workspaces"
def mcc_at(y,p,rate=0.012):
    th=np.quantile(p,1-rate); pred=p>=th
    tp=np.sum(pred&(y==1));fp=np.sum(pred&(y==0));fn=np.sum((~pred)&(y==1));tn=np.sum((~pred)&(y==0))
    den=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); return (tp*tn-fp*fn)/den if den>0 else 0
files={"track":(f"{W}/rigel_delta/oof_pair.parquet","prob"),"pairh":(f"{W}/rigel_delta/oof_pair_h.parquet","prob"),
"pstack":(f"{W}/achernar_sigma/oof_pair_gstack.parquet","pred"),"v1":(f"{W}/achernar_sigma/oof_pair_lgbv1.parquet","pred"),
"v2":(f"{W}/achernar_sigma/oof_pair_lgbv2.parquet","pred"),"rstack":(f"{W}/rigel_delta/oof_pair_stack_r.parquet","prob"),
"seq":(f"{W}/achernar_sigma/oof_pair_seqavg.parquet","prob"),"xgb":(f"{W}/rigel_delta/oof_pair_xgb_avg.parquet","prob"),
"v4":(f"{W}/achernar_sigma/oof_pair_lgbv4.parquet","pred"),"cat":(f"{W}/achernar_sigma/oof_pair_cat.parquet","pred")}
base=None; yv=None; s={}
for k,(f,c) in files.items():
    d=pd.read_parquet(f)
    if base is None:
        base=d[["contact_id"]].copy(); yv=(d["contact"].values if "contact" in d else d["y"].values)
        p=d.contact_id.str.split("_",expand=True); base["gp"]=p[0]+"_"+p[1]; base["step"]=p[2].astype(int); base["p1"]=p[3]; base["p2"]=p[4]
    else: base=base.merge(d[["contact_id"]],on="contact_id",how="inner")
    s[k]=d.set_index("contact_id")[c]
base=base.sort_values(["gp","p1","p2","step"]).reset_index(drop=True)
y=base.contact_id.map(pd.Series(yv,index=pd.read_parquet(files["track"][0]).contact_id.values)).values
R={k:rankdata(s[k].reindex(base.contact_id).values)/len(base) for k in files}
g=[base.gp,base.p1,base.p2]
S={k:pd.Series(R[k]).groupby(g).transform(lambda x:x.rolling(3,center=True,min_periods=1).mean()).values for k in files}
print("cat single",mcc_at(y,S["cat"]),"xgb single",mcc_at(y,S["xgb"]),"v4 single",mcc_at(y,S["v4"]))
def hill(names):
    w=np.ones(len(names))/len(names); Sl=[S[k] for k in names]
    def sc(w): return mcc_at(y,sum(w[i]*Sl[i] for i in range(len(w))))
    best=(sc(w),w.copy())
    for it in range(8):
        imp=False
        for i in range(len(w)):
            for d in [0.08,-0.08,0.04,-0.04,0.02,-0.02]:
                w2=w.copy(); w2[i]=max(0,w2[i]+d)
                if w2.sum()==0: continue
                w2=w2/w2.sum(); s2=sc(w2)
                if s2>best[0]+1e-7: best=(s2,w2.copy()); w=w2; imp=True
        if not imp: break
    return best
names1=["track","pairh","pstack","v1","v2","rstack","seq","xgb","v4"]
names2=names1+["cat"]
b1=hill(names1); b2=hill(names2)
print("WITHOUT cat",round(b1[0],6),{names1[i]:round(b1[1][i],3) for i in range(len(names1))})
print("WITH cat",round(b2[0],6),{names2[i]:round(b2[1][i],3) for i in range(len(names2))})
# cat added at fixed small weights on b1
for wc in [0.05,0.1,0.15,0.2,0.25]:
    wd={names1[i]:b1[1][i]*(1-wc) for i in range(len(names1))}; wd["cat"]=wc
    print("add cat raw",wc,round(mcc_at(y,sum(wd[k]*S[k] for k in wd)),6))
