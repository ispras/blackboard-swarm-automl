ra=rankdata(m.prob.values)/len(m); rb=rankdata(m.b3.values)/len(m)
ga=m.contact_id.str.split("_",expand=True); gp=ga[0]+"_"+ga[1]; pid=ga[3]
g=[gp,pid]
def sm(v,w=15): return pd.Series(v).groupby(g).transform(lambda x:x.rolling(w,center=True,min_periods=1).mean()).values
for w in [11,15]:
    print("w",w,"blend alone",round(best_at(y,sm(ra,w)),5),"b3 alone",round(best_at(y,sm(rb,w)),5))
    for wx in [0.05,0.1,0.15,0.2,0.3]:
        print("  add b3",wx,round(best_at(y,sm((1-wx)*ra+wx*rb,w)),5),end=";")
    print()
