        p=d.contact_id.str.split("_",expand=True); base["gp"]=p[0]+"_"+p[1]; base["step"]=p[2].astype(int); base["p1"]=p[3]; base["p2"]=p[4]
    else: base=base.merge(d[["contact_id"]],on="contact_id",how="inner")
    s[k]=d.set_index("contact_id")[c]
base=base.sort_values(["gp","p1","p2","step"]).reset_index(drop=True)
y=base.contact_id.map(pd.Series(y,index=pd.read_parquet(files["track"][0]).contact_id.values)).values
R={k:rankdata(s[k].reindex(base.contact_id).values)/len(base) for k in files}
g=[base.gp,base.p1,base.p2]
def sm(v,w=3): return pd.Series(v).groupby(g).transform(lambda x:x.rolling(w,center=True,min_periods=1).mean()).values
print("v4 single",mcc_at(y,sm(R["v4"]),0.012),"v2",mcc_at(y,sm(R["v2"]),0.012))
