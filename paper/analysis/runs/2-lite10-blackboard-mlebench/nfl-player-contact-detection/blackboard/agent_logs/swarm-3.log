    negk=rng.choice(neg,int(len(neg)*0.35),replace=False); idx=np.concatenate([pos,negk]); rng.shuffle(idx)
    m=CatBoostClassifier(iterations=700,depth=7,learning_rate=0.08,l2_leaf_reg=3.0,rsm=0.7,
                         bootstrap_type="Bernoulli",subsample=0.8,thread_count=4,verbose=0,
