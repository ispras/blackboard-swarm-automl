import pandas as pd, numpy as np
from scipy.stats import rankdata
W="workspaces"
def best(y,p):
    y=np.asarray(y,np.float64); p=np.asarray(p,np.float64)
    o=np.argsort(p); ys=y[o]; ps=p[o]; n=len(y); P=y.sum(); N=n-P
    tp=np.cumsum(ys[::-1])[::-1]; fp=(n-np.arange(n))-tp; fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); mcc=np.where(den>0,(tp*tn-fp*fn)/np.where(den>0,den,1),0)
    i=int(np.argmax(mcc)); return float(ps[i]),float(mcc[i])
files={"gstack":(f"{W}/achernar_sigma/oof_ground_gstack.parquet","pred"),
"gfus":(f"{W}/achernar_sigma/oof_ground_gfus.parquet","pred"),
"v2":(f"{W}/achernar_sigma/oof_ground_lgbv2.parquet","pred"),
"cvid":(f"{W}/castor_alpha/ground_oof_video.parquet","pred"),
"rstack":(f"{W}/rigel_delta/ground_oof_stack_r.parquet","prob"),
"rig":(f"{W}/rigel_delta/oof_ground.parquet","prob")}
base=None
for k,(f,c) in files.items():
    d=pd.read_parquet(f); print(k,d.columns.tolist())
    yy=d["y"].values if "y" in d else d["contact"].values
    if base is None: base=d[["contact_id"]].copy(); base["y"]=yy
    else: base=base.merge(d[["contact_id"]],on="contact_id",how="inner")
    dd=d.set_index("contact_id"); base[k]=base.contact_id.map(dd[c]).values
parts=base.contact_id.str.split("_",expand=True); base["game_play"]=parts[0]+"_"+parts[1]; base["step"]=parts[2].astype(int); base["p1"]=parts[3]
base=base.sort_values(["game_play","p1","step"]).reset_index(drop=True)
y=base.y.values;n=len(base)
R={k:rankdata(base[k].values)/n for k in files}
g=[base.game_play,base.p1]
def sm(v,w): return pd.Series(v).groupby(g).transform(lambda x:x.rolling(w,center=True,min_periods=1).mean()).values
for k in files: print("single",k,[(w,round(best(y,sm(R[k],w))[1],4)) for w in [7,9,11,15]])
cands={"rstack+gstack .6/.4":{"rstack":.6,"gstack":.4},"rstack+gstack .5/.5":{"rstack":.5,"gstack":.5},
"rstack+gstack+cvid":{"rstack":.5,"gstack":.3,"cvid":.2},
"rstack+gstack+gfus":{"rstack":.5,"gstack":.3,"gfus":.2},
"rstack+gstack+cvid+gfus":{"rstack":.45,"gstack":.3,"cvid":.15,"gfus":.1},
"rstack+cvid+gfus":{"rstack":.55,"cvid":.25,"gfus":.2}}
for name,wd in cands.items():
    p=sum(wd[k]*R[k] for k in wd)
    print(name,[(w,round(best(y,sm(p,w))[1],4)) for w in [7,9,11,15]])
