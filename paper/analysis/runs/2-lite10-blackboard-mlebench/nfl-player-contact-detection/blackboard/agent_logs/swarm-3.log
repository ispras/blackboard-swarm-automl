import pandas as pd, numpy as np
W="workspaces"
def mcc(y,pred):
    tp=np.sum(pred&(y==1));fp=np.sum(pred&(y==0));fn=np.sum((~pred)&(y==1));tn=np.sum((~pred)&(y==0))
    den=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn));return (tp*tn-fp*fn)/den if den>0 else 0
for name,path,col,rate in [("pair",f"{W}/castor_alpha/pair_oof_ens_eff.parquet","pred",0.012),("ground",f"{W}/castor_alpha/ground_oof_ens_eff.parquet","pred",0.045)]:
    d=pd.read_parquet(path)[["contact_id","y",col]].rename(columns={col:"p"})
    p=d.contact_id.str.split("_",expand=True); d["gp"]=p[0]+"_"+p[1]
    y=d.y.values
    th=d.p.quantile(1-rate); pred=(d.p>=th).values
    print(name,"GLOBAL rate",rate,"mcc",round(mcc(y,pred),5),"pos",int(pred.sum()))
    # per-play rate matching: each play gets same rate -> threshold per gp as quantile
    d["pred_pp"]=d.groupby("gp")["p"].transform(lambda x:(x>=x.quantile(1-rate)).astype(int))
    print(name,"PERPLAY rate",rate,"mcc",round(mcc(y,d.pred_pp.values.astype(bool)),5),"pos",int(d.pred_pp.sum()))
    # scale threshold by play mean score
    gm=d.p.mean(); ming=d.groupby("gp")["p"].transform("mean")
    for a in [0.25,0.5,0.75,1.0]:
        thj=th*( (ming/gm)**a )
        pred2=(d.p.values>=thj.values)
        print(name,f"scale a={a} mcc",round(mcc(y,pred2),5),"pos",int(pred2.sum()),"rate",round(pred2.mean(),4))
EOF'
