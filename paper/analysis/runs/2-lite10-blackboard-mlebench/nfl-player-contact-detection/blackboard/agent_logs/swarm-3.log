import pandas as pd, numpy as np
W="workspaces"
def mcc(y,pred):
    tp=np.sum(pred&(y==1));fp=np.sum(pred&(y==0));fn=np.sum((~pred)&(y==1));tn=np.sum((~pred)&(y==0))
    den=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); return (tp*tn-fp*fn)/den if den>0 else 0.0
def boot(path,rates,reps=200,seed=1):
    d=pd.read_parquet(path); ycol="contact" if "contact" in d.columns else "y"; pcol=[c for c in ["prob","pred","p"] if c in d.columns][0]
    d=d.copy(); d["gp"]=d.contact_id.str.split("_").str[:2].str.join("_")
    rng=np.random.RandomState(seed); plays=d.gp.unique(); res={r:[] for r in rates}
    idx_by={p:np.where(d.gp.values==p)[0] for p in plays}
    for _ in range(reps):
        samp=rng.choice(plays,size=len(plays),replace=True)
        idx=np.concatenate([idx_by[p] for p in samp])
        yy=d[ycol].values[idx].astype(float); pp=d[pcol].values[idx].astype(float)
        for r in rates:
            th=np.quantile(pp,1-r); res[r].append(mcc(yy,pp>=th))
    for r in rates:
        a=np.array(res[r]); print(f"  rate {r:.3f}: mean {a.mean():.5f} std {a.std():.5f} p5 {np.quantile(a,.05):.5f}")
    return res
print("GROUND blend",path if False else "")
rg=boot(f"{W}/rigel_delta/ground_oof_best.parquet",[0.045,0.047,0.048,0.049],200)
print("win 4.8>4.5:",np.mean(np.array(rg[0.048])>np.array(rg[0.045])))
print("PAIR ens (castor eff)")
rp=boot(f"{W}/castor_alpha/pair_oof_ens_eff.parquet",[0.011,0.0115,0.012,0.0123,0.0125],100)
print("win 1.20>1.15:",np.mean(np.array(rp[0.012])>np.array(rp[0.0115])),"win 1.233>1.20:",np.mean(np.array(rp[0.0123])>np.array(rp[0.012])))
