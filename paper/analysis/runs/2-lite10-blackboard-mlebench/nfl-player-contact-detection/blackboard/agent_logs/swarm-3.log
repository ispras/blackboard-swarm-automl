import pandas as pd, numpy as np
from scipy.stats import rankdata
W="workspaces"
def best(y,p):
    y=np.asarray(y,np.float64); p=np.asarray(p,np.float64)
    o=np.argsort(p); ys=y[o]; ps=p[o]; n=len(y); P=y.sum(); N=n-P
    tp=np.cumsum(ys[::-1])[::-1]; fp=(n-np.arange(n))-tp; fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); mcc=np.where(den>0,(tp*tn-fp*fn)/np.where(den>0,den,1),0)
    i=int(np.argmax(mcc)); return float(ps[i]),float(mcc[i])
def load(path,col):
    d=pd.read_parquet(path); y=d["y"].values if "y" in d else d["contact"].values
    return d[["contact_id",col]].rename(columns={col:"p"}), y
files={
"v1":(f"{W}/achernar_sigma/oof_ground_lgbv1.parquet","pred"),
"gfus":(f"{W}/achernar_sigma/oof_ground_gfus.parquet","pred"),
"cvideo":(f"{W}/castor_alpha/ground_oof_video.parquet","pred"),
"ctab":(f"{W}/castor_alpha/ground_oof_tab.parquet","oof"),
"cstack2":(f"{W}/castor_alpha/ground_oof_stack2.parquet","pred"),
"rigel":(f"{W}/rigel_delta/oof_ground.parquet","prob"),
}
base=None; P={}; folds=None
for k,(f,col) in files.items():
    d,y=load(f,col)
    if base is None:
        base=d[["contact_id"]].copy(); base["y"]=y
        fd=pd.read_parquet(f); folds=fd["fold"].values if "fold" in fd else None
    else:
        base=base.merge(d[["contact_id"]],on="contact_id",how="inner")
    dd=d.set_index("contact_id")
    base[k]=base.contact_id.map(dd["p"]).values
parts=base.contact_id.str.split("_",expand=True); base["game_play"]=parts[0]+"_"+parts[1]; base["step"]=parts[2].astype(int); base["p1"]=parts[3]
base=base.sort_values(["game_play","p1","step"]).reset_index(drop=True)
if folds is not None:
    fmap=pd.Series(folds,index=pd.read_parquet(files["v1"][0]).contact_id.values)
    base["fold"]=base.contact_id.map(fmap).values
y=base.y.values; n=len(base)
ranks={k:rankdata(base[k].values)/n for k in files}
print("singles raw / rank / per-fold-rank:")
for k in files:
    print(k, "raw",round(best(y,base[k].values)[1],4),"rank",round(best(y,ranks[k])[1],4))
# smoothing helper
g=[base.game_play,base.p1]
def sm(v,w=9): return pd.Series(v).groupby(g).transform(lambda x:x.rolling(w,center=True,min_periods=1).mean()).values
# hill-climb weights on ranks, objective best smoothed MCC
names=list(files.keys())
w=np.array([0.1,0.4,0.4,0.0,0.05,0.05])
w=w/w.sum()
def score(w):
    p=sum(w[i]*ranks[k] for i,k in enumerate(names))
    return best(y,sm(p))[1]
bestw=(score(w),w.copy())
for it in range(120):
    improved=False
    for i in range(len(names)):
        for d in [0.05,-0.05,0.02,-0.02]:
            w2=w.copy(); w2[i]=max(0,w2[i]+d); w2=w2/w2.sum()
            s=score(w2)
            if s>bestw[0]+1e-6:
                bestw=(s,w2); w=w2; improved=True
    if not improved: break
print("hill best",bestw[0],{names[i]:round(bestw[1][i],3) for i in range(len(names))})
# selected manual blends
cands={"cvideo_only":{ "cvideo":1},"gfus_only":{"gfus":1},"gfus+cvideo .4/.6":{"gfus":0.4,"cvideo":0.6},
"gfus+cvideo .5/.5":{"gfus":0.5,"cvideo":0.5},"gfus+cvideo .3/.7":{"gfus":0.3,"cvideo":0.7},
"gfus+v1+cvideo":{ "gfus":0.25,"v1":0.1,"cvideo":0.65}}
for name,wd in cands.items():
    p=sum(wd.get(k,0)*ranks[k] for k in names)
    for wdw in [7,9,11,13]:
        print(name,"w",wdw,best(y,sm(p,wdw)))
EOF'
