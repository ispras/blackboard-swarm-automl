import pandas as pd, numpy as np
from scipy.stats import rankdata
def best(y,p):
    y=np.asarray(y,np.float64); p=np.asarray(p,np.float64)
    o=np.argsort(p); ys=y[o]; ps=p[o]; n=len(y); P=y.sum(); N=n-P
    tp=np.cumsum(ys[::-1])[::-1]; fp=(n-np.arange(n))-tp; fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)); mcc=np.where(den>0,(tp*tn-fp*fn)/np.where(den>0,den,1),0)
    i=int(np.argmax(mcc)); return float(ps[i]),float(mcc[i])
o=pd.read_parquet("workspaces/achernar_sigma/oof_pair_lgbv1.parquet")[["contact_id","y","pred"]]
r=pd.read_parquet("workspaces/rigel_delta/oof_pair.parquet")[["contact_id","prob"]]
m=o.merge(r,on="contact_id")
parts=m.contact_id.str.split("_",expand=True); m["game_play"]=parts[0]+"_"+parts[1]; m["step"]=parts[2].astype(int); m["p1"]=parts[3]; m["p2"]=parts[4]
m=m.sort_values(["game_play","p1","p2","step"]).reset_index(drop=True)
y=m.y.values; n=len(m)
ra=rankdata(m.pred)/n; rr=rankdata(m.prob)/n
g=[m.game_play,m.p1,m.p2]
for name,p in [("ours",m.pred.values),("rigel",m.prob.values),("rank_avg",(ra+rr)/2),("raw_avg",(m.pred.values+m.prob.values)/2),("w.75",0.75*ra+0.25*rr),("w.25",0.25*ra+0.75*rr)]:
    s=pd.Series(p); row=[]
    for w in [1,3,5,9]:
        sm=s.groupby(g).transform(lambda x: x.rolling(w,center=True,min_periods=1).mean()).values
        t,mc=best(y,sm); row.append((w,round(mc,4)))
    print(name,row)
