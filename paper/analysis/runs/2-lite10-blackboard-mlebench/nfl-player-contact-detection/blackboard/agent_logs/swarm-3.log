"seq":(f"{W}/achernar_sigma/oof_pair_seqavg.parquet","prob"),"v4":(f"{W}/achernar_sigma/oof_pair_lgbv4.parquet","pred")}
base=None; y=None; s={}
for k,(f,c) in files.items():
    d=pd.read_parquet(f)
    if base is None:
