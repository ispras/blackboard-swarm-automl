groups={}
for i in va: groups.setdefault(study[i],[]).append(i)
groups={g:np.array(v) for g,v in groups.items()}; gn=sorted(groups)
hv=lambda g:int(hashlib.md5(g.encode()).hexdigest(),16)%2
tune=[g for g in gn if hv(g)==0]; hold=[g for g in gn if hv(g)==1]
gt={}; gtree={}
for g in gn:
    for c in range(3):
        v=np.ascontiguousarray(mask[groups[g],c]>0); gt[(g,c)]=v
        if v.any(): gtree[(g,c)]=cKDTree(np.argwhere(v).astype(np.float32))
Eq=np.load('/download_job_code/payload/sandbox/workspaces/mimosa_sigma/ensemble/oof_eq.npy',mmap_mode='r')
cands={'fpn':'/download_job_code/payload/sandbox/workspaces/dubhe_zeta/handoff/val0_probs_fpn.npy',
       'b4':'/download_job_code/payload/sandbox/workspaces/betelgeuse_zeta/betel_b4f0_valprobs.npy'}
def ev(P,c,cfg,gl):
    thr,c2,c3,kt=cfg; scs=[]
    for g in gl:
        rows=np.searchsorted(va,groups[g])
        b=postproc(P[rows],thr,c2,c3,kt,0)
        sc,d,h=decide(b,gt[(g,c)],gtree.get((g,c))); scs.append(sc)
    return float(np.mean(scs))
for c,cn in enumerate(CLASSES):
    E=np.asarray(Eq[:,c]); r=rec['classes'][cn]; cfg=(r['thr'],r['cc2d'],r['cc3d'],r['keep_top'])
    base_t=ev(E,c,cfg,tune); base_h=ev(E,c,cfg,hold)
