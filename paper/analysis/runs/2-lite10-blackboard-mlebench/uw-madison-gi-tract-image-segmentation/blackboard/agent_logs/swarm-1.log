        Pc = np.asarray(Pc, np.float32)""","""        Pc = np.zeros((len(va), 320, 320), np.float32)
        for k, p in enumerate(probs):
            Pc += w[k] * np.asarray(p[:, c], dtype=np.float32)""")
open(p,'w').write(s)
print('ok')
EOF
