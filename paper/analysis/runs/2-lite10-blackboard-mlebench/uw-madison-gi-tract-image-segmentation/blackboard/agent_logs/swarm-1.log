sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/mimosa_sigma/code')
from tune_postproc import postproc, decide
from scipy.spatial import cKDTree
C='/download_job_code/payload/sandbox/workspaces/mimosa_sigma/cache'
CLASSES=['large_bowel','small_bowel','stomach']
rec=json.load(open('/download_job_code/payload/sandbox/workspaces/mimosa_sigma/logs/recipe_ens_eq.json'))
study=json.load(open(f'{C}/train_study.json')); fold=np.load(f'{C}/train_fold.npy'); va=np.where(fold==0)[0]
