    return float(np.mean(scs))
for c,cn in enumerate(CLASSES):
    P=np.asarray(Pm[:,c]); r=rec['classes'][cn]; base=(r['thr'],r['cc2d'],r['cc3d'],r['keep_top'])
    cfgs=[('base',base)]
    th,c2,c3,kt=base
    for d in [-0.05,0.05]:
        cfgs.append((f'thr{th+d:+.2f}',(round(th+d,2),c2,c3,kt)))
    cfgs.append(('cc3d0',(th,c2,0,kt)))
    cfgs.append((f'cc3d{c3*2}',(th,c2,c3*2,kt)))
    cfgs.append((f'cc3d{max(1,c3//2)}',(th,c2,max(1,c3//2),kt)))
    cfgs.append(('keep1',(th,c2,c3,1)))
    if c2==0: cfgs.append(('cc2d100',(th,100,c3,kt)))
    else: cfgs.append(('cc2d200',(th,200,c3,kt)))
    print('==',cn,flush=True)
    res=[]
    for name,cfg in cfgs:
        t=ev(P,c,cfg,tune); h=ev(P,c,cfg,hold); res.append((t,h,name,cfg))
        print(f'  {name:12s} thr={cfg[0]} cc2d={cfg[1]} cc3d={cfg[2]} keep={cfg[3]} tune={t:.4f} hold={h:.4f}',flush=True)
    res.sort(reverse=True); print('  BEST_TUNE',res[0][2],round(res[0][0],4),'hold',round(res[0][1],4),flush=True)
