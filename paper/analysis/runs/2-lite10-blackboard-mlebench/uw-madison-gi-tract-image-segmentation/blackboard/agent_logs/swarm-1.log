[0m$ [0mpyenv shell sis-black && python - <<'EOF'
import pandas as pd, os, glob, re
tr=pd.read_csv('data/train.csv'); te=pd.read_csv('data/test.csv')
print('train rows',len(tr),'unique ids',tr.id.nunique(),'cases',tr.id.str.split('_').str[0].nunique())
tr['case']=tr.id.str.split('_').str[0]; tr['day']=tr.id.str.split('_').str[1]
print('case-day combos',tr[['case','day']].drop_duplicates().shape[0])
print('test rows',len(te),'unique ids',te.id.nunique(),'cases',te.id.str.split('_').str[0].nunique())
print('train cases',sorted(tr.case.unique())[:10],'...')
# overlap cases
trc=set(tr.case); tec=set(te.id.str.split('_').str[0])
print('case overlap',len(trc&tec),'train-only',len(trc-tec),'test-only',len(tec-trc))
# label prevalence
tr['has']=tr.segmentation.notna()
print(tr.groupby('class')['has'].mean())
print('slices w/ any mask', tr.groupby('id')['has'].any().mean())
# image size distribution
files=glob.glob('data/train/*/*/*.png')
print('train png',len(files))
import collections
sizes=collections.Counter(re.search(r'_(\d+)_(\d+)_',os.path.basename(f)).groups() for f in files[:5000])
print(sizes.most_common(5))
files2=glob.glob('data/test/*/*/*.png'); print('test png',len(files2))
print('test day/case example', [os.path.basename(x) for x in files2[:3]])
