            t=ev(P,c,cfg,tune); h=ev(P,c,cfg,hold)
            print(f'  +{nm} w={w:.1f} tune={t:.4f} ({t-base_t:+.4f}) hold={h:.4f} ({h-base_h:+.4f})',flush=True)
        del X
EOF
