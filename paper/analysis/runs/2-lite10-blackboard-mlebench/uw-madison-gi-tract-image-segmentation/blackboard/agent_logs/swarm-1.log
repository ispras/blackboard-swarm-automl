import pandas as pd, numpy as np, json
sub=pd.read_csv('workspaces/mimosa_sigma/ensemble/submission.csv',dtype=str,keep_default_na=False)
te=pd.read_csv('data/test.csv',dtype=str)
print('rows',len(sub),'expected',len(te))
m=sub.merge(te,on=['id','class'],how='outer',indicator=True)
print(m._merge.value_counts().to_dict())
# validate RLE
hw_map={}
ids=json.load(open('workspaces/mimosa_sigma/cache/test_ids.json')); hw=np.load('workspaces/mimosa_sigma/cache/test_hw.npy')
for i,x in enumerate(ids): hw_map[x]=(int(hw[i,0]),int(hw[i,1]))
bad=0; areas=[]
for r in sub.itertuples():
    s=r.predicted.strip()
    if not s: continue
    v=np.array(s.split(),dtype=np.int64)
    if len(v)%2: bad+=1; continue
    st=v[0::2]; ln=v[1::2]
    if np.any(st<1) or np.any(ln<1): bad+=1; continue
    if np.any(np.diff(st)<=0): bad+=1; continue
    ends=st+ln-1
    if np.any(st[1:]<=ends[:-1]): bad+=1; continue
    h,w=hw_map[r.id]
    if ends.max()>h*w: bad+=1
    areas.append(ln.sum())
print('bad rows',bad,'nonempty',len(areas))
areas=np.array(areas); print('area min/median/max',areas.min(),np.median(areas),areas.max())
# expected order of ids equals test.csv order
print('id order equal', (sub['id'].values==te['id'].values).all(), (sub['class'].values==te['class'].values).all())
