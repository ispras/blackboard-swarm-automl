import os, sys, argparse, numpy as np, pandas as pd, cv2
sys.path.insert(0,os.path.dirname(__file__))
from simlib import dice2d, hd3d_norm, combo, CLASSES

def postproc_mask(m, min_area=0, close=True):
    m=m.astype(np.uint8)
    if m.sum()==0: return m
    if close: m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,np.ones((3,3),np.uint8))
    if min_area>0:
        n,lab,stats,_=cv2.connectedComponentsWithStats(m,8)
        out=np.zeros_like(m)
        for k in range(1,n):
            if stats[k,cv2.CC_STAT_AREA]>=min_area: out[lab==k]=1
        m=out
    return m

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--probs",required=True)
    ap.add_argument("--thr",default="0.5,0.5,0.5")
    ap.add_argument("--min_area",type=int,default=0)
    ap.add_argument("--full",type=int,default=0)
    ap.add_argument("--limit_cd",type=int,default=0)
    args=ap.parse_args()
    probs=np.load(args.probs).astype(np.float32)
    gt=np.load(args.probs.replace("_probs.npy","_probs_gt.npy")).astype(np.uint8)
    meta=pd.read_csv(args.probs.replace("_probs.npy","_probs_meta.csv"))
    thrs=[float(x) for x in args.thr.split(",")]
    N=len(meta)
    # dice fast
    dpos={c:[] for c in range(3)}; dall={c:[] for c in range(3)}
    preds=np.zeros_like(gt)
    for i in range(N):
        for c in range(3):
            m=(probs[i,c]>thrs[c]).astype(np.uint8)
            m=postproc_mask(m,args.min_area); preds[i,c]=m
            g=gt[i,c]
            if g.sum()>0: dpos[c].append(dice2d(m,g))
            dall[c].append(dice2d(m,g))
    print("DICE_POS", [float(np.mean(dpos[c])) if dpos[c] else 0.0 for c in range(3)], "mean", float(np.mean([np.mean(dpos[c]) for c in range(3)])))
    print("DICE_ALL", [float(np.mean(dall[c])) for c in range(3)], "mean", float(np.mean([np.mean(dall[c]) for c in range(3)])))
    if args.full:
        cds=sorted(meta.case_day.unique())
        if args.limit_cd: cds=cds[:args.limit_cd]
        res={c:[] for c in range(3)}; dres={c:[] for c in range(3)}
        for cd in cds:
            sel=np.where(meta.case_day.values==cd)[0]
            sel=sel[np.argsort(meta.idx.values[sel])]
            for c in range(3):
                p3=preds[sel,c]; g3=gt[sel,c]
                d=float(np.mean([dice2d(p3[k],g3[k]) for k in range(len(sel))]))
                hd=hd3d_norm(p3,g3,(p3.shape[1],p3.shape[2]))
                res[c].append(combo(d,hd)); dres[c].append(d)
        print("COMBO", [float(np.mean(res[c])) for c in range(3)], "mean", float(np.mean([np.mean(res[c]) for c in range(3)])), "ncd",len(cds))
        best=[max(res[c]) for c in range(3)]; print("COMBO_bestcd", [float(x) for x in best])
if __name__=="__main__": main()
PY
