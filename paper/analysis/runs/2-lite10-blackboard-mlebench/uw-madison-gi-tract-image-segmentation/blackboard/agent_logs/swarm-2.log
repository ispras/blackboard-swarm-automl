import numpy as np, pandas as pd, sys
sys.path.insert(0,"workspaces/dubhe_zeta")
from common import rle_decode
sub=pd.read_csv("final_solution/submission.csv", keep_default_na=False)
test=pd.read_csv("data/test.csv")
files=pd.read_parquet("workspaces/dubhe_zeta/test_files.parquet").set_index("id")
# 1) exact id/class correspondence
assert list(sub.columns)==["id","class","predicted"]
assert len(sub)==len(test)==20400
assert (sub.id.values==test.id.values).all() and (sub.class.values==test.class.values).all()
assert set(sub["class"].unique())=={"large_bowel","small_bowel","stomach"}
assert sub.id.nunique()==6800 and sub.groupby("id").size().eq(3).all()
# 2) full structural + decode check over ALL rows
bad=0; decoded=0; per_class={c:[] for c in sub["class"].unique()}; per_shape={}
for _,r in sub.iterrows():
    sid=r["id"]; cls=r["class"]; s=str(r["predicted"]).strip()
    h,w=int(files.loc[sid,"h"]),int(files.loc[sid,"w"]); N=h*w
    if s=="":
        per_class[cls].append(0); per_shape.setdefault((h,w),[]).append(0); continue
    a=np.array(s.split(),dtype=np.int64)
    if len(a)==0 or len(a)%2: bad+=1; continue
    st=a[0::2]; ln=a[1::2]
    if (st<1).any() or (ln<1).any() or (np.diff(st)<=0).any(): bad+=1; continue
    end=st+ln-1
    if (end>N).any(): bad+=1; continue
    if len(st)>1 and (st[1:]<=end[:-1]).any(): bad+=1; continue
    m=rle_decode(s,(h,w))
    if m.shape!=(h,w) or int(m.sum())==0: bad+=1; continue
    decoded+=1; per_class[cls].append(int(m.sum())); per_shape.setdefault((h,w),[]).append(float(m.mean()))
print("rows",len(sub),"decoded nonempty",decoded,"bad",bad)
for c,v in per_class.items():
    v=np.array(v); print(f"  {c}: mean_px={v.mean():.1f} max_px={v.max()} nonempty_frac={np.mean(v>0):.3f}")
for k,v in per_shape.items():
    v=np.array(v); print(f"  shape {k}: n={len(v)} mean_area_frac={v.mean():.4f} max={v.max():.4f}")
print("FULL VERIFY", "OK" if bad==0 else "FAIL")
PY
