def dice_loss(logits, target):
    p = torch.sigmoid(logits)
    num = 2 * (p * target).sum(dim=(2, 3)) + 1.0
    den = p.sum(dim=(2, 3)) + target.sum(dim=(2, 3)) + 1.0
    return (1 - num / den).mean()

@torch.no_grad()
def validate(model, loader, dev):
    model.eval()
    inter = np.zeros(3); den = np.zeros(3)
    all_probs = []
    all_ids = []
    for x, y, ids in loader:
        x = x.to(dev, non_blocking=True)
        with torch.cuda.amp.autocast():
            logits = model(x)
        p = torch.sigmoid(logits).float().cpu().numpy()
        yy = y.numpy()
        pred = (p > 0.5).astype(np.float32)
        inter += (pred * yy).sum(axis=(0, 2, 3))
        den += pred.sum(axis=(0, 2, 3)) + yy.sum(axis=(0, 2, 3))
        all_probs.append(p.astype(np.float16))
        all_ids.append(ids.numpy())
    dice = 2 * inter / np.maximum(den, 1)
    return dice, np.concatenate(all_probs), np.concatenate(all_ids)

