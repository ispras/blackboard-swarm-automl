import os, sys, argparse, json, time, numpy as np, pandas as pd, torch, cv2
from torch.utils.data import Dataset, DataLoader
sys.path.insert(0,os.path.dirname(__file__))
from common import *

def add_neighbors(df):
    df=df.sort_values(["case_day","idx"]).reset_index(drop=True)
    prev=np.arange(len(df)); nxt=np.arange(len(df))
    for cd,g in df.groupby("case_day",sort=False):
        idx=g.index.values; prev[idx[1:]]=idx[:-1]; nxt[idx[:-1]]=idx[1:]
    df["prev"]=prev; df["nxt"]=nxt
    return df

def build_test_df():
    files=pd.read_parquet(f"{WS}/test_files.parquet")
    return add_neighbors(files)

class InferDataset(Dataset):
    def __init__(self, df, size=320, twofive=True, nclass=3, mask_df=None):
        self.df=df.reset_index(drop=True); self.size=size; self.twofive=twofive; self.nclass=nclass
        self.mask_df=mask_df
    def __len__(self): return len(self.df)
    def _load(self,row):
        img=cv2.imread(row.path, cv2.IMREAD_UNCHANGED)
        return norm_img(img)
    def __getitem__(self,i):
        row=self.df.iloc[i]; chans=[]
        if self.twofive:
            for j in (int(row.prev), i, int(row.nxt)):
                rr=self.df.iloc[j] if (j!=i and j>=0) else row
                im=self._load(rr)
                if im.shape[:2]!=(self.size,self.size): im=cv2.resize(im,(self.size,self.size))
                chans.append(im)
        else:
            im=self._load(row)
            if im.shape[:2]!=(self.size,self.size): im=cv2.resize(im,(self.size,self.size))
            chans=[im]
        img=np.stack(chans,-1).astype(np.float32)/255.0
        if img.shape[2]==1: img=np.repeat(img,3,axis=2)
        img=(img-IMAGENET_MEAN)/IMAGENET_STD
        img=np.transpose(img,(2,0,1)).astype(np.float32)
        out={"img":torch.from_numpy(img),"idx":i}
        if self.mask_df is not None:
            mrow=self.mask_df.iloc[i]
            masks=[]
            for c in CLASSES:
                m=rle_decode(mrow.get(c,None),(int(row.h),int(row.w)))
                if m.shape[0]!=self.size or m.shape[1]!=self.size:
                    m=cv2.resize(m,(self.size,self.size),interpolation=cv2.INTER_NEAREST)
                masks.append(m)
            out["mask"]=torch.from_numpy(np.stack(masks).astype(np.float32))
        return out

def tta_predict(model, x):
    outs=[]
    # identity
    outs.append(torch.sigmoid(model(x)))
    # hflip
    outs.append(torch.flip(torch.sigmoid(model(torch.flip(x,[3]))),[3]))
    # vflip
    outs.append(torch.flip(torch.sigmoid(model(torch.flip(x,[2]))),[2]))
    # rot180
    outs.append(torch.flip(torch.sigmoid(model(torch.flip(x,[2,3]))),[2,3]))
    return torch.stack(outs,0).mean(0)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--ckpt",required=True)
    ap.add_argument("--split",default="test")
    ap.add_argument("--fold",type=int,default=0)
    ap.add_argument("--tta",type=int,default=1)
    ap.add_argument("--out",default="")
    ap.add_argument("--batch",type=int,default=32)
    ap.add_argument("--workers",type=int,default=4)
    args=ap.parse_args()
    ck=torch.load(args.ckpt,map_location="cpu")
    a=ck["args"]; size=a["size"]
    import segmentation_models_pytorch as smp
    model=getattr(smp,a["arch"])(encoder_name=a["encoder"],encoder_weights=None,
            in_channels=3 if a["twofive"] else 1,classes=3)
    model.load_state_dict(ck["state"]); model=model.cuda().eval()
    if args.split=="test":
        files=build_test_df(); mask_df=None; ids=files.id.values
    else:
        from train import get_folds
        full=build_slice_df(); fold_arr=get_folds(full)
        vadf=full[fold_arr==args.fold].reset_index(drop=True)
        # need neighbors within full case_day sequence; use full df neighbors then subset
        g2l={int(g):l for l,g in enumerate(full.reset_index(drop=True).index)}
        files=add_neighbors(vadf)[["id","path","case","case_day","idx","h","w"]].copy()
        # rebuild prev/nxt using full adjacency remapped to val positions
        full2=full.reset_index(drop=True)
        pos={rid:i for i,rid in enumerate(files.id.values)}
        def mapnb(g,cur):
            rid=full2.loc[int(g),"id"] if int(g)>=0 else None
            return pos.get(rid,cur)
        files["prev"]=[mapnb(g,i) for i,(g) in enumerate(full2.loc[vadf.index,"prev"].values)] if False else list(range(len(files)))
        # simpler: neighbors from full df
        prevs=[]; nxts=[]
        full_prev=full2["prev"].values; full_nxt=full2["nxt"].values
        val_global_index=vadf.index.values
        # map global df index -> val position
        gpos={int(g):i for i,g in enumerate(val_global_index)}
        for i,g in enumerate(val_global_index):
            prevs.append(gpos.get(int(full_prev[g]), i)); nxts.append(gpos.get(int(full_nxt[g]), i))
        files["prev"]=prevs; files["nxt"]=nxts
        # attach mask columns from full
        mask_df=full2.iloc[val_global_index][["id"]+CLASSES].reset_index(drop=True)
        files=files.reset_index(drop=True); ids=files.id.values
    ds=InferDataset(files,size=size,twofive=bool(a["twofive"]),mask_df=mask_df)
    dl=DataLoader(ds,batch_size=args.batch,num_workers=args.workers,pin_memory=True)
    N=len(ds); probs=np.zeros((N,3,size,size),dtype=np.float16)
    t0=time.time(); done=0
    masks=None
    if mask_df is not None: masks=np.zeros((N,3,size,size),dtype=np.uint8)
    with torch.no_grad():
        for b in dl:
            x=b["img"].cuda(non_blocking=True)
            with torch.cuda.amp.autocast():
                if args.tta: p=tta_predict(model,x)
                else: p=torch.sigmoid(model(x))
            p=p.float().cpu().numpy().astype(np.float16)
            idxs=b["idx"].numpy(); probs[idxs]=p; done+=len(idxs)
            if "mask" in b:
                masks[idxs]=b["mask"].numpy().astype(np.uint8)
            if done % (args.batch*10) < args.batch:
                print(f"{done}/{N} {time.time()-t0:.1f}s",flush=True)
    out=args.out or os.path.join(os.path.dirname(args.ckpt),f"{args.split}_probs.npy")
    np.save(out,probs); np.save(out.replace(".npy","_ids.npy"),np.array(ids))
    if masks is not None: np.save(out.replace(".npy","_gt.npy"),masks)
    print("saved",out,probs.shape,flush=True)

if __name__=="__main__":
    main()
