[0m$ [0mcd /download_job_code/payload/sandbox && cat > workspaces/dubhe_zeta/analyze.py <<'PY'
import pandas as pd, numpy as np, glob, os, re
from collections import Counter

def rle_decode(rle, shape):
    h,w=shape
    if not isinstance(rle,str) or rle.strip()=="":
        return np.zeros((h,w),dtype=np.uint8)
    s=np.array(rle.split(),dtype=int)
    starts=s[0::2]-1; lengths=s[1::2]
    out=np.zeros(h*w,dtype=np.uint8)
    for st,ln in zip(starts,lengths):
        out[st:st+ln]=1
    return out.reshape((h,w),order='F')

tr=pd.read_csv("data/train.csv")
tr["shape"]=tr["id"].map(lambda x: tuple(map(int, re.search(r"slice_\d+_(\d+)_(\d+)_",x).groups())))
print("shapes train:", Counter(tr["shape"]))
te=pd.read_csv("data/test.csv")
te["shape"]=te["id"].map(lambda x: tuple(map(int, re.search(r"slice_\d+_(\d+)_(\d+)_",x).groups())))
print("shapes test:", Counter(te["shape"]))
# mask area stats
sub=tr[tr.segmentation.notna()].copy()
areas=[]; 
for _,r in sub.iterrows():
    s=np.array(r.segmentation.split(),dtype=int)
    areas.append(s[1::2].sum())
sub["area"]=areas
print(sub.groupby("class")["area"].describe())
