import os, sys, argparse, numpy as np, pandas as pd, cv2
sys.path.insert(0,os.path.dirname(__file__))
from simlib import dice2d, hd3d_norm, combo, CLASSES

def postproc_mask(m, min_area=0, close=True):
    m=m.astype(np.uint8)
    if m.sum()==0: return m
    if close: m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,np.ones((3,3),np.uint8))
    if min_area>0:
        n,lab,stats,_=cv2.connectedComponentsWithStats(m,8)
        out=np.zeros_like(m)
        for k in range(1,n):
            if stats[k,cv2.CC_STAT_AREA]>=min_area: out[lab==k]=1
        m=out
    return m

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--probs",required=True)
    ap.add_argument("--thr",default="0.5,0.5,0.5")
    ap.add_argument("--min_area",type=int,default=0)
    ap.add_argument("--full",type=int,default=0)
    ap.add_argument("--limit_cd",type=int,default=0)
    ap.add_argument("--gt",default=""); ap.add_argument("--meta",default="")
    ap.add_argument("--weighted",type=int,default=1)
    args=ap.parse_args()
    probs=np.load(args.probs, mmap_mode="r")
    gtpath=args.gt or args.probs.replace(".npy","_gt.npy")
    metapath=args.meta or args.probs.replace(".npy","_meta.csv")
    gt=np.load(gtpath, mmap_mode="r")
    meta=pd.read_csv(metapath); N=len(meta)
    thrs=[float(x) for x in args.thr.split(",")]
    dpos={c:[] for c in range(3)}; dall={c:[] for c in range(3)}
    for i in range(N):
        for c in range(3):
            m=postproc_mask((np.asarray(probs[i,c])>thrs[c]),args.min_area)
            g=np.asarray(gt[i,c])
            d=dice2d(m,g); dall[c].append(d)
            if g.sum()>0: dpos[c].append(d)
    dp=[float(np.mean(dpos[c])) if dpos[c] else 0.0 for c in range(3)]
    da=[float(np.mean(dall[c])) for c in range(3)]
    print("DICE_POS",dp,"mean",float(np.mean(dp)))
    print("DICE_ALL",da,"mean",float(np.mean(da)))
    if args.full:
        cds=sorted(meta.case_day.unique())
        if args.limit_cd: cds=cds[:args.limit_cd]
        res={c:[] for c in range(3)}; comp={c:[] for c in range(3)}; hres={c:[] for c in range(3)}
        for cd in cds:
            sel=np.where(meta.case_day.values==cd)[0]
            sel=sel[np.argsort(meta.idx.values[sel])]
            for c in range(3):
                p3=np.stack([postproc_mask(np.asarray(probs[j,c])>thrs[c],args.min_area) for j in sel])
                g3=np.stack([np.asarray(gt[j,c]) for j in sel])
                d=float(np.mean([dice2d(p3[k],g3[k]) for k in range(len(sel))]))
                hd=hd3d_norm(p3,g3,(p3.shape[1],p3.shape[2]))
                comp[c].append(combo(d,hd)); hres[c].append(hd); res[c].append(d)
        print("COMBO",[float(np.mean(comp[c])) for c in range(3)],"mean",float(np.mean([np.mean(comp[c]) for c in range(3)])),"ncd",len(cds))
        print("HD",[float(np.mean(hres[c])) for c in range(3)],"DICE3d",[float(np.mean(res[c])) for c in range(3)])
if __name__=="__main__": main()
PY
