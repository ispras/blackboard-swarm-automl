#!/bin/bash
set -x
cd /download_job_code/payload/sandbox
export PATH="/root/.pyenv/shims:$PATH"; export OMP_NUM_THREADS=4
PY="python"
WS="workspaces/dubhe_zeta"
echo "WAIT for fold0 training to finish"
while pgrep -f '[b]3u_f0' >/dev/null 2>&1; do sleep 20; done
echo "TRAINING DONE $(date)"
sleep 5
cp $WS/runs/b3u_f0/last.pt $WS/runs/b3u_f0/snaps/final_fold0.pt
echo "=== VAL TTA inference (fold0) ==="
$PY $WS/infer.py --ckpt $WS/runs/b3u_f0/snaps/final_fold0.pt --split val --fold 0 --tta 1 --batch 32 --workers 3 --outsize 320 \
  --order_ids $WS/fold0_ids_mimosa.json --out $WS/handoff/val0_probs_final.npy
echo "=== TEST TTA inference (fold0) ==="
$PY $WS/infer.py --ckpt $WS/runs/b3u_f0/snaps/final_fold0.pt --split test --tta 1 --batch 32 --workers 3 --outsize 320 \
  --order_ids workspaces/mimosa_sigma/cache/test_ids.json --out $WS/handoff/test_probs_f0.npy
echo "=== OOF eval (fold0) ==="
$PY workspaces/mimosa_sigma/code/eval_model.py --probs $WS/handoff/val0_probs_final.npy --fold 0 --tag dubhe_f0_final \
  --thrs 0.60,0.70,0.75,0.80,0.85,0.90 --ccs 0,100,200,400 --out $WS/handoff/eval_dubhe_f0_final.json
echo "=== ALL-DATA fine-tune ==="
$PY $WS/train.py --all_data 1 --init_ckpt $WS/runs/b3u_f0/snaps/final_fold0.pt --fold 0 --epochs 5 --lr 1e-4 --warmup_epochs 0.2 \
  --size 384 --batch 24 --workers 4 --encoder efficientnet-b3 --arch Unet --name b3u_all > $WS/runs/b3u_all.log 2>&1
echo "=== TEST TTA inference (all-data) ==="
$PY $WS/infer.py --ckpt $WS/runs/b3u_all/last.pt --split test --tta 1 --batch 32 --workers 3 --outsize 320 \
  --order_ids workspaces/mimosa_sigma/cache/test_ids.json --out $WS/handoff/test_probs_all.npy
echo "ALL DONE $(date)"
SH
chmod +x workspaces/dubhe_zeta/post_train.sh
nohup setsid systemd-run --user --scope --collect -q -p MemoryHigh=6G -p MemoryMax=8G -p MemorySwapMax=0 bash workspaces/dubhe_zeta/post_train.sh > workspaces/dubhe_zeta/handoff/post_train.log 2>&1 < /dev/null & sleep 6; echo launched; tail -3 workspaces/dubhe_zeta/handoff/post_train.log; date
