    imgs=np.load(imgs_path,mmap_mode='r')
    idx=index.reset_index(drop=True); N=len(idx)
    S=imgs.shape[1]
    out=np.lib.format.open_memmap(os.path.join(ROOT,f'preds_{os.path.basename(os.path.dirname(ckpt))}.npy'),mode='w+',dtype=np.float16,shape=(N,3,S,S)) if False else np.zeros((N,3,S,S),np.float16)
    t0=time.time()
