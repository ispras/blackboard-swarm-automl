import os, sys, json, time, argparse
import numpy as np, pandas as pd
import cv2
from scipy import ndimage
sys.path.insert(0, '/download_job_code/payload/sandbox/workspaces/mimosa_sigma/code')
import simlib

ROOT = '/download_job_code/payload/sandbox'
C = f'{ROOT}/workspaces/mimosa_sigma/cache'
CLASSES = simlib.CLASSES
cv2.setNumThreads(4)


def postprocess(bin3d, cc_min):
    if cc_min <= 1:
        return bin3d
    st = np.ones((3, 3, 3), dtype=bool)
    lab, n = ndimage.label(bin3d, structure=st)
    if n == 0:
        return bin3d
    sizes = np.bincount(lab.ravel())
    keep = sizes >= cc_min; keep[0] = False
    return keep[lab]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--probs', nargs='+', required=True)
    ap.add_argument('--weights', nargs='+', type=float, default=None)
    ap.add_argument('--thr', default='0.45,0.45,0.45')
    ap.add_argument('--cc', default='100,100,100')
    ap.add_argument('--out', default=f'{ROOT}/final_solution/submission.csv')
    ap.add_argument('--save-probs', default='')
    args = ap.parse_args()
    t0 = time.time()
    ids = json.load(open(f'{C}/test_ids.json'))
    study = json.load(open(f'{C}/test_study.json'))
    hw = np.load(f'{C}/test_hw.npy')
    n = len(ids)
    ws = args.weights or [1.0] * len(args.probs)
    ws = np.array(ws, dtype=np.float32); ws /= ws.sum()
    blend = np.zeros((n, 3, 320, 320), dtype=np.float32)
    for k, (p, w) in enumerate(zip(args.probs, ws)):
        a = np.load(p, mmap_mode='r')
        assert len(a) == n, (p, len(a), n)
        s = a.shape[-1]
        for i in range(n):
            for c in range(3):
                v = np.asarray(a[i, c], dtype=np.float32)
                if s != 320:
                    v = cv2.resize(v, (320, 320), interpolation=cv2.INTER_LINEAR)
                blend[i, c] += w * v
        print('loaded', p, f'{time.time()-t0:.0f}s', flush=True)
    if args.save_probs:
        np.save(args.save_probs, blend.astype(np.float16))
    thrs = [float(x) for x in args.thr.split(',')]
    ccs = [int(x) for x in args.cc.split(',')]
    groups = {}
    for i, g in enumerate(study):
        groups.setdefault(g, []).append(i)
    rows = []
    for g, idxs in groups.items():
        idxs = np.array(idxs)
        for c in range(3):
            vol = blend[idxs, c] >= thrs[c]
            if vol.any():
                vol = postprocess(vol, ccs[c])
            for z, i in enumerate(idxs):
                m = cv2.resize(vol[z].astype(np.uint8), (int(hw[i, 1]), int(hw[i, 0])),
                               interpolation=cv2.INTER_NEAREST)
                rows.append((ids[i], CLASSES[c], simlib.rle_encode(m)))
    df = pd.DataFrame(rows, columns=['id', 'class', 'predicted'])
    sub = pd.read_csv(f'{ROOT}/data/test.csv')
    out = sub[['id', 'class']].merge(df, on=['id', 'class'], how='left')
    out['predicted'] = out['predicted'].fillna('')
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    out.to_csv(args.out, index=False)
    nz = (out.predicted != '').sum()
    print('wrote', args.out, len(out), 'rows;', nz, 'nonempty', f'{time.time()-t0:.0f}s', flush=True)


if __name__ == '__main__':
    main()
