import os, sys, json, time, argparse
import numpy as np, pandas as pd
import cv2
from scipy import ndimage
sys.path.insert(0, '/download_job_code/payload/sandbox/workspaces/mimosa_sigma/code')
import simlib

ROOT = '/download_job_code/payload/sandbox'
C = f'{ROOT}/workspaces/mimosa_sigma/cache'
CLASSES = simlib.CLASSES
cv2.setNumThreads(4)


def load_val(fold):
    ids = json.load(open(f'{C}/train_ids.json'))
    study = json.load(open(f'{C}/train_study.json'))
    foldarr = np.load(f'{C}/train_fold.npy')
    mask = np.load(f'{C}/train_mask.npy', mmap_mode='r')
    va = np.where(foldarr == fold)[0]
    return ids, study, va, mask


def build_gt(mask, va, study):
    # dict[(study,c)] -> (nz,H,W) bool, and per-slice index list
    gt = {}
    groups = {}
    for i in va:
        groups.setdefault(study[i], []).append(i)
    for g, idxs in groups.items():
        idxs = np.array(idxs)
        for c in range(3):
            vol = mask[idxs, c]  # (nz,320,320) uint8 (memmap) -> copy
            gt[(g, c)] = np.ascontiguousarray(vol > 0)
    return gt, groups


def postprocess(bin3d, cc_min, keep_top=0):
    if cc_min <= 1 and keep_top == 0:
        return bin3d
    st = np.ones((3, 3, 3), dtype=bool)
    lab, n = ndimage.label(bin3d, structure=st)
    if n == 0:
        return bin3d
    sizes = np.bincount(lab.ravel())
    keep = np.zeros(n + 1, dtype=bool)
    keep[1:] = sizes[1:] >= cc_min
    if keep_top > 0:
        order = np.argsort(sizes[1:])[::-1][:keep_top] + 1
        keep = np.zeros(n + 1, dtype=bool); keep[order] = True
    return keep[lab]


def eval_class(gt_vols, pred_vols, thr, cc_min, keep_top):
    dices = []; hds = []
    for key, gvol in gt_vols.items():
        pvol = (pred_vols[key] >= thr)
        if cc_min > 1 or keep_top:
            pvol = postprocess(pvol, cc_min, keep_top)
        nz = gvol.shape[0]
        d = np.mean([simlib.dice2d(pvol[z], gvol[z]) for z in range(nz)])
        hd = simlib.hd3d_norm(pvol, gvol, (320, 320))
        dices.append(d); hds.append(hd)
    dices = np.array(dices); hds = np.array(hds)
    return float(np.mean(0.4 * dices + 0.6 * (1 - hds))), float(dices.mean()), float(hds.mean())


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--probs', required=True)
    ap.add_argument('--valid', required=True)
    ap.add_argument('--fold', type=int, default=0)
    ap.add_argument('--tag', default='model')
    args = ap.parse_args()
    t0 = time.time()
    ids, study, va, mask = load_val(args.fold)
    probs = np.load(args.probs, mmap_mode='r')
    valid = np.load(args.valid)
    id2v = {x: k for k, x in enumerate(valid)}
    order = [id2v[ids[i]] for i in va]  # prob row for each va idx
    gt, groups = build_gt(mask, va, study)
    print('gt built', len(groups), 'groups', f'{time.time()-t0:.0f}s', flush=True)
    # build pred vol dict per class
    pred = {c: {} for c in range(3)}
    g2rows = {g: [] for g in groups}
    for j, i in enumerate(va):
        g2rows[study[i]].append(order[j])
    for g in groups:
        rows = np.array(g2rows[g])
        for c in range(3):
            pred[c][(g, c)] = np.asarray(probs[rows, c])
    # sweep
    thrs = [round(x, 2) for x in np.arange(0.30, 0.81, 0.05)]
    ccs = [0, 50, 100, 200, 400, 800]
    best = {}
    for c in range(3):
        gtc = {k: v for k, v in gt.items() if k[1] == c}
        rows = []
        for thr in thrs:
            for cc in ccs:
                sc, dm, hm = eval_class(gtc, pred[c], thr, cc, 0)
                rows.append((sc, dm, hm, thr, cc))
        rows.sort(reverse=True)
        best[c] = rows[0]
        print(f'class {CLASSES[c]} best combo={rows[0][0]:.4f} dice={rows[0][1]:.4f} hd={rows[0][2]:.4f} thr={rows[0][3]} cc={rows[0][4]}', flush=True)
        for r in rows[:3]:
            print('   ', tuple(round(x, 4) if isinstance(x, float) else x for x in r), flush=True)
    mean_combo = np.mean([best[c][0] for c in range(3)])
    mean_dice = np.mean([best[c][1] for c in range(3)])
    print(f'OVERALL {args.tag} combo={mean_combo:.4f} dice={mean_dice:.4f} thrs={[best[c][3] for c in range(3)]} ccs={[best[c][4] for c in range(3)]}', flush=True)
    json.dump({'tag': args.tag, 'combo': mean_combo, 'dice': mean_dice,
               'best': {CLASSES[c]: {'combo': best[c][0], 'dice': best[c][1], 'hd': best[c][2],
                                     'thr': best[c][3], 'cc': best[c][4]} for c in range(3)}},
              open(f'{ROOT}/workspaces/mimosa_sigma/logs/eval_{args.tag}.json', 'w'), indent=2)


if __name__ == '__main__':
    main()
