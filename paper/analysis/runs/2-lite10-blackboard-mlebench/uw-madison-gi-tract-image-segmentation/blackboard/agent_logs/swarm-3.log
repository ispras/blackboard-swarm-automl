hw=np.load(f'{ROOT}/workspaces/mimosa_sigma/cache/test_hw.npy'); ids=json.load(open(f'{ROOT}/workspaces/mimosa_sigma/cache/test_ids.json')); i2={x:i for i,x in enumerate(ids)}
print('file',path)
print('cols',list(sub.columns),'rows',len(sub))
print('header/order match test.csv:', list(sub.columns)==['id','class','predicted'] and (sub[['id','class']].values==tc[['id','class']].values).all())
print('order match sample_submission:', (sub[['id','class']].values==ss[['id','class']].values).all())
bad=0; badpix=0; nonempty=0; total_px=0
classes=set(sub['class'])
for r in sub.itertuples():
    s=r.predicted
    if not isinstance(s,str) or not s.strip(): continue
    nonempty+=1
    try: a=np.fromstring(s,sep=' ').astype(np.int64)
    except Exception: bad+=1; continue
    if len(a)==0 or len(a)%2: bad+=1; continue
    st=a[0::2]; ln=a[1::2]
    if (st<1).any() or (ln<1).any(): bad+=1; continue
    if (np.diff(st)<=0).any(): bad+=1; continue
    h,w=hw[i2[r.id]]
    end=st+ln-1
    if end.max()>h*w: bad+=1; continue
    # overlap check
    if len(st)>1 and (st[1:]<=end[:-1]).any(): bad+=1; continue
    total_px+=int(ln.sum())
print('classes',sorted(classes))
print('nonempty rows',nonempty,'bad rows',bad,'total predicted px',total_px)
print('md5',hashlib.md5(open(path,'rb').read()).hexdigest())
print('OK' if bad==0 else 'FAIL')
EOF
