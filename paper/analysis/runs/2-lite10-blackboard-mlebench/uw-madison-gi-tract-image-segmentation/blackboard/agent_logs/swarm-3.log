import os, glob, re, numpy as np, pandas as pd, cv2
from multiprocessing import Pool
from PIL import Image
cv2.setNumThreads(1)
ROOT=os.path.dirname(os.path.abspath(__file__)); CACHE=os.path.join(ROOT,'cache384'); S=384
DATA='/download_job_code/payload/sandbox/data'
CLS=['large_bowel','small_bowel','stomach']
pat=re.compile(r'slice_(\d+)_(\d+)_(\d+)_')
# build path map
pathmap={}
for p in glob.glob(f'{DATA}/train/*/*/scans/*.png')+glob.glob(f'{DATA}/test/*/*/scans/*.png'):
    d=p.split('/'); group=d[-3]; m=pat.search(d[-1]); sl=int(m.group(1))
    pathmap[f'{group}_slice_{sl:04d}']=p
print('paths',len(pathmap),flush=True)
def get_hw(p):
    w,h=Image.open(p).size; return (h,w)
# actual shapes
items=list(pathmap.items())
with Pool(8) as pool: hws=pool.map(get_hw,[p for _,p in items],chunksize=64)
hwmap={k:v for (k,_),v in zip(items,hws)}
print('shapes done',flush=True)
def rle_decode_C(rle,H,W):
    flat=np.zeros(H*W,np.uint8)
    if isinstance(rle,str) and len(rle):
        s=np.fromstring(rle,sep=' ').astype(np.int64)
        for st,ln in zip(s[0::2]-1,s[1::2]): flat[st:st+ln]=1
    return flat.reshape((H,W))  # C-order row-major, empirically verified
def build():
    tr=pd.read_csv(f'{CACHE}/train_index.csv')
    tr['H']=[hwmap[i][0] for i in tr['id']]; tr['W']=[hwmap[i][1] for i in tr['id']]
    tr.to_csv(f'{CACHE}/train_index.csv',index=False)
    te=pd.read_csv(f'{CACHE}/test_index.csv')
    te['H']=[hwmap[i][0] for i in te['id']]; te['W']=[hwmap[i][1] for i in te['id']]
    te.to_csv(f'{CACHE}/test_index.csv',index=False)
    lab=pd.read_csv(f'{DATA}/train.csv'); mp={(i,c):g for i,c,g in zip(lab['id'],lab['class'],lab['segmentation'])}
    N=len(tr); flags=np.lib.format.open_memmap(f'{CACHE}/train_flags.npy',mode='w+',dtype=np.uint8,shape=(N,S,S))
    for r in range(N):
        row=tr.iloc[r]; H=int(row.H); W=int(row.W); sid=row['id']
        fl=np.zeros((H,W),np.uint8)
        for b,c in enumerate(CLS):
            fl |= (rle_decode_C(mp.get((sid,c)),H,W)<<b)
        fl=cv2.resize(fl,(S,S),interpolation=cv2.INTER_NEAREST)
        flags[r]=fl
        if r%3000==0: print('mask',r,flush=True)
    flags.flush(); print('DONE')
if __name__=='__main__': build()
EOF
