import os, sys, json, argparse, time
import numpy as np, pandas as pd, cv2
from scipy import ndimage
cv2.setNumThreads(4)
ROOT='/download_job_code/payload/sandbox'
MC=f'{ROOT}/workspaces/mimosa_sigma/cache'
CLASSES=['large_bowel','small_bowel','stomach']

def rle_encode(mask):
    flat=np.asarray(mask,dtype=np.uint8).reshape(-1)  # C-order row-major (verified)
    if flat.max()==0: return ''
    d=np.diff(np.concatenate(([0],flat,[0])))
    starts=np.where(d==1)[0]+1; ends=np.where(d==-1)[0]+1; lens=ends-starts
    return ' '.join(f'{a} {b}' for a,b in zip(starts,lens))

def rle_decode(rle,shape):
    h,w=shape; img=np.zeros(h*w,np.uint8)
    if isinstance(rle,str) and rle.strip():
        s=np.asarray(rle.split(),np.int64)
        for st,ln in zip(s[0::2]-1,s[1::2]): img[st:st+ln]=1
    return img.reshape((h,w))

def postprocess(vol,cc_min):
    if cc_min<=1 or not vol.any(): return vol
    st=np.ones((3,3,3),bool); lab,n=ndimage.label(vol,structure=st)
    if n==0: return vol
    sizes=np.bincount(lab.ravel()); keep=sizes>=cc_min; keep[0]=False
    return keep[lab]

def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--probs',nargs='+',required=True); ap.add_argument('--weights',nargs='+',type=float,default=None)
    ap.add_argument('--thr',default='0.5,0.5,0.5'); ap.add_argument('--cc',default='100,100,100')
    ap.add_argument('--out',default=f'{ROOT}/workspaces/betelgeuse_zeta/submission_betel.csv'); ap.add_argument('--ids_order',default='')
    args=ap.parse_args()
    ids=json.load(open(f'{MC}/test_ids.json')); study=json.load(open(f'{MC}/test_study.json')); hw=np.load(f'{MC}/test_hw.npy')  # hw=(h,w)
    n=len(ids); ws=args.weights or [1.0]*len(args.probs); ws=np.array(ws,np.float32); ws/=ws.sum()
    blend=np.zeros((n,3,320,320),np.float32)
    for p,w in zip(args.probs,ws):
        a=np.load(p,mmap_mode='r'); assert len(a)==n,(p,len(a),n)
        s=a.shape[-1]
        for i in range(n):
            for c in range(3):
                v=np.asarray(a[i,c],np.float32)
                if s!=320: v=cv2.resize(v,(320,320),interpolation=cv2.INTER_LINEAR)
                blend[i,c]+=w*v
    thrs=[float(x) for x in args.thr.split(',')]; ccs=[int(x) for x in args.cc.split(',')]
    groups={}
    for i,g in enumerate(study): groups.setdefault(g,[]).append(i)
    rows=[]
    t0=time.time()
    for g,idxs in groups.items():
        idxs=np.array(idxs)
        for c in range(3):
            vol=blend[idxs,c]>=thrs[c]
            if vol.any(): vol=postprocess(vol,ccs[c])
            for z,i in enumerate(idxs):
                m=cv2.resize(vol[z].astype(np.uint8),(int(hw[i,1]),int(hw[i,0])),interpolation=cv2.INTER_NEAREST)
                rows.append((ids[i],CLASSES[c],rle_encode(m)))
        if len(rows)%3000<3: print('group',g,f'{time.time()-t0:.0f}s',flush=True)
    df=pd.DataFrame(rows,columns=['id','class','predicted'])
    sub=pd.read_csv(f'{ROOT}/data/test.csv')
    out=sub[['id','class']].merge(df,on=['id','class'],how='left'); out['predicted']=out['predicted'].fillna('')
    out.to_csv(args.out,index=False)
    print('wrote',args.out,len(out),'rows',int((out.predicted!='').sum()),'nonempty',flush=True)
if __name__=='__main__': main()
EOF
