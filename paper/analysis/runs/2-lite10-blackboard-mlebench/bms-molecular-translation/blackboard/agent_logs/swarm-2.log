    score=np.stack([np.where(validM,z(M.loc[ids].conf.values),-9),np.where(validT,z(T.loc[ids].conf.values),-9),np.where(validC,z(C.loc[ids].conf.values),-9)])
    pick=score.argmax(0); pickd=cand[pick,range(len(ids))]
    out[sel]=pickd[sel]
    print(f"lowconf q{q} -> best-of-3 by conf: {out.mean():.3f} (iota {di.mean():.3f})")
