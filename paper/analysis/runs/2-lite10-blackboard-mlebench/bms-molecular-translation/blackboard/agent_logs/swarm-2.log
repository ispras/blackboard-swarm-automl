import os,sys,time
sys.path.insert(0,"/download_job_code/payload/sandbox/workspaces/regulus_omega/pkgs")
import pandas as pd,numpy as np,torch,cv2
from rdkit import Chem,RDLogger
RDLogger.DisableLog('rdApp.*')
from molscribe import MolScribe
from molscribe.chemistry import convert_graph_to_smiles

def lev(a,b):
    if len(a)>len(b): a,b=b,a
    prev=list(range(len(a)+1))
    for ch in b:
        cur=[prev[0]+1]
        for j,ca in enumerate(a,1): cur.append(min(prev[j]+1,cur[j-1]+1,prev[j-1]+(ca!=ch)))
        prev=cur
    return prev[-1]

def to_inchi_smi(s):
    if not s or s=='<invalid>': return ''
    m=Chem.MolFromSmiles(s)
    if m is None: return ''
    try: return Chem.MolToInchi(m)
    except: return ''

def to_inchi_mol(mb):
    if not mb: return ''
    try:
        m=Chem.MolFromMolBlock(mb)
        if m is None: return ''
        return Chem.MolToInchi(m)
    except: return ''

tl=pd.read_csv('/download_job_code/payload/sandbox/data/train_labels.csv'); tl['h']=tl.image_id.apply(lambda x:int(x,16)%100)
val=tl[tl.h==0].head(100).reset_index(drop=True)
print("val",len(val),flush=True)
model=MolScribe('/download_job_code/payload/sandbox/workspaces/regulus_omega/ckpts/swin_base_char_aux_1m680k.pth',device=torch.device('cuda'))
imgs=[]
for iid in val.image_id:
    p=f"/download_job_code/payload/sandbox/data/train/{iid[0]}/{iid[1]}/{iid[2]}/{iid}.png"
    im=cv2.imread(p); imgs.append(cv2.cvtColor(im,cv2.COLOR_BGR2RGB))
# token decode
t=time.time(); toksm=[]
for i in range(0,len(imgs),16):
    batch=[model.transform(image=im,keypoints=[])['image'] for im in imgs[i:i+16]]
    batch=torch.stack(batch).to(model.device)
    with torch.no_grad():
        feats,hids=model.encoder(batch); preds=model.decoder.decode(feats,hids)
    toksm += [p['chartok_coords']['smiles'] for p in preds]
print("token infer",time.time()-t,flush=True)
t=time.time(); outs=model.predict_images(imgs,batch_size=16); print("graph infer",time.time()-t,flush=True)
res={}
for name in ['A_graph','B_tok','C_mol','D_tok_or_graph']: res[name]=[]
valid={n:0 for n in res}; empt={n:0 for n in res}
for row,o,ts in zip(val.itertuples(index=False),outs,toksm):
    iid,gt=row[0],row[1]
    a=to_inchi_smi(o['smiles']); b=to_inchi_smi(ts); c=to_inchi_mol(o.get('molfile',''))
    d=b or a
    for n,p in [('A_graph',a),('B_tok',b),('C_mol',c),('D_tok_or_graph',d)]:
        res[n].append(lev(p,gt)); valid[n]+=bool(p); empt[n]+=not p
for n in res: print(n,"mean",round(float(np.mean(res[n])),3),"exact",round(float(np.mean(np.array(res[n])==0)),3),"valid",valid[n])
# show token vs graph mismatches
for row,o,ts in zip(val.itertuples(index=False),outs,toksm):
    iid,gt=row[0],row[1]
    if (o['smiles'] in (None,'<invalid>')) and ts not in (None,'<invalid>'):
        print("RESCUED",iid,"tok",ts[:80],"| d",lev(to_inchi_smi(ts),gt)); break
