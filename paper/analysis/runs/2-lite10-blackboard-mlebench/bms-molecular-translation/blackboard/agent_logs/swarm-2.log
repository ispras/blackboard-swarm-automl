import sys,argparse,numpy as np,pandas as pd
from rapidfuzz.distance import Levenshtein
from sklearn.ensemble import HistGradientBoostingRegressor,RandomForestRegressor
from sklearn.model_selection import GroupKFold
R='/download_job_code/payload/sandbox'
CONST=open(f'{R}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
def load(path,icol):
    d=pd.read_csv(path).set_index('image_id')
    d[icol]=d[icol].fillna(CONST); d.loc[d[icol]=='',icol]=CONST
    return d
def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--n',type=int,default=3000); a=ap.parse_args()
    truth=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').head(a.n).set_index('image_id').InChI
    ids=list(truth.index)
    srcs={
      'iota':(load(f'{R}/workspaces/regulus_iota/val_preds_final3000.csv').reindex(ids),'inchi_from_smiles'),
      'ms':(load(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv').reindex(ids),'inchi'),
      'om':(load('preds_val_final_3000.csv').reindex(ids),'inchi'),
      'omtta':(load('preds_val_final_tta_3000.csv').reindex(ids),'inchi'),
    }
    # ranks
    for k,(d,c) in srcs.items():
        d['confrank']=d['conf'].rank(pct=True)
        d['valid']=d['valid'].astype(float) if 'valid' in d else 1.0
    rows=[]
    for iid in ids:
        cands={}
        for k,(d,c) in srcs.items():
            cands[k]=d.loc[iid,c]
        g=truth.loc[iid]
        for k,(d,c) in srcs.items():
            v=cands[k]; dd=Levenshtein.distance(v,g)
            others=[Levenshtein.distance(v,w) for kk,w in cands.items() if kk!=k]
            feats=dict(image_id=iid,src=k,dist=dd,correct=float(dd==0),
                conf=float(d.loc[iid,'conf']),confrank=float(d.loc[iid,'confrank']),valid=float(d.loc[iid,'valid']),
                len_pred=len(v),len_gt=len(g),
                agree_min=min(others),agree_mean=float(np.mean(others)),
                n_equal=sum(v==w for w in cands.values())-1,
                iota_conf=float(srcs['iota'][0].loc[iid,'conf']),
                iota_valid=float(srcs['iota'][0].loc[iid,'valid']),
                is_iota=float(k=='iota'),)
            rows.append(feats)
    df=pd.DataFrame(rows)
    print('rows',len(df),'base iota',df[df.src=='iota'].dist.mean())
    featcols=['conf','confrank','valid','len_pred','len_gt','agree_min','agree_mean','n_equal','iota_conf','iota_valid','is_iota']
    X=df[featcols].values; y=df.dist.values; groups=df.image_id.values
    oof=np.zeros(len(df))
    gkf=GroupKFold(n_splits=5)
    for tr,te in gkf.split(X,y,groups):
        m=HistGradientBoostingRegressor(max_iter=300,max_depth=6,learning_rate=0.05,l2_regularization=1.0,random_state=0)
        m.fit(X[tr],y[tr]); oof[te]=m.predict(X[te])
    df['pred']=oof
    # selection per image: min predicted distance; tie -> iota
    sel=[]
    for iid,gdf in df.groupby('image_id',sort=False):
        gdf=gdf.copy()
        gdf['rank']=gdf.src.map(lambda s: 0 if s=='iota' else 1)
        best=gdf.sort_values(['pred','rank']).iloc[0]
        sel.append((iid,best.src,best.dist,best.pred))
    s=pd.DataFrame(sel,columns=['image_id','src','dist','pred'])
    print("CV reranker mean",s.dist.mean(),"exact",np.mean(s.dist==0))
    print(s.src.value_counts())
    # baselines and oracle
    piv=df.pivot(index='image_id',columns='src',values='dist').loc[ids]
    print("baselines:",{c:round(piv[c].mean(),4) for c in piv.columns})
    print("oracle3/4",round(piv.min(axis=1).mean(),4))
    # simple iota rule: invalid->ms else iota
    iv=srcs['iota'][0]; mv=srcs['ms'][0]
    out=[]
    for iid in ids:
        v=iv.loc[iid,'inchi_from_smiles']
        if not iv.loc[iid,'valid'] and mv.loc[iid,'valid']: v=mv.loc[iid,'inchi']
        out.append(Levenshtein.distance(v,truth.loc[iid]))
    print("iota+inv->ms",round(np.mean(out),4))
    # gate reranker to only change iota when predicted gain > margin
    for margin in [0.5,1,2,3,5]:
        out=[]
        for iid,gdf in df.groupby('image_id',sort=False):
            gdf=gdf.copy(); iota_pred=gdf[gdf.src=='iota'].pred.iloc[0]
            best=gdf.sort_values('pred').iloc[0]
            if best.src!='iota' and best.pred < iota_pred-margin: out.append(best.dist)
            else: out.append(gdf[gdf.src=='iota'].dist.iloc[0])
        print('margin',margin,round(np.mean(out),4))
    df.to_csv('rerank_cv_rows.csv',index=False)
if __name__=='__main__': main()
