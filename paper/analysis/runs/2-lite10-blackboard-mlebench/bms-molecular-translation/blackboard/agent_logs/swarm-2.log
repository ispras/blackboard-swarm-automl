I=rd(f'{R}/workspaces/regulus_iota/val_preds_phase3_ckpt_best_3000.csv','inchi_from_smiles')
L=rd(f'{R}/workspaces/regulus_iota/val_preds_phase3_ckpt_last_3000.csv','inchi_from_smiles')
T=rd('preds_val_final_tta_3000.csv','inchi'); M=rd(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv','inchi')
R0=rd(f'{R}/workspaces/regulus_iota/val_preds_final_rot3000.csv','inchi_from_smiles')
D={'I':(I,'inchi_from_smiles'),'L':(L,'inchi_from_smiles'),'T':(T,'inchi'),'M':(M,'inchi'),'R':(R0,'inchi_from_smiles')}
def med(f,ms_avail_f):
    thr=I.conf.quantile(f); thr_ms=I.conf.quantile(ms_avail_f)
    routed=(~I.valid)|(I.conf<=thr); ms_avail=(~I.valid)|(I.conf<=thr_ms)
    out=[]
    for iid in truth.index:
        if not routed.loc[iid]: v=I.loc[iid,'inchi_from_smiles'] or CONST
        else:
            cs=[]
            for k,(d,c) in D.items():
                if k=='M' and not ms_avail.loc[iid]: continue
                v=d.loc[iid,c]
                if d.loc[iid,'valid'] and v: cs.append(v)
            if not cs: v=CONST
            elif len(cs)==1: v=cs[0]
            else:
                sums=[sum(Levenshtein.distance(s,y) for y in cs) for s in cs]; v=cs[int(np.argmin(sums))]
        out.append(Levenshtein.distance(v,truth.loc[iid]))
    return np.mean(out)
for f in [0.05,0.06,0.08,0.10,0.12]:
    print(f"route f{f} with MS only f5: {med(f,0.05):.4f} | MS to f{f}: {med(f,f):.4f}")
