import os,sys,time,math,random,argparse,json
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_omega/pkgs')
import numpy as np,pandas as pd,cv2,torch,torch.nn as nn,torch.nn.functional as F
from torch.utils.data import Dataset,DataLoader,RandomSampler
from molscribe.model import Encoder,Decoder
from molscribe.tokenizer import Tokenizer,SOS_ID,EOS_ID,PAD_ID
from rapidfuzz.distance import Levenshtein

ROOT='/download_job_code/payload/sandbox'
PREFIX='InChI=1S/'

class InchiTok(Tokenizer):
    def __init__(self,chars=None,path=None):
        super().__init__(path)
        if chars is not None:
            vocab=['<pad>','<sos>','<eos>','<unk>']+chars
            self.stoi={s:i for i,s in enumerate(vocab)}
            self.itos={i:s for s,i in self.stoi.items()}
    def text_to_sequence(self,text,tokenized=True):
        seq=[SOS_ID]+[self.stoi.get(c,3) for c in text]+[EOS_ID]
        return seq
    @property
    def output_constraint(self): return False

def load_model(ckpt,device,chars):
    tok=InchiTok(chars=chars)
    class A: pass
    args=A()
    d=dict(encoder='swin_base',use_checkpoint=True,input_size=384,dec_num_layers=6,dec_hidden_size=256,
           dec_attn_heads=8,hidden_dropout=0.1,attn_dropout=0.1,max_relative_positions=0,enc_pos_emb=False,
           continuous_coords=False,sep_xy=True,coord_bins=64,formats=['atomtok'],vocab_file=None)
    for k,v in d.items(): setattr(args,k,v)
    enc=Encoder(args,pretrained=False)
    st=torch.load(ckpt,map_location='cpu')
    def strip(sd): return {k.replace('module.',''):v for k,v in sd.items()}
    esd=strip(st['encoder']); enc.load_state_dict(esd,strict=True)
    args.encoder_dim=enc.n_features
    dec=Decoder(args,{'atomtok':tok})
    dsd={}
    for k,v in strip(st['decoder']).items():
        if k.startswith('decoder.chartok_coords.'):
            nk='decoder.atomtok.'+k[len('decoder.chartok_coords.'):]
        else: nk=k
        dsd[nk]=v
    cur=dec.state_dict(); ok=0; skip=0
    filt={}
    for k,v in dsd.items():
        if k in cur and hasattr(v,'shape') and v.shape==cur[k].shape:
            filt[k]=v; ok+=1
        else: skip+=1
    miss=dec.load_state_dict(filt,strict=False)
    print(f"decoder loaded {ok} tensors, skipped {skip}; missing {len(miss.missing_keys)}",flush=True)
    return enc.to(device),dec.to(device),args,tok

class DS(Dataset):
    def __init__(self,df,size,chars_max=256):
        self.paths=df['path'].values; self.labels=df['target'].values; self.size=size; self.maxlen=chars_max
    def __len__(self): return len(self.paths)
    def __getitem__(self,idx):
        p=self.paths[idx]
        img=cv2.imread(p,cv2.IMREAD_GRAYSCALE)
        if img is None: img=np.full((64,64),255,np.uint8)
        # crop white margins
        mask=img<248
        if mask.any():
            ys,xs=np.where(mask)
            y0,y1=max(0,ys.min()-3),min(img.shape[0],ys.max()+4)
            x0,x1=max(0,xs.min()-3),min(img.shape[1],xs.max()+4)
            img=img[y0:y1,x0:x1]
        h,w=img.shape
        if h==0 or w==0: img=np.full((64,64),255,np.uint8); h,w=64,64
        side=max(h,w)
        canvas=np.full((side,side),255,np.uint8)
        canvas[(side-h)//2:(side-h)//2+h,(side-w)//2:(side-w)//2+w]=img
        img=cv2.resize(canvas,(self.size,self.size),interpolation=cv2.INTER_AREA)
        if random.random()<0.5:
            k=random.randint(0,3)
            if k: img=cv2.rotate(img,k)
        arr=img.astype(np.float32)/255.0
        arr=np.stack([arr]*3)
        mean=np.array([0.485,0.456,0.406],np.float32)[:,None,None]
        std=np.array([0.229,0.224,0.225],np.float32)[:,None,None]
        arr=(arr-mean)/std
        seq=self.labels[idx][:self.maxlen]
        return torch.from_numpy(arr), torch.LongTensor([SOS_ID]+[TXT_STOI.get(c,3) for c in seq]+[EOS_ID])

TXT_STOI={}
def collate(b):
    imgs=torch.stack([x[0] for x in b])
    lens=[len(x[1]) for x in b]; ml=max(lens)
    labs=torch.full((len(b),ml),PAD_ID,dtype=torch.long)
    for i,x in enumerate(b): labs[i,:len(x[1])]=x[1]
    return imgs,labs

def make_val(df,n):
    df=df.sample(n=min(n,len(df)),random_state=123)
    return df.reset_index(drop=True)

@torch.no_grad()
def evaluate(enc,dec,args,tok,val_df,size,device,maxn=None):
    enc.eval(); dec.eval()
    paths=val_df['path'].values; targets=val_df['target'].values
    if maxn: paths=paths[:maxn]; targets=targets[:maxn]
    preds=[]
    bs=128
    dummy=DS(pd.DataFrame({'path':paths,'target':targets}),size)
    for i in range(0,len(paths),bs):
        imgs=torch.stack([dummy[j][0] for j in range(i,min(i+bs,len(paths)))]).to(device)
        with torch.autocast('cuda',dtype=torch.bfloat16):
            feats,_=enc(imgs)
            out=dec.decode(feats,beam_size=1,max_length=256)[0]
        txts=[tok.predict_caption(x[0].tolist()) for x in out]
        preds+=txts
    ps=[PREFIX+t for t in preds]; gs=[PREFIX+t for t in targets]
    for p,g in zip(ps[:3],gs[:3]): pass
    ds=[Levenshtein.distance(p,g) for p,g in zip(ps,gs)]
    exact=float(np.mean([d==0 for d in ds]))
    return float(np.mean(ds)),exact,list(zip(ps,gs))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--size',type=int,default=320)
    ap.add_argument('--batch',type=int,default=64)
    ap.add_argument('--lr_enc',type=float,default=2e-5)
    ap.add_argument('--lr_dec',type=float,default=2e-4)
    ap.add_argument('--subset',type=int,default=400000)
    ap.add_argument('--epochs',type=int,default=3)
    ap.add_argument('--steps_per_epoch',type=int,default=-1)
    ap.add_argument('--workers',type=int,default=20)
    ap.add_argument('--max_minutes',type=float,default=300)
    ap.add_argument('--out',type=str,default='/download_job_code/payload/sandbox/workspaces/regulus_omega/cap_ckpt.pt')
    ap.add_argument('--val_n',type=int,default=2000)
    ap.add_argument('--freeze_encoder',action='store_true')
    ap.add_argument('--resume',type=str,default=None)
    a=ap.parse_args()
    random.seed(42); np.random.seed(42); torch.manual_seed(42)
    device='cuda'
    tl=pd.read_csv(f'{ROOT}/data/train_labels.csv')
    th=tl.image_id.apply(lambda x:int(x,16)%100)
    tr=tl[th!=0].reset_index(drop=True)
    va=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv') if os.path.exists(f'{ROOT}/workspaces/regulus_iota/val_20k.csv') else tl[th==0].reset_index(drop=True)
    for df in (tr,va):
        df['path']=df.image_id.apply(lambda i:f'{ROOT}/data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png')
        df['target']=df.InChI.str.replace(PREFIX,'',regex=False)
    print('train',len(tr),'val',len(va),flush=True)
    chars=sorted(set(''.join(tr.target.sample(200000,random_state=0).tolist())))
    global TXT_STOI
    TXT_STOI={c:i for i,c in enumerate(['<pad>','<sos>','<eos>','<unk>']+chars)}
    print('vocab',len(chars),''.join(chars),flush=True)
    enc,dec,args,tok=load_model(f'{ROOT}/workspaces/regulus_omega/ckpts/swin_base_char_aux_1m680k.pth',device,chars)
    start=time.time()
    if a.resume and os.path.exists(a.resume):
        st=torch.load(a.resume,map_location='cpu')
        enc.load_state_dict(st['enc']); dec.load_state_dict(st['dec'])
        print('resumed',a.resume,flush=True)
    if a.freeze_encoder:
        for p in enc.parameters(): p.requires_grad=False
        enc.eval()
    params=[{'params':[p for p in dec.parameters()],'lr':a.lr_dec}]
    if not a.freeze_encoder:
        params.append({'params':[p for p in enc.parameters()],'lr':a.lr_enc})
    opt=torch.optim.AdamW(params,weight_decay=1e-6)
    ds=DS(tr,a.size)
    steps_per_epoch=a.steps_per_epoch if a.steps_per_epoch>0 else max(1,a.subset//a.batch)
    total_steps=steps_per_epoch*a.epochs
    warm=min(1000,total_steps//20)
    sched=torch.optim.lr_scheduler.LambdaLR(opt,lambda s: (s+1)/max(1,warm) if s<warm else max(0.02,0.5*(1+math.cos(math.pi*(s-warm)/max(1,total_steps-warm)))))
    crit=nn.CrossEntropyLoss(ignore_index=PAD_ID)
    va_small=make_val(va,min(a.val_n,300))
    best=999; gstep=0; t0=time.time()
    for ep in range(a.epochs):
        sampler=RandomSampler(ds,replacement=False,num_samples=min(a.subset,len(ds)))
        dl=DataLoader(ds,batch_size=a.batch,sampler=sampler,num_workers=a.workers,pin_memory=True,drop_last=True,
                      collate_fn=collate,persistent_workers=True,prefetch_factor=4)
        enc.train(not a.freeze_encoder); dec.train()
        run=0; n=0
        for it,(imgs,labs) in enumerate(dl):
            imgs=imgs.to(device,non_blocking=True); labs=labs.to(device,non_blocking=True)
            with torch.autocast('cuda',dtype=torch.bfloat16):
                if a.freeze_encoder:
                    with torch.no_grad(): feats,_=enc(imgs)
                else: feats,_=enc(imgs)
                logits,labels,_=dec(feats,labs,None)
                loss=crit(logits.reshape(-1,logits.size(-1)),labels.reshape(-1))
            opt.zero_grad(set_to_none=True); loss.backward()
            torch.nn.utils.clip_grad_norm_([p for g in opt.param_groups for p in g['params'] if p.grad is not None],5.0)
            opt.step(); sched.step(); gstep+=1; run+=loss.item(); n+=1
            if gstep%50==0:
                el=time.time()-t0
                print(f"ep{ep} step{gstep} loss {run/n:.4f} lr {sched.get_last_lr()[-1]:.2e} img/s {gstep*a.batch/el:.1f} elapsed {el/60:.1f}m",flush=True)
                run=0; n=0
            if gstep%1500==0 or (time.time()-t0)/60>a.max_minutes:
                m,ex,_=evaluate(enc,dec,args,tok,va_small,a.size,maxn=300)
                print(f"VAL step{gstep} meanLev {m:.3f} exact {ex:.3f}",flush=True)
                if m<best:
                    best=m; torch.save({'enc':enc.state_dict(),'dec':dec.state_dict(),'chars':chars,'step':gstep,'val':m},a.out)
                    print('saved',a.out,flush=True)
                enc.train(not a.freeze_encoder); dec.train()
            if (time.time()-t0)/60>a.max_minutes:
                print('time limit stop',flush=True); break
        if (time.time()-t0)/60>a.max_minutes: break
    m,ex,examples=evaluate(enc,dec,args,tok,va,a.size,maxn=None)
    print(f"FINAL val meanLev {m:.4f} exact {ex:.4f}",flush=True)
    torch.save({'enc':enc.state_dict(),'dec':dec.state_dict(),'chars':chars,'step':gstep,'val':m},a.out)
    with open(a.out+'.valpreds.json','w') as f: json.dump(examples[:200],f)
    print('done',flush=True)

if __name__=='__main__': main()
