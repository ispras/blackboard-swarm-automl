import os,sys,time,argparse
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_iota')
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_omega/pkgs')
import numpy as np,pandas as pd,torch
from PIL import Image
from torch.utils.data import Dataset,DataLoader
from common import Seq2Seq,decode_ids,batch_smiles_to_inchi,load_fallback,encode_text,PAD,SOS,EOS
R='/download_job_code/payload/sandbox'
class CropDS(Dataset):
    def __init__(self,ids,img_dir,size,mode='crop'):
        self.ids=list(ids); self.dir=img_dir; self.size=size; self.mode=mode
    def __len__(self): return len(self.ids)
    def __getitem__(self,i):
        iid=self.ids[i]; p=os.path.join(self.dir,iid[0],iid[1],iid[2],iid+'.png')
        im=Image.open(p).convert('L'); a=np.asarray(im,np.uint8)
        if self.mode in ('crop','crop_otsu'):
            m=a<248
            if m.any():
                ys,xs=np.where(m); a=a[max(0,ys.min()-2):ys.max()+3,max(0,xs.min()-2):xs.max()+3]
        h,w=a.shape
        if h<2 or w<2: a=np.full((32,32),255,np.uint8); h,w=32,32
        side=max(h,w); c=np.full((side,side),255,np.uint8)
        c[(side-h)//2:(side-h)//2+h,(side-w)//2:(side-w)//2+w]=a
        im=Image.fromarray(c).resize((self.size,self.size),Image.BILINEAR)
        arr=np.asarray(im,np.uint8)
        if self.mode=='crop_otsu':
            import cv2
            _,arr=cv2.threshold(arr,0,255,cv2.THRESH_BINARY+cv2.THRESH_OTSU)
        x=torch.from_numpy(arr).unsqueeze(0).repeat(3,1,1)
        return x
@torch.no_grad()
def run(ids,img_dir,size,mode,ckpt,batch=128,workers=6,maxlen=160):
    ck=torch.load(ckpt,map_location='cpu'); ca=ck['args']
    model=Seq2Seq(ca.get('d_model',512),ca.get('nheads',8),ca.get('nlayers',6),ca.get('ffn',2048),ca.get('dropout',0.1),pretrained=False)
    model.load_state_dict(ck['model']); model=model.cuda().eval()
    ds=CropDS(ids,img_dir,size,mode); dl=DataLoader(ds,batch_size=batch,shuffle=False,num_workers=workers,pin_memory=True)
    smis=[];confs=[];mins=[]
    for x in dl:
        x=x.cuda(non_blocking=True).float().div_(255).sub_(0.5).div_(0.5)
        ys,conf,minc=model.generate(x,maxlen=maxlen,return_scores=True)
        for row,c,mc in zip(ys.cpu().tolist(),conf.cpu().tolist(),minc.cpu().tolist()):
            smis.append(decode_ids(row)); confs.append(c); mins.append(mc)
    inchis=batch_smiles_to_inchi(smis,load_fallback())
    return pd.DataFrame({'image_id':ids,'smiles':smis,'conf':confs,'minconf':mins,'inchi_from_smiles':inchis,'valid':[bool(v and v!=load_fallback()) for v in inchis]})
if __name__=='__main__':
    p=argparse.ArgumentParser(); p.add_argument('--ckpt',required=True); p.add_argument('--ids_csv',required=True)
    p.add_argument('--split',default='val'); p.add_argument('--size',type=int,default=256); p.add_argument('--mode',default='crop')
    p.add_argument('--out',required=True); a=p.parse_args()
    ids=pd.read_csv(a.ids_csv).image_id.tolist()
    img_dir=f'{R}/data/train' if a.split=='val' else f'{R}/data/test'
    t=time.time(); out=run(ids,img_dir,a.size,a.mode,a.ckpt); out.to_csv(a.out,index=False)
    print('saved',a.out,len(out),'time',round(time.time()-t,1),flush=True)
    if a.split=='val':
        from rapidfuzz.distance import Levenshtein as L
        tr=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').set_index('image_id').InChI
        fb=load_fallback(); d=[L.distance((x or fb),tr.loc[i]) for i,x in zip(out.image_id,out.inchi_from_smiles)]
        print('MEANLEV',np.mean(d),'invalid',(~out.valid).sum(),flush=True)
EOF
