import pandas as pd,numpy as np
from rapidfuzz.distance import Levenshtein
R='/download_job_code/payload/sandbox'
truth=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').head(3000).set_index('image_id')
I=pd.read_csv(f'{R}/workspaces/regulus_iota/val_preds_final3000.csv').set_index('image_id').reindex(truth.index)
M=pd.read_csv(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv').set_index('image_id').reindex(truth.index)
T=pd.read_csv('preds_val_final_tta_3000.csv').set_index('image_id').reindex(truth.index)
CONST=open(f'{R}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
for d,c in [(I,'inchi_from_smiles'),(M,'inchi'),(T,'inchi')]:
    d[c]=d[c].fillna(CONST); d.loc[d[c]=='',c]=CONST
def dist(v): return np.array([Levenshtein.distance(x,y) for x,y in zip(v,truth.InChI)])
DI,DM,DT=dist(I.inchi_from_smiles),dist(M.inchi),dist(T.inchi)
n=2048
base=DI[:n].copy(); inv=(~I.valid.values)[:n]
# iota rule
for q in [0.022,0.03]:
    out=base.copy()
    for k,iid in enumerate(I.index[:n]):
        if inv[k]:
            if M.valid.values[k]: out[k]=DM[k]
        else:
            thr=np.quantile(I.conf.values[:n],q)
            if I.conf.values[k]<=thr and M.valid.values[k] and M.conf.values[k]>0.88: out[k]=DM[k]
    print("iota rule q",q,np.mean(out))
# add omega for unresolved invalid and lowconf where ms not chosen/valid
for q in [0.022,0.03,0.05,0.08]:
    for thO in [0.0,0.3,0.5,0.7]:
        out=base.copy(); thr=np.quantile(I.conf.values[:n],q)
        for k,iid in enumerate(I.index[:n]):
            if inv[k]:
                out[k]= DM[k] if M.valid.values[k] else (DT[k] if T.valid.values[k] else base[k])
            elif I.conf.values[k]<=thr:
                if M.valid.values[k] and M.conf.values[k]>0.88: out[k]=DM[k]
                elif T.valid.values[k] and T.conf.values[k]>thO: out[k]=DT[k]
        print(f"3src q{q} thO{thO} Lev {np.mean(out):.4f}")
print("oracle on lowconf q0.06:",np.mean(np.minimum(np.minimum(DI[:n],DM[:n]),DT[:n]))[:0] if False else np.mean(np.minimum(np.minimum(DI[:n],DM[:n]),DT[:n])))
