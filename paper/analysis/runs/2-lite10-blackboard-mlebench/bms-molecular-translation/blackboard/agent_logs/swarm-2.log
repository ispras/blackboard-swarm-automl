import pandas as pd,numpy as np
from rapidfuzz.distance import Levenshtein
R='/download_job_code/payload/sandbox'
CONST=open(f'{R}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
truth=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').head(3000).set_index('image_id').InChI
def rd(p,c):
    d=pd.read_csv(p).set_index('image_id').reindex(truth.index)
    if c not in d.columns: c='inchi'
    d[c]=d[c].fillna(''); d.loc[d[c]==CONST,c]=''
    if 'valid' in d.columns: d['valid']=d['valid'].fillna(False)
    else: d['valid']=d[c].ne('')
    return d
I=rd(f'{R}/workspaces/regulus_iota/val_preds_final3000.csv','inchi_from_smiles')
L=rd(f'{R}/workspaces/altair_theta/tt_last_val.csv','inchi_from_smiles')
Rr=rd(f'{R}/workspaces/regulus_iota/val_preds_final_rot3000.csv','inchi_from_smiles')
T=rd('preds_val_final_tta_3000.csv','inchi')
M=rd(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv','inchi')
ds={'I':I,'L':L,'R':Rr,'T':T,'M':M}
ics={'I':'inchi_from_smiles','L':'inchi_from_smiles','R':'inchi_from_smiles','T':'inchi','M':'inchi'}
routed=(~I.valid)|(I.conf<=-0.109475)
res=[]
for iid in truth.index:
    if not routed.loc[iid]:
        v=I.loc[iid,'inchi_from_smiles'] or CONST
    else:
        cands=[]
        for k,d in ds.items():
            v=d.loc[iid,ics[k]]
            if d.loc[iid,'valid'] and v: cands.append(v)
        if not cands: v=CONST
        elif len(cands)==1: v=cands[0]
        else:
            sums=[sum(Levenshtein.distance(s,y) for y in cands) for s in cands]
            v=cands[int(np.argmin(sums))]
    res.append(Levenshtein.distance(v,truth.loc[iid]))
res=np.array(res)
print('routed',int(routed.sum()),'meanLev',round(res.mean(),4),'exact',round((res==0).mean(),4),'halves',round(res[:1500].mean(),4),round(res[1500:].mean(),4))
EOF
