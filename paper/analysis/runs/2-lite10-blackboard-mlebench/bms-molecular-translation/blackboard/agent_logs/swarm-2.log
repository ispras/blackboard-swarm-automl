import pandas as pd,numpy as np
from rapidfuzz.distance import Levenshtein
R='/download_job_code/payload/sandbox'
truth=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').head(3000).set_index('image_id').InChI
ids=pd.read_csv('lowconf_val_5.csv').image_id.tolist()
M=pd.read_csv(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv').set_index('image_id').reindex(ids)
CONST=open(f'{R}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
M['inchi']=M['inchi'].fillna(CONST); M.loc[M.inchi=='','inchi']=CONST
for S in [256,320,384]:
    d=pd.read_csv(f'hires_{S}.csv').set_index('image_id').reindex(ids)
    v=d.inchi_from_smiles.fillna(CONST); v.loc[v=='']=CONST
    dist=[Levenshtein.distance(v.loc[i],truth.loc[i]) for i in ids]
    # rule
    out=[]
    for i in ids:
        x=v.loc[i]; inv=not d.loc[i,'valid']
        if inv and M.loc[i,'valid']: x=M.loc[i,'inchi']
        elif (d.loc[i,'conf']<=-0.109475) and M.loc[i,'valid'] and M.loc[i,'conf']>0.88: x=M.loc[i,'inchi']
        out.append(Levenshtein.distance(x,truth.loc[i]))
    print(S,'iota-alone',round(np.mean(dist),3),'rule',round(np.mean(out),3),'invalid',int((~d.valid).sum()))
# oracle between sizes per id
for S1,S2 in [(256,320),(256,384),(320,384)]:
    d1=pd.read_csv(f'hires_{S1}.csv').set_index('image_id').reindex(ids); d2=pd.read_csv(f'hires_{S2}.csv').set_index('image_id').reindex(ids)
    a=[Levenshtein.distance((d1.loc[i,'inchi_from_smiles'] or CONST),truth.loc[i]) for i in ids]
    b=[Levenshtein.distance((d2.loc[i,'inchi_from_smiles'] or CONST),truth.loc[i]) for i in ids]
    print(f'oracle {S1}/{S2}',round(np.mean(np.minimum(a,b)),3),'equal',sum(x==y for x,y in zip(a,b)))
