import sys,multiprocessing as mp
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_omega/pkgs')
import pandas as pd,numpy as np,json
from rdkit import Chem,RDLogger
RDLogger.DisableLog('rdApp.*')
R='/download_job_code/payload/sandbox'
def conv(s):
    try:
        m=Chem.MolFromSmiles(s)
        if m is None: return None
        return Chem.MolToInchi(m) or None
    except Exception: return None
if __name__=='__main__':
    raw=pd.read_csv(f'{R}/workspaces/altair_theta/preds_iota_test.csv.raw.csv')
    print('raw',len(raw),flush=True)
    with mp.Pool(24) as p: inchis=p.map(conv,raw.smiles.tolist(),chunksize=512)
    raw['valid']=[x is not None for x in inchis]; raw['inchi']=[x if x else '' for x in inchis]
    raw.to_csv(f'{R}/workspaces/regulus_omega/iota_test_with_valid.csv',index=False)
    for q in [0.05,0.10,0.15,0.20]:
        thr=raw.conf.quantile(q)
        ids=raw[(~raw.valid)|(raw.conf<=thr)].image_id.tolist()
        pd.DataFrame({'image_id':ids}).to_csv(f'{R}/workspaces/regulus_omega/lowconf_test_{int(q*100)}.csv',index=False)
        print(q,len(ids),flush=True)
    # val slice using iota val preds
    v=pd.read_csv(f'{R}/workspaces/regulus_iota/val_preds_final3000.csv')
    for q in [0.10,0.15,0.20]:
        thr=v.conf.quantile(q)
        ids=v[(~v.valid)|(v.conf<=thr)].image_id.tolist()
        pd.DataFrame({'image_id':ids}).to_csv(f'{R}/workspaces/regulus_omega/lowconf_val_{int(q*100)}.csv',index=False)
        print('val',q,len(ids),flush=True)
EOF
