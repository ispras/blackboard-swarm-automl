import pandas as pd,numpy as np
from rapidfuzz.distance import Levenshtein as Lev
R='/download_job_code/payload/sandbox'
FB=open(f'{R}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
truth=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').head(3000).set_index('image_id').InChI
def load(path,col=None):
    d=pd.read_csv(path)
    if col is None: col='inchi' if 'inchi' in d.columns else 'inchi_from_smiles'
    d=d.set_index('image_id').reindex(truth.index)
    s=d[col].fillna('').astype(str).replace('nan','')
    valid=d['valid'].fillna(False).astype(bool).values if 'valid' in d.columns else (s!='').values
    s=np.where(valid&(s!='')&(s!=FB),s,'')
    return pd.Series(s,index=truth.index)
p=load(f'{R}/workspaces/regulus_iota/val_preds_phase3_ckpt_best_3000.csv')
o=load(f'{R}/workspaces/regulus_iota/val_preds_final3000.csv')
r=load(f'{R}/workspaces/regulus_iota/val_preds_phase3_rot3000.csv')
om=load('preds_val_final_tta_3000.csv','inchi')
m=load(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv','inchi')
conf=pd.read_csv(f'{R}/workspaces/regulus_iota/val_preds_phase3_ckpt_best_3000.csv').set_index('image_id').reindex(truth.index).conf
validp=pd.read_csv(f'{R}/workspaces/regulus_iota/val_preds_phase3_ckpt_best_3000.csv').set_index('image_id').reindex(truth.index).valid.fillna(False)
def run(q):
    thr=conf.quantile(q); routed=(~validp)|(conf<=thr)
    out=[]
    for iid in truth.index:
        pv=p.loc[iid]
        if not routed.loc[iid]: val=pv if pv else FB
        else:
            cs=[pv] if pv else []
            for c in (o,r,om,m):
                v=c.loc[iid]
                if isinstance(v,str) and v: cs.append(v)
            if not cs: val=FB
            elif len(cs)==1: val=cs[0]
            else:
                sums=[sum(Lev.distance(s,y) for y in cs) for s in cs]; val=cs[int(np.argmin(sums))]
        out.append(Lev.distance(val,truth.loc[iid]))
    out=np.array(out); return out.mean(),out[:1500].mean(),out[1500:].mean(),routed.sum()
for q in [0.05,0.06,0.08]:
    print(q,run(q))
