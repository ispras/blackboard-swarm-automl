        if not vs: out.append(Levenshtein.distance(CONST,truth.loc[iid])); continue
        if len(vs)==1: pick=vs[0][1]
        else:
            strings=[v for k,v in vs]
            sums=[sum(Levenshtein.distance(s,y) for y in strings) for s in strings]
            pick=strings[int(np.argmin(sums))]
