import pandas as pd,numpy as np
from rapidfuzz.distance import Levenshtein as Lev
R='/download_job_code/payload/sandbox'; FB=open(f'{R}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
truth=pd.read_csv(f'{R}/workspaces/regulus_iota/val_20k.csv').head(3000).set_index('image_id').InChI
def load(f):
    d=pd.read_csv(f)
    ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    d=d.set_index('image_id').reindex(truth.index)
    s=d[ic].fillna('').astype(str).replace('nan','')
    return pd.Series(np.where((s!='')&(s!=FB),s,''),index=truth.index), d['conf'].astype(float)
I,ci=load(f'{R}/workspaces/altair_theta/check_p3_val3000.csv')
S={'last':load(f'{R}/workspaces/altair_theta/p3_last0_val.csv')[0],
   'r180':load(f'{R}/workspaces/altair_theta/p3_r180_val.csv')[0],
   'omegaT':load('preds_val_final_tta_3000.csv')[0],
   'ms':load(f'{R}/workspaces/altair_theta/preds_zeroshot_val3000.csv')[0],
   'oldiota':load(f'{R}/workspaces/regulus_iota/val_preds_final3000.csv')[0]}
def medoid(cs):
    if not cs: return FB
    if len(cs)==1: return cs[0]
    best=None;bc=None
    for a in cs:
        t=sum(Lev.distance(a,b) for b in cs)
        if best is None or t<best: best=t;bc=a
    return bc
