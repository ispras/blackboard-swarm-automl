import os,sys,time,math,random,argparse,json,multiprocessing as mp
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_omega/pkgs')
import numpy as np,pandas as pd,cv2,torch,torch.nn as nn
from torch.utils.data import Dataset,DataLoader,RandomSampler
from rdkit import Chem,RDLogger
RDLogger.DisableLog('rdApp.*')
from molscribe.model import Encoder,Decoder
from molscribe.tokenizer import Tokenizer,SOS_ID,EOS_ID,PAD_ID
from rapidfuzz.distance import Levenshtein
ROOT='/download_job_code/payload/sandbox'
PKG=f'{ROOT}/workspaces/regulus_omega/pkgs'
CONST=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

class SmiTok(Tokenizer):
    def __init__(self,path):
        super().__init__(path)
    def text_to_sequence(self,text,tokenized=True):
        return [SOS_ID]+[self.stoi.get(c,3) for c in text]+[EOS_ID]
    @property
    def output_constraint(self): return False
    def predict_text(self,seq):
        out=[]
        for i in seq:
            if i==EOS_ID or i==PAD_ID: break
            if i==SOS_ID: continue
            out.append(self.itos.get(i,''))
        return ''.join(out)

def load_model(ckpt,device,tok):
    class A: pass
    args=A()
    for k,v in dict(encoder='swin_base',use_checkpoint=True,input_size=384,dec_num_layers=6,dec_hidden_size=256,
           dec_attn_heads=8,hidden_dropout=0.1,attn_dropout=0.1,max_relative_positions=0,enc_pos_emb=False,
           continuous_coords=False,sep_xy=True,coord_bins=64,formats=['atomtok'],vocab_file=None,compute_confidence=False).items(): setattr(args,k,v)
    enc=Encoder(args,pretrained=False)
    st=torch.load(ckpt,map_location='cpu')
    def strip(sd): return {k.replace('module.',''):v for k,v in sd.items()}
    enc.load_state_dict(strip(st['encoder']),strict=True)
    args.encoder_dim=enc.n_features
    dec=Decoder(args,{'atomtok':tok})
    dsd={}
    for k,v in strip(st['decoder']).items():
        nk='decoder.atomtok.'+k[len('decoder.chartok_coords.'):] if k.startswith('decoder.chartok_coords.') else k
        dsd[nk]=v
    cur=dec.state_dict(); filt={}; skip=[]
    for k,v in dsd.items():
        if k in cur and hasattr(v,'shape') and v.shape==cur[k].shape: filt[k]=v
        else: skip.append(k)
    miss=dec.load_state_dict(filt,strict=False)
    print(f"decoder loaded {len(filt)} skipped {len(skip)} missing {len(miss.missing_keys)} skip={skip[:8]}",flush=True)
    return enc.to(device),dec.to(device),args,tok

class DS(Dataset):
    def __init__(self,paths,labels,size,maxlen=160):
        self.paths=paths; self.labels=labels; self.size=size; self.maxlen=maxlen
    def __len__(self): return len(self.paths)
    def prep(self,img):
        if img is None: return np.full((self.size,self.size,3),0.449,np.float32)
        mask=img<248
        if mask.any():
            ys,xs=np.where(mask)
            img=img[max(0,ys.min()-3):ys.max()+4, max(0,xs.min()-3):xs.max()+4]
        h,w=img.shape
        if h<2 or w<2: return np.full((self.size,self.size,3),0.449,np.float32)
        side=max(h,w); canvas=np.full((side,side),255,np.uint8)
        canvas[(side-h)//2:(side-h)//2+h,(side-w)//2:(side-w)//2+w]=img
        img=cv2.resize(canvas,(self.size,self.size),interpolation=cv2.INTER_AREA)
        arr=img.astype(np.float32)/255.0; arr=np.stack([arr]*3)
        mean=np.array([0.485,0.456,0.406],np.float32)[:,None,None]; std=np.array([0.229,0.224,0.225],np.float32)[:,None,None]
        return (arr-mean)/std
    def __getitem__(self,idx):
        img=cv2.imread(self.paths[idx],cv2.IMREAD_GRAYSCALE)
        if random.random()<0.5:
            k=random.randint(0,3)
            if k: img=cv2.rotate(img,cv2.ROTATE_90_CLOCKWISE) if k==1 else (cv2.rotate(img,cv2.ROTATE_180) if k==2 else cv2.rotate(img,cv2.ROTATE_90_COUNTERCLOCKWISE))
        arr=self.prep(img)
        seq=self.labels[idx][:self.maxlen]
        return torch.from_numpy(arr), torch.LongTensor([SOS_ID]+[TOK.stoi.get(c,3) for c in seq]+[EOS_ID])

TOK=None
def collate(b):
    imgs=torch.stack([x[0] for x in b]); ml=max(len(x[1]) for x in b)
    labs=torch.full((len(b),ml),PAD_ID,dtype=torch.long)
    for i,x in enumerate(b): labs[i,:len(x[1])]=x[1]
    return imgs,labs

def smiles_to_inchi(s):
    if not s: return None
    try:
        m=Chem.MolFromSmiles(s)
        if m is None: return None
        v=Chem.MolToInchi(m)
        return v if v else None
    except Exception: return None

@torch.no_grad()
def evaluate(enc,dec,tok,paths,targets,size,device,maxn=None,bs=128):
    enc.eval(); dec.eval()
    if maxn: paths=paths[:maxn]; targets=targets[:maxn]
    preds=[]
    ds=DS(paths,['']*len(paths),size)
    for i in range(0,len(paths),bs):
        imgs=torch.stack([ds.prep(cv2.imread(p,cv2.IMREAD_GRAYSCALE)) for p in paths[i:i+bs]]).to(device)
        with torch.autocast('cuda',dtype=torch.bfloat16):
            feats,_=enc(imgs); outs=dec.decode(feats,beam_size=1)
        preds+=[o['atomtok']['smiles'] for o in outs]
    inchis=[]
    for s in preds:
        v=smiles_to_inchi(s)
        inchis.append(v if v else CONST)
    ds_=[Levenshtein.distance(p,g) for p,g in zip(inchis,targets)]
    exact=float(np.mean([d==0 for d in ds_])); val=float(np.mean(ds_))
    smi_exact=float(np.mean([p==t for p,t in zip(preds,[None]*len(preds))])) if False else 0
    return val,exact,list(zip(inchis,targets)),preds

@torch.no_grad()
def infer_paths(enc,dec,tok,paths,size,device,bs=128,out_csv=None):
    enc.eval(); dec.eval(); res=[]
    ds=DS(paths,['']*len(paths),size)
    for i in range(0,len(paths),bs):
        imgs=torch.stack([ds.prep(cv2.imread(p,cv2.IMREAD_GRAYSCALE)) for p in paths[i:i+bs]]).to(device)
        with torch.autocast('cuda',dtype=torch.bfloat16):
            feats,_=enc(imgs); outs=dec.decode(feats,beam_size=1)
        res+=[o['atomtok']['smiles'] for o in outs]
    return res

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--size',type=int,default=320); ap.add_argument('--batch',type=int,default=64)
    ap.add_argument('--lr_enc',type=float,default=3e-5); ap.add_argument('--lr_dec',type=float,default=3e-4)
    ap.add_argument('--subset',type=int,default=400000); ap.add_argument('--epochs',type=int,default=3)
    ap.add_argument('--steps_per_epoch',type=int,default=-1); ap.add_argument('--workers',type=int,default=16)
    ap.add_argument('--max_minutes',type=float,default=300); ap.add_argument('--out',type=str,default=f'{ROOT}/workspaces/regulus_omega/smi_ckpt.pt')
    ap.add_argument('--val_n',type=int,default=500); ap.add_argument('--final_n',type=int,default=2000)
    ap.add_argument('--eval_every',type=int,default=1500); ap.add_argument('--resume',type=str,default=None)
    ap.add_argument('--time_limit_min',type=float,default=1e9)
    ap.add_argument('--maxlen',type=int,default=160)
    a=ap.parse_args()
    random.seed(42); np.random.seed(42); torch.manual_seed(42)
    device='cuda'
    df=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/labels_smiles.csv')
    df['path']=df.image_id.apply(lambda i:f'{ROOT}/data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png')
    va_ids=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').image_id
    isva=df.image_id.isin(set(va_ids))
    tr=df[~isva].reset_index(drop=True); va=df[isva].reset_index(drop=True)
    print('train',len(tr),'val',len(va),flush=True)
    global TOK
    TOK=SmiTok(f'{PKG}/molscribe/vocab/vocab_chars.json')
    enc,dec,args,tok=load_model(f'{ROOT}/workspaces/regulus_omega/ckpts/swin_base_char_aux_1m680k.pth',device,TOK)
    t0=time.time()
    if a.resume and os.path.exists(a.resume):
        st=torch.load(a.resume,map_location='cpu'); enc.load_state_dict(st['enc']); dec.load_state_dict(st['dec'])
        print('resumed',a.resume,'prev val',st.get('val'),flush=True)
    params=[{'params':list(dec.parameters()),'lr':a.lr_dec},{'params':list(enc.parameters()),'lr':a.lr_enc}]
    opt=torch.optim.AdamW(params,weight_decay=1e-6)
    spe=a.steps_per_epoch if a.steps_per_epoch>0 else max(1,a.subset//a.batch)
    total=spe*a.epochs; warm=min(1500,max(50,total//20))
    sched=torch.optim.lr_scheduler.LambdaLR(opt,lambda s:(s+1)/max(1,warm) if s<warm else max(0.03,0.5*(1+math.cos(math.pi*(s-warm)/max(1,total-warm)))))
    crit=nn.CrossEntropyLoss(ignore_index=PAD_ID)
    best=999; gstep=0
    tr_paths=tr.path.values; tr_smi=tr.smiles.values
    va_paths=va.path.values; va_inc=va.InChI.values
    idx_val=make_idx(len(va),a.val_n)
    for ep in range(a.epochs):
        ds=DS(tr_paths,tr_smi,a.size,a.maxlen)
        sampler=RandomSampler(range(len(ds)),replacement=False,num_samples=min(a.subset,len(ds)))
        dl=DataLoader(ds,batch_size=a.batch,sampler=sampler,num_workers=a.workers,pin_memory=True,drop_last=True,collate_fn=collate,persistent_workers=True,prefetch_factor=3)
        enc.train(); dec.train(); run=0; n=0
        for it,(imgs,labs) in enumerate(dl):
            imgs=imgs.to(device,non_blocking=True); labs=labs.to(device,non_blocking=True)
            with torch.autocast('cuda',dtype=torch.bfloat16):
                feats,_=enc(imgs); logits,labels,_=dec.decoder['atomtok'](feats,labs,None)
                loss=crit(logits.reshape(-1,logits.size(-1)),labels.reshape(-1))
            opt.zero_grad(set_to_none=True); loss.backward()
            torch.nn.utils.clip_grad_norm_(list(enc.parameters())+list(dec.parameters()),5.0)
            opt.step(); sched.step(); gstep+=1; run+=loss.item(); n+=1
            if gstep%50==0:
                el=time.time()-t0
                print(f"ep{ep} step{gstep} loss {run/n:.4f} lr {sched.get_last_lr()[-1]:.2e} img/s {gstep*a.batch/el:.1f} elapsed {el/60:.1f}m eta {el/60/max(gstep,1)*(total-gstep):.0f}m",flush=True)
                run=0;n=0
            if gstep%a.eval_every==0 or (time.time()-t0)/60>a.time_limit_min:
                vp=va_paths[idx_val]; vt=va_inc[idx_val]
                m,ex,_,_=evaluate(enc,dec,tok,vp,vt,a.size,device)
                print(f"VAL step{gstep} meanLev {m:.3f} exact {ex:.3f}",flush=True)
                if m<best:
                    best=m; torch.save({'enc':enc.state_dict(),'dec':dec.state_dict(),'step':gstep,'val':m,'size':a.size},a.out); print('saved',a.out,flush=True)
                enc.train(); dec.train()
            if (time.time()-t0)/60>a.time_limit_min or (time.time()-t0)/60>a.max_minutes:
                print('time stop',flush=True); break
        if (time.time()-t0)/60>a.time_limit_min or (time.time()-t0)/60>a.max_minutes: break
    m,ex,examples,preds=evaluate(enc,dec,tok,va_paths,va_inc,a.size,device,maxn=a.final_n)
    print(f"FINAL val meanLev {m:.4f} exact {ex:.4f}",flush=True)
    torch.save({'enc':enc.state_dict(),'dec':dec.state_dict(),'step':gstep,'val':m,'size':a.size},a.out)
    with open(a.out+'.valpreds.json','w') as f: json.dump(examples[:300],f)
    print('done',flush=True)

def make_idx(n,k):
    rng=np.random.RandomState(7); return rng.choice(n,min(k,n),replace=False)

if __name__=='__main__': main()
