import pandas as pd,numpy as np
from rapidfuzz.distance import Levenshtein
ROOT='/download_job_code/payload/sandbox'
truth=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').head(3000)[['image_id','InChI']]
iota=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_preds_final3000.csv')
ms=pd.read_csv(f'{ROOT}/workspaces/altair_theta/preds_zeroshot_val3000.csv')
om=pd.read_csv('preds_val_final_3000.csv')
ot=pd.read_csv('preds_val_final_tta_3000.csv')
CONST=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
truth=truth.set_index('image_id')
def prep(df,icol='inchi'):
    d=df.set_index('image_id')
    d=d.reindex(truth.index)
    if 'valid' not in d: d['valid']=True
    d[icol]=d[icol].fillna(CONST)
    d.loc[d[icol]=='',icol]=CONST
    d['dist']=[Levenshtein.distance(x,y) for x,y in zip(d[icol],truth.InChI)]
    return d
I=prep(iota,'inchi_from_smiles')
M=prep(ms,'inchi')
O=prep(om,'inchi')
T=prep(ot,'inchi')
print("alone: iota",I.dist.mean(),"ms",M.dist.mean(),"omega",O.dist.mean(),"omega_tta",T.dist.mean())
def cv(x,n=2048): return np.mean(x[:n])
for n in [1000,2048,3000]:
    print(f"-- n={n}")
    print(" iota",I.dist[:n].mean(),"ms",M.dist[:n].mean(),"om",O.dist[:n].mean(),"omtta",T.dist[:n].mean())
# rules
base=I['inchi_from_smiles'].copy()
def rule(q, cand='ms', invalid_cand=None):
    out=base.copy(); inv=~I.valid
    if invalid_cand is None: invalid_cand=cand
    for iid in I.index[inv]:
        c = M if invalid_cand=='ms' else (T if invalid_cand=='omtta' else O)
        if c.loc[iid,'valid']: out.loc[iid]=c.loc[iid,'inchi']
    thr=I.conf.quantile(q)
    low=(I.conf<=thr)&(~inv)
    for iid in I.index[low]:
        c = M if cand=='ms' else (T if cand=='omtta' else O)
        if c.loc[iid,'valid']: out.loc[iid]=c.loc[iid,'inchi']
    d=[Levenshtein.distance(a,b) for a,b in zip(out,truth.InChI)]
    return np.mean(d),np.mean(np.array(d)==0),inv.mean(),low.mean()
for q in [0.01,0.022,0.03,0.05,0.08]:
    for cand in ['ms','om','omtta']:
        m,e,fi,fl=rule(q,cand)
        print(f"q{q} cand{cand}: Lev {m:.4f} exact {e:.3f} inv{fi*100:.1f}% low{fl*100:.1f}%")
# invalid -> try omega_tta first then ms
out=base.copy(); inv=~I.valid
for iid in I.index[inv]:
    if T.loc[iid,'valid']: out.loc[iid]=T.loc[iid,'inchi']
    elif M.loc[iid,'valid']: out.loc[iid]=M.loc[iid,'inchi']
out2=base.copy()
for iid in I.index[inv]:
    if M.loc[iid,'valid']: out2.loc[iid]=M.loc[iid,'inchi']
    elif T.loc[iid,'valid']: out2.loc[iid]=T.loc[iid,'inchi']
for name,o in [('inv omtta->ms',out),('inv ms->omtta',out2)]:
    d=[Levenshtein.distance(a,b) for a,b in zip(o,truth.InChI)]
    print(name,np.mean(d),np.mean(np.array(d)==0))
# distances of each source on iota-invalid and iota-lowconf slices
inv=~I.valid
for q in [0.03,0.06]:
    thr=I.conf.quantile(q); low=(I.conf<=thr)&(~inv)
    print(f"slice q{q}: n_low={low.sum()}, iota dist {I.dist[low].mean():.2f}, ms {M.dist[low].mean():.2f} valid {M.valid[low].mean():.2f}, omtta {T.dist[low].mean():.2f} valid {T.valid[low].mean():.2f}, om {O.dist[low].mean():.2f}")
print("invalid slice n",inv.sum(),"iota",I.dist[inv].mean(),"ms",M.dist[inv].mean(),M.valid[inv].mean(),"omtta",T.dist[inv].mean(),T.valid[inv].mean())
EOF
