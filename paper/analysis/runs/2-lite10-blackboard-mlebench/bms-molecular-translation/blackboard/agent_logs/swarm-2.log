    pass
for thr_name,thr in [('test_thr',-0.10637),('valq5',ci.quantile(0.05))]:
    routed=(I=='')|(ci<=thr)
    out=[]
    for iid in truth.index:
        a=I.loc[iid]
        if not routed.loc[iid]: p=a or FB
        else:
            cs=[a] if a else []
            for k,v in S.items():
                if v.loc[iid]: cs.append(v.loc[iid])
            p=medoid(cs)
        out.append(Lev.distance(p,truth.loc[iid]))
    out=np.array(out); print(thr_name,'routed',int(routed.sum()),'Lev',round(out.mean(),4),'halves',round(out[:1500].mean(),4),round(out[1500:].mean(),4))
