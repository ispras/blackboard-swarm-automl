import sys,argparse,numpy as np,pandas as pd
from rapidfuzz.distance import Levenshtein
from sklearn.isotonic import IsotonicRegression
ROOT='/download_job_code/payload/sandbox'
CONST=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--val_truth',default=f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
    ap.add_argument('--val_preds',nargs='+',required=True,help='csv image_id,inchi,conf,model on val')
    ap.add_argument('--test_preds',nargs='+',required=True,help='csv image_id,inchi,conf,model on test')
    ap.add_argument('--out',default=f'{ROOT}/workspaces/regulus_omega/fused_submission.csv')
    ap.add_argument('--nrows',type=int,default=0)
    a=ap.parse_args()
    truth=pd.read_csv(a.val_truth).set_index('image_id').InChI
    models=[]
    for p in a.val_preds:
        d=pd.read_csv(p); d=d[d.image_id.isin(truth.index)].drop_duplicates('image_id').set_index('image_id')
        gt=truth.loc[d.index].values
        d['dist']=[Levenshtein.distance(x,y) for x,y in zip(d.inchi.values,gt)]
        wrong=d[d.dist>0]
        mw=float(wrong.dist.mean()) if len(wrong) else 72.0
        iso=IsotonicRegression(out_of_bounds='clip',y_min=0,y_max=1).fit(d.conf.values,(d.dist.values==0).astype(float))
        # expected distance model: p_exact*0 + (1-p_exact)*mean_wrong_dist; also floor from observed
        models.append({'path':p,'name':d.model.iloc[0] if 'model' in d else p,'mw':mw,'iso':iso,
                       'val_mean':float(d.dist.mean()),'val_exact':float((d.dist==0).mean()),'n':len(d)})
        print(f"{models[-1]['name']}: n={len(d)} meanLev={models[-1]['val_mean']:.3f} exact={models[-1]['val_exact']:.3f} mean_wrong={mw:.1f}")
    # merge test preds
    dfs=[]
    for p in a.test_preds:
        d=pd.read_csv(p); d=d.drop_duplicates('image_id')
        dfs.append(d.set_index('image_id'))
    base_ids=dfs[0].index
    if a.nrows: base_ids=base_ids[:a.nrows]
    out=[]
    for iid in base_ids:
        best=CONST; best_exp=72.03; best_src='const'
        for d,m in zip(dfs,models):
            if iid not in d.index: continue
            row=d.loc[iid]; conf=float(row.conf)
            p=float(m['iso'].predict([conf])[0])
            exp=(1-p)*m['mw']
            if row.inchi==CONST: exp=72.03
            if exp<best_exp:
                best_exp=exp; best=row.inchi; best_src=m['name']
        out.append((iid,best,best_src))
    df=pd.DataFrame(out,columns=['image_id','InChI','source'])
    df.to_csv(a.out,index=False)
    print('wrote',a.out,len(df)); print(df.source.value_counts().head(10))

if __name__=='__main__': main()
