import pandas as pd, numpy as np
from collections import Counter,defaultdict
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str))); ids=list(gt)
def load(f):
    d=pd.read_csv(f); ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    out={}
    for i,x,c in zip(d.image_id.astype(str),d[ic].fillna(''),d['conf']):
        xs=str(x).strip(); out[i]=('' if xs in ('','nan') or xs==FB else xs, float(c))
    return out
S={'iota':load('../regulus_iota/val_preds_final3000.csv'),'omega':load('../regulus_omega/preds_val_final_3000.csv'),
   'omegaT':load('../regulus_omega/preds_val_final_tta_3000.csv'),'ms':load('preds_zeroshot_val3000.csv'),
   'r90':load('tta_val_r90.csv'),'r180':load('../regulus_iota/val_preds_final_rot3000.csv'),'r270':load('tta_val_r270.csv'),'last':load('tt_last_val.csv')}
def ev(pred): return np.mean([Lev.distance((p or FB),gt[i]) for p,i in zip(pred,ids)])
ci=np.array([S['iota'][i][1] for i in ids]); vi=np.array([bool(S['iota'][i][0]) for i in ids])
def routed(f):
    th=np.quantile(ci[vi],f) if f>0 else -1e9
    return (ci<=th)|(~vi)
def medoid(cands):
    if len(cands)==1: return cands[0]
    best=None
    for a in cands:
        s=sum(Lev.distance(a,b) for b in cands)
        if best is None or s<best[0]: best=(s,a)
    return best[1]
def policy_medoid(f,names,cluster_thr=None):
    R=routed(f); out=[]
    for k,i in enumerate(ids):
        if not R[k]: out.append(S['iota'][i][0] or FB); continue
        cands=[S[n][i][0] for n in names if S[n][i][0]]
        if not cands: out.append(FB); continue
        if cluster_thr is not None:
            # largest cluster under distance thr, then medoid
            groups=[]
            for a in cands:
                g=[b for b in cands if Lev.distance(a,b)<=cluster_thr]
                groups.append(g)
            g=max(groups,key=len); cands=g
        out.append(medoid(cands))
    return out
names_sets=[['iota','last','omega','omegaT','ms','r180'],['iota','last','ms','omegaT','r180'],['iota','last','omegaT','ms'],['iota','last','r180','omegaT'],['iota','ms','omegaT','r180']]
for names in names_sets:
    for f in [0.05,0.10,0.15,0.20]:
        print("medoid",'+'.join(names),f,round(ev(policy_medoid(f,names)),4))
    for f in [0.10,0.15]:
        for ct in [1,2,3,5]:
            print("medoid_cluster",'+'.join(names),f,ct,round(ev(policy_medoid(f,names,ct)),4))
