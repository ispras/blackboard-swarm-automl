from molscribe.model import Encoder,Decoder
from molscribe.tokenizer import Tokenizer,SOS_ID,EOS_ID,PAD_ID
from rapidfuzz.distance import Levenshtein

ROOT='/download_job_code/payload/sandbox'
PREFIX='InChI=1S/'

class InchiTok(Tokenizer):
    def __init__(self,chars=None,path=None):
        super().__init__(path)
        if chars is not None:
            vocab=['<pad>','<sos>','<eos>','<unk>']+chars
            self.stoi={s:i for i,s in enumerate(vocab)}
            self.itos={i:s for s,i in self.stoi.items()}
    def text_to_sequence(self,text,tokenized=True):
        seq=[SOS_ID]+[self.stoi.get(c,3) for c in text]+[EOS_ID]
        return seq
    @property
    def output_constraint(self): return False

def load_model(ckpt,device,chars):
    tok=InchiTok(chars=chars)
    class A: pass
    args=A()
    d=dict(encoder='swin_base',use_checkpoint=True,input_size=384,dec_num_layers=6,dec_hidden_size=256,
           dec_attn_heads=8,hidden_dropout=0.1,attn_dropout=0.1,max_relative_positions=0,enc_pos_emb=False,
           continuous_coords=False,sep_xy=True,coord_bins=64,formats=['atomtok'],vocab_file=None,compute_confidence=False)
    for k,v in d.items(): setattr(args,k,v)
    enc=Encoder(args,pretrained=False)
    st=torch.load(ckpt,map_location='cpu')
    def strip(sd): return {k.replace('module.',''):v for k,v in sd.items()}
    esd=strip(st['encoder']); enc.load_state_dict(esd,strict=True)
    args.encoder_dim=enc.n_features
    dec=Decoder(args,{'atomtok':tok})
    dsd={}
    for k,v in strip(st['decoder']).items():
        if k.startswith('decoder.chartok_coords.'):
            nk='decoder.atomtok.'+k[len('decoder.chartok_coords.'):]
        else: nk=k
        dsd[nk]=v
    cur=dec.state_dict(); ok=0; skip=0
    filt={}
    for k,v in dsd.items():
        if k in cur and hasattr(v,'shape') and v.shape==cur[k].shape:
            filt[k]=v; ok+=1
        else: skip+=1
    miss=dec.load_state_dict(filt,strict=False)
    print(f"decoder loaded {ok} tensors, skipped {skip}; missing {len(miss.missing_keys)}",flush=True)
    return enc.to(device),dec.to(device),args,tok

class DS(Dataset):
    def __init__(self,df,size,chars_max=256):
