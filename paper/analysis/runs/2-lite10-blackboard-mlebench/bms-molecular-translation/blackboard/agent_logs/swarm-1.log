ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str))); ids=list(gt)
def load(f):
    d=pd.read_csv(f); ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    s=d[ic].fillna('').astype(str).replace('nan','')
    valid=d['valid'].fillna(False).astype(bool).values if 'valid' in d.columns else ((s!='').values&(s!=FB).values)
    return {i:(x if (val and x and x!=FB) else '') for i,x,val in zip(d.image_id.astype(str),s,valid)}
C={'iota':load(f'{ROOT}/workspaces/regulus_iota/val_preds_phase3_ckpt_best_3000.csv'),
   'old':load(f'{ROOT}/workspaces/regulus_iota/val_preds_final3000.csv'),
   'rot':load(f'{ROOT}/workspaces/regulus_iota/val_preds_phase3_rot3000.csv'),
   'omT':load(f'{ROOT}/workspaces/regulus_omega/preds_val_final_tta_3000.csv'),
