import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str))); ids=list(gt)
def load(f):
    d=pd.read_csv(f); ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    return {i:('' if str(x).strip() in ('','nan') or str(x).strip()==FB else str(x).strip(), float(c)) for i,x,c in zip(d.image_id.astype(str),d[ic].fillna(''),d['conf'])}
S={'iota':load('../regulus_iota/val_preds_final3000.csv'),'ms':load('preds_zeroshot_val3000.csv'),'r180':load('../regulus_iota/val_preds_final_rot3000.csv'),'last':load('tt_last_val.csv'),'omegaT':load('../regulus_omega/preds_val_final_tta_3000.csv')}
ci=np.array([S['iota'][i][1] for i in ids]); vi=np.array([bool(S['iota'][i][0]) for i in ids])
def medoid(c): return min(c,key=lambda a: sum(Lev.distance(a,b) for b in c))
th=-0.109475
pr={}; nroute=0; nswitch=0
for k,i in enumerate(ids):
    routed=(ci[k]<=th) or (not vi[k])
    a=S['iota'][i][0]
    if not routed: pr[i]=a or FB; continue
    nroute+=1
    c=[a] if a else []
    for n in ['last','r180','omegaT']:
        if S[n][i][0]: c.append(S[n][i][0])
    if not vi[k] and S['ms'][i][0]: c.append(S['ms'][i][0])  # ms only for invalid as in test
    p=medoid(c) if c else FB
    if p!=a: nswitch+=1
    pr[i]=p or FB
d=np.array([Lev.distance(pr[i],gt[i]) for i in ids])
print("routed",nroute,"switch",nswitch,"val estimate",d.mean(),"halves",np.mean(d[0::2]),np.mean(d[1::2]))
