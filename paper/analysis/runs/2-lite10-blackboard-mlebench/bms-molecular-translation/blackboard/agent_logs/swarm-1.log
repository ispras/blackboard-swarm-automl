import argparse, os, numpy as np, pandas as pd
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'
FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def read(p):
    df=pd.read_csv(p)
    pc=[c for c in ['inchi_from_smiles','InChI_pred','inchi','InChI'] if c in df.columns][0]
    cc=[c for c in ['conf','confidence'] if c in df.columns][0]
    return {str(i):(str(x) if isinstance(x,str) else '', float(c)) for i,x,c in zip(df.image_id,df[pc].fillna(''),df[cc])}

def policy(ids, main, tta, t):
    out={}
    for i in ids:
        s0,c0=main.get(i,('',-1e9))
        if c0>=t or i not in tta:
            out[i]=s0
        else:
            s1,c1=tta[i]
            out[i]=s1 if c1>c0 else s0
    return out

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--main',required=True)
    ap.add_argument('--tta',default='')
    ap.add_argument('--val',default=f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
    ap.add_argument('--out',default='')
    ap.add_argument('--sweep',action='store_true')
    ap.add_argument('--thresholds',default='')
    a=ap.parse_args()
    m=read(a.main); tta=read(a.tta) if a.tta else {}
    v=pd.read_csv(a.val); gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str)))
    ids=[i for i in m if i in gt]
    if a.sweep or not a.out:
        ths=[float(x) for x in a.thresholds.split(',')] if a.thresholds else [-0.20,-0.18,-0.16,-0.14,-0.12,-0.11,-0.10,-0.095,-0.09,-0.08,-0.06,-0.04,1.0]
        best=(1e9,None)
        for t in ths:
            pr=policy(ids,m,tta,t)
            d=np.mean([Lev.distance(pr[i] if pr[i] else FB, gt[i]) for i in ids])
            ex=np.mean([Lev.distance(pr[i] if pr[i] else FB, gt[i])==0 for i in ids])
            print(f"t={t:+.3f} lev={d:.3f} exact={ex:.3f}")
            if d<best[0]: best=(d,t)
        print("BEST",best)
    if a.out:
        ss=pd.read_csv(f'{ROOT}/data/sample_submission.csv'); allids=ss.image_id.astype(str).tolist()
        t=best[1] if (a.sweep and best[1] is not None) else 1.0
        pr=policy(allids,m,tta,t)
        rows=[pr.get(i,'') or FB for i in allids]
        pd.DataFrame({'image_id':allids,'InChI':rows}).to_csv(a.out,index=False)
        print('wrote',a.out,'cover',sum(1 for i in allids if pr.get(i,'')),'fallback',sum(1 for r in rows if r==FB))

if __name__=='__main__': main()
