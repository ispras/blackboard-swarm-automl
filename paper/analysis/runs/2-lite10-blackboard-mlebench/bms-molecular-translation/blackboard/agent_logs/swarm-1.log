import time, json, cv2, numpy as np, pandas as pd, torch
from rdkit import Chem, RDLogger
from rdkit.Chem import inchi
RDLogger.DisableLog('rdApp.*')
from molscribe import MolScribe
from molscribe.dataset import CropWhite
import albumentations as A
from albumentations.pytorch import ToTensorV2
from rapidfuzz.distance import Levenshtein

ckpt='hf/models--yujieq--MolScribe/snapshots/a0189776b7415b82795c7ee81eed311bf5c8724b/swin_base_char_aux_1m.pth'
dev=torch.device('cuda')

def make_tf(size):
    tl=[CropWhite(pad=5),
        A.PadIfNeeded(min_height=size,min_width=size,border_mode=cv2.BORDER_CONSTANT,value=(255,255,255)),
        A.LongestMaxSize(max_size=size),
        A.PadIfNeeded(min_height=size,min_width=size,border_mode=cv2.BORDER_CONSTANT,value=(255,255,255)),
        A.ToGray(p=1),A.Normalize(mean=[0.485,0.456,0.406],std=[0.229,0.224,0.225]),ToTensorV2()]
    return A.Compose(tl, keypoint_params=A.KeypointParams(format='xy', remove_invisible=False))

df=pd.read_csv('/download_job_code/payload/sandbox/workspaces/regulus_iota/val_20k.csv').sample(96,random_state=7)
imgs=[]
for iid in df.image_id:
    p=f"/download_job_code/payload/sandbox/data/train/{iid[0]}/{iid[1]}/{iid[2]}/{iid}.png"
    im=cv2.imread(p); imgs.append(cv2.cvtColor(im,cv2.COLOR_BGR2RGB))

model=MolScribe(model_path=ckpt, device=dev)
layers=model.encoder.transformer.layers
for l in layers: l.use_checkpoint=False
print("ckpt off", flush=True)

def evaluate(model, imgs, gt, half=False, infer_mode=True, tag=""):
    model.transform=make_tf(SIZE)
    t=time.time()
    with torch.inference_mode() if infer_mode else torch.no_grad():
        if half:
            outs=model.predict_images([None]*len(imgs), return_confidence=True, batch_size=BS) if False else None
        # replicate predict_images to allow half input
        preds=[]; imshape=None
        for idx in range(0,len(imgs),BS):
            batch=imgs[idx:idx+BS]
            x=torch.stack([model.transform(image=b,keypoints=[])['image'] for b in batch]).to(dev)
            if half: x=x.half()
            feats,hid=model.encoder(x)
            preds+=model.decoder.decode(feats,hid)
    dt=time.time()-t
    smiles=[p['chartok_coords']['smiles'] for p in preds]
    coords=[p['chartok_coords']['coords'] for p in preds]
    syms=[p['chartok_coords']['symbols'] for p in preds]
    edges=[p['edges'] for p in preds]
    from molscribe.chemistry import convert_graph_to_smiles
    smi_list,_,_=convert_graph_to_smiles(coords,syms,edges,images=imgs)
    ds=[]; nvalid=0
    for row,smi,o in zip(df.itertuples(),smi_list,preds):
        try:
            m=Chem.MolFromSmiles(smi) if smi else None
            p=inchi.MolToInchi(m) if m is not None else ''
        except Exception: p=''
        if p: nvalid+=1
        ds.append(Levenshtein.distance(p,row.InChI))
    print(f"{tag} size={SIZE} bs={BS} half={half} t/img={dt/len(imgs):.3f} mean={np.mean(ds):.2f} exact={np.mean([d==0 for d in ds]):.3f} valid={nvalid}/{len(ds)}",flush=True)
    return np.mean(ds)

import sys
configs=[(384,16,False),(384,32,False),(384,64,False),(384,32,True),(320,32,True),(256,32,True),(256,64,True)]
res={}
for SIZE,BS,HALF in configs:
    if HALF and not hasattr(model,'_half_done'):
        model.encoder.half(); model.decoder.half(); model._half_done=True
    # carefully: converting to half once; do all half configs after fp32
    res[f"{SIZE}_{BS}_{HALF}"]=evaluate(model,imgs,None,half=HALF,tag="")
json.dump(res,open('bench.json','w'))
