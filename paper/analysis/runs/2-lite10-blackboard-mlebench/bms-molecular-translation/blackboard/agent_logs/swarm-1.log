import pandas as pd, numpy as np, re, time, pickle
from collections import defaultdict, Counter
t0=time.time()
# load pool
pool=pd.read_csv('/download_job_code/payload/sandbox/data/extra_approved_InChIs.csv', header=0)
col=pool.columns[0]; print("pool",pool.shape,col,time.time()-t0,flush=True)
pool=pool[col].astype(str)
def formula(s):
    # InChI=1S/<formula>/...
    try:
        return s.split('/',2)[1]
    except Exception:
        return ''
# membership check on 20k train labels (chunked)
tr=pd.read_csv('/download_job_code/payload/sandbox/workspaces/regulus_iota/val_20k.csv')
poolset=None
# membership via merge to save memory
tr['f']=tr.InChI.map(formula)
pool_df=pd.DataFrame({'InChI':pool.values})
pool_df['f']=pool_df.InChI.map(formula)
print("pool parsed",time.time()-t0,flush=True)
m=pool_df.merge(tr[['InChI']],on='InChI',how='inner')
print("holdout rows found in pool:",len(m),"of",len(tr),flush=True)
# formula group sizes for holdout formulas
cnt=pool_df.f.value_counts()
print("formula count stats all pool:",cnt.describe().to_dict(),flush=True)
hf=set(tr.f)
hs=cnt[cnt.index.isin(hf)]
print("holdout formulas",len(hf),"group size stats",hs.describe().to_dict(),flush=True)
print("median group",hs.median(),"p90",hs.quantile(.9),"p99",hs.quantile(.99),flush=True)
# save formula->list only for holdout formulas, plus all train formulas maybe
want=hf
grp=defaultdict(list)
for s,f in zip(pool_df.InChI.values, pool_df.f.values):
    if f in want: grp[f].append(s)
print("grp built",len(grp),time.time()-t0,flush=True)
pickle.dump(dict(grp),open('pool_groups_val.pkl','wb'))
print("saved",time.time()-t0)
