import argparse, os, json, numpy as np, pandas as pd
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'
FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def load_pred(p):
    df=pd.read_csv(p)
    ic=[c for c in ['inchi_from_smiles','inchi','InChI_pred','InChI'] if c in df.columns][0]
    cc=[c for c in ['conf','confidence'] if c in df.columns][0]
    out={}
    for i,x,c in zip(df.image_id.astype(str),df[ic].fillna(''),df[cc]):
        out[i]=(str(x), float(c))
    return out

class Cal:
    """bins conf -> mean Lev for one source (monotone via isotonic-free bin averaging)"""
    def __init__(self, nb=12): self.nb=nb
    def fit(self, conf, lev):
        conf=np.asarray(conf); lev=np.asarray(lev)
        qs=np.unique(np.quantile(conf, np.linspace(0,1,self.nb+1)))
        if len(qs)<3: qs=np.array([conf.min(), conf.max()+1e-9])
        self.edges=qs; self.vals=[]
        for j in range(len(qs)-1):
            m=(conf>=qs[j])&(conf<qs[j+1]) if j<len(qs)-2 else (conf>=qs[j])&(conf<=qs[j+1])
            self.vals.append(float(lev[m].mean()) if m.sum() else (self.vals[-1] if self.vals else float(lev.mean())))
        # enforce monotone non-increasing expected Lev with conf
        for j in range(len(self.vals)-2,-1,-1):
            self.vals[j]=max(self.vals[j], self.vals[j+1])
    def predict(self, conf):
        idx=np.searchsorted(self.edges, conf, side='right')-1
        idx=np.clip(idx,0,len(self.vals)-1)
        return np.array([self.vals[k] for k in idx])

def build(val_csv, sources, target_ids=None):
    v=pd.read_csv(val_csv); gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str)))
    if target_ids is not None: ids=[i for i in target_ids if i in gt]
    else: ids=[i for i in gt]
    P={name:load_pred(p) for name,p in sources.items()}
    lev={name:np.array([Lev.distance((P[name].get(i,('',-1e9))[0]) or FB, gt[i]) for i in ids]) for name in P}
    conf={name:np.array([P[name].get(i,('',-1e9))[1] for i in ids]) for name in P}
    return ids,gt,P,lev,conf

def policy_predict(ids, P, cals, fb_lev):
    n=len(ids); bestL=np.full(n, fb_lev); bestS=np.array(['__fb__']*n, dtype=object)
    for name,cal in cals.items():
        c=np.array([P[name].get(i,('',-1e9))[1] for i in ids])
        L=cal.predict(c)
        m=L<bestL
        bestL=np.where(m,L,bestL); bestS=np.where(m,name,bestS)
    preds=[]
    for k,i in enumerate(ids):
        if bestS[k]=='__fb__' or i not in P[bestS[k]] or not P[bestS[k]][i][0]: preds.append(FB)
        else: preds.append(P[bestS[k]][i][0])
    return preds,bestS

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--val',default=f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
    ap.add_argument('--val_limit',type=int,default=1000)
    ap.add_argument('--src',action='append',required=True,help='name:valcsv')
    ap.add_argument('--test',action='append',default=[],help='name:testcsv')
    ap.add_argument('--out',default='')
    a=ap.parse_args()
    srcs={s.split(':',1)[0]:s.split(':',1)[1] for s in a.src}
    v=pd.read_csv(a.val); ids_all=v.image_id.astype(str).tolist()[:a.val_limit]
    ids,gt,P,lev,conf=build(a.val,srcs,ids_all)
    print("sources:",{k:(round(lev[k].mean(),3)) for k in srcs})
    fb=np.mean([Lev.distance(FB,gt[i]) for i in ids]); print("fallback",round(fb,3))
    # honest 2-fold check of calibration
    half=len(ids)//2; idx=np.arange(len(ids)); cv=[]
    for tr,te in [(idx[:half],idx[half:]),(idx[half:],idx[:half])]:
        cals={}
        for name in srcs:
            c=Cal(); c.fit(conf[name][tr],lev[name][tr]); cals[name]=c
        pr,ch=policy_predict([ids[k] for k in te],P,cals,fb)
        cv.append(np.mean([Lev.distance(p,gt[i]) for p,i in zip(pr,[ids[k] for k in te])]))
    print("honest CV lev:",round(np.mean(cv),3),cv)
    cals={}
    for name in srcs:
        c=Cal(); c.fit(conf[name],lev[name]); cals[name]=c
    pr,ch=policy_predict(ids,P,cals,fb)
    print("in-sample lev:",round(np.mean([Lev.distance(p,gt[i]) for p,i in zip(pr,ids)]),3),
          "routed:",{s:int((ch==s).sum()) for s in set(ch)})
    if a.out:
        ss=pd.read_csv(f'{ROOT}/data/sample_submission.csv'); allids=ss.image_id.astype(str).tolist()
        TP={}
        for spec in a.test:
            name,p=spec.split(':',1); TP[name]=load_pred(p)
        allP={k:TP.get(k,{}) for k in srcs}
        rows,bestS=policy_predict(allids,allP,cals,fb)
        nfb=sum(1 for x in rows if x==FB)
        pd.DataFrame({'image_id':allids,'InChI':rows}).to_csv(a.out,index=False)
        print("wrote",a.out,"fallback rows",nfb,"sources",{s:int((bestS==s).sum()) for s in set(bestS)})
        json.dump({n:{'edges':list(map(float,c.edges)),'vals':c.vals} for n,c in cals.items()},open(a.out+'.cal.json','w'))

if __name__=='__main__': main()
