import argparse, os, numpy as np, pandas as pd
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'
FALLBACK=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def load_gt(val_csv):
    df=pd.read_csv(val_csv)
    return dict(zip(df.image_id.astype(str), df.InChI.astype(str)))

def col(df, want):
    for c in want:
        if c in df.columns: return c
    raise KeyError(f"none of {want} in {list(df.columns)}")

def get_pred(df):
    for c in ['inchi_from_smiles','InChI_pred','inchi','InChI']:
        if c in df.columns: return df[c].fillna('').astype(str)
    raise KeyError(list(df.columns))

def get_conf(df):
    for c in ['conf','confidence']:
        if c in df.columns: return pd.to_numeric(df[c], errors='coerce').fillna(-1e9)
    return pd.Series(np.zeros(len(df)))

def ev(pred, gt, ids):
    d=np.array([Lev.distance(p if p else FALLBACK, gt[i]) if i in gt else np.nan for p,i in zip(pred,ids)])
    m=~np.isnan(d)
    return float(np.nanmean(d)), float(np.nanmean(d==0)), int(m.sum())

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('cmd',choices=['eval','sub','merge'])
    ap.add_argument('--preds',nargs='+',required=True)
    ap.add_argument('--val',default=f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
    ap.add_argument('--out',default='')
    ap.add_argument('--limit',type=int,default=0)
    a=ap.parse_args()
    if a.cmd=='eval':
        gt=load_gt(a.val)
        for p in a.preds:
            df=pd.read_csv(p); pr=get_pred(df); cf=get_conf(df); ids=df.image_id.astype(str).tolist()
            have=np.array([i in gt for i in ids])
            if a.limit: 
                ids=ids[:a.limit]; pr=pr.iloc[:a.limit]; cf=cf.iloc[:a.limit]; have=have[:a.limit]
            d=np.array([Lev.distance(x if x else FALLBACK, gt[i]) for x,i in zip(pr,ids) if i in gt])
            print(f"{p}: n={len(d)} mean={d.mean():.3f} exact={(d==0).mean():.3f} invalid={(np.array([bool(x) for x in pr])==False).mean():.3f}")
            # threshold sweep using conf (higher=better); if conf is NLL (negative), higher still better after sign? detect
            for th in [-1.4,-1.2,-1.0,-0.8,-0.6,-0.4,-0.2,0.0]:
                preds=[(x if (c>=th and x) else FALLBACK) for x,c in zip(pr,cf)]
                dd=np.array([Lev.distance(x,gt[i]) for x,i in zip(preds,ids) if i in gt])
                print(f"  th={th:+.2f} mean={dd.mean():.3f}")
    elif a.cmd=='sub':
        ss=pd.read_csv(f'{ROOT}/data/sample_submission.csv'); ids=ss.image_id.astype(str).tolist()
        best={}; bestconf={}
        for p in a.preds:
            df=pd.read_csv(p); pr=get_pred(df); cf=get_conf(df); cols=df.image_id.astype(str)
            for i,x,c in zip(cols,pr,cf):
                if i not in bestconf or c>bestconf[i]:
                    bestconf[i]=c; best[i]=x if x else ''
        out=[]
        nfill=0
        for i in ids:
            x=best.get(i,'')
            if not x: x=FALLBACK; nfill+=1
            out.append(x)
        pd.DataFrame({'image_id':ids,'InChI':out}).to_csv(a.out,index=False)
        print(f"wrote {a.out} rows={len(ids)} fallback_filled={nfill} covered={len(best)}")
    elif a.cmd=='merge':
        pass

if __name__=='__main__': main()
