import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str))); ids=list(gt)
def load(f):
    d=pd.read_csv(f); ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    return {i:('' if str(x).strip() in ('','nan') or str(x).strip()==FB else str(x).strip(), float(c)) for i,x,c in zip(d.image_id.astype(str),d[ic].fillna(''),d['conf'])}
S={'iota':load('../regulus_iota/val_preds_final3000.csv'),'ms':load('preds_zeroshot_val3000.csv'),'r180':load('../regulus_iota/val_preds_final_rot3000.csv'),'last':load('tt_last_val.csv'),'omegaT':load('../regulus_omega/preds_val_final_tta_3000.csv'),'omega':load('../regulus_omega/preds_val_final_3000.csv'),'r90':load('tta_val_r90.csv'),'r270':load('tta_val_r270.csv')}
ci=np.array([S['iota'][i][1] for i in ids]); vi=np.array([bool(S['iota'][i][0]) for i in ids])
def medoid(c): return min(c,key=lambda a: sum(Lev.distance(a,b) for b in c))
def ev(names,f=0.05):
    th=np.quantile(ci[vi],f); pr={}
    for k,i in enumerate(ids):
        if not ((ci[k]<=th) or (not vi[k])): pr[i]=S['iota'][i][0] or FB; continue
        c=[S[n][i][0] for n in names if S[n][i][0]]; pr[i]=medoid(c) if c else FB
    d=np.array([Lev.distance((pr[i] or FB),gt[i]) for i in ids]); return d.mean(), d[0::2].mean(), d[1::2].mean()
base=['iota','last','ms','r180','omegaT']
for names in [base, base+['omega'], base+['r90'], base+['r270'], base+['omega','r90','r270'], ['iota','last','ms','r180','omegaT','omega']]:
    print('+'.join(names), [round(x,4) for x in ev(names)])
