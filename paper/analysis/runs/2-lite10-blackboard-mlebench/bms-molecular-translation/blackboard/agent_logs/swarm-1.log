import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str)))
def load(f, ic=None, cc=None):
    d=pd.read_csv(f); ic=ic or ([c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]); cc=cc or ('conf' if 'conf' in d.columns else [c for c in d.columns if 'conf' in c][0])
    out={}
    for i,x,c,val in zip(d.image_id.astype(str),d[ic].fillna(''),d[cc], d['valid'] if 'valid' in d.columns else [True]*len(d)):
        xs=str(x).strip(); 
        if xs in ('','nan') or xs==FB or not bool(val): out[i]=('',-1e9)
        else: out[i]=(xs,float(c))
    return out
S={'iota':load('../regulus_iota/val_preds_final3000.csv'),
   'omega':load('../regulus_omega/preds_val_final_3000.csv'),
   'omegaT':load('../regulus_omega/preds_val_final_tta_3000.csv'),
   'ms':load('preds_zeroshot_val3000.csv')}
ids=[i for i in gt]
def lev_of(pred,i): return Lev.distance(pred or FB, gt[i])
for name,d in S.items():
    print(name,'coverage',sum(1 for i in ids if d.get(i,('',0))[0])/len(ids))
# iota conf
ci=np.array([S['iota'].get(i,('',-1e9))[1] for i in ids])
vi=np.array([bool(S['iota'].get(i,('',-1e9))[0]) for i in ids])
di=np.array([lev_of(S['iota'].get(i,('',-1e9))[0],i) for i in ids])
print("iota base",di.mean())
for f in [0.03,0.05,0.06,0.08,0.10,0.15]:
    th=np.quantile(ci,1-f); route=(ci<=th)|(~vi); n=route.sum()
    print(f"\n--- routed f={route.mean():.3f} n={n} iota_on_route={di[route].mean():.2f}")
    cands={}
    for name,d in S.items():
        dd=np.array([lev_of(d.get(i,('',-1e9))[0],i) for i in ids])
        cands[name]=dd
        print(f"  {name} on route {dd[route].mean():.2f} (better frac {(dd[route]<di[route]).mean():.2f})")
    D=np.stack([cands[n] for n in S])
    print("  oracle min route",D[:,route].min(0).mean())
    # policy: for routed, pick candidate with highest conf among valid, else iota
    best=None
    for name in ['omega','omegaT','ms']:
        for t in [-1e9,-0.4,-0.2,0.0,0.5,0.8,0.9]:
            use=route & np.array([bool(S[name].get(i,('',0))[0]) and S[name].get(i,('',0))[1]>=t for i in ids])
            pred=np.where(use, cands[name], di)
            L=pred.mean()
            if best is None or L<best[0]: best=(L,name,t,use.sum())
    print("  best single-source routing",best)
