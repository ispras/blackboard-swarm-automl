import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str))); ids=list(gt)
def load(f):
    d=pd.read_csv(f); ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    out={}
    for i,x,c in zip(d.image_id.astype(str),d[ic].fillna(''),d['conf']):
        xs=str(x).strip(); out[i]=('' if xs in ('','nan') or xs==FB else xs, float(c))
    return out
S={'iota':load('../regulus_iota/val_preds_final3000.csv'),'ms':load('preds_zeroshot_val3000.csv'),
   'r180':load('../regulus_iota/val_preds_final_rot3000.csv'),'last':load('tt_last_val.csv')}
ci=np.array([S['iota'][i][1] for i in ids]); vi=np.array([bool(S['iota'][i][0]) for i in ids])
def medoid(c): return min(c,key=lambda a: sum(Lev.distance(a,b) for b in c))
def ev(pr): return np.mean([Lev.distance((pr[i] or FB),gt[i]) for i in ids])
def by_rule(fixed_th=None, f=None):
    th = fixed_th if fixed_th is not None else np.quantile(ci[vi],f)
    pr={}
    for k,i in enumerate(ids):
        routed=(ci[k]<=th) or (not vi[k])
        if not routed: pr[i]=S['iota'][i][0] or FB; continue
        c=[S[n][i][0] for n in ['iota','last','ms','r180'] if S[n][i][0]]
        pr[i]=medoid(c) if c else FB
    return pr
print("iota base", round(ev({i:S['iota'][i][0] or FB for i in ids}),4))
for th in [-0.109475,-0.107318,-0.11,-0.12]:
    print("medoid rule th",th,"routed",round(np.mean((ci<=th)|(~vi)),3),round(ev(by_rule(fixed_th=th)),4))
for f in [0.05,0.06,0.08,0.1,0.15,0.2]:
    print("medoid f",f,round(ev(by_rule(f=f)),4))
# iota's conservative rule for reference: invalid->ms, lowconf & ms conf>0.88 -> ms
def iota_rule(th=-0.109475,s=0.88):
    pr={}
    for k,i in enumerate(ids):
        a,ca=S['iota'][i]; m,cm=S['ms'][i]
        if not a: pr[i]=m or FB
        elif ci[k]<=th and m and cm>s: pr[i]=m
        else: pr[i]=a
    return pr
print("iota rule 0.88",round(ev(iota_rule()),4))
