import pandas as pd, numpy as np
from collections import Counter
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'; FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()
v=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').iloc[:3000]; gt=dict(zip(v.image_id.astype(str),v.InChI.astype(str))); ids=list(gt)
def load(f):
    d=pd.read_csv(f); ic=[c for c in ['inchi_from_smiles','inchi','InChI'] if c in d.columns][0]
    out={}
    for i,x,c in zip(d.image_id.astype(str),d[ic].fillna(''),d['conf']):
        xs=str(x).strip(); out[i]=('' if xs in ('','nan') or xs==FB else xs, float(c))
    return out
S={'iota':load('../regulus_iota/val_preds_final3000.csv'),'omega':load('../regulus_omega/preds_val_final_3000.csv'),
   'omegaT':load('../regulus_omega/preds_val_final_tta_3000.csv'),'ms':load('preds_zeroshot_val3000.csv'),
   'r90':load('tta_val_r90.csv'),'r180':load('../regulus_iota/val_preds_final_rot3000.csv'),'r270':load('tta_val_r270.csv'),'last':load('tt_last_val.csv')}
D={n:np.array([Lev.distance((S[n][i][0] or FB), gt[i]) for i in ids]) for n in S}
for n in S: print(n, round(D[n].mean(),4))
# 1) best/last max conf
def sel_max(names, ids_sub):
    out=[]
    for i in ids_sub:
        best=None
        for n in names:
            p,c=S[n][i]
            if not p: continue
            if best is None or c>best[1]: best=(p,c,n)
        out.append(best[0] if best else FB)
    return out
def ev(preds, ids_sub): return np.mean([Lev.distance(p,gt[i]) for p,i in zip(preds,ids_sub)])
print("iota+last maxconf", round(ev(sel_max(['iota','last'],ids),ids),4))
# agreement-based best/last
pred=[]
for i in ids:
    a,ca=S['iota'][i]; b,cb=S['last'][i]
    if a and b and a==b: pred.append(a)
    elif not a: pred.append(b or FB)
    elif not b: pred.append(a)
    else: pred.append(a if ca>=cb else b)
print("iota+last agree+conf", round(ev(pred,ids),4))
# 2) vote based on routed subset, params: route fraction f, min votes v
ci=np.array([S['iota'][i][1] for i in ids]); vi=np.array([bool(S['iota'][i][0]) for i in ids])
def vote_policy(f, vmin, names, use_routed=True):
    th=np.quantile(ci[vi],f) if f>0 else -1e9
    out=[]
    for k,i in enumerate(ids):
        routed=(ci[k]<=th) or (not vi[k])
        if (not routed) or (not use_routed):
            out.append(S['iota'][i][0] or FB); continue
        c=Counter(); bestconf={}
        for n in names:
            p,cf=S[n][i]
            if p: c[p]+=1; bestconf[p]=max(bestconf.get(p,-1e9),cf)
        if not c: out.append(FB); continue
        p,cnt=c.most_common(1)[0]
        if cnt>=vmin and (p!=S['iota'][i][0] or cnt>=2): out.append(p)
        else: out.append(S['iota'][i][0] or FB)
    return out
for names in [['iota','last'],['iota','last','omega','omegaT','ms','r180'],['iota','last','ms','omegaT','r180']]:
    for f in [0.05,0.08,0.10,0.15]:
        for vmin in [2,3]:
            print("vote",'+'.join(names),f,vmin, round(ev(vote_policy(f,vmin,names),ids),4))
