    th=np.quantile(ci[vi],f) if vi.sum() else 0
    route=(ci<=th)|(~vi); 
    print(f"\n--- f={f:.2f} routed={route.mean():.3f} n={route.sum()} iota_route={di[route].mean():.2f} rest={di[~route].mean():.3f}")
    for name in S:
        print(f"   {name}: route {D[name][route].mean():.2f}, better_fraction {(D[name][route]<di[route]).mean():.2f}")
    print(f"   oracle route {np.stack([D[n][route] for n in S]).min(0).mean():.2f}")
    # choose candidate by confidence threshold per source, priority by best val performance on route
    best=(9,None)
    for name in ['omegaT','omega','ms']:
        conf=np.array([S[name].get(i,('',-1e9))[1] for i in ids]); valid=np.array([bool(S[name].get(i,('',-1e9))[0]) for i in ids])
        for t in np.quantile(conf[np.isfinite(conf)], [0,0.1,0.3,0.5,0.7,0.9,0.95]):
            use=route&valid&(conf>=t); pred=np.where(use,D[name],di); L=pred.mean()
            if L<best[0]: best=(L,name,float(t),int(use.sum()))
    print("   best single-source route:",best)
