th=np.quantile(ci[vi],0.08); routed=[(k,i) for k,i in enumerate(ids) if (ci[k]<=th) or (not vi[k])]
print("routed",len(routed))
base_sum=sum(Lev.distance(C['iota'][i] or FB,gt[i]) for k,i in enumerate(ids) if not ((ci[k]<=th) or (not vi[k])))
def score(names):
    tot=base_sum
    for k,i in routed:
        cs=[C[n][i] for n in ['iota']+names if C[n][i]]
        p=min(cs,key=lambda a: sum(Lev.distance(a,b) for b in cs)) if cs else FB
        tot+=Lev.distance(p or FB,gt[i])
    return tot/len(ids)
extra=['old','rot','omT','ms','last','p4']
res=[]
