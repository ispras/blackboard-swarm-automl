from rdkit import Chem, RDLogger
from rdkit.Chem import inchi
RDLogger.DisableLog('rdApp.*')
from molscribe import MolScribe
from molscribe.dataset import CropWhite
import albumentations as A
from albumentations.pytorch import ToTensorV2

ckpt='hf/models--yujieq--MolScribe/snapshots/a0189776b7415b82795c7ee81eed311bf5c8724b/swin_base_char_aux_1m.pth'
model=MolScribe(model_path=ckpt, device=torch.device('cuda'))

def make_tf(letterbox=False):
    tl=[CropWhite(pad=5)]
    if letterbox:
        tl.append(A.PadIfNeeded(min_height=384,min_width=384,border_mode=cv2.BORDER_CONSTANT,value=(255,255,255)))
        tl.append(A.LongestMaxSize(max_size=384))
        tl.append(A.PadIfNeeded(min_height=384,min_width=384,border_mode=cv2.BORDER_CONSTANT,value=(255,255,255)))
    else:
        tl.append(A.Resize(384,384))
    tl += [A.ToGray(p=1),A.Normalize(mean=[0.485,0.456,0.406],std=[0.229,0.224,0.225]),ToTensorV2()]
    return A.Compose(tl, keypoint_params=A.KeypointParams(format='xy', remove_invisible=False))

def lev(a,b):
    if a==b: return 0
    if len(a)<len(b): a,b=b,a
    prev=list(range(len(b)+1))
    for i,ca in enumerate(a,1):
        cur=[i]+[0]*len(b)
        for j,cb in enumerate(b,1):
            cur[j]=min(prev[j]+1,cur[j-1]+1,prev[j-1]+(ca!=cb))
        prev=cur
    return prev[-1]

