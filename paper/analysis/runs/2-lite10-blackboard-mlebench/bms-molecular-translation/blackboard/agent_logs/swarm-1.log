import os,sys,time,argparse,json,multiprocessing as mp
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_omega/pkgs')
import numpy as np,pandas as pd,cv2,torch
from rdkit import Chem,RDLogger
RDLogger.DisableLog('rdApp.*')
from molscribe.model import Encoder,Decoder
from molscribe.tokenizer import Tokenizer,SOS_ID,EOS_ID,PAD_ID
from train_smiles import SmiTok,load_model,DS,PKG,ROOT,CONST
from torch.utils.data import Dataset,DataLoader

def to_inchi(s):
    if not s: return None
    try:
        m=Chem.MolFromSmiles(s)
        if m is None: return None
        v=Chem.MolToInchi(m)
        return v if v else None
    except Exception: return None

def _to_inchi_wrap(args):
    return to_inchi(args)

def batch_conf(dec,feats,labs,device):
    with torch.autocast('cuda',dtype=torch.bfloat16):
        logits,labels,_=dec.decoder['atomtok'](feats,labs,None)
        lp=torch.log_softmax(logits.float(),dim=-1)
    m=labels!=PAD_ID
    gathered=lp.gather(2,labels.unsqueeze(-1)).squeeze(-1)
    conf=(gathered*m).sum(1)/m.sum(1).clamp(min=1)
    return conf.cpu().tolist()

class PathDS(Dataset):
    def __init__(self,paths,size,rot=0):
        self.paths=paths; self.ds=DS(paths,['']*len(paths),size); self.rot=rot
    def __len__(self): return len(self.paths)
    def __getitem__(self,i):
        img=cv2.imread(self.paths[i],cv2.IMREAD_GRAYSCALE)
        if self.rot: img=cv2.rotate(img,cv2.ROTATE_180)
        return torch.from_numpy(self.ds.prep(img))

@torch.no_grad()
def run(enc,dec,tok,paths,size,device,bs=128,compute_conf=True,log_every=10,workers=16,rot=0):
    enc.eval(); dec.eval(); res=[]; confs=[]
    dl=DataLoader(PathDS(paths,size,rot),batch_size=bs,shuffle=False,num_workers=workers,pin_memory=True,
                  collate_fn=lambda b: torch.stack(b),prefetch_factor=4)
    t0=time.time(); done=0
    for imgs in dl:
        imgs=imgs.to(device,non_blocking=True)
        with torch.autocast('cuda',dtype=torch.bfloat16):
            feats,_=enc(imgs); outs=dec.decode(feats,beam_size=1)
        smis=[o['atomtok']['smiles'] for o in outs]
        if compute_conf:
            labs=[[SOS_ID]+[tok.stoi.get(c,3) for c in s]+[EOS_ID] for s in smis]
            ml=max(len(x) for x in labs)
            lt=torch.full((len(labs),ml),PAD_ID,dtype=torch.long)
            for j,x in enumerate(labs): lt[j,:len(x)]=torch.tensor(x)
            confs+=batch_conf(dec,feats,lt.to(device),device)
        res+=smis; done+=len(smis)
        if (done//bs)%log_every==0:
            el=time.time()-t0
            print(f"infer {done}/{len(paths)} {done/el:.1f} img/s elapsed {el/60:.1f}m",flush=True)
    return res,confs

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ckpt',required=True); ap.add_argument('--size',type=int,default=256)
    ap.add_argument('--split',type=str,default='test',choices=['test','val','train_sample','ids'])
    ap.add_argument('--ids_csv',type=str,default=None)
    ap.add_argument('--limit',type=int,default=0); ap.add_argument('--bs',type=int,default=256)
    ap.add_argument('--out',type=str,required=True); ap.add_argument('--nproc',type=int,default=24)
    ap.add_argument('--no_conf',action='store_true')
    ap.add_argument('--maxlen',type=int,default=160)
    ap.add_argument('--tta',action='store_true'); ap.add_argument('--shard',type=str,default='0/1')
    ap.add_argument('--model_name',type=str,default='omega_ft')
    a=ap.parse_args()
    import molscribe.utils as MU
    MU.FORMAT_INFO['atomtok']['max_len']=a.maxlen
    import molscribe.model as MM
    MM.FORMAT_INFO['atomtok']['max_len']=a.maxlen
    device='cuda'
    tok=SmiTok(f'{PKG}/molscribe/vocab/vocab_chars.json')
    enc,dec,args,_=load_model(f'{ROOT}/workspaces/regulus_omega/ckpts/swin_base_char_aux_1m680k.pth',device,tok)
    st=torch.load(a.ckpt,map_location='cpu'); enc.load_state_dict(st['enc']); dec.load_state_dict(st['dec'])
    print('loaded',a.ckpt,'ckpt_size',st.get('size'),'val',st.get('val'),flush=True)
    if a.split=='ids':
        ids=pd.read_csv(a.ids_csv).image_id.tolist()
        paths=[f'{ROOT}/data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png' for i in ids]
        vm=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv').set_index('image_id').InChI
        targets=[vm.get(i,CONST) for i in ids]
    elif a.split=='test':
        ids=pd.read_csv(f'{ROOT}/data/sample_submission.csv').image_id.tolist()
        paths=[f'{ROOT}/data/test/{i[0]}/{i[1]}/{i[2]}/{i}.png' for i in ids]
        targets=None
    else:
        va=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
        if a.split=='val':
            ids=va.image_id.tolist(); targets=va.InChI.tolist()
        else:
            ids=va.image_id.tolist()[:2000]; targets=va.InChI.tolist()[:2000]
        paths=[f'{ROOT}/data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png' for i in ids]
    sh_i,sh_n=map(int,a.shard.split('/'))
    idx=list(range(len(paths)))
    if sh_n>1: idx=idx[sh_i::sh_n]
    if a.limit: idx=idx[:a.limit]
    paths=[paths[j] for j in idx]; ids=[ids[j] for j in idx]
    if targets is not None: targets=[targets[j] for j in idx]
    t=time.time()
    smis,confs=run(enc,dec,tok,paths,a.size,device,a.bs,not a.no_conf,log_every=2)
    if a.tta:
        t1=time.time(); smis2,confs2=run(enc,dec,tok,paths,a.size,device,a.bs,not a.no_conf,log_every=2,rot=180)
        print('tta pass',time.time()-t1,'s',flush=True)
        for i in range(len(smis)):
            if confs2[i]>confs[i]: smis[i]=smis2[i]; confs[i]=confs2[i]
    print('infer total',time.time()-t,'s',len(smis)/(time.time()-t),'img/s',flush=True)
    with mp.Pool(a.nproc) as p: inchis=p.map(_to_inchi_wrap,smis,chunksize=256)
    print('rdkit convert',time.time()-t,flush=True)
    fin=[x if x else CONST for x in inchis]
    df=pd.DataFrame({'image_id':ids,'smiles':smis,'inchi':fin,'inchi_from_smiles':fin,'conf':confs if confs else [0.0]*len(fin),'valid':[x is not None for x in inchis],'model':a.model_name})
    df.to_csv(a.out,index=False)
    print('wrote',a.out,len(df),'invalid',sum(x is None for x in inchis),flush=True)
    if targets is not None:
        from rapidfuzz.distance import Levenshtein
        d=[Levenshtein.distance(x,y) for x,y in zip(fin,targets)]
        print(f"EVAL meanLev {np.mean(d):.4f} exact {np.mean([x==0 for x in d]):.4f}",flush=True)

if __name__=='__main__': main()
