import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
FB=open('baseline_constant.txt').read().strip()
val=pd.read_csv('val_20k.csv')[['image_id','InChI']].head(3000)
def rd(p):
    d=pd.read_csv(p); d['inchi_from_smiles']=d['inchi_from_smiles'].fillna('').astype(str); return d
p3=rd('val_preds_phase3_ckpt_best_3000.csv'); p4=rd('val_preds_phase4_3000.csv')
m=val.merge(p3[['image_id','inchi_from_smiles','conf','valid']].rename(columns={'inchi_from_smiles':'p3','conf':'p3conf','valid':'p3valid'}),on='image_id')
m=m.merge(p4[['image_id','inchi_from_smiles','conf','valid']].rename(columns={'inchi_from_smiles':'p4','conf':'p4conf','valid':'p4valid'}),on='image_id')
for c in ['p3','p4']: m[c]=m[c].fillna('').astype(str)
m['p3valid']=m.p3valid.fillna(False).astype(bool); m['p4valid']=m.p4valid.fillna(False).astype(bool)
thr=float(np.quantile(m.p3conf,0.08))
routed=((~m.p3valid)|(m.p3conf<=thr)).values
m['l3']=[Lev.distance(x if x else FB,y) for x,y in zip(m.p3,m.InChI)]
m['l4']=[Lev.distance(x if x else FB,y) for x,y in zip(m.p4,m.InChI)]
for name,mask in [('routed',routed),('nonrouted',~routed),('all',np.ones(len(m),bool))]:
    s=m[mask]
    print(f'{name}: n={len(s)} p3={s.l3.mean():.4f} p4={s.l4.mean():.4f} diff(p4-p3)={(s.l4-s.l3).mean():.4f} p4_win={(s.l4<s.l3).mean():.3f} p3_win={(s.l4>s.l3).mean():.3f}')
# nonrouted where they differ
s=m[(~routed)&(m.p3!=m.p4)]
print('nonrouted disagree n',len(s),'p3',round(s.l3.mean(),3),'p4',round(s.l4.mean(),3),'p4 better frac',(s.l4<s.l3).mean())
# choose p4 on nonrouted, keep p3 on routed (hybrid) vs base p3
hyb=np.where(routed, m.p3, m.p4)
lev_h=np.mean([Lev.distance(x if x else FB,y) for x,y in zip(hyb,m.InChI)])
print('hybrid p4-nonrouted/p3-routed lev',round(lev_h,4),'p3 base',round(m.l3.mean(),4))
# also choose higher conf on nonrouted
ch=np.where(~routed, np.where(m.p4conf>m.p3conf,m.p4,m.p3), m.p3)
lev_c=np.mean([Lev.distance(x if x else FB,y) for x,y in zip(ch,m.InChI)])
print('conf-pick on nonrouted lev',round(lev_c,4))
