import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
FB=open('baseline_constant.txt').read().strip()
val=pd.read_csv('val_20k.csv')[['image_id','InChI']]
for name,path,n in [('best_3000','val_preds_final3000.csv',3000),('last_1000','val_preds_final_last1000.csv',1000)]:
    d=pd.read_csv(path); d['inchi_from_smiles']=d['inchi_from_smiles'].fillna('').astype(str)
    m=val.head(n).merge(d,on='image_id')
    m['lev']=[Lev.distance(a if a else FB,b) for a,b in zip(m.inchi_from_smiles,m.InChI)]
    print(name,'n',len(m),'lev',round(m.lev.mean(),3),'exact',round((m.lev==0).mean(),3),'invalid',round((m.inchi_from_smiles=='').mean(),4),'median',m.lev.median())
# best on first 1000 as well
d=pd.read_csv('val_preds_final3000.csv'); d['inchi_from_smiles']=d['inchi_from_smiles'].fillna('').astype(str)
m=val.head(1000).merge(d,on='image_id'); m['lev']=[Lev.distance(a if a else FB,b) for a,b in zip(m.inchi_from_smiles,m.InChI)]
print('best_1000 lev',round(m.lev.mean(),3),'exact',round((m.lev==0).mean(),3),'invalid',round((m.inchi_from_smiles=='').mean(),4))
# confidence routing tail analysis
m['conf']=pd.read_csv('val_preds_final3000.csv').head(1000)['conf']
mm=m.sort_values('conf').reset_index(drop=True)
for f in [0.05,0.1,0.15,0.2,0.25]:
    k=int(len(mm)*f); print(f'worst {f}: lev {mm.iloc[:k].lev.mean():.2f} rest {mm.iloc[k:].lev.mean():.2f}')
