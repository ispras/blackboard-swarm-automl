        psum=sum(Lev.distance(pv,o) for o in cs) if pv in cs else None
        bi=int(np.argmin(sums))
        if margin>0 and 'inchi_from_smiles' in names and pv in cs:
            pi=cs.index(pv)
            if sums[pi]-sums[bi] < margin: bi=pi
        out.append(cs[bi])
    return out
