import os, time, random, json
import torch, pandas as pd, numpy as np, cv2
from rdkit import Chem, RDLogger
from rdkit.Chem import inchi
RDLogger.DisableLog('rdApp.*')
from molscribe import MolScribe

def lev(a,b):
    if a==b: return 0
    if len(a)<len(b): a,b=b,a
    prev=list(range(len(b)+1))
    for i,ca in enumerate(a,1):
        cur=[i]+[0]*len(b)
        for j,cb in enumerate(b,1):
            cur[j]=min(prev[j]+1,cur[j-1]+1,prev[j-1]+(ca!=cb))
        prev=cur
    return prev[-1]

ckpt='hf/models--yujieq--MolScribe/snapshots/a0189776b7415b82795c7ee81eed311bf5c8724b/swin_base_char_aux_1m.pth'
dev=torch.device('cuda')
model=MolScribe(model_path=ckpt, device=dev)
print("model loaded", flush=True)
df=pd.read_csv('/download_job_code/payload/sandbox/data/train_labels.csv', nrows=300000)
