import pandas as pd, numpy as np
from rdkit import Chem, RDLogger
from rdkit.Chem import inchi as rdinchi
from rdkit.Chem import rdmolops
RDLogger.DisableLog('rdApp.*')
from rapidfuzz.distance import Levenshtein as Lev
FB=open('baseline_constant.txt').read().strip()
val=pd.read_csv('val_20k.csv')[['image_id','InChI']].head(1000)
d=pd.read_csv('val_preds_6k.csv')
m=val.merge(d,on='image_id')
bad=m[m.inchi_from_smiles==FB].copy()
print('n bad', len(bad))
def rec(smi, mode):
    try:
        if mode=='lax':
            mol=Chem.MolFromSmiles(smi, sanitize=False)
            if mol is None: return None
            try: Chem.SanitizeMol(mol, Chem.SanitizeFlags.SANITIZE_ALL ^ Chem.SanitizeFlags.SANITIZE_PROPERTIES, catchErrors=True)
            except Exception: pass
            return rdinchi.MolToInchi(mol) or None
        if mode=='nosan':
            mol=Chem.MolFromSmiles(smi, sanitize=False)
            if mol is None: return None
            try: return rdinchi.MolToInchi(mol) or None
            except Exception: return None
        if mode=='removeatoms':
            # remove atoms with valence problems iteratively
            mol=Chem.MolFromSmiles(smi, sanitize=False)
            if mol is None: return None
            try:
                Chem.SanitizeMol(mol)
                return rdinchi.MolToInchi(mol) or None
            except Exception:
                return None
    except Exception:
        return None
for mode in ['lax','nosan']:
    outs=[rec(s,mode) for s in bad.smiles]
    ok=sum(x is not None for x in outs)
    levs=[]
    for x,gt in zip(outs,bad.InChI):
        levs.append(Lev.distance(x if x else FB, gt))
    print(mode,'recovered',ok,'/',len(bad),'mean lev on bad',np.mean(levs),'vs fallback',np.mean([Lev.distance(FB,g) for g in bad.InChI]))
print('sample bad smiles:')
for s in bad.smiles.head(6): print(repr(s)[:120])
