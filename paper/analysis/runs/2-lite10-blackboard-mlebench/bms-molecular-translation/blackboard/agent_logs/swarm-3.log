import os, argparse, numpy as np, pandas as pd
from rapidfuzz.distance import Levenshtein as Lev
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.model_selection import GroupKFold
ROOT='/download_job_code/payload/sandbox'
FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def load_pred(path, name):
    d=pd.read_csv(path)
    col='inchi' if 'inchi' in d.columns else ('inchi_from_smiles' if 'inchi_from_smiles' in d.columns else 'InChI_pred')
    s=d[col].fillna('').astype(str).replace('nan','')
    if 'valid' in d.columns:
        valid=d['valid'].fillna(False).astype(bool).values
    else:
        valid=(s!='').values & (s!=FB).values
    s=np.where(valid & (s!=FB) & (s!=''), s, '')
    out=pd.DataFrame({'image_id':d.image_id.astype(str)})
    out[name]=s
    out[name+'_valid']=np.asarray(s!='',dtype=bool)
    conf=d['conf'] if 'conf' in d.columns else (d['confidence'] if 'confidence' in d.columns else pd.Series(np.zeros(len(d))))
    out[name+'_conf']=conf.astype(float).values
    return out

def feat(inchi, conf, valid, src, others, size, ns):
    L=len(inchi) if valid else 0
    levs=[Lev.distance(inchi,o)/max(1,max(len(inchi),len(o))) for o in others if o]
    agree=[1.0 if inchi==o else 0.0 for o in others if o]
    f=[conf,float(valid),L,(L-121.)/50.,((L-121.)/50.)**2, inchi.count('/'),inchi.count('('),inchi.count('.'),
       1.0 if (valid and inchi.startswith('InChI=1S/')) else 0.0,
       min(levs) if levs else 1.0, float(np.mean(levs)) if levs else 1.0,
       max(agree) if agree else 0.0, sum(agree) if agree else 0.0, float(np.log1p(size))]
    f += [1.0 if src==i else 0.0 for i in range(ns)]
    return f

def build_rows(recs, names, sizes, ns):
    X=[]; y=[]; g=[]
    for i,r in enumerate(recs):
        vals=[r[n] if r.get(n+'_valid',False) else '' for n in names]
        cand=[r[n] if r.get(n+'_valid',False) else FB for n in names]
        for si,n in enumerate(names):
            others=[c for j,c in enumerate(vals) if j!=si and c]
            X.append(feat(cand[si], r[n+'_conf'], r.get(n+'_valid',False), si, others, sizes[i], ns))
            y.append(Lev.distance(cand[si], r['gt'])); g.append(i)
        others=[c for c in vals if c]
        X.append(feat(FB, -5.0, True, len(names), others, sizes[i], ns)); y.append(Lev.distance(FB,r['gt'])); g.append(i)
    return np.array(X,np.float32), np.array(y,np.float32), np.array(g)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--val_sources', nargs='+', required=True)
    ap.add_argument('--test_iota', required=True)
    ap.add_argument('--test_sources', nargs='+', default=[])
    ap.add_argument('--out', default=f'{ROOT}/workspaces/regulus_iota/submission_assemble.csv')
    a=ap.parse_args()
    gt=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv')[['image_id','InChI']]
    names=[]; frames=[]
    for spec in a.val_sources:
        n,p=spec.split(':',1); names.append(n); frames.append(load_pred(p,n))
    m=gt.copy()
    for f in frames: m=m.merge(f,on='image_id',how='inner')
    sizes=[]
    for iid in m.image_id:
        p=f'{ROOT}/data/train/{iid[0]}/{iid[1]}/{iid[2]}/{iid}.png'
        try: sizes.append(os.path.getsize(p))
        except: sizes.append(0)
    recs=m.to_dict('records')
    for r,g in zip(recs,m.InChI): r['gt']=g
    X,y,gg=build_rows(recs,names,sizes,len(names)+1)
    print('calib images',len(m),'rows',X.shape,'sources',names,flush=True)
    # CV
    oof=np.zeros(len(y))
    for tr,te in GroupKFold(n_splits=5).split(X,y,gg):
        reg=HistGradientBoostingRegressor(max_iter=400,learning_rate=0.05,max_depth=6,min_samples_leaf=25,l2_regularization=1.0)
        reg.fit(X[tr],y[tr]); oof[te]=reg.predict(X[te])
    best={}
    for r,i in enumerate(gg):
        if i not in best or oof[r]<oof[best[i]]: best[i]=r
    def pick(r, si):
        if si<len(names): return m[names[si]].iloc[r] if m[names[si]+'_valid'].iloc[r] else FB
        return FB
    pred=[pick(i,best[i]% (len(names)+1)) for i in range(len(m))]
    print('CV full val lev',float(np.mean([Lev.distance(p,t) for p,t in zip(pred,m.InChI)])),flush=True)
    # routed simulation: rerank only bottom f by primary conf union invalid
    prim=names[0]; ic=m[prim+'_conf'].values; iv=m[prim+'_valid'].values
    order=np.argsort(ic)
    for f in [0.15,0.20,0.25,0.30]:
        k=int(len(m)*f); routed=set(order[:k].tolist()) | set(np.flatnonzero(~iv).tolist())
        pr=[pick(i,best[i]%(len(names)+1)) if i in routed else (pick(i,0) if iv[i] else FB) for i in range(len(m))]
        print(f'route {f:.2f} n={len(routed)} lev {np.mean([Lev.distance(p,t) for p,t in zip(pr,m.InChI)]):.3f}',flush=True)
    # fit full
    reg=HistGradientBoostingRegressor(max_iter=400,learning_rate=0.05,max_depth=6,min_samples_leaf=25,l2_regularization=1.0)
    reg.fit(X,y)
    # test
    iota=load_pred(a.test_iota,'primary')
    t=iota
    test_names=['primary']
    src_names=set()
    for spec in a.test_sources:
        n,p=spec.split(':',1); f=load_pred(p,n); src_names.add(n)
        t=t.merge(f,on='image_id',how='left'); test_names.append(n)
    allnames=names  # model source names used at fit: primary + cascade names as in val (first is primary)
    # align: val names[0] is primary; others must match test source names
    use_names=[names[0]]+[n for n in names[1:] if n in src_names]
    ns=len(names)+1
    out=[]
    for r in t.itertuples():
        rec={'gt':None}
        # primary
        p_inchi=getattr(r,'primary'); p_valid=getattr(r,'primary_valid'); p_conf=getattr(r,'primary_conf')
        present=[(names[0],p_inchi,p_valid,p_conf)]
        for n in names[1:]:
            if n in src_names:
                v=getattr(r,n+'_valid',np.nan)
                if pd.isna(v): v=False
                inchi=getattr(r,n,FB)
                if pd.isna(inchi) or inchi=='nan': inchi=''
                inchi=inchi if (v and inchi) else ''
                conf=getattr(r,n+'_conf',-5.0); conf=(-5.0 if pd.isna(conf) else conf)
                present.append((n,inchi,bool(v),conf))
        routed = any(n in src_names and bool(getattr(r,n+'_valid',False)) for n in names[1:]) or (not bool(p_valid))
        if routed:
            vals=[x[1] if x[2] else '' for x in present]
            cands=[x[1] if x[2] else FB for x in present]
            others=[c for c in vals if c]
            iid=r.image_id
            try: sz=os.path.getsize(f'{ROOT}/data/test/{iid[0]}/{iid[1]}/{iid[2]}/{iid}.png')
            except: sz=0
            rows=[]
            for si,(n,inchi,valid,conf) in enumerate(present):
                oo=[c for j,c in enumerate(vals) if j!=si and c]
                rows.append(feat(cands[si],conf,valid,si,oo,sz,ns))
            oo=others
            rows.append(feat(FB,-5.0,True,len(names),oo,sz,ns))
            pr=reg.predict(np.array(rows,np.float32))
            bi=int(np.argmin(pr))
            out.append((iid, cands[bi] if bi<len(cands) else FB))
        else:
            out.append((r.image_id, p_inchi if p_valid and p_inchi else FB))
    df=pd.DataFrame(out,columns=['image_id','InChI'])
    df.to_csv(a.out,index=False)
    print('wrote',a.out,len(df),'dupes',df.image_id.duplicated().sum(),flush=True)

if __name__=='__main__': main()
