import sys, torch, argparse
p=argparse.ArgumentParser(); p.add_argument('ckpts', nargs='+'); p.add_argument('--out', required=True); a=p.parse_args()
cks=[torch.load(c, map_location='cpu') for c in a.ckpts]
base=cks[-1]
avg={k:torch.zeros_like(v, dtype=torch.float32) for k,v in base['model'].items()}
for c in cks:
    for k,v in c['model'].items():
        avg[k]+=v.float()
for k in avg: avg[k]/=len(cks)
out={'model':avg,'step':base.get('step'),'args':base.get('args'),'best':min(c.get('best',1e9) for c in cks)}
torch.save(out,a.out)
print('saved',a.out,'from',len(cks),'ckpts step',out['step'])
EOF
