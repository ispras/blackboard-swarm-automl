        pv=r.inchi_from_smiles
        if not routed[i]: out.append(pv if pv else FB); continue
        cs=[]; ww=[]
        for j,n in enumerate(names):
            v=getattr(r,n)
            if v:
                cs.append(v); ww.append(1.0 if w is None else (w if j==0 else 1.0))
        if not cs: out.append(FB); continue
        # weighted sums
        sums=[sum(ww[k]*Lev.distance(c,o) for k,o in enumerate(cs)) for c in cs]
