import argparse, numpy as np, pandas as pd, sys, os
from rapidfuzz.distance import Levenshtein as Lev
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.model_selection import GroupKFold
ROOT='/download_job_code/payload/sandbox'
FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def load_pred(path, name):
    d=pd.read_csv(path)
    col='inchi' if 'inchi' in d.columns else ('inchi_from_smiles' if 'inchi_from_smiles' in d.columns else 'InChI_pred')
    out=pd.DataFrame({'image_id':d.image_id})
    s=d[col].fillna('').astype(str).replace('nan','')
    if 'valid' in d.columns:
        valid=d['valid'].astype(bool).values
    else:
        valid=(s!='').values
    s=np.where(valid & (s!=FB), s, '')
    out[name]=s; out[name+'_valid']=(s!='').values
    c=d['conf'] if 'conf' in d.columns else (d['confidence'] if 'confidence' in d.columns else pd.Series(np.zeros(len(d))))
    out[name+'_conf']=c.astype(float).values
    return out

def feat_row(inchi, conf, valid, srcidx, others, imgsize, ns):
    L=len(inchi) if valid else 0
    levs=[Lev.distance(inchi,o)/max(1,max(len(inchi),len(o))) for o in others if o]
    agree=[1.0 if inchi==o else 0.0 for o in others if o]
    f=[conf, float(valid), L, (L-121.0)/50.0, ((L-121.0)/50.0)**2,
       inchi.count('/'), inchi.count('('), inchi.count('.'),
       1.0 if (valid and inchi.startswith('InChI=1S/')) else 0.0,
       min(levs) if levs else 1.0, np.mean(levs) if levs else 1.0,
       max(agree) if agree else 0.0, sum(agree) if agree else 0.0,
       float(np.log1p(imgsize)) if imgsize else 0.0]
    f += [1.0 if srcidx==i else 0.0 for i in range(ns)]
    return f

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--val_preds', nargs='+', required=True)
    ap.add_argument('--test_preds', nargs='+', default=[])
    ap.add_argument('--out', default='')
    ap.add_argument('--cv', type=int, default=5)
    a=ap.parse_args()
    gt=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv')[['image_id','InChI']]
    frames=[]; names=[]
    for spec in a.val_preds:
        n,p=spec.split(':',1); names.append(n); frames.append(load_pred(p,n))
    m=gt
    for f in frames: m=m.merge(f,on='image_id',how='inner')
    # image size proxy: use InChI len? use file size via os.stat (val train images)
    sizes=[]
    for iid in m.image_id:
        p=f'{ROOT}/data/train/{iid[0]}/{iid[1]}/{iid[2]}/{iid}.png'
        try: sizes.append(os.path.getsize(p))
        except: sizes.append(0)
    m['imgsize']=sizes
    N=len(m); ns=len(names)
    print('val images',N,'sources',names)
    for n in names:
        print(f'{n}: lev {np.mean([Lev.distance(x,y) for x,y in zip(m[n],m.InChI)]):.3f} valid {m[n+'_valid'].mean():.3f}')
    incl=[FB]*0  # placeholder
    src_list=names+['fallback']
    rows=[]; targets=[]; groups=[]
    for i in range(N):
        cands=[m[n].iloc[i] for n in names]
        for si,n in enumerate(names):
            inchi=m[n].iloc[i]; valid=m[n+'_valid'].iloc[i]; conf=m[n+'_conf'].iloc[i]
            others=[c for j,c in enumerate(cands) if j!=si and c]
            if not valid: inchi=''
            rows.append(feat_row(inchi, conf, valid, si, others, m.imgsize.iloc[i], len(src_list)))
            targets.append(Lev.distance(inchi if valid else FB, m.InChI.iloc[i]))
            groups.append(i)
        # fallback candidate
        others=[c for c in cands if c]
        rows.append(feat_row(FB, -5.0, True, len(names), others, m.imgsize.iloc[i], len(src_list)))
        targets.append(Lev.distance(FB, m.InChI.iloc[i])); groups.append(i)
    X=np.array(rows,dtype=np.float32); y=np.array(targets,dtype=np.float32); g=np.array(groups)
    print('rows',X.shape)
    # CV
    oof=np.zeros(len(y))
    gkf=GroupKFold(n_splits=a.cv)
    for tr,te in gkf.split(X,y,g):
        reg=HistGradientBoostingRegressor(max_iter=300,learning_rate=0.06,max_depth=6,min_samples_leaf=30,l2_regularization=1.0)
        reg.fit(X[tr],y[tr]); oof[te]=reg.predict(X[te])
    # selection
    best_idx={}
    for r,gg in enumerate(g): 
        if gg not in best_idx or oof[r]<oof[best_idx[gg]]: best_idx[gg]=r
    def cand_str(row_idx, si):
        if si<len(names): 
            v=m[names[si]].iloc[row_idx]; ok=m[names[si]+'_valid'].iloc[row_idx]
            return v if ok else FB
        return FB
    preds=[cand_str(i,best_idx[i]) for i in range(N)]
    levs=[Lev.distance(p,t) for p,t in zip(preds,m.InChI)]
    print('CV reranker lev',float(np.mean(levs)))
    # oracle over sources+fallback
    orc=[]
    for i in range(N):
        cs=[cand_str(i,si) for si in range(len(src_list))]
        orc.append(min(Lev.distance(c,m.InChI.iloc[i]) for c in cs))
    print('oracle',float(np.mean(orc)))
    import collections
    cnt=collections.Counter(best_idx.values())
    print('selection row-idx mod', {k:v for k,v in collections.Counter([ best_idx[i]//len(src_list) for i in range(N)]).items()})
    # fit full and apply test
    if a.test_preds and a.out:
        reg=HistGradientBoostingRegressor(max_iter=300,learning_rate=0.06,max_depth=6,min_samples_leaf=30,l2_regularization=1.0)
        reg.fit(X,y)
        tfs=[]
        for spec in a.test_preds:
            n,p=spec.split(':',1); tfs.append(load_pred(p,n))
        t=tfs[0]
        for f in tfs[1:]: t=t.merge(f,on='image_id',how='outer')
        # need sizes for test images
        out=[]
        for r in t.itertuples():
            iid=r.image_id
            try: sz=os.path.getsize(f'{ROOT}/data/test/{iid[0]}/{iid[1]}/{iid[2]}/{iid}.png')
            except: sz=0
            cands=[]
            for n in names:
                inchi=getattr(r,n); valid=getattr(r,n+'_valid'); conf=getattr(r,n+'_conf')
                cands.append((inchi if valid else '', valid, conf))
            others=[c[0] for c in cands if c[0]]
            rows=[]
            for si,(inchi,valid,conf) in enumerate(cands):
                oo=[c for j,c in enumerate([cc[0] for cc in cands]) if j!=si and c]
                rows.append(feat_row(inchi,conf,valid,si,oo,sz,len(src_list)))
            rows.append(feat_row(FB,-5.0,True,len(names),others,sz,len(src_list)))
            pr=reg.predict(np.array(rows,dtype=np.float32))
            bi=int(np.argmin(pr))
            out.append((iid, cand_str2(cands,bi,FB)))
        pd.DataFrame(out,columns=['image_id','InChI']).to_csv(a.out,index=False)
        print('wrote',a.out,len(out))

def cand_str2(cands,bi,FB):
    if bi<len(cands):
        inchi,valid,conf=cands[bi]
        return inchi if valid else FB
    return FB

if __name__=='__main__': main()
