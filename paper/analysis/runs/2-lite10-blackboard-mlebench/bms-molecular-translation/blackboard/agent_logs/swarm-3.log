def medoid(cs,w):
    cs=[c for c in cs if c]
    if not cs: return FB
    if len(cs)==1: return cs[0]
    best=None;bc=None
    for i,c in enumerate(cs):
        t=sum(w[j]*Lev.distance(c,o) for j,o in enumerate(cs))
        if best is None or t<best: best=t;bc=c
    return bc
def apply(w=None, margin=0):
    out=[]
