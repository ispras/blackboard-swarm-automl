    ms[['image_id','inchi','conf','valid']].rename(columns={'inchi':'ms','conf':'ms_conf','valid':'ms_valid'}),on='image_id',how='left').merge(
    om[['image_id','inchi','conf','valid']].rename(columns={'inchi':'om','conf':'om_conf','valid':'om_valid'}),on='image_id',how='left')
for c in ['inchi_from_smiles','ms','om']: m[c]=m[c].fillna('').astype(str)
m['lev_i']=[Lev.distance(a if a else FB,b) for a,b in zip(m.inchi_from_smiles,m.InChI)]
m['lev_ms']=[Lev.distance(a if a else FB,b) for a,b in zip(m.ms,m.InChI)]
m['lev_om']=[Lev.distance(a if a else FB,b) for a,b in zip(m.om,m.InChI)]
print('n',len(m),'iota',round(m.lev_i.mean(),3),'ms',round(m.lev_ms.mean(),3),'omega',round(m.lev_om.mean(),3))
print('ms better frac',(m.lev_ms<m.lev_i).mean(),'omega better frac',(m.lev_om<m.lev_i).mean())
mm=m.sort_values('conf').reset_index(drop=True)
for f in [0.02,0.05,0.1,0.15,0.2]:
    k=int(len(mm)*f); s=mm.iloc[:k]
    print(f'worst {f}: n={k} iota={s.lev_i.mean():.2f} ms={s.lev_ms.mean():.2f} om={s.lev_om.mean():.2f} ms_better_frac={(s.lev_ms<s.lev_i).mean():.2f} invalid={(s.inchi_from_smiles=="").mean():.3f}')
# safe rules
for rule,fn in [
  ('invalid->ms', lambda r: r.ms if (not r.valid and r.ms_valid and r.ms) else (r.inchi_from_smiles if r.valid else FB)),
  ('invalid or lev_i>20 oracle-ms', None),
]:
    pass
# evaluate invalid->ms
def apply(fn):
    ps=[fn(r) for r in m.itertuples()]
    return np.mean([Lev.distance(p,t) for p,t in zip(ps,m.InChI)])
print('invalid->ms', apply(lambda r: (r.ms if (r.ms_valid and r.ms) else FB) if (not r.valid) else r.inchi_from_smiles))
# threshold rule: iota conf < t1 & ms valid & ms_conf > t2 -> ms
best=(1e9,None)
for t1 in np.quantile(m.conf,[0.01,0.02,0.03,0.05,0.08,0.1,0.15,0.2]):
    for t2 in [0.0,0.3,0.5,0.7,0.85,0.95]:
        ps=[]
        for r in m.itertuples():
            if (not r.valid): p=(r.ms if (r.ms_valid and r.ms) else FB)
            elif r.conf<t1 and r.ms_valid and r.ms and r.ms_conf>t2: p=r.ms
            else: p=r.inchi_from_smiles
            ps.append(p)
        lev=np.mean([Lev.distance(p,t) for p,t in zip(ps,m.InChI)])
        if lev<best[0]: best=(lev,(t1,t2))
print('best threshold rule',best,'base',m.lev_i.mean())
