import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
FB=open('baseline_constant.txt').read().strip()
val=pd.read_csv('val_20k.csv')[['image_id','InChI']]
def rd(p,col):
    d=pd.read_csv(p); d[col]=d[col].fillna('').astype(str); return d
i=rd('val_preds_final3000.csv','inchi_from_smiles')
r=rd('val_preds_final_rot3000.csv','inchi_from_smiles')
ms=rd('/download_job_code/payload/sandbox/workspaces/altair_theta/preds_zeroshot_val3000.csv','inchi')
om=rd('/download_job_code/payload/sandbox/workspaces/regulus_omega/preds_val_phaseA.csv','inchi')
m=val.merge(i[['image_id','inchi_from_smiles','conf','valid']],on='image_id')
m=m.merge(r[['image_id','inchi_from_smiles','conf','valid']].rename(columns={'inchi_from_smiles':'rot','conf':'rot_conf','valid':'rot_valid'}),on='image_id')
m=m.merge(ms[['image_id','inchi','conf','valid']].rename(columns={'inchi':'ms','conf':'ms_conf','valid':'ms_valid'}),on='image_id',how='inner')
m=m.merge(om[['image_id','inchi','conf','valid']].rename(columns={'inchi':'om','conf':'om_conf','valid':'om_valid'}),on='image_id',how='inner')
for c in ['inchi_from_smiles','rot','ms','om']: m[c]=m[c].fillna('').astype(str)
m['valid']=m['valid'].fillna(False).astype(bool); m['rot_valid']=m['rot_valid'].fillna(False).astype(bool)
gt=m.InChI.values
def levcol(s): return np.array([Lev.distance((a if a else FB),b) for a,b in zip(s,gt)])
base=m['inchi_from_smiles'].values
lbase=levcol(base); print('base',round(lbase.mean(),3))
def score(pred): return np.mean([Lev.distance((a if a else FB),b) for a,b in zip(pred,gt)])
# Rule invalid -> choose valid cascade with max conf
def pick_cascade(r):
    opts=[]
    if r.rot_valid and r.rot: opts.append((r.rot_conf,r.rot))
    if r.ms_valid and r.ms: opts.append((r.ms_conf,r.ms))
    if r.om_valid and r.om: opts.append((r.om_conf,r.om))
    if not opts: return FB
    return max(opts)[1]
pred=[]
for rr in m.itertuples():
    if not rr.valid: pred.append(pick_cascade(rr))
    else: pred.append(rr.inchi_from_smiles)
print('invalid->best-conf cascade',round(score(pred),3))
# threshold rules: iota conf < t1; use source if source valid & conf > t2; else iota
for src,sc,vc in [('rot','rot_conf','rot_valid'),('ms','ms_conf','ms_valid'),('om','om_conf','om_valid')]:
    best=(1e9,None)
    for t1 in np.quantile(m.conf,[0.02,0.05,0.08,0.1,0.12,0.15,0.2,0.25,0.3]):
        for t2 in np.quantile(m[sc],[0.3,0.5,0.7,0.8,0.9,0.95]):
            src_ok=(m[sc]>t2)&m[vc]
            use=((~m.valid)|((m.conf<t1)&src_ok)).values
            p=np.where(use & src_ok.values, m[src].values, np.where(use & (~src_ok).values, FB, base))
            lev=score(p)
            if lev<best[0]: best=(lev,(float(t1),float(t2)))
    print('best rule',src,best,'-> gain',round(lbase.mean()-best[0],3))
# combined: invalid->cascade; low conf -> best cascade by conf if > its t2 (simple)
pred=[]
for rr in m.itertuples():
    if not rr.valid:
        pred.append(pick_cascade(rr)); continue
    if rr.conf < -0.105:
        opts=[]
        if rr.rot_valid and rr.rot and rr.rot_conf>-0.06: opts.append((rr.rot_conf,rr.rot))
        if rr.ms_valid and rr.ms and rr.ms_conf>0.85: opts.append((rr.ms_conf,rr.ms))
        if opts: pred.append(max(opts)[1])
        else: pred.append(rr.inchi_from_smiles)
    else: pred.append(rr.inchi_from_smiles)
print('hand combined rule',round(score(pred),3),'routed frac',float(((~m.valid)|((m.conf<-0.105))).mean()))
