import argparse, numpy as np, pandas as pd, sys
from rapidfuzz.distance import Levenshtein as Lev
ROOT='/download_job_code/payload/sandbox'
FB=open(f'{ROOT}/workspaces/regulus_iota/baseline_constant.txt').read().strip()

def load_pred(path, name):
    d=pd.read_csv(path)
    col='inchi' if 'inchi' in d.columns else ('inchi_from_smiles' if 'inchi_from_smiles' in d.columns else 'InChI_pred')
    out=pd.DataFrame({'image_id':d.image_id})
    out[name]=d[col].fillna(FB).replace('',FB)
    out[name+'_conf']=d['conf'] if 'conf' in d.columns else (d['confidence'] if 'confidence' in d.columns else -1.0)
    if 'valid' in d.columns:
        out[name+'_valid']=d['valid'].astype(bool)
    elif 'smiles' in d.columns:
        out[name+'_valid']=d['smiles'].notna() & (d['smiles']!='')
    else:
        out[name+'_valid']=out[name]!=FB
    return out

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--val_gt', default=f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
    ap.add_argument('--val_preds', nargs='+', required=True, help='name:path')
    ap.add_argument('--run', action='store_true')
    ap.add_argument('--test_preds', nargs='+', default=[], help='name:path')
    ap.add_argument('--out', default='')
    a=ap.parse_args()
    gt=pd.read_csv(a.val_gt)[['image_id','InChI']]
    frames=[]; names=[]; stats={}
    for spec in a.val_preds:
        name,path=spec.split(':',1); names.append(name)
        frames.append(load_pred(path,name))
    m=gt
    for f in frames: m=m.merge(f,on='image_id',how='inner')
    print('val matched',len(m),'sources',names)
    for name in names:
        mu=m[name+'_conf'].mean(); sd=m[name+'_conf'].std()+1e-9
        stats[name]=(mu,sd)
        z=(m[name+'_conf']-mu)/sd
        print(f'{name}: raw lev {np.mean([Lev.distance(p,g) for p,g in zip(m[name],m.InChI)]):.3f} conf mean {mu:.4f} sd {sd:.4f}')
    Y=m.InChI.tolist(); N=len(m)
    Z={n:(m[n+'_conf']-stats[n][0])/stats[n][1] for n in names}
    V={n:(m[n+'_valid'] & (m[n]!=FB)).values if (m[n+'_valid']).dtype!=object else m[n+'_valid'].fillna(False).values for n in names}
    best=(1e9,None)
    if len(names)==2:
        n1,n2=names
        for bias in np.arange(-0.8,0.81,0.05):
            for tau in [-1.5,-1.0,-0.7,-0.5,-0.3,0.0,0.5]:
                pred=[]
                for i in range(N):
                    cands=[]
                    if V[n1][i]: cands.append((Z[n1].iloc[i], m[n1].iloc[i]))
                    if V[n2][i]: cands.append((Z[n2].iloc[i]+bias, m[n2].iloc[i]))
                    if cands and max(c[0] for c in cands)>=tau:
                        pred.append(max(cands,key=lambda c:c[0])[1])
                    else:
                        pred.append(FB)
                lev=np.mean([Lev.distance(p,g) for p,g in zip(pred,Y)])
                if lev<best[0]: best=(lev,(bias,tau))
        print('BEST 2-source', best)
        bias,tau=best[1]
        # oracle per-image best source
        orc=np.mean([min([Lev.distance(m[n].iloc[i],Y[i]) for n in names if V[n][i]] or [Lev.distance(FB,Y[i])]) for i in range(N)])
        print('oracle best-of-2', orc)
    else:
        print('only implemented 2-source fusion; got',names)
        return
    if a.run and a.out:
        t=gt[['image_id']].copy()
        if not a.test_preds:
            print('need --test_preds'); return
        tf=[]
        for spec in a.test_preds:
            name,path=spec.split(':',1); tf.append(load_pred(path,name))
        t2=None
        for f in tf:
            t2=f if t2 is None else t2.merge(f,on='image_id',how='outer')
        # z-score using val stats
        preds=[]
        for r in t2.itertuples():
            scores=[]
            for n in names:
                conf=getattr(r,n+'_conf')
                z=(conf-stats[n][0])/stats[n][1]
                inchi=getattr(r,n)
                valid=getattr(r,n+'_valid') if hasattr(r,n+'_valid') else (inchi!=FB)
                if valid and inchi!=FB: scores.append((z+(bias if n==names[1] else 0.0), inchi))
            if scores and max(s[0] for s in scores)>=tau:
                preds.append(max(scores,key=lambda s:s[0])[1])
            else: preds.append(FB)
        t2['InChI']=preds
        t2[['image_id','InChI']].to_csv(a.out,index=False)
        print('wrote',a.out,len(t2))
EOF
