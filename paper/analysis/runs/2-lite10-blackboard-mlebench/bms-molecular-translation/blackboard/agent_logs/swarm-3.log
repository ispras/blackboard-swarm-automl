import pandas as pd, numpy as np, re
from rdkit import Chem, RDLogger
from rdkit.Chem import inchi as rdinchi
RDLogger.DisableLog('rdApp.*')
from rapidfuzz.distance import Levenshtein as Lev
FB=open('baseline_constant.txt').read().strip()
val=pd.read_csv('val_20k.csv')[['image_id','InChI']].head(1000)
d=pd.read_csv('val_preds_6k.csv')
m=val.merge(d,on='image_id')
bad=m[m.inchi_from_smiles==FB].copy()

def parse(s):
    try:
        mol=Chem.MolFromSmiles(s)
        if mol is None: return None
        x=rdinchi.MolToInchi(mol)
        return x or None
    except Exception: return None

def fix_parens(s):
    # remove unmatched ')' scanning
    out=[]; bal=0
    for ch in s:
        if ch=='(':
            bal+=1; out.append(ch)
        elif ch==')':
            if bal>0: bal-=1; out.append(ch)
        else: out.append(ch)
    out.append(')'*bal)
    return ''.join(out)

def strip_unmatched_rings(s):
    # remove ring-closure digits that appear exactly once (and %nn)
    from collections import Counter
    digs=re.findall(r'%[0-9]{2}|[0-9]',s)
    cnt=Counter(digs)
    res=[]; i=0
    while i<len(s):
        if s[i]=='%' and i+2<len(s) and s[i+1].isdigit() and s[i+2].isdigit():
            tok=s[i:i+3]
            if cnt[tok]%2==1: i+=3; continue
            res.append(tok); i+=3
        elif s[i].isdigit():
            tok=s[i]
            if cnt[tok]%2==1: i+=1; continue
            res.append(tok); i+=1
        else:
            res.append(s[i]); i+=1
    return ''.join(res)

def longest_prefix(s):
    # binary-ish: try decreasing lengths; parse
    n=len(s)
    for L in range(n, max(0,n-80), -1):
        x=parse(s[:L])
        if x: return x
    return None

strategies={}
for name,fn in [('paren',lambda s:parse(fix_parens(s))),
                ('rings',lambda s:parse(strip_unmatched_rings(s))),
                ('paren+rings',lambda s:parse(strip_unmatched_rings(fix_parens(s)))),
                ('prefix',longest_prefix)]:
    outs=[fn(s) for s in bad.smiles]
    levs=[Lev.distance(x if x else FB,g) for x,g in zip(outs,bad.InChI)]
    strategies[name]=(sum(x is not None for x in outs), np.mean(levs))
    print(name, 'recovered', strategies[name][0], '/', len(bad), 'mean lev on bad', round(strategies[name][1],2))
print('fallback baseline on bad', round(np.mean([Lev.distance(FB,g) for g in bad.InChI]),2))
# combined best per image
best=[]
for i in range(len(bad)):
    cands=[FB]
    for name,fn in [('paren',lambda s:parse(fix_parens(s))),('rings',lambda s:parse(strip_unmatched_rings(s))),('paren+rings',lambda s:parse(strip_unmatched_rings(fix_parens(s)))),('prefix',longest_prefix)]:
        x=fn(bad.smiles.iloc[i])
        if x: cands.append(x)
    # no gt use; just pick first non-fallback (can't know). measure min lev oracle
    best.append(min(Lev.distance(c,bad.InChI.iloc[i]) for c in cands))
print('oracle best-of-repairs on bad', round(np.mean(best),2))
