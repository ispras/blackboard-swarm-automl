from rapidfuzz.distance import Levenshtein as Lev
FB=open('baseline_constant.txt').read().strip()
val=pd.read_csv('val_20k.csv')[['image_id','InChI']]
def load(p,inchi_col):
    d=pd.read_csv(p); d[inchi_col]=d[inchi_col].fillna('').astype(str)
    return d
i=load('val_preds_final3000.csv','inchi_from_smiles')
ms=load('/download_job_code/payload/sandbox/workspaces/altair_theta/preds_zeroshot_val3000.csv','inchi')
om=load('/download_job_code/payload/sandbox/workspaces/regulus_omega/preds_val_phaseA.csv','inchi')
# omega uses 'inchi' col with empty for invalid
