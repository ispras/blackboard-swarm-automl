import os, sys, time, math, json, argparse, random
import numpy as np, pandas as pd, torch
import torch.nn as nn
from torch.utils.data import DataLoader
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/regulus_iota')
from common import *

ROOT='/download_job_code/payload/sandbox'

def get_args():
    p=argparse.ArgumentParser()
    p.add_argument('--size', type=int, default=256)
    p.add_argument('--batch', type=int, default=256)
    p.add_argument('--epochs', type=int, default=20)
    p.add_argument('--lr', type=float, default=4e-4)
    p.add_argument('--wd', type=float, default=0.01)
    p.add_argument('--workers', type=int, default=10)
    p.add_argument('--warmup', type=int, default=2000)
    p.add_argument('--val_every', type=int, default=1500)   # steps
    p.add_argument('--val_decode', type=int, default=400)   # greedy decode count
    p.add_argument('--limit', type=int, default=0)
    p.add_argument('--resume', type=str, default='')
    p.add_argument('--out', type=str, default='ckpt')
    p.add_argument('--d_model', type=int, default=384)
    p.add_argument('--nlayers', type=int, default=4)
    p.add_argument('--ffn', type=int, default=1536)
    p.add_argument('--dropout', type=float, default=0.1)
    p.add_argument('--max_steps', type=int, default=0)
    p.add_argument('--maxlen', type=int, default=256)
    return p.parse_args()

def make_loaders(args):
    tr=pd.read_csv(f'{ROOT}/data/train_labels.csv')
    val=pd.read_csv(f'{ROOT}/workspaces/regulus_iota/val_20k.csv')
    tr=tr[~tr.image_id.isin(set(val.image_id))].reset_index(drop=True)
    if args.limit: tr=tr.iloc[:args.limit].reset_index(drop=True)
    print(f'train rows {len(tr)} val {len(val)}', flush=True)
    dtr=InChIDataset(tr, f'{ROOT}/data/train', args.size, train=True)
    dva=InChIDataset(val, f'{ROOT}/data/train', args.size, train=False)
    ltr=DataLoader(dtr, batch_size=args.batch, shuffle=True, num_workers=args.workers,
                   collate_fn=collate, pin_memory=True, drop_last=True, persistent_workers=args.workers>0,
                   prefetch_factor=4 if args.workers>0 else None)
    lva=DataLoader(dva, batch_size=64, shuffle=False, num_workers=4, collate_fn=collate, pin_memory=True)
    return ltr, lva

from rapidfuzz.distance import Levenshtein as Lev

@torch.no_grad()
def evaluate(model, lva, n_decode=400, max_batches=20, device='cuda', maxlen=256):
    model.eval()
    tok_correct=tok_total=0
    ce=0.0; nb=0
    for i,b in enumerate(lva):
        if i>=max_batches: break
        x,t=b; x=x.to(device,non_blocking=True); t=t.to(device,non_blocking=True)
        with torch.autocast('cuda', dtype=torch.bfloat16):
            logits=model(x,t[:,:-1])
        pred=logits.argmax(-1); tgt=t[:,1:]
        m=tgt!=PAD
        tok_correct+=(pred[m]==tgt[m]).sum().item(); tok_total+=m.sum().item()
        nb+=1
    # greedy decode
    ex=[]; preds=[]; gts=[]
    cnt=0
    for b in lva:
        x,t=b; x=x.to(device,non_blocking=True)
        ys=model.generate(x, maxlen=maxlen)
        for row,T in zip(ys.cpu().tolist(), t.tolist()):
            ps=decode_ids(row); gt=decode_ids(T)
            preds.append(ps); gts.append(gt)
            cnt+=1
            if cnt>=n_decode: break
        if cnt>=n_decode: break
    model.train()
    levs=[Lev.distance(p,g) for p,g in zip(preds,gts)]
    exact=np.mean([p==g for p,g in zip(preds,gts)])
    return tok_correct/max(tok_total,1), float(np.mean(levs)), float(exact)

def main():
    args=get_args()
    os.makedirs(args.out, exist_ok=True)
    torch.backends.cudnn.benchmark=True
    torch.backends.cuda.matmul.allow_tf32=True
    ltr,lva=make_loaders(args)
    device='cuda'
    model=Seq2Seq(args.d_model, 6, args.nlayers, args.ffn, args.dropout, pretrained=True).to(device)
    nparam=sum(p.numel() for p in model.parameters())
    print('params', nparam, flush=True)
    opt=torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.wd, betas=(0.9,0.98))
    scaler=torch.cuda.amp.GradScaler(enabled=False)
    step=0; best=1e9
    if args.resume:
        ck=torch.load(args.resume, map_location='cpu')
        model.load_state_dict(ck['model']); opt.load_state_dict(ck['opt']); step=ck.get('step',0)
        best=ck.get('best',1e9)
        print('resumed from', args.resume, 'step', step, flush=True)
    total_steps=args.max_steps if args.max_steps>0 else args.epochs*len(ltr)
    def set_lr(s):
        if s<args.warmup: lr=args.lr*s/args.warmup
        else:
            p=min(1.0,(s-args.warmup)/max(1,total_steps-args.warmup))
            lr=1e-5+(args.lr-1e-5)*0.5*(1+math.cos(math.pi*p))
        for g in opt.param_groups: g['lr']=lr
        return lr
    crit=nn.CrossEntropyLoss(ignore_index=PAD, label_smoothing=0.1)
    logf=open(os.path.join(args.out,'train_log.csv'),'a')
    if os.path.getsize(os.path.join(args.out,'train_log.csv'))==0 if os.path.exists(os.path.join(args.out,'train_log.csv')) else True:
        pass
    t0=time.time(); run_loss=0.0; nb=0
    model.train()
    while step < total_steps:
        for x,t in ltr:
            if step>=total_steps: break
            lr=set_lr(step)
            x=x.to(device,non_blocking=True); t=t.to(device,non_blocking=True)
            with torch.autocast('cuda', dtype=torch.bfloat16):
                logits=model(x,t[:,:-1])
                loss=crit(logits.reshape(-1,VOCAB).float(), t[:,1:].reshape(-1))
            opt.zero_grad(set_to_none=True)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step(); step+=1; run_loss+=loss.item(); nb+=1
            if step%50==0:
                dt=time.time()-t0
                print(f'step {step}/{total_steps} loss {run_loss/nb:.4f} lr {lr:.2e} {nb/dt:.2f} it/s elapsed {dt/60:.1f}m', flush=True)
                run_loss=0; nb=0; t0=time.time()
            if step%args.val_every==0:
                ta,lev,ex=evaluate(model,lva,args.val_decode,maxlen=args.maxlen)
                print(f'VAL step {step} tok_acc {ta:.4f} lev {lev:.4f} exact {ex:.4f}', flush=True)
                logf.write(f'{step},{ta},{lev},{ex},{time.time()}\n'); logf.flush()
                torch.save({'model':model.state_dict(),'opt':opt.state_dict(),'step':step,'args':vars(args),'best':best}, os.path.join(args.out,'ckpt_last.pt'))
                if lev<best:
                    best=lev
                    torch.save({'model':model.state_dict(),'opt':opt.state_dict(),'step':step,'args':vars(args),'best':best}, os.path.join(args.out,'ckpt_best.pt'))
                    print('saved best', flush=True)
                t0=time.time()
    ta,lev,ex=evaluate(model,lva,args.val_decode,maxlen=args.maxlen)
    print(f'FINAL step {step} tok_acc {ta:.4f} lev {lev:.4f} exact {ex:.4f}', flush=True)
    logf.write(f'{step},{ta},{lev},{ex},{time.time()}\n'); logf.flush()
    torch.save({'model':model.state_dict(),'opt':opt.state_dict(),'step':step,'args':vars(args),'best':min(best,lev)}, os.path.join(args.out,'ckpt_last.pt'))
    if lev<best:
        torch.save({'model':model.state_dict(),'opt':opt.state_dict(),'step':step,'args':vars(args),'best':lev}, os.path.join(args.out,'ckpt_best.pt'))

if __name__=='__main__':
    main()
