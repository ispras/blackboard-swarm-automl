m['a']=m.a.where(m.a!='',FB); m['b']=m.b.where(m.b!='',FB)
gt=m.InChI.values
def sc(p): return np.mean([Lev.distance(x,y) for x,y in zip(p,gt)])
print('a(best32k)',round(sc(m.a),4),'b(last33.5k)',round(sc(m.b),4))
# best conf pick
p=np.where(m.b_conf>m.a_conf, m.b, m.a); print('pick higher conf',round(sc(p),4))
# pick b if a invalid else a
p=np.where(m.a==FB, np.where(m.b!=FB,m.b,FB), m.a); print('a else b-if-invalid',round(sc(p),4))
# margin rule
best=(1e9,None)
for dth in [-0.02,-0.01,-0.005,0,0.005,0.01,0.02]:
    p=np.where((m.b_conf>m.a_conf+dth), m.b, m.a); lev=sc(p)
    if lev<best[0]: best=(lev,dth)
print('margin rule best',best)
