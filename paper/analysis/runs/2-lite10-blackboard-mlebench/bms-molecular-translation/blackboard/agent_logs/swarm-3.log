for bs in [8,16,32]:
    t0=time.time()
    outs=model.predict_images(imgs, return_confidence=True, batch_size=bs)
    dt=time.time()-t0
    print(f"bs={bs} time={dt:.2f}s per_img={dt/len(imgs):.3f}s", flush=True)
outs=model.predict_images(imgs, return_confidence=True, batch_size=16)
res=[]
for row,o in zip(sub.itertuples(),outs):
    smi=o['smiles']
    try:
        mol=Chem.MolFromSmiles(smi) if smi else None
        pred=inchi.MolToInchi(mol) if mol is not None else ''
    except Exception:
        pred=''
    d=lev(pred,row.InChI)
    res.append((row.image_id,smi,pred,row.InChI,d,o.get('confidence')))
    print(f"d={d:3d} conf={o.get('confidence')} true={row.InChI[:45]} pred={pred[:45]}", flush=True)
print("MEAN LEV", np.mean([r[4] for r in res]), "EXACT", np.mean([r[4]==0 for r in res]), "median", np.median([r[4] for r in res]))
json.dump(res, open('molscribe_sample.json','w'))
