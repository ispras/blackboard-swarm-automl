tr,Y,te,Yt=C.load_labels(); n=len(tr)
def ldf(path):
    d=pd.read_csv(path).set_index('rec_id').reindex(tr.rec_id.values); return d[[f'pred_{i}' for i in range(19)]].values.astype(float)
O={}
for nm,fn in [('perch','perch_pcr_max'),('bn','birdnet_h05max'),('bn3dn','bn3_dn'),('pp','perch_probe'),('mlpp','mlp_perch_ens5'),('mlpa','mlp_all_avg3'),('dn','perch_dn'),('meta','meta_LR'),('emb','mlp_embmeta')]:
    O[nm]=ldf(f'final_solution/components/{fn}_oof.csv')
O['bn3dnh']=ldf('workspaces/castor_rho/artifacts/bn3_dn_h125_probs.csv')
z=np.load('workspaces/castor_rho/artifacts/convnext_probs.npz'); rid={int(r):i for i,r in enumerate(z['rec_id'])}
O['cnx']=z['max'][[rid[int(r)] for r in tr.rec_id]]
# session prior honest
def sig(f):
    m=re.match(r'(PC\d+)_(\d{8})_(\d{6})_(\d+)',f); return m.group(1),m.group(2),int(m.group(3)[:2])*3600+int(m.group(3)[2:4])*60,int(m.group(3)),int(m.group(4))
D=np.array([sig(f) for f in tr.filename],dtype=object); site=np.array([d[0] for d in D]); date=np.array([d[1] for d in D]); sec=np.array([d[2] for d in D],dtype=int); seq=np.array([d[4] for d in D],dtype=int)
def prior(ti,trn):
    out=np.zeros((len(ti),19))
    for a,i in enumerate(ti):
        m=(site[trn]==site[i])&(date[trn]==date[i]); t=trn[m]
        if len(t)==0: continue
        w=np.exp(-np.abs(sec[t]-sec[i])/300.)*np.exp(-np.abs(seq[t]-seq[i])/30.); out[a]=(w[:,None]*Y[t]).sum(0)/(w.sum()+1e-9)
    return out
cv=pd.read_csv('final_solution/components/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cv.rec_id,cv.fold))).values
Pw=np.zeros((n,19))
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=prior(vi,np.setdiff1d(np.arange(n),vi))
O['pw']=Pw
Wb={'perch':1.,'bn':.2,'bn3dn':1.,'pp':.1,'mlpp':.1,'mlpa':.3,'dn':.15,'meta':.1,'pw':.2}
def zc(A,clip=1.5):
    out=np.zeros_like(A,float)
    for c in range(A.shape[1]): out[:,c]=np.clip((A[:,c]-A[:,c].mean())/(A[:,c].std()+1e-9),-clip,clip)
    return out
def offset(idx,tidx):
    pr=np.clip(Y[tidx].mean(0),1e-3,1-1e-3); lp=np.log(pr/(1-pr)); est=np.clip(0.5*(O['mlpp'][idx].mean(0)+O['emb'][idx].mean(0)),1e-3,1-1e-3); le=np.log(est/(1-est)); return 0.2*lp+0.8*le
def score(W,idx,tidx,clip=1.5,lam=1.1,extra=None):
    S=sum(w*zc(O[k][idx],clip) for k,w in W.items())
    if extra:
        for k,w in extra.items(): S=S+w*zc(O[k][idx],clip)
    return S+lam*offset(idx,tidx)[None,:]
def mic(Yv,S): return roc_auc_score(Yv.ravel(),S.ravel())
# OOF transductive
S=score(Wb,np.arange(n),np.arange(n)); print('base OOF micro %.4f macro %.4f'%(mic(Y,S),C.per_class_auc(Y,S)[0]))
# replacements/additions OOF
def ev(name,W,extra=None):
    S=score(W,np.arange(n),np.arange(n),extra=extra); print(f'{name}: OOF micro {mic(Y,S):.4f} macro {C.per_class_auc(Y,S)[0]:.4f}')
W1=dict(Wb); W1.pop('bn3dn'); W1['bn3dnh']=1.0; ev('replace bn3dn->h125',W1)
for w in [0.05,0.1,0.15,0.2,0.3]: ev(f'+cnx {w}',Wb,{'cnx':w})
W2=dict(W1)
for w in [0.05,0.1,0.15,0.2]: ev(f'h125+cnx {w}',W2,{'cnx':w})
# random sim
rng=np.random.RandomState(555); draws=600
variants={'base':(Wb,None),'h125':(W1,None),'base+cnx.1':(Wb,{'cnx':0.1}),'base+cnx.2':(Wb,{'cnx':0.2}),'h125+cnx.1':(W2,{'cnx':0.1}),'h125+cnx.2':(W2,{'cnx':0.2})}
res={k:[] for k in variants}
for it in range(draws):
