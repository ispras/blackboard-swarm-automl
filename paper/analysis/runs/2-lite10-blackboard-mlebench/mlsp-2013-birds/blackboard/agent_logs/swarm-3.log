import pandas as pd, numpy as np, re, os, pickle
base='data/essential_data/'
df=pd.read_pickle('workspaces/alderamin_phi/meta_labels.pkl')
# histogram
h={}
for line in open('data/supplemental_data/histogram_of_segments.txt'):
    line=line.strip()
    if not line or line.startswith('rec_id'): continue
    p=line.split(','); h[int(p[0])]=np.array(p[1:],dtype=np.float32)
# segment feature aggregates
segs={}
for line in open('data/supplemental_data/segment_features.txt'):
    line=line.strip()
    if not line or line.startswith('rec_id'): continue
    p=line.split(','); rid=int(p[0]); segs.setdefault(rid,[]).append(np.array(p[2:],dtype=np.float32))
# rectangles aggregates
rects={}
for line in open('data/supplemental_data/segment_rectangles.txt'):
    line=line.strip()
    if not line or line.lower().startswith('rec_id'): continue
    p=line.split(',')
    try: rid=int(p[0])
    except: continue
    vals=[float(x) for x in p[2:] if x.strip()!='']
    rects.setdefault(rid,[]).append(np.array(vals,dtype=np.float32))
feats={}
for rid in df.rec_id:
    f=[]
    f.append(h.get(rid,np.zeros(100,dtype=np.float32)))
    s=segs.get(rid,None)
    if s is not None and len(s):
        s=np.stack(s); f += [s.mean(0),s.max(0),s.min(0),s.std(0)]
    else:
        f += [np.zeros(38,dtype=np.float32)]*4
    r=rects.get(rid,None)
    if r is not None and len(r):
        r=np.stack([x for x in r if len(x)==4])
        if len(r): f += [r.mean(0),r.max(0),r.min(0), r[:,2]*r[:,3]]
        else: f += [np.zeros(4,dtype=np.float32)]*3+[np.zeros(1,dtype=np.float32)]
    else:
        f += [np.zeros(4,dtype=np.float32)]*3+[np.zeros(1,dtype=np.float32)]
    feats[rid]=np.concatenate(f).astype(np.float32)
# metadata
sites=sorted(df.site.unique()); times=sorted(df.time.str[:2].unique()); dates=sorted(df.date.unique())
meta={}
for _,r in df.iterrows():
    v=[1 if r.site==x else 0 for x in sites]
    v+=[1 if r.time[:2]==x else 0 for x in times]
    v+=[1 if r.date==x else 0 for x in dates]
    v+=[int(r.time[:2]), int(r.time[2:4])/60., int(r.date[:4]), r.seq[:2]=='0' and 1 or 0]
    meta[r.rec_id]=np.array(v,dtype=np.float32)
df['spec_feat']=[feats[r] for r in df.rec_id]
df['meta_feat']=[meta[r] for r in df.rec_id]
df.to_pickle('workspaces/alderamin_phi/feats.pkl')
print('spec',len(df.spec_feat.iloc[0]),'meta',len(df.meta_feat.iloc[0]))
