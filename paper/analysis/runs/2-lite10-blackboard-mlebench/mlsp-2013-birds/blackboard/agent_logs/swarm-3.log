import numpy as np, pandas as pd
w=np.load('workspaces/castor_rho/artifacts/birdnet_h05_windows.npz',allow_pickle=True)
rids=w['rec_id']; probs=w['probs']; starts=w['starts']
def feats(P):
    # P: n_win x 19
    out=[]
    for c in range(19):
        p=P[:,c]; idx=np.argsort(-p); pos=np.arange(len(p))[idx]
        srt=np.sort(p)[::-1]
        f=[p.max(),p.mean(),p.std(),srt[:2].mean() if len(p)>1 else p.max(),srt[:3].mean(),
           np.quantile(p,0.25),np.quantile(p,0.5),np.quantile(p,0.75),np.quantile(p,0.9),
           (p>0.05).mean(),(p>0.1).mean(),(p>0.3).mean(),(p>0.5).mean(),
           np.argmax(p)/max(1,len(p)-1), (p*np.arange(len(p))).sum()/max(1e-9,p.sum())/max(1,len(p)-1)]
        for th in [0.05,0.2,0.5]:
            b=(p>th).astype(int); runs=[]; cur=0
            for v in b:
                cur=cur+1 if v else 0; runs.append(cur)
            f.append(max(runs)/len(p)); f.append(sum(b))
        # rolling mean max window3
        f.append(np.convolve(p,np.ones(3)/3,mode='valid').max() if len(p)>=3 else p.max())
        out.append(f)
    out=np.array(out).T  # n_win? no -> shape (19, nf); transpose before
    return out
F={}; nb=None
for r,P in zip(rids,probs):
    if nb is None: nb=P.shape[0]
    F[int(r)]=feats(P).ravel()
print('nwin',nb,'feature len',len(next(iter(F.values()))))
df=pd.DataFrame({'rec_id':list(F),'winfeat':[F[k] for k in F]})
df.to_pickle('workspaces/alderamin_phi/winfeats.pkl')
