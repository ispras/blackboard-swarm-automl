def prior(target_idx, train_idx, mode):
    out=np.zeros((len(target_idx),19))
    for a,i in enumerate(target_idx):
        m=(site[train_idx]==site[i])&(date[train_idx]==date[i])
        ti=train_idx[m]
        if len(ti)==0: continue
        if mode=='grp':
            mm=tm[ti]==tm[i]; ti=ti[mm]
            if len(ti)==0: continue
            out[a]=Y[ti].mean(0)
        else:
            w=np.exp(-np.abs(sec[ti]-sec[i])/300.)*np.exp(-np.abs(seq[ti]-seq[i])/30.)
            out[a]=(w[:,None]*Y[ti]).sum(0)/(w.sum()+1e-9)
    return out
cv=pd.read_csv('final_solution/components/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cv.rec_id,cv.fold))).values
Pw=np.zeros((n,19))
for k in range(5):
    vi=np.where(ftr==k)[0]; ti=np.setdiff1d(np.arange(n),vi); Pw[vi]=prior(vi,ti,'time')
O['pw']=Pw
W={'perch_pcr_max':1.,'birdnet_h05max':.2,'bn3_b3_max':.5,'bn3_b3_mean':.3,'perch_probe':.1,'mlp_perch_ens5':.1,'mlp_all_avg3':.3,'perch_dn':.15,'meta_LR':.1,'pw':.2}
def z(P):
