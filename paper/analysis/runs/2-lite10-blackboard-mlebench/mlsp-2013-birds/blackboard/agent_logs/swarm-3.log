import numpy as np, pandas as pd, sys, warnings, re
warnings.filterwarnings('ignore')
sys.path.insert(0,'workspaces/arcturus_kappa'); import common as C
from sklearn.metrics import roc_auc_score
tr,Y,te,Yt=C.load_labels(); n=len(tr)
def ldf(path):
    d=pd.read_csv(path).set_index('rec_id').reindex(tr.rec_id.values); return d[[f'pred_{i}' for i in range(19)]].values.astype(float)
root='final_solution/components'
O={}
for nm,fn in [('perch_pcr_max','perch_pcr_max'),('birdnet_h05max','birdnet_h05max'),('bn3_b3_max','bn3_b3_max'),('bn3_b3_mean','bn3_b3_mean'),
              ('perch_probe','perch_probe'),('mlp_perch_ens5','mlp_perch_ens5'),('mlp_all_avg3','mlp_all_avg3'),('perch_dn','perch_dn'),('meta_LR','meta_LR'),('mlp_embmeta','mlp_embmeta')]:
    O[nm]=ldf(f'{root}/{fn}_oof.csv')
O['bn3_dn']=ldf('workspaces/castor_rho/oof/bn3_dn_oof.csv')
# session prior honest (own fold excluded)
def sig(f):
    m=re.match(r'(PC\d+)_(\d{8})_(\d{6})_(\d+)',f); return m.group(1),m.group(2),int(m.group(3)[:2])*3600+int(m.group(3)[2:4])*60,int(m.group(3)),int(m.group(4))
D=np.array([sig(f) for f in tr.filename],dtype=object); site=np.array([d[0] for d in D]); date=np.array([d[1] for d in D]); sec=np.array([d[2] for d in D],dtype=int); seq=np.array([d[4] for d in D],dtype=int)
def prior(ti,trn):
    out=np.zeros((len(ti),19))
    for a,i in enumerate(ti):
        m=(site[trn]==site[i])&(date[trn]==date[i]); t=trn[m]
        if len(t)==0: continue
        w=np.exp(-np.abs(sec[t]-sec[i])/300.)*np.exp(-np.abs(seq[t]-seq[i])/30.); out[a]=(w[:,None]*Y[t]).sum(0)/(w.sum()+1e-9)
    return out
cv=pd.read_csv(f'{root}/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cv.rec_id,cv.fold))).values
Pw=np.zeros((n,19))
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=prior(vi,np.setdiff1d(np.arange(n),vi))
O['pw']=Pw
Wcan={'perch_pcr_max':1.,'birdnet_h05max':.2,'bn3_b3_max':.5,'bn3_b3_mean':.3,'perch_probe':.1,'mlp_perch_ens5':.1,'mlp_all_avg3':.3,'perch_dn':.15,'meta_LR':.1,'pw':.2}
Wnew={'perch_pcr_max':1.,'birdnet_h05max':.2,'bn3_dn':1.,'perch_probe':.1,'mlp_perch_ens5':.1,'mlp_all_avg3':.3,'perch_dn':.15,'meta_LR':.1,'pw':.2}
def z(P,clip=None):
    Q=np.zeros_like(P,float)
    for c in range(P.shape[1]):
        sd=P[:,c].std(); Q[:,c]=(P[:,c]-P[:,c].mean())/(sd+1e-9) if sd>1e-12 else 0
    return np.clip(Q,-clip,clip) if clip else Q
def build(W,idx,clip,lam,alpha=.8):
    Z={k:z(O[k][idx],clip) for k in W}; S=sum(wt*Z[k] for k,wt in W.items())
    return S,lam
def offset(idx,tidx,alpha=.8):
    pr=np.clip(Y[tidx].mean(0),1e-3,1-1e-3); lpp=np.log(pr/(1-pr))
    est=np.clip(0.5*(O['mlp_perch_ens5'][idx].mean(0)+O['mlp_embmeta'][idx].mean(0)),1e-3,1-1e-3); le=np.log(est/(1-est))
    return (1-alpha)*lpp+alpha*le
# honest per-fold
def fold_scores(W,clip,lam):
    out=[]
    for k in range(5):
        vi=np.where(ftr==k)[0]; ti=np.setdiff1d(np.arange(n),vi)
        S,_=build(W,vi,clip,lam); S=S+lam*offset(vi,ti)[None,:]
        out.append(roc_auc_score(Y[vi].ravel(),S.ravel()))
    return np.array(out)
for nm,W,clip,lam in [('canonical',Wcan,None,1.2),('candidate',Wnew,1.5,1.10)]:
    f=fold_scores(W,clip,lam); print(nm,'honest folds',np.round(f,4),'mean',round(f.mean(),4))
# random split sim
for seed in [99,123,7,2026]:
    rng=np.random.RandomState(seed); draws=1000
    d=[]; wins=0; a_can=[]; a_new=[]
    for it in range(draws):
        idx=rng.choice(n,64,replace=False); tidx=np.setdiff1d(np.arange(n),idx)
        Sc,_=build(Wcan,idx,None,1.2); Sc=Sc+1.2*offset(idx,tidx)[None,:]; mc=roc_auc_score(Y[idx].ravel(),Sc.ravel())
        Sn,_=build(Wnew,idx,1.5,1.10); Sn=Sn+1.10*offset(idx,tidx)[None,:]; mn=roc_auc_score(Y[idx].ravel(),Sn.ravel())
        a_can.append(mc); a_new.append(mn); wins+=mn>mc
    a_can=np.array(a_can); a_new=np.array(a_new)
    print(f'seed {seed}: canon {a_can.mean():.4f} (q10 {np.quantile(a_can,.1):.4f}) -> new {a_new.mean():.4f} (q10 {np.quantile(a_new,.1):.4f}); delta {np.mean(a_new-a_can):+.4f}; win {wins/draws:.3f}')
# OOF transductive report
for nm,W,clip,lam in [('canonical',Wcan,None,1.2),('candidate',Wnew,1.5,1.10)]:
    idx=np.arange(n); S,_=build(W,idx,clip,lam); pr=np.clip(Y.mean(0),1e-3,1-1e-3); lpp=np.log(pr/(1-pr)); est=np.clip(0.5*(O['mlp_perch_ens5'].mean(0)+O['mlp_embmeta'].mean(0)),1e-3,1-1e-3); le=np.log(est/(1-est)); S=S+lam*(0.2*lpp+0.8*le)[None,:]
    print(nm,'OOF transductive micro %.4f macro %.4f'%(roc_auc_score(Y.ravel(),S.ravel()),C.per_class_auc(Y,S)[0]))
