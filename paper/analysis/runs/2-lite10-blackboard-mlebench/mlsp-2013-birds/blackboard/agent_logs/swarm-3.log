import pandas as pd, numpy as np, warnings, torch, torch.nn as nn, os
warnings.filterwarnings('ignore')
from sklearn.preprocessing import StandardScaler, QuantileTransformer
from sklearn.metrics import roc_auc_score
torch.manual_seed(0); np.random.seed(0)
dev='cuda' if torch.cuda.is_available() else 'cpu'; print('dev',dev)
df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl').sort_values('rec_id').reset_index(drop=True)
cvf=pd.read_csv('workspaces/castor_rho/shared/cv_folds.csv'); df=df.merge(cvf,on='rec_id',how='left')
bn=pd.read_csv('workspaces/castor_rho/artifacts/birdnet_probs.csv'); df=df.merge(bn,on='rec_id',how='left')
emb=np.load('workspaces/castor_rho/artifacts/birdnet_emb.npz')
embd={int(r):e for r,e in zip(emb['rec_id'],emb['emb'])}; df['emb']=[embd[r] for r in df.rec_id]
tr=df[df.fold_x==0].reset_index(drop=True); te=df[df.fold_x==1].reset_index(drop=True)
Y=np.zeros((len(tr),19),dtype=np.float32)
for i,l in enumerate(tr.labs):
    for s in l: Y[i,s]=1
bncols=[f'bn_max_{s}' for s in range(19)]; bnm=[f'bn_mean_{s}' for s in range(19)]; bnt=[f'bn_top2_{s}' for s in range(19)]
def makeX(d):
    e=np.stack(d.emb.values); m=np.stack(d.meta_feat.values); b=d[bncols+bnm+bnt].values
    return np.hstack([e,m,b]).astype(np.float32), e, m, b
Xtr,Etr,Mtr,Btr=makeX(tr); Xte,Ete,Mte,Bte=makeX(te)
sc=StandardScaler().fit(Xtr)
class Net(nn.Module):
    def __init__(self,din,h=256,do=0.4):
        super().__init__(); self.net=nn.Sequential(nn.Linear(din,h),nn.BatchNorm1d(h),nn.GELU(),nn.Dropout(do),nn.Linear(h,64),nn.GELU(),nn.Dropout(do),nn.Linear(64,19))
    def forward(self,x): return self.net(x)
def train_one(Xa,Ya,Xv,Yv,epochs=120,h=256,do=0.4,lr=1e-3,wd=1e-2,bs=32):
    Xa=torch.tensor(sc.transform(Xa),device=dev); Ya=torch.tensor(Ya,device=dev)
    Xv=torch.tensor(sc.transform(Xv),device=dev)
    net=Net(Xa.shape[1],h,do).to(dev); opt=torch.optim.AdamW(net.parameters(),lr=lr,weight_decay=wd)
    lossf=nn.BCEWithLogitsLoss(); n=len(Xa)
    for ep in range(epochs):
        net.train(); perm=torch.randperm(n,device=dev)
        for i in range(0,n,bs):
            idx=perm[i:i+bs]; opt.zero_grad(); l=lossf(net(Xa[idx]),Ya[idx]); l.backward(); opt.step()
    net.eval()
    with torch.no_grad(): return torch.sigmoid(net(Xv)).cpu().numpy()
def cv(kind,epochs,h,do,lr,wd):
    oof=np.zeros((len(tr),19)); pt=np.zeros((len(te),19))
    if kind=='embmeta': A,B=Etr,Mtr; At,Bt=Ete,Mte
    elif kind=='all': A,B=Xtr,None; At,Bt=Xte,None
    elif kind=='bnmeta': A,B=Btr,Mtr; At,Bt=Bte,Mte
    Xa=np.hstack([A,B]) if B is not None else A; Xat=np.hstack([At,Bt]) if Bt is not None else At
    for k in sorted(tr.fold_y.unique()):
        vi=np.where(tr.fold_y.values==k)[0]; ti=np.setdiff1d(np.arange(len(tr)),vi)
        p=train_one(Xa[ti],Y[ti],Xa[vi],Y[vi],epochs,h,do,lr,wd); oof[vi]=p
        pt+=train_one(Xa[ti],Y[ti],Xat,Y[ti][:0],epochs,h,do,lr,wd)/5.0
    aucs=[roc_auc_score(Y[:,s],oof[:,s]) for s in range(19) if 0<Y[:,s].sum()<len(Y)]
    micro=roc_auc_score(Y.ravel(),oof.ravel())
    print(f'{kind} ep{epochs} h{h} do{do} lr{lr} wd{wd}: micro={micro:.4f} macro={np.mean(aucs):.4f}',' '.join(f'{a:.3f}' for a in aucs),flush=True)
    return oof,pt,micro
best=None
for kind in ['embmeta','all','bnmeta']:
    for epochs,h,do,lr,wd in [(80,256,0.4,1e-3,1e-2),(120,256,0.5,1e-3,3e-2),(120,512,0.5,5e-4,3e-2)]:
        oof,pt,m=cv(kind,epochs,h,do,lr,wd)
        if best is None or m>best[0]: best=(m,kind,epochs,h,do,lr,wd,oof,pt)
print('BEST',best[:7],best[0])
m,kind,epochs,h,do,lr,wd,oof,pt=best
np.save(f'workspaces/alderamin_phi/oof/mlp_{kind}_oof.npy',oof); np.save(f'workspaces/alderamin_phi/oof/mlp_{kind}_test.npy',pt)
