import numpy as np, pandas as pd, itertools
from sklearn.metrics import roc_auc_score
from scipy.stats import rankdata
Y=np.load('workspaces/alderamin_phi/oof/Y.npy')
names=['bn_max','bn_top2','meta_LR','meta_ET','spec_ET','bn3_meta_spec_ET','emb_meta_LR','emb_meta_bn3_LR']
M={n:np.load(f'workspaces/alderamin_phi/oof/{n}.npy') for n in names}
pos=Y.sum(0); print('positives per class',pos.tolist())
def ranks(M):
    R=np.zeros_like(M)
    for s in range(M.shape[1]): R[:,s]=(rankdata(M[:,s])-0.5)/M.shape[0]
    return R
R={n:ranks(M[n]) for n in names}
def ev(oof,name):
    aucs=[roc_auc_score(Y[:,s],oof[:,s]) for s in range(19) if 0<Y[:,s].sum()<len(Y)]
    flat=roc_auc_score(Y.ravel(),oof.ravel())
    per=[roc_auc_score(Y[:,s],oof[:,s]) if 0<Y[:,s].sum()<len(Y) else np.nan for s in range(19)]
    print(f'{name}: macro={np.mean(aucs):.4f} micro={flat:.4f} |',' '.join(f'{a:.3f}' for a in per))
    return np.mean(aucs)
# pairs rank average
for a,b in itertools.combinations(names,2):
    ev((R[a]+R[b])/2,f'RA {a}+{b}')
# weighted bn with best learned
print('--- weighted bn_max + emb_meta_bn3 ---')
for w in [0.5,0.6,0.7,0.8,0.9]:
    ev(w*R['bn_max']+(1-w)*R['emb_meta_bn3_LR'],f'w={w}')
print('--- weighted bn_max + bn3_meta_spec_ET ---')
for w in [0.5,0.6,0.7,0.8,0.9]:
    ev(w*R['bn_max']+(1-w)*R['bn3_meta_spec_ET'],f'w={w}')
print('--- 3way ---')
ev((R['bn_max']+R['emb_meta_bn3_LR']+R['bn3_meta_spec_ET'])/3,'RA 3way')
print('--- per-species selection (bn vs emb_meta_bn3, margin) ---')
for margin in [0,0.02,0.04,0.06]:
    out=R['bn_max'].copy()
    for s in range(19):
        if pos[s]<5: continue
        ab=roc_auc_score(Y[:,s],M['bn_max'][:,s]); ae=roc_auc_score(Y[:,s],M['emb_meta_bn3_LR'][:,s])
        if ae>ab+margin: out[:,s]=R['emb_meta_bn3_LR'][:,s]
        elif ab>ae+margin: out[:,s]=R['bn_max'][:,s]
        else: out[:,s]=(R['bn_max'][:,s]+R['emb_meta_bn3_LR'][:,s])/2
    ev(out,f'select margin={margin}')
print('--- per-species blend using OOF-best among 4 (optimistic) ---')
out=np.zeros_like(M['bn_max'])
for s in range(19):
    best=None;ba=-1
    for n in ['bn_max','emb_meta_bn3_LR','bn3_meta_spec_ET','spec_ET','meta_ET']:
        a=roc_auc_score(Y[:,s],M[n][:,s]) if 0<Y[:,s].sum()<len(Y) else 0.5
        if a>ba: ba=a;best=n
    out[:,s]=R[best][:,s]
    print(s,best,round(ba,3))
ev(out,'best-per-species')
