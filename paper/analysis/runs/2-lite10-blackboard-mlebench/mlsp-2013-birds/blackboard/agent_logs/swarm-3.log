import pandas as pd, numpy as np, warnings, torch, torch.nn as nn, sys
warnings.filterwarnings('ignore')
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'workspaces/arcturus_kappa'); import common as C
torch.manual_seed(0); np.random.seed(0)
dev='cuda' if torch.cuda.is_available() else 'cpu'; print(dev,flush=True)
df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl').sort_values('rec_id').reset_index(drop=True)
cvf=pd.read_csv('workspaces/castor_rho/shared/cv_folds.csv'); df=df.merge(cvf,on='rec_id',how='left')
wf=pd.read_pickle('workspaces/alderamin_phi/winfeats.pkl'); df=df.merge(wf,on='rec_id',how='left')
bn=pd.read_csv('workspaces/castor_rho/artifacts/birdnet_probs.csv'); df=df.merge(bn,on='rec_id',how='left')
emb=np.load('workspaces/castor_rho/artifacts/birdnet_emb.npz'); embd={int(r):e for r,e in zip(emb['rec_id'],emb['emb'])}
tr=df[df.fold_x==0].reset_index(drop=True); te=df[df.fold_x==1].reset_index(drop=True)
Y=np.zeros((len(tr),19),dtype=np.float32)
for i,l in enumerate(tr.labs):
    for s in l: Y[i,s]=1
folds=[np.where(tr.fold_y.values==k)[0] for k in sorted(tr.fold_y.unique())]
bncols=[f'bn_max_{s}' for s in range(19)]; bnm=[f'bn_mean_{s}' for s in range(19)]; bnt=[f'bn_top2_{s}' for s in range(19)]
def gx(d): return dict(E=np.stack([embd[r] for r in d.rec_id]), M=np.stack(d.meta_feat.values), B=d[bncols+bnm+bnt].values, W=np.stack(d.winfeat.values))
A=gx(tr); T=gx(te)
class Net(nn.Module):
    def __init__(s,din,h,do):
        super().__init__(); s.net=nn.Sequential(nn.Linear(din,h),nn.BatchNorm1d(h),nn.GELU(),nn.Dropout(do),nn.Linear(h,96),nn.GELU(),nn.Dropout(do),nn.Linear(96,19))
    def forward(s,x): return s.net(x)
def train_one(Xa,Ya,Xv,seed,epochs,h,do,lr,wd,bs=32):
    torch.manual_seed(seed); np.random.seed(seed)
    sc=StandardScaler().fit(Xa)
    Xa=torch.tensor(sc.transform(Xa).astype(np.float32),device=dev); Ya=torch.tensor(Ya,device=dev); Xv=torch.tensor(sc.transform(Xv).astype(np.float32),device=dev)
    net=Net(Xa.shape[1],h,do).to(dev); opt=torch.optim.AdamW(net.parameters(),lr=lr,weight_decay=wd)
    lf=nn.BCEWithLogitsLoss(); n=len(Xa)
    for ep in range(epochs):
        net.train(); perm=torch.randperm(n,device=dev)
        for i in range(0,n,bs):
            idx=perm[i:i+bs]; opt.zero_grad(); l=lf(net(Xa[idx]),Ya[idx]); l.backward(); opt.step()
    net.eval()
    with torch.no_grad(): return torch.sigmoid(net(Xv)).cpu().numpy()
def cv(kind,seed=0,epochs=100,h=256,do=0.4,lr=1e-3,wd=2e-2):
    if kind=='wmb': A_=np.hstack([A['W'],A['M'],A['B']]); T_=np.hstack([T['W'],T['M'],T['B']])
    elif kind=='wmbE': A_=np.hstack([A['W'],A['M'],A['B'],A['E']]); T_=np.hstack([T['W'],T['M'],T['B'],T['E']])
    elif kind=='wEm': A_=np.hstack([A['W'],A['E'],A['M']]); T_=np.hstack([T['W'],T['E'],T['M']])
    oof=np.zeros((len(tr),19)); pt=np.zeros((len(te),19))
    for vi in folds:
        ti=np.setdiff1d(np.arange(len(tr)),vi)
        oof[vi]=train_one(A_[ti],Y[ti],A_[vi],seed,epochs,h,do,lr,wd)
        pt+=train_one(A_[ti],Y[ti],T_,seed,epochs,h,do,lr,wd)/5
    mi=roc_auc_score(Y.ravel(),oof.ravel()); ma=C.per_class_auc(Y,oof)[0]
    print(kind,seed,epochs,h,do,wd,f'micro={mi:.4f} macro={ma:.4f}',flush=True)
    return oof,pt,mi,ma
res=[]
for kind in ['wmb','wmbE','wEm']:
    for seed in [0,1]:
        for epochs,h,do,lr,wd in [(100,256,0.4,1e-3,2e-2),(140,256,0.5,7e-4,4e-2)]:
            res.append((kind,seed,epochs,h,do,lr,wd)+cv(kind,seed,epochs,h,do,lr,wd))
