import pandas as pd, numpy as np, soundfile as sf, os, torch, torchaudio
df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl')
base='data/essential_data/src_wavs/'
os.makedirs('workspaces/alderamin_phi/logmel',exist_ok=True)
mel=torchaudio.transforms.MelSpectrogram(sample_rate=16000,n_fft=1024,hop_length=320,n_mels=128,f_min=50,f_max=8000,power=2.0)
db=torchaudio.transforms.AmplitudeToDB(top_db=80)
lens=[]
for i,r in df.iterrows():
    w, sr=sf.read(base+r.filename+'.wav',dtype='float32')
    if w.ndim>1: w=w.mean(1)
    if sr!=16000:
        w=torchaudio.functional.resample(torch.tensor(w),sr,16000).numpy()
    w=torch.tensor(w)
    if len(w)<160000: w=torch.nn.functional.pad(w,(0,160000-len(w)))
    w=w[:160000]
    m=db(mel(w)).numpy()  # 128 x 501
    # normalize per sample
    m=(m-m.mean())/(m.std()+1e-6)
    np.save(f'workspaces/alderamin_phi/logmel/{int(r.rec_id)}.npy',m.astype(np.float16))
    lens.append(m.shape)
print('done',len(lens),set(lens))
