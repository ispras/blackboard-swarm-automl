import os, sys, time
os.environ['OMP_NUM_THREADS']='4'
import numpy as np, pandas as pd, librosa, torch, torchaudio
from torchvision import transforms
from transformers import ConvNextForImageClassification
from eval_utils import *
torch.set_num_threads(4); dev='cuda' if torch.cuda.is_available() else 'cpu'
base='/download_job_code/payload/sandbox'
rec2f={}
for line in open(f'{base}/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
SCI=["Certhia americana","Troglodytes pacificus","Empidonax difficilis","Sitta canadensis","Junco hyemalis","Contopus cooperi","Catharus guttatus","Poecile rufescens","Ixoreus naevius","Setophaga occidentalis","Catharus ustulatus","Empidonax hammondii","Piranga ludoviciana","Pheucticus melanocephalus","Regulus satrapa","Vireo gilvus","Geothlypis tolmiei","Cyanocitta stelleri","Chordeiles minor"]
codes=["brncre","pacwre1","pasfly","rebnut","daejun","olsfly","herthr","chbchi","varthr","herwar","swathr","hamfly","westan","bkhgro","gockin","warvir","macwar","stejay","comnig"]
model=ConvNextForImageClassification.from_pretrained('models/convnext_birdset').to(dev).eval()
id2lab=model.config.id2label; lab2id={v:k for k,v in id2lab.items()}
tgt=[int(lab2id[c]) for c in codes]
print('target ids',tgt,flush=True)
class PowerToDB(torch.nn.Module):
    def __init__(self,ref=1.0,amin=1e-10,top_db=80.0):
        super().__init__(); self.ref=ref; self.amin=amin; self.top_db=top_db
    def forward(self,S):
        S=torch.as_tensor(S,dtype=torch.float32); mag=S.abs() if torch.is_complex(S) else S
        log=10*torch.log10(torch.clamp(mag,min=self.amin))
        if self.top_db is not None: log=torch.maximum(log,log.max()-self.top_db)
        return log
sp=torchaudio.transforms.Spectrogram(n_fft=1024,hop_length=320,power=2.0)
mel=torchaudio.transforms.MelScale(n_mels=128,n_stft=513,sample_rate=32000)
norm=transforms.Normalize((-4.268,),(4.569,)); p2db=PowerToDB(top_db=80)
def prep(y):
    with torch.no_grad():
        x=torch.tensor(y)[None,:]
        x=sp(x); x=mel(x); x=p2db(x); x=norm(x)
        return x.unsqueeze(0)  # 1,1,128,T
SR=32000; W=5*SR; H=int(2.5*SR)
ids=sorted(rec2f)
res={}
t0=time.time()
with torch.no_grad():
    for rid in ids:
        y,_=librosa.load(f'{base}/data/essential_data/src_wavs/{rec2f[rid]}.wav',sr=SR,mono=True)
        if len(y)<W: y=np.pad(y,(0,W-len(y)))
        starts=list(range(0,len(y)-W+1,H))
        if starts[-1]+W<len(y): starts.append(len(y)-W)
        xs=[prep(y[s:s+W]).to(dev) for s in starts]
        x=torch.cat(xs,0); out=model(pixel_values=x).logits.cpu().numpy()
        res[rid]=(out[:,tgt].max(0), out[:,tgt].mean(0), out[:,tgt])
        if len(res)%40==0: print(len(res),round(time.time()-t0,1),flush=True)
mx=np.stack([res[r][0] for r in ids]); mn=np.stack([res[r][1] for r in ids])
np.savez_compressed('artifacts/convnext_probs.npz',rec_id=np.array(ids),max=mx,mean=mn)
tr,tst,lab=train_ids(); Y=Y_matrix(tr,lab); ridx={r:i for i,r in enumerate(ids)}
for nm,M in [('max',mx),('mean',mn)]:
    P=M[[ridx[r] for r in tr]]
    report(Y,P,'convnext '+nm)
print('DONE',round(time.time()-t0,1),flush=True)
