E=E/(np.linalg.norm(E,axis=1,keepdims=True)+1e-9); n=len(tr); Et=E[:n]; K=np.zeros((n,19))
for i in range(n):
    idx=np.where(ftr!=ftr[i])[0]; s=Et[idx]@Et[i]; top=idx[np.argsort(-s)[:20]]; ss=Et[top]@Et[i]; ww=np.exp((ss-ss.max())/0.02); K[i]=(ww[:,None]*Y[top]).sum(0)/ww.sum()
comp['knn20_bnemb']=K
Z={k:z(v) for k,v in comp.items()}
