        out.append(roc_auc_score(Y[idx].ravel(),(S+1.2*(0.2*lpp+0.8*le)[None,:]).ravel()))
    print(mode,w,alpha,'mean=%.4f med=%.4f q10=%.4f'%(np.mean(out),np.median(out),np.quantile(out,.1)))
run(None)
