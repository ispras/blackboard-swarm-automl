    if kind=='spec': return dic['spec']
    if kind=='all3': return np.hstack([dic['bn3'],dic['meta'],dic['spec']])
    if kind=='embmeta': return np.hstack([dic['emb'],dic['meta']])
    if kind=='embmetabn3': return np.hstack([dic['emb'],dic['meta'],dic['bn3']])
for name,fn,kind,ok in specs:
