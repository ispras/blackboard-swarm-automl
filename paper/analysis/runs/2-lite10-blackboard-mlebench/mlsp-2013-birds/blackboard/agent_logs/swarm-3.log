def load(path,ids):
    d=pd.read_csv(path).set_index('rec_id').reindex(ids); return d[[f'pred_{i}' for i in range(19)]].values.astype(float)
def z(P):
    Q=np.zeros_like(P,float)
    for c in range(P.shape[1]):
        sd=P[:,c].std(); Q[:,c]=(P[:,c]-P[:,c].mean())/(sd+1e-9) if sd>1e-12 else 0
    return Q
def add(name):
