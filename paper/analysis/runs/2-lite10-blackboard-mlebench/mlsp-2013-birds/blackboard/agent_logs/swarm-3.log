import pandas as pd, numpy as np, warnings, sys
warnings.filterwarnings('ignore')
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'workspaces/arcturus_kappa'); import common as C
df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl').sort_values('rec_id').reset_index(drop=True)
cvf=pd.read_csv('workspaces/castor_rho/shared/cv_folds.csv'); df=df.merge(cvf,on='rec_id',how='left')
wf=pd.read_pickle('workspaces/alderamin_phi/winfeats.pkl'); df=df.merge(wf,on='rec_id',how='left')
bn=pd.read_csv('workspaces/castor_rho/artifacts/birdnet_probs.csv'); df=df.merge(bn,on='rec_id',how='left')
emb=np.load('workspaces/castor_rho/artifacts/birdnet_emb.npz'); embd={int(r):e for r,e in zip(emb['rec_id'],emb['emb'])}
tr=df[df.fold_x==0].reset_index(drop=True); te=df[df.fold_x==1].reset_index(drop=True)
Y=np.zeros((len(tr),19),dtype=int)
for i,l in enumerate(tr.labs):
    for s in l: Y[i,s]=1
folds=[np.where(tr.fold_y.values==k)[0] for k in sorted(tr.fold_y.unique())]
def gx(d): return dict(W=np.stack(d.winfeat.values),M=np.stack(d.meta_feat.values),S=np.stack(d.spec_feat.values),E=np.stack([embd[r] for r in d.rec_id]),B=d[[f'bn_max_{s}' for s in range(19)]].values)
A=gx(tr); T=gx(te)
def run(cols,name,sv=False,n_est=1200,ml=1,mf=0.15,msl=1):
    X=np.hstack([A[c] for c in cols]); Xt=np.hstack([T[c] for c in cols])
    oof=np.zeros((len(tr),19)); pt=np.zeros((len(te),19))
    fn=lambda: ExtraTreesClassifier(n_est,min_samples_leaf=msl,max_features=mf,n_jobs=8,random_state=0)
    for vi in folds:
        ti=np.setdiff1d(np.arange(len(tr)),vi)
        for s in range(19):
            y=Y[ti,s]
            if y.sum()==0: continue
            if y.sum()==len(y): oof[vi,s]=1; pt[:,s]+=1/5; continue
            m=fn(); m.fit(X[ti],y); oof[vi,s]=m.predict_proba(X[vi])[:,1]; pt[:,s]+=m.predict_proba(Xt)[:,1]/5
    mi=roc_auc_score(Y.ravel(),oof.ravel()); ma=C.per_class_auc(Y,oof)[0]
    print(f'{name}: micro={mi:.4f} macro={ma:.4f}',flush=True)
    if sv:
        np.save(f'workspaces/alderamin_phi/oof/{name}_oof.npy',oof); np.save(f'workspaces/alderamin_phi/oof/{name}_test.npy',pt)
    return oof,mi,ma
for cols,name in [(['W','M','B'],'wf_meta_bn_ET'),(['W','M','B','E'],'wf_meta_bn_emb_ET'),(['W','M','B','E','S'],'wf_meta_bn_emb_spec_ET'),(['W','M','E'],'wf_meta_emb_ET')]:
    for mf,msl in [(0.15,1),(0.1,2)]:
        run(cols,f'{name}_mf{mf}_msl{msl}',sv=(name=='wf_meta_bn_ET' and mf==0.15 and msl==1),mf=mf,msl=msl)
