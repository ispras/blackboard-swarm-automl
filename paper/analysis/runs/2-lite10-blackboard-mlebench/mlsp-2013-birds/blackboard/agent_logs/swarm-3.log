def session_prior(train,Yv,targets,exclude=None):
    out=np.zeros((len(targets),19)); secs=train.secs.values if 'secs' in train else None
    import re
    sig=lambda f: (lambda m:(m.group(1),m.group(2),int(m.group(3)[:2])*3600+int(m.group(3)[2:4])*60,int(m.group(4))))(re.match(r'(PC\d+)_(\d{8})_(\d{6})_(\d+)',f))
    site=np.array([sig(f)[0] for f in train.filename]); date=np.array([sig(f)[1] for f in train.filename]); sec=np.array([sig(f)[2] for f in train.filename]); seq=np.array([sig(f)[3] for f in train.filename])
    tsit=np.array([sig(f)[0] for f in targets.filename]); tdat=np.array([sig(f)[1] for f in targets.filename]); tsec=np.array([sig(f)[2] for f in targets.filename]); tseq=np.array([sig(f)[3] for f in targets.filename])
    for i in range(len(targets)):
        m=(site==tsit[i])&(date==tdat[i])
        if exclude is not None: m=m&exclude
        if not m.any(): continue
        w=np.exp(-np.abs(sec[m]-tsec[i])/300.)*np.exp(-np.abs(seq[m]-tseq[i])/30.)
        out[i]=(w[:,None]*Yv[m]).sum(0)/(w.sum()+1e-9)
    return out
cv=pd.read_csv('final_solution/components/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cv.rec_id,cv.fold))).values
Pw=np.zeros((n,19))
