"""Generic greedy blender over all published component OOF/test predictions.

- Components are per-class z-scored across recs.
- Score = sum w_k * Z_k + lam * logit(train prevalence_c)   (micro-AUC prior offset)
- Honest OOF priors for group/session/kNN are precomputed using fold-restricted siblings.
- Greedy forward selection on shared 5-fold OOF micro AUC; leave-fold-out check.
"""
import sys, os, glob, numpy as np, pandas as pd, warnings
warnings.filterwarnings("ignore")
sys.path.insert(0, "/download_job_code/payload/sandbox/workspaces/arcturus_kappa")
import common as C
from sklearn.metrics import roc_auc_score

WS = "/download_job_code/payload/sandbox/workspaces/arcturus_kappa"
ROOT = "/download_job_code/payload/sandbox/workspaces"
tr, Y, te, Yt = C.load_labels()
cv = pd.read_csv(f"{ROOT}/castor_rho/shared/cv_folds.csv")
fm = dict(zip(cv.rec_id, cv.fold)); ftr = tr.rec_id.map(fm).values
folds = [(np.where(ftr != k)[0], np.where(ftr == k)[0]) for k in range(5)]

def load_long(path, ids):
    d = pd.read_csv(path).set_index("rec_id").reindex(ids)
    cols = [f"pred_{i}" for i in range(19)]
    return d[cols].values.astype(float)

def z(P):
    Q = np.zeros_like(P, float)
    for c in range(P.shape[1]):
        sd = P[:, c].std()
        Q[:, c] = (P[:, c] - P[:, c].mean()) / (sd + 1e-9) if sd > 1e-12 else 0.0
    return Q

# ---- component OOF/TEST registry ----
comp = {}
def add(name, oof_path, test_path):
    if os.path.exists(oof_path) and os.path.exists(test_path):
        comp[name] = (load_long(oof_path, tr.rec_id.values), load_long(test_path, te.rec_id.values))
        o = comp[name][0]
        print(f"loaded {name:22s} micro={C.global_auc(Y,o):.4f} macro={C.per_class_auc(Y,o)[0]:.4f}")
    else:
        print("missing", name)

add("bn_h05max", f"{ROOT}/castor_rho/oof/birdnet_h05max_oof.csv", f"{ROOT}/castor_rho/oof/birdnet_h05max_test.csv")
add("bn_globalmax", f"{ROOT}/castor_rho/oof/birdnet_globalmax_oof.csv", f"{ROOT}/castor_rho/oof/birdnet_globalmax_test.csv")
add("bne_probe", f"{ROOT}/castor_rho/oof/bne_probe_oof.csv", f"{ROOT}/castor_rho/oof/bne_probe_test.csv")
add("bme_probe", f"{ROOT}/castor_rho/oof/bme_probe_oof.csv", f"{ROOT}/castor_rho/oof/bme_probe_test.csv")
# my models
add("audio", f"{WS}/oof/audio_oof.csv", f"{WS}/oof/audio_test.csv")
add("provided", f"{WS}/oof/provided_oof.csv", f"{WS}/oof/provided_test.csv")
add("meta", f"{WS}/oof/meta_oof.csv", f"{WS}/oof/meta_test.csv")
add("mil_seg", f"{WS}/oof/mil_seg_oof.csv", f"{WS}/oof/mil_seg_test.csv")
# alderamin models (if published)
for p in glob.glob(f"{ROOT}/alderamin_phi/oof/*_oof.csv"):
    nm = os.path.basename(p)[:-8]
    add("ald_" + nm, p, p[:-8] + "_test.csv")

# priors (honest OOF)
h = np.load(f"{WS}/priors_honest.npz")
w = np.load(f"{WS}/priors_weighted.npz")
comp["prior_grp"] = (h["Pg"], h["Tg"])
comp["prior_sess"] = (h["Ps"], h["Ts"])
comp["prior_wtd"] = (w["Pw"], w["Tw"])
# kNN prior on BirdNET embeddings
d = np.load(f"{ROOT}/castor_rho/artifacts/birdnet_emb.npz", allow_pickle=True)
E = pd.DataFrame(d["emb"], index=d["rec_id"])
ids = np.concatenate([tr.rec_id.values, te.rec_id.values])
E = E.reindex(ids).values.astype(float)
E = E / (np.linalg.norm(E, axis=1, keepdims=True) + 1e-9)
n = len(tr); Et = E[:n]
K = np.zeros((n, 19)); KT = np.zeros((len(te), 19))
for i in range(n):
    idx = np.where(ftr != ftr[i])[0]
    s = Et[idx] @ Et[i]; top = idx[np.argsort(-s)[:20]]; ss = Et[top] @ Et[i]
    ww = np.exp((ss - ss.max()) / 0.02)
    K[i] = (ww[:, None] * Y[top]).sum(0) / ww.sum()
for i in range(len(te)):
    s = Et @ E[n + i]; top = np.argsort(-s)[:20]; ss = s[top]
    ww = np.exp((ss - ss.max()) / 0.02)
    KT[i] = (ww[:, None] * Y[top]).sum(0) / ww.sum()
comp["knn20"] = (K, KT)

Z = {k: (z(v[0]), z(v[1])) for k, v in comp.items()}
prior = Y.mean(0); lp = np.log(prior / (1 - prior))
LAM = 0.35

def score(weights, idx=None, part="oof"):
    S = np.zeros_like(Y, float) if part == "oof" else np.zeros((len(te), 19))
    for k, wt in weights.items():
        S += wt * Z[k][0 if part == "oof" else 1]
    return S + LAM * lp[None, :]

def mic(S):
    return roc_auc_score(Y.ravel(), S.ravel())
def mac(S):
    return C.per_class_auc(Y, S)[0]

# greedy forward selection
cands = [k for k in Z if not k.startswith("ald_")]
weights = {}
best = -1
for step in range(10):
    gains = []
    for k in cands:
        for wt in [0.05, 0.1, 0.15, 0.2, 0.3]:
            w2 = dict(weights); w2[k] = w2.get(k, 0) + wt
            m = mic(score(w2))
            gains.append((m, k, wt, w2))
    gains.sort(reverse=True, key=lambda x: x[0])
    m, k, wt, w2 = gains[0]
    if m <= best + 0.0004:
        break
    best, weights = m, w2
    print(f"step {step+1}: +{k} w={wt} -> micro={m:.4f} macro={mac(score(weights)):.4f}", flush=True)

print("\nfinal weights", weights)
So = score(weights)
St = score(weights, part="test")
print("OOF micro=%.4f macro=%.4f" % (mic(So), mac(So)))

# leave-fold-out honesty: weights chosen on 4 folds, eval held fold (with priors already fold-restricted)
lf = []
for k in range(5):
    ti = np.where(ftr != k)[0]; vi = np.where(ftr == k)[0]
    wts = {}
    b = -1
    for step in range(8):
        gs = []
        for cname in cands:
            for wt in [0.05, 0.1, 0.15, 0.2, 0.3]:
                w2 = dict(wts); w2[cname] = w2.get(cname, 0) + wt
                S = sum(wt2 * Z[cname2][0][ti] for cname2, wt2 in w2.items()) + LAM * lp[None, :]
                m = roc_auc_score(Y[ti].ravel(), S.ravel())
                gs.append((m, cname, wt, w2))
        gs.sort(reverse=True, key=lambda x: x[0])
        m, cname, wt, w2 = gs[0]
        if m <= b + 0.0006: break
        b, wts = m, w2
    S = sum(wt2 * Z[cname2][0][vi] for cname2, wt2 in wts.items()) + LAM * lp[None, :]
    a = roc_auc_score(Y[vi].ravel(), S.ravel()); lf.append(a)
    print(f"holdout fold {k}: micro={a:.4f} weights={ {kk: round(vv,2) for kk,vv in wts.items()} }")
print("leave-fold-out mean micro=%.4f" % np.mean(lf))

np.savez(f"{WS}/blend_final.npz", So=So, St=St, Y=Y, weights=np.array(list(weights.items()), dtype=object))
# submission
rows = []
for i, rid in enumerate(te.rec_id.values):
    for c in range(19):
        rows.append((int(rid) * 100 + c, float(1 / (1 + np.exp(-St[i, c])))))
sub = pd.DataFrame(rows, columns=["Id", "Probability"]).sort_values("Id")
sub.to_csv(f"{WS}/candidate_submission.csv", index=False)
print("wrote candidate_submission.csv", sub.shape)
