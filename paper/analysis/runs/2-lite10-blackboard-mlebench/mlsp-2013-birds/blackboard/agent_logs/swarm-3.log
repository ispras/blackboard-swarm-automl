import pandas as pd, numpy as np, os, warnings, math, torch, torch.nn as nn, torch.nn.functional as F
warnings.filterwarnings('ignore')
import timm
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import KFold
torch.manual_seed(42); np.random.seed(42)
dev='cuda' if torch.cuda.is_available() else 'cpu'; print('dev',dev,flush=True)
df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl').sort_values('rec_id').reset_index(drop=True)
cvf=pd.read_csv('workspaces/castor_rho/shared/cv_folds.csv'); df=df.merge(cvf,on='rec_id',how='left')
tr=df[df.fold_x==0].reset_index(drop=True); te=df[df.fold_x==1].reset_index(drop=True)
Y=np.zeros((len(tr),19),dtype=np.float32)
for i,l in enumerate(tr.labs):
    for s in l: Y[i,s]=1
LM='/download_job_code/payload/sandbox/workspaces/alderamin_phi/logmel'
def load(rid): return np.load(f'{LM}/{int(rid)}.npy').astype(np.float32)
Xtr=[load(r) for r in tr.rec_id]; Xte=[load(r) for r in te.rec_id]
folds=[np.where(tr.fold_y.values==k)[0] for k in sorted(tr.fold_y.unique())]

def aug(x, train=True):
    t=x
    if train:
        # random time crop between 75%-100% then pad/crop to 501
        L=t.shape[1]; keep=np.random.randint(int(L*0.75),L)
        st=np.random.randint(0,L-keep); t=t[:,st:st+keep]
        if keep<L: t=np.pad(t,((0,0),(0,L-keep)),mode='constant')
        t=t+np.random.uniform(-0.2,0.2)
        # spec augment
        for _ in range(2):
            f0=np.random.randint(0,128-12); t[f0:f0+np.random.randint(4,13),:]=0
        for _ in range(2):
            w=np.random.randint(10,50); t0=np.random.randint(0,max(1,501-w)); t[:,t0:t0+w]=0
    return torch.tensor(t)[None]
def batch_to_tensor(arrs):
    return torch.stack(arrs).to(dev)
def make_model():
    return timm.create_model('resnet18',pretrained=True,in_chans=1,num_classes=19,drop_rate=0.2,drop_path_rate=0.1).to(dev)
def predict(model,xs,tta=False):
    model.eval(); outs=[]
    with torch.no_grad():
        for x in xs:
            arrs=[aug(x,False)]
            if tta:
                arrs=[aug(x,False), torch.tensor(x[:,:420])[None], torch.tensor(x[:,80:])[None]]
            imgs=torch.stack(arrs).to(dev)  # 3,1,128,501
            imgs=F.interpolate(imgs,size=(224,224),mode='bilinear',align_corners=False)
            p=torch.sigmoid(model(imgs)).mean(0).cpu().numpy(); outs.append(p)
    return np.stack(outs)
def run_fold(fi):
    torch.manual_seed(42+fi); np.random.seed(42+fi)
    vi=folds[fi]; ti=np.setdiff1d(np.arange(len(tr)),vi)
    model=make_model(); opt=torch.optim.AdamW(model.parameters(),lr=3e-4,weight_decay=1e-4)
    EPOCHS=30; sch=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=EPOCHS)
    n=len(ti); bs=16
    for ep in range(EPOCHS):
        model.train(); perm=np.random.permutation(ti)
        for i in range(0,n,bs):
            idx=perm[i:i+bs]
            xb=torch.stack([aug(Xtr[j],True) for j in idx]).to(dev)
            xb=F.interpolate(xb,size=(224,224),mode='bilinear',align_corners=False)
            yb=torch.tensor(Y[idx]).to(dev)
            if np.random.rand()<0.5:
                lam=np.random.beta(0.4,0.4)
                pi=torch.randperm(len(idx),device=dev)
                xb=lam*xb+(1-lam)*xb[pi]; yb=lam*yb+(1-lam)*yb[pi]
            opt.zero_grad(); loss=F.binary_cross_entropy_with_logits(model(xb),yb); loss.backward(); opt.step()
        sch.step()
        if ep%10==9 or ep==EPOCHS-1:
            pv=predict(model,[Xtr[j] for j in vi]); auc=roc_auc_score(Y[vi].ravel(),pv.ravel())
            print(f'fold{fi} ep{ep} valmicro={auc:.4f}',flush=True)
    pv=predict(model,[Xtr[j] for j in vi],tta=True)
