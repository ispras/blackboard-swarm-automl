import pandas as pd, numpy as np, warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler, QuantileTransformer
from sklearn.pipeline import make_pipeline
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.metrics import roc_auc_score
import lightgbm as lgb

df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl').sort_values('rec_id').reset_index(drop=True)
cvf=pd.read_csv('workspaces/castor_rho/shared/cv_folds.csv')
df=df.merge(cvf,on='rec_id',how='left')
bn=pd.read_csv('workspaces/castor_rho/artifacts/birdnet_probs.csv')
df=df.merge(bn,on='rec_id',how='left')
emb=np.load('workspaces/castor_rho/artifacts/birdnet_emb.npz')
embd={int(r):e for r,e in zip(emb['rec_id'],emb['emb'])}
df['emb']=[embd.get(r) for r in df.rec_id]
tr=df[df.fold_x==0].reset_index(drop=True)
Y=np.zeros((len(tr),19),dtype=int)
for i,l in enumerate(tr.labs):
    for s in l: Y[i,s]=1
folds=[tr.index[tr.fold_y==k].values for k in sorted(tr.fold_y.dropna().unique())]
print('fold sizes',[len(f) for f in folds])

bncols=[f'bn_max_{s}' for s in range(19)]
bnm=[f'bn_mean_{s}' for s in range(19)]
bnt=[f'bn_top2_{s}' for s in range(19)]
Xbn=tr[bncols].values
Xbn3=tr[bncols+bnm+bnt].values
Xmeta=np.stack(tr.meta_feat.values); Xspec=np.stack(tr.spec_feat.values)
Xemb=np.stack(tr.emb.values)

def init():
    return np.full((len(tr),19),np.nan)
def evaluate(oof,name):
    aucs=[]
    for s in range(19):
        y=Y[:,s]
        if y.sum()>0 and y.sum()<len(y):
            aucs.append(roc_auc_score(y,oof[:,s]))
    flat=roc_auc_score(Y.ravel(),oof.ravel())
    print(f'{name}: macro={np.mean(aucs):.4f} micro={flat:.4f} |', ' '.join(f'{a:.3f}' for a in aucs))
    return oof, np.mean(aucs)

def run_cv(X,name,model_fn,rank=False):
    oof=init()
    for ti,vi in [(np.setdiff1d(np.arange(len(tr)),v),v) for v in folds]:
        for s in range(19):
            y=Y[ti,s]
            if y.sum()==0: oof[vi,s]=0; continue
            if y.sum()==len(y): oof[vi,s]=1; continue
            m=model_fn(); m.fit(X[ti],y)
            oof[vi,s]=m.predict_proba(X[vi])[:,1]
    return evaluate(oof,name)

# zero-shot baselines
for c,n in [(bncols,'bn_max'),(bnt,'bn_top2'),(bncols+bnm+bnt,'bn_3agg')]:
    evaluate(tr[c].values,n+'_zeroshot')

lr=lambda C=0.3: make_pipeline(StandardScaler(),LogisticRegression(C=C,max_iter=3000))
# bn + metadata
run_cv(np.hstack([Xbn,Xmeta]),'bn+meta_LR0.3',lambda: lr(0.3))
run_cv(np.hstack([Xbn3,Xmeta]),'bn3+meta_LR0.3',lambda: lr(0.3))
# meta only with shared folds
run_cv(Xmeta,'meta_LR0.5',lambda: lr(0.5))
run_cv(Xmeta,'meta_ET',lambda: ExtraTreesClassifier(500,min_samples_leaf=3,n_jobs=8,random_state=0))
# spec only
run_cv(Xspec,'spec_LR0.05',lambda: lr(0.05))
run_cv(Xspec,'spec_ET',lambda: ExtraTreesClassifier(500,min_samples_leaf=2,n_jobs=8,random_state=0))
# bn + meta + spec
run_cv(np.hstack([Xbn3,Xmeta,Xspec]),'bn3+meta+spec_LR0.1',lambda: lr(0.1))
run_cv(np.hstack([Xbn3,Xmeta,Xspec]),'bn3+meta+spec_ET',lambda: ExtraTreesClassifier(700,min_samples_leaf=2,max_features=0.3,n_jobs=8,random_state=0))
run_cv(np.hstack([Xbn3,Xmeta,Xspec]),'bn3+meta+spec_LGB',lambda: lgb.LGBMClassifier(n_estimators=250,learning_rate=0.03,num_leaves=7,subsample=0.8,colsample_bytree=0.4,reg_lambda=2,n_jobs=8,verbose=-1))
# embeddings
run_cv(np.hstack([Xemb,Xmeta]),'emb+meta_LR0.01',lambda: lr(0.01))
run_cv(np.hstack([Xemb,Xmeta,Xbn3]),'emb+meta+bn3_LR0.01',lambda: lr(0.01))
