warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline
from sklearn.ensemble import ExtraTreesClassifier

out='workspaces/alderamin_phi/oof'
df=pd.read_pickle('workspaces/alderamin_phi/feats.pkl').sort_values('rec_id').reset_index(drop=True)
bn=pd.read_csv('workspaces/castor_rho/artifacts/birdnet_probs.csv'); df=df.merge(bn,on='rec_id',how='left')
emb=np.load('workspaces/castor_rho/artifacts/birdnet_emb.npz')
embd={int(r):e for r,e in zip(emb['rec_id'],emb['emb'])}; df['emb']=[embd[r] for r in df.rec_id]
tr=df[df.fold==0].reset_index(drop=True); te=df[df.fold==1].reset_index(drop=True)
Y=np.zeros((len(tr),19),dtype=int)
for i,l in enumerate(tr.labs):
    for s in l: Y[i,s]=1
bncols=[f'bn_max_{s}' for s in range(19)]; bnm=[f'bn_mean_{s}' for s in range(19)]; bnt=[f'bn_top2_{s}' for s in range(19)]
def X(d):
    return {'meta':np.stack(d.meta_feat.values),'spec':np.stack(d.spec_feat.values),
            'emb':np.stack(d.emb.values),'bn3':d[bncols+bnm+bnt].values,'bn':d[bncols].values}
Xtr,Xte=X(tr),X(te)
lr=lambda C=0.3: make_pipeline(StandardScaler(),LogisticRegression(C=C,max_iter=3000))
def fit_predict(Xtr,Xte,model_fn):
    P=np.zeros((len(te),19))
    for s in range(19):
        y=Y[:,s]
        if y.sum()==0: P[:,s]=0; continue
        if y.sum()==len(y): P[:,s]=1; continue
        m=model_fn(); m.fit(Xtr,y); P[:,s]=m.predict_proba(Xte)[:,1]
    return P
def save(name, oof_path, Ptest):
    O=np.load(oof_path)
    oof=pd.DataFrame(O,columns=[f'pred_{s}' for s in range(19)]); oof.insert(0,'rec_id',tr.rec_id.values)
    test=pd.DataFrame(Ptest,columns=[f'pred_{s}' for s in range(19)]); test.insert(0,'rec_id',te.rec_id.values)
    oof.to_csv(f'{out}/{name}_oof.csv',index=False); test.to_csv(f'{out}/{name}_test.csv',index=False)
    print('saved',name,oof.shape,test.shape)
specs=[
 ('meta_LR',lambda: lr(0.5),'meta','meta'),
 ('meta_ET',lambda: ExtraTreesClassifier(500,min_samples_leaf=3,n_jobs=8,random_state=0),'meta','meta'),
 ('spec_ET',lambda: ExtraTreesClassifier(500,min_samples_leaf=2,n_jobs=8,random_state=0),'spec','spec'),
 ('bn3_meta_spec_ET',lambda: ExtraTreesClassifier(700,min_samples_leaf=2,max_features=0.3,n_jobs=8,random_state=0),'all3','all3'),
 ('emb_meta_LR',lambda: lr(0.01),'embmeta','embmeta'),
 ('emb_meta_bn3_LR',lambda: lr(0.01),'embmetabn3','embmetabn3'),
]
def getX(dic,kind):
