import os, sys, time
os.environ['OMP_NUM_THREADS']='4'
sys.path.insert(0,'vendor')
import numpy as np, pandas as pd, librosa
from birdnetlib.analyzer import Analyzer
SCI=["Certhia americana","Troglodytes pacificus","Empidonax difficilis","Sitta canadensis","Junco hyemalis","Contopus cooperi","Catharus guttatus","Poecile rufescens","Ixoreus naevius","Setophaga occidentalis","Catharus ustulatus","Empidonax hammondii","Piranga ludoviciana","Pheucticus melanocephalus","Regulus satrapa","Vireo gilvus","Geothlypis tolmiei","Cyanocitta stelleri","Chordeiles minor"]
base='/download_job_code/payload/sandbox'; rec2f={}
for line in open(f'{base}/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
an=Analyzer(); an.load_model(); labels=[l.strip() for l in open(an.label_path)]
labmap={}
for i,l in enumerate(labels): labmap.setdefault(l.split('_')[0],i)
tgt=[labmap[s] for s in SCI]; interp=an.interpreter
SR=48000; win=3*SR; hop=int(0.5*SR)
P=[]; R=[]; ST=[]
t0=time.time()
for n,(rid,fn) in enumerate(sorted(rec2f.items())):
    y,_=librosa.load(f'{base}/data/essential_data/src_wavs/{fn}.wav',sr=SR,mono=True)
    if len(y)<win: y=np.pad(y,(0,win-len(y)))
    starts=list(range(0,len(y)-win+1,hop))
    if starts[-1]+win<len(y): starts.append(len(y)-win)
    ps=[]
    for st in starts:
        c=np.ascontiguousarray(y[st:st+win],dtype='float32')[None,:]
        interp.resize_tensor_input(0,[1,win]); interp.allocate_tensors(); interp.set_tensor(0,c); interp.invoke()
        lg=interp.get_tensor(546)[0]; ps.append(1/(1+np.exp(-np.clip(lg,-15,15)))[tgt])
    P.append(np.array(ps,dtype=np.float32)); R.append(rid); ST.append(np.array(starts)/SR)
    if n%50==0: print(n,round(time.time()-t0,1),flush=True)
np.savez_compressed('artifacts/birdnet_h05_windows.npz',rec_id=np.array(R),probs=np.array(P,dtype=object),starts=np.array(ST,dtype=object))
print('DONE',round(time.time()-t0,1),flush=True)
