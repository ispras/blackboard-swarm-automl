import os, sys, numpy as np, pandas as pd
from scipy.special import logit
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution'); import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
FIN='/download_job_code/payload/sandbox/final_solution/components/'
def rd(p): d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
P={'perch':rd(FIN+'perch_pcr_max_oof.csv'),'bn3dn':rd(FIN+'bn3_dn_oof.csv'),'bn':rd(FIN+'birdnet_h05max_oof.csv'),'pp':rd(FIN+'perch_probe_oof.csv'),'mlpp':rd(FIN+'mlp_perch_ens5_oof.csv'),'mlpa':rd(FIN+'mlp_all_avg3_oof.csv'),'dn':rd(FIN+'perch_dn_oof.csv'),'meta':rd(FIN+'meta_LR_oof.csv'),'mlp_embmeta':rd(FIN+'mlp_embmeta_oof.csv')}
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
W={'perch':1.0,'bn3dn':1.0,'bn':0.2,'pp':0.1,'mlpp':0.1,'mlpa':0.3,'dn':0.15,'meta':0.1,'pw':0.2}
def zm(A): 
    return (A-A.mean(0))/(A.std(0)+1e-9)
rng=np.random.default_rng(61); N=500; res={}
for it in range(N):
    mask=np.zeros(len(ids),bool); mask[rng.choice(len(ids),64,replace=False)]=True
    va=np.where(mask)[0]; trn=np.where(~mask)[0]
    Pw=SOL.session_prior(tr.iloc[trn].reset_index(drop=True),Y[trn],tr.iloc[va].reset_index(drop=True))
    lp=logit(np.clip(Y[trn].mean(0),.01,.99)); mp=np.clip((P['mlpp'][va].mean(0)+P['mlp_embmeta'][va].mean(0))/2,.01,.99); off=1.1*(0.2*lp+0.8*logit(mp))
    Z={k:zm(P[k][va]) for k in P if k!='mlp_embmeta'}; Z['pw']=zm(Pw)
    ac={'perch','bn3dn','bn','pp','mlpp','mlpa','dn'}
    variants={}
    variants['clip_all']=sum(W[k]*np.clip(Z[k],-1.5,1.5) for k in W)
    variants['clip_ac']=sum(W[k]*(np.clip(Z[k],-1.5,1.5) if k in ac else Z[k]) for k in W)
    variants['clip_bn3']=sum(W[k]*(np.clip(Z[k],-1.5,1.5) if k in ('bn3dn','perch') else Z[k]) for k in W)
    Sk=sum(W[k]*Z[k] for k in W); variants['clip_sum']=np.clip(Sk,-2,2)
    for nm,S in variants.items():
        res.setdefault(nm,[]).append(roc_auc_score(Y[va].ravel(),(S+off[None,:]).ravel()))
for k,v in res.items():
    v=np.array(v); print(f'{k:10s} mean {v.mean():.4f} q10 {np.quantile(v,.1):.4f} q90 {np.quantile(v,.9):.4f}')
EOF
