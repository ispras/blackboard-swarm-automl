folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
FIN='/download_job_code/payload/sandbox/final_solution/components/'
def rd(p): d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
P={'perch':rd(FIN+'perch_pcr_max_oof.csv'),'bn':rd(FIN+'birdnet_h05max_oof.csv'),'pp':rd(FIN+'perch_probe_oof.csv'),'mlpp':rd(FIN+'mlp_perch_ens5_oof.csv')}
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
cvf=pd.read_csv('shared/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cvf.rec_id,cvf.fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
P['pw']=Pw
W={'perch':1.0,'bn':0.2,'pp':0.2,'mlpp':0.2,'pw':0.2}; lam=0.75
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
S=sum(W[k]*z(P[k]) for k in W)+lam*logit(np.clip(Y.mean(0),.01,.99))[None,:]
# metadata
rec2f={}
for line in open('/download_job_code/payload/sandbox/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
md={}
for r,fn in rec2f.items():
    m=re.match(r'([A-Za-z0-9]+)_(\d{8})_(\d{6})_(\d+)',fn); s,d,t,i=m.groups(); md[r]=(s,d,t)
has_grp=np.array([any(q!=r and md[q][:3]==md[r][:3] for q in ids) for r in ids])
has_sess=np.array([any(q!=r and md[q][:2]==md[r][:2] for q in ids) for r in ids])
print('no_grp',(~has_grp).sum(),'no_sess',(~has_sess).sum())
def load(path):
    zz=np.load(path); rid={r:i for i,r in enumerate(zz['rec_id'])}; return zz['emb'][[rid[r] for r in ids]]
E={'perch':load('artifacts/perch2_emb.npz')}; E['bne']=load('artifacts/birdnet_emb.npz'); E['cat']=np.concatenate([E['perch'],E['bne']],1)
def knn(X,k,power=3):
    Xn=normalize(X); SS=Xn@Xn.T; Pk=np.zeros((len(ids),19))
    for f in range(5):
        va=np.where(folds==f)[0]; trn=np.where(folds!=f)[0]; sv=SS[np.ix_(va,trn)]
        for i,vi in enumerate(va):
            sim=sv[i]; o=np.argsort(-sim)[:k]; w=np.clip(sim[o],0,None)**power
            Pk[vi]=Y[trn[o]].T@w/w.sum()
    return Pk
def ev(Q,label):
    ma,mi=macro_auc(Y,Q),micro_auc(Y,Q)
    mg=~has_grp; ms=~has_sess
    a1=roc_auc_score(Y[mg].ravel(),Q[mg].ravel()); a2=roc_auc_score(Y[ms].ravel(),Q[ms].ravel())
    print(f'{label}: all micro {mi:.4f} macro {ma:.4f} | no_grp micro {a1:.4f} | no_sess micro {a2:.4f}')
ev(S,'base')
for en in ['perch','bne','cat']:
    for k in [10,20,50]:
        Pk=knn(E[en],k); Zk=z(Pk)
        for w in [0.05,0.1,0.15,0.2,0.3]:
            for mask_name,mask in [('nogrp',~has_grp),('nosess',~has_sess)]:
                Q=S+w*Zk*mask[:,None]
                # only print promising/selected
                if w in [0.1,0.2] and k in [20,50]:
                    ev(Q,f'+knn {en} k{k} w{w} {mask_name}')
EOF
