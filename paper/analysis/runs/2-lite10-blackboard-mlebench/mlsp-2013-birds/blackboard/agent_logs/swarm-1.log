import numpy as np, pandas as pd, os
from scipy.special import logit
from sklearn.metrics import roc_auc_score
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
ARC='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/oof/'
ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'
paths={
 'perch':'oof/perch_pc_max_{}.csv','perch_mean':'oof/perch_pc_mean_{}.csv',
 'perch_rawmax':'oof/perch_pcr_max_{}.csv','perch_rawmean':'oof/perch_pcr_mean_{}.csv',
 'perch_probe':'oof/perch_probe_{}.csv',
 'bn_h05':'oof/birdnet_h05max_{}.csv','bn_global':ARC+'birdnet_{}.csv','bne':'oof/bne_probe_{}.csv','bme':'oof/bme_probe_{}.csv',
 'winfeat':'oof/winfeat_et_{}.csv','prior_g':'oof/prior_grp_{}.csv','prior_s':'oof/prior_sess_{}.csv',
 'meta_arc':ARC+'meta_{}.csv','audio_arc':ARC+'audio_{}.csv','provided_arc':ARC+'provided_{}.csv',
 'meta_lr_ald':ALD+'meta_LR_{}.csv','meta_et_ald':ALD+'meta_ET_{}.csv','spec_et_ald':ALD+'spec_ET_{}.csv',
 'emb_meta_lr_ald':ALD+'emb_meta_LR_{}.csv','emb_meta_bn3_lr_ald':ALD+'emb_meta_bn3_LR_{}.csv',
 'bn3_meta_spec_et_ald':ALD+'bn3_meta_spec_ET_{}.csv','mlp_embmeta_ald':ALD+'mlp_embmeta_{}.csv','cnn_raw_ald':ALD+'cnn_raw_{}.csv',
}
O={};T={}
for k,p in paths.items():
    try:
        do=pd.read_csv(p.format('oof')).set_index('rec_id'); dt=pd.read_csv(p.format('test')).set_index('rec_id')
        O[k]=do.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
        T[k]=dt.reindex(test)[[f'pred_{j}' for j in range(19)]].values
        assert not np.isnan(O[k]).any() and not np.isnan(T[k]).any()
    except Exception as e: print('skip',k,e)
print('loaded',len(O),list(O))
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
Z={k:z(v) for k,v in O.items()}; ZT={k:z(v) for k,v in T.items()}
prev=Y.mean(0); lp=logit(np.clip(prev,0.01,0.99))
for k in O: print(f'{k:22s} micro {micro_auc(Y,O[k]):.4f} macro {macro_auc(Y,O[k])[0]:.4f}')
wgrid=[0,0.02,0.05,0.1,0.15,0.2,0.3,0.5,0.75]
W={k:0.0 for k in O}; W['perch']=1.0; lam=0.3
def score(W,lam,Zm): return sum(W[k]*Zm[k] for k in Zm)+lam*lp[None,:]
def ev(W,lam):
    S=score(W,lam,Z); return micro_auc(Y,S), macro_auc(Y,S)[0]
best=ev(W,lam); print('start',best)
for r in range(4):
    for k in W:
        if k=='perch': continue
        cur=W[k]; b=(best[0],cur)
        for w in wgrid:
            W[k]=w; v=ev(W,lam)[0]
            if v>b[0]: b=(v,w)
        W[k]=b[1]; best=ev(W,lam)
    # tune lam
    bl=(best[0],lam)
    for L in [0,0.05,0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.5,0.6,0.8]:
        v=ev(W,L)[0]
        if v>bl[0]: bl=(v,L)
    lam=bl[1]; best=ev(W,lam)
    print(f'round{r}',best,'lam',lam,{k:round(v,2) for k,v in W.items() if v>0})
mi,ma=ev(W,lam); print(f'FINAL OOF micro {mi:.4f} macro {ma:.4f}')
np.savez('blend_all_weights.npz',W=np.array([W[k] for k in W]),keys=np.array(list(W)),lam=lam)
# save test scores and submission candidate
St=score(W,lam,ZT)
np.savez('candidate_all.npz',So=score(W,lam,Z),St=St,Y=Y,rec_tr=ids,rec_te=test)
def submission(S,path):
    rows=[]
    for i,rid in enumerate(test):
        for c in range(19): rows.append((int(rid)*100+c,float(1/(1+np.exp(-S[i,c])))))
    d=pd.DataFrame(rows,columns=['Id','Probability']).sort_values('Id'); d.to_csv(path,index=False); print('sub',path,d.shape)
submission(St,'candidate_perch.csv')
# honest leave-fold-out with fixed W (deployment-like z within eval set)
mis=[];mas=[]
for f in range(5):
    va=folds==f; tr=~va
    prevf=Y[tr].mean(0); lpf=logit(np.clip(prevf,0.01,0.99))
    S=np.zeros((va.sum(),19))
    for c in range(19):
        for k in W: S[:,c]+=W[k]*((O[k][va,c]-O[k][va,c].mean())/(O[k][va,c].std()+1e-9))
    S=S+lpf[None,:]
    mis.append(roc_auc_score(Y[va].ravel(),S.ravel())); mas.append(macro_auc(Y[va],S)[0])
print('HONEST within-fold mean micro',np.mean(mis),'macro',np.mean(mas),'perfold',[round(x,4) for x in mis])
