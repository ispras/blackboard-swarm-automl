import numpy as np, pandas as pd
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
z=np.load('artifacts/birdnet_h05_windows.npz',allow_pickle=True)
rid2p={int(r):p for r,p in zip(z['rec_id'],z['probs'])}
Pgrp=np.load('artifacts/prior_grp_train.npy')
def agg(p):
    n=p.shape[0]; srt=np.sort(p,axis=0)
    d={'max':p.max(0),'mean':p.mean(0),'top2':srt[-min(2,n):].mean(0),'top3':srt[-min(3,n):].mean(0),
       'top5':srt[-min(5,n):].mean(0),'q90':np.quantile(p,0.9,axis=0),'q75':np.quantile(p,0.75,axis=0)}
    for w in [2,3]:
        if n>=w:
            roll=np.stack([p[i:i+w].mean(0) for i in range(n-w+1)]).max(0); d[f'roll{w}']=roll
        else: d[f'roll{w}']=p.max(0)
    for tau in [0.05,0.1,0.2,0.35]:
        d[f'cnt{tau}']=(p>tau).mean(0)
    return d
res={}
for rid in ids:
    for k,v in agg(rid2p[rid]).items(): res.setdefault(k,{})[rid]=v
for k in res:
    P=np.stack([res[k][r] for r in ids])
    ma,mi=report(Y,P,k)
    for w in [0.05,0.1]:
        m2,_=macro_auc(Y,(1-w)*P+w*Pgrp); mi2=micro_auc(Y,(1-w)*P+w*Pgrp)
        print(f'   +prior w{w}: macro {m2:.4f} micro {mi2:.4f}')
# combinations (max + roll2 + cnt)
for combo in [('max','roll2'),('max','cnt0.1'),('max','roll2','cnt0.1'),('top3','max'),('max','top2','roll2')]:
    P=np.mean([np.stack([res[k][r] for r in ids]) for k in combo],0)
    ma,mi=report(Y,P,'+'.join(combo))
EOF
