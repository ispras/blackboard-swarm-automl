import pandas as pd, numpy as np, re
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab); pos={r:i for i,r in enumerate(ids)}
rec2f={}
for line in open('/download_job_code/payload/sandbox/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
def parse(fn):
    m=re.match(r'([A-Za-z0-9]+)_(\d{8})_(\d{6})_(\d+)',fn); return m.groups()
rows=[]
for r,fn in rec2f.items():
    site,date,tm,idx=parse(fn); rows.append({'rec_id':r,'site':site,'date':date,'time':tm,'split':'test' if r in test else 'train'})
df=pd.DataFrame(rows).set_index('rec_id'); df['sess']=df.site+'_'+df.date; df['grp']=df.sess+'_'+df.time
for key in ['grp','sess']:
    prior=np.zeros((len(ids),19))
    for i,r in enumerate(ids):
        sibs=[q for q in ids if q!=r and df.loc[q,key]==df.loc[r,key]]
        if sibs: prior[i]=Y[[pos[q] for q in sibs]].mean(0)
    report(Y,prior,f'prior_{key} alone')
    np.save(f'artifacts/prior_{key}_train.npy',prior)
    # test prior
    P=np.zeros((len(test),19))
    for i,r in enumerate(test):
        sibs=[q for q in ids if df.loc[q,key]==df.loc[r,key]]
        if sibs: P[i]=Y[[pos[q] for q in sibs]].mean(0)
    np.save(f'artifacts/prior_{key}_test.npy',P)
    print(key,'test recs with train sib',int((P.sum(1)>0).sum()),'of',len(test))
# fuse with birdnet max by rank
bp=pd.read_csv('artifacts/birdnet_probs.csv').set_index('rec_id')
B=bp[[f'bn_max_{j}' for j in range(19)]].reindex(ids).values
from scipy.stats import rankdata
def rk(A): return np.stack([rankdata(A[:,j])/len(A) for j in range(A.shape[1])],1)
Btr=rk(B)
for key in ['grp','sess']:
    Pt=np.load(f'artifacts/prior_{key}_train.npy'); Pr=rk(Pt)
    for w in [0.1,0.2,0.3,0.5,0.7,1.0]:
        report(Y,(1-w)*Btr+w*Pr,f'fuse {key} w={w}')
EOF
