import numpy as np, pandas as pd, re
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab); pos={r:i for i,r in enumerate(ids)}
rec2f={}
for line in open('/download_job_code/payload/sandbox/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
meta={}
for r,fn in rec2f.items():
    m=re.match(r'([A-Za-z0-9]+)_(\d{8})_(\d{6})_(\d+)',fn); s,d,t,i=m.groups(); meta[r]=(s,d,t,int(i))
v=pd.read_csv('artifacts/birdnet_variants.csv').set_index('rec_id')
H=v.loc[ids,[f'bn_h05_max_{j}' for j in range(19)]].values
def build(weightfn, key='grp'):
    P=np.zeros((len(ids),19))
    for i,r in enumerate(ids):
        sib=[q for q in ids if q!=r and (meta[q][:3]==meta[r][:3] if key=='grp' else meta[q][:2]==meta[r][:2])]
        if not sib: continue
        w=np.array([weightfn(r,q) for q in sib]); w=w/w.sum()
        P[i]=Y[[pos[q] for q in sib]].T@w
    return P
variants={
 'equal':lambda r,q:1.0,
 'exp20':lambda r,q:np.exp(-abs(meta[r][3]-meta[q][3])/20),
 'inv10':lambda r,q:1/(1+abs(meta[r][3]-meta[q][3])/10),
 'near':lambda r,q: 1.0 if abs(meta[r][3]-meta[q][3])<=20 else 0.1,
 'exp50':lambda r,q:np.exp(-abs(meta[r][3]-meta[q][3])/50),
}
for key in ['grp','sess']:
    for nm,fn in variants.items():
        P=build(fn,key); ma,mi=report(Y,P,f'{key} {nm}')
        for w in [0.05,0.1,0.15]:
            m2,mi2=macro_auc(Y,(1-w)*H+w*P),micro_auc(Y,(1-w)*H+w*P)
            print(f'   +H w{w}: macro {m2:.4f} micro {mi2:.4f}')
EOF
