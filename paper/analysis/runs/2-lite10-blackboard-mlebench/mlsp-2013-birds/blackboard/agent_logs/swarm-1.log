import numpy as np, pandas as pd
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
v=pd.read_csv('artifacts/birdnet_variants.csv').set_index('rec_id').reindex(ids)
Pgrp=np.load('artifacts/prior_grp_train.npy')
cols={}
cols['max']=[f'bn_max_{j}' for j in range(19)]
for nm in ['full','h05','w5']:
    for agg in ['max','mean']:
        cols[f'{nm}_{agg}']=[f'bn_{nm}_{agg}_{j}' for j in range(19)]
for k,c in cols.items():
    B=v[c].values
    ma,mi=report(Y,B,f'BN {k}')
    for w in [0.1,0.2,0.3]:
        m2,_=macro_auc(Y,(1-w)*B+w*Pgrp)
        print(f'   +prior w{w}: {m2:.4f}')
# blend multiple aggregations equally
for combo in [['h05_max','w5_max','full_max'],['h05_mean','w5_mean','full_mean'],['h05_max','bn_max'],['h05_max','w5_max']]:
    B=np.mean([v[cols[c]].values for c in combo],0)
    ma,mi=report(Y,B,f'blend {combo}')
    for w in [0.2,0.3]:
        m2,_=macro_auc(Y,(1-w)*B+w*Pgrp); print(f'   +prior w{w}: {m2:.4f}')
EOF
