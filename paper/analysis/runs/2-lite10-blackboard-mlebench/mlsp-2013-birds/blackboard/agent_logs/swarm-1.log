import numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
z=np.load('artifacts/birdnet_emb.npz'); emb=z['emb']; rid=z['rec_id']
idx={r:i for i,r in enumerate(rid)}; X=emb[[idx[r] for r in ids]]
print('X',X.shape)
def run(npc,C):
    P=np.zeros((len(ids),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        for j in range(19):
            y=Y[:,j]
            if y[tr].sum()==0:
                P[va,j]=0; continue
            pipe=Pipeline([('sc',StandardScaler()),('pca',PCA(n_components=min(npc,X.shape[0],X.shape[1]))),('lr',LogisticRegression(C=C,max_iter=2000,class_weight='balanced'))])
            pipe.fit(X[tr],y[tr]); P[va,j]=pipe.predict_proba(X[va])[:,1]
    return report(Y,P,f'emb pca{npc} C{C}')
for npc in [32,64,128]:
    for C in [0.01,0.1,1.0]:
        run(npc,C)
