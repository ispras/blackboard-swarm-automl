"""Build OOF/test predictions for arcturus_kappa component models and the ensemble.

Components:
  - audio   : LR on handcrafted raw-WAV features (audio_feats.npz)
  - provided: LR on provided histogram_of_segments + aggregated segment features + metadata dummies
  - meta    : LR on recording metadata (site/month/hour/site_month/year/doy/minute)
  - birdnet : castor_rho zero-shot birdnet probs (pretrained, no fitting)  -> bn_max

Ensemble score (per class z-scored, then class-prior offset):
  S = Z(bn_max) + 0.10*Z(meta) + 0.10*Z(audio) + 0.05*Z(prov) + 0.30*logit(prior)
"""
import sys, numpy as np, pandas as pd, warnings
warnings.filterwarnings("ignore")
sys.path.insert(0, "/download_job_code/payload/sandbox/workspaces/arcturus_kappa")
import common as C
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import make_pipeline
from sklearn.impute import SimpleImputer

WS = "/download_job_code/payload/sandbox/workspaces/arcturus_kappa"
SHARED = "/download_job_code/payload/sandbox/workspaces/castor_rho/shared/cv_folds.csv"
BN = "/download_job_code/payload/sandbox/workspaces/castor_rho/artifacts/birdnet_probs.csv"
tr, Y, te, Yt = C.load_labels()
cv = pd.read_csv(SHARED); fm = dict(zip(cv.rec_id, cv.fold))
f = tr.rec_id.map(fm).values
folds = [(np.where(f != k)[0], np.where(f == k)[0]) for k in range(5)]

af = np.load(f"{WS}/audio_feats.npz", allow_pickle=True)
A = pd.DataFrame(np.nan_to_num(af["Xrec"], nan=0.0, posinf=0.0, neginf=0.0), index=af["rec_ids"])
Xa_tr, Xa_te = A.reindex(tr.rec_id).values, A.reindex(te.rec_id).values
pf = np.load(f"{WS}/provided_feats.npz")
Xp_tr, Xp_te = pf["Xtr"], pf["Xte"]
bn = pd.read_csv(BN).set_index("rec_id")
bc = [f"bn_max_{i}" for i in range(19)]
Bn_tr, Bn_te = bn.reindex(tr.rec_id)[bc].values, bn.reindex(te.rec_id)[bc].values
assert not np.isnan(Bn_te).any()

def meta_feats(M):
    d = pd.DataFrame({"site": M.site, "month": M.month.astype(str), "hour": M.hour.astype(str),
                      "year": M.year, "doy": pd.to_datetime(M.date, format="%Y%m%d").dt.dayofyear,
                      "minute": M.minute})
    d["site_month"] = d.site + "_" + d.month
    return d
Dtr, Dte = meta_feats(C.parse_meta(tr)), meta_feats(C.parse_meta(te))
cats, num = ["site", "month", "hour", "site_month"], ["year", "doy", "minute"]
allD = pd.concat([Dtr, Dte])
oh = pd.get_dummies(allD[cats], drop_first=False).astype(float)
Xm_tr = np.hstack([oh.iloc[:len(Dtr)].values, Dtr[num].values])
Xm_te = np.hstack([oh.iloc[len(Dtr):].values, Dte[num].values])

def lr():
    return make_pipeline(SimpleImputer(strategy="median"), StandardScaler(),
                         LogisticRegression(C=0.1, max_iter=3000, class_weight="balanced"))
def lr_meta():
    return make_pipeline(StandardScaler(), LogisticRegression(C=2.0, max_iter=3000, class_weight="balanced"))

def oof_and_full(Xtr, Xte, mk, Cval=None):
    P = np.zeros_like(Y, float); T = np.zeros((len(te), 19), float)
    for ti, vi in folds:
        for c in range(19):
            y = Y[ti, c]
            if y.sum() < 2:
                P[vi, c] = y.mean(); continue
            m = mk(); m.fit(Xtr[ti], y); P[vi, c] = m.predict_proba(Xtr[vi])[:, 1]
    for c in range(19):
        y = Y[:, c]
        if y.sum() < 2:
            T[:, c] = y.mean(); continue
        m = mk(); m.fit(Xtr, y); T[:, c] = m.predict_proba(Xte)[:, 1]
    return P, T

Pa, Ta = oof_and_full(Xa_tr, Xa_te, lr)
Pp, Tp = oof_and_full(Xp_tr, Xp_te, lr)
Pm, Tm = oof_and_full(Xm_tr, Xm_te, lr_meta)

def z(P):
    Z = np.zeros_like(P, float)
    for c in range(P.shape[1]):
        Z[:, c] = (P[:, c] - P[:, c].mean()) / (P[:, c].std() + 1e-9)
    return Z

prior = Y.mean(0); lp = np.log(prior / (1 - prior))
W = dict(bn=1.0, meta=0.10, audio=0.10, prov=0.05, lam=0.30)

def ensemble(Zb, Zm, Za, Zp):
    return W["bn"] * Zb + W["meta"] * Zm + W["audio"] * Za + W["prov"] * Zp + W["lam"] * lp[None, :]

So = ensemble(z(Bn_tr), z(Pm), z(Pa), z(Pp))
St = ensemble(z(Bn_te), z(Tm), z(Ta), z(Tp))
print("OOF ensemble micro=%.4f macro=%.4f" % (C.global_auc(Y, So), C.per_class_auc(Y, So)[0]))
for nm, P in [("bn", Bn_tr), ("meta", Pm), ("audio", Pa), ("prov", Pp)]:
    print(f"  {nm:6s} micro={C.global_auc(Y,P):.4f} macro={C.per_class_auc(Y,P)[0]:.4f}")

# save long-format component OOF/test csv (rec_id, pred_0..pred_18)
def save_csv(P, rec_ids, path):
    d = pd.DataFrame(P, columns=[f"pred_{i}" for i in range(19)])
    d.insert(0, "rec_id", rec_ids)
    d.to_csv(path, index=False)
oos = f"{WS}/oof"; import os; os.makedirs(oos, exist_ok=True)
save_csv(Pa, tr.rec_id.values, f"{oos}/audio_oof.csv"); save_csv(Ta, te.rec_id.values, f"{oos}/audio_test.csv")
save_csv(Pp, tr.rec_id.values, f"{oos}/provided_oof.csv"); save_csv(Tp, te.rec_id.values, f"{oos}/provided_test.csv")
save_csv(Pm, tr.rec_id.values, f"{oos}/meta_oof.csv"); save_csv(Tm, te.rec_id.values, f"{oos}/meta_test.csv")
save_csv(Bn_tr, tr.rec_id.values, f"{oos}/birdnet_oof.csv"); save_csv(Bn_te, te.rec_id.values, f"{oos}/birdnet_test.csv")
np.savez(f"{WS}/ens_oof_test.npz", So=So, St=St, Y=Y, rec_tr=tr.rec_id.values, rec_te=te.rec_id.values,
         Pa=Pa, Pp=Pp, Pm=Pm, Bn_tr=Bn_tr, Ta=Ta, Tp=Tp, Tm=Tm, Bn_te=Bn_te)
# candidate submission (sigmoid -> [0,1], monotone)
def submission(S, path):
    rows = []
    for i, rid in enumerate(te.rec_id.values):
        for c in range(19):
            rows.append((int(rid) * 100 + c, float(1 / (1 + np.exp(-S[i, c])))))
    d = pd.DataFrame(rows, columns=["Id", "Probability"]).sort_values("Id")
    d.to_csv(path, index=False)
    print("submission", path, d.shape)
submission(St, f"{WS}/candidate_submission.csv")
