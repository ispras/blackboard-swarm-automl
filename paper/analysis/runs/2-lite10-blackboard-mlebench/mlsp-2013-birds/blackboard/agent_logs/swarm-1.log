FIN='/download_job_code/payload/sandbox/final_solution/components/'; ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'
def rd(p): d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
P={'perch':rd(FIN+'perch_pcr_max_oof.csv'),'bn':rd(FIN+'birdnet_h05max_oof.csv'),'pp':rd(FIN+'perch_probe_oof.csv'),'mlpp':rd(FIN+'mlp_perch_ens5_oof.csv'),'meta_lr':rd(ALD+'meta_LR_oof.csv'),'mlp_embmeta':rd(ALD+'mlp_embmeta_oof.csv'),'bn3':rd('oof/bn3_h125_max_oof.csv'),'prior_g':rd('oof/prior_grp_oof.csv')}
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
site=tr.site.values; date=tr.date.values; tm=tr.time.values
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
baseW={'perch':1.0,'bn':0.2,'pp':0.2,'mlpp':0.2,'meta_lr':0.1}
bn3W=dict(baseW); bn3W['bn3']=0.5
rng=np.random.default_rng(2); N=250
res={}
for it in range(N):
    mask=np.zeros(len(ids),bool); mask[rng.choice(len(ids),64,replace=False)]=True
    va=np.where(mask)[0]; trn=np.where(~mask)[0]
    Pw=SOL.session_prior(tr.iloc[trn].reset_index(drop=True),Y[trn],tr.iloc[va].reset_index(drop=True))
    keyg={}
    for j in trn: keyg.setdefault((site[j],date[j],tm[j]),[]).append(j)
    Pg=np.zeros((len(va),19))
    for i,j in enumerate(va):
        g=keyg.get((site[j],date[j],tm[j]),[])
        if g: Pg[i]=Y[g].mean(0)
    Z={k:z(P[k][va]) for k in baseW}
    Z['pw']=z(Pw); Z['prior_g']=z(Pg); Z['bn3']=z(P['bn3'][va])
    B=sum(bn3W[k]*Z[k] for k in bn3W)+0.1*Z['prior_g']+0.2*Z['pw']
    lp_tr=logit(np.clip(Y[trn].mean(0),.01,.99))
    est={'train':np.clip(Y[trn].mean(0),.01,.99),
         'mlp':np.clip((P['mlpp'][va].mean(0)+P['mlp_embmeta'][va].mean(0))/2,.01,.99),
         'perch':np.clip(P['perch'][va].mean(0),.01,.99),
         'bn3':np.clip(P['bn3'][va].mean(0),.01,.99),
         'perch_bn3':np.clip((P['perch'][va].mean(0)+P['bn3'][va].mean(0))/2,.01,.99),
