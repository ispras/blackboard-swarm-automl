import numpy as np, pandas as pd
from sklearn.metrics import roc_auc_score
BASE='/download_job_code/payload/sandbox'
def load_labels():
    lab={}
    for line in open(f'{BASE}/data/essential_data/rec_labels_test_hidden.txt').read().splitlines()[1:]:
        p=line.split(','); rid=int(p[0]); lab[rid]=None if (len(p)>1 and p[1]=='?') else set(map(int,p[1:]))
    folds0={}
    for line in open(f'{BASE}/data/essential_data/CVfolds_2.txt').read().splitlines()[1:]:
        a,b=line.split(','); folds0[int(a)]=int(b)
    return lab,folds0
def train_ids():
    lab,f=load_labels(); return sorted(r for r in f if f[r]==0), sorted(r for r in f if f[r]==1), lab
def Y_matrix(ids,lab=None):
    if lab is None: _,_,lab=load_labels()
    Y=np.zeros((len(ids),19),int)
    for i,r in enumerate(ids):
        for s in lab[r]: Y[i,s]=1
    return Y
def macro_auc(Y,P):
    aucs=[]; names=[]
    for j in range(Y.shape[1]):
        if Y[:,j].min()==0 and Y[:,j].max()==1:
            aucs.append(roc_auc_score(Y[:,j],P[:,j])); names.append(j)
    return float(np.mean(aucs)), aucs
def micro_auc(Y,P):
    return float(roc_auc_score(Y.ravel(),P.ravel()))
def report(Y,P,label=''):
    ma,aucs=macro_auc(Y,P); mi=micro_auc(Y,P)
    print(f'{label}: macroAUC={ma:.4f} microAUC={mi:.4f} per-class={[round(a,3) for a in aucs]}')
    return ma,mi
EOF
