basep='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/oof/'
def readcsv(p):
    d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
O={'bn_global':readcsv(basep+'birdnet_oof.csv'),'audio':readcsv(basep+'audio_oof.csv'),'meta':readcsv(basep+'meta_oof.csv'),'provided':readcsv(basep+'provided_oof.csv'),'bn_h05':readcsv('oof/birdnet_h05max_oof.csv'),'bne':readcsv('oof/bne_probe_oof.csv'),'bme':readcsv('oof/bme_probe_oof.csv'),'prior_g':readcsv('oof/prior_grp_oof.csv'),'prior_s':readcsv('oof/prior_sess_oof.csv')}
W={'bn_global':1.0,'meta':0.1,'audio':0.02,'provided':0.02,'prior_g':0.1,'prior_s':0,'bn_h05':0.5,'bne':0.1,'bme':0.15}
