import os, numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
def load(path,which='emb'):
    z=np.load(path); rid={r:i for i,r in enumerate(z['rec_id'])}
    return z[which][[rid[r] for r in ids]], z[which][[rid[r] for r in test]]
def probe(X,Xte,npc=128,C=0.03):
    Po=np.zeros((len(ids),19)); Pt=np.zeros((len(test),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        sc=StandardScaler().fit(X[tr]); Xt=sc.transform(X[tr]); Xv=sc.transform(X[va])
        pc=PCA(n_components=min(npc,Xt.shape[0]-1,Xt.shape[1]),random_state=0).fit(Xt); Xt=pc.transform(Xt); Xv=pc.transform(Xv)
        for j in range(19):
            if Y[tr,j].sum()<2: Po[va,j]=Y[tr,j].mean(); continue
            lr=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(Xt,Y[tr,j])
            Po[va,j]=lr.predict_proba(Xv)[:,1]
    sc=StandardScaler().fit(X); Xt=sc.transform(X); Xf=sc.transform(Xte)
    pc=PCA(n_components=min(npc,Xt.shape[0]-1,Xt.shape[1]),random_state=0).fit(Xt); Xt=pc.transform(Xt); Xf=pc.transform(Xf)
    for j in range(19):
        if Y[:,j].sum()<2: Pt[:,j]=Y[:,j].mean(); continue
        lr=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(Xt,Y[:,j])
        Pt[:,j]=lr.predict_proba(Xf)[:,1]
    return Po,Pt
def save(name,A,rids):
    d=pd.DataFrame(A,columns=[f'pred_{j}' for j in range(19)]); d.insert(0,'rec_id',rids); d.to_csv(f'oof/{name}.csv',index=False)
os.makedirs('oof',exist_ok=True)
