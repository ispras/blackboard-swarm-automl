    for nm,pv in est.items():
        for a in [0.0,0.2,0.5]:
            off=a*lp_tr+(1-a)*logit(pv)
            S=B+off[None,:]; res.setdefault(f'{nm}_a{a}',[]).append(roc_auc_score(Y[va].ravel(),S.ravel()))
for k,v in res.items():
