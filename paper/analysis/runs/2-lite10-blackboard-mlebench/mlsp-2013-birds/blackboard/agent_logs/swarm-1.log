import os, sys, json, time
os.environ['OMP_NUM_THREADS']='4'; os.environ['TF_NUM_INTRAOP_THREADS']='4'; os.environ['TF_NUM_INTEROP_THREADS']='2'
sys.path.insert(0,'vendor')
import numpy as np, pandas as pd, librosa
from birdnetlib.analyzer import Analyzer

SCI=["Certhia americana","Troglodytes pacificus","Empidonax difficilis","Sitta canadensis","Junco hyemalis","Contopus cooperi","Catharus guttatus","Poecile rufescens","Ixoreus naevius","Setophaga occidentalis","Catharus ustulatus","Empidonax hammondii","Piranga ludoviciana","Pheucticus melanocephalus","Regulus satrapa","Vireo gilvus","Geothlypis tolmiei","Cyanocitta stelleri","Chordeiles minor"]
base='/download_job_code/payload/sandbox'
rec2f={}
for line in open(f'{base}/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b

print('loading analyzer...',flush=True)
an=Analyzer()
labels=[l.strip() for l in open(an.label_path)]
labmap={}
for i,l in enumerate(labels):
    s=l.split('_')[0]
    labmap.setdefault(s,i)
tgt=[labmap[s] for s in SCI]
print('target indices',tgt,flush=True)
# embeddings model
an.load_model()
print('model loaded',flush=True)

SR=48000
rows=[]; embs={}
t0=time.time()
for n,(rid,fn) in enumerate(sorted(rec2f.items())):
    path=f'{base}/data/essential_data/src_wavs/{fn}.wav'
    y,sr=librosa.load(path,sr=SR,mono=True)
    # pad to at least 3s
    win=3*SR; hop=int(1.5*SR)
    if len(y)<win: y=np.pad(y,(0,win-len(y)))
    starts=list(range(0,len(y)-win+1,hop))
    if starts[-1]+win<len(y): starts.append(len(y)-win)
    probs=[]; emb=[]
    for st in starts:
        chunk=y[st:st+win]
        p=an.predict(chunk,sensitivity=1.0)[0]
        probs.append(p[tgt])
        e=an._return_embeddings(np.array([chunk],dtype='float32'))
        emb.append(np.asarray(e)[0])
    probs=np.array(probs); emb=np.array(emb)
    rows.append({'rec_id':rid,
        **{f'bn_max_{j}':probs[:,j].max() for j in range(19)},
        **{f'bn_mean_{j}':probs[:,j].mean() for j in range(19)},
        **{f'bn_top2_{j}':np.sort(probs[:,j])[-2:].mean() for j in range(19)}})
    embs[rid]=emb.mean(0).astype(np.float32)
    if n%20==0: print(n,rid,'chunks',len(starts),'time',round(time.time()-t0,1),flush=True)
df=pd.DataFrame(rows).sort_values('rec_id')
df.to_csv('artifacts/birdnet_probs.csv',index=False)
np.savez_compressed('artifacts/birdnet_emb.npz',
    rec_id=np.array(sorted(embs)), emb=np.stack([embs[r] for r in sorted(embs)]))
print('DONE',df.shape,'time',time.time()-t0,flush=True)
