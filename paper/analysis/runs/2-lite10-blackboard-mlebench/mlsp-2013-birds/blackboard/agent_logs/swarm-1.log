import numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
def load(path):
    z=np.load(path); rid={r:i for i,r in enumerate(z['rec_id'])}; return z['emb'][[rid[r] for r in ids]]
E={'bne':load('artifacts/birdnet_emb.npz'),'bme':load('artifacts/birdmae_emb.npz')}
E['both']=np.concatenate([E['bne'],E['bme']],1)
v=pd.read_csv('artifacts/birdnet_variants.csv').set_index('rec_id')
BN=v.loc[ids,[f'bn_h05_max_{j}' for j in range(19)]].values
BNl=np.log(np.clip(BN,1e-5,1-1e-5)/(1-np.clip(BN,1e-5,1-1e-5)))
def probe(X,npc,C,bnw=1.0):
    P=np.zeros((len(ids),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        sc=StandardScaler().fit(X[tr]); Xt=sc.transform(X[tr]); Xv=sc.transform(X[va])
        pc=PCA(n_components=min(npc,Xt.shape[0]-1,Xt.shape[1]),random_state=0).fit(Xt)
        Xt=pc.transform(Xt); Xv=pc.transform(Xv)
        bs=StandardScaler().fit(BNl[tr]); Bt=bs.transform(BNl[tr])*bnw; Bv=bs.transform(BNl[va])*bnw
        Xt=np.hstack([Xt,Bt]); Xv=np.hstack([Xv,Bv])
        for j in range(19):
            if Y[tr,j].sum()<2: P[va,j]=Y[tr,j].mean(); continue
            lr=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(Xt,Y[tr,j])
            P[va,j]=lr.predict_proba(Xv)[:,1]
    return P
for nm,X in E.items():
    for npc in [64,128]:
        for C in [0.03,0.1]:
            for bnw in [0.5,1.0]:
                P=probe(X,npc,C,bnw); report(Y,P,f'{nm}+bn pca{npc} C{C} bw{bnw}')
EOF
