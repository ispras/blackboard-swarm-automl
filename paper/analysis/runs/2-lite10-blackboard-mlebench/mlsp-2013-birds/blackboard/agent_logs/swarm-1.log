}
O={};T={}
for k,p in paths.items():
    do=pd.read_csv(p.format('oof')).set_index('rec_id'); dt=pd.read_csv(p.format('test')).set_index('rec_id')
    O[k]=do.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
    T[k]=dt.reindex(test)[[f'pred_{j}' for j in range(19)]].values
# prior weighted from solution.py
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); te=meta[meta.fold==1].reset_index(drop=True)
Ytr=SOL.load_labels(tr)
ftr=tr.rec_id.map(dict(zip(folds_df.rec_id,folds_df.fold)) if False else dict(zip(pd.read_csv('shared/cv_folds.csv').rec_id,pd.read_csv('shared/cv_folds.csv').fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
pwt=SOL.session_prior(tr,Ytr,te)
O['pw']=Pw; T['pw']=pwt
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
Z={k:z(v) for k,v in O.items()}; ZT={k:z(v) for k,v in T.items()}
prev=Y.mean(0); lp=logit(np.clip(prev,0.01,0.99))
for k in O: print(f'{k:20s} micro {micro_auc(Y,O[k]):.4f} macro {macro_auc(Y,O[k])[0]:.4f}')
# arcturus final
Warc={'perch':1.0,'bn_h05':0.2,'perch_probe':0.2,'mlp_perch':0.2,'pw':0.2}; lam=0.75
S=sum(Warc[k]*Z[k] for k in Warc)+lam*lp[None,:]
print('ARC final OOF micro %.4f macro %.4f'%(micro_auc(Y,S),macro_auc(Y,S)[0]))
# greedy
wgrid=[0,0.02,0.05,0.1,0.15,0.2,0.3,0.5,0.75]
W={k:0.0 for k in O}; W['perch']=1.0; lam=0.6
def ev(W,lam): 
    S=sum(W[k]*Z[k] for k in W)+lam*lp[None,:]; return micro_auc(Y,S),macro_auc(Y,S)[0]
best=ev(W,lam)
for r in range(4):
    for k in W:
        if k=='perch': continue
        cur=W[k]; b=(best[0],cur)
        for w in wgrid:
            W[k]=w; v=ev(W,lam)[0]
            if v>b[0]: b=(v,w)
        W[k]=b[1]; best=ev(W,lam)
    bl=(best[0],lam)
    for L in [0.4,0.5,0.6,0.7,0.8,0.9,1.0,1.1,1.2]:
        v=ev(W,L)[0]
        if v>bl[0]: bl=(v,L)
    lam=bl[1]; best=ev(W,lam)
    print('round',r,best,'lam',lam,{k:round(v,2) for k,v in W.items() if v>0})
print('GREEDY OOF micro %.4f macro %.4f'%ev(W,lam))
# honest within-fold for ARC and greedy
def honest(W,lam):
    mis=[];mas=[]
    for f in range(5):
        va=folds==f; trn=~va
        lpf=logit(np.clip(Y[trn].mean(0),0.01,0.99))
        S=np.zeros((va.sum(),19))
        for c in range(19):
            for k in W:
                if W[k]==0: continue
                S[:,c]+=W[k]*((O[k][va,c]-O[k][va,c].mean())/(O[k][va,c].std()+1e-9))
        S+=lam*lpf[None,:]
        mis.append(roc_auc_score(Y[va].ravel(),S.ravel())); mas.append(macro_auc(Y[va],S)[0])
    return np.mean(mis),np.mean(mas),mis
print('ARC honest',honest(Warc,0.75)[:2])
print('GREEDY honest',honest(W,lam)[:2])
np.savez('blend_v2.npz',W=np.array([W[k] for k in W]),keys=np.array(list(W)),lam=lam)
