import os, time
os.environ['OMP_NUM_THREADS']='4'
import numpy as np, pandas as pd, librosa, tensorflow as tf
base='/download_job_code/payload/sandbox'
rec2f={}
for line in open(f'{base}/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
labels=pd.read_csv('models/perch2/perch2_class_labels.txt',header=None).iloc[:,0].tolist(); idx={s:i for i,s in enumerate(labels)}
SCI=["Certhia americana","Troglodytes pacificus","Empidonax difficilis","Sitta canadensis","Junco hyemalis","Contopus cooperi","Catharus guttatus","Poecile rufescens","Ixoreus naevius","Setophaga occidentalis","Catharus ustulatus","Empidonax hammondii","Piranga ludoviciana","Pheucticus melanocephalus","Regulus satrapa","Vireo gilvus","Geothlypis tolmiei","Cyanocitta stelleri","Chordeiles minor"]
tgt=[idx[s] for s in SCI]
it=tf.lite.Interpreter(model_path='models/perch2/Perch2.tflite',num_threads=4); it.allocate_tensors()
BATCH=8; it.resize_tensor_input(0,[BATCH,160000]); it.allocate_tensors()
ids=sorted(rec2f); t0=time.time(); rows=[]; embs={}; alllab={}
for s in range(0,len(ids),BATCH):
    b=ids[s:s+BATCH]; xs=[]
    for rid in b:
        y,_=librosa.load(f'{base}/data/essential_data/src_wavs/{rec2f[rid]}.wav',sr=16000,mono=True)
        y=y[:160000] if len(y)>=160000 else np.pad(y,(0,160000-len(y)))
        xs.append(y.astype('float32'))
    while len(xs)<BATCH: xs.append(np.zeros(160000,dtype='float32'))
    x=np.stack(xs)
    it.set_tensor(0,x); it.invoke()
    outs=it.get_output_details(); em=np.zeros((BATCH,1536),dtype='float32'); lab=np.zeros((BATCH,14795),dtype='float32')
    for d in outs:
        t=it.get_tensor(d['index'])
        if t.shape[-1]==1536 and t.ndim==2: em=t
        if t.shape[-1]==14795: lab=t
    for j,rid in enumerate(b):
        rows.append({'rec_id':rid,**{f'pc_raw_{k}':lab[j,tgt[k]] for k in range(19)},**{f'pc_sig_{k}':1/(1+np.exp(-lab[j,tgt[k]])) for k in range(19)}})
        embs[rid]=em[j].copy(); alllab[rid]=lab[j,tgt].copy()
    print(s+len(b),round(time.time()-t0,1),flush=True)
df=pd.DataFrame(rows).sort_values('rec_id'); df.to_csv('artifacts/perch_probs.csv',index=False)
ids2=np.array(sorted(embs)); np.savez_compressed('artifacts/perch_emb.npz',rec_id=ids2,emb=np.stack([embs[r] for r in ids2]))
print('DONE',df.shape,round(time.time()-t0,1),flush=True)
EOF
