import os, sys, numpy as np, pandas as pd
from scipy.special import logit
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution'); import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
ARC='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/oof/'; ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'; FIN='/download_job_code/payload/sandbox/final_solution/components/'
paths={'perch':'oof/perch_pcr_max_{}.csv','bn3':'oof/bn3_b3_max_{}.csv','bn3mean':'oof/bn3_b3_mean_{}.csv','mlp_perch':FIN+'mlp_perch_ens5_{}.csv','perch_probe':'oof/perch_probe_{}.csv','bn_h05':'oof/birdnet_h05max_{}.csv','prior_g':'oof/prior_grp_{}.csv','prior_s':'oof/prior_sess_{}.csv','meta_lr_ald':ALD+'meta_LR_{}.csv','meta_arc':ARC+'meta_{}.csv','pw':None}
O={}
for k,p in paths.items():
    if k=='pw': continue
    d=pd.read_csv(p.format('oof')).set_index('rec_id'); O[k]=d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
cvf=pd.read_csv('shared/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cvf.rec_id,cvf.fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
O['pw']=Pw
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
Z={k:z(v) for k,v in O.items()}
prev=Y.mean(0); lp=logit(np.clip(prev,0.01,0.99))
for k in O: print(f'{k:12s} micro {micro_auc(Y,O[k]):.4f} macro {macro_auc(Y,O[k])[0]:.4f}')
wgrid=[0,0.05,0.1,0.15,0.2,0.3,0.4,0.5,0.75,1.0,1.25,1.5]
W={k:0.0 for k in O}; W['perch']=1.0; W['bn3']=1.0; lam=0.6
def ev(W,lam): S=sum(W[k]*Z[k] for k in W)+lam*lp[None,:]; return micro_auc(Y,S),macro_auc(Y,S)[0]
best=ev(W,lam); print('start',best)
for r in range(5):
    for k in W:
        if k in ('perch','bn3'): continue
        cur=W[k]; b=(best[0],cur)
        for w in wgrid:
            W[k]=w; v=ev(W,lam)[0]
            if v>b[0]: b=(v,w)
        W[k]=b[1]; best=ev(W,lam)
    # tune perch/bn3 ratio
    for k in ['perch','bn3']:
        cur=W[k]
        b=(best[0],cur)
        for w in wgrid:
            if w==0: continue
            W[k]=w; v=ev(W,lam)[0]
            if v>b[0]: b=(v,w)
        W[k]=b[1]; best=ev(W,lam)
    bl=(best[0],lam)
    for L in [0.3,0.4,0.5,0.6,0.7,0.8,0.9,1.0,1.1,1.2,1.4]:
        v=ev(W,L)[0]
        if v>bl[0]: bl=(v,L)
    lam=bl[1]; best=ev(W,lam)
    print('round',r,best,'lam',lam,{k:round(v,2) for k,v in W.items() if v>0})
print('FINAL OOF micro %.4f macro %.4f'%ev(W,lam))
def honest(W,lam):
    mis=[];mas=[]
    for f in range(5):
        va=folds==f; trn=~va; va_idx=np.where(va)[0]; lpf=logit(np.clip(Y[trn].mean(0),.01,.99))
        S=np.zeros((va.sum(),19))
        for k,wgt in W.items():
            if wgt==0: continue
            A=O[k][va_idx]; S+=wgt*((A-A.mean(0))/(A.std(0)+1e-9))
        S+=lam*lpf[None,:]; mis.append(roc_auc_score(Y[va_idx].ravel(),S.ravel())); mas.append(macro_auc(Y[va_idx],S)[0])
    return np.mean(mis),np.mean(mas),mis
print('HONEST',honest(W,lam))
np.savez('blend_bn3.npz',W=np.array([W[k] for k in W]),keys=np.array(list(W)),lam=lam)
EOF
