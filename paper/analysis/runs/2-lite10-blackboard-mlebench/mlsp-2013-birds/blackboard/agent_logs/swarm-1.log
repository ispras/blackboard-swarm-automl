import os, sys, numpy as np, pandas as pd
from scipy.special import logit
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution')
import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
ARC='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/oof/'; ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'; FIN='/download_job_code/payload/sandbox/final_solution/components/'
paths={'perch':'oof/perch_pcr_max_{}.csv','perch_mean':'oof/perch_pc_mean_{}.csv','perch_probe':'oof/perch_probe_{}.csv','mlp_perch':FIN+'mlp_perch_ens5_{}.csv','bn_h05':'oof/birdnet_h05max_{}.csv','prior_g':'oof/prior_grp_{}.csv','prior_s':'oof/prior_sess_{}.csv','meta_arc':ARC+'meta_{}.csv','meta_lr_ald':ALD+'meta_LR_{}.csv','pw':None}
O={}
for k,p in paths.items():
    if k=='pw': continue
    d=pd.read_csv(p.format('oof')).set_index('rec_id'); O[k]=d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
ftr=tr.rec_id.map(dict(zip(pd.read_csv('shared/cv_folds.csv').rec_id,pd.read_csv('shared/cv_folds.csv').fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
O['pw']=Pw
pos={r:i for i,r in enumerate(ids)}
# metadata dicts for prior recompute
site=tr.site.values; date=tr.date.values; tm=tr.time.values; secs=tr.secs.values; seq=tr.seq.values
def priors_for_mask(mask_va):
    # build prior_g, prior_s, pw for va recs using train=~mask_va
    n=mask_va.sum(); Pg=np.zeros((n,19)); Ps=np.zeros((n,19))
    va_idx=np.where(mask_va)[0]; tr_idx=np.where(~mask_va)[0]
    keyg={}; keys={}
    for j in tr_idx:
        keyg.setdefault((site[j],date[j],tm[j]),[]).append(j); keys.setdefault((site[j],date[j]),[]).append(j)
    for i,j in enumerate(va_idx):
        g=keyg.get((site[j],date[j],tm[j]),[]); s=keys.get((site[j],date[j]),[])
        if g: Pg[i]=Y[g].mean(0)
        if s: Ps[i]=Y[s].mean(0)
    # pw via solution.session_prior with train subset DataFrame
    trsub=tr.iloc[tr_idx].reset_index(drop=True); tgt=tr.iloc[va_idx].reset_index(drop=True)
    Pwt=SOL.session_prior(trsub,Y[tr_idx],tgt)
    return Pg,Ps,Pwt,tr_idx,va_idx
w=np.load('blend_v2.npz',allow_pickle=True); W={k:float(v) for k,v in zip(w['keys'],w['W'])}
print('W',W,'lam',float(w['lam']))
rng=np.random.default_rng(0); sizes=[64]
for lam in [0.8,0.9,1.0,1.1,1.2,1.3,1.5]:
    mis=[]
    for it in range(150):
        mask=np.zeros(len(ids),bool); mask[rng.choice(len(ids),64,replace=False)]=True
        Pg,Ps,Pwt,tr_idx,va_idx=priors_for_mask(mask)
        prev=Y[tr_idx].mean(0); lp=logit(np.clip(prev,0.01,0.99))
        S=np.zeros((64,19))
        for k,wgt in W.items():
            if wgt==0: continue
            A=O[k][va_idx] if k not in ('prior_g','prior_s','pw') else (Pg if k=='prior_g' else Ps if k=='prior_s' else Pwt)
            A=(A-A.mean(0))/(A.std(0)+1e-9); S+=wgt*A
        S+=lam*lp[None,:]
        mis.append(roc_auc_score(Y[va_idx].ravel(),S.ravel()))
    print(f'lam {lam}: sim64 mean {np.mean(mis):.4f} q10 {np.quantile(mis,.1):.4f} q90 {np.quantile(mis,.9):.4f}')
# honest fold
for lam in [0.8,0.9,1.0,1.1,1.2,1.3,1.5]:
    mis=[];mas=[]
    for f in range(5):
        va=folds==f; trn=~va; va_idx=np.where(va)[0]; tr_idx=np.where(trn)[0]
        lpf=logit(np.clip(Y[trn].mean(0),0.01,0.99))
        S=np.zeros((va.sum(),19))
        for k,wgt in W.items():
            if wgt==0: continue
            A=O[k][va_idx]; S+=wgt*((A-A.mean(0))/(A.std(0)+1e-9))
        S+=lam*lpf[None,:]; mis.append(roc_auc_score(Y[va_idx].ravel(),S.ravel())); mas.append(macro_auc(Y[va_idx],S)[0])
