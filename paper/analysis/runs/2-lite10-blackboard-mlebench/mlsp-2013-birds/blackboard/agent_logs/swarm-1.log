    noise=np.percentile(mag,15,axis=1,keepdims=True)
    mask=np.clip((mag-1.5*noise)/(mag+1e-8),0,1)
    mask=np.apply_along_axis(lambda r:np.convolve(r,np.ones(5)/5,mode='same'),1,mask)
