import numpy as np, pandas as pd
from scipy.special import logit
from sklearn.metrics import roc_auc_score
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
basep='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/oof/'
def readcsv(p):
    d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
O={
 'bn_global':readcsv(basep+'birdnet_oof.csv'),'audio':readcsv(basep+'audio_oof.csv'),
 'meta':readcsv(basep+'meta_oof.csv'),'provided':readcsv(basep+'provided_oof.csv'),
 'bn_h05':readcsv('oof/birdnet_h05max_oof.csv'),'bne':readcsv('oof/bne_probe_oof.csv'),
 'bme':readcsv('oof/bme_probe_oof.csv'),'both':readcsv('oof/both_probe_oof.csv'),
 'prior_g':readcsv('oof/prior_grp_oof.csv'),'prior_s':readcsv('oof/prior_sess_oof.csv')}
def z(A,mask=None):
    m = A if mask is None else A[mask]
    return (A-m.mean(0))/(m.std(0)+1e-9)
Zall={k:z(v) for k,v in O.items()}
grid=[0,0.02,0.05,0.1,0.15,0.2,0.3,0.5]
def micro_mask(Y,S,mask):
    return roc_auc_score(Y[mask].ravel(),S[mask].ravel())
def tune(mask):
    W={k:0.0 for k in O}; W['bn_global']=1.0; W['meta']=0.1; W['audio']=0.1; W['provided']=0.05
    prev=Y[mask].mean(0); lp=logit(np.clip(prev,0.01,0.99))
    lam=0.3
    def sc(W,lam): return sum(W[k]*Zall[k] for k in W)+lam*lp[None,:]
    def val(W,lam): return micro_mask(Y,sc(W,lam),mask)
    cur=val(W,lam)
    for r in range(3):
        for k in W:
            if k=='bn_global': continue
            best=(cur,W[k])
            for w in grid:
                W[k]=w; v=val(W,lam)
                if v>best[0]: best=(v,w)
            W[k]=best[1]; cur=best[0]
        bestl=(cur,lam)
        for L in [0,0.05,0.1,0.15,0.2,0.25,0.3,0.4,0.5,0.7]:
            v=val(W,L)
            if v>bestl[0]: bestl=(v,L)
        lam=bestl[1]; cur=bestl[0]
    return W,lam,cur
baseW={'bn_global':1.0,'meta':0.1,'audio':0.1,'provided':0.05,'prior_g':0.0,'prior_s':0.0,'bn_h05':0.0,'bne':0.0,'bme':0.0,'both':0.0}
fullW={'bn_global':1.0,'meta':0.1,'audio':0.02,'provided':0.02,'prior_g':0.1,'prior_s':0,'bn_h05':0.5,'bne':0.1,'bme':0.15,'both':0,'prior_s':0}
vals_base=[]; vals_full=[]; vals_tuned=[]
for f in range(5):
    va=folds==f; tr=~va; mask=va
    prev=Y[tr].mean(0); lp=logit(np.clip(prev,0.01,0.99))
    def sc(W,lam): return sum(W[k]*Zall[k] for k in W)+lam*lp[None,:]
    mb=micro_mask(Y,sc(baseW,0.3),mask); mf=micro_mask(Y,sc(fullW,0.5),mask)
    W,lam,c=tune(tr)
    mt=micro_mask(Y,sc(W,lam),mask)
    vals_base.append(mb); vals_full.append(mf); vals_tuned.append(mt)
    print(f'fold{f} base {mb:.4f} fullW {mf:.4f} tuned {mt:.4f} W={W} lam={lam}')
print('MEAN base',np.mean(vals_base),'fullW',np.mean(vals_full),'tuned',np.mean(vals_tuned))
