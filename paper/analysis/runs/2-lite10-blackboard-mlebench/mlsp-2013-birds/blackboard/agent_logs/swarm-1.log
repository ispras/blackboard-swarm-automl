import os, sys, numpy as np, pandas as pd
from scipy.special import logit
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution'); import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
FIN='/download_job_code/payload/sandbox/final_solution/components/'; ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'
def rd(p,which):
    d=pd.read_csv(p).set_index('rec_id'); return d.reindex(which)[[f'pred_{j}' for j in range(19)]].values
W={'perch':1.0,'bn3':0.5,'bn':0.2,'pp':0.2,'mlpp':0.2,'meta_lr':0.1,'pw':0.2,'prior_g':0.1}; lam=1.1
O={};T={}
O['perch']=rd(FIN+'perch_pcr_max_oof.csv',ids); T['perch']=rd(FIN+'perch_pcr_max_test.csv',test)
O['bn3']=rd('oof/bn3_b3_max_oof.csv',ids); T['bn3']=rd('oof/bn3_b3_max_test.csv',test)
O['bn']=rd(FIN+'birdnet_h05max_oof.csv',ids); T['bn']=rd(FIN+'birdnet_h05max_test.csv',test)
O['pp']=rd(FIN+'perch_probe_oof.csv',ids); T['pp']=rd(FIN+'perch_probe_test.csv',test)
O['mlpp']=rd(FIN+'mlp_perch_ens5_oof.csv',ids); T['mlpp']=rd(FIN+'mlp_perch_ens5_test.csv',test)
O['meta_lr']=rd(ALD+'meta_LR_oof.csv',ids); T['meta_lr']=rd(ALD+'meta_LR_test.csv',test)
O['prior_g']=rd('oof/prior_grp_oof.csv',ids); T['prior_g']=rd('oof/prior_grp_test.csv',test)
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); te=meta[meta.fold==1].reset_index(drop=True); Ytr=SOL.load_labels(tr)
cvf=pd.read_csv('shared/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cvf.rec_id,cvf.fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
O['pw']=Pw; T['pw']=SOL.session_prior(tr,Ytr,te)
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
prev=np.clip(Y.mean(0),.001,1-.001); lp=logit(prev)
So=sum(W[k]*z(O[k]) for k in W)+lam*lp[None,:]
St=sum(W[k]*z(T[k]) for k in W)+lam*lp[None,:]
report(Y,So,'candidate bn3 OOF')
# honest
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
from sklearn.metrics import roc_auc_score
mis=[];mas=[]
for f in range(5):
    va=folds==f; trn=~va; idx=np.where(va)[0]; lpf=logit(np.clip(Y[trn].mean(0),.01,.99))
    S=np.zeros((va.sum(),19))
    for k,w in W.items():
        A=O[k][idx]; S+=w*((A-A.mean(0))/(A.std(0)+1e-9))
    S+=lam*lpf[None,:]; mis.append(roc_auc_score(Y[idx].ravel(),S.ravel())); mas.append(macro_auc(Y[idx],S)[0])
print('HONEST micro %.4f macro %.4f folds %s'%(np.mean(mis),np.mean(mas),[round(x,4) for x in mis]))
probs=1/(1+np.exp(-St))
rows=[]
for i,rid in enumerate(test):
    for c in range(19): rows.append((int(rid)*100+c,float(probs[i,c])))
d=pd.DataFrame(rows,columns=['Id','Probability']).sort_values('Id'); d.to_csv('candidate_bn3.csv',index=False)
print('wrote candidate_bn3.csv',d.shape)
ss=pd.read_csv('/download_job_code/payload/sandbox/data/sample_submission.csv')
print('idmatch',(d.Id.values==ss.Id.values).all(),'range',d.Probability.min(),d.Probability.max())
np.savez('candidate_bn3.npz',So=So,St=St,Y=Y)
