import numpy as np, pandas as pd
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
v=pd.read_csv('artifacts/birdnet_variants.csv').set_index('rec_id')
bp=pd.read_csv('artifacts/birdnet_probs.csv').set_index('rec_id')
Pgrp_tr=np.load('artifacts/prior_grp_train.npy'); Pgrp_te=np.load('artifacts/prior_grp_test.npy')
Psess_tr=np.load('artifacts/prior_sess_train.npy'); Psess_te=np.load('artifacts/prior_sess_test.npy')
os.makedirs('oof',exist_ok=True)
def save(name,A,rids):
    df=pd.DataFrame(A,columns=[f'pred_{j}' for j in range(19)]); df.insert(0,'rec_id',rids)
    df.to_csv(f'oof/{name}.csv',index=False)
H_tr=v.loc[ids,[f'bn_h05_max_{j}' for j in range(19)]].values
H_te=v.loc[test,[f'bn_h05_max_{j}' for j in range(19)]].values
G_tr=bp.loc[ids,[f'bn_max_{j}' for j in range(19)]].values
G_te=bp.loc[test,[f'bn_max_{j}' for j in range(19)]].values
save('birdnet_h05max_oof',H_tr,ids); save('birdnet_h05max_test',H_te,test)
save('birdnet_globalmax_oof',G_tr,ids); save('birdnet_globalmax_test',G_te,test)
save('prior_grp_oof',Pgrp_tr,ids); save('prior_grp_test',Pgrp_te,test)
save('prior_sess_oof',Psess_tr,ids); save('prior_sess_test',Psess_te,test)
for w in [0.05,0.1,0.15,0.2]:
    A=(1-w)*H_tr+w*Pgrp_tr; At=(1-w)*H_te+w*Pgrp_te
    ma,mi=report(Y,A,f'H05+grp w{w}')
    save(f'bn_h05_grp_w{w}_oof',A,ids); save(f'bn_h05_grp_w{w}_test',At,test)
# prior alone
report(Y,Pgrp_tr,'prior_grp')
# per-class z + prior-offset on top of h05+prior
from scipy.stats import rankdata
def zcol(A):
    return (A-A.mean(0))/(A.std(0)+1e-9)
prev=Y.mean(0)
A=(1-0.1)*H_tr+0.1*Pgrp_tr
for lam in [0.05,0.1,0.15,0.2,0.3]:
    S=zcol(A)+lam*np.logit(np.clip(prev,0.01,0.99))[None,:]
    ma,mi=report(Y,S,f'h05+grp z+prior lam{lam}')
EOF
