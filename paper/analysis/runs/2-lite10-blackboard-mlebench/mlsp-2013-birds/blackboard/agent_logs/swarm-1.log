import numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import ExtraTreesClassifier
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
z=np.load('artifacts/birdnet_h05_windows.npz',allow_pickle=True)
rid2p={int(r):p for r,p in zip(z['rec_id'],z['probs'])}
def feats(p):
    srt=np.sort(p,axis=0); out=[]
    out.append(p.max(0)); out.append(p.mean(0)); out.append(p.std(0))
    for q in [0.25,0.5,0.75,0.9]: out.append(np.quantile(p,q,axis=0))
    for t in [0.01,0.05,0.1,0.2]: out.append((p>t).mean(0))
    out.append(srt[-min(3,len(p)):].mean(0))
    return np.concatenate(out)
X=np.stack([feats(rid2p[r]) for r in ids])
print('X',X.shape)
def cv(fn,fl='lr'):
    P=np.zeros((len(ids),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        for c in range(19):
            if Y[tr,c].sum()<2: P[va,c]=Y[tr,c].mean(); continue
            if fl=='et': m=ExtraTreesClassifier(n_estimators=300,min_samples_leaf=2,max_features='sqrt',random_state=0,n_jobs=4)
            else: m=LogisticRegression(C=0.1,max_iter=3000,class_weight='balanced')
            if fl=='lr':
                sc=StandardScaler().fit(X[tr]); m.fit(sc.transform(X[tr]),Y[tr,c]); P[va,c]=m.predict_proba(sc.transform(X[va]))[:,1]
            else: m.fit(X[tr],Y[tr,c]); P[va,c]=m.predict_proba(X[va])[:,1]
    return P
for fl in ['lr','et']:
    P=cv(None,fl); report(Y,P,f'winfeat {fl}')
# add bn max and bne to features
bp=pd.read_csv('artifacts/birdnet_variants.csv').set_index('rec_id')
BN=bp.loc[ids,[f'bn_h05_max_{j}' for j in range(19)]].values
X2=np.concatenate([X,BN],1)
X=X2; print('X2',X.shape)
P=cv(None,'lr'); report(Y,P,'winfeat+bn lr')
EOF
