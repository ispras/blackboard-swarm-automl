import numpy as np, pandas as pd, re
from sklearn.preprocessing import normalize
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab); pos={r:i for i,r in enumerate(ids)}
rec2f={}
for line in open('/download_job_code/payload/sandbox/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
meta={}
for r,fn in rec2f.items():
    m=re.match(r'([A-Za-z0-9]+)_(\d{8})_(\d{6})_(\d+)',fn); s,d,t,i=m.groups(); meta[r]=(s,d,t,int(i))
def embed(path):
    z=np.load(path); rid={r:i for i,r in enumerate(z['rec_id'])}; return z['emb'][[rid[r] for r in ids]]
E1=normalize(embed('artifacts/birdnet_emb.npz')); E2=normalize(embed('artifacts/birdmae_emb.npz'))
v=pd.read_csv('artifacts/birdnet_variants.csv').set_index('rec_id')
H=v.loc[ids,[f'bn_h05_max_{j}' for j in range(19)]].values
def build(scope,simE,topk=None,power=1):
    P=np.zeros((len(ids),19))
    for i,r in enumerate(ids):
        if scope=='grp': cand=[q for q in ids if q!=r and meta[q][:3]==meta[r][:3]]
        else: cand=[q for q in ids if q!=r and meta[q][:2]==meta[r][:2]]
        if not cand: continue
        ci=[pos[q] for q in cand]; sims=simE[i,ci]
        if topk: 
            o=np.argsort(-sims)[:topk]; ci=[ci[j] for j in o]; sims=sims[o]
        w=np.clip(sims,0,None)**power
        if w.sum()<1e-9: w=np.ones(len(ci))
        P[i]=Y[ci].T@w/w.sum()
    return P
for scope in ['grp','sess']:
    for nm,EE in [('bne',E1),('bme',E2)]:
        for topk in ([None,1,2,3,5] if scope=='sess' else [None,1,2]):
            P=build(scope,EE,topk)
            ma,mi=report(Y,P,f'{scope} {nm} k{topk}')
            for w in [0.05,0.1,0.15]:
                m2,_=macro_auc(Y,(1-w)*H+w*P); mi2=micro_auc(Y,(1-w)*H+w*P)
                print(f'    fuse w{w}: macro {m2:.4f} micro {mi2:.4f}')
EOF
