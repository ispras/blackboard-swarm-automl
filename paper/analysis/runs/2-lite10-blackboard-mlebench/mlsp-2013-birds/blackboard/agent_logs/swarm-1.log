import numpy as np, pandas as pd, itertools, os
from scipy.special import logit
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
def readcsv(p):
    d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values, d.reindex(test)[[f'pred_{j}' for j in range(19)]].values
A={'bn_global':'../arcturus_kappa/oof/birdnet_{}.csv','audio':'../arcturus_kappa/oof/audio_{}.csv','meta':'../arcturus_kappa/oof/meta_{}.csv','provided':'../arcturus_kappa/oof/provided_{}.csv','bn_h05':'oof/birdnet_h05max_{}.csv','bne':'oof/bne_probe_{}.csv','bme':'oof/bme_probe_{}.csv','both':'oof/both_probe_{}.csv','prior_g':'oof/prior_grp_{}.csv','prior_s':'oof/prior_sess_{}.csv'}
O={};T={}
for k,p in A.items():
    try:
        O[k],T[k]=readcsv(p.format('oof').replace('../arcturus_kappa','/download_job_code/payload/sandbox/workspaces/arcturus_kappa') if p.startswith('../') else p.format('oof'))
        T[k]=readcsv((p.format('test').replace('../arcturus_kappa','/download_job_code/payload/sandbox/workspaces/arcturus_kappa') if p.startswith('../') else p.format('test')))[1]
    except Exception as e: print('skip',k,e)
print('loaded',list(O))
def z(A):
    return (A-A.mean(0))/(A.std(0)+1e-9)
Z={k:z(v) for k,v in O.items()}
ZT={k:z(v) for k,v in T.items()}
prev=Y.mean(0); lp=logit(np.clip(prev,0.01,0.99))
# base arcturus
W={'bn_global':1.0,'meta':0.1,'audio':0.1,'provided':0.05,'prior_g':0.0,'prior_s':0.0,'bn_h05':0.0,'bne':0.0,'bme':0.0,'both':0.0}
def score(W,lam,useZ=True):
    S=sum(W[k]*Z[k] for k in W)+lam*lp[None,:]; return S
def ev(W,lam,label=''):
    S=score(W,lam); ma,mi=report(Y,S,label); return mi,ma
print('BASE'); ev(W,0.3,'base')
# greedy coordinate ascent on micro
grid=[0,0.02,0.05,0.1,0.15,0.2,0.3,0.5]
def greedy(obj='micro',rounds=3):
    global W,lam
    best_mi,best_ma=ev(W,lam)
    lam=0.3
    for r in range(rounds):
        for k in list(W):
            if k=='bn_global': continue
            cur=W[k]; best=(best_mi if obj=='micro' else best_ma,cur,lam)
            for w in grid:
                W[k]=w
                for L in ([lam] if k!='__' else []):
                    S=score(W,L); mi=micro_auc(Y,S); ma,_=macro_auc(Y,S)
                    val=mi if obj=='micro' else ma
                    if val>best[0]: best=(val,w,L)
            W[k]=best[1]
        # tune lam
        bestl=(best_mi if obj=='micro' else best_ma,lam)
        for L in [0,0.05,0.1,0.15,0.2,0.25,0.3,0.4,0.5,0.7]:
            S=score(W,L); mi=micro_auc(Y,S); ma,_=macro_auc(Y,S); val=mi if obj=='micro' else ma
            if val>bestl[0]: bestl=(val,L)
        lam=bestl[1]
        mi,ma=ev(W,lam,f'round{r}')
        best_mi,best_ma=mi,ma
    return W,lam
for obj in ['micro','macro']:
    W={'bn_global':1.0,'meta':0.1,'audio':0.1,'provided':0.05,'prior_g':0.0,'prior_s':0.0,'bn_h05':0.0,'bne':0.0,'bme':0.0,'both':0.0}
    lam=0.3
    W,lam=greedy(obj,3)
    print('OPT',obj,W,'lam',lam)
    ev(W,lam,'FINAL '+obj)
    np.savez(f'blend_{obj}.npz',W=np.array([W[k] for k in W]),keys=np.array(list(W)),lam=lam)
