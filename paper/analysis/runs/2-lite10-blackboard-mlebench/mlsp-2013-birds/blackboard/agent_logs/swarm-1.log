import os, numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
z=np.load('artifacts/perch_spatial.npz'); rid={r:i for i,r in enumerate(z['rec_id'])}
G=np.load('artifacts/perch2_emb.npz'); grid={r:i for i,r in enumerate(G['rec_id'])}
Xsets={'smax':z['max'][[rid[r] for r in ids]],'smean':z['mean'][[rid[r] for r in ids]]}
Xsets['smax_mean']=np.concatenate([Xsets['smax'],z['mean'][[rid[r] for r in ids]]],1)
Xsets['smax_global']=np.concatenate([Xsets['smax'],G['emb'][[grid[r] for r in ids]]],1)
def probe(X,npc=256,C=0.01):
    P=np.zeros((len(ids),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        sc=StandardScaler().fit(X[tr]); A=sc.transform(X[tr]); B=sc.transform(X[va])
        pc=PCA(n_components=min(npc,A.shape[0]-1,A.shape[1]),random_state=0).fit(A); A=pc.transform(A); B=pc.transform(B)
        for j in range(19):
            if Y[tr,j].sum()<2: P[va,j]=Y[tr,j].mean(); continue
            m=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(A,Y[tr,j]); P[va,j]=m.predict_proba(B)[:,1]
    return P
for nm,X in Xsets.items():
    for npc in [128,256]:
        P=probe(X,npc); report(Y,P,f'{nm} pca{npc}')
EOF
