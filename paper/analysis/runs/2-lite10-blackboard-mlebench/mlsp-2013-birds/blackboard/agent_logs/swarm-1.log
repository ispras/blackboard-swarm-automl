import os, time
os.environ['OMP_NUM_THREADS']='4'
import numpy as np, pandas as pd, librosa, tensorflow as tf
base='/download_job_code/payload/sandbox'
rec2f={}
for line in open(f'{base}/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
labels=pd.read_csv('models/perch2/perch2_class_labels.txt',header=None).iloc[:,0].tolist(); idx={s:i for i,s in enumerate(labels)}
SCI=["Certhia americana","Troglodytes pacificus","Empidonax difficilis","Sitta canadensis","Junco hyemalis","Contopus cooperi","Catharus guttatus","Poecile rufescens","Ixoreus naevius","Setophaga occidentalis","Catharus ustulatus","Empidonax hammondii","Piranga ludoviciana","Pheucticus melanocephalus","Regulus satrapa","Vireo gilvus","Geothlypis tolmiei","Cyanocitta stelleri","Chordeiles minor"]
tgt=[idx[s] for s in SCI]
it=tf.lite.Interpreter(model_path='models/perch2/Perch2.tflite',num_threads=4); it.allocate_tensors()
BATCH=8; it.resize_tensor_input(0,[BATCH,160000]); it.allocate_tensors()
SR=32000; W=5*SR; H=int(1.25*SR)
ids=sorted(rec2f); clips=[]; owner=[]; starts_all={}
for rid in ids:
    y,_=librosa.load(f'{base}/data/essential_data/src_wavs/{rec2f[rid]}.wav',sr=SR,mono=True)
    if len(y)<W: y=np.pad(y,(0,W-len(y)))
    starts=list(range(0,len(y)-W+1,H))
    if starts[-1]+W<len(y): starts.append(len(y)-W)
    starts_all[rid]=np.array(starts)/SR
    for st in starts: clips.append(y[st:st+W].astype('float32')); owner.append(rid)
print('clips',len(clips),flush=True)
P={r:[] for r in ids}; t0=time.time()
for s in range(0,len(clips),BATCH):
    b=clips[s:s+BATCH]; n=len(b)
    while len(b)<BATCH: b.append(np.zeros(W,dtype='float32'))
    x=np.stack(b); it.set_tensor(0,x); it.invoke()
    lab=None
    for d in it.get_output_details():
        t=it.get_tensor(d['index'])
        if t.ndim==2 and t.shape[-1]==14795: lab=t
    for j in range(n):
        P[owner[s+j]].append(1/(1+np.exp(-lab[j,tgt])))
    if s%120==0: print(s,round(time.time()-t0,1),flush=True)
obs=np.array([np.asarray(P[r],dtype=np.float32) for r in ids],dtype=object)
np.savez_compressed('artifacts/perch_h125_windows.npz',rec_id=np.array(ids),probs=obs,starts=np.array([starts_all[r] for r in ids],dtype=object))
rows=[]
for r in ids:
    p=np.asarray(P[r]); rows.append({'rec_id':r,'max':p.max(0),'mean':p.mean(0),'top2':np.sort(p,0)[-2:].mean(0),'noisyor':1-np.prod(1-p,0)})
np.savez_compressed('artifacts/perch_h125_aggs.npz',rec_id=np.array(ids),
    max=np.stack([x['max'] for x in rows]),mean=np.stack([x['mean'] for x in rows]),
    top2=np.stack([x['top2'] for x in rows]),noisyor=np.stack([x['noisyor'] for x in rows]))
print('DONE',round(time.time()-t0,1),flush=True)
