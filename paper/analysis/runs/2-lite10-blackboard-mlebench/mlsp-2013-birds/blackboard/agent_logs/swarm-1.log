    for ep in range(epochs):
        m.train()
        for xb,yb in dl:
            xb=xb.to(dev); yb=yb.to(dev); opt.zero_grad(); loss=lossf(m(xb),yb); loss.backward(); opt.step()
        sch.step()
    m.eval()
    with torch.no_grad(): return torch.sigmoid(m(torch.tensor(Xva).to(dev))).cpu().numpy()
