import os, sys, numpy as np, pandas as pd
from scipy.special import logit
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution'); import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
FIN='/download_job_code/payload/sandbox/final_solution/components/'; ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'
def rd(p): d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
P={'perch':rd(FIN+'perch_pcr_max_oof.csv'),'bn':rd(FIN+'birdnet_h05max_oof.csv'),'pp':rd(FIN+'perch_probe_oof.csv'),'mlpp':rd(FIN+'mlp_perch_ens5_oof.csv'),'bn3':rd('oof/bn3_b3_max_oof.csv'),'bn3m':rd('oof/bn3_b3_mean_oof.csv'),'meta_lr':rd(ALD+'meta_LR_oof.csv'),'prior_g':rd('oof/prior_grp_oof.csv')}
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
cvf=pd.read_csv('shared/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cvf.rec_id,cvf.fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
P['pw']=Pw
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
Z={k:z(v) for k,v in P.items()}
prev=Y.mean(0); lp=logit(np.clip(prev,.01,.99))
def ev(W,lam):
    S=sum(W[k]*Z[k] for k in W)+lam*lp[None,:]; return micro_auc(Y,S),macro_auc(Y,S)[0]
def honest(W,lam):
    mis=[];mas=[]
    for f in range(5):
        va=folds==f; trn=~va; idx=np.where(va)[0]; lpf=logit(np.clip(Y[trn].mean(0),.01,.99))
        S=np.zeros((va.sum(),19))
        for k,w in W.items():
            if w==0: continue
            A=P[k][idx]; S+=w*((A-A.mean(0))/(A.std(0)+1e-9))
        S+=lam*lpf[None,:]; mis.append(roc_auc_score(Y[idx].ravel(),S.ravel())); mas.append(macro_auc(Y[idx],S)[0])
    return np.mean(mis),np.mean(mas),mis
base={'perch':1.0,'bn':0.2,'pp':0.2,'mlpp':0.2,'pw':0.2}
