import os, sys, numpy as np, pandas as pd
from scipy.special import logit
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution'); import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
FIN='/download_job_code/payload/sandbox/final_solution/components/'; ALD='/download_job_code/payload/sandbox/workspaces/alderamin_phi/oof/'
def rd(p): d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
P={'perch':rd(FIN+'perch_pcr_max_oof.csv'),'bn':rd(FIN+'birdnet_h05max_oof.csv'),'pp':rd(FIN+'perch_probe_oof.csv'),'mlpp':rd(FIN+'mlp_perch_ens5_oof.csv'),'meta_lr':rd(ALD+'meta_LR_oof.csv'),'mlp_embmeta':rd(ALD+'mlp_embmeta_oof.csv'),'bn3':rd('oof/bn3_b3_max_oof.csv'),'prior_g':rd('oof/prior_grp_oof.csv')}
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
site=tr.site.values; date=tr.date.values; tm=tr.time.values
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
baseW={'perch':1.0,'bn':0.2,'pp':0.2,'mlpp':0.2,'meta_lr':0.1}
bn3W=dict(baseW); bn3W['bn3']=0.5
rng=np.random.default_rng(1); N=300
res={'base_train':[],'base_trans':[],'bn3_train':[],'bn3_trans':[]}
for it in range(N):
    mask=np.zeros(len(ids),bool); mask[rng.choice(len(ids),64,replace=False)]=True
    va=np.where(mask)[0]; trn=np.where(~mask)[0]
    # prior weighted & group from train complement
    Pw=SOL.session_prior(tr.iloc[trn].reset_index(drop=True),Y[trn],tr.iloc[va].reset_index(drop=True))
    keyg={}
    for j in trn: keyg.setdefault((site[j],date[j],tm[j]),[]).append(j)
    Pg=np.zeros((len(va),19))
    for i,j in enumerate(va):
        g=keyg.get((site[j],date[j],tm[j]),[])
        if g: Pg[i]=Y[g].mean(0)
    Z={k:z(P[k][va]) for k in baseW}
    Z['pw']=z(Pw); Z['prior_g']=z(Pg); Z['bn3']=z(P['bn3'][va])
    trainprev=Y[trn].mean(0); lp_tr=logit(np.clip(trainprev,.01,.99))
    # transductive prevalence estimate from mlpp + mlp_embmeta mean predicted prob
    mp=np.clip((P['mlpp'][va].mean(0)+P['mlp_embmeta'][va].mean(0))/2,.01,.99)
    off_trans=0.2*lp_tr+0.8*logit(mp)
    for nm,W in [('base',baseW),('bn3',bn3W)]:
        B=sum(W[k]*Z[k] for k in W)
        if nm=='bn3': B=B+0.1*Z['prior_g']
        B=B+0.2*Z['pw']
        for off,onm in [(1.0*lp_tr,'train'),(off_trans,'trans')]:
            S=B+off[None,:]
            res[f'{nm}_{onm}'].append(roc_auc_score(Y[va].ravel(),S.ravel()))
for k,v in res.items():
    v=np.array(v); print(f'{k:12s} mean {v.mean():.4f} q10 {np.quantile(v,.1):.4f} q90 {np.quantile(v,.9):.4f}')
EOF
