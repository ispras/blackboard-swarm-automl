import os, numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler, normalize
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
def get(path):
    z=np.load(path); rid={r:i for i,r in enumerate(z['rec_id'])}
    return z['emb'][[rid[r] for r in ids]], (z['emb'][[rid[r] for r in test]] if 'test' else None)
BME,_=get('artifacts/birdmae_emb.npz'); BNE,_=get('artifacts/birdnet_emb.npz')
def probe(X,npc=64,C=0.1):
    P=np.zeros((len(ids),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        sc=StandardScaler().fit(X[tr]); Xt=sc.transform(X[tr]); Xv=sc.transform(X[va])
        if npc and npc<min(Xt.shape):
            pc=PCA(n_components=npc,random_state=0).fit(Xt); Xt=pc.transform(Xt); Xv=pc.transform(Xv)
        for j in range(19):
            if Y[tr,j].sum()==0: P[va,j]=0; continue
            lr=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(Xt,Y[tr,j])
            P[va,j]=lr.predict_proba(Xv)[:,1]
    return P
def proto(X):
    Xn=normalize(X); P=np.zeros((len(ids),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        for j in range(19):
            p=Xn[tr][Y[tr,j]==1]
            if len(p)==0: P[va,j]=0; continue
            c=normalize(p.mean(0,keepdims=True)); P[va,j]=Xn[va]@c.T
    return P
for name,X in [('bme',BME),('bne',BNE),('both',np.concatenate([BME,BNE],1))]:
    for npc in [32,64,128]:
        for C in [0.03,0.1,0.3]:
            P=probe(X,npc,C); report(Y,P,f'{name} pca{npc} C{C}')
    P=proto(X); report(Y,P,f'{name} proto')
    for npc in [64]:
        P=probe(X,npc,0.1)
        report(Y,normalize(P),f'{name} pca{npc} C0.1 norm')
EOF
