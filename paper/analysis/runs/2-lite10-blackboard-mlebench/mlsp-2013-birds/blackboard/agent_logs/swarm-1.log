import os, time
os.environ['OMP_NUM_THREADS']='4'
import numpy as np, pandas as pd, librosa, torch
from transformers import AutoModel, AutoFeatureExtractor
torch.set_num_threads(4)
base='/download_job_code/payload/sandbox'
rec2f={}
for line in open(f'{base}/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
p='models/Bird-MAE-Base'
fe=AutoFeatureExtractor.from_pretrained(p,trust_remote_code=True)
m=AutoModel.from_pretrained(p,trust_remote_code=True).eval()
SR=32000; W=5*SR; H=int(2.5*SR)
out={}; perclip={}; t0=time.time()
with torch.no_grad():
    for n,(rid,fn) in enumerate(sorted(rec2f.items())):
        y,_=librosa.load(f'{base}/data/essential_data/src_wavs/{fn}.wav',sr=SR,mono=True)
        if len(y)<W: y=np.pad(y,(0,W-len(y)))
        starts=list(range(0,len(y)-W+1,H))
        if starts[-1]+W<len(y): starts.append(len(y)-W)
        clips=[y[s:s+W] for s in starts]
        inp=fe(clips,return_tensors='pt')
        o=m(input_values=inp).last_hidden_state.numpy()
        out[rid]=o.mean(0).astype(np.float32)
        perclip[rid]=o.astype(np.float32)
        if n%40==0: print(n,round(time.time()-t0,1),flush=True)
ids=np.array(sorted(out))
np.savez_compressed('artifacts/birdmae_emb.npz',rec_id=ids,emb=np.stack([out[r] for r in ids]),
                    perclip=np.stack([perclip[r] for r in ids]))
print('DONE',round(time.time()-t0,1),flush=True)
