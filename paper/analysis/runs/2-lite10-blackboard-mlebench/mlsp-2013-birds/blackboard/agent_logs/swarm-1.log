def fold_score(W,clip,lam,idx):
    S=np.zeros((len(idx),19))
    for k,w in W.items():
        A=P[k][idx] if k!='pw' else P['pw'][idx]
        S+=w*zc2(A,clip)
    return S
# need honest pw per fold: recompute using train folds only
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
cvf=pd.read_csv('shared/cv_folds.csv'); ftr=tr.rec_id.map(dict(zip(cvf.rec_id,cvf.fold))).values
Pw=np.zeros_like(Y,float)
for k in range(5):
    vi=np.where(ftr==k)[0]; Pw[vi]=SOL.session_prior(tr,Ytr,tr.iloc[vi],exclude=(ftr!=k))
P['pw']=Pw
for nm,(W,clip,lam) in variants.items():
    vals=[]; macs=[]
    for f in range(5):
        va=folds==f; trn=~va; idx=np.where(va)[0]
        S=fold_score(W,clip,lam,idx)
        lpf=logit(np.clip(Y[trn].mean(0),.01,.99)); mp=np.clip((P['mlpp'][idx].mean(0)+P['mlp_embmeta'][idx].mean(0))/2,.01,.99)
        S+=lam*(0.2*lpf+0.8*logit(mp))[None,:]
        vals.append(roc_auc_score(Y[idx].ravel(),S.ravel())); macs.append(macro_auc(Y[idx],S)[0])
    print(nm,'perfold micro',[round(x,4) for x in vals],'mean',round(np.mean(vals),4),'macro mean',round(np.mean(macs),4))
