    def forward(self,x): return self.net(x)
def train_fold(Xtr,Ytr,Xva,seed,epochs=50):
    torch.manual_seed(seed); np.random.seed(seed)
    m=Net(Xtr.shape[1]).to(dev)
    opt=torch.optim.AdamW(m.parameters(),lr=1e-3,weight_decay=1e-3)
    sch=torch.optim.lr_scheduler.CosineAnnealingLR(opt,epochs)
    ds=torch.utils.data.TensorDataset(torch.tensor(Xtr),torch.tensor(Ytr))
    dl=torch.utils.data.DataLoader(ds,batch_size=64,shuffle=True,drop_last=False)
