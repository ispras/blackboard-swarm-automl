import os, numpy as np, pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
z=np.load('artifacts/perch2_emb.npz'); rid={r:i for i,r in enumerate(z['rec_id'])}
X=z['emb'][[rid[r] for r in ids]]; Xte=z['emb'][[rid[r] for r in test]]
def probe(npc,C):
    Po=np.zeros((len(ids),19)); Pt=np.zeros((len(test),19))
    for f in range(5):
        tr=folds!=f; va=~tr
        sc=StandardScaler().fit(X[tr]); A=sc.transform(X[tr]); B=sc.transform(X[va])
        pc=PCA(n_components=min(npc,A.shape[0]-1,A.shape[1]),random_state=0).fit(A); A=pc.transform(A); B=pc.transform(B)
        for j in range(19):
            if Y[tr,j].sum()<2: Po[va,j]=Y[tr,j].mean(); continue
            m=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(A,Y[tr,j]); Po[va,j]=m.predict_proba(B)[:,1]
    sc=StandardScaler().fit(X); A=sc.transform(X); B=sc.transform(Xte)
    pc=PCA(n_components=min(npc,A.shape[0]-1,A.shape[1]),random_state=0).fit(A); A=pc.transform(A); B=pc.transform(B)
    for j in range(19):
        if Y[:,j].sum()<2: Pt[:,j]=Y[:,j].mean(); continue
        m=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(A,Y[:,j]); Pt[:,j]=m.predict_proba(B)[:,1]
    return Po,Pt
for npc in [64,128,256]:
    for C in [0.01,0.03,0.1]:
        Po,Pt=probe(npc,C)
        ma,mi=report(Y,Po,f'perch probe pca{npc} C{C}')
        if npc==128 and C==0.03:
            def save(name,A,rids):
                d=pd.DataFrame(A,columns=[f'pred_{j}' for j in range(19)]); d.insert(0,'rec_id',rids); d.to_csv(f'oof/{name}.csv',index=False)
            save('perch_probe_oof',Po,ids); save('perch_probe_test',Pt,test)
