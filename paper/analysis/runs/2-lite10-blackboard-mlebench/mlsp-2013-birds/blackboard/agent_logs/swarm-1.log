from scipy.special import logit
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/final_solution'); import solution as SOL
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
FIN='/download_job_code/payload/sandbox/final_solution/components/'
def rd(p): d=pd.read_csv(p).set_index('rec_id'); return d.reindex(ids)[[f'pred_{j}' for j in range(19)]].values
P={'perch':rd(FIN+'perch_pcr_max_oof.csv'),'bn3max':rd(FIN+'bn3_b3_max_oof.csv'),'bn3mean':rd(FIN+'bn3_b3_mean_oof.csv'),'bn':rd(FIN+'birdnet_h05max_oof.csv'),'pp':rd(FIN+'perch_probe_oof.csv'),'mlpp':rd(FIN+'mlp_perch_ens5_oof.csv'),'mlpa':rd(FIN+'mlp_all_avg3_oof.csv'),'meta':rd(FIN+'meta_LR_oof.csv'),'mlp_embmeta':rd(FIN+'mlp_embmeta_oof.csv')}
meta=SOL.load_meta(); tr=meta[meta.fold==0].reset_index(drop=True); Ytr=SOL.load_labels(tr)
def z(A): return (A-A.mean(0))/(A.std(0)+1e-9)
W={'perch':1.0,'bn3max':0.5,'bn3mean':0.3,'bn':0.2,'pp':0.1,'mlpp':0.1,'mlpa':0.3,'meta':0.1,'pw':0.2}
rng=np.random.default_rng(11); N=250; res={}
for it in range(N):
    mask=np.zeros(len(ids),bool); mask[rng.choice(len(ids),64,replace=False)]=True
    va=np.where(mask)[0]; trn=np.where(~mask)[0]
    Pw=SOL.session_prior(tr.iloc[trn].reset_index(drop=True),Y[trn],tr.iloc[va].reset_index(drop=True))
    Z={k:z(P[k][va]) for k in ['perch','bn3max','bn3mean','bn','pp','mlpp','mlpa','meta']}; Z['pw']=z(Pw)
    B=sum(W[k]*Z[k] for k in W)
    lp=logit(np.clip(Y[trn].mean(0),.01,.99))
    means={k:np.clip(P[k][va].mean(0),.01,.99) for k in ['mlpp','mlpa','mlp_embmeta','bn3max','perch']}
    est={'mlpp_emb':(means['mlpp']+means['mlp_embmeta'])/2,
         'mlpa':means['mlpa'],
         'mlpa_mlpp_emb':(means['mlpa']+means['mlpp']+means['mlp_embmeta'])/3,
         'mlpa_mlpp':(means['mlpa']+means['mlpp'])/2,
         'three_mlp_bn3':(means['mlpa']+means['mlpp']+means['mlp_embmeta']+means['bn3max'])/4}
    for nm,pv in est.items():
        pv=np.clip(pv,.01,.99)
        for a in [0.0,0.2,0.4]:
            off=1.2*(a*lp+(1-a)*logit(pv)); S=B+off[None,:]
            res.setdefault(f'{nm}_a{a}',[]).append(roc_auc_score(Y[va].ravel(),S.ravel()))
for k,v in res.items():
    v=np.array(v); print(f'{k:22s} mean {v.mean():.4f} q10 {np.quantile(v,.1):.4f} q90 {np.quantile(v,.9):.4f}')
