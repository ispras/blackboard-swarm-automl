import numpy as np, pandas as pd, re
from sklearn.preprocessing import normalize
from sklearn.metrics import roc_auc_score
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab); pos={r:i for i,r in enumerate(ids)}
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
rec2f={}
for line in open('/download_job_code/payload/sandbox/data/essential_data/rec_id2filename.txt').read().splitlines()[1:]:
    a,b=line.split(','); rec2f[int(a)]=b
meta={}
for r,fn in rec2f.items():
    m=re.match(r'([A-Za-z0-9]+)_(\d{8})_(\d{6})_(\d+)',fn); s,d,t,i=m.groups(); meta[r]=(s,d,t)
# session sibling availability
has_sess=np.array([any(q!=r and meta[q][:2]==meta[r][:2] for q in ids) for r in ids])
has_grp=np.array([any(q!=r and meta[q][:3]==meta[r][:3] for q in ids) for r in ids])
print('train recs with sess sib',has_sess.sum(),'grp',has_grp.sum())
def load(path):
    z=np.load(path); rid={r:i for i,r in enumerate(z['rec_id'])}; return z['emb'][[rid[r] for r in ids]]
E={'perch':load('artifacts/perch2_emb.npz'),'bne':load('artifacts/birdnet_emb.npz'),'bme':load('artifacts/birdmae_emb.npz')}
E['cat']=np.concatenate([E['perch'],E['bne']],1)
pc=pd.read_csv('artifacts/perch2_probs.csv').set_index('rec_id').reindex(ids)[[f'pc_max_{j}' for j in range(19)]].values
def knn(E,k,power=3):
    Xn=normalize(E); S=Xn@Xn.T; P=np.zeros((len(ids),19))
    for f in range(5):
        va=np.where(folds==f)[0]; tr=np.where(folds!=f)[0]
        sv=S[np.ix_(va,tr)]
        for i,vi in enumerate(va):
            sim=sv[i]; o=np.argsort(-sim)[:k]; w=np.clip(sim[o],0,None)**power
            P[vi]=Y[tr[o]].T@w/w.sum()
    return P
# evaluate on subsets
for subset_name,mask in [('all',np.ones(len(ids),bool)),('no_sess',~has_sess),('no_grp',~has_grp)]:
    print('##',subset_name,mask.sum())
    for nm,X in E.items():
        for k in [5,10,20,50]:
            P=knn(X,k)
            # per-class on subset where valid
            aucs=[]
            for c in range(19):
                y=Y[mask,c]
                if 0<y.sum()<len(y): aucs.append(roc_auc_score(y,P[mask,c]))
            print(f'  {nm} k{k}: macro {np.mean(aucs):.3f} micro {roc_auc_score(Y[mask].ravel(),P[mask].ravel()):.3f}')
    # perch + knn
    for k in [10,20,50]:
        P=knn(E['perch'],k)
        for w in [0.1,0.2,0.3]:
            Q=(1-w)*pc+w*P
            aucs=[roc_auc_score(Y[mask,c],Q[mask,c]) for c in range(19) if 0<Y[mask,c].sum()<mask.sum()]
            print(f'  perch+knn k{k} w{w}: macro {np.mean(aucs):.3f} micro {roc_auc_score(Y[mask].ravel(),Q[mask].ravel()):.3f}')
EOF
