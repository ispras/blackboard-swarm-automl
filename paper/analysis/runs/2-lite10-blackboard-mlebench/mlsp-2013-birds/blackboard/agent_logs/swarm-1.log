[0m$ [0mcd workspaces/castor_rho && mkdir -p shared artifacts && pyenv shell sis-black && python - <<'EOF'
import numpy as np, pandas as pd
tr=[]
for line in open('../../data/essential_data/CVfolds_2.txt').read().splitlines()[1:]:
    a,b=line.split(','); 
    if int(b)==0: tr.append(int(a))
lab={}
for line in open('../../data/essential_data/rec_labels_test_hidden.txt').read().splitlines()[1:]:
    p=line.split(','); lab[int(p[0])]=set(map(int,p[1:])) if p[1:] else set()
tr=sorted(tr)
Y=np.zeros((len(tr),19),int)
for i,r in enumerate(tr):
    for s in lab[r]: Y[i,s]=1
print('positives per class',Y.sum(0))
print('recordings with >=1', (Y.sum(1)>0).sum())
# simple greedy multilabel strat: assign each recording to fold minimizing imbalance
K=5
order=np.argsort(-Y.sum(1))  # multi-label first
folds=np.full(len(tr),-1)
cnt=np.zeros((K,19))
tot=np.zeros((K,))
for i in order:
    ys=Y[i]
    # cost: fill folds to balance positives of labels present + total size
    best=None
    for f in range(K):
        c=(cnt[f]+ys)/ (Y.sum(0)+1)
        cost=np.sum((c-1/K)**2) + 0.05*(tot[f]+1)/ (len(tr)/K+1)
        if best is None or cost<best[0]: best=(cost,f)
    f=best[1]; folds[i]=f; cnt[f]+=ys; tot[f]+=1
print('fold sizes',tot)
print('fold label counts\n',cnt.astype(int))
df=pd.DataFrame({'rec_id':tr,'fold':folds})
df.to_csv('shared/cv_folds.csv',index=False)
print(df.head())
EOF
