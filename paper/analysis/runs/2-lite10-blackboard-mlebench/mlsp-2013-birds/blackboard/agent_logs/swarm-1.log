import os, numpy as np, pandas as pd
from sklearn.ensemble import ExtraTreesClassifier
from eval_utils import *
ids,test,lab=train_ids(); Y=Y_matrix(ids,lab)
folds=pd.read_csv('shared/cv_folds.csv').set_index('rec_id').reindex(ids)['fold'].values
z=np.load('artifacts/birdnet_h05_windows.npz',allow_pickle=True)
rid2p={int(r):np.asarray(p,dtype=np.float64) for r,p in zip(z['rec_id'],z['probs'])}
def feats(p):
    srt=np.sort(p,axis=0); out=[p.max(0),p.mean(0),p.std(0)]
    for q in [0.25,0.5,0.75,0.9]: out.append(np.quantile(p,q,axis=0))
    for t in [0.01,0.05,0.1,0.2]: out.append((p>t).mean(0))
    out.append(srt[-min(3,len(p)):].mean(0)); return np.concatenate(out)
X=np.stack([feats(rid2p[r]) for r in ids]); Xte=np.stack([feats(rid2p[r]) for r in test])
def mk(): return ExtraTreesClassifier(n_estimators=500,min_samples_leaf=2,max_features='sqrt',random_state=0,n_jobs=4)
Po=np.zeros((len(ids),19)); Pt=np.zeros((len(test),19))
for f in range(5):
    tr=folds!=f; va=~tr
    for c in range(19):
        if Y[tr,c].sum()<2: Po[va,c]=Y[tr,c].mean(); continue
        m=mk().fit(X[tr],Y[tr,c]); Po[va,c]=m.predict_proba(X[va])[:,1]
for c in range(19):
    if Y[:,c].sum()<2: Pt[:,c]=Y[:,c].mean(); continue
    m=mk().fit(X,Y[:,c]); Pt[:,c]=m.predict_proba(Xte)[:,1]
report(Y,Po,'winfeat ET')
def save(name,A,rids):
    d=pd.DataFrame(A,columns=[f'pred_{j}' for j in range(19)]); d.insert(0,'rec_id',rids); d.to_csv(f'oof/{name}.csv',index=False)
save('winfeat_et_oof',Po,ids); save('winfeat_et_test',Pt,test)
print('saved')
EOF
