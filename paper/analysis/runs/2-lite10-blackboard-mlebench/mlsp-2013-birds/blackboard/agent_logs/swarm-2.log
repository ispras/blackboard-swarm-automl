import sys,glob,os; sys.path.insert(0,"workspaces/arcturus_kappa")
import common as C, numpy as np, pandas as pd, warnings
warnings.filterwarnings("ignore")
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline
from sklearn.metrics import roc_auc_score
ROOT="workspaces"
tr,Y,te,Yt=C.load_labels()
cv=pd.read_csv(f"{ROOT}/castor_rho/shared/cv_folds.csv"); fm=dict(zip(cv.rec_id,cv.fold)); ftr=tr.rec_id.map(fm).values
def ll(p,ids):
    d=pd.read_csv(p).set_index("rec_id").reindex(ids); return d[[f"pred_{i}" for i in range(19)]].values
def z(P):
    Q=np.zeros_like(P)
    for c in range(19): Q[:,c]=(P[:,c]-P[:,c].mean())/(P[:,c].std()+1e-9)
    return Q
comp={}
for nm,p in [("bn_h05","castor_rho/oof/birdnet_h05max_oof.csv"),("bn_glob","castor_rho/oof/birdnet_globalmax_oof.csv"),("bne","castor_rho/oof/bne_probe_oof.csv"),("bme","castor_rho/oof/bme_probe_oof.csv"),("mlp","alderamin_phi/oof/mlp_embmeta_oof.csv"),("emb3","alderamin_phi/oof/emb_meta_bn3_LR_oof.csv"),("metaLR","alderamin_phi/oof/meta_LR_oof.csv"),("cnnbmp","arcturus_kappa/oof/cnn_bmp_oof.csv"),("cnnraw","alderamin_phi/oof/cnn_raw_oof.csv")]:
    comp[nm]=ll(f"{ROOT}/{p}",tr.rec_id.values)
w=np.load("arcturus_kappa/priors_weighted.npz"); comp["pw"]=w["Pw"]
d=np.load("castor_rho/artifacts/birdnet_emb.npz",allow_pickle=True)
E=pd.DataFrame(d["emb"],index=d["rec_id"]); ids=np.concatenate([tr.rec_id.values,te.rec_id.values]); E=E.reindex(ids).values
E=E/(np.linalg.norm(E,axis=1,keepdims=True)+1e-9); Et=E[:len(tr)]; K=np.zeros_like(Y,float)
for i in range(len(tr)):
    idx=np.where(ftr!=ftr[i])[0]; s=Et[idx]@Et[i]; top=idx[np.argsort(-s)[:20]]; ss=Et[top]@Et[i]
    ww=np.exp((ss-ss.max())/0.02); K[i]=(ww[:,None]*Y[top]).sum(0)/ww.sum()
comp["knn"]=K
Z={k:z(v) for k,v in comp.items()}
names=list(Z)
prior=Y.mean(0); lp=np.log(prior/(1-prior))
# per-class stacking cross-fitted
def stack_perclass(Cval):
    P=np.zeros_like(Y,float)
    X=np.stack([Z[k] for k in names],axis=2)  # n,19,f
    for k in range(5):
        ti=np.where(ftr!=k)[0]; vi=np.where(ftr==k)[0]
        for c in range(19):
            y=Y[ti,c]
            if y.sum()<2: P[vi,c]=y.mean(); continue
            m=make_pipeline(StandardScaler(),LogisticRegression(C=Cval,max_iter=2000,class_weight="balanced"))
            m.fit(X[ti,c],y); P[vi,c]=m.predict_proba(X[vi,c])[:,1]
    return P
for Cv in [0.02,0.05,0.1,0.3]:
    P=stack_perclass(Cv); print(f"perclass stack C={Cv} micro={C.global_auc(Y,P):.4f} macro={C.per_class_auc(Y,P)[0]:.4f}")
    for lam in [0.1,0.2,0.3]:
        S=np.log(np.clip(P,1e-6,1-1e-6)/(1-np.clip(P,1e-6,1-1e-6)))+lam*lp[None,:]
        print(f"   +prior lam={lam} micro={C.global_auc(Y,S):.4f} macro={C.per_class_auc(Y,S)[0]:.4f}")
# global stacker with class one-hot + prior logit
def stack_global(Cval):
    F=[];YY=[]
    for c in range(19):
        F.append(np.column_stack([Z[k][:,c] for k in names]+[np.full(len(tr),c),np.full(len(tr),lp[c])]))
        YY.append(Y[:,c])
    X=np.vstack(F); y=np.concatenate(YY)
    gid=np.tile(np.arange(len(tr)),19); 
    P=np.zeros_like(Y,float)
    for k in range(5):
        ti=np.where(ftr!=k)[0]; vi=np.where(ftr==k)[0]
        mti=np.isin(gid,ti); mvi=np.isin(gid,vi)
        m=make_pipeline(StandardScaler(),LogisticRegression(C=Cval,max_iter=3000,class_weight="balanced"))
        m.fit(X[mti],y[mti]); p=m.predict_proba(X[mvi])[:,1]
        P[vi]=p.reshape(19,len(vi)).T
    return P
for Cv in [0.02,0.05,0.1,0.3]:
    P=stack_global(Cv); print(f"global stack C={Cv} micro={C.global_auc(Y,P):.4f} macro={C.per_class_auc(Y,P)[0]:.4f}")
