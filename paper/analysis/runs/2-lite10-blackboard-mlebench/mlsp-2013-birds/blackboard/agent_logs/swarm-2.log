for s in sorted(res,key=lambda s:-np.mean(res[s]))[:10]: print(s,round(np.mean(res[s]),4))
print("baseline a=0:", round(np.mean([roc_auc_score(Y[s].ravel(), (sum(wt*z(v[s]) for (k,wt) in [("perch",1),("bn",0.2),("pp",0.2),("mlpp",0.2),("meta",0.1),("pw",0.2)]) + 0.75*lg(np.clip(Y[np.setdiff1d(np.arange(len(tr)),s)].mean(0),1e-3,1-1e-3)/(1-np.clip(Y[np.setdiff1d(np.arange(len(tr)),s)].mean(0),1e-3,1-1e-3)))[None,:]).ravel()) for s in [rng.choice(len(tr),64,replace=False) for _ in range(100)] if Y[s].sum()>0]),4))
print("STRATIFIED FOLDS (lam=1):")
