import sys; sys.path.insert(0,"workspaces/arcturus_kappa")
import common as C, numpy as np, pandas as pd
from sklearn.metrics import roc_auc_score
tr,Y,te,Yt=C.load_labels()
cv=pd.read_csv("workspaces/castor_rho/shared/cv_folds.csv"); fm=dict(zip(cv.rec_id,cv.fold)); ftr=tr.rec_id.map(fm).values
def ll(p,ids):
    d=pd.read_csv(p).set_index("rec_id").reindex(ids); return d[[f"pred_{i}" for i in range(19)]].values
def z(P):
    Q=np.zeros_like(P)
    for c in range(19):
        sd=P[:,c].std(); Q[:,c]=(P[:,c]-P[:,c].mean())/(sd+1e-9) if sd>1e-12 else 0
    return Q
P={k:ll(f"workspaces/{p}",tr.rec_id.values) for k,p in {"perch":"castor_rho/oof/perch_pcr_max_oof.csv","bn3max":"castor_rho/oof/bn3_b3_max_oof.csv","bn3mean":"castor_rho/oof/bn3_b3_mean_oof.csv","bn":"castor_rho/oof/birdnet_h05max_oof.csv","pp":"castor_rho/oof/perch_probe_oof.csv","mlpp":"arcturus_kappa/oof/mlp_perch_ens5_oof.csv","meta":"alderamin_phi/oof/meta_LR_oof.csv","mlpbn":"alderamin_phi/oof/mlp_embmeta_oof.csv"}.items()}
w=np.load("workspaces/arcturus_kappa/priors_weighted.npz"); P["pw"]=w["Pw"]
h=np.load("workspaces/arcturus_kappa/priors_honest.npz"); P["pgrp"]=h["Pg"]
def lg(x): x=np.clip(x,1e-3,1-1e-3); return np.log(x/(1-x))
Z={k:z(v) for k,v in P.items()}
CFG={
"ours":{"perch":1,"bn3max":.5,"bn3mean":.3,"bn":.2,"pp":.2,"mlpp":.2,"meta":.1,"pw":.2},
"castor":{"perch":1,"bn3max":.5,"bn":.2,"pp":.2,"mlpp":.2,"meta":.1,"pw":.2,"pgrp":.1},
"castor_nopgrp":{"perch":1,"bn3max":.5,"bn":.2,"pp":.2,"mlpp":.2,"meta":.1,"pw":.2},
"castor_bn3mean":{"perch":1,"bn3max":.5,"bn3mean":.2,"bn":.2,"pp":.2,"mlpp":.2,"meta":.1,"pw":.2,"pgrp":.1},
}
rng=np.random.RandomState(1010)
for nm,W in CFG.items():
    B=sum(wt*Z[k] for k,wt in W.items())
    lp=lg(Y.mean(0))
    for lam in ([1.1,1.2] if nm!="ours" else [1.2]):
        print(f"{nm} lam={lam} OOF micro={C.global_auc(Y,B+lam*lp[None,:]):.4f} macro={C.per_class_auc(Y,B+lam*lp[None,:])[0]:.4f}",end=" ")
    # stratified honest a=0 and a=.8 at lam 1.1/1.2
    for a,lam in [(0,1.1),(0.8,1.1),(0.8,1.2)]:
        fs=[]
        for k in range(5):
            vi=np.where(ftr==k)[0]; ti=np.where(ftr!=k)[0]
            Zs={kk:z(v[vi]) for kk,v in P.items()}
            Bf=sum(wt*Zs[k2] for k2,wt in W.items())
            ltr=lg(Y[ti].mean(0)); est=0.5*(lg(P["mlpp"][vi].mean(0))+lg(P["mlpbn"][vi].mean(0)))
            off=(1-a)*ltr+a*est
            fs.append(roc_auc_score(Y[vi].ravel(),(Bf+lam*off[None,:]).ravel()))
        print(f"strat_a{a}_l{lam}={np.mean(fs):.4f}",end=" ")
    # random subset transductive a=.8 lam 1.1/1.2
    for a,lam in [(0.8,1.1),(0.8,1.2)]:
        res=[]
        for rep in range(200):
            sub=rng.choice(len(tr),64,replace=False); mask=np.ones(len(tr),bool); mask[sub]=False
            yy=Y[sub].ravel()
            if yy.min()==yy.max(): continue
            Zs={kk:z(v[sub]) for kk,v in P.items()}
            Bs=sum(wt*Zs[k2] for k2,wt in W.items())
            ltr=lg(Y[mask].mean(0)); est=0.5*(lg(P["mlpp"][sub].mean(0))+lg(P["mlpbn"][sub].mean(0)))
            off=(1-a)*ltr+a*est
            res.append(roc_auc_score(yy,(Bs+lam*off[None,:]).ravel()))
        print(f"rand_a{a}_l{lam}={np.mean(res):.4f}",end=" ")
    print()
