import common as C, numpy as np, pandas as pd, itertools
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import make_pipeline
tr,Y,te,Yt=C.load_labels()
cv=pd.read_csv("workspaces/castor_rho/shared/cv_folds.csv"); fm=dict(zip(cv.rec_id,cv.fold))
folds=[(np.where(tr.rec_id.map(fm).values!=k)[0],np.where(tr.rec_id.map(fm).values==k)[0]) for k in range(5)]
M=C.parse_meta(tr); Mt=C.parse_meta(te)
def feat(M):
    d=pd.DataFrame({"site":M.site,"month":M.month.astype(str),"hour":M.hour.astype(str),
                    "year":M.year,"doy":pd.to_datetime(M.date,format="%Y%m%d").dt.dayofyear,"minute":M.minute})
    d["site_month"]=d.site+"_"+d.month
    return d
Dtr=feat(M);Dte=feat(Mt)
def build(cats,num):
    allD=pd.concat([Dtr,Dte]); oh=pd.get_dummies(allD[cats],drop_first=False).astype(float)
    return np.hstack([oh.iloc[:len(Dtr)].values,Dtr[num].values]), np.hstack([oh.iloc[len(Dtr):].values,Dte[num].values])
o=np.load("workspaces/arcturus_kappa/oof_lr.npz")
bn=pd.read_csv("workspaces/castor_rho/artifacts/birdnet_probs.csv").set_index("rec_id")
B=bn.reindex(tr.rec_id)[[f"bn_max_{i}" for i in range(19)]].values
def z(P):
    Z=np.zeros_like(P)
    for c in range(19): Z[:,c]=(P[:,c]-P[:,c].mean())/(P[:,c].std()+1e-9)
    return Z
Zb=z(B); Za=z(o["Pa"]); Zp=z(o["Pp"])
prior=Y.mean(0); lp=np.log(prior/(1-prior))
def meta_oof(Xtr,Cv):
    Pm=np.zeros_like(Y,float)
    for ti,vi in folds:
        for c in range(19):
            y=Y[ti,c]
            if y.sum()<2: Pm[vi,c]=y.mean(); continue
            m=make_pipeline(StandardScaler(),LogisticRegression(C=Cv,max_iter=2000,class_weight="balanced"))
            m.fit(Xtr[ti],y); Pm[vi,c]=m.predict_proba(Xtr[vi])[:,1]
    return Pm
for cats,num in [(["site","month","hour"],["year","doy","minute"]),
                 (["site","month","hour","site_month"],["year","doy","minute"]),
                 (["site","hour","site_month"],["year","doy"]),
                 ]:
    Xtr,Xte=build(cats,num)
    for Cv in [0.1,0.5,2.0]:
        Pm=meta_oof(Xtr,Cv)
        print(f"cats={len(cats)} C={Cv} meta micro={C.global_auc(Y,Pm):.4f} macro={C.per_class_auc(Y,Pm)[0]:.4f}")
        Zm=z(Pm); E=Zb+0.1*Zm+0.1*Za+0.05*Zp
        for lam in [0.2,0.25,0.3,0.35,0.4]:
            S=E+lam*lp[None,:]
