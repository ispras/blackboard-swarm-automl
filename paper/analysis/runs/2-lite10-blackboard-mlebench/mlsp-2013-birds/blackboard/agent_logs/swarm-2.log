"bme":lc("workspaces/castor_rho/oof/bme_probe_oof.csv",tr.rec_id),
"meta":e["Pm"],"audio":e["Pa"],"prov":e["Pp"],"pw":w["Pw"],"knn":K,
"mil":lc("workspaces/arcturus_kappa/oof/mil_seg_oof.csv",tr.rec_id)}
prior=Y.mean(0); lp=np.log(prior/(1-prior))
configs={
"A":{"bn_h05":1.0,"meta":0.1,"audio":0.1,"prov":0.05,"pw":0.15,"knn":0.15,"bne":0.1,"bme":0.05},
"B":{"bn_glob":1.0,"bn_h05":0.5,"bne":0.1,"bme":0.15,"meta":0.1,"audio":0.02,"prov":0.02,"pw":0.1},
"C":{"bn_h05":1.0,"meta":0.15,"audio":0.05,"prov":0.05,"pw":0.15,"knn":0.15,"bne":0.15,"bme":0.1,"mil":0.05},
"D":{"bn_h05":1.0,"bn_glob":0.3,"meta":0.15,"pw":0.15,"knn":0.1,"bne":0.15,"bme":0.1},
}
for mode in ["z","rank"]:
    Z={k:lzd(v,mode) for k,v in comp.items()}
    for name,wts in configs.items():
