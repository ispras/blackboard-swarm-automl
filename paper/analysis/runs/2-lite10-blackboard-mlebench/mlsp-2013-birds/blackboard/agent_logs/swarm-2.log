def zscore(P):
    Q = np.zeros_like(P, dtype=float)
    for c in range(P.shape[1]):
        sd = P[:, c].std()
        Q[:, c] = (P[:, c] - P[:, c].mean()) / (sd + 1e-9) if sd > 1e-12 else 0.0
    return np.clip(Q, -CLIP, CLIP)


