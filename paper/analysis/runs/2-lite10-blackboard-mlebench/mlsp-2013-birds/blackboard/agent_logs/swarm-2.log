Xtr=np.hstack([oh.iloc[:len(Dtr)].values,Dtr[num].values]); Xte=np.hstack([oh.iloc[len(Dtr):].values,Dte[num].values])
print(Xtr.shape)
def z(P):
    Z=np.zeros_like(P)
    for c in range(19): Z[:,c]=(P[:,c]-P[:,c].mean())/(P[:,c].std()+1e-9)
