import sys; sys.path.insert(0,"workspaces/arcturus_kappa")
import common as C, numpy as np, pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.isotonic import IsotonicRegression
tr,Y,te,Yt=C.load_labels()
cv=pd.read_csv("workspaces/castor_rho/shared/cv_folds.csv"); fm=dict(zip(cv.rec_id,cv.fold)); ftr=tr.rec_id.map(fm).values
def lc(p,ids):
    d=pd.read_csv(p).set_index("rec_id").reindex(ids); return d[[f"pred_{i}" for i in range(19)]].values
def z(P):
    Q=np.zeros_like(P)
    for c in range(19): Q[:,c]=(P[:,c]-P[:,c].mean())/(P[:,c].std()+1e-9)
    return Q
e=np.load("workspaces/arcturus_kappa/ens_oof_test.npz"); w=np.load("workspaces/arcturus_kappa/priors_weighted.npz")
d=np.load("workspaces/castor_rho/artifacts/birdnet_emb.npz",allow_pickle=True)
E=pd.DataFrame(d["emb"],index=d["rec_id"]); ids=np.concatenate([tr.rec_id.values,te.rec_id.values]); E=E.reindex(ids).values
E=E/(np.linalg.norm(E,axis=1,keepdims=True)+1e-9); n=len(tr); Et=E[:n]; K=np.zeros((n,19))
for i in range(n):
    idx=np.where(ftr!=ftr[i])[0]; s=Et[idx]@Et[i]; top=idx[np.argsort(-s)[:20]]; ss=Et[top]@Et[i]
    ww=np.exp((ss-ss.max())/0.02); K[i]=(ww[:,None]*Y[top]).sum(0)/ww.sum()
comp={"bn_h05":lc("workspaces/castor_rho/oof/birdnet_h05max_oof.csv",tr.rec_id),
"bne":lc("workspaces/castor_rho/oof/bne_probe_oof.csv",tr.rec_id),
"bme":lc("workspaces/castor_rho/oof/bme_probe_oof.csv",tr.rec_id),
"meta":e["Pm"],"audio":e["Pa"],"prov":e["Pp"],"pw":w["Pw"],"knn":K}
Z={k:z(v) for k,v in comp.items()}
wts={"bn_h05":1.0,"meta":0.1,"audio":0.1,"prov":0.05,"pw":0.15,"knn":0.15,"bne":0.1,"bme":0.05}
B=sum(wt*Z[k] for k,wt in wts.items())
prior=Y.mean(0); lp=np.log(prior/(1-prior))
print("raw B micro",C.global_auc(Y,B),"macro",C.per_class_auc(Y,B)[0])
for lam in [0.3,0.35,0.4,0.45]:
    S=B+lam*lp[None,:]; print(f"z+offset lam={lam} micro={C.global_auc(Y,S):.4f} macro={C.per_class_auc(Y,S)[0]:.4f}")
# cross-fitted per-class logistic calibration
def calib(B, kind="logit", Cval=1.0):
    P=np.zeros_like(B)
    for k in range(5):
        ti=np.where(ftr!=k)[0]; vi=np.where(ftr==k)[0]
        for c in range(19):
            y=Y[ti,c]
            if y.sum()<2 or y.sum()>len(y)-2: P[vi,c]=y.mean(); continue
            x=B[ti,c][:,None]
            if kind=="logit":
                m=LogisticRegression(C=Cval,max_iter=1000); m.fit(x,y); P[vi,c]=m.predict_proba(B[vi,c][:,None])[:,1]
            else:
                m=IsotonicRegression(out_of_bounds="clip"); m.fit(x.ravel(),y); P[vi,c]=m.predict(B[vi,c])
    return P
for kind in ["logit","iso"]:
    P=calib(B,kind)
    print(f"calib {kind} micro={C.global_auc(Y,P):.4f} macro={C.per_class_auc(Y,P)[0]:.4f}")
    for lam in [0.05,0.1,0.2,0.3]:
        # mix calibrated prob with prior in logit space
        S=np.log(np.clip(P,1e-6,1-1e-6)/(1-np.clip(P,1e-6,1-1e-6)))+lam*lp[None,:]
        print(f"  +offset lam={lam} micro={C.global_auc(Y,S):.4f} macro={C.per_class_auc(Y,S)[0]:.4f}")
