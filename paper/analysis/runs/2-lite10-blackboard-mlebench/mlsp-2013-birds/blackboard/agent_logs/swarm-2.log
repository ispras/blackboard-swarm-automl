cv=pd.read_csv("workspaces/castor_rho/shared/cv_folds.csv"); fm=dict(zip(cv.rec_id,cv.fold))
ftr=tr.rec_id.map(fm).values
G=C.parse_meta(tr); Gt=C.parse_meta(te)
def keys(M,kind):
    if kind=="grp": return (M.site+"_"+M.date+"_"+M.time).values
    return (M.site+"_"+M.date).values
def honest_prior(kind):
    key=keys(G,kind)
    P=np.zeros_like(Y,float); cnt=np.zeros(len(tr))
    for i in range(len(tr)):
        mask=(key==key[i])&(ftr!=ftr[i])
        if mask.sum()>0:
            P[i]=Y[mask].mean(0); cnt[i]=mask.sum()
    # test: all train siblings
    keyt=keys(Gt,kind)
    T=np.zeros((len(te),19),float); cntt=np.zeros(len(te))
    for i in range(len(te)):
        mask=(key==keyt[i])
        if mask.sum()>0:
            T[i]=Y[mask].mean(0); cntt[i]=mask.sum()
    return P,T,cnt,cntt
