for f in ['workspaces/capella_xi/members/bellatrix_swin_merged_test.csv','workspaces/capella_xi/members/bellatrix_swin_s123_merged_test.csv',
          'workspaces/capella_xi/members/altair_effml_test.csv','workspaces/capella_xi/members/altair_cnb_test.csv',
          'workspaces/capella_xi/members/bellatrix_b0_test.csv']:
    tp.append(norm(L(f).reindex(E1t.index)[P].values))
