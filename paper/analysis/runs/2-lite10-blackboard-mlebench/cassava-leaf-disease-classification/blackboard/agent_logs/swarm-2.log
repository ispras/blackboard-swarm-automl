import numpy as np, pandas as pd, sys
sys.path.insert(0,'.')
from final_blend import norm, acc, fit_weights, class_bias, P
from sklearn.model_selection import StratifiedKFold
E1=pd.read_csv('blend_v2/E1_oof.csv').set_index('image_id')
singles={n:pd.read_csv(f'members/{n}_oof.csv').set_index('image_id') for n in ['bellatrix_swin','bellatrix_eva02','bellatrix_b0']}
idx=E1.index
for d in singles.values(): idx=idx.intersection(d.index)
idx=idx.sort_values(); y=E1.loc[idx,'label'].values.astype(int)
base={'E1':norm(E1.loc[idx,P].values)}
for n,d in singles.items(): base[n]=norm(d.loc[idx,P].values)

def fit_bias(V,y):
    w,_=fit_weights(V,y,n_restart=4,seed=13)
    p=norm(np.tensordot(w,V,axes=(0,0)))
    b=class_bias(p,y)
    return w,b

def probs(V,w,b): return norm(np.tensordot(w,V,axes=(0,0))*np.exp(b)[None,:])

sets={'all4':['E1','bellatrix_swin','bellatrix_eva02','bellatrix_b0'],
      '3b0':['E1','bellatrix_swin','bellatrix_b0'],
      '3eva':['E1','bellatrix_swin','bellatrix_eva02']}
accs={k:[] for k in ['all4','3b0','3eva','meta','meta2']}
for seed in [1,2,3]:
    skf=StratifiedKFold(5,shuffle=True,random_state=seed*100+7)
    for tr,va in skf.split(np.zeros(len(y)),y):
        ps={}
        for name,ss in sets.items():
            V=np.stack([base[n] for n in ss],0)
            w,b=fit_bias(V[:,tr],y[tr])
            ps[name]=probs(V[:,va],w,b)
            accs[name].append(acc(ps[name],y[va]))
        accs['meta'].append(acc(norm(ps['all4']+ps['3b0']),y[va]))
        accs['meta2'].append(acc(norm(0.6*ps['all4']+0.4*ps['3b0']),y[va]))
for k,v in accs.items(): print(k, f'{np.mean(v):.4f} +- {np.std(v):.4f}')
