import argparse, os
import numpy as np
import pandas as pd
import cv2, torch
from torch.utils.data import Dataset, DataLoader
import timm
import albumentations as A
from albumentations.pytorch import ToTensorV2

DATA = '/download_job_code/payload/sandbox/data'
MEAN = (0.485, 0.456, 0.406)
STD = (0.229, 0.224, 0.225)


class TestDS(Dataset):
    def __init__(self, ids, size, img_dir, tf):
        self.ids = ids; self.img_dir = img_dir; self.tf = tf

    def __len__(self):
        return len(self.ids)

    def __getitem__(self, i):
        p = os.path.join(self.img_dir, self.ids[i])
        img = cv2.cvtColor(cv2.imread(p), cv2.COLOR_BGR2RGB)
        return self.tf(image=img)['image']


def infer(model, loader, tta):
    model.eval(); out = []
    with torch.no_grad():
        for x in loader:
            x = x.cuda(non_blocking=True)
            with torch.autocast('cuda', dtype=torch.float16):
                if tta.startswith('rot'):
                    n = int(tta[3:]) if len(tta) > 3 else 8
                    logits = 0
                    views = 0
                    for k in range(4):
                        xr = torch.rot90(x, k, dims=[2, 3])
                        logits = logits + model(xr).float(); views += 1
                        if views < n:
                            logits = logits + model(torch.flip(xr, [3])).float(); views += 1
                else:
                    logits = model(x).float()
                    if 'h' in tta:
                        logits = logits + model(torch.flip(x, [3])).float()
                    if 'v' in tta:
                        logits = logits + model(torch.flip(x, [2])).float()
            out.append(torch.softmax(logits, 1).cpu().numpy())
    return np.concatenate(out)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--model', required=True)
    ap.add_argument('--size', type=int, required=True)
    ap.add_argument('--ckpt', required=True)
    ap.add_argument('--out', required=True)
    ap.add_argument('--tta', default='hv')
    ap.add_argument('--batch', type=int, default=64)
    ap.add_argument('--workers', type=int, default=10)
    ap.add_argument('--split', default='val', choices=['val', 'test'])
    args = ap.parse_args()
    os.makedirs(args.out, exist_ok=True)

    tf = A.Compose([A.Resize(args.size, args.size), A.Normalize(MEAN, STD), ToTensorV2()])
    if args.split == 'test':
        df = pd.read_csv(f'{DATA}/sample_submission.csv')
        ids = df.image_id.tolist(); img_dir = f'{DATA}/test_images'
    else:
        from sklearn.model_selection import train_test_split
        df = pd.read_csv(f'{DATA}/train.csv')
        _, vidx = train_test_split(np.arange(len(df)), test_size=0.15, random_state=42,
                                   stratify=df.label.values)
        df = df.iloc[vidx].reset_index(drop=True)
        ids = df.image_id.tolist(); img_dir = f'{DATA}/train_images'

    ds = TestDS(ids, args.size, img_dir, tf)
    dl = DataLoader(ds, batch_size=args.batch, shuffle=False, num_workers=args.workers, pin_memory=True)
    model = timm.create_model(args.model, pretrained=False, num_classes=5).cuda()
