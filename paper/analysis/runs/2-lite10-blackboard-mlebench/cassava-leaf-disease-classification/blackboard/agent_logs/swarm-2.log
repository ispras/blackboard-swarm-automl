import numpy as np, pandas as pd, sys
sys.path.insert(0,'.')
from final_blend import norm, acc, fit_temps, temper, P
from sklearn.model_selection import StratifiedKFold
E1=pd.read_csv('stackA/E1_oof.csv').set_index('image_id')
files={'swin42':'members/bellatrix_swin_oof.csv','swin123':'members/bellatrix_swin_s123_oof.csv',
       'effml':'members/altair_effml_oof.csv','cnb':'members/altair_cnb_oof.csv','b0':'members/bellatrix_b0_oof.csv'}
idx=E1.index
for f in files.values(): idx=idx.intersection(pd.read_csv(f).set_index('image_id').index)
idx=idx.sort_values(); y=E1.loc[idx,'label'].values.astype(int)
V=np.stack([norm(E1.loc[idx,P].values)]+[norm(pd.read_csv(f).set_index('image_id').loc[idx,P].values) for f in files.values()],0)
print('n',len(y),'equal',acc(np.mean(V,0),y))
for seed in [1,2,3]:
    skf=StratifiedKFold(5,shuffle=True,random_state=seed*100+7)
    accs={'eq':[], 'eqT':[], 'gm':[], 'pow2':[]}
    for tr,va in skf.split(np.zeros(len(y)),y):
        T=fit_temps(V[:,tr],y[tr]); Vt=temper(V,T)
        accs['eq'].append(acc(np.mean(V[:,va],0),y[va]))
        accs['eqT'].append(acc(np.mean(Vt[:,va],0),y[va]))
        accs['gm'].append(acc(norm(np.exp(np.mean(np.log(np.clip(V[:,va],1e-9,1)),0))),y[va]))
        accs['pow2'].append(acc(norm(np.mean(V[:,va]**2,0)),y[va]))
    print(seed, {k:round(float(np.mean(v)),4) for k,v in accs.items()})
