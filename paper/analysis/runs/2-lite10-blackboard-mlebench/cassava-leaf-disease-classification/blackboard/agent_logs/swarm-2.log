            for tr,va in skf.split(Xf,y):
                lr=LogisticRegression(C=C,max_iter=3000)
                lr.fit(Xf[tr],y[tr]); oofp[va]=lr.predict_proba(Xf[va])
            accs.append(acc(oofp,y))
        out[C]=(np.mean(accs),np.std(accs))
    return out
# weighted-average reference via in-fold weight fitting
accs=[]
for seed in (1,2):
    skf=StratifiedKFold(5,shuffle=True,random_state=seed*100+7)
    oofp=np.zeros((len(y),5))
    for tr,va in skf.split(np.zeros(len(y)),y):
        w,_=fit_weights(V[:,tr],y[tr],n_restart=4,seed=seed)
        oofp[va]=norm(np.tensordot(w,V[:,va],axes=(0,0)))
    accs.append(acc(oofp,y))
print('weighted-avg CV',np.mean(accs),np.std(accs))
for name,Xf in [('prob',np.concatenate(list(V),1)),('log',np.concatenate([np.log(np.clip(v,1e-6,1)) for v in V],1))]:
    r=cv(Xf)
    for C,(m,s) in r.items(): print(f'LR {name} C={C}: {m:.4f} +- {s:.4f}')
