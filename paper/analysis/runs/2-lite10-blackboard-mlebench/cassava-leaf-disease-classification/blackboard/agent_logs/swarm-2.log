import pandas as pd, numpy as np
P=[f'p{i}' for i in range(5)]
def norm(a): return a/np.clip(a.sum(-1,keepdims=True),1e-9,None)
def L(f): return pd.read_csv(f).set_index('image_id')
E1=pd.read_csv('/tmp/opencode/qa_stack/E1_oof.csv').set_index('image_id')
y=E1.loc[sorted(E1.index),'label'].values
valf=['workspaces/capella_xi/members/bellatrix_swin_oof.csv','workspaces/capella_xi/members/bellatrix_swin_s123_oof.csv',
      'workspaces/capella_xi/members/altair_effml_oof.csv','workspaces/capella_xi/members/altair_cnb_oof.csv',
      'workspaces/capella_xi/members/bellatrix_b0_oof.csv']
idx=E1.index
for f in valf: idx=idx.intersection(L(f).index)
idx=idx.sort_values()
V=[norm(E1.loc[idx,P].values)]+[norm(L(f).loc[idx,P].values) for f in valf]
print('QA val acc', ((np.mean(V,0)).argmax(1)==E1.loc[idx,'label'].values.astype(int)).mean())
E1t=pd.read_csv('/tmp/opencode/qa_stack/E1_test.csv').set_index('image_id')
