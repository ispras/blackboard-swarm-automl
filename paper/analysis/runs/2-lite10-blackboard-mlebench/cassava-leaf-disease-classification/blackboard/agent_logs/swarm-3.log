    print(tag,'test mc done',tp.shape,'test argmax change',(bt.argmax(1)!=avg.argmax(1)).sum(),flush=True)
    # val avg
    idx=np.load(f'{OUT}/oof_idx_{tag}_f0.npy'); vids=df.image_id.values[idx]
    vm=np.load(f'{OUT}/oof_mc_{tag}_f0.npy'); vb=np.load(f'{OUT}/oof_{tag}_f0.npy'); va=(vb+vm)/2
    vd=pd.DataFrame(va,columns=P); vd.insert(0,'image_id',vids); vd.to_csv(f'workspaces/altair_chi/{tag}_avg_val_probs.csv',index=False)
