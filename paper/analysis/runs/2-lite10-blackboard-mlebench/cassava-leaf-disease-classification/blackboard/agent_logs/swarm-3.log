 'cnb':'workspaces/altair_chi/cnb_val_probs.csv',
 'b0':'workspaces/altair_chi/b0_val_probs.csv'}.items()}
p=np.mean([mem[k] for k in mem],0); lp=np.log(np.clip(p,1e-9,1))
def acc(pp,yy): return (pp.argmax(1)==yy).mean()
res={'none':[], 'acc_bias':[], 'prior':[]}
for seed in range(5):
    skf=StratifiedKFold(5,shuffle=True,random_state=seed)
    for tr,va in skf.split(p,y):
        res['none'].append(acc(p[va],y[va]))
        # accuracy-optimized per-class bias on train (coordinate search)
        b=np.zeros(5)
        cur=acc((lp[tr]+b).argmax(1),y[tr])
        for it in range(30):
            improved=False
            for c in range(5):
                for d in (-0.3,-0.1,0.1,0.3):
                    bb=b.copy(); bb[c]+=d
                    a=acc((lp[tr]+bb).argmax(1),y[tr])
                    if a>cur: cur=a; b=bb; improved=True
            if not improved: break
        res['acc_bias'].append(acc((lp[va]+b).argmax(1),y[va]))
        # prior correction: offset by log(train prior)
        prior=np.bincount(y[tr],minlength=5)/len(tr)
        res['prior'].append(acc((lp[va]+np.log(prior)).argmax(1),y[va]))
for k,v in res.items(): print(k, np.mean(v), np.std(v))
