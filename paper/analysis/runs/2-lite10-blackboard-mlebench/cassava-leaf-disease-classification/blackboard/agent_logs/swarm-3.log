import numpy as np, pandas as pd, itertools
from sklearn.model_selection import StratifiedKFold
P=[f'p{i}' for i in range(5)]
def load(vp):
    d=pd.read_csv(vp); d[P]=d[P].values/np.clip(d[P].values.sum(1,keepdims=True),1e-9,None); return d
E1=load('workspaces/capella_xi/stackA/E1_oof.csv')
base={
 'E1':E1,
 'swin42':load('workspaces/bellatrix_tau/runs/swinb_384/val_probs_rot8.csv'),
 'swin123':load('workspaces/bellatrix_tau/runs/swinb_384_s123/val_probs_rot8.csv'),
 'effml':load('workspaces/altair_chi/effml_val_probs.csv'),
 'cnb':load('workspaces/altair_chi/cnb_val_probs.csv'),
 'b0':load('workspaces/altair_chi/b0_val_probs.csv'),
 'eva':load('workspaces/bellatrix_tau/runs/eva02_448/val_probs_hv.csv'),
 'effml_avg':load('workspaces/altair_chi/effml_avg_val_probs.csv'),
 'cnb_avg':load('workspaces/altair_chi/cnb_avg_val_probs.csv'),
}
ids=base['effml'].image_id
y=E1.set_index('image_id').loc[ids,'label'].values.astype(int)
V={}
for k,d in base.items():
    V[k]=d.set_index('image_id').loc[ids,P].values
names=list(V.keys())
v7=['E1','swin42','swin123','effml','cnb','b0']
def acc(p,y): return (p.argmax(1)==y).mean()

# ---- candidate fixed subsets with equal weights, plain holdout acc (for reference) ----
print('--- fixed equal-weight subsets (2,809 rows, optimistic as selected) ---')
cand=[v7,
      ['E1','swin42','swin123','effml','cnb'],
      ['E1','swin42','swin123','effml','cnb','b0','eva'],
      ['E1','swin42','swin123','effml_avg','cnb_avg','b0'],
      ['E1','swin42','swin123','effml','cnb','effml_avg','cnb_avg','b0'],
      ['E1','effml','cnb','swin42','swin123'],
      ['E1','effml_avg','cnb_avg','swin42','swin123','b0']]
for s in cand:
    p=np.mean([V[k] for k in s],0); print(f'{len(s)} {s} -> {acc(p,y):.4f}')

# ---- nested CV: select subset on train, evaluate on val ----
def run_nested(member_names):
    n=len(member_names); subsets=[]
    for r in range(1,n+1):
        for comb in itertools.combinations(range(n),r):
            m=0
            for i in comb: m|=1<<i
            subsets.append(m)
    res={'select_top1':[],'select_top3avg':[],'v7_fixed':[],'all_equal':[]}
    v7mask=0
    for i,nm in enumerate(member_names):
        if nm in v7: v7mask|=1<<i
    accs_sub=np.zeros((len(subsets),))
    for seed in range(5):
        skf=StratifiedKFold(5,shuffle=True,random_state=seed)
        for tr,va in skf.split(np.zeros(len(y)),y):
            tr_acc=np.empty(len(subsets)); va_acc=np.empty(len(subsets))
            for j,m in enumerate(subsets):
                idx=[i for i in range(n) if m>>i&1]
                p=np.mean([V[member_names[i]] for i in idx],0)
                tr_acc[j]=acc(p[tr],y[tr]); va_acc[j]=acc(p[va],y[va])
            order=np.argsort(-tr_acc)
            res['select_top1'].append(va_acc[order[0]])
            top3=order[:3]
            # top3 average of probs
            ps=[]
            for j in top3:
                idx=[i for i in range(n) if subsets[j]>>i&1]
                ps.append(np.mean([V[member_names[i]] for i in idx],0)[va])
            res['select_top3avg'].append(acc(np.mean(ps,0),y[va]))
            if (v7mask in subsets):
                res['v7_fixed'].append(va_acc[subsets.index(v7mask)])
            res['all_equal'].append(va_acc[subsets.index((1<<n)-1)])
    for k,v in res.items():
        print(f'  {k}: {np.mean(v):.4f} +- {np.std(v):.4f}')
print('--- nested subset selection: 7 core members ---')
core=['E1','swin42','swin123','effml','cnb','b0','eva']
run_nested(core)
print('--- nested subset selection: 9 (with avg TTA variants) ---')
run_nested(names)
EOF
