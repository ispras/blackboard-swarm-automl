import numpy as np, pandas as pd, torch, timm, torchvision.transforms as T
from torch.utils.data import Dataset, DataLoader
from PIL import Image
DATA='/download_job_code/payload/sandbox/data'; OUT='/download_job_code/payload/sandbox/workspaces/altair_chi/out'
class DS(Dataset):
    def __init__(s,ids,root,sz): s.ids=ids; s.root=root; s.sz=sz
    def __len__(s): return len(s.ids)
    def __getitem__(s,i):
        im=Image.open(f'{s.root}/{s.ids[i]}').convert('RGB')
        im=T.Resize(int(s.sz*1.33))(im)
        W,H=im.size; c=s.sz
        crops=[im.crop((0,0,c,c)),im.crop((W-c,0,W,c)),im.crop((0,H-c,c,H)),im.crop((W-c,H-c,W,H)),im.crop(((W-c)//2,(H-c)//2,(W-c)//2+c,(H-c)//2+c))]
        tf=T.Compose([T.ToTensor(),T.Normalize((0.485,0.456,0.406),(0.229,0.224,0.225))])
        return torch.stack([tf(x) for x in crops])
@torch.no_grad()
def pred(model,dl,dev):
    model.eval(); o=[]
    for x in dl:
        B,C,sz,_=x.shape; x=x.view(B*C,3,sz,sz).to(dev)
        with torch.autocast('cuda',dtype=torch.bfloat16):
            p=torch.softmax(model(x).float(),1).view(B,C,5).mean(1)
            p=p+torch.softmax(model(torch.flip(x,[3])).float(),1).view(B,C,5).mean(1)
        o.append((p/2).cpu().numpy())
    return np.concatenate(o,0)
df=pd.read_csv(f'{DATA}/train.csv')
for tag,model_name,np_path,np_idx in [('effml','tf_efficientnetv2_l','oof_effml_f0.npy','oof_idx_effml_f0.npy'),('cnb','convnext_base.fb_in22k_ft_in1k','oof_cnb_f0.npy','oof_idx_cnb_f0.npy')]:
    idx=np.load(f'{OUT}/{np_idx}'); ids=df.image_id.values[idx]; y=df.label.values[idx]
    dl=DataLoader(DS(ids,f'{DATA}/train_images',384),batch_size=8,shuffle=False,num_workers=6,pin_memory=True)
    m=timm.create_model(model_name,pretrained=False,num_classes=5)
    m.load_state_dict(torch.load(f'{OUT}/model_{tag}_f0.pth',map_location='cpu')); m.to('cuda')
    p=pred(m,dl,'cuda'); base=np.load(f'{OUT}/{np_path}')
    print(tag,'multicrop_hflip acc',(p.argmax(1)==y).mean(),'current acc',(base.argmax(1)==y).mean(),flush=True)
    np.save(f'{OUT}/oof_mc_{tag}_f0.npy',p)
