y=E1.set_index('image_id').loc[ids,'label'].values.astype(int)
mem={k:load(v).set_index('image_id').loc[ids,P].values for k,v in {
 'E1':'workspaces/capella_xi/stackA/E1_oof.csv',
 'swin42':'workspaces/bellatrix_tau/runs/swinb_384/val_probs_rot8.csv',
 'swin123':'workspaces/bellatrix_tau/runs/swinb_384_s123/val_probs_rot8.csv',
