import numpy as np, pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import StandardScaler
P=[f'p{i}' for i in range(5)]
def load(vp):
    d=pd.read_csv(vp); d[P]=(d[P].values/np.clip(d[P].values.sum(1,keepdims=True),1e-9,None)); return d
E1=load('workspaces/capella_xi/stackA/E1_oof.csv')
members={
 'E1':E1,
 'swin42':load('workspaces/bellatrix_tau/runs/swinb_384/val_probs_rot8.csv'),
 'swin123':load('workspaces/bellatrix_tau/runs/swinb_384_s123/val_probs_rot8.csv'),
 'effml':load('workspaces/altair_chi/effml_val_probs.csv'),
 'cnb':load('workspaces/altair_chi/cnb_val_probs.csv'),
 'b0':load('workspaces/altair_chi/b0_val_probs.csv'),
 'eva':load('workspaces/bellatrix_tau/runs/eva02_448/val_probs_hv.csv'),
}
ids=E1.image_id
y=E1.set_index('image_id').loc[ids,'label'].values.astype(int)
for k,d in members.items():
    d=d.set_index('image_id').loc[ids]
    members[k]=d
    print(k,'acc',(d[P].values.argmax(1)==y).mean())
# feature builder
def feats(keys, logit=False):
    out=[]
    for k in keys:
        v=members[k][P].values
        if logit: v=np.log(np.clip(v,1e-6,1))
        out.append(v)
    return np.concatenate(out,1)
def cv_acc(X, y, C, seeds=(0,1,2,3,4)):
    accs=[]
    for s in seeds:
        skf=StratifiedKFold(5,shuffle=True,random_state=s)
        pr=np.zeros((len(y),5))
        for tr,va in skf.split(X,y):
            m=LogisticRegression(C=C,max_iter=2000,multi_class='multinomial')
            m.fit(X[tr],y[tr]); pr[va]=m.predict_proba(X[va])
        accs.append((pr.argmax(1)==y).mean())
    return float(np.mean(accs)), float(np.std(accs))
key_sets=[['E1','swin42','swin123','effml','cnb','b0'],
          ['E1','swin42','swin123','effml','cnb','b0','eva'],
          ['E1','swin42','swin123','effml','cnb'],
          ['E1','effml','cnb']]
for ks in key_sets:
    X=feats(ks,logit=True)
    for C in [0.01,0.03,0.1,0.3,1.0]:
        m,s=cv_acc(X,y,C)
        print(f'LR logit C={C} keys={len(ks)} {ks} -> {m:.4f} +- {s:.4f}', flush=True)
# equal baseline
for ks in key_sets:
    p=np.mean([members[k][P].values for k in ks],0)
    print('equal',len(ks),ks,'->',(p.argmax(1)==y).mean())
EOF
