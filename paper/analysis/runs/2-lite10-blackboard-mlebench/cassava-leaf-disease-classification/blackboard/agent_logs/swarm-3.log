import os, numpy as np, pandas as pd, torch
from torch.utils.data import Dataset, DataLoader
from PIL import Image
import timm, torchvision.transforms as T
DATA='/download_job_code/payload/sandbox/data'; OUT='/download_job_code/payload/sandbox/workspaces/altair_chi/out'
class DS(Dataset):
    def __init__(s, ids, root, tf): s.ids=ids; s.root=root; s.tf=tf
    def __len__(s): return len(s.ids)
    def __getitem__(s,i): return s.tf(Image.open(os.path.join(s.root,s.ids[i])).convert('RGB'))
@torch.no_grad()
def pred(model, dl, dev):
    model.eval(); o=[]
    for x in dl:
        x=x.to(dev)
        with torch.autocast('cuda', dtype=torch.bfloat16):
            l=model(x).float()+model(torch.flip(x,[3])).float()
        o.append(torch.softmax(l/2,1).cpu().numpy())
    return np.concatenate(o,0)
df=pd.read_csv(f'{DATA}/train.csv'); idx=np.load(f'{OUT}/oof_idx_effm_f0.npy')
y=df.label.values[idx]; ids=df.image_id.values[idx]
for sz in [448,512]:
    tf=T.Compose([T.Resize(int(sz*1.14)),T.CenterCrop(sz),T.ToTensor(),T.Normalize((0.485,0.456,0.406),(0.229,0.224,0.225))])
    dl=DataLoader(DS(ids,f'{DATA}/train_images',tf),batch_size=16,shuffle=False,num_workers=4,pin_memory=True)
    m=timm.create_model('tf_efficientnetv2_m',pretrained=False,num_classes=5)
    m.load_state_dict(torch.load(f'{OUT}/model_effm_f0.pth',map_location='cpu')); m.to('cuda')
    p=pred(m,dl,'cuda'); print(sz,'val_acc', (p.argmax(1)==y).mean(), flush=True)
EOF
