import json, math, statistics
import Levenshtein
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
lm={json.loads(l)['id']:json.loads(l) for l in open('val_lm_true.jsonl')}
bt={json.loads(l)['id']:json.loads(l) for l in open('val_bertrl_true.jsonl')}
fomc={}
for l in open('../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'):
    o=json.loads(l);fomc[o['id']]=o
def fw(i,g):
    d={}
    for it in (fomc.get(i,{}).get('cands') or []):
        gg,w,c=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and c>0:d[w]=d.get(w,0)+c
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def medoid(P,mpb=0.05,depth=3):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+4.57)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def cost(i,x):
    d=truth[i];T=[t for t in d['orig'].split(' ') if t];g=d['gap'];ds=T[:g]+T[g+1:]
    return Levenshtein.distance(d['orig'],' '.join(ds[:g]+([x] if x else [])+ds[g:]))
ids=[i for i in lm if i in bt and i in truth]
def ev(wb,wl,wbt,alpha):
    ds=[]
    for i in ids:
        g=lm[i]['gap'];P={}
        for w,lp in lm[i]['base'][:15]:
            if w:P[w]=P.get(w,0)+wb*math.exp(lp)
        for w,lp in lm[i]['large'][:15]:
            if w:P[w]=P.get(w,0)+wl*math.exp(lp)
        for w,lp in bt[i]['words'][:15]:
            if w:P[w]=P.get(w,0)+wbt*math.exp(lp)
        for w,v in fw(i,g).items():P[w]=P.get(w,0)+alpha*v
        ds.append(cost(i,medoid(P)))
    return statistics.mean(ds)
print('bert-large solo',ev(0,0,1,0))
print('current .3/.7/0/.3',ev(0.3,0.7,0,0.3))
best=None
for wbt in [0.2,0.3,0.4,0.6,1.0]:
    for wb in [0.2,0.3]:
        wl=1-wb
        m=ev(wb,wl,wbt,0.3)
        print(f'wb={wb} wl={wl} bert={wbt} alpha.3: {m:.4f}',flush=True)
        if best is None or m<best[0]:best=(m,wb,wl,wbt)
print('BEST',best)
EOF
