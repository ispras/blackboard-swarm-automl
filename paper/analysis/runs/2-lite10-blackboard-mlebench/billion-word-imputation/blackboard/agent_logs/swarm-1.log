import json, statistics, math
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

def feats(i):
    r=dev[i]; T=r['corrupted'].split(' '); n=len(T); pred=mlm[i]['pred']; cs=cau[i]['cscore']
    F={}
    for gs,d in pred.items():
        g=int(gs)
        if not(1<=g<n): continue
        pairs=[(norm(w),lp) for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if len(pairs)<2: continue
        ws=[x for x,_ in pairs]; lps=[lp for _,lp in pairs]
        top1=lps[0]; mx=max(lps); l20=lps[-1]
        nxt=T[g]; prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        F[g]=dict(top1=top1,mx=mx,spread=mx-l20,marg_nxt=mx-lp_nxt,marg_prv=mx-lp_prv,
                  caus=cs.get(gs,0.0),word=ws[0])
    return F

def zcomb(F,keys,weights):
    out={g:0.0 for g in F}
    for k,w in zip(keys,weights):
        vals=[F[g][k] for g in F]; m=statistics.mean(vals); s=statistics.pstdev(vals) or 1.0
        for g in F: out[g]+=w*(F[g][k]-m)/s
    return out

def cost(r,g,x):
    T=r['corrupted'].split(' '); n=len(T); g=max(0,min(g,n))
    return Levenshtein.distance(r['orig'],' '.join(T[:g]+([x] if x else [])+T[g:]))

FEATKEYS=['marg_nxt','caus']; W=[1,1]
cache={}
for i,r in dev.items():
    F=feats(i)
    if not F: continue
    z=zcomb(F,FEATKEYS,W)
    order=sorted(z,key=lambda g:z[g],reverse=True)
    g1=order[0]; g2=order[1] if len(order)>1 else g1
    margin=z[g1]-z[g2]
    cache[i]=(g1,margin,F[g1]['word'],F[g1]['top1'],r)

print('n',len(cache))
# gap top1 acc
gacc=statistics.mean(g1==r['gap'] for g1,m,w,t,r in cache.values())
wacc=statistics.mean((g1==r['gap'] and w==r['true']) for g1,m,w,t,r in cache.values())
print('gap top1',gacc,'word joint',wacc)
# thresholds on margin
ms=sorted(m for g1,m,w,t,r in cache.values())
qs=[ms[min(len(ms)-1,int(len(ms)*q))] for q in [0.1,0.25,0.5,0.6,0.7,0.8,0.9]]
print('margin quantiles',[round(x,2) for x in qs])
print('\n-- act if margin>=thr, insert full top1 word --')
for thr in [-1e9,0,0.5,0.8,1.0,1.2,1.5,1.8,2.0,2.5,3.0]:
    ds=[];act=0;correct=0
    for g1,m,w,t,r in cache.values():
        if m>=thr:
            act+=1; d=cost(r,g1,w); correct+= (g1==r['gap'] and w==r['true'])
        else: d=cost(r,0,'')
        ds.append(d)
    print(f'thr={thr:.2f} act={act/len(cache):.2%} loc_acc_acted={correct/max(1,act):.2%} mean={statistics.mean(ds):.4f}')
print('\n-- act if margin>=thr, insert PREFIX2 --')
for thr in [-1e9,0.5,0.8,1.0,1.2,1.5,1.8,2.0,2.5,3.0]:
    ds=[];act=0
    for g1,m,w,t,r in cache.values():
        if m>=thr: act+=1; d=cost(r,g1,w[:2] if len(w)>2 else w)
        else: d=cost(r,0,'')
        ds.append(d)
    print(f'thr={thr:.2f} act={act/len(cache):.2%} mean={statistics.mean(ds):.4f}')
