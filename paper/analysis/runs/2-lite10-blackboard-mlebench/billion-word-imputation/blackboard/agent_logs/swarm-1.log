import json, statistics, math, sys, os
sys.path.insert(0,'.')
from decision import optimize_sentence
import Levenshtein

BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev=[json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')][:3000]
mlm={}
for l in open(f'{BASE}/pred_roberta_dev3k.jsonl'):
    d=json.loads(l); mlm[d['id']]=d
cau={}
cp=f'{BASE}/causal_gpt2med_dev3k.jsonl'
if os.path.exists(cp):
    for l in open(cp):
        d=json.loads(l); cau[d['id']]=d

def norm(t):
    return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

def build(r, use_causal):
    T=r['corrupted'].split(' ')
    n=len(T)
    pred=mlm[r['id']]['pred']
    cands=[]
    for gs,gapd in pred.items():
        g=int(gs)
        if not (0<=g<=n): continue
        gp=1.0
        if use_causal and r['id'] in cau and gs in cau[r['id']]['cscore']:
            gp=min(5.0, math.exp(0.25*cau[r['id']]['cscore'][gs]))
        for w,lp in zip(gapd['w'],gapd['lp']):
            x=norm(w)
            if not x: continue
            cands.append((g,x,math.exp(lp)*gp))
    return cands

def score(r,ga,x):
    T=r['corrupted'].split(' ')
    return Levenshtein.distance(r['orig'],' '.join(T[:ga]+([x] if x else [])+T[ga:]))

sub=dev[:1500]
# greedy mirfak-style
def greedy(r):
    T=r['corrupted'].split(' '); n=len(T)
    pred=mlm[r['id']]['pred']; best=(-1e18,None,None)
    for gs,gapd in pred.items():
        g=int(gs)
        for w,lp in zip(gapd['w'],gapd['lp']):
            x=norm(w)
            if not x: continue
            if x==T[g-1] or (g<n and x==T[g]): lp-=4.0
            if lp>best[0]: best=(lp,g,x)
    return best[1], best[2]
for label,fn in [('greedy',lambda r:greedy(r))]:
    ds=[]; ok=0
    for r in sub:
        g,x=fn(r); ds.append(score(r,g,x)); ok+=score(r,g,x)==0
    print(f'{label}: mean={statistics.mean(ds):.4f} exact={ok/len(ds):.3%}')

for use_causal in (False,True):
    for pb in (0.05,0.1,0.15,0.2,0.3,0.5):
        ds=[]; ch=0; exp_cost=[]
        for r in sub:
            T=r['corrupted'].split(' ')
            c=build(r,use_causal)
            ga,x,cost,kind=optimize_sentence(T,c,None,pb=pb,top_cands=20,top_gaps=3)
            ds.append(score(r,ga,x)); ch+=kind=='insert'
        print(f'opt causal={use_causal} pb={pb}: mean={statistics.mean(ds):.4f} changed={ch/len(ds):.1%}')
EOF
