import argparse, json, random, os

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--train', default='train_v2.txt')
    ap.add_argument('--out', default='dev.jsonl')
    ap.add_argument('--n', type=int, default=5000)
    ap.add_argument('--stride', type=int, default=0)
    ap.add_argument('--seed', type=int, default=1234)
    ap.add_argument('--maxlen', type=int, default=60)
    args = ap.parse_args()

    total_lines = 29998384
    stride = args.stride or max(1, total_lines // (args.n * 2))
    rng = random.Random(args.seed)
    rows = []
    with open(args.train, 'r', encoding='utf-8', errors='replace') as f:
        for i, line in enumerate(f):
            if i % stride: continue
            s = line.strip()
            if not s: continue
            words = s.split(' ')
            if len(words) < 5 or len(words) > args.maxlen: continue
            # missing word never first or last
            k = rng.randint(1, len(words) - 2)
            true = words[k]
            corrupted = words[:k] + words[k+1:]
            rows.append({'id': len(rows), 'orig': s, 'corrupted': ' '.join(corrupted),
                         'gap': k, 'true': true, 'nwords': len(words)})
            if len(rows) >= args.n: break
    with open(args.out, 'w') as f:
        for r in rows: f.write(json.dumps(r) + '\n')
    print('wrote', len(rows), 'to', args.out, 'stride', stride)

if __name__ == '__main__':
    main()
