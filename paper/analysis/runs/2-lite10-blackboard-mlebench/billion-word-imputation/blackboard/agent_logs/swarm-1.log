import json, csv, math, statistics, sys, torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
import Levenshtein
truth=[json.loads(l) for l in open('val_truth.jsonl')]
test={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
PUNCT=set()
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
def run_model(name, n=19948, topk=20, maxlen=192, batch=128):
    tok=AutoTokenizer.from_pretrained(name, add_prefix_space=True)
    model=AutoModelForMaskedLM.from_pretrained(name, torch_dtype=torch.float16).eval().cuda()
    items=[]
    for di,d in enumerate(truth[:n]):
        words=[w for w in test[d['id']].split(' ') if w!='']
        enc=tok(words,is_split_into_words=True,add_special_tokens=True,truncation=True,max_length=maxlen)
        ids=enc['input_ids'];wids=enc.word_ids()
        first={}
        for ti,w in enumerate(wids):
            if w is not None and w not in first: first[w]=ti
        g=d['gap']
        if g in first: items.append((di,ids,first[g]))
    res={}
    with torch.no_grad():
        for bi in range(0,len(items),batch):
            b=items[bi:bi+batch]; ml=max(len(x[1])+1 for x in b)
            inp=torch.full((len(b),ml),tok.pad_token_id,dtype=torch.long); att=torch.zeros((len(b),ml),dtype=torch.long); posl=[]
            for j,(di,ids,pos) in enumerate(b):
                seq=ids[:pos]+[tok.mask_token_id]+ids[pos:]; L=len(seq)
                inp[j,:L]=torch.tensor(seq); att[j,:L]=1; posl.append(pos)
            inp=inp.cuda();att=att.cuda()
            lo=model(input_ids=inp,attention_mask=att).logits
            idx=torch.arange(len(b),device='cuda')
            lp=torch.log_softmax(lo[idx,torch.tensor(posl,device='cuda')].float(),dim=-1)
            tv,ti=lp.topk(topk,dim=-1); tv=tv.cpu().numpy();ti=ti.cpu().numpy()
            for j,(di,ids,pos) in enumerate(b):
                res[di]=[(norm(tok.convert_ids_to_tokens(int(t))),float(v)) for t,v in zip(ti[j],tv[j])]
            del lo
    del model; torch.cuda.empty_cache()
    return res
def medoid(pairs,mpb=0.2,ml=4.57):
    pairs=[(w,lp) for w,lp in pairs if w][:15]
    if not pairs: return ''
    P={w-P: 0 for w,_ in []}
    P={}
    for w,lp in pairs: P[w]=P.get(w,0)+math.exp(lp)
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in (1,2,3):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
models={}
for name in ['roberta-base','bert-base-uncased','roberta-large']:
    print('running',name,flush=True)
    models[name]=run_model(name)
print('done inference',flush=True)
def actual(i,g,x):
    T=[w for w in test[truth[i]['id']].split(' ') if w!='']
    return Levenshtein.distance(truth[i]['orig'],' '.join(T[:g]+([x] if x else [])+T[g:]))
for name in models:
