import json, csv, math, statistics
import Levenshtein
vt={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
gv={json.loads(l)['id']:json.loads(l) for l in open('../fomalhaut_zeta/val_gaps_v4.jsonl')}
lm={json.loads(l)['id']:json.loads(l) for l in open('val_v4_lm.jsonl')}
tri={json.loads(l)['id']:json.loads(l) for l in open('../fomalhaut_zeta/trigram_val_chosen_v2.jsonl')}
def nc(pairs):
    d={}
    for w,c in pairs:
        if w and c>0:d[w]=d.get(w,0)+float(c)
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def medoid(P,mpb,depth,maxlen=99):
    ws=list(P);pool=set(w for w in ws if len(w)<=maxlen)
    for w in ws:
        for k in range(1,min(depth,maxlen)+1):
            if len(w)>k:pool.add(w[:k])
    if not pool: pool=set(w for w in ws)
    pool|={',','the','a','of','to','and','in','.',''}
    best=None
    for x in pool:
        if len(x)>maxlen: continue
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+4.57)
        if best is None or e<best[0]:best=(e,x)
    return best[1] if best else ''
def buildP(i,g,wb=0.3,alpha=0.3):
    o=lm[i];P={}
    for w,lp in o['base'][:15]:
        if w:P[w]=P.get(w,0)+wb*math.exp(lp)
    for w,lp in o['large'][:15]:
        if w:P[w]=P.get(w,0)+(1-wb)*math.exp(lp)
    t=tri.get(i)
    if t and int(t['gap'])==g:
        for w,v in nc(t['tri']).items():P[w]=P.get(w,0)+alpha*v
    return P
def cost(i,g,x):
    T=[t for t in vt[i].split(' ') if t]
    cand=' '.join(T) if x=='' else ' '.join(T[:g]+[x]+T[g:])
    return Levenshtein.distance(truth[i]['orig'],cand)
bins=[(0.0,0.2),(0.2,0.25),(0.25,0.3),(0.3,0.35),(0.35,0.4),(0.4,0.5),(0.5,0.6),(0.6,1.1)]
for a,b in bins:
    rows=[i for i in truth if i>=5000 and a<=gv[i]['margin']<b]
    if not rows: continue
    noop=[];full=[];short=[];p1=[];p2=[]
    for i in rows:
        g=gv[i]['gap'];T=[t for t in vt[i].split(' ') if t]
        noop.append(Levenshtein.distance(truth[i]['orig'],' '.join(T)))
        P=buildP(i,g)
        full.append(cost(i,g,medoid(P,0.03,3)) if P else noop[-1])
        p1.append(cost(i,g,medoid(P,0.03,1,maxlen=1)) if P else noop[-1])
        p2.append(cost(i,g,medoid(P,0.03,2,maxlen=2)) if P else noop[-1])
        short.append(cost(i,g,medoid(P,0.03,2,maxlen=3)) if P else noop[-1])
    print(f'margin[{a},{b}) n={len(rows)} gapacc={statistics.mean(gv[i]["gap"]==truth[i]["gap"] for i in rows):.3f} '
          f'noop={statistics.mean(noop):.3f} full={statistics.mean(full):.3f} short3={statistics.mean(short):.3f} p1={statistics.mean(p1):.3f} p2={statistics.mean(p2):.3f}',flush=True)
EOF
