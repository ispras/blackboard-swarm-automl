import argparse, json, torch, numpy as np
from transformers import AutoTokenizer, AutoModelForMaskedLM

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--model', default='roberta-base')
    ap.add_argument('--dev', default='dev.jsonl')
    ap.add_argument('--out', default='pred_dev.jsonl')
    ap.add_argument('--batch', type=int, default=256)
    ap.add_argument('--topk', type=int, default=20)
    ap.add_argument('--maxlen', type=int, default=128)
    args = ap.parse_args()

    dev = [json.loads(l) for l in open(args.dev)]
    if 'roberta' in args.model or 'gpt2' in args.model:
        tok = AutoTokenizer.from_pretrained(args.model, add_prefix_space=True)
    else:
        tok = AutoTokenizer.from_pretrained(args.model)
    model = AutoModelForMaskedLM.from_pretrained(args.model, torch_dtype=torch.float16)
    model.eval().cuda()
    mask_id = tok.mask_token_id
    device = 'cuda'

    # Build all (sentence, gap) items with token ids and mask position
    items = []  # (dev_idx, gap_word_index, input_ids list, mask_pos)
    for di, r in enumerate(dev):
        words = r['corrupted'].split(' ')
        enc = tok(words, is_split_into_words=True, add_special_tokens=True,
                  truncation=True, max_length=args.maxlen)
        ids = enc['input_ids']
        wids = enc.word_ids()
        nw = len(words)
        # for gap before word g (g=1..nw-1) find first token with word_id==g
        first_tok = {}
        for ti, w in enumerate(wids):
            if w is not None and w not in first_tok:
                first_tok[w] = ti
        for g in range(1, nw):
            if g not in first_tok:
                continue
            pos = first_tok[g]
            items.append((di, g, ids, pos))

    print('items', len(items), 'dev', len(dev), flush=True)
    # group into batches
    results = [dict() for _ in range(len(dev))]
    vocab_size = model.config.vocab_size
    with torch.no_grad():
        for bi in range(0, len(items), args.batch):
            batch = items[bi:bi+args.batch]
            maxlen = max(len(x[2]) + 1 for x in batch)
            inp = torch.full((len(batch), maxlen), tok.pad_token_id, dtype=torch.long)
            att = torch.zeros((len(batch), maxlen), dtype=torch.long)
            pos_list = []
            for j, (di, g, ids, pos) in enumerate(batch):
                seq = ids[:pos] + [mask_id] + ids[pos:]
                L = len(seq)
                inp[j, :L] = torch.tensor(seq, dtype=torch.long)
                att[j, :L] = 1
                pos_list.append(pos)
            inp = inp.to(device); att = att.to(device)
            logits = model(input_ids=inp, attention_mask=att).logits.float()
            idx = torch.arange(len(batch), device=device)
            mask_logits = logits[idx, torch.tensor(pos_list, device=device)]
            logp = torch.log_softmax(mask_logits, dim=-1)
            topv, topi = logp.topk(args.topk, dim=-1)
            topv = topv.cpu().numpy(); topi = topi.cpu().numpy()
            for j, (di, g, ids, pos) in enumerate(batch):
                results[di][str(g)] = {'tok': topi[j].tolist(), 'logp': topv[j].tolist()}
            if bi % (args.batch*20) == 0:
                print('batch', bi, '/', len(items), flush=True)

    # decode tokens
    id2tok = {i: tok.convert_ids_to_tokens(i) for i in range(vocab_size)}
    with open(args.out, 'w') as f:
        for di, r in enumerate(dev):
            rec = {'id': r['id'], 'gap': r['gap'], 'true': r['true'],
                   'nwords': r['nwords'], 'pred': {}}
            for g, d in results[di].items():
                toks = [id2tok.get(t, '') for t in d['tok']]
