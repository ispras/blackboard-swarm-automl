import json, statistics, math, sys
sys.path.insert(0,'.')
from decision import optimize_sentence
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
ids=[i for i in dev if i<1500]
def feats(i):
    r=dev[i]; T=r['corrupted'].split(' '); n=len(T); pred=mlm[i]['pred']; cs=cau[i]['cscore']
    F={}; words={}
    for gs,d in pred.items():
        g=int(gs)
        if not(1<=g<n): continue
        pairs=[(norm(w),lp) for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if len(pairs)<2: continue
        ws=[x for x,_ in pairs]; lps=[lp for _,lp in pairs]
        mx=max(lps); l20=lps[-1]
        nxt=T[g]; prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        F[g]=(mx-lp_nxt) + cs.get(gs,0.0)
        words[g]=[(x,lp) for x,lp in pairs]
    return T,F,words
def cost(r,g,x):
    T=r['corrupted'].split(' '); n=len(T); g=max(0,min(g,n))
    return Levenshtein.distance(r['orig'],' '.join(T[:g]+([x] if x else [])+T[g:]))
data={i:feats(i) for i in ids}
for beta in [0.3,0.5,0.8,1.0,1.5,2.0,3.0]:
    top1p=[]
    for i in ids:
        T,F,W=data[i]; gs=list(F)
        mx=max(F.values()); ex={g:math.exp(beta*(F[g]-mx)) for g in gs}; Z=sum(ex.values())
        top=max(gs,key=lambda g:F[g]); top1p.append(ex[top]/Z)
    print(f'beta={beta}: mean top1 posterior={statistics.mean(top1p):.3f}')
# use beta and run engine
for beta in [0.5,0.8,1.0,1.5]:
  for pb in [0.05,0.1,0.2,0.35,0.5]:
    ds=[]; ch=0
    for i in ids:
        T,F,W=data[i]
        if not F: ds.append(cost(dev[i],0,'')); continue
        mx=max(F.values()); ex={g:math.exp(beta*(F[g]-mx)) for g in F}; Z=sum(ex.values())
        gp={g:ex[g]/Z for g in F}
        cands=[]
        for g in F:
            for x,lp in W[g]: cands.append((g,x,math.exp(lp)))
        ga,x,c,kind=optimize_sentence(T,cands,gp,pb=pb,top_cands=24,top_gaps=3)
        ds.append(cost(dev[i],ga,x)); ch+=kind=='insert'
    print(f'beta={beta} pb={pb}: mean={statistics.mean(ds):.4f} changed={ch/len(ids):.1%}')
