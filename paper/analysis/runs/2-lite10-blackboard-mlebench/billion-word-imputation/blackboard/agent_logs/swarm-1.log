import zipfile, io, math, time, json, os, csv, collections, statistics
import Levenshtein

COUNT_LINES = int(os.environ.get("COUNT_LINES", "8000000"))
TOPK = int(os.environ.get("TOPK", "15"))
PATH = '/download_job_code/payload/sandbox/data/train_v2.txt.zip'
BASE = '/download_job_code/payload/sandbox/workspaces/betelgeuse_tau'
OUT = '/download_job_code/payload/sandbox/workspaces/fomalhaut_zeta'
t0 = time.time()

truth = [json.loads(l) for l in open(f'{BASE}/val_truth.jsonl', encoding='utf-8')]
test_rows = list(csv.DictReader(open(f'{BASE}/val_test.csv', encoding='utf-8')))
test_by_id = {int(r['id']): r['sentence'] for r in test_rows}
print('val', len(truth), flush=True)

# candidate gaps: insertion index g in 1..len(T)-1, pair (T[g-1],T[g])
query = set()
for d in truth:
    T = test_by_id[d['id']].split(' ')
    for k in range(len(T)-1):
        query.add((T[k], T[k+1]))
print('query pairs', len(query), flush=True)

qc = {k: 0 for k in query}; qmed = {k: 0 for k in query}; mid = {}
z = zipfile.ZipFile(PATH); f = io.TextIOWrapper(z.open('train_v2.txt'), encoding='utf-8')
n = 0
for line in f:
    s = line.rstrip('\n')
    if not s: continue
    toks = s.split(' '); L = len(toks)
    for i in range(L-1):
        p = (toks[i], toks[i+1])
        if p in qc: qc[p] += 1
    for i in range(L-2):
        p = (toks[i], toks[i+2])
        if p in qmed:
            qmed[p] += 1
            dd = mid.get(p)
            if dd is None: dd = {}; mid[p] = dd
            y = toks[i+1]; dd[y] = dd.get(y, 0) + 1
    n += 1
    if n % 1000000 == 0: print('counted', n, 't=%.1f'%(time.time()-t0), flush=True)
    if n >= COUNT_LINES: break
print('count done', n, 't=%.1f'%(time.time()-t0), 'midpairs', len(mid), flush=True)

def gscore(a,b):
    return math.log((qmed.get((a,b),0)+0.5)/(qc.get((a,b),0)+0.5))

def softmax(xs):
    m=max(xs); e=[math.exp(x-m) for x in xs]; s=sum(e); return [v/s for v in e]

recs=[]
for d in truth:
    T=test_by_id[d['id']].split(' '); nT=len(T)
    gaplist=list(range(1,nT))
    scores=[gscore(T[g-1],T[g]) for g in gaplist]
    probs=softmax(scores)
    best_i=max(range(len(scores)), key=lambda i:scores[i])
    pg=gaplist[best_i]; pbest=probs[best_i]
    pair=(T[pg-1],T[pg]); dd=mid.get(pair,{})
    tot=sum(dd.values()) if dd else 0
    top=sorted(dd.items(), key=lambda x:-x[1])[:TOPK]
    cands=[[pg,w,c] for w,c in top]
    # my own greedy prediction: best word at best gap
    word=top[0][0] if top else ''
    pred=' '.join(T[:pg]+[word]+T[pg:]) if word else ' '.join(T)
    noop=' '.join(T)
    dist=Levenshtein.distance(d['orig'],pred)
    cost_noop=Levenshtein.distance(d['orig'],noop)
    gap_ok=(pg==d['gap'])
    recs.append({'id':d['id'],'gap_ok':gap_ok,'p':pbest,'score':scores[best_i],
                 'dist':dist,'noop':cost_noop,'cands':cands,
                 'gap_probs':[[g,pr] for g,pr in zip(gaplist,probs)]})

N=len(recs)
print('=== SHARED HOLDOUT, count_lines=%d, tmpairs=%d ==='%(n,len(mid)))
print('noop', statistics.mean(r['noop'] for r in recs))
print('gap top1', statistics.mean(r['gap_ok'] for r in recs))
for k in [2,3,5]:
    acc=0
    for d,r in zip(truth,recs):
        T=test_by_id[d['id']].split(' ')
        topgaps=sorted(range(len(r['gap_probs'])), key=lambda i:-r['gap_probs'][i][1])[:k]
        acc+= ( (d['gap']) in [r['gap_probs'][i][0] for i in topgaps] )
    print('gap top%d'%k, acc/N)
print('always-insert bestword cost', statistics.mean(r['dist'] for r in recs))
print('  cost when gap ok', statistics.mean([r['dist'] for r in recs if r['gap_ok']]) if any(r['gap_ok'] for r in recs) else 0)
for th in [0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.5]:
    sel=[r for r in recs if r['p']>=th]
    if not sel: continue
    tot=sum(r['dist'] for r in sel)+sum(r['noop'] for r in recs if r['p']<th)
    acc=statistics.mean(r['gap_ok'] for r in sel)
    print('  th=%.2f cov=%.3f gapacc=%.3f total=%.4f'%(th,len(sel)/N,acc,tot/N))

# write candidate jsonl
with open(f'{OUT}/fomalhaut_gap_cands_val.jsonl','w') as fo:
    for r in recs:
        fo.write(json.dumps({'id':r['id'],'cands':r['cands'],'gap_probs':r['gap_probs']})+'\n')
# also a simple tsv best guess
with open(f'{OUT}/fomalhaut_best_val.tsv','w') as fo:
    for r in recs:
        pg=r['cands'][0][0]; w=r['cands'][0][1] if r['cands'] else ''
        fo.write(f"{r['id']}\t{pg}\t{w}\n")
json.dump({'n':n,'noop':statistics.mean(r['noop'] for r in recs),
           'gapacc':statistics.mean(r['gap_ok'] for r in recs)},
          open(f'{OUT}/loc_shared.json','w'))
print('wrote cands', flush=True)
