import json, csv, math, pickle
import numpy as np
cfg=json.load(open('fusion_config.json')); clf=pickle.load(open('fusion_model.pkl','rb'))
TH=cfg['threshold']; TOPN=cfg['topN']
PUNCT=set([',','.',';',':','!','?','"',"'",'(',')','--','-','``',"''"])
test={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
fom={}
for l in open('../fomalhaut_zeta/fomalhaut_val_gap_probs20m.jsonl'):
    o=json.loads(l); fom[o['id']]=o
mlm={}
for l in open('mlm_val20k.jsonl'):
    o=json.loads(l); mlm[o['id']]=o['pred']
def mass(o):
    gp=o.get('gap_probs') or []
    if isinstance(gp,dict):gp=list(gp.items())
    return {int(g):float(p) for g,p in gp if float(p)>0}
def features(i):
    T=[t for t in test[i].split(' ') if t!='']; n=len(T)
    m=mass(fom[i]); items=sorted(m.items(),key=lambda kv:-kv[1])[:TOPN]; topd=dict(items); rest=1-sum(topd.values())
    pred=mlm[i]; gm=[]
    for gs,d in pred.items():
        g=int(gs)
        if not(1<=g<n):continue
        pairs=[(w,lp) for w,lp in zip(d['w'],d['lp']) if w][:15]
        if len(pairs)>=2:gm.append((g,pairs))
    if not gm:return None
    missing=[g for g,_ in gm if g not in topd]
    floor=math.log(max(rest,1e-9)/max(1,len(missing))) if missing else -30.0
    rows=[];gaps=[]
    for g,pairs in gm:
        fl=math.log(max(topd[g],1e-12)) if g in topd else floor
        ws=[w for w,_ in pairs];lps=[lp for _,lp in pairs];top1=lps[0];mx=max(lps)
        nxt=T[g];prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        nconf=sum(1 for lp in lps if math.exp(lp)>0.01);punct=1.0 if(nxt in PUNCT or prv in PUNCT) else 0.0
        rows.append([fl,top1,mx-lp_nxt,mx-lp_prv,top1-lps[-1],top1-lps[1],g/(n-1),nconf,len(ws[0]),punct]);gaps.append(g)
    A=np.array(rows);mu=A.mean(0);sd=A.std(0);sd[sd<1e-9]=1;Z=(A-mu)/sd
    inter=np.column_stack([Z[:,0]*Z[:,2],Z[:,0]*Z[:,3],Z[:,2]*Z[:,4]]);Z=np.column_stack([Z,inter])
    return T,gaps,Z,{g:pairs for g,pairs in gm}
with open('val_chosen_gaps.tsv','w') as fg, open('val_p1.jsonl','w') as fp:
    na=0
    for i in sorted(test):
        if i not in fom or i not in mlm: continue
        b=features(i)
        if b is None: continue
        T,gaps,Z,gw=b
        s=clf.decision_function(Z);e=np.exp(s-s.max());P=e/e.sum()
        j=int(np.argmax(P));g1=gaps[j];P1=float(P[j])
        fp.write(json.dumps({'id':i,'g1':g1,'P1':P1,'gaps':gaps,'P':[float(x) for x in P]})+'\n')
        if P1>=TH: fg.write(f'{i}\t{g1}\n');na+=1
print('acted',na)
EOF
