=== train_gap.py ===
import argparse, json, numpy as np, torch, torch.nn as nn, time, math
from transformers import AutoTokenizer, AutoModel

class GapModel(nn.Module):
    def __init__(self, enc_name, hidden_dropout=0.1):
        super().__init__()
        self.enc = AutoModel.from_pretrained(enc_name)
        H = self.enc.config.hidden_size
        self.head = nn.Sequential(
            nn.Linear(2*H, 512), nn.GELU(), nn.Dropout(hidden_dropout),
            nn.Linear(512, 128), nn.GELU(), nn.Dropout(hidden_dropout),
            nn.Linear(128, 1))
    def forward(self, ids, att, wstart, nw, gap_target=None):
        h = self.enc(input_ids=ids, attention_mask=att).last_hidden_state  # B,T,H
        B, MAXW = wstart.shape
        valid = (wstart >= 0)
        wi = wstart.clamp(min=0)
        left_idx = (wi - 1).clamp(min=0)
        right_idx = wi
        bidx = torch.arange(B, device=ids.device).unsqueeze(1).expand(B, MAXW)
        hl = h[bidx, left_idx]   # B,MAXW,H
        hr = h[bidx, right_idx]
        feat = torch.cat([hl, hr], dim=-1)
        logits = self.head(feat).squeeze(-1)  # B,MAXW
        # gaps g=1..nw-1 use word index g (column g). Column 0 is not a gap.
        logits = logits[:, 1:]
        gmask = torch.arange(1, MAXW, device=ids.device).unsqueeze(0) < nw.unsqueeze(1)
        logits = logits.masked_fill(~gmask, -1e4)
        loss = None
        if gap_target is not None:
            tgt = (gap_target - 1).clamp(min=0)
            loss = nn.functional.cross_entropy(logits.float(), tgt)
        return logits, loss

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--tr',default='gaptr_train.npz')
    ap.add_argument('--dev',default='gaptr_dev.npz')
    ap.add_argument('--model',default='roberta-base')
    ap.add_argument('--epochs',type=int,default=3)
    ap.add_argument('--batch',type=int,default=256)
    ap.add_argument('--lr',type=float,default=3e-5)
    ap.add_argument('--out',default='gapmodel.pt')
    ap.add_argument('--log',default='gap_train.log')
    ap.add_argument('--max_steps',type=int,default=0)
    args=ap.parse_args()

    tr=np.load(args.tr); dv=np.load(args.dev)
    tok=AutoTokenizer.from_pretrained(args.model, add_prefix_space=True)
    pad_id=tok.pad_token_id or 1
    N=len(tr['ids'])
    print('train',N,'dev',len(dv['ids']),flush=True)
    model=GapModel(args.model).cuda()
    model.train()
    opt=torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=0.01)
    dev_ids=torch.tensor(dv['ids'],dtype=torch.long).cuda()
    dev_ws=torch.tensor(dv['wstart'],dtype=torch.long).cuda()
    dev_nw=torch.tensor(dv['nw'],dtype=torch.long).cuda()
    dev_gap=torch.tensor(dv['gap'],dtype=torch.long).cuda()
    dev_ln=torch.tensor(dv['ln'],dtype=torch.long).cuda()

    def evaluate():
        model.eval()
        corr=0; tot=0; rank_sum=0
        with torch.no_grad():
            for st in range(0,len(dev_ids),512):
                ids=dev_ids[st:st+512]; ws=dev_ws[st:st+512]; nw=dev_nw[st:st+512]
                g=dev_gap[st:st+512]; ln=dev_ln[st:st+512]
                T=int(ln.max())
                att=(torch.arange(T,device=ids.device).unsqueeze(0) < ln.unsqueeze(1)).long()
                logits,_=model(ids[:,:T],att,ws,nw)
                pred=logits.argmax(-1)+1
                corr+=(pred==g).sum().item(); tot+=len(g)
                # rank
                order=logits.argsort(dim=-1,descending=True)
                ranks=(order==(g-1).unsqueeze(1)).float().argmax(1)+1
                rank_sum+=ranks.sum().item()
        model.train()
        return corr/tot, rank_sum/tot
    lf=open(args.log,'a')
    step=0
    t0=time.time()
    for ep in range(args.epochs):
        perm=np.random.permutation(N)
        for st in range(0,N,args.batch):
            idx=perm[st:st+args.batch]
            ids=torch.tensor(tr['ids'][idx],dtype=torch.long).cuda()
            ws=torch.tensor(tr['wstart'][idx],dtype=torch.long).cuda()
            nw=torch.tensor(tr['nw'][idx],dtype=torch.long).cuda()
            g=torch.tensor(tr['gap'][idx],dtype=torch.long).cuda()
            ln=torch.tensor(tr['ln'][idx],dtype=torch.long).cuda()
            T=int(ln.max()); T=max(T,8)
            att=(torch.arange(T,device=ids.device).unsqueeze(0) < ln.unsqueeze(1)).long()
            logits,loss=model(ids[:,:T],att,ws,nw,g)
            opt.zero_grad(); loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(),1.0)
            opt.step(); step+=1
            if step%200==0:
                msg=f'ep{ep} step{step} loss{loss.item():.4f} {(time.time()-t0)/step:.2f}s/it'
                print(msg,flush=True); lf.write(msg+'\n'); lf.flush()
            if args.max_steps and step>=args.max_steps: break
        acc,rk=evaluate()
        msg=f'== ep{ep} dev top1={acc:.4f} meanrank={rk:.2f}'
        print(msg,flush=True); lf.write(msg+'\n'); lf.flush()
        torch.save({'model':model.state_dict(),'model_name':args.model},args.out)
        if args.max_steps and step>=args.max_steps: break
    print('done')

if __name__=='__main__': main()
