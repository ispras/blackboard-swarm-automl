import json, csv, math, statistics, sys
sys.path.insert(0,'.')
from decision import optimize_sentence
import Levenshtein

FOM=sys.argv[1] if len(sys.argv)>1 else '../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'
MLM=sys.argv[2] if len(sys.argv)>2 else 'mlm_val20k.jsonl'
N=int(sys.argv[3]) if len(sys.argv)>3 else 19948

test={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl',encoding='utf-8')}
fom={}
for l in open(FOM,encoding='utf-8'):
    o=json.loads(l); fom[int(o['id'])]=o
mlm={}
for l in open(MLM,encoding='utf-8'):
    o=json.loads(l); mlm[int(o['id'])]=o
print('loaded',len(fom),len(mlm),flush=True)

def glist(o):
    gp=o.get('gap_probs') or []
    if isinstance(gp,dict): gp=list(gp.items())
    arr=[(int(g),float(p)) for g,p in gp if float(p)>0]
    z=sum(v for _,v in arr) or 1.0
    return {g:v/z for g,v in arr}

def fom_words(o,g):
    d={}
    for it in (o.get('cands') or []):
        gg,w,s=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and s>0: d[w]=d.get(w,0)+s
    z=sum(d.values()) or 1.0
    return {w:v/z for w,v in d.items()}

def predict(i, word_src='mlm', alpha=0.8, pb_floor=0.05, pb_scale=1.0, top_cands=20, top_gaps=3):
    T=[t for t in test[i].split(' ') if t!='']
    gp=glist(fom[i])
    pred=mlm[i]['pred']
    joint=[]
    for g,pg in gp.items():
        pm={}
        d=pred.get(str(g))
        if d:
            for w,lp in zip(d['w'],d['lp']):
                if w: pm[w]=math.exp(lp)
        if not pm: continue
        # renormalize? keep raw mass (top-k covers most prob)
        fw=fom_words(fom[i],g)
        if word_src=='mlm': P=pm
        elif word_src=='fom': P=fw if fw else {}
        else:
            P={}
            for w,v in pm.items(): P[w]=P.get(w,0)+alpha*v
            for w,v in fw.items(): P[w]=P.get(w,0)+(1-alpha)*v
        for w,v in P.items():
            if v>0: joint.append((g,w,pg*v))
    mass=sum(s for _,_,s in joint)
    pb=max(pb_floor, min(0.999,(1.0-mass)*pb_scale))
    ga,x,c,kind=optimize_sentence(T,joint,None,pb=pb,top_cands=top_cands,top_gaps=top_gaps)
    return (' '.join(T) if x=='' else ' '.join(T[:ga]+[x]+T[ga:]))

ids=sorted(set(fom)&set(mlm)&set(truth))[:N]
for word_src in ['mlm','fom','both']:
  for alpha in ([0.8] if word_src!='both' else [0.6,0.8,0.9]):
    for pfloor in [0.02,0.05,0.1,0.2,0.3]:
        ds=[]
        for i in ids:
            p=predict(i,word_src,alpha,pb_floor=pfloor)
            ds.append(Levenshtein.distance(truth[i]['orig'],p))
        print(f'word={word_src} alpha={alpha} floor={pfloor}: mean={statistics.mean(ds):.4f}',flush=True)
