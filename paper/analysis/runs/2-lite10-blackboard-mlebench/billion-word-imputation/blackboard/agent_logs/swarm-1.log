import json, statistics, math
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev=[json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')]
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
sub=dev[:2000]
def cost(r,g,x):
    T=r['corrupted'].split(' '); n=len(T); g=max(0,min(g,n))
    return Levenshtein.distance(r['orig'],' '.join(T[:g]+([x] if x else [])+T[g:]))

def scores(r):
    T=r['corrupted'].split(' '); n=len(T); pred=mlm[r['id']]['pred']
    o={}
    for gs,d in pred.items():
        g=int(gs)
        if not (1<=g<n): continue
        lps=[lp for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if lps: o[g]=max(lps)
    return o

def topword(r,g):
    d=mlm[r['id']]['pred'][str(g)]
    best=None
    for w,lp in zip(d['w'],d['lp']):
        x=norm(w)
        if x and (best is None or lp>best[0]): best=(lp,x)
    return best[1] if best else ''

def gap_choice(r,kind):
    s=scores(r); gs=list(s)
    if kind=='maxlp': return max(gs,key=lambda g:s[g])
    if kind=='minlp': return min(gs,key=lambda g:s[g])
    if kind=='causal':
        cs=cau[r['id']]['cscore']; return max(gs,key=lambda g:cs.get(str(g),-1e9))
    if kind.startswith('comb'):
        w=float(kind[4:]); cs=cau[r['id']]['cscore']
        return max(gs,key=lambda g:(1-w)*s[g]+w*cs.get(str(g),-1e9))
    if kind=='truth': return r['gap']
for kind in ['maxlp','minlp','causal','comb0.5','comb0.75','truth']:
    line=[]
    for hmode in ['word','p1','p2','p3',',','none']:
        ds=[]
        for r in sub:
            g=gap_choice(r,kind)
            if hmode=='none': x=''
            elif hmode=='word': x=topword(r,g)
            elif hmode==',': x=','
            else: x=topword(r,g)[:int(hmode[1])]
            ds.append(cost(r,g,x))
        line.append(f'{hmode}={statistics.mean(ds):.3f}')
    print(kind,' '.join(line))
EOF
