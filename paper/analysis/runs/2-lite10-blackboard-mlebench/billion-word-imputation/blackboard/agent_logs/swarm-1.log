rng = random.Random(SEED)
val = []
line_idx = 0
for line in f:
    if line_idx >= VAL_START and len(val) < VAL_N:
        s = line.rstrip('\n').strip()
        toks = s.split(' ')
        if len(toks) >= 4:
            j = rng.randint(1, len(toks) - 2)
            val.append((toks, j))
    line_idx += 1
    if line_idx >= VAL_START + VAL_N * 2:
        break
print('val', len(val), 't=%.1f' % (time.time()-t0), flush=True)

