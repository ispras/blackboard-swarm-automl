        xm=medoid(Pc)
        def c(xx):return Levenshtein.distance(truth[i]['orig'],' '.join(T[:g1]+([xx] if xx else [])+T[g1:]))
        noop=Levenshtein.distance(truth[i]['orig'],' '.join(T))
        out.append(dict(i=i,P1=P1,P2=P2,gapm=P1-P2,wp=wp,wm=wm,wlen=len(x),n=len(T),
                        ins=c(x),med=c(xm),p2=c(x[:2] if len(x)>2 else x),noop=noop,
                        gap_ok=g1==truth[i]['gap'],x=x))
    return out
Rtr=records(tr);Rte=records(te)
print('train',len(Rtr),'test',len(Rte))
for mode in ['ins','med','p2']:
    for th in [0.5,0.55,0.6,0.65,0.7]:
        m=statistics.mean((r[mode] if r['P1']>=th else r['noop']) for r in Rte)
        print(f'{mode} th={th}: {m:.4f}',end='   ')
    print()
# learned gate on train split: label insert better than noop
def feats(r):
    return [r['P1'],math.log(max(r['wp'],1e-6)),r['wlen'],r['gapm'],r['wm'],r['n']/100.0, math.log(max(r['P1']/(1-r['P1']+1e-9),1e-9))]
Xg=np.array([feats(r) for r in Rtr]);yg=np.array([1 if r['ins']<r['noop'] else 0 for r in Rtr])
for C in [0.1,0.5,2.0]:
    g=LogisticRegression(C=C,max_iter=2000).fit(Xg,yg)
    p=g.predict_proba(np.array([feats(r) for r in Rte]))[:,1]
    for th in [0.4,0.45,0.5,0.55,0.6]:
        m=statistics.mean((r['ins'] if pp>=th else r['noop']) for r,pp in zip(Rte,p))
        cov=sum(pp>=th for pp in p)/len(p)
        print(f'gate C={C} th={th}: mean={m:.4f} cov={cov:.3f}')
# per bucket best mode
print('oracle min ins/noop',statistics.mean(min(r['ins'],r['noop']) for r in Rte))
