import json, statistics, math, itertools
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

allF={}
for i,r in dev.items():
    T=r['corrupted'].split(' '); n=len(T); pred=mlm[i]['pred']; cs=cau[i]['cscore']
    F={}
    for gs,d in pred.items():
        g=int(gs)
        if not(1<=g<n): continue
        lps=[lp for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if len(lps)<2: continue
        top1=lps[0]; top2=lps[1] if len(lps)>1 else lps[0]; l20=lps[-1] if len(lps)>=20 else lps[-1]
        nxt=T[g]; prv=T[g-1]
        # logp of next/prev token if present
        ws=[norm(w) for w in d['w']]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        F[g]=dict(top1=top1, top2=top2, l20=l20, spread=top1-l20, margin=top1-top2,
                  caus=cs.get(gs,0.0), marg_nxt=top1-lp_nxt, marg_prv=top1-lp_prv)
    allF[i]=F

def evalfeat(name, fn):
    ranks=[]
    for i,F in allF.items():
        tg=dev[i]['gap']
        if not F: continue
        order=sorted(F,key=lambda g:fn(F[g]),reverse=True)
        ranks.append(order.index(tg) if tg in order else 99)
    n=len(ranks)
    print(f'{name:34s} top1={sum(x==0 for x in ranks)/n:.3f} top3={sum(x<3 for x in ranks)/n:.3f} top5={sum(x<5 for x in ranks)/n:.3f} meanrank={statistics.mean(ranks):.2f}')

for k in ['top1','l20','spread','margin','caus','marg_nxt','marg_prv']:
    evalfeat(k, lambda F,k=k: F[k])
    evalfeat('-'+k, lambda F,k=k: -F[k])
# z-combos
def zc(i,keys,weights):
    F=allF[i]; out={g:0.0 for g in F}
    for k,w in zip(keys,weights):
        vals=[F[g][k] for g in F]; m=statistics.mean(vals); s=statistics.pstdev(vals) or 1.0
        for g in F: out[g]+=w*(F[g][k]-m)/s
    return out
def evalz(name,keys,weights):
    ranks=[]
    for i,F in allF.items():
        tg=dev[i]['gap']; z=zc(i,keys,weights)
        order=sorted(z,key=lambda g:z[g],reverse=True)
        ranks.append(order.index(tg) if tg in order else 99)
    n=len(ranks)
    print(f'{name:34s} top1={sum(x==0 for x in ranks)/n:.3f} top3={sum(x<3 for x in ranks)/n:.3f} top5={sum(x<5 for x in ranks)/n:.3f} meanrank={statistics.mean(ranks):.2f}')
evalz('z[top1,caus]',['top1','caus'],[1,1])
evalz('z[top1,margin,caus]',['top1','margin','caus'],[1,1,1])
evalz('z[top1,spread,caus]',['top1','spread','caus'],[1,1,1])
evalz('z[spread,caus]',['spread','caus'],[1,1])
evalz('z[marg_nxt,caus]',['marg_nxt','caus'],[1,1])
evalz('z[top1,marg_nxt,caus]',['top1','marg_nxt','caus'],[1,1,1])
evalz('z[top1,marg_nxt,marg_prv,caus]',['top1','marg_nxt','marg_prv','caus'],[1,1,1,1])
for w in [0.5,1,1.5,2,3,4]:
    evalz(f'z[top1,marg_nxt,caus,spread w={w}]',['top1','marg_nxt','caus','spread'],[1,1,1,w])
