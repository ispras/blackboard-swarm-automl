import json, statistics, math
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
N=2000
scores={k:[] for k in ['max_lp','min_lp','min_ent','max_ent','min_margin','max_margin','max_c','min_c','max_lp_minus_c','max_c_minus_lp']}
for i in range(N):
    r=dev[i]; T=r['corrupted'].split(' '); tg=r['gap']; nw=len(T)
    pred=mlm[i]['pred']
    gaps=[int(g) for g in pred if 1<=int(g)<nw]
    f={}
    for g in gaps:
        d=pred[str(g)]
        nz=[(norm(w),lp) for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if not nz: continue
        lps=[lp for _,lp in nz]
        mx=max(lps); mn=min(lps)
        second=sorted(lps,reverse=True)[1] if len(lps)>1 else mn
        ent=-sum(math.exp(l) * l for l in lps)  # negative entropy-ish
        f[g]=dict(max_lp=mx,min_lp=mn,ent=ent,margin=mx-second)
    if not f: continue
    gs=list(f)
    def rank(key,rev):
        o=sorted(gs,key=lambda g:f[g][key],reverse=rev)
        return o.index(tg) if tg in o else 99
    scores['max_lp'].append(rank('max_lp',True))
    scores['min_lp'].append(rank('min_lp',False))
    scores['max_ent'].append(rank('ent',True))
    scores['min_ent'].append(rank('ent',False))
    scores['max_margin'].append(rank('margin',True))
    scores['min_margin'].append(rank('margin',False))
    if i in cau:
        cs=cau[i]['cscore']
        cg=[g for g in gaps if str(g) in cs]
        if cg:
            o=sorted(cg,key=lambda g:cs[str(g)],reverse=True)
            scores['max_c'].append(o.index(tg) if tg in o else 99)
            o=sorted(cg,key=lambda g:-cs[str(g)])
            scores['min_c'].append(o.index(tg) if tg in o else 99)
            # combine: normalize ranks? simple z of max_lp and c
            ml={g:f[g]['max_lp'] for g in cg if g in f}
            if ml:
                def comb(g, sx):
                    a=ml.get(g,-99); 
                    c=cs[str(g)]
                    return sx*a + (1-sx)*c
                for th in (0.0,0.25,0.5,0.75,1.0):
                    o=sorted(cg,key=lambda g:comb(g,th),reverse=True)
                    scores.setdefault(f'comb{th}',[]).append(o.index(tg) if tg in o else 99)
for k,v in scores.items():
    if not v: continue
    print(f'{k:16s} n={len(v)} top1={sum(x==0 for x in v)/len(v):.3f} top3={sum(x<3 for x in v)/len(v):.3f} meanrank={statistics.mean(v):.2f}')
EOF
