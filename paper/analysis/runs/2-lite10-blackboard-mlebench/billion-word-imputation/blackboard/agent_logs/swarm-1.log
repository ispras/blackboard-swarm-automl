import json, statistics, math
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

n=1000
neighbor_copy=0; total_gap=0
rank_max=[]; rank_min=[]
for i in range(n):
    r=dev[i]; T=r['corrupted'].split(' '); tg=r['gap']; nw=len(T)
    pred=mlm[i]['pred']
    gaps=[int(g) for g in pred if 1<=int(g)<nw]
    sc_max={}; sc_min={}
    for g in gaps:
        d=pred[str(g)]
        vals=[]
        for w,lp in zip(d['w'],d['lp']):
            x=norm(w)
            if not x: continue
            vals.append(lp)
            total_gap+=1
            if x==T[g-1] or (g<nw and x==T[g]): neighbor_copy+=1
        sc_max[g]=max(vals) if vals else -1e9
        sc_min[g]=min(vals) if vals else 1e9
    om=sorted(gaps,key=lambda g:sc_max[g],reverse=True)
    on=sorted(gaps,key=lambda g:sc_min[g])
    rank_max.append(om.index(tg)); rank_min.append(on.index(tg))
print('sentences',n)
print('neighbor-copy rate among all topk entries', neighbor_copy/max(1,total_gap))
for name,rank in [('max',rank_max),('min',rank_min)]:
    print(name,'top1',sum(x==0 for x in rank)/n,'top3',sum(x<3 for x in rank)/n,'meanrank',statistics.mean(rank))
# top1 gap raw logp actual values at true vs others
print('example: id0 true gap',dev[0]['gap'],'true',dev[0]['truth'] if 'truth' in dev[0] else dev[0]['true'])
EOF
