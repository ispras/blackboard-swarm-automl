import json, csv, math, statistics, time, os
import numpy as np
BASE = '/download_job_code/payload/sandbox/workspaces/betelgeuse_tau'
OUT = '/download_job_code/payload/sandbox/workspaces/fomalhaut_zeta'
t0 = time.time()

truth = [json.loads(l) for l in open(f'{BASE}/val_truth.jsonl', encoding='utf-8')]
vt = {int(r['id']): r['sentence'] for r in csv.DictReader(open(f'{BASE}/val_test.csv', encoding='utf-8'))}
tg = {d['id']: d['gap'] for d in truth}
mygap = {}
for l in open(f'{OUT}/fomalhaut_val_gap_probs20m.jsonl'):
    d = json.loads(l); mygap[d['id']] = {int(g): p for g, p in d['gap_probs']}
print('loaded mygap', len(mygap), flush=True)

mlm = {}
for l in open(f'{BASE}/mlm_val20k.jsonl'):
    d = json.loads(l); mlm[d['id']] = d['pred']
print('loaded mlm', len(mlm), 't=%.1f'%(time.time()-t0), flush=True)
causal={}
for l in open(f'{OUT}/causal_surp_val.jsonl'):
    d=json.loads(l); causal[d['id']]=d['surp']
print('loaded causal', len(causal), flush=True)
verif={}
VP='../mirfak_chi/verif_gaps_val.jsonl'
for l in open(VP):
    d=json.loads(l); verif[d['id']]={int(g):(float(r),float(p)) for g,r,p in d['gap_probs']}
print('loaded verif',len(verif),flush=True)

def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

X = []; Y = []; meta = []  # meta: (id,gap,row index)
for d in truth:
    i = d['id']; T = vt[i].split(' '); n = len(T); pred = mlm.get(i, {})
    for g in range(1, n):
        myp = mygap[i].get(g, 1e-9)
        dg = pred.get(str(g))
        if dg is None:
            top1=top2=l20=spread=margin=margn=margp=-12.0; have=0
        else:
            pairs=[(norm(w),lp) for w,lp in zip(dg['w'],dg['lp']) if norm(w)]
            lps=[lp for _,lp in pairs]; ws=[w for w,_ in pairs]
            if len(lps)<2:
                top1=top2=l20=spread=margin=margn=margp=-12.0; have=0
            else:
                have=1
                top1=lps[0]; top2=lps[1]; l20=lps[-1]
                spread=top1-l20; margin=top1-top2
                nxt=T[g]; prv=T[g-1]
                lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
                lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
                margn=top1-lp_nxt; margp=top1-lp_prv
        lp_my = math.log(max(myp,1e-12))
        cs = causal.get(i, [])
        if cs:
            arr = cs[1:] if len(cs)>1 else cs
            mu = sum(arr)/len(arr); sd = (sum((x-mu)**2 for x in arr)/len(arr))**0.5 or 1.0
            sg = cs[g] if g < len(cs) else 0.0
            zsg = (sg-mu)/sd
            med = sorted(arr)[len(arr)//2] if arr else 0.0
            rat = sg/(med+1e-6)
            sg_prev = cs[g-1] if g-1>=0 else 0.0
            rank = sum(1 for x in arr if x < sg)/max(1,len(arr))
        else:
            sg=zsg=rat=sg_prev=rank=0.0
        vd=verif.get(i,{})
        if vd:
            vr_all=[x[0] for x in vd.values()]
            vmin=min(vr_all)
            vraw=vd[g][0] if g in vd else vmin-2.0
            vp=vd[g][1] if g in vd else 0.0
            vmu=sum(vr_all)/len(vr_all); vsd=(sum((x-vmu)**2 for x in vr_all)/len(vr_all))**0.5 or 1.0
            vz=(vraw-vmu)/vsd
        else:
            vraw=vp=vz=0.0
        feats=[lp_my, top1, top2, l20, spread, margin, margn, margp,
               g/ n, (n-g)/n, len(T[g-1]), len(T[g]),
               float(T[g-1] in ',.;:!?'), float(T[g] in ',.;:!?'),
               float(g==1), float(g==n-1), have,
               sg, zsg, rat, sg_prev, rank,
               vraw, vz, vp]
        X.append(feats); Y.append(1 if g==tg[i] else 0); meta.append((i,g))
X=np.array(X, dtype=np.float32); Y=np.array(Y, dtype=np.int8)
print('X', X.shape, 'rows per sentence %.1f'%(X.shape[0]/len(truth)), flush=True)

ids = np.array([m[0] for m in meta])
train_mask = ids < 5000
import lightgbm as lgb
def evalrank(scores, mask_ids):
    from collections import defaultdict
    bys=defaultdict(list)
    for (i,g),s in zip(meta, scores):
        bys[i].append((float(s), g))
    top1=top3=top5=0; n=0; ranks=[]
    for i, lst in bys.items():
        if i not in mask_ids: continue
        lst.sort(reverse=True); order=[g for _,g in lst]
        r=order.index(tg[i]) if tg[i] in order else 999
        ranks.append(r); top1+=r==0; top3+=r<3; top5+=r<5; n+=1
    return top1/n, top3/n, top5/n, statistics.mean(ranks)

# baseline: my log p only
base_scores = X[:,0]
eval_ids=set(range(5000,20000))
print('my ngram only : top1 %.4f top3 %.4f top5 %.4f mr %.2f'%evalrank(base_scores, eval_ids), flush=True)
# MLM margn only
print('marg_nxt only : top1 %.4f top3 %.4f top5 %.4f mr %.2f'%evalrank(X[:,6], eval_ids), flush=True)

for params in [dict(num_leaves=int(os.environ.get('NL','31')), learning_rate=float(os.environ.get('LR','0.05')), n_estimators=int(os.environ.get('NE','300')), min_child_samples=int(os.environ.get('MCS','50')))]:
