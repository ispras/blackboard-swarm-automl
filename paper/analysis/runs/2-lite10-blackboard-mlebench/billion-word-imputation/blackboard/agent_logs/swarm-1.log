import json, statistics, math, os
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

def top1(r):
    T=r['corrupted'].split(' '); n=len(T); pred=mlm[r['id']]['pred']
    best=None
    for gs,gapd in pred.items():
        g=int(gs)
        for w,lp in zip(gapd['w'],gapd['lp']):
            x=norm(w)
            if not x: continue
            l=lp
            if x==T[g-1] or (g<n and x==T[g]): l-=4.0
            if best is None or l>best[0]: best=(l,g,x,lp)
    return best

def cost(r,g,x):
    T=r['corrupted'].split(' '); n=len(T); g=max(0,min(g,n))
    return Levenshtein.distance(r['orig'],' '.join(T[:g]+([x] if x else [])+T[g:]))

rows=[]
for i,r in dev.items():
    if i>=3000: continue
    l,g,x,rawlp=top1(r)
    base_cols={'l':l,'gap_ok':(g==r['gap']),'word_ok':(g==r['gap'] and x==r['truth'] if 'truth' in r else (g==r['gap'] and x==r['true'])),
               'noop':cost(r,0,''),'ins':cost(r,g,x),'p1':cost(r,g,x[:1]),'p2':cost(r,g,x[:2]),
               'len_true':len(r['true'])}
    rows.append(base_cols)
print('n',len(rows))
print('gap acc',statistics.mean(r['gap_ok'] for r in rows),'word acc',statistics.mean(r['word_ok'] for r in rows))
print('noop',statistics.mean(r['noop'] for r in rows))
print('ins top1',statistics.mean(r['ins'] for r in rows),'p1',statistics.mean(r['p1'] for r in rows),'p2',statistics.mean(r['p2'] for r in rows))

# buckets by top1 logp l
ls=sorted(r['l'] for r in rows)
qs=[ls[int(len(ls)*q)] for q in [0.0,0.2,0.4,0.5,0.6,0.7,0.8,0.9,0.95,1.0]]
print('logp quantiles',[round(x,2) for x in qs])
import numpy as np
edges=[-1e9,-3,-2,-1.5,-1,-0.5,0,0.5,1e9]
for a,b in zip(edges[:-1],edges[1:]):
    sub=[r for r in rows if a<=r['l']<b]
    if not sub: continue
    print(f'l in [{a},{b}) n={len(sub)} gapacc={statistics.mean(r["gap_ok"] for r in sub):.3f} wordacc={statistics.mean(r["word_ok"] for r in sub):.3f} noop={statistics.mean(r["noop"] for r in sub):.2f} ins={statistics.mean(r["ins"] for r in sub):.2f} p1={statistics.mean(r["p1"] for r in sub):.2f} p2={statistics.mean(r["p2"] for r in sub):.2f}')
# gated: act if l>=thr, insert top word
for thr in [-4,-3,-2.5,-2,-1.5,-1,-0.5,0,0.5]:
    acted=[r for r in rows if r['l']>=thr]
    ds=[r['ins'] if r['l']>=thr else r['noop'] for r in rows]
    print(f'thr={thr}: act={len(acted)/len(rows):.2%} mean_ins={statistics.mean(ds):.4f}')
for thr in [-4,-3,-2.5,-2,-1.5,-1,-0.5,0,0.5]:
    ds=[r['p2'] if r['l']>=thr else r['noop'] for r in rows]
    print(f'thr={thr} prefix2: act={sum(r["l"]>=thr for r in rows)/len(rows):.2%} mean={statistics.mean(ds):.4f}')
EOF
