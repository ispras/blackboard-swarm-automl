import zipfile, io, random, math, time, json, os, collections
import Levenshtein

COUNT_START = int(os.environ.get("COUNT_START", "1100000"))
COUNT_LINES = int(os.environ.get("COUNT_LINES", "3000000"))
VAL_START = 1000000
VAL_N = int(os.environ.get("VAL_N", "10000"))
SEED = 12345
PATH = '/download_job_code/payload/sandbox/data/train_v2.txt.zip'
t0 = time.time()

z = zipfile.ZipFile(PATH); f = io.TextIOWrapper(z.open('train_v2.txt'), encoding='utf-8')
rng = random.Random(SEED); val = []; li = 0
for line in f:
    if VAL_START <= li < VAL_START + VAL_N*2 and len(val) < VAL_N:
        s = line.rstrip('\n').strip(); toks = s.split(' ')
        if len(toks) >= 4:
            val.append((toks, rng.randint(1, len(toks)-2)))
    li += 1
    if li >= VAL_START + VAL_N*2: break
print('val', len(val), flush=True)

query = set()
for toks, j in val:
    T = toks[:j]+toks[j+1:]
    for k in range(len(T)-1): query.add((T[k], T[k+1]))
print('query', len(query), flush=True)

qc = {k: 0 for k in query}; qmed = {k: 0 for k in query}
mid = {}; uni = collections.Counter()
z2 = zipfile.ZipFile(PATH); f2 = io.TextIOWrapper(z2.open('train_v2.txt'), encoding='utf-8')
n = 0; skip = 0
for line in f2:
    if skip < COUNT_START:
        skip += 1; continue
    s = line.rstrip('\n')
    if not s: continue
    toks = s.split(' '); L = len(toks)
