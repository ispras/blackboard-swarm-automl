        N+=1;o=gv[i];g=o['gap'];mg=o['margin'];T=[t for t in vt[i].split(' ') if t]
        noop=Levenshtein.distance(truth[i]['orig'],' '.join(T))
        if mg<thr: ds.append(noop);continue
        rec=lm.get(i)
        P={}
        for w,lp in rec['base'][:15]:
            if w:P[w]=P.get(w,0)+wb*math.exp(lp)
        for w,lp in rec['large'][:15]:
            if w:P[w]=P.get(w,0)+(1-wb)*math.exp(lp)
        t=tri.get(i)
        if t and int(t['gap'])==g:
            for w,v in norm_counts(t.get('tri') or []).items():P[w]=P.get(w,0)+alpha*v
        x=medoid(P,mpb) if P else ''
        cand=' '.join(T) if x=='' else ' '.join(T[:g]+[x]+T[g:])
        ds.append(Levenshtein.distance(truth[i]['orig'],cand));act+=1
    return statistics.mean(ds),act/N
for thr in [0.25,0.3,0.35,0.4,0.45,0.5]:
    m,c=pol(thr);print(f'tri_v2 thr={thr}: {m:.4f} cov={c:.3f}',flush=True)
for mpb in [0.03,0.05,0.1]:
