import json, statistics, math
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')}
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
ids=[i for i in dev if i<3000]
COMMON=['the','a','of','to','and','in',',','is','that','for',"'s",'it','on','was','.','s','']
def cands_at(r,g):
    d=mlm[r['id']]['pred'].get(str(g))
    if not d: return []
    pairs=[(norm(w),lp) for w,lp in zip(d['w'],d['lp']) if norm(w)]
    return pairs
def pick(pairs, mode, pb=0.25, mean_len=4.6):
    if not pairs: return ''
    ps=[p for _,p in []]
    ws=[w for w,_ in pairs]; lps=[lp for _,lp in pairs]
    mx=max(lps); P=[math.exp(lp-mx) for lp in lps]; Z=sum(P); P=[p/Z for p in P]
    top=ws[lps.index(mx)]
    if mode=='top1': return top
    # action pool
    pool=set()
    for w in ws:
        pool.add(w)
        for k in (1,2,3):
            if len(w)>k: pool.add(w[:k])
    pool |= set(COMMON)
    best=None
    for x in pool:
        e=(1-pb)*sum(p*Levenshtein.distance(x,w) for w,p in zip(ws,P)) + pb*(len(x)+mean_len if x else mean_len)
        if best is None or e<best[0]: best=(e,x)
    return best[1]
for mode in ['top1','hedge']:
    ds=[]; ok=0
    for i in ids:
        r=dev[i]; T=r['corrupted'].split(' '); g=r['gap']
        x=pick(cands_at(r,g),mode)
        cand=' '.join(T[:g]+([x] if x else [])+T[g:])
        d=Levenshtein.distance(r['orig'],cand); ds.append(d); ok+=d==0
    print(mode,'oracle-gap mean',statistics.mean(ds),'exact',ok/len(ids))
# also with predicted gap z[marg_next,caus]
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def zgap(i):
    r=dev[i]; T=r['corrupted'].split(' '); n=len(T); pred=mlm[i]['pred']; cs=cau[i]['cscore']
    F={}
    for gs,d in pred.items():
        g=int(gs)
        if not(1<=g<n): continue
        pairs=[(norm(w),lp) for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if len(pairs)<2: continue
        ws=[x for x,_ in pairs]; lps=[lp for _,lp in pairs]; mx=max(lps)
        nxt=T[g]; prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        F[g]=(mx-lp_nxt)+(mx-lp_prv)+cs.get(gs,0.0)
    if not F: return None,None
    g=max(F,key=lambda k:F[k]); return g,F[g]
for mode in ['top1','hedge']:
    for thr in [-1e9,1.0,1.5,2.0,2.5]:
        ds=[];act=0
        for i in ids:
            r=dev[i]; g1,s=zgap(i)
            if g1 is None: ds.append(Levenshtein.distance(r['corrupted'],r['orig'])); continue
            if s>=thr:
                g2,s2=zgap(i); x=pick(cands_at(r,g2 if False else g1),mode); act+=1
                cand=' '.join(r['corrupted'].split(' ')[:g1]+([x] if x else [])+r['corrupted'].split(' ')[g1:])
            else:
                cand=r['corrupted']
            ds.append(Levenshtein.distance(cand,r['orig']))
        print('predgap',mode,'thr',thr,'act',round(act/len(ids),3),'mean',round(statistics.mean(ds),4))
