import json, statistics, argparse, math
from Levenshtein import distance as lev

def norm(t):
    return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()

def loc_eval(dev, mlm, cau):
    n=len(dev); res={}
    funcs={}
    # per-gap feature builder
    def feats(i, words, tg, true):
        cs=cau[i]['cscore']; mp=mlm[i]['pred']
        gaps=[g for g in range(1,len(words)) if str(g) in cs and str(g) in mp]
        F={}
        for g in gaps:
            d=mp[str(g)]
            ws=[norm(w) for w in d['w']]; lps=d['lp']
            nxt=words[g]; prv=words[g-1]
            top1=lps[0]
            # margin vs next token
            lp_next=-20.0
            for w,lp in zip(ws,lps):
                if w==nxt: lp_next=lp; break
            lp_prev=-20.0
            for w,lp in zip(ws,lps):
                if w==prv: lp_prev=lp; break
            F[g]=dict(top1=top1, next=lp_next, prev=lp_prev, caus=cs[str(g)],
                      marg_next=top1-lp_next, marg_prev=top1-lp_prev)
        return F
    feats_all={i:feats(i, dev[i]['corrupted'].split(' '), dev[i]['gap'], dev[i]['true']) for i in dev}
    def zs(vals):
        m=statistics.mean(vals); s=statistics.pstdev(vals) or 1.0
        return m,s
    combos={
        'top1': lambda F: F['top1'],
        'marg_next': lambda F: F['marg_next'],
        'marg_prev': lambda F: F['marg_prev'],
        'caus': lambda F: F['caus'],
        'top1+caus': lambda F: F['top1']+F['caus'],
        'marg_next+caus': lambda F: F['marg_next']+F['caus'],
        'top1+marg_next+caus': lambda F: F['top1']+F['marg_next']+F['caus'],
    }
    # z-normalize per sentence then combine
    def zscore_sentence(F, keys):
        # returns dict g->sum of per-sentence z of each feature
        out={g:0.0 for g in F}
        for k in keys:
            vals=[F[g][k] for g in F]
            m=statistics.mean(vals); s=statistics.pstdev(vals) or 1.0
            for g in F: out[g]+=(F[g][k]-m)/s
        return out
    zcombos={
        'z[top1,caus]': ['top1','caus'],
