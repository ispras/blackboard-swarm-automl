import json, csv, math, statistics
import Levenshtein
cfg=json.load(open('fusion_config.json')); TH=cfg['threshold']
test={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
p1={json.loads(l)['id']:json.loads(l) for l in open('val_p1.jsonl')}
base={json.loads(l)['id']:json.loads(l) for l in open('mlm_val20k.jsonl')}
lmg={json.loads(l)['id']:json.loads(l) for l in open('val_lm_chosen.jsonl')}
