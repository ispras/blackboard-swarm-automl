    for k in range(len(T)-1):
        query.add((T[k], T[k+1]))
print('query pairs', len(query), flush=True)

qc = {k: 0 for k in query}       # direct bigram a,b
qmed = {k: 0 for k in query}     # mediated a,*,b
mid = {} if STORE_MID else None
uni = {}

z2 = zipfile.ZipFile(PATH)
f2 = io.TextIOWrapper(z2.open('train_v2.txt'), encoding='utf-8')
n = 0
for line in f2:
    s = line.rstrip('\n')
    if not s: continue
    toks = s.split(' ')
    L = len(toks)
    for i in range(L):
        w = toks[i]; uni[w] = uni.get(w, 0) + 1
    for i in range(L-1):
        p = (toks[i], toks[i+1])
        if p in qc: qc[p] += 1
    for i in range(L-2):
        p = (toks[i], toks[i+2])
        if p in qmed:
            qmed[p] += 1
            if STORE_MID:
                d = mid.get(p)
                if d is None: d = {}; mid[p] = d
                y = toks[i+1]; d[y] = d.get(y, 0) + 1
    n += 1
    if n % 500000 == 0:
        print('counted', n, 't=%.1f' % (time.time()-t0), flush=True)
    if n >= COUNT_LINES: break
print('count done n=%d t=%.1f' % (n, time.time()-t0), flush=True)

# score variants
def make_scores(a, b):
    cab = qc.get((a,b), 0); cm = qmed.get((a,b), 0)
    return {
        'med_over_direct': math.log((cm+0.5)/(cab+0.5)),
        'med_minus_direct': math.log(cm+0.5) - math.log(cab+0.5),
        'med_only': math.log(cm+0.5),
        'neg_direct': -math.log(cab+0.5),
        'med_over_direct_normb': math.log((cm+0.5)/(cab+0.5)) - math.log(uni.get(b,0)+1),
    }
variants = ['med_over_direct','med_minus_direct','med_only','neg_direct','med_over_direct_normb']
top1 = {v:0 for v in variants}
cost_oracle = {v:0.0 for v in variants}
cost_comma = {v:0.0 for v in variants}
cost_noop = 0.0
ranks = {v:[] for v in variants}
N = len(val)
for toks, j in val:
    T = toks[:j] + toks[j+1:]
    true_gap = j-1
    sc = {v:[] for v in variants}
    for k in range(len(T)-1):
        ss = make_scores(T[k], T[k+1])
        for v in variants: sc[v].append(ss[v])
    O = ' '.join(toks)
    cost_noop += Levenshtein.distance(' '.join(T), O)
    for v in variants:
        order = sorted(range(len(T)-1), key=lambda k: -sc[v][k])
        rg = order.index(true_gap); ranks[v].append(rg)
        if rg == 0: top1[v]+=1
        pg = order[0]
        cand = T[:pg+1]+[toks[j]]+T[pg+1:]
        cost_oracle[v] += Levenshtein.distance(' '.join(cand), O)
        cand2 = T[:pg+1]+[',']+T[pg+1:]
        cost_comma[v] += Levenshtein.distance(' '.join(cand2), O)

print('=== count_lines=%d N=%d noop=%.4f ===' % (n, N, cost_noop/N))
res = {}
for v in variants:
    print('%-24s top1=%.4f oracle@pg=%.4f comma@pg=%.4f meanrank=%.2f' %
          (v, top1[v]/N, cost_oracle[v]/N, cost_comma[v]/N, sum(ranks[v])/N))
    res[v] = {'top1': top1[v]/N, 'oracle': cost_oracle[v]/N, 'comma': cost_comma[v]/N,
              'meanrank': sum(ranks[v])/N}
json.dump({'n':n,'noop':cost_noop/N,'res':res}, open('/download_job_code/payload/sandbox/workspaces/fomalhaut_zeta/loc_exp2.json','w'))
