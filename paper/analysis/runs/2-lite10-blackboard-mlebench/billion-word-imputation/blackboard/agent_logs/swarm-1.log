import json, csv, math, statistics, sys
import numpy as np
from sklearn.linear_model import LogisticRegression
sys.path.insert(0,'.')
from decision import optimize_sentence
import Levenshtein

FOM='../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'
MLM='mlm_val20k.jsonl'
test={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl',encoding='utf-8')}
fom={}
for l in open(FOM,encoding='utf-8'):
    o=json.loads(l); fom[int(o['id'])]=o
mlm={}
for l in open(MLM,encoding='utf-8'):
    o=json.loads(l); mlm[int(o['id'])]=o
def glist(o):
    gp=o.get('gap_probs') or []
    if isinstance(gp,dict): gp=list(gp.items())
    arr=[(int(g),float(p)) for g,p in gp if float(p)>0]
    z=sum(v for _,v in arr) or 1.0
    return {g:v/z for g,v in arr}
def fom_words(o,g):
    d={}
    for it in (o.get('cands') or []):
        gg,w,s=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and s>0: d[w]=d.get(w,0)+s
    z=sum(d.values()) or 1.0
    return {w:v/z for w,v in d.items()}

ids=sorted(set(fom)&set(mlm)&set(truth))
def build_feats(i):
    T=[t for t in test[i].split(' ') if t!=' ']
    gp=glist(fom[i]); pred=mlm[i]['pred']
    gaps=sorted(set(gp)&set(int(g) for g in pred if 1<=int(g)<len(T)))
    if len(gaps)<2: return None
    raw={}
    for g in gaps:
        d=pred[str(g)]
        pairs=[(w,lp) for w,lp in zip(d['w'],d['lp']) if w]
        if len(pairs)<2: continue
        ws=[w for w,_ in pairs]; lps=[lp for _,lp in pairs]
        top1=lps[0]; l20=lps[-1]; mx=max(lps)
        nxt=T[g]; prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        raw[g]=[math.log(max(gp.get(g,1e-12),1e-12)), top1, mx-lp_nxt, mx-lp_prv, top1-l20, top1-lps[1]]
    gaps=[g for g in gaps if g in raw]
    if len(gaps)<2: return None
    A=np.array([raw[g] for g in gaps],dtype=np.float64)
    # per-sentence z-normalize each feature
    mu=A.mean(0); sd=A.std(0); sd[sd<1e-9]=1.0
    Z=(A-mu)/sd
    return gaps,Z

train_ids=ids[:5000]
test_ids=ids[5000:]
def make(idset):
    X=[];y=[];meta=[]
    for k,i in enumerate(idset):
        b=build_feats(i)
        if b is None: continue
        gaps,Z=b; tg=truth[i]['gap']
        for j,g in enumerate(gaps):
            X.append(Z[j]); y.append(1 if g==tg else 0)
        meta.append((i,gaps,Z))
    return np.array(X),np.array(y),meta
Xtr,ytr,_=make(train_ids)
Xte,yte,meta_te=make(test_ids)
print('train',Xtr.shape,'test',Xte.shape,flush=True)
for C in [0.01,0.03,0.1,0.3,1.0]:
    clf=LogisticRegression(C=C,max_iter=2000)
    clf.fit(Xtr,ytr)
    top1=0;top3=0;n=0
    allg={}
    for i,gaps,Z in meta_te:
        s=clf.decision_function(Z)
        order=np.argsort(-s)
        tg=truth[i]['gap']
        rank=list(np.array(gaps)[order]).index(tg) if tg in gaps else 99
        top1+=rank==0; top3+=rank<3; n+=1
        # posterior
        e=np.exp(s-s.max()); p=e/e.sum()
        allg[i]={int(g):float(pp) for g,pp in zip(gaps,p)}
    print(f'C={C} top1={top1/n:.4f} top3={top3/n:.4f} n={n}',flush=True)
    if C==0.1:
        json.dump({str(k):v for k,v in allg.items()}, open('fused_gap_te.json','w'))
        # evaluate decision on held-out using fused gap + mlm/fom words
        for wsrc,alpha in [('mlm',0.0),('both',0.6)]:
            for floor in [0.02,0.05,0.1]:
                ds=[]
                for i,gaps,Z in meta_te:
                    T=[t for t in test[i].split(' ') if t!='']
                    gp=allg[i]; pred=mlm[i]['pred']; joint=[]
                    for g,pg in gp.items():
                        pm={}
                        d=pred.get(str(g))
                        if d:
                            for w,lp in zip(d['w'],d['lp']):
                                if w: pm[w]=math.exp(lp)
                        fw=fom_words(fom[i],g)
                        if wsrc=='mlm': P=pm
                        else:
                            P={}
                            for w,v in pm.items(): P[w]=P.get(w,0)+alpha*v
                            for w,v in fw.items(): P[w]=P.get(w,0)+(1-alpha)*v
                        for w,v in P.items():
                            if v>0: joint.append((g,w,pg*v))
                    mass=sum(s for _,_,s in joint); pb=max(floor,min(0.999,1-mass))
                    ga,x,c,kind=optimize_sentence(T,joint,None,pb=pb,top_cands=20,top_gaps=3)
                    pred_s=' '.join(T) if x=='' else ' '.join(T[:ga]+[x]+T[ga:])
                    ds.append(Levenshtein.distance(truth[i]['orig'],pred_s))
                print(f'   C=0.1 word={wsrc} alpha={alpha} floor={floor}: mean={statistics.mean(ds):.4f}',flush=True)
