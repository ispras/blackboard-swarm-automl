        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        rows.append([math.log(max(gp.get(g,1e-12),1e-12)),top1,mx-lp_nxt,mx-lp_prv,top1-lps[-1],top1-lps[1]])
        gaps.append(g)
    if len(rows)<2:return None
