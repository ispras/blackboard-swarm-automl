import json, csv, math, statistics
import Levenshtein
vt={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
gv={}
for l in open('../fomalhaut_zeta/val_gaps_v3.jsonl'):
    o=json.loads(l);gv[o['id']]=o
lm={json.loads(l)['id']:json.loads(l) for l in open('val_v3_lm.jsonl')}
fomc={}
for l in open('../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'):
    o=json.loads(l);fomc[o['id']]=o
def fw(i,g):
    d={}
    for it in (fomc.get(i,{}).get('cands') or []):
        gg,w,c=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and c>0: d[w]=d.get(w,0)+c
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def medoid(P,mpb,depth):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+4.57)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def ev(wb,alpha,mpb,depth,thr=0.30):
    ds=[]
    for i in sorted(truth):
        if i<5000: continue
        o=gv[i];g=o['gap'];mg=o['margin'];T=[t for t in vt[i].split(' ') if t]
        noop=Levenshtein.distance(truth[i]['orig'],' '.join(T))
        if mg<thr: ds.append(noop);continue
        rec=lm.get(i)
        if not rec: ds.append(noop);continue
        P={}
        for w,lp in rec['base'][:15]:
            if w:P[w]=P.get(w,0)+wb*math.exp(lp)
        for w,lp in rec['large'][:15]:
            if w:P[w]=P.get(w,0)+(1-wb)*math.exp(lp)
        for w,v in fw(i,g).items():P[w]=P.get(w,0)+alpha*v
        x=medoid(P,mpb,depth) if P else ''
        cand=' '.join(T) if x=='' else ' '.join(T[:g]+[x]+T[g:])
        ds.append(Levenshtein.distance(truth[i]['orig'],cand))
    return statistics.mean(ds)
best=None
for wb in [0.2,0.3,0.5]:
    for alpha in [0.0,0.3,0.5]:
        for mpb in [0.03,0.05,0.1]:
            m=ev(wb,alpha,mpb,3)
            print(f'wb={wb} alpha={alpha} mpb={mpb} depth=3: {m:.4f}',flush=True)
            if best is None or m<best[0]:best=(m,wb,alpha,mpb,3)
print('BEST',best)
b=best
for depth in [1,2,4]:
    m=ev(b[1],b[2],b[3],depth);print('depth',depth,m)
EOF
