for l in open('../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'):
    o=json.loads(l); fomc[o['id']]=o
def fw(i,g):
    d={}
    for it in (fomc.get(i,{}).get('cands') or []):
        gg,w,c=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and c>0: d[w]=d.get(w,0)+c
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def medoid(P,mpb,depth=3):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+4.57)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def cost(i,g,x):
    T=[t for t in test[i].split(' ') if t]
    cand=' '.join(T) if x=='' else ' '.join(T[:g]+[x]+T[g:])
    return Levenshtein.distance(truth[i]['orig'],cand)
old_ds=[];new_ds=[]
for i in sorted(truth):
    T=[t for t in test[i].split(' ') if t]
    noop=Levenshtein.distance(truth[i]['orig'],' '.join(T))
    r=p1.get(i)
    if r is None or r['P1']<TH:
        old_ds.append(noop);new_ds.append(noop);continue
    g=r['g1']
    # old: base top from mlm_val20k + fom .4, mpb .2
    o=base[i]['pred'].get(str(g)) or {}
    P={}
    for w,lp in zip(o.get('w',[]),o.get('lp',[])):
        if w:P[w]=P.get(w,0)+math.exp(lp)
    for w,v in fw(i,g).items():P[w]=P.get(w,0)+0.4*v
    xo=medoid(P,0.2) if P else ''
    old_ds.append(cost(i,g,xo))
    # new: base .3 + large .7 + fom .4, mpb .05
    P2={}
    for w,lp in lmg[i]['base'][:15]:
        if w:P2[w]=P2.get(w,0)+0.3*math.exp(lp)
    for w,lp in lmg[i]['large'][:15]:
        if w:P2[w]=P2.get(w,0)+0.7*math.exp(lp)
    for w,v in fw(i,g).items():P2[w]=P2.get(w,0)+0.4*v
    xn=medoid(P2,0.05) if P2 else ''
    new_ds.append(cost(i,g,xn))
print('n',len(old_ds))
print('OLD word policy:',statistics.mean(old_ds))
print('NEW word policy:',statistics.mean(new_ds))
EOF
