    gp=o.get('gap_probs') or []
    if isinstance(gp,dict): gp=list(gp.items())
    arr=[(int(g),float(p)) for g,p in gp if float(p)>0]
    z=sum(v for _,v in arr) or 1.0
    return {g:v/z for g,v in arr}
def fom_words(o,g):
    d={}
    for it in (o.get('cands') or []):
        gg,w,s=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and s>0: d[w]=d.get(w,0)+s
    z=sum(d.values()) or 1.0
    return {w:v/z for w,v in d.items()}
PUNCT=set([',','.',';',':','!','?','"',"'",'(',')','--','-','``',"''"])
def build(i):
    T=[t for t in test[i].split(' ') if t!='']
    gp=glist(fom[i]); pred=mlm[i]['pred']; n=len(T)
    gaps=sorted(set(gp)&set(int(g) for g in pred if 1<=int(g)<n))
    rows=[]
    for g in gaps:
        d=pred[str(g)]
        pairs=[(w,lp) for w,lp in zip(d['w'],d['lp']) if w]
        if len(pairs)<2: continue
        ws=[w for w,_ in pairs]; lps=[lp for _,lp in pairs]
        top1=lps[0]; l20=lps[-1]; mx=max(lps)
        nxt=T[g]; prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        nconf=sum(1 for lp in lps if math.exp(lp)>0.01)
        rows.append([math.log(max(gp.get(g,1e-12),1e-12)), top1, mx-lp_nxt, mx-lp_prv,
                     top1-l20, top1-lps[1], g/(n-1), nconf, len(ws[0]),
                     1.0 if (nxt in PUNCT or prv in PUNCT) else 0.0])
    if len(rows)<2: return None
    gaps2=[g for g in gaps if str(g) in pred]
    # keep alignment: rows built in same order as gaps that passed; redo gaps list
    gaps2=[]
    for g in gaps:
        d=pred[str(g)]; pairs=[(w,lp) for w,lp in zip(d['w'],d['lp']) if w]
        if len(pairs)>=2: gaps2.append(g)
    A=np.array(rows); mu=A.mean(0); sd=A.std(0); sd[sd<1e-9]=1.0
    Z=(A-mu)/sd
    # interactions (post-z)
    inter=np.column_stack([Z[:,0]*Z[:,2], Z[:,0]*Z[:,3], Z[:,2]*Z[:,4]])
    Z=np.column_stack([Z,inter])
    return gaps2,Z
ids=sorted(set(fom)&set(mlm)&set(truth))
cache={}
for i in ids:
    b=build(i)
    if b: cache[i]=b
print('cached',len(cache),flush=True)
train_ids=[i for i in ids[:5000] if i in cache]; test_ids=[i for i in ids[5000:] if i in cache]
def make(idset):
    X=[];y=[];meta=[]
    for i in idset:
        gaps,Z=cache[i]; tg=truth[i]['gap']
        for j,g in enumerate(gaps):
            X.append(Z[j]); y.append(1 if g==tg else 0)
        meta.append((i,gaps,Z))
    return np.array(X),np.array(y),meta
Xtr,ytr,_=make(train_ids); Xte,yte,meta_te=make(test_ids)
def evalmeta(scores_fn):
    top1=0;top3=0;n=0;allg={}
    for i,gaps,Z in meta_te:
        s=scores_fn(Z); order=np.argsort(-s); tg=truth[i]['gap']
        rank=list(np.array(gaps)[order]).index(tg) if tg in gaps else 99
        top1+=rank==0; top3+=rank<3; n+=1
        e=np.exp(s-s.max()); p=e/e.sum()
        allg[i]={int(g):float(pp) for g,pp in zip(gaps,p)}
    return top1/n,top3/n,allg
# logistic
for C in [0.03,0.1,0.3]:
    clf=LogisticRegression(C=C,max_iter=3000).fit(Xtr,ytr)
    t1,t3,allg=evalmeta(lambda Z: clf.decision_function(Z))
    print(f'logreg C={C}: top1={t1:.4f} top3={t3:.4f}',flush=True)
    if C==0.1: best_logreg=(t1,t3,allg)
# lightgbm binary
for params in [dict(num_leaves=15,n_estimators=300,learning_rate=0.05,min_child_samples=50),
               dict(num_leaves=31,n_estimators=400,learning_rate=0.05,min_child_samples=30)]:
    m=lgb.LGBMClassifier(objective='binary',subsample=0.8,colsample_bytree=0.8,verbose=-1,**params)
    m.fit(Xtr,ytr)
    t1,t3,allg=evalmeta(lambda Z: m.predict_proba(Z)[:,1])
    print(f'lgb {params}: top1={t1:.4f} top3={t3:.4f}',flush=True)
