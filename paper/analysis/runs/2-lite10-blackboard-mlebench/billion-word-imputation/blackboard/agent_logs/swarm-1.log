import lightgbm as lgb
import Levenshtein
FOM='../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'; MLM='mlm_val20k.jsonl'
test={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl',encoding='utf-8')}
fom={};mlm={}
for l in open(FOM,encoding='utf-8'):
    o=json.loads(l);fom[int(o['id'])]=o
for l in open(MLM,encoding='utf-8'):
    o=json.loads(l);mlm[int(o['id'])]=o
def glist(o):
    gp=o.get('gap_probs') or []
    if isinstance(gp,dict):gp=list(gp.items())
    arr=[(int(g),float(p)) for g,p in gp if float(p)>0];z=sum(v for _,v in arr) or 1
    return {g:v/z for g,v in arr}
def fom_words(o,g):
    d={}
    for it in (o.get('cands') or []):
        gg,w,s=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and s>0:d[w]=d.get(w,0)+s
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def build(i):
    T=[t for t in test[i].split(' ') if t!='']
    gp=glist(fom[i]);pred=mlm[i]['pred'];n=len(T)
    gaps=[];rows=[]
    for g in sorted(set(gp)&set(int(x) for x in pred if 1<=int(x)<n)):
        d=pred[str(g)];pairs=[(w,lp) for w,lp in zip(d['w'],d['lp']) if w]
        if len(pairs)<2:continue
        ws=[w for w,_ in pairs];lps=[lp for _,lp in pairs];top1=lps[0];mx=max(lps)
        nxt=T[g];prv=T[g-1]
        lp_nxt=min(lps) if nxt not in ws else lps[ws.index(nxt)]
        lp_prv=min(lps) if prv not in ws else lps[ws.index(prv)]
        rows.append([math.log(max(gp.get(g,1e-12),1e-12)),top1,mx-lp_nxt,mx-lp_prv,top1-lps[-1],top1-lps[1]])
        gaps.append(g)
    if len(rows)<2:return None
    A=np.array(rows);mu=A.mean(0);sd=A.std(0);sd[sd<1e-9]=1;Z=(A-mu)/sd
    return T,gaps,Z,pred
ids=sorted(set(fom)&set(mlm)&set(truth));cache={}
for i in ids:
    b=build(i)
    if b:cache[i]=b
tr=[i for i in ids[:5000] if i in cache];te=[i for i in ids[5000:] if i in cache]
Xtr=[];ytr=[]
for i in tr:
    T,gaps,Z,pred=cache[i];tg=truth[i]['gap']
    for j,g in enumerate(gaps):Xtr.append(Z[j]);ytr.append(1 if g==tg else 0)
clf=LogisticRegression(C=0.1,max_iter=3000).fit(np.array(Xtr),np.array(ytr))
def medoid(P, pb=0.1, mean_len=4.57):
    ws=list(P); pool=set(ws)
    for w in ws:
        for k in (1,2):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+pb*(len(x)+mean_len)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def records(idset):
    out=[]
    for i in idset:
        T,gaps,Z,pred=cache[i];s=clf.decision_function(Z);e=np.exp(s-s.max());P=e/e.sum()
        order=np.argsort(-P);g1=gaps[order[0]];P1=float(P[order[0]]);P2=float(P[order[1]])
        d=pred[str(g1)]
