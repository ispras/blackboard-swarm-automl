        pairs=models[name][i];g=d['gap']
        top1=pairs[0][0]
        ds_top1.append(actual(i,g,top1));ds_med.append(actual(i,g,medoid(pairs)));ds_none.append(len(d['word'])+1)
    print(f'{name}: oracle-gap top1={statistics.mean(ds_top1):.4f} medoid={statistics.mean(ds_med):.4f} noop={statistics.mean(ds_none):.4f}',flush=True)
# ensembles
for combo in [('roberta-base','roberta-large'),('roberta-base','bert-base-uncased'),('roberta-base','bert-base-uncased','roberta-large')]:
    ds=[];dst=[]
    for i,d in enumerate(truth):
        if any(i not in models[m] for m in combo): continue
        P={}
        for m in combo:
            for w,lp in models[m][i][:15]:
                if w: P[w]=P.get(w,0)+math.exp(lp)
        ws=list(P);pool=set(ws)
        for w in ws:
            for k in (1,2,3):
                if len(w)>k:pool.add(w[:k])
        pool|={',','the','a','of','to','and','in','.'}
        best=None
        for x in pool:
            e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+0.2*(len(x)+4.57)
            if best is None or e<best[0]:best=(e,x)
        g=d['gap'];ds.append(actual(i,g,best[1]))
        # top1 of roberta-large
    print('combo',combo,'medoid=',statistics.mean(ds),flush=True)
