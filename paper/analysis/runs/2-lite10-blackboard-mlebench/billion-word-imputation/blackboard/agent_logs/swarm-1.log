import json, math, statistics
import Levenshtein
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
lm={}
for l in open('val_lm_true.jsonl'):
    o=json.loads(l); lm[o['id']]=o
def build_P(o,wb,use_base=True,use_large=True,topk=15):
    P={}
    if use_base:
        for w,lp in o['base'][:topk]:
            if w: P[w]=P.get(w,0)+wb*math.exp(lp)
    if use_large:
        for w,lp in o['large'][:topk]:
            if w: P[w]=P.get(w,0)+(1-wb if use_base else 1.0)*math.exp(lp)
    return P
def medoid(P,mpb,ml=4.57,depth=3,fullonly=False):
    ws=list(P);pool=set(ws)
    if not fullonly:
        for w in ws:
            for k in range(1,depth+1):
                if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def cost(i,x):
    d=truth[i];T=[t for t in d['orig'].split(' ') if t]
    g=d['gap'];ds=T[:g]+T[g+1:]
    return Levenshtein.distance(d['orig'],' '.join(ds[:g]+([x] if x else [])+ds[g:]))
ids=[i for i in lm if i in truth]
best=None
for uw in [('base','large'),('large',),('base',)]:
    use_base='base' in uw; use_large='large' in uw
    for wb in ([0.5,0.3,0.0] if (use_base and use_large) else [0.0]):
        for mpb in [0.05,0.1,0.15,0.2,0.3,0.5]:
            for depth in [1,2,3]:
                ds=[]
                for i in ids:
                    P=build_P(lm[i],wb,use_base,use_large)
                    x=medoid(P,mpb,depth=depth)
                    ds.append(cost(i,x))
                m=statistics.mean(ds)
                if best is None or m<best[0]:best=(m,uw,wb,mpb,depth)
                print(f'{uw} wb={wb} mpb={mpb} depth={depth}: {m:.4f}',flush=True)
print('BEST',best)
