    # feature importance
    names=['lp_my','top1','top2','l20','spread','margin','margn','margp','pos','posr','lenp','lenn','pp','np','g1','gn','have','cs','zcs','rat','csprev','crank','vraw','vz','vp']
    imp=sorted(zip(names, clf.feature_importances_), key=lambda x:-x[1])
    print('importance', imp, flush=True)
    import os as _o; np.save(f'{OUT}/gbdt_scores_val3_{os.environ.get("TAG","a")}.npy', s)
