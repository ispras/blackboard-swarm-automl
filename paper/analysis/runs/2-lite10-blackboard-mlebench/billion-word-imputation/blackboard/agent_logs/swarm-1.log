import json, csv, math, statistics
import Levenshtein
vt={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
gv={json.loads(l)['id']:json.loads(l) for l in open('val_gaps_v7.jsonl')}
lm={json.loads(l)['id']:json.loads(l) for l in open('val_v7_lm.jsonl')}
tri={json.loads(l)['id']:json.loads(l) for l in open('../fomalhaut_zeta/trigram_val_chosen_v2.jsonl')}
fomc={}
for l in open('../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'):
    o=json.loads(l);fomc[o['id']]=o
def nc(pairs):
    d={}
    for w,c in pairs:
        if w and c>0:d[w]=d.get(w,0)+float(c)
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def fw_old(i,g):
    d={}
    for it in (fomc.get(i,{}).get('cands') or []):
        gg,w,c=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and c>0:d[w]=d.get(w,0)+c
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def medoid(P,mpb,depth=3,ml=4.57):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def pol(thr,mpb=0.03,alpha=0.3,wb=0.3):
    ds=[];act=0;N=0
    for i in sorted(truth):
        if i<5000: continue
        N+=1;o=gv[i];g=o['gap'];mg=o['margin'];T=[t for t in vt[i].split(' ') if t]
        noop=Levenshtein.distance(truth[i]['orig'],' '.join(T))
        if mg<thr or i not in lm: ds.append(noop);continue
        base,large=lm[i]['base'],lm[i]['large']
        P={}
        for w,lp in base[:15]:
            if w:P[w]=P.get(w,0)+wb*math.exp(lp)
        for w,lp in large[:15]:
            if w:P[w]=P.get(w,0)+(1-wb)*math.exp(lp)
        t=tri.get(i)
        if t and int(t['gap'])==g:
            for w,v in nc(t.get('tri') or []).items():P[w]=P.get(w,0)+alpha*v
        else:
            for w,v in fw_old(i,g).items():P[w]=P.get(w,0)+alpha*v
        x=medoid(P,mpb) if P else ''
        cand=' '.join(T) if x=='' else ' '.join(T[:g]+[x]+T[g:])
        ds.append(Levenshtein.distance(truth[i]['orig'],cand));act+=1
    return statistics.mean(ds),act/N
for thr in [0.25,0.3,0.35,0.4,0.45,0.5]:
    m,c=pol(thr);print(f'v7 thr={thr}: {m:.4f} cov={c:.3f}',flush=True)
for mpb in [0.02,0.03,0.05]:
    m,c=pol(0.35,mpb);print(f'mpb={mpb}: {m:.4f}',flush=True)
EOF
