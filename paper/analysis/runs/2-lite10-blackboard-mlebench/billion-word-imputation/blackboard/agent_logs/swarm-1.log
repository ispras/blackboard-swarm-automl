import json, csv, math, zipfile, io, os, statistics
import Levenshtein
OUT='/download_job_code/payload/sandbox/workspaces/fomalhaut_zeta'
BASE='/download_job_code/payload/sandbox/workspaces/betelgeuse_tau'
WHAT=os.environ.get('WHAT','test')
THR=float(os.environ.get('THR','0.35'))
GAPF=os.environ.get('GAPF',f'{OUT}/test_fused_top1_v3.jsonl')
WORDF=os.environ.get('WORDF',f'{OUT}/words_roberta-large_{WHAT}.jsonl')
BASEF=os.environ.get('BASEF','')  # optional base words file
OUTFILE=os.environ.get('OUTFILE',f'{OUT}/submission_large.csv')
def medoid(pairs):
    ws=[w for w,_ in pairs]; pr=[math.exp(lp) for _,lp in pairs]; tot=sum(pr); unk=max(0,1-tot)
    pool=set(ws)|{',','the','a','of','to','and','in','.'}
    for w in ws:
        for kk in (1,2):
            if len(w)>kk: pool.add(w[:kk])
    best=None
    for x in pool:
        e=sum(p*Levenshtein.distance(x,w) for w,p in zip(ws,pr))+unk*(len(x)+4.57)
        if best is None or e<best[0]: best=(e,x)
    return best[1]
gaps={json.loads(l)['id']:json.loads(l) for l in open(GAPF)}
words={json.loads(l)['id']:json.loads(l)['words'] for l in open(WORDF)}
base={}
if BASEF:
    for l in open(BASEF): 
        d=json.loads(l); base[d['id']]=d.get('words',[])
if WHAT=='test':
    sents={}
    z=zipfile.ZipFile('/download_job_code/payload/sandbox/data/test_v2.txt.zip'); f=io.TextIOWrapper(z.open('test_v2.txt'),encoding='utf-8')
    r=csv.reader(f); next(r)
    for row in r: sents[int(row[0])]=row[1]
else:
    sents={int(r['id']):r['sentence'] for r in csv.DictReader(open(f'{BASE}/val_test.csv'))}
truth={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/val_truth.jsonl')} if WHAT=='val' else {}
rows=[]; nins=0; ds=[]
for i in sorted(sents):
    g=gaps.get(i,{}); gap=int(g.get('gap',1)); mg=float(g.get('margin',0.0)); T=sents[i].split(' ')
    wl=words.get(i,[])
    # merge base words (if given) into prob pool
    pairs=[(a,float(b)) for a,b in wl]
    if base.get(i):
        # add base probs scaled (only if same gap known: assume gap matches)
        pass
    if mg>=THR and len(pairs)>=2:
        w=medoid(pairs); pred=' '.join(T[:gap]+[w]+T[gap:]); nins+=1
    else:
        pred=' '.join(T)
    rows.append((i,pred))
    if truth: ds.append(Levenshtein.distance(truth[i]['orig'],pred))
with open(OUTFILE,'w',newline='') as fo:
    w=csv.writer(fo); w.writerow(['id','sentence'])
    for i,p in rows: w.writerow([i,p])
print('wrote',OUTFILE,'rows',len(rows),'inserted',nins,'thr',THR)
if ds: print('VAL mean Lev = %.4f'%statistics.mean(ds))
