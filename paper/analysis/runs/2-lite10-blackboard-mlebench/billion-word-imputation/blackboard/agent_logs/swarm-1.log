import json, csv, random, statistics, sys
from decision import optimize_sentence
import Levenshtein

truth=[json.loads(l) for l in open('val_truth.jsonl',encoding='utf-8')]
test_by_id={int(r['id']):r['sentence'] for r in csv.DictReader(open('val_test.csv',encoding='utf-8'))}
COMMON=['the','a','of','to','and','in',',','is','that','for',"'s",'it','on','was','as','with','by','be','at','from','The','this','an','are','has','have','not','but','or','its','his','her','their']
rng=random.Random(11); N=4000; sample=truth[:N]

def actual(T,ga,x,d):
    return Levenshtein.distance(d['orig'],' '.join(T[:ga]+([x] if x else [])+T[ga:]))

def build(d,T,Pg,Pw,width=2,nw=6):
    g,w=d['gap'],d['word']; L=len(T)
    gaps=[g]
    # distribute (1-Pg) to neighbors
    neigh=[gg for gg in (g-1,g+1,g-2,g+2) if 0<=gg<=L and gg!=g][:width*2]
    gp={g:Pg}
    if neigh:
        for gg in neigh: gp[gg]=(1-Pg)/len(neigh)
    cands=[]
    others=[c for c in COMMON if c!=w][:nw]
    for gg,p in gp.items():
        if gg==g and rng.random()<Pw:
            cands.append((gg,w,p*Pw))
            for c in others: cands.append((gg,c,p*(1-Pw)/len(others)))
        else:
            # wrong gap OR true word missed: common words only (maybe include true word at low prob)
            for c in others: cands.append((gg,c,p/len(others)))
    return cands,None

for Pg,Pw in ((0.9,0.7),(0.8,0.6),(0.7,0.5),(0.6,0.45),(0.5,0.35),(0.4,0.3)):
    for pb in (0.2,0.4):
        ds=[]; ch=0
        for d in sample:
            T=[t for t in test_by_id[d['id']].split(' ') if t!='']
            c,_=build(d,T,Pg,Pw)
            ga,x,cost,kind=optimize_sentence(T,c,None,pb=pb)
            ds.append(actual(T,ga,x,d)); ch+= kind=='insert'
        print(f'Pg={Pg} Pw={Pw} pb={pb}: mean={statistics.mean(ds):.4f} changed={ch/len(ds):.1%}')
