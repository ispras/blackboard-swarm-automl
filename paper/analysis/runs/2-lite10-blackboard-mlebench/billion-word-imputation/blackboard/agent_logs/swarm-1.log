import json, statistics, math, sys
sys.path.insert(0,'.')
from decision import optimize_sentence
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/mirfak_chi'
dev=[json.loads(l) for l in open(f'{BASE}/dev3k.jsonl')]
mlm={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/pred_roberta_dev3k.jsonl')}
cau={json.loads(l)['id']:json.loads(l) for l in open(f'{BASE}/causal_gpt2med_dev3k.jsonl')}
def norm(t): return t.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
sub=dev[:1500]
def score(r,ga,x):
    T=r['corrupted'].split(' ')
    return Levenshtein.distance(r['orig'],' '.join(T[:ga]+([x] if x else [])+T[ga:]))

def gap_scores(r):
    T=r['corrupted'].split(' '); n=len(T); pred=mlm[r['id']]['pred']
    s={}
    for gs,d in pred.items():
        g=int(gs)
        if not (1<=g<n): continue
        lps=[lp for w,lp in zip(d['w'],d['lp']) if norm(w)]
        if not lps: continue
        s[g]=max(lps)  # top1 lp
    return s

def build(r, beta, use_causal, cw=0.25):
    T=r['corrupted'].split(' '); n=len(T); pred=mlm[r['id']]['pred']
    s=gap_scores(r)
    if not s: return [], None
    # gap score: -top1lp (low confidence => likely true gap)
    z={}
    cs=cau.get(r['id'],{}).get('cscore',{})
    for g,v in s.items():
        val=-v
        if use_causal and str(g) in cs:
            val = (1-cw)*val/cw if False else (1-cw)*val + cw*cs[str(g)]*1.0
        z[g]=val
    mx=max(z.values())
    gp={g:math.exp(beta*(v-mx)) for g,v in z.items()}
    Z=sum(gp.values()); gp={g:v/Z for g,v in gp.items() if v/Z>1e-4}
    cands=[]
    for gs,d in pred.items():
        g=int(gs)
        if g not in gp: continue
        for w,lp in zip(d['w'],d['lp']):
            x=norm(w)
            if not x: continue
            cands.append((g,x,gp[g]*math.exp(lp)))
    return cands, gp

best=None
for use_causal in (False,True):
  for beta in (0.5,1,2,4,8,16):
    for pb in (0.05,0.15,0.3,0.5,0.7):
        ds=[]; ch=0
        for r in sub:
            T=r['corrupted'].split(' ')
            c,gp=build(r,beta,use_causal)
            ga,x,cost,kind=optimize_sentence(T,c,gp,pb=pb,top_cands=20,top_gaps=3)
            ds.append(score(r,ga,x)); ch+=kind=='insert'
        m=statistics.mean(ds)
        if best is None or m<best[0]: best=(m,use_causal,beta,pb,ch/len(ds))
        print(f'causal={use_causal} beta={beta} pb={pb}: mean={m:.4f} changed={ch/len(ds):.1%}')
print('BEST',best)
EOF
