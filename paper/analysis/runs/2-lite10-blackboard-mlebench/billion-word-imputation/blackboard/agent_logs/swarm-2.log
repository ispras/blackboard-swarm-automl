for r in csv.DictReader(open(f'{V}/val_test.csv')): sents[int(r['id'])]=r['sentence']
def medoid(P,mpb,depth=3,ml=4.57):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*L.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def run(mode,mpb,thr,topn=15,alpha=0.4,verbose=False):
    tot=0;n=0;act=0;gacc=0
    for i,(g,m) in gaps.items():
        if i not in sents or i not in truth: continue
        n+=1; orig=truth[i]['orig']; T=sents[i].split(' ')
        if m<thr or i not in lm:
            tot+=L.distance(sents[i],orig); continue
        act+=1; base,large=lm[i]; P={}
        if mode in ('base','bl','blt'):
            for w,lp in base[:topn]: P[w]=P.get(w,0)+0.3*math.exp(lp)
        if mode in ('large','bl','blt'):
            for w,lp in large[:topn]: P[w]=P.get(w,0)+(0.7 if mode!='large' else 1.0)*math.exp(lp)
        if mode=='blt':
            t=tri.get(i)
            if t and int(t.get('gap',-1))==g:
                d={}
                for w,c in (t.get('tri') or []):
                    if w and c>0: d[w]=d.get(w,0)+float(c)
                z=sum(d.values()) or 1.0
                for w,v in d.items(): P[w]=P.get(w,0)+alpha*v/z
        x=medoid(P,mpb) if P else ''
        ours=' '.join(T[:g]+([x] if x else [])+T[g:])
        tot+=L.distance(ours,orig)
        if g==truth[i]['gap']: gacc+=1
    return tot/n,act/n,(gacc/act if act else 0)
print('best config sweep (thr, mpb, mode):')
