import numpy as np
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score
import torch, torch.nn as nn
d=np.load('verif_probe.npz')
X=d['feat'].astype(np.float32); y=d['label']; sid=d['sid']; ev=d['ev']; t1=d['top1lp']
tr=np.where(ev==0)[0]; te=np.where(ev==1)[0]
sc=StandardScaler().fit(X[tr]); Xtr=sc.transform(X[tr]); Xte=sc.transform(X[te])
clf=LogisticRegression(C=0.1,max_iter=500).fit(Xtr,y[tr])
pte=clf.decision_function(Xte)
print('AUC lr',roc_auc_score(y[te],pte),flush=True)
class MLP(nn.Module):
    def __init__(s):
        super().__init__(); s.net=nn.Sequential(nn.Linear(X.shape[1],256),nn.GELU(),nn.Dropout(0.2),nn.Linear(256,64),nn.GELU(),nn.Linear(64,1))
    def forward(s,x): return s.net(x).squeeze(-1)
m=MLP(); opt=torch.optim.AdamW(m.parameters(),lr=1e-3,weight_decay=1e-2)
Xt=torch.tensor(Xtr); yt=torch.tensor(y[tr],dtype=torch.float32)
for ep in range(20):
    perm=torch.randperm(len(Xt))
    for st in range(0,len(perm),512):
        idx=perm[st:st+512]
        loss=nn.functional.binary_cross_entropy_with_logits(m(Xt[idx]),yt[idx])
        opt.zero_grad(); loss.backward(); opt.step()
m.eval()
with torch.no_grad(): pm=m(torch.tensor(Xte)).numpy()
print('AUC mlp',roc_auc_score(y[te],pm),flush=True)
def rank_eval(score,name):
    ss=sid[te]; yy=y[te]
    order=np.lexsort((-score,ss))
    corr=0;tot=0;ranks=[]
    start=0
    while start<len(order):
        end=start
        while end<len(order) and ss[order[end]]==ss[order[start]]: end+=1
        grp=order[start:end]
        pos=np.where(yy[grp]==1)[0]
        if len(pos):
            r=int(pos[0]); ranks.append(r); corr+=(r==0); tot+=1
        start=end
    print(f'{name}: top1={corr/tot:.3f} meanrank={np.mean(ranks):.2f} top3={np.mean([r<3 for r in ranks]):.3f} top5={np.mean([r<5 for r in ranks]):.3f}',flush=True)
z=lambda a:(a-a.mean())/(a.std()+1e-9)
rank_eval(pte,'verif-lr')
rank_eval(pm,'verif-mlp')
rank_eval(t1[te],'top1lp')
rank_eval(z(pte)+z(pm),'verif-lr+mlp')
rank_eval(z(pte)+z(pm)+z(t1[te]),'verif+top1lp')
EOF
