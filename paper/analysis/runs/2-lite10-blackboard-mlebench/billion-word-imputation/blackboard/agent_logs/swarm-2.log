def medoid(P,mpb=0.03,depth=3,ml=4.57):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k: pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*L.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]: best=(e,x)
    return best[1]
tri={}
for l in open(f'{F}/trigram_val_chosen_v2.jsonl'):
    d=json.loads(l); tri[d['id']]=d
sents={}
for r in csv.DictReader(open(f'{V}/val_test.csv')): sents[int(r['id'])]=r['sentence']
IDS=[i for i in gaps if i>=5000]
print('heldout top1',sum(gaps[i][0]==truth[i]['gap'] for i in IDS)/len(IDS),'n',len(IDS))
def metric(thr,use_tri=True):
    tot=0;n=0
    for i in IDS:
        g,m=gaps[i]; T=sents[i].split(' '); orig=truth[i]['orig']; n+=1
        if m<thr or i not in lm:
            tot+=L.distance(sents[i],orig); continue
        base,large=lm[i]; P={}
        for w,lp in base[:20]: P[w]=P.get(w,0)+0.3*math.exp(lp)
        for w,lp in large[:20]: P[w]=P.get(w,0)+0.7*math.exp(lp)
        if use_tri:
            t=tri.get(i)
            if t and int(t.get('gap',-1))==g:
                dd={}
                for w,c in (t.get('tri') or []):
                    if w and c>0: dd[w]=dd.get(w,0)+float(c)
                z=sum(dd.values()) or 1.0
                for w,v in dd.items(): P[w]=P.get(w,0)+0.4*v/z
        x=medoid(P)
        tot+=L.distance(' '.join(T[:g]+[x]+T[g:]),orig)
    return tot/n
for thr in [0.30,0.35,0.40,0.45]:
    print('thr',thr,'metric(no tri)',round(metric(thr,False),4),'metric(tri)',round(metric(thr,True),4))
