    toks=s.split(' '); ids=[vget(t) for t in toks]; L=len(ids)
    for i in range(L-2):
        a=ids[i]
        if a is None: continue
        b=ids[i+2]
        if b is None: continue
        key=a*V+b
        d=mid.get(key)
        if d is not None: d[toks[i+1]]+=1
    n+=1
