import json,csv,math
import Levenshtein as L
V="../betelgeuse_tau"; F="../fomalhaut_zeta"
truth={json.loads(l)["id"]:json.loads(l) for l in open(V+"/val_truth.jsonl")}
gaps={}
for l in open(F+"/val_gaps_v4.jsonl"):
    d=json.loads(l); gaps[d["id"]]=(d["gap"],d["margin"])
lm={}
for l in open(V+"/val_v4_lm.jsonl"):
    d=json.loads(l); lm[d["id"]]=(d["base"],d["large"])
tri={}
for l in open(F+"/trigram_val_chosen_v2.jsonl"):
    d=json.loads(l); tri[d["id"]]=d
sents={}
for r in csv.DictReader(open(V+"/val_test.csv")): sents[int(r["id"])]=r["sentence"]
def medoid(P,mpb,depth=3,ml=4.57,exclude=set()):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={",","the","a","of","to","and","in","."}
    pool-=exclude
    best=None
    for x in pool:
        e=sum(P[w]*L.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]:best=(e,x)
    return best[1] if best else ""
trin={}
for i,d in tri.items():
    g=int(d.get("gap",-1)); dd={}
    for w,c in (d.get("tri") or []):
        if w and c>0: dd[w]=dd.get(w,0)+float(c)
    z=sum(dd.values()) or 1.0
    trin[i]=(g,{w:v/z for w,v in dd.items()})
IDS=[i for i in gaps if i>=5000]
def run(excl):
    tot=0;n=0;dup=0;dupcost=0;dupcorrect=0;changed=0;tot2=0
    for i in IDS:
        g,m=gaps[i];
        if i not in sents or i not in truth: continue
        n+=1; orig=truth[i]["orig"]; T=sents[i].split(" ")
        if m<0.35 or i not in lm:
            c=L.distance(sents[i],orig); tot+=c; continue
        base,large=lm[i]; P={}
        for w,lp in base[:20]: P[w]=P.get(w,0)+0.3*math.exp(lp)
        for w,lp in large[:20]: P[w]=P.get(w,0)+0.7*math.exp(lp)
        t=trin.get(i)
        if t and t[0]==g:
            for w,v in t[1].items(): P[w]=P.get(w,0)+0.4*v
        ex=set()
        if excl: ex={T[g-1], T[g]}
        x=medoid(P,0.03,exclude=ex)
        if x and (x==T[g-1] or x==T[g]):
            dup+=1; dupcost+=L.distance(x,truth[i]["word"]); dupcorrect+=(g==truth[i]["gap"] and x==truth[i]["word"])
        tot+=L.distance(" ".join(T[:g]+[x]+T[g:]),orig)
    return tot/n,dup,dup/n,(dupcost/max(1,dup)),dupcorrect
print("baseline",run(False))
print("exclude_neighbors",run(True))
EOF'
