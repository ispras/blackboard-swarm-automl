import Levenshtein as L
V="../betelgeuse_tau"; F="../fomalhaut_zeta"
truth={json.loads(l)["id"]:json.loads(l) for l in open(f"{V}/val_truth.jsonl")}
gaps={}
for l in open(f"{F}/val_gaps_v5.jsonl"):
    d=json.loads(l); gaps[d["id"]]=(d["gap"],d["margin"])
lm={}
for l in open(f"{V}/val_v5_lm.jsonl"):
    d=json.loads(l); lm[d["id"]]=(d["base"],d["large"])
tri={}
for l in open(f"{F}/trigram_val_chosen_v3.jsonl"):
    d=json.loads(l); tri[d["id"]]=d
sents={}
for r in csv.DictReader(open(f"{V}/val_test.csv")): sents[int(r["id"])]=r["sentence"]
def medoid(P,mpb=0.03,depth=3,ml=4.57):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k: pool.add(w[:k])
    pool|={",","the","a","of","to","and","in","."}
    best=None
    for x in pool:
        e=sum(P[w]*L.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]: best=(e,x)
    return best[1]
IDS=[i for i in gaps if i>=5000]
END={".","!","?","...","\u2014","--"}
def run(casemode):
    tot=0;n=0;fixes=0;bad=0
    for i in IDS:
        g,m=gaps[i]; T=sents[i].split(" "); orig=truth[i]["orig"]; n+=1
        if m<0.35 or i not in lm:
            tot+=L.distance(sents[i],orig); continue
        base,large=lm[i]; P={}
        for w,lp in base[:20]: P[w]=P.get(w,0)+0.3*math.exp(lp)
        for w,lp in large[:20]: P[w]=P.get(w,0)+0.7*math.exp(lp)
        t=tri.get(i)
        if t and int(t.get("gap",-1))==g:
            dd={}
            for w,c in (t.get("tri") or []):
                if w and c>0: dd[w]=dd.get(w,0)+float(c)
            z=sum(dd.values()) or 1.0
            for w,v in dd.items(): P[w]=P.get(w,0)+0.3*v/z
        x=medoid(P)
        xx=x
        if casemode and x and x.isalpha() and len(x)>=2 and x==x.lower():
            prev=T[g-1]
            capA=any((tok.strip(string.punctuation)==x and tok!=tok.lower()) for tok in T)
            capB=(prev in END) or (prev.endswith(".") and prev!=".") or prev in {'``','\u201c'}
            if (casemode==1 and capA) or (casemode==2 and capB) or (casemode==3 and (capA or capB)):
                xx=x.capitalize()
        if xx!=x: fixes+=1
        c=L.distance(" ".join(T[:g]+[xx]+T[g:]),orig); tot+=c
        if c> L.distance(" ".join(T[:g]+[x]+T[g:]),orig): bad+=1
    return tot/n,fixes,bad
for m in [0,1,2,3]:
    met,fix,bad=run(m)
    print("casemode",m,"metric",round(met,5),"fixes",fix,"made_worse",bad,flush=True)
