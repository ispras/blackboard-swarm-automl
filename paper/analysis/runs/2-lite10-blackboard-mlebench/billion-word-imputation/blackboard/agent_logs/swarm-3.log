import json,csv,statistics
import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/betelgeuse_tau'
truth=[json.loads(l) for l in open(f'{BASE}/val_truth.jsonl')]
vt={int(r['id']):r['sentence'] for r in csv.DictReader(open(f'{BASE}/val_test.csv'))}
def run(probf, candf, th):
    probs={json.loads(l)['id']:json.loads(l) for l in open(probf)}
    cands={json.loads(l)['id']:json.loads(l) for l in open(candf)}
    tot=0; cov=0; acc=0
    for d in truth:
        i=d['id']; T=vt[i].split(' ')
        pr=probs[i]['gap_probs']
        g,p=max(pr,key=lambda x:x[1])
        noop=' '.join(T)
        c=cands[i]['cands']
        # dict gap->best word
        bw={}
        for gg,w,cnt in c:
            if gg not in bw: bw[gg]=w
        if p>=th and g in bw:
            pred=' '.join(T[:g]+[bw[g]]+T[g:]); cov+=1
        else:
            pred=noop
        tot+=Levenshtein.distance(d['orig'],pred); acc+=(g==d['gap'])
    return tot/len(truth),cov/len(truth),acc/len(truth)
print('using OLD 8M val file for threshold tuning')
for th in [0.4,0.5,0.55,0.6,0.65,0.7,0.75,0.8]:
    m,c,a=run('fomalhaut_gap_cands_val.jsonl','fomalhaut_gap_cands_val.jsonl',th)
    print('th %.2f total %.4f cov %.3f'%(th,m,c))
