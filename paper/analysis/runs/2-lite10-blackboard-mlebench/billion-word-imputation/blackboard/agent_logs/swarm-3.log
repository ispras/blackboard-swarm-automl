#!/usr/bin/env bash
# Container-версия bin/swarm.sh: запускается внутри job'а MLM как `mlm_run.sh`.
# Отличия от локальной версии:
#   * нет systemd (deadline-watcher и остановка — на sleep/kill);
#   * результаты (blackboard/, final_solution/ и workspaces/; последнее можно
#     отключить через --no-workspaces) выгружаются артефактами job'а,
#     забрать их можно через `mlm/swarm.sh pull`;
#   * оценка submission по-прежнему выполняется ТОЛЬКО на хосте (bin/grade.sh).
set -euo pipefail
shopt -s nullglob

# Контейнер по умолчанию в UTC, а доска/граф живут по MSK: имена SYSTEM-сообщений
# и штампы снапшотов должны быть в MSK. POSIX TZ-строка MSK-3 не требует tzdata.
export TZ="${SWARM_TZ:-MSK-3}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX="$ROOT/sandbox"
mkdir -p "$SANDBOX/blackboard/agent_logs"
cd "$SANDBOX"

AGENTS="${SWARM_AGENTS:-2}"
HOURS="${SWARM_HOURS:-4}"
MODEL="${SWARM_MODEL:-}"
PROMPT="${SWARM_PROMPT:-PROMPT.md}"
OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode)}"
LOGDIR="$SANDBOX/blackboard/agent_logs"
PORT="${SWARM_PORT:-4096}"
GPU_COUNT="${SWARM_GPUS:-1}"
WITH_WORKSPACES="${SWARM_ARTIFACT_WORKSPACES:-1}"
BOARD_INTERVAL="${SWARM_BOARD_INTERVAL:-300}"
ANALYSIS_DIR="$SANDBOX/analysis"
mkdir -p "$ANALYSIS_DIR"
# агент, завершившийся до hard_end, продолжается в своей opencode-сессии
RESUME_MESSAGE="${SWARM_RESUME_MESSAGE:-Continue work until hard end.}"
RESUME_DELAY="${SWARM_RESUME_DELAY:-15}"
RESUME_DELAY_MAX="${SWARM_RESUME_DELAY_MAX:-300}"

[ "$GPU_COUNT" -ge 1 ] 2>/dev/null || GPU_COUNT=1
[ -f "$PROMPT" ] || PROMPT="$SANDBOX/$PROMPT"
if [ ! -s "$PROMPT" ]; then
