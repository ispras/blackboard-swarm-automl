import json, math, time, os, csv, zipfile, io
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from collections import defaultdict
MODEL=os.environ.get('MODEL','roberta-large')
WHAT=os.environ.get('WHAT','test')
GAPF=os.environ['GAPF']
OUT='/download_job_code/payload/sandbox/workspaces/fomalhaut_zeta'
BASE='/download_job_code/payload/sandbox/workspaces/betelgeuse_tau'
t0=time.time()
gaps={}
for l in open(GAPF):
    d=json.loads(l); gaps[d['id']]=int(d['gap'])
if WHAT=='test':
    sents={}
    z=zipfile.ZipFile('/download_job_code/payload/sandbox/data/test_v2.txt.zip'); f=io.TextIOWrapper(z.open('test_v2.txt'),encoding='utf-8')
    r=csv.reader(f); next(r)
    for row in r: sents[int(row[0])]=row[1]
else:
    sents={int(r['id']):r['sentence'] for r in csv.DictReader(open(f'{BASE}/val_test.csv'))}
tok=AutoTokenizer.from_pretrained(MODEL, add_prefix_space=True)
model=AutoModelForMaskedLM.from_pretrained(MODEL).cuda().eval()
items=[]
for i,g in gaps.items():
    T=sents[i].split(' '); items.append((len(T)+1,i,T,g))
items.sort()
res={}; B=128
with torch.no_grad():
    for st in range(0,len(items),B):
        chunk=items[st:st+B]
        seqs=[it[2][:it[3]]+[tok.mask_token]+it[2][it[3]:] for it in chunk]
        enc0=tok(seqs,is_split_into_words=True,return_tensors='pt',padding=True,truncation=True,max_length=512)
        enc={k:v.cuda() for k,v in enc0.items()}
        out=model(**enc).logits
        mp=(enc['input_ids']==tok.mask_token_id).nonzero(as_tuple=False)
        posmap=defaultdict(list)
        for r,c in mp.tolist(): posmap[r].append(c)
        lp=torch.log_softmax(out,dim=-1)
        for j,it in enumerate(chunk):
            _,i,T,g=it
            if j not in posmap: res[i]=[]; continue
            c=posmap[j][0]; top=torch.topk(lp[j,c],25); words=[]
            for tid,val in zip(top.indices.tolist(),top.values.tolist()):
                w=tok.convert_ids_to_tokens(tid)
                if w in tok.all_special_tokens: continue
                w=w.replace('\u0120',' ').replace('\u010a',' ').replace('\u0109',' ').strip()
                if w: words.append([w,float(val)])
            res[i]=words
        if st%(B*40)==0: print('done',st,'/',len(items),'t=%.1f'%(time.time()-t0),flush=True)
fn=f'{OUT}/words_{MODEL.replace("/","_")}_{WHAT}.jsonl'
with open(fn,'w') as fo:
    for i,wp in res.items(): fo.write(json.dumps({'id':i,'gap':gaps[i],'words':wp})+'\n')
print('wrote',fn,'t=%.1f'%(time.time()-t0),flush=True)
