import json, math, statistics, time
import Levenshtein
O='/download_job_code/payload/sandbox/workspaces/fomalhaut_zeta'
B='/download_job_code/payload/sandbox/workspaces/betelgeuse_tau'
truth={json.loads(l)['id']:json.loads(l) for l in open(f'{B}/val_truth.jsonl')}
lm={json.loads(l)['id']:json.loads(l) for l in open(f'{O}/val_v5_lm.jsonl')}
tri={json.loads(l)['id']:json.loads(l)['tri'] for l in open(f'{O}/trigram_val_chosen_v3.jsonl')}
margin={json.loads(l)['id']:json.loads(l)['margin'] for l in open(f'{O}/val_gaps_v5.jsonl')}
t0=time.time()
cache={}
for i,d in lm.items():
    base=[(w,float(lp)) for w,lp in d['base'][:15] if w]
    large=[(w,float(lp)) for w,lp in d['large'][:15] if w]
    td={}
    for w,c in tri.get(i,[]):
        c=float(c)
        if w and c>0: td[w]=td.get(w,0)+c
    s=sum(td.values()) or 1.0
    tp={w:v/s for w,v in td.items()}
    g=d['gap']; T=[t for t in truth[i]['orig'].split(' ') if t]; tg=truth[i]['gap']
    ds0=T[:tg]+T[tg+1:]; noop=' '.join(ds0)
    cache[i]=(g,base,large,tp,ds0,truth[i]['orig'],margin[i],noop)
def make_P(base,large,tp,wb,wl,wt):
    P={}
    for w,lp in base: P[w]=P.get(w,0)+wb*math.exp(lp)
    for w,lp in large: P[w]=P.get(w,0)+wl*math.exp(lp)
    if wt>0:
        for w,p in tp.items(): P[w]=P.get(w,0)+wt*p
    return P
def medoid(P,pool,mpb):
    items=list(P.items()); best=None
    for x in pool:
        e=0.0
        for w,p in items: e+=p*Levenshtein.distance(x,w)
        e+=mpb*(len(x)+4.57)
        if best is None or e<best[0]: best=(e,x)
    return best[1]
POOL={}
def pool_for(P,depth):
    key=(tuple(sorted(P.keys())),depth)
    p=POOL.get(key)
    if p is None:
        s=set(P)|{',','the','a','of','to','and','in','.'}
        for w in P:
            for k in range(1,depth+1):
                if len(w)>k: s.add(w[:k])
        p=list(s); POOL[key]=p
    return p
def run(ids,wb,wl,wt,mpb,depth,thr):
    tot=0.0
    for i in ids:
        g,base,large,tp,ds0,orig,mg,noop=cache[i]
        if mg<thr: tot+=Levenshtein.distance(orig,noop); continue
        P=make_P(base,large,tp,wb,wl,wt)
        pool=pool_for(P,depth)
        x=medoid(P,pool,mpb)
        tot+=Levenshtein.distance(orig,' '.join(ds0[:g]+([x] if x else [])+ds0[g:]))
    return tot/len(ids)
ids=sorted(cache); tr=[i for i in ids if i<5000]; ev=[i for i in ids if i>=5000]
results=[]
for wb,wl in [(0.3,0.7),(0.4,0.6),(0.2,0.8),(0.5,0.5)]:
    for wt in [0.2,0.3,0.4]:
        for mpb in [0.02,0.03,0.05]:
            m=run(tr,wb,wl,wt,mpb,3,0.35)
            results.append((m,wb,wl,wt,mpb))
results.sort()
print('top on train:')
for r in results[:8]: print('  %.4f wb=%.1f wl=%.1f wt=%.1f mpb=%.2f'%r,flush=True)
print('--- held-out for top configs ---',flush=True)
for m,wb,wl,wt,mpb in results[:5]:
    for thr in [0.30,0.35,0.40]:
        print('  train=%.4f wb=%.1f wl=%.1f wt=%.1f mpb=%.2f thr=%.2f -> HELD %.4f'%(m,wb,wl,wt,mpb,thr,run(ev,wb,wl,wt,mpb,3,thr)),flush=True)
