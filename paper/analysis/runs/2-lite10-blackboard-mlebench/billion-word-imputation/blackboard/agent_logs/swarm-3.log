# policy evaluation helpers
def medoid(P, mpb=0.2, mean_len=4.57):
    ws=list(P); pool=set(ws)
    for w in ws:
        for k in (1,2,3):
            if len(w)>k: pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+mean_len)
        if best is None or e<best[0]: best=(e,x)
    return best[1]
def eval_policy(te_ids, alpha, mpb, th):
    ds=[]
    for i in te_ids:
        T,gaps,Z,pred=cache[i]; P=dat[i]
        P1=max(P.values()) if P else 0.0
        g1=max(P,key=P.get) if P else None
        if g1 is None or P1<th:
            ds.append(Levenshtein.distance(truth[i]['orig'],' '.join(T))); continue
        d=pred.get(str(g1)) or {}
        pairs=[(w,lp) for w,lp in zip(d.get('w',[]),d.get('lp',[])) if w]
        Pw={}
        for w,lp in pairs: Pw[w]=Pw.get(w,0)+math.exp(lp)
        # fomalhaut trigram words at g1 (val file old has cands) -- optional
        try:
            oc=fom_cands.get(i)
            if oc:
                for it in (oc.get('cands') or []):
                    gg,w,c=int(it[0]),str(it[1]),float(it[2])
                    if gg==g1 and w and c>0: Pw[w]=Pw.get(w,0)+alpha*(c)
        except NameError:
            pass
        if not Pw:
            ds.append(Levenshtein.distance(truth[i]['orig'],' '.join(T))); continue
        # normalize fom contribution shape (counts) -> scale relative to mlm
        tot_mlm=sum(math.exp(lp) for _,lp in pairs) or 1.0
        # rebuild properly if fom present
        x=medoid(Pw,mpb)
        ds.append(Levenshtein.distance(truth[i]['orig'],' '.join(T[:g1]+([x] if x else [])+T[g1:])))
    return statistics.mean(ds)
