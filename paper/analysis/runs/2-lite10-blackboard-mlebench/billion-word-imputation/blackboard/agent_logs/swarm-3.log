import json, math, statistics
import Levenshtein
truth={json.loads(l)['id']:json.loads(l) for l in open('val_truth.jsonl')}
lm={}
for l in open('val_lm_true.jsonl'):
    o=json.loads(l); lm[o['id']]=o
fomc={}
for l in open('../fomalhaut_zeta/fomalhaut_gap_cands_val.jsonl'):
    o=json.loads(l); fomc[o['id']]=o
def fw_at(i,g):
    d={}
    for it in (fomc.get(i,{}).get('cands') or []):
        gg,w,c=int(it[0]),str(it[1]),float(it[2])
        if gg==g and w and c>0: d[w]=d.get(w,0)+c
    z=sum(d.values()) or 1
    return {w:v/z for w,v in d.items()}
def medoid(P,mpb=0.05,ml=4.57,depth=3):
    ws=list(P);pool=set(ws)
    for w in ws:
        for k in range(1,depth+1):
            if len(w)>k:pool.add(w[:k])
    pool|={',','the','a','of','to','and','in','.'}
    best=None
    for x in pool:
        e=sum(P[w]*Levenshtein.distance(x,w) for w in ws)+mpb*(len(x)+ml)
        if best is None or e<best[0]:best=(e,x)
    return best[1]
def cost(i,x):
    d=truth[i];T=[t for t in d['orig'].split(' ') if t];g=d['gap']
    ds=T[:g]+T[g+1:]
    return Levenshtein.distance(d['orig'],' '.join(ds[:g]+([x] if x else [])+ds[g:]))
ids=[i for i in lm if i in truth]
for alpha in [0.0,0.2,0.4,0.7]:
    for mpb in [0.03,0.05,0.1,0.2]:
        ds=[]
        for i in ids:
