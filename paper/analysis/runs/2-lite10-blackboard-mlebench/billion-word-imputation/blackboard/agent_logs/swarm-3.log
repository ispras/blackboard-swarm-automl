    if len(toks)<3: continue
    interior=toks[1:-1]
    c.update(interior); tot_tok+=len(interior)
    senthashes[hash(s)]+=1
    if len(sample)<300000: sample.append(s)
    n+=1
    if n>=1000000: break
print('sents',n,'interior tokens',tot_tok)
print('top missing-word distribution:')
for w,k in c.most_common(30): print(f'  {w!r}: {k/tot_tok:.4f}')
# duplicate rate among first 300k sentences
dups=sum(v-1 for v in senthashes.values() if v>1)
print('dup extra among sampled range',dups,'/',n)
vals=list(senthashes.values())
print('unique',len(senthashes),'maxcount',max(vals))
