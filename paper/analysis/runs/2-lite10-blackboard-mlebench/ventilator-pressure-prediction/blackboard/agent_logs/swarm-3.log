p=0
for k,w in wi.items():
    a=np.load(paths[k]); a=a[i0] if a.shape[0]==67905 else a; p=p+w*a
base=np.abs(p-y0)[insp].mean()
rng=np.random.RandomState(0); half=rng.rand(len(i0))<0.5
q=p.copy()
for h in [0,1]:
