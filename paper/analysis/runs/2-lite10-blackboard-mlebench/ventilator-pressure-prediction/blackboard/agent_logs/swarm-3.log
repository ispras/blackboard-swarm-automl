import numpy as np, pandas as pd
d=np.load("workspaces/shared/ventilator_v1.npz", allow_pickle=True)
y=d["y_train"]; uout=d["u_out_train"]; X=d["X_train"]; bid=d["breath_id_train"]; fn=list(d["feature_names"])
folds=pd.read_csv("workspaces/shared/folds.csv"); fmap=dict(zip(folds.breath_id,folds.fold)); fo=np.array([fmap[b] for b in bid])
idx0=np.where(fo==0)[0]; p=np.load("workspaces/canopus_iota/oof_lstm384.npy")[idx0]
y0=y[idx0]; m=(uout[idx0]<0.5)
R=(X[idx0,:,fn.index("R_is5")]*5+X[idx0,:,fn.index("R_is20")]*20+X[idx0,:,fn.index("R_is50")]*50).astype(int)
C=(X[idx0,:,fn.index("C_is10")]*10+X[idx0,:,fn.index("C_is20")]*20+X[idx0,:,fn.index("C_is50")]*50).astype(int)
rng=np.random.RandomState(0); half=rng.rand(len(idx0))<0.5
base=np.abs(p-y0)[m].mean()
def cv_shift(kind):
  q=p.copy()
  if kind=="global":
    for h in [0,1]:
      tr=(~half if h==0 else half); key=slice(None)
      sh=np.median((y0-p)[tr][m[tr]])
      q[h==half]=p[h==half]+sh
  elif kind=="step":
    st=np.arange(80)[None,:]
    for h in [0,1]:
      tr=(~half if h==0 else half); te=(half if h==0 else ~half)
      for s in range(32):
        mm=tr&(st[0]==s)&m if False else None
      # do vectorized per step
      for s in range(32):
        trm=tr&(st==s)&m; tem=te&(st==s)&m
        sh=np.median((y0-p)[trm]); q[tem]=p[tem]+sh
  elif kind=="stepRC":
    st=np.arange(80)[None,:]
    for h in [0,1]:
      tr=(~half if h==0 else half); te=(half if h==0 else ~half)
      for r in [5,20,50]:
        for c in [10,20,50]:
          for s in range(32):
            trm=tr&(st==s)&(R==r)&(C==c)&m; tem=te&(st==s)&(R==r)&(C==c)&m
            if trm.sum()<200: continue
            sh=np.median((y0-p)[trm]); q[tem]=p[tem]+sh
  return q
for kind in ["global","step","stepRC"]:
  q=cv_shift(kind); print(kind,"CV-half insp MAE",np.abs(q-y0)[m].mean(),"vs base",base)
# in-sample oracle shift
q=p.copy(); st=np.arange(80)[None,:]
for s in range(32):
  trm=(st==s)&m; q[trm]=p[trm]+np.median((y0-p)[trm])
print("in-sample per-step", np.abs(q-y0)[m].mean())
