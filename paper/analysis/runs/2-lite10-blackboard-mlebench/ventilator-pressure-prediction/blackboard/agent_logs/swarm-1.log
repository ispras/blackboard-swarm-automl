import numpy as np,pandas as pd,hashlib
tr=pd.read_csv("../../data/train.csv",usecols=["breath_id","R","C","u_in","pressure"])
te=pd.read_csv("../../data/test.csv",usecols=["breath_id","R","C","u_in"])
def sig(df):
    a=df.sort_values(["breath_id"]).groupby("breath_id")[["R","C","u_in"]].apply(lambda x: hashlib.md5(np.round(x.values.astype(np.float64),4).tobytes()).hexdigest())
    return a
str_=sig(tr); ste=sig(te)
print("train unique",str_.nunique(),"of",len(str_),"test unique",ste.nunique(),"of",len(ste))
print("test sig in train",ste.isin(set(str_)).mean())
# rounded u_in only
def sig2(df):
    return df.groupby("breath_id").apply(lambda x: hashlib.md5(np.round(x.sort_values("breath_id")["u_in"].values,3).tobytes()).hexdigest())
