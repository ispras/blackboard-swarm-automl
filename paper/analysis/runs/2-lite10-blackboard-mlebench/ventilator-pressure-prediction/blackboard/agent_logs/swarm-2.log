def sc(pp,ii): 
    d=np.abs(pp[ii]-yy[ii]); return (d*mm[ii]).sum()/mm[ii].sum()
rng=np.random.RandomState(1);perm=rng.permutation(len(f0));h1,h2=perm[:len(f0)//2],perm[len(f0)//2:]
def fit_bias_perstep(ii):
    num=((p[ii]-yy[ii])*mm[ii]).sum(0); den=mm[ii].sum(0); return num/np.where(den>0,den,1)
def fit_bias_group(ii):
    out={}
    for r in [5,20,50]:
      for c in [10,20,50]:
        s=(R[ii]==r)&(Cc[ii]==c)
        if s.sum(): out[(r,c)]=((p[ii][s]-yy[ii][s])*mm[ii][s]).sum()/mm[ii][s].sum()
    return out
def apply_group(ii,b):
    q=p[ii].copy()
    for (r,c),v in b.items():
        s=(R[ii]==r)&(Cc[ii]==c); q[s]-=v
    return q
for a,b,na,nb in [(h1,h2,"h1->h2","h2"),(h2,h1,"h2->h1","h1")]:
    print(na,"base",round(sc(p,b),4))
