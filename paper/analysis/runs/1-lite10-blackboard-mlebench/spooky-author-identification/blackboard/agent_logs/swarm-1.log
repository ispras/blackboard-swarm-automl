+def greedy(oofs, y, geo=False, iters=60):
+    n = len(oofs)
+    P = [np.log(norm(o)) if geo else norm(o) for o in oofs]
+    counts = np.zeros(n)
+    s = None
+    for t in range(iters):
+        best = (1e9, -1)
+        for i in range(n):
+            cand = P[i] if s is None else s + P[i]
+            if geo:
+                z = cand - cand.max(1, keepdims=True)
+                e = np.exp(z); p = e / e.sum(1, keepdims=True)
+            else:
+                p = cand / (t + 1)
+            ll = logloss(y, p)
+            if ll < best[0]:
+                best = (ll, i)
+        i = best[1]
+        s = P[i] if s is None else s + P[i]
+        counts[i] += 1
+    w = counts / counts.sum()
+    return w, best[0]
+
+
