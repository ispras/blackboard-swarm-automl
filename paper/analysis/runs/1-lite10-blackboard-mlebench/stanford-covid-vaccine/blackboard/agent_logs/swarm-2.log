+    A = np.vstack([Xn, np.sqrt(alpha) * np.eye(m)])
+    b = np.concatenate([y, np.zeros(m)])
+    res = lsq_linear(A, b, bounds=(0.0, np.inf), max_iter=500, tol=1e-8)
