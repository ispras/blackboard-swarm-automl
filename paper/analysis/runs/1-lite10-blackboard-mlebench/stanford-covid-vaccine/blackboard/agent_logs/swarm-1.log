        else: assign[i]=len(reps); reps.append(i)
    return assign
for thr in [0.6,0.7]:
    g=cluster(seqs,thr)
    sizes=np.bincount(g)
    order=np.argsort(-sizes)
    fold_of_group=np.zeros(len(sizes),dtype=int); load=np.zeros(5,dtype=int)
    for gr in order:
        f=np.argmin(load); fold_of_group[gr]=f; load[f]+=sizes[gr]
    folds=np.zeros(len(tr),dtype=int)
    folds[idx]=fold_of_group[g]
    np.save(f'runs/grp{int(thr*10)}_folds.npy',folds)
    cnt=np.bincount(folds[idx])
    print(f'thr{thr} groups={len(sizes)} fold sample counts {cnt}')
