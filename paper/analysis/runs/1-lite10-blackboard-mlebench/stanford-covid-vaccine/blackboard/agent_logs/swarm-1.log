import numpy as np, sys
from sklearn.model_selection import GroupKFold
sys.path.insert(0,'.')
from data_utils import load_data
tr,te=load_data()
sn=np.array([r['SN_filter'] for r in tr])
idx=np.where(sn==1)[0]
seqs=np.array([list(tr[i]['sequence']) for i in idx])
def cluster(seqs, thr):
    reps=[]; assign=np.zeros(len(seqs),dtype=int)
    for i,a in enumerate(seqs):
        best=-1; bj=-1
        for j,r in enumerate(reps):
            sim=(a==seqs[r]).mean()
            if sim>best: best=sim; bj=j
        if best>=thr: assign[i]=bj
        else: assign[i]=len(reps); reps.append(i)
    return assign
for thr in [0.6,0.7]:
    g=cluster(seqs,thr)
    folds=np.full(len(tr),-1,dtype=int)
    gkf=GroupKFold(5)
    for k,(_,va) in enumerate(gkf.split(idx,groups=g)):
        folds[idx[va]]=k
    # assign any unassigned (shouldn't be) 
    folds[folds<0]=0
    np.save(f'runs/grp{int(thr*10)}_folds.npy',folds)
    print(f'thr{thr} saved, groups={len(np.unique(g))}, fold counts',np.bincount(folds[folds>=0]))
