import glob, os, subprocess, hashlib, time

ROOT = "/download_job_code/payload/sandbox"
os.chdir(ROOT)


def pairs():
    out = []
    for o in glob.glob("workspaces/*/runs/*/oof.npy") + glob.glob("workspaces/*/preds/*/oof.npy"):
        out.append((o, os.path.join(os.path.dirname(o), "test.npy"),
                    os.path.basename(os.path.dirname(o))))
    for o in glob.glob("workspaces/*/runs/*_oof.npy") + glob.glob("workspaces/*/preds/*_oof.npy"):
        base = o[:-len("_oof.npy")]
        out.append((o, base + "_test.npy", os.path.basename(base)))
    return out


def signature():
    items = []
    for o, t, tag in pairs():
        low = tag.lower()
        if any(s in low for s in ("mask", "blend", "final", "fold", "oof")):
            continue
        if os.path.exists(o) and os.path.exists(t):
            items.append((o, round(os.path.getmtime(o)), round(os.path.getmtime(t))))
    items.sort()
    return hashlib.md5(repr(items).encode()).hexdigest(), len(items)


if __name__ == "__main__":
    last = None
    while True:
        h, n = signature()
        if h != last:
            print(f"[watch] change detected ({n} candidates), re-blending", flush=True)
            r = subprocess.run("pyenv shell sis-black && OMP_NUM_THREADS=4 python -u "
                               "workspaces/mirfak_zeta/ensemble.py && "
                               "python -u workspaces/mirfak_zeta/make_submission.py",
                               shell=True, executable="/bin/bash",
                               capture_output=True, text=True)
            print(r.stdout[-1500:], flush=True)
            if r.returncode != 0:
                print("ERR", r.stderr[-1500:], flush=True)
            last = h
        time.sleep(120)
