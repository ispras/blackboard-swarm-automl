+def build_err_weights(df, eps=0.05):
+    N = len(df)
+    W = np.zeros((N, 107), dtype=np.float32)
+    cols = ['reactivity_error', 'deg_error_Mg_pH10', 'deg_error_pH10',
+            'deg_error_Mg_50C', 'deg_error_50C']
+    for i, r in enumerate(df):
+        ss = r['seq_scored']
+        errs = np.stack([np.asarray(r[c]) for c in cols], 1)
+        v = (errs ** 2).mean(1)
+        W[i, :ss] = 1.0 / (v + eps)
+    return W
+
+
 def mcrmse(y_true, y_pred, mask):
     # y_true (N,L,5), y_pred same, mask (N,L)
