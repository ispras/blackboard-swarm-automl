import numpy as np, sys
sys.path.insert(0,'.')
from data_utils import load_data
tr,te=load_data()
sn=np.array([r['SN_filter'] for r in tr])
idx=np.where(sn==1)[0]
seqs=np.array([list(tr[i]['sequence']) for i in idx])
N=len(seqs)
# leader clustering at threshold
def cluster(seqs, thr):
    reps=[]; assign=np.zeros(len(seqs),dtype=int)
    for i,a in enumerate(seqs):
        best=-1; bj=-1
        for j,r in enumerate(reps):
            sim=(a==seqs[r]).mean()
            if sim>best: best=sim; bj=j
        if best>=thr:
            assign[i]=bj
        else:
            assign[i]=len(reps); reps.append(i)
    return assign, np.array(reps)
for thr in [0.5,0.6,0.7,0.8]:
    assign,reps=cluster(seqs,thr)
    sizes=np.bincount(assign)
    print(f'thr={thr}: clusters={len(reps)} max_size={sizes.max()} singletons={(sizes==1).sum()}')
np.save('runs/grp50.npy', cluster(seqs,0.5)[0])
np.save('runs/grp70.npy', cluster(seqs,0.7)[0])
# also test vs train clusters
