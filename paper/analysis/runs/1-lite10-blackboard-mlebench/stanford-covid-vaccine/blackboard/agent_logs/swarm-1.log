+class CNNBiGRU(nn.Module):
+    def __init__(self, in_ch=14, hidden=256, lstm_hidden=128, n_conv=4,
+                 n_lstm=2, dropout=0.3, out=5, **kw):
+        super().__init__()
+        self.stem = nn.Sequential(
+            nn.Conv1d(in_ch, hidden, 5, padding=2),
+            nn.BatchNorm1d(hidden), nn.GELU())
+        self.blocks = nn.Sequential(*[
+            ResidualConvBlock(hidden, k=5, dil=2 ** (i % 3), dropout=dropout)
+            for i in range(n_conv)])
+        self.gru = nn.GRU(hidden, lstm_hidden, num_layers=n_lstm,
+                          batch_first=True, bidirectional=True,
+                          dropout=dropout if n_lstm > 1 else 0.0)
+        self.head = nn.Sequential(
+            nn.Linear(2 * lstm_hidden, 256), nn.GELU(),
+            nn.Dropout(dropout), nn.Linear(256, out))
+
+    def forward(self, x):
+        h = self.stem(x)
+        h = self.blocks(h).permute(0, 2, 1)
+        h, _ = self.gru(h)
+        return self.head(h)
+
+
