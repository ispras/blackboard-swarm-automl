+def pair_dist(struct):
+    n = len(struct)
+    d = np.zeros(n, dtype=np.float32)
+    stack = []
+    for i, c in enumerate(struct):
+        if c == "(":
+            stack.append(i)
+        elif c == ")" and stack:
+            j = stack.pop()
+            d[i] = i - j
+            d[j] = i - j
+    return d / max(n, 1)
+
+
