import json, numpy as np
from collections import Counter
def L(p): return [json.loads(l) for l in open(p) if l.strip()]
tr=L('data/train.json'); te=L('data/test.json')
def freq(rows):
    c=Counter(); 
    for r in rows: c.update(r['sequence'])
    n=sum(c.values()); return {k:round(v/n,4) for k,v in sorted(c.items())}
print('train freq',freq(tr))
print('test  freq',freq(te))
# loop type dist
def loopfreq(rows):
    c=Counter()
    for r in rows: c.update(r['predicted_loop_type'])
    n=sum(c.values()); return {k:round(v/n,3) for k,v in sorted(c.items())}
print('train loop',loopfreq(tr))
print('test  loop',loopfreq(te))
# target means clean
T=["reactivity","deg_Mg_pH10","deg_pH10","deg_Mg_50C","deg_50C"]
cl=[r for r in tr if r['SN_filter']==1]
for t in T:
    v=np.concatenate([np.array(r[t])[:68] for r in cl])
    print('clean',t,round(v.mean(),3),round(v.std(),3))
