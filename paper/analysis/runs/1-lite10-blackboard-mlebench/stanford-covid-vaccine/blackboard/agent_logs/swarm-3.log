# per-target overall
true_all=np.stack([np.stack([np.array(tr[i][t]) for t in TARGETS],1) for i in range(len(tr))],0)
for j,t in enumerate(TARGETS):
    se=((oof[:,:,j]-true_all[:,:,j])**2).mean()
    print(t, round(np.sqrt(se),4))
