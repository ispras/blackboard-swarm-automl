# check target ranges
for k in ['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']:
    v=np.concatenate([x[k] for x in tr])
    print(k, round(v.mean(),3), round(v.std(),3), round(v.min(),2), round(v.max(),2))
