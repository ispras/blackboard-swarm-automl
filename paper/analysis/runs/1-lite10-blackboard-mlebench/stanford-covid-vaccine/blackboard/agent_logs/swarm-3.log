+class TCNBlock(nn.Module):
+    def __init__(self, ch, k, dil, dropout):
+        super().__init__()
+        self.conv = nn.Conv1d(ch, ch, k, padding=dil * (k - 1) // 2, dilation=dil)
+        self.ln = nn.GroupNorm(1, ch)
+        self.drop = nn.Dropout(dropout)
+        self.act = nn.ReLU()
+
+    def forward(self, x):
+        h = self.conv(x)
+        h = self.ln(h)
+        h = self.act(h)
+        h = self.drop(h)
+        return x + h
+
+
+class NetTCN(nn.Module):
+    def __init__(self, hidden=256, layers=2, dropout=0.3, width=128, in_ch=15):
+        super().__init__()
+        self.inp = nn.Conv1d(in_ch, width, 5, padding=2)
+        self.blocks = nn.Sequential(*[TCNBlock(width, 5, 2 ** i if 2 ** i <= 16 else 16, dropout)
+                                      for i in range(6)])
+        self.lstm = nn.GRU(width, hidden, layers, batch_first=True, bidirectional=True,
+                           dropout=dropout if layers > 1 else 0.0)
+        self.drop = nn.Dropout(dropout)
+        self.head = nn.Linear(hidden * 2, 5)
+
+    def forward(self, x):
+        h = x.transpose(1, 2)
+        h = self.inp(h)
+        h = self.blocks(h)
+        h = h.transpose(1, 2)
+        h, _ = self.lstm(h)
+        h = self.drop(h)
+        return self.head(h)
+
+
 class NetCNN(nn.Module):
     """Multi-scale CNN stem (inception-like) + BiGRU."""
     def __init__(self, hidden=192, layers=2, dropout=0.3, width=128, in_ch=15):
         super().__init__()

