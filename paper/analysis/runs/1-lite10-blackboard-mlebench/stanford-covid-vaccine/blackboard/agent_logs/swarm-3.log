@@ -102,8 +102,35 @@
         h = self.drop(h)
         return self.head(h)
 
 
+class NetCNN(nn.Module):
+    """Multi-scale CNN stem (inception-like) + BiGRU."""
+    def __init__(self, hidden=192, layers=2, dropout=0.3, width=128):
+        super().__init__()
+        self.branches = nn.ModuleList([
+            nn.Conv1d(15, width // 4, k, padding=k // 2) for k in (3, 5, 7, 9)
+        ])
+        self.drop0 = nn.Dropout(dropout)
+        self.conv2 = nn.Sequential(
+            nn.Conv1d(width, width, 5, padding=2), nn.ReLU(), nn.Dropout(dropout),
+            nn.Conv1d(width, width, 5, padding=2), nn.ReLU())
+        self.gru = nn.GRU(width, hidden, layers, batch_first=True,
+                          bidirectional=True, dropout=dropout if layers > 1 else 0.0)
+        self.drop = nn.Dropout(dropout)
+        self.head = nn.Linear(hidden * 2, 5)
+
+    def forward(self, x):
+        h = x.transpose(1, 2)  # (B,15,L)
+        h = torch.cat([b(h) for b in self.branches], 1)
+        h = self.drop0(h)
+        h = self.conv2(h)
+        h = h.transpose(1, 2)  # (B,L,C)
+        h, _ = self.gru(h)
