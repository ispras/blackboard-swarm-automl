+def discover():
+    import glob
+    oof_files = []
+    for pat in ["workspaces/*/runs/*_oof.npy", "workspaces/*/preds/*_oof.npy",
+                "workspaces/*/runs/*/oof.npy"]:
+        oof_files += glob.glob(os.path.join(ROOT, pat))
+    specs = []
+    for op in sorted(oof_files):
+        base = os.path.basename(op)
+        if base.startswith(("blend", "final_", "knn")):
+            continue
+        if "_fold0" in base:
+            continue
+        dp = os.path.dirname(op)
+        if base.endswith("_oof.npy"):
+            tp = op.replace("_oof.npy", "_test.npy")
+            name = base.replace("_oof.npy", "")
+        else:
+            tp = os.path.join(dp, "test.npy")
+            name = os.path.basename(dp)
+        if not os.path.exists(tp):
+            continue
+        try:
+            o = np.load(op, mmap_mode="r")
+        except Exception:
+            continue
+        if o.shape != (2160, 107, 5):
+            continue
+        try:
+            t = np.load(tp, mmap_mode="r")
+        except Exception:
+            continue
+        if t.shape != (240, 107, 5):
+            continue
+        valid = np.isfinite(o[:, :68, :]).all(axis=2).sum()
+        if valid < 1500:
+            continue
+        specs.append(f"{name}::{op}::{tp}")
+    return specs
+
+
