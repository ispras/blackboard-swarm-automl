TARGETS=["reactivity","deg_Mg_pH10","deg_pH10","deg_Mg_50C","deg_50C"]
from sklearn.model_selection import KFold
kf=KFold(5,shuffle=True,random_state=42)
splits=list(kf.split(tr))
def mcrmse(p,t): 
    se=((p-t)**2).mean(1); return float(np.sqrt(se[[0,1,3]]).mean())
for f,(tri,vai) in enumerate(splits):
    true=np.stack([np.stack([np.array(tr[i][t]) for t in TARGETS],1) for i in vai],0)
    # sample weights: only seq_scored
