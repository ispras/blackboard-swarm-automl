+def nnls_loop_weights(oofs, rows):
+    M = len(oofs)
+    nlt = len(LOOPC) + 1
+    W = np.zeros((nlt, 5, M))
+    for lt in range(nlt):
+        m = (LOOPID[rows] == lt)
+        if m.sum() == 0:
+            continue
+        for t in range(5):
+            A = np.stack([o[rows][:, :68, t][m] for o in oofs], 1)
+            b = Y[rows][:, :68, t][m]
+            A = np.nan_to_num(A)
+            b = np.nan_to_num(b)
+            w, _ = nnls(A, b)
+            W[lt, t] = w
+    return W
+
+
+def apply_nnls_loop(oofs, W, rows):
+    nlt = W.shape[0]
+    out = np.zeros((len(rows), 107, 5))
+    for t in range(5):
+        base = np.stack([o[rows][:, :68, t] for o in oofs], 0)  # (M,N,68)
+        for lt in range(nlt):
+            m = (LOOPID[rows] == lt)
+            if m.sum() == 0:
+                continue
+            blend = np.tensordot(W[lt, t], base, axes=(0, 0))  # (N,68)
+            out[:, :68, t][m] = blend[m]
+        out[:, 68:, t] = np.mean([o[rows][:, 68:, t] for o in oofs], 0)
+    return out
+
+
