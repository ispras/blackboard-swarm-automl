import os, numpy as np, pandas as pd, cv2, torch
from torch.utils.data import Dataset, DataLoader
from torch.cuda.amp import autocast
import timm
cv2.setNumThreads(0); ROOT="/download_job_code/payload/sandbox"
BASE=torch.tensor([0.485,0.456,0.406]).view(3,1,1).float().cuda()
SIG=torch.tensor([0.229,0.224,0.225]).view(3,1,1).float().cuda()
df=pd.read_csv(f"{ROOT}/workspaces/shared/folds5_seed42.csv")
va=df[df.fold==0].reset_index(drop=True); y=va.label.values
class DS(Dataset):
    def __init__(s,df,size): s.df=df.reset_index(drop=True); s.size=size
    def __len__(s): return len(s.df)
    def __getitem__(s,i):
        r=s.df.iloc[i]; img=cv2.imread(f"{ROOT}/data/train_images/{r.image_id}"); img=cv2.cvtColor(img,cv2.COLOR_BGR2RGB)
        t=torch.from_numpy(img).permute(2,0,1).float()/255.
        return t, int(r.label)
def norm(t): return (t-BASE)/SIG
def crop5(x,size):
    n=x.shape[-1]
    if n!=size: x=torch.nn.functional.interpolate(x,size=(size,size),mode='bilinear',align_corners=False)
    m=size-size  # 0
    # 5 crops from a size*1.25 resize
    return x
@torch.no_grad()
def run(backbone,ck,size=384,bs=24):
    m=timm.create_model(backbone,pretrained=False,num_classes=5).cuda(); m.load_state_dict(torch.load(ck,map_location='cuda')); m.eval()
    dl=DataLoader(DS(va,size),batch_size=bs,shuffle=False,num_workers=6)
    acc=[]
    for x,yb in dl:
        x=x.cuda()
        # A: resize to size*1.14 then center crop size
        xa=torch.nn.functional.interpolate(x,size=(int(size*1.14),int(size*1.14)),mode='bilinear',align_corners=False)
        o=(int(size*1.14)-size)//2
        xa=xa[:,:,o:o+size,o:o+size]
        # B: resize to size*1.25 then 5 crops size, each hflip
        xb=torch.nn.functional.interpolate(x,size=(int(size*1.25),int(size*1.25)),mode='bilinear',align_corners=False)
        n=int(size*1.25); m2=n-size
        offs=[(m2//2,m2//2),(0,0),(0,m2),(m2,0),(m2,m2)]
        with autocast():
            la=0
            for v in [xa,torch.flip(xa,[3]),torch.flip(xa,[2])]: la=la+m(norm(v))
            la=la.float().softmax(1)
            lb=0
            for (i,j) in offs:
                c=xb[:,:,i:i+size,j:j+size]
                lb=lb+m(norm(c))+m(norm(torch.flip(c,[3])))
            lb=lb.float().softmax(1)
        acc.append((la.cpu(),lb.cpu()))
    A=torch.cat([a for a,_ in acc]).numpy(); B=torch.cat([b for _,b in acc]).numpy()
    C=(A/3+B/10)/2
    print(f"{backbone.split('.')[0]:24s} A(cur)={ (A.argmax(1)==y).mean():.4f} B(5crop)={(B.argmax(1)==y).mean():.4f} C(blend)={(C.argmax(1)==y).mean():.4f} agree(A,B)={(A.argmax(1)==B.argmax(1)).mean():.4f}")
run('convnext_small.fb_in22k_ft_in1k','workspaces/achernar_delta/cvnx_s384/f0_best.pt')
run('convnext_small.fb_in22k_ft_in1k','workspaces/achernar_delta/cvnx_mix/f0_best.pt')
EOF
