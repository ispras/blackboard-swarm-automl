    v=load_val(vp, vp.replace('val_probs','val_idx'))
    if v is None: print('MISS val',k); continue
    names.append(k); T.append(t.astype(np.float64)); V.append(v)
    print(f'{k:24s} val0={np.mean(v.argmax(1)==y0):.4f}')
T=np.stack(T,0); V=np.stack(V,0)
def geom(P): return np.exp(np.log(P+1e-9).mean(0))
print('\nALL equal-geom fold0:', round(float(np.mean(geom(V).argmax(1)==y0)),4))
# greedy forward selection by equal-geom on fold0
sel=[]; 
def score(idxs): return float(np.mean(geom(V[list(idxs)]).argmax(1)==y0))
best_glob=0
while True:
    cand=None;bsc=best_glob
    for j in range(len(names)):
        if j in sel: continue
        s=score(sel+[j])
        if s>bsc: bsc=s;cand=j
    if cand is None: break
    sel.append(cand);best_glob=bsc
    print('add',names[cand],'->',round(bsc,4))
print('selected',[names[j] for j in sel])
# leave-one-out from ALL
for j in range(len(names)):
    rest=[k for k in range(len(names)) if k!=j]
    print(f'drop {names[j]:24s} -> {score(rest):.4f}')
