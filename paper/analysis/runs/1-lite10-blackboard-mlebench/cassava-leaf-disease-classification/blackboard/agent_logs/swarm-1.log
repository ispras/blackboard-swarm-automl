import numpy as np, pandas as pd, os
from scipy.stats import mode
df=pd.read_csv('workspaces/shared/folds5_seed42.csv')
f0idx=np.where(df.fold.values==0)[0]; y0=df.label.values[f0idx]; pos={v:i for i,v in enumerate(f0idx)}
def lv(p):
    v=np.load(p)
    if v.shape[0]==len(f0idx): return v.astype(np.float64)
    ip=p.replace('val_probs','val_idx')
    if os.path.exists(ip):
        idx=np.load(ip).astype(int); o=np.zeros((len(f0idx),5))
        for k,orig in enumerate(idx):
            if int(orig) in pos: o[pos[int(orig)]]=v[k]
        return o
    return None
R='workspaces/'
files=[R+'achernar_delta/cvnx_mix/val0_convnext_v2.npy',R+'capella_kappa/infer_swin/val_probs.npy',R+'capella_kappa/infer_swin_mix/val_probs.npy',R+'capella_kappa/infer_vit/val_probs.npy',R+'capella_kappa/infer_vit_mix/val_probs.npy',R+'capella_kappa/infer_beit_mix/val_probs.npy',R+'capella_kappa/infer_xcit_mix/val_probs.npy',R+'arcturus_kappa/runs/v2s_mix/val0_v2s_mix.npy',R+'arcturus_kappa/runs/v2m_480/f0_val_probs.npy',R+'arcturus_kappa/runs/cvnxb_384/f0_val_probs.npy',R+'arcturus_kappa/runs/effb4_512/f0_val_probs.npy']
V=np.stack([lv(p) for p in files],0)
def acc(pred): return float(np.mean(pred==y0))
ar=V.mean(0); ge=np.exp(np.log(V+1e-9).mean(0))
print('arith   ',round(acc(ar.argmax(1)),4))
print('geom    ',round(acc(ge.argmax(1)),4))
# majority vote
votes=np.stack([v.argmax(1) for v in V],0)  # M,n
mv=mode(votes,axis=0,keepdims=False).mode
print('majority',round(acc(mv),4))
# logit mean of log-probs == geom (same argmax) so skip
# power mean p=0.5
pm=(V**0.5).mean(0)**2; print('pow0.5  ',round(acc(pm.argmax(1)),4))
# trimmed: drop lowest-confidence member per sample
conf=V.max(2)  # M,n
order=conf.argsort(0)  # ascending
# weighted by confidence
w=conf/conf.sum(0,keepdims=True)
wc=(V*w[:,:,None]).sum(0); print('conf-wtd',round(acc(wc.argmax(1)),4))
