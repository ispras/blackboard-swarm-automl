import numpy as np, pandas as pd, os
df=pd.read_csv('workspaces/shared/folds5_seed42.csv')
f0idx=np.where(df.fold.values==0)[0]; y0=df.label.values[f0idx]; pos={v:i for i,v in enumerate(f0idx)}
def lv(path):
    v=np.load(path)
    if v.shape[0]==len(f0idx): return v.astype(np.float64)
    ip=path.replace('val_probs','val_idx')
    if os.path.exists(ip):
        idx=np.load(ip).astype(int); o=np.zeros((len(f0idx),5))
        for k,orig in enumerate(idx):
            if int(orig) in pos: o[pos[int(orig)]]=v[k]
        return o
    return None
R='workspaces/'
V={
 'achernar_convnext':lv(R+'achernar_delta/cvnx_mix/val0_convnext_v2.npy'),
 'achernar_convnext512':lv(R+'achernar_delta/cvnx_512f0/f0_val_probs.npy'),
 'capella_swin':lv(R+'capella_kappa/infer_swin/val_probs.npy'),
 'capella_swin_mix':lv(R+'capella_kappa/infer_swin_mix/val_probs.npy'),
 'capella_vit':lv(R+'capella_kappa/infer_vit/val_probs.npy'),
 'capella_vit_mix':lv(R+'capella_kappa/infer_vit_mix/val_probs.npy'),
 'capella_beit_mix':lv(R+'capella_kappa/infer_beit_mix/val_probs.npy'),
