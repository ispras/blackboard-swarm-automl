import numpy as np, pandas as pd, os
from sklearn.model_selection import StratifiedKFold
df=pd.read_csv('workspaces/shared/folds5_seed42.csv')
f0=np.where(df.fold.values==0)[0]; y0=df.label.values[f0]
cands={
 'achernar_cvnx':'workspaces/achernar_delta/cvnx_s384/val0_convnext_s384.npy',
 'capella_swin':'workspaces/capella_kappa/infer_swin/val_probs.npy',
 'capella_vit':'workspaces/capella_kappa/infer_vit/val_probs.npy',
 'arcturus_effb4':'workspaces/arcturus_kappa/runs/effb4_512/f0_val_probs.npy',
 'arcturus_v2s':'workspaces/arcturus_kappa/runs/v2s_384/f0_val_probs.npy',
 'arcturus_v2s_mix':'workspaces/arcturus_kappa/runs/v2s_mix/f0_val_probs.npy',
}
keys=[]; arrs=[]
for k,p in cands.items():
    if os.path.exists(p):
        a=np.load(p)
        if a.shape[0]==len(f0): keys.append(k); arrs.append(a)
P=np.stack(arrs,0)  # M,n,5
def greedy_idx(Ptr,ytr,iters=40):
    M=P.shape[0]; counts=np.zeros(M,int)
    accs=[np.mean(Ptr[j].argmax(1)==ytr) for j in range(M)]
    counts[int(np.argmax(accs))]=1
    def acc(c):
        w=c/c.sum(); p=np.tensordot(w,Ptr,axes=([0],[0])); return np.mean(p.argmax(1)==ytr)
    best=acc(counts)
    for _ in range(iters):
        cj=-1;cb=best
        for j in range(M):
            c=counts.copy();c[j]+=1;a=acc(c)
            if a>cb: cb=a;cj=j
        if cj<0:break
        counts[cj]+=1;best=cb
    return counts,best
# simple full-fold greedy (optimistic)
counts,best=greedy_idx(P,y0)
print('FULL greedy fold0 acc',round(float(best),4),{k:int(c) for k,c in zip(keys,counts)})
eq=P.mean(0); print('equal',round(float((eq.argmax(1)==y0).mean()),4))
gm=np.exp(np.log(P+1e-9).mean(0)); print('geom',round(float((gm.argmax(1)==y0).mean()),4))
# nested CV to estimate honest generalization of: equal vs greedy
skf=StratifiedKFold(5,shuffle=True,random_state=0)
res_eq=[];res_gr=[];res_best=[]
for tr,va in skf.split(np.zeros(len(y0)),y0):
    Ptr=P[:,tr]; Pva=P[:,va]; ytr=y0[tr]; yva=y0[va]
    res_eq.append((Pva.mean(0).argmax(1)==yva).mean())
    c,_=greedy_idx(Ptr,ytr)
    w=c/c.sum(); res_gr.append((np.tensordot(w,Pva,axes=([0],[0])).argmax(1)==yva).mean())
    singles=[(Pva[j].argmax(1)==yva).mean() for j in range(len(keys))]
    res_best.append(max(singles))
print('nested equal',round(float(np.mean(res_eq)),4),'greedy',round(float(np.mean(res_gr)),4),'best_single',round(float(np.mean(res_best)),4))
