    cs=size
    m=n-cs
    offs=[(0,0),(0,m),(m,0),(m,m)]
    ct=(m//2,m//2)
    idx=[ct]+offs
    for (i,j) in idx: out.append(xs[:,:,i:i+cs,j:j+cs])
    return out
@torch.no_grad()
def run(backbone,ck,size=384,bs=32):
    m=timm.create_model(backbone,pretrained=False,num_classes=5).cuda(); m.load_state_dict(torch.load(ck,map_location='cuda')); m.eval()
    dl=DataLoader(DS(va,f"{ROOT}/data/train_images",size),batch_size=bs,shuffle=False,num_workers=6)
    # view: center single, and 5-crop(scale1.0)+flips, and 5-crop(scale0.885)
    preds_center=[]; preds_5=[]; preds_5s=[]
    for x,yb in dl:
        x=x.cuda()
        with autocast():
            lc=0
            for v in [x, torch.flip(x,[3]), torch.flip(x,[2])]:
                lc=lc+m(norm(v))
            # 5-crop scale 1.0
            l5=0
            for c in crops(x,size,1.0):
                l5=l5+m(norm(c))+m(norm(torch.flip(c,[3])))
            # 5-crop scale ~0.885 (i.e. resize to size=384 exactly then 5-crop of 340)
            l5s=0
            for c in crops(x,int(size*0.885),1.0):
                l5s=l5s+m(norm(c))+m(norm(torch.flip(c,[3])))
        preds_center.append(lc.float().argmax(1).cpu()); preds_5.append(l5.float().argmax(1).cpu()); preds_5s.append(l5s.float().argmax(1).cpu())
    pc=torch.cat(preds_center).numpy(); p5=torch.cat(preds_5).numpy(); p5s=torch.cat(preds_5s).numpy()
    print(backbone.split('.')[0], 'center', round(float((pc==y).mean()),4), '5crop', round(float((p5==y).mean()),4), '5crop2', round(float((p5s==y).mean()),4))
run('convnext_small.fb_in22k_ft_in1k','workspaces/achernar_delta/cvnx_s384/f0_best.pt')
run('convnext_small.fb_in22k_ft_in1k','workspaces/achernar_delta/cvnx_mix/f0_best.pt')
