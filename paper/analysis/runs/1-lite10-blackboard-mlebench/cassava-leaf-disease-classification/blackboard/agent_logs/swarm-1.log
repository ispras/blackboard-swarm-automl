 'arcturus_v2m480':lv(R+'arcturus_kappa/runs/v2m_480/f0_val_probs.npy'),
 'arcturus_cvnxb':lv(R+'arcturus_kappa/runs/cvnxb_384/f0_val_probs.npy'),
 'arcturus_effb4':lv(R+'arcturus_kappa/runs/effb4_512/f0_val_probs.npy'),
}
for k,v in V.items(): print(f'{k:20s} {None if v is None else round(float((v.argmax(1)==y0).mean()),4)}')
names=[k for k,v in V.items() if v is not None]
P=np.stack([V[k] for k in names],0)
def ge(idx): 
    g=np.exp(np.log(P[idx]+1e-9).mean(0)); return float((g.argmax(1)==y0).mean())
allidx=list(range(len(names)))
