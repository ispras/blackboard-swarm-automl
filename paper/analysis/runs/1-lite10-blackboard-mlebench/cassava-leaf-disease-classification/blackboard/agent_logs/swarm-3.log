 ('achernar_convnext', b+'achernar_delta/cvnx_mix/val0_convnext_v2.npy'),
 ('capella_swin', b+'capella_kappa/infer_swin/val_probs.npy'),
 ('capella_swin_mix', b+'capella_kappa/infer_swin_mix/val_probs.npy'),
 ('capella_vit', b+'capella_kappa/infer_vit/val_probs.npy'),
 ('capella_vit_mix', b+'capella_kappa/infer_vit_mix/val_probs.npy'),
 ('capella_beit_mix', b+'capella_kappa/infer_beit_mix/val_probs.npy'),
 ('capella_xcit_mix', b+'capella_kappa/infer_xcit_mix/val_probs.npy'),
 ('arcturus_v2s_best', b+'arcturus_kappa/runs/v2s_mix/val0_v2s_mix.npy'),
 ('arcturus_v2m480', b+'arcturus_kappa/runs/v2m_480/f0_val_probs.npy'),
 ('arcturus_cvnxb', b+'arcturus_kappa/runs/cvnxb_384/f0_val_probs.npy'),
 ('arcturus_effb4', b+'arcturus_kappa/runs/effb4_512/f0_val_probs.npy'),
]
V=np.stack([np.load(p) for _,p in M],0).astype(np.float64)
P=V+1e-9
def arith(P): return P.mean(0)
def geom(P): return np.exp(np.log(P).mean(0))
def pow_comb(P,a): q=P**a; return q/q.sum(-1,keepdims=True)
def rank(P):
    # per-member, per-sample rank of each class (higher prob -> higher rank), average
    R=np.zeros_like(P)
    for i in range(P.shape[0]):
        R[i]=np.argsort(np.argsort(P[i],axis=1),axis=1)
    return R.mean(0)
def majority(P):
    # one-hot of each member argmax, sum
    oh=np.zeros_like(P)
    idx=P.argmax(1)
    for i in range(P.shape[0]): oh[i,np.arange(P.shape[1]),idx[i]]=1
    return oh
combiners={'arith':arith(P),'geom':geom(P),'rank':rank(P),'majority':majority(P),
           'pow0.5':pow_comb(P,0.5),'pow0.75':pow_comb(P,0.75),'pow1.5':pow_comb(P,1.5),'pow2':pow_comb(P,2.0)}
for k,v in combiners.items(): print(f'{k:9s} {(v.argmax(1)==y).mean():.4f}')
# bootstrap
rng=np.random.default_rng(0); n=len(y); B=2000
wins={k:0 for k in combiners}; sums={k:0 for k in combiners}
for _ in range(B):
    idx=rng.integers(0,n,n)
    accs={k:(v[idx].argmax(1)==y[idx]).mean() for k,v in combiners.items()}
    bk=max(accs,key=accs.get); wins[bk]+=1
    for k in sums: sums[k]+=accs[k]
print('mean accs', {k:round(sums[k]/B,4) for k in sums})
print('win counts', wins)
