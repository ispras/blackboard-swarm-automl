p=np.load(\"workspaces/sirius_tau/oof_lgb.npy\")
o=np.argsort(-p); ys=y[o]; ps=p[o]
P=np.cumsum(ys); totP=P[-1]; N=len(ys)-totP
TP=P; FP=(np.arange(len(ys))+1.0)-P; FN=totP-TP; TN=N-FP
den=np.sqrt((TP+FP)*(TP+FN)*(TN+FP)*(TN+FN)); mcc=np.where(den>0,(TP*TN-FP*FN)/den,0)
k=int(np.argmax(mcc)); thr=float(ps[k]); print(\"best thr\",thr,\"mcc\",mcc[k])
pt=np.load(\"workspaces/sirius_tau/test_lgb.npy\")
sub=pd.read_csv(\"data/sample_submission.csv\"); sub[\"contact\"]=(pt>=thr).astype(int)
sub.to_csv(\"final_solution/submission.csv\",index=False)
print(\"pos rate\",sub.contact.mean(),\"n\",len(sub))
