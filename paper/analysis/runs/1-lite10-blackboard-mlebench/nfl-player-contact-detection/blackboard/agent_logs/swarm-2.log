    return hashlib.md5(pd.read_csv(f).contact.values.tobytes()).hexdigest()[:10]
target='final_solution/submission.csv'
print('final',h(target))
import glob
for f in glob.glob('workspaces/*/sub_*.csv')+glob.glob('workspaces/*/*sub*.csv'):
    try:
        if h(f)==h(target): print('MATCH <-',f)
    except: pass
# also print each hash
for f in ['final_solution/submission.csv','workspaces/procyon_theta/sub_ens_greedy.csv','workspaces/fomalhaut_omicron/sub_ens_v4.csv','workspaces/procyon_theta/sub_l2_seq.csv']:
    try: print(f,h(f))
    except Exception as e: print(f,e)
