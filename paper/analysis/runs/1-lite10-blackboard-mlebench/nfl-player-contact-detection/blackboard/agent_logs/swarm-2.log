import numpy as np, pandas as pd
from sklearn.metrics import matthews_corrcoef
tr=pd.read_parquet('cache/train_track_feat.parquet', columns=['contact'])
y=tr.contact.values.astype(np.int64)
oof=np.load('cache/oof_lgb.npy')
# efficient MCC over thresholds via sorting
idx=np.argsort(-oof); ys=y[idx]; ps=oof[idx]
P=ys.sum(); N=len(ys)-P
tp=np.cumsum(ys); fp=np.cumsum(1-ys)
# threshold = take top k as positive (k=1..len)
den=np.sqrt((tp+fp)*(tp+ (P-tp))*((N-fp)+fp)*((N-fp)+(P-tp))).astype(float)
num=(tp*(N-fp)-fp*(P-tp)).astype(float)
mcc=np.divide(num,den,out=np.zeros_like(num),where=den>0)
k=np.argmax(mcc); best=mcc[k]
thr=ps[k]
print('best k',k,'npos',k+1,'thr',thr,'MCC',best)
# also test few thresholds
for t in [0.01,0.013,0.02,0.03,0.05,0.1,0.2]:
    print(t, round(matthews_corrcoef(y,(oof>=t).astype(int)),5))
print('pos rate', y.mean())
