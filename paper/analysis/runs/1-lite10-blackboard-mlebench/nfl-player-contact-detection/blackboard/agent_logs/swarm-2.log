import numpy as np, pandas as pd
from sklearn.metrics import matthews_corrcoef
tr=pd.read_parquet('cache/train_track_feat.parquet', columns=['contact'])
y=tr.contact.values.astype(np.int64)
oof=np.load('cache/oof_lgb.npy').astype(np.float64)
print('pred stats', oof.min(), oof.max(), oof.mean(), np.percentile(oof,[50,90,95,99,99.5]))
idx=np.argsort(-oof); ys=y[idx]; ps=oof[idx]
P=float(ys.sum()); N=float(len(ys)-P)
tp=np.cumsum(ys).astype(np.float64); fp=np.cumsum(1-ys).astype(np.float64)
fn=P-tp; tn=N-fp
den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))
num=(tp*tn-fp*fn)
