import pandas as pd, numpy as np
d=pd.read_parquet('../fomalhaut_omicron/cache/feat2_train.parquet', columns=['p2','contact'])
ig=(d.p2=='G').values; y=d.contact.values
oof=np.load('../fomalhaut_omicron/cache/oof_feat2.npy')
def mcc(y,p):
    tp=((p==1)&(y==1)).sum();fp=((p==1)&(y==0)).sum();fn=((p==0)&(y==1)).sum();tn=((p==0)&(y==0)).sum()
    den=np.sqrt(float((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)));return 0 if den==0 else (tp*tn-fp*fn)/den
def best(y,p):
    o=np.argsort(-p);ys=y[o].astype(float);ps=p[o];tp=np.cumsum(ys);fp=np.cumsum(1-ys)
    P=y.sum();N=len(y)-P;fn=P-tp;tn=N-fp;den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))
    m=np.where(den>0,(tp*tn-fp*fn)/np.where(den>0,den,1),0);i=np.argmax(m);return m[i],(ps[i]+ps[min(i+1,len(ps)-1)])/2
for name,msk in [('all',np.ones(len(y),bool)),('ground',ig),('pair',~ig)]:
    m,t=best(y[msk],oof[msk]); print(name,'n',msk.sum(),'MCC',round(m,4),'thr',round(t,4))
