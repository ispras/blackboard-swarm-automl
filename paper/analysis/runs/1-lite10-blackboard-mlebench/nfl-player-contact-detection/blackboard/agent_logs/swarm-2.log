    P=float(Pg+Pp); N=float((Ng+Np)-P); FN=P-TP; TN=N-FP""")
s=s.replace("return float(mcc[i]), kgs[i[0]], kps[i[1]]","return float(mcc[i]), int(kgs[i[0]]), int(kps[i[1]])")
open(p,'w').write(s); print('patched')
EOF
