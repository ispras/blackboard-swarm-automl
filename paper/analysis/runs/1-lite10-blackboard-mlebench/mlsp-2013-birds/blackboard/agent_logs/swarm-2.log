"""Train a chosen pipeline on all 258 labeled recs and write a submission.

Usage: python make_submission.py <featspec> <out.csv>
featspec e.g. "ast+meta" (logreg C=0.1).
"""
import os, sys, csv
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import common as C
import eval_feats as EF
import eval_ast as EA

HERE = os.path.dirname(os.path.abspath(__file__))


def fit_predict(Xtr, Y, Xte, Cv=0.1):
    from sklearn.linear_model import LogisticRegression
    from sklearn.preprocessing import StandardScaler
    P = np.zeros((Xte.shape[0], 19), dtype=np.float64)
    for c in range(19):
        yc = Y[:, c]
        if yc.sum() == 0:
            P[:, c] = 0.0
            continue
        if yc.sum() == len(yc):
            P[:, c] = 1.0
            continue
        sc = StandardScaler().fit(Xtr)
        m = LogisticRegression(C=Cv, max_iter=5000, class_weight="balanced")
        m.fit(sc.transform(Xtr), yc)
        P[:, c] = m.predict_proba(sc.transform(Xte))[:, 1]
    return P


def main():
    featspec = sys.argv[1] if len(sys.argv) > 1 else "ast+meta"
    out = sys.argv[2] if len(sys.argv) > 2 else os.path.join(HERE, "submission.csv")
    keys = featspec.split("+")
    train, Y, test, _ = C.load_dataset()
    F = EA.get_blocks(train, test)
    Xtr = np.hstack([F[k][0] for k in keys])
    Xte = np.hstack([F[k][1] for k in keys])
    P = fit_predict(Xtr, Y, Xte)
    with open(out, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Id", "Probability"])
        for i, r in enumerate(test):
            for c in range(19):
                w.writerow([r * 100 + c, f"{P[i, c]:.6f}"])
    print("wrote", out, "rows", len(test) * 19)
    np.savez(os.path.join(HERE, "test_pred_" + featspec.replace("+", "_") + ".npz"),
             test_recs=np.array(test), probs=P)


if __name__ == "__main__":
    main()
