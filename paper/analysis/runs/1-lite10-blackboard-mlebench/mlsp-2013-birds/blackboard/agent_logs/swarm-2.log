"""Extract pretrained AST (AudioSet) embeddings for all 322 recordings.

Saves workspaces/rigel_omega/ast_feats.npz with:
  recs (322,), emb (322,768) pooler_output, logits (322,527) AudioSet probs
"""
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import common as C

os.environ.setdefault("HF_HOME", os.path.expanduser("~/.cache/huggingface"))
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ast_feats.npz")
MODEL = "MIT/ast-finetuned-audioset-10-10-0.4593"


def rec2file():
    d = {}
    with open(os.path.join(C.DATA, "essential_data", "rec_id2filename.txt")) as f:
        f.readline()
        for line in f:
            line = line.strip()
            if not line:
                continue
            r, fn = line.split(",")
            d[int(r)] = fn
    return d


def main():
    import torch
    import soundfile as sf
    from transformers import AutoFeatureExtractor, ASTModel, ASTForAudioClassification

    dev = "cuda" if torch.cuda.is_available() else "cpu"
    print("device", dev, flush=True)
    fe = AutoFeatureExtractor.from_pretrained(MODEL)
    model = ASTModel.from_pretrained(MODEL).to(dev).eval()
    clf = ASTForAudioClassification.from_pretrained(MODEL).to(dev).eval()
    r2f = rec2file()
    recs = sorted(r2f.keys())
    embs, logits = [], []
    t0 = time.time()
    bs = 16
    with torch.no_grad():
        for i in range(0, len(recs), bs):
            batch = recs[i:i + bs]
            wavs = []
            for r in batch:
                y, sr = sf.read(os.path.join(C.DATA, "essential_data", "src_wavs",
                                             r2f[r] + ".wav"))
                if y.ndim > 1:
                    y = y.mean(1)
                wavs.append(y.astype(np.float32))
            inp = fe(wavs, sampling_rate=16000, return_tensors="pt", padding=True)
            iv = inp["input_values"].to(dev)
            out = model(iv)
            embs.append(out.pooler_output.cpu().numpy())
            lo = clf(iv).logits
            logits.append(torch.sigmoid(lo).cpu().numpy())
            print(i + len(batch), "/", len(recs), f"{time.time()-t0:.1f}s", flush=True)
    emb = np.vstack(embs); logit = np.vstack(logits)
    np.savez(OUT, recs=np.array(recs), emb=emb, logits=logit)
    print("saved", OUT, emb.shape, logit.shape, "in", time.time() - t0)


if __name__ == "__main__":
    main()
