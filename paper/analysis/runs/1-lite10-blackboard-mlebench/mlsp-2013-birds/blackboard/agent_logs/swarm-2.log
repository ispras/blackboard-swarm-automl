import os, sys, glob, json
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import common as C
from scipy.stats import rankdata
from sklearn.model_selection import KFold

HERE = os.path.dirname(os.path.abspath(__file__))
WS = os.path.abspath(os.path.join(HERE, ".."))


def glob_auc(Y, P):
    from sklearn.metrics import roc_auc_score
    return roc_auc_score(Y, P, average="micro")


def macro(Y, P):
    return C.macro_auc(Y, P)


def rank_norm(a):
    out = np.zeros_like(a, dtype=np.float64)
    for j in range(a.shape[1]):
        r = rankdata(a[:, j])
        out[:, j] = (r - 1) / max(len(r) - 1, 1)
    return out


def load_members():
    train, Y, test, _ = C.load_dataset()
    tr_idx = {r: i for i, r in enumerate(train)}
    te_idx = {r: i for i, r in enumerate(test)}
    members = {}
    for d in glob.glob(os.path.join(WS, "*")):
        for f in sorted(glob.glob(os.path.join(d, "**", "oof*.npz"), recursive=True)):
            try:
                z = np.load(f, allow_pickle=True)
            except Exception:
                continue
            if not ({"rec_ids", "probs"} <= set(z.files)):
                continue
            recs = list(z["rec_ids"]); probs = z["probs"]
            if probs.shape != (len(train), 19):
                continue
            # align
            if set(recs) != set(train):
                continue
            order = np.argsort([tr_idx[r] for r in recs])
            p = probs[order]
            name = os.path.basename(f)[:-4]
            key = os.path.basename(d) + "/" + name
            tp = None
            if "test_probs" in z.files and "test_rec_ids" in z.files:
                trecs = list(z["test_rec_ids"])
                if set(trecs) == set(test):
                    o2 = np.argsort([te_idx[r] for r in trecs])
                    tp = z["test_probs"][o2]
            members[key] = dict(oof=p.astype(np.float64), test=None if tp is None else tp.astype(np.float64))
    return train, Y, test, members


def blend(names, members, rows, use_rank=True, weights=None):
    O = None
    for n in names:
        o = rank_norm(members[n]["oof"][rows]) if use_rank else members[n]["oof"][rows]
        w = 1.0 if weights is None else weights[n]
        O = o * w if O is None else O + o * w
    return O


def greedy(members, Y, names, n_iter=30, use_rank=True):
    chosen = {}
    best = -1
    for it in range(n_iter):
        add, sc = None, best
        for n in names:
            cand = dict(chosen); cand[n] = cand.get(n, 0) + 1
            tot = sum(cand.values()); w = {k: v / tot for k, v in cand.items()}
            o = blend(list(cand), members, np.arange(len(Y)), use_rank, w)
            s = glob_auc(Y, o)
            if s > sc:
                sc, add = s, n
        if add is None:
            break
        chosen[add] = chosen.get(add, 0) + 1
        best = sc
    tot = sum(chosen.values()); w = {k: v / tot for k, v in chosen.items()}
    return w, best


def nested_greedy(members, Y, names, seeds=(0, 1, 2), n_iter=20, use_rank=True):
    scores = []
    for seed in seeds:
        for tri, vai in KFold(5, shuffle=True, random_state=seed).split(Y):
            sub = {n: dict(oof=members[n]["oof"][tri]) for n in names}
            w, _ = greedy(sub, Y[tri], names, n_iter=n_iter, use_rank=use_rank)
            ov = None
            for n, wt in w.items():
                o = rank_norm(members[n]["oof"][vai]) if use_rank else members[n]["oof"][vai]
                ov = o * wt if ov is None else ov + o * wt
            scores.append(glob_auc(Y[vai], ov))
    return float(np.mean(scores)), float(np.std(scores))


def main():
    train, Y, test, members = load_members()
    withtest = {k: v for k, v in members.items() if v["test"] is not None}
    scored = sorted(((glob_auc(Y, m["oof"]), macro(Y, m["oof"]), k) for k, m in members.items()), reverse=True)
    print(f"members={len(members)} with_test={len(withtest)}")
    for g, mm, k in scored[:25]:
        print(f"  {g:.4f} {mm:.4f} {k}")
    names_all = [k for _, _, k in scored]
    print("\n-- rank mean top-k (all members) --")
    for k in [1, 2, 3, 5, 8, 12, 20, len(names_all)]:
        ns = names_all[:k]
        O = blend(ns, members, np.arange(len(Y)), True)
        print(f"  top{k:2d} g={glob_auc(Y, O):.4f} m={macro(Y, O):.4f}")
    print("\n-- nested greedy (honest) --")
    ng, ns_ = nested_greedy({k: members[k] for k in names_all[:15]}, Y,
                            names_all[:15], n_iter=20, use_rank=True)
    print(f"  nested g={ng:.4f} +/- {ns_:.4f}")


if __name__ == "__main__":
    main()
