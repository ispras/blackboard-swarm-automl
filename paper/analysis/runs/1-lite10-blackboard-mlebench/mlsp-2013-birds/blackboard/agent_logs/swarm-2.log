        B=np.mean([mem[kk][va] for kk in chosen],0)
        G.append(gauc(Y[va],B)); Ma.append(mac(Y[va],B))
    return np.mean(G),np.mean(Ma)
for sel,extra in [(15,0),(20,0),(20,1),(20,3),(20,5),(30,3),(15,3),(10,3)]:
    g,m=blend(sel,extra); print(f"sel={sel} extra_raw={extra}: global={g:.4f} macro={m:.4f}",flush=True)
