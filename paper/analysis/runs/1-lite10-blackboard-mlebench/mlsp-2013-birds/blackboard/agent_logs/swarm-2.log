    for s,idxs in groups.items():
        if len(idxs)<2: continue
        for i in idxs:
            others=[j for j in idxs if j!=i]
            prior=Y[others].mean(0)
            Q[i]=(1-b)*P[i]+b*prior
    print(f"b={b}: global={gauc(Q):.4f} macro={mac(Q):.4f}")
