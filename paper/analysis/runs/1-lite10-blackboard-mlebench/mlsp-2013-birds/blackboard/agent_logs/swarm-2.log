[0m$ [0mcd /download_job_code/payload/sandbox/data && python3 - <<'EOF'
import collections, numpy as np
labels={}
with open('essential_data/rec_labels_test_hidden.txt') as f:
    next(f)
    for line in f:
        p=line.strip().split(','); rid=int(p[0]); rest=[x for x in p[1:] if x!='']
        labels[rid]=('?' if (rest and rest[0]=='?') else set(int(x) for x in rest))
fold={}
with open('essential_data/CVfolds_2.txt') as f:
    next(f)
    for line in f:
        r,fo=line.strip().split(','); fold[int(r)]=int(fo)
fn={}
with open('essential_data/rec_id2filename.txt') as f:
    next(f)
    for line in f:
        r,f2=line.strip().split(','); fn[int(r)]=f2
tr=[r for r in fold if fold[r]==0]; te=[r for r in fold if fold[r]==1]
def sd(r):
    p=fn[r].split('_'); return (p[0],p[1])
# group sizes
gtr=collections.defaultdict(list); gte=collections.defaultdict(list)
for r in tr: gtr[sd(r)].append(r)
for r in te: gte[sd(r)].append(r)
print("unique station-date groups train",len(gtr),"test",len(gte))
print("test groups whose station-date also in train:", sum(1 for k in gte if k in gtr))
# label consistency within train groups
same=0; tot=0; jac=[]
for k,ids in gtr.items():
    sets=[labels[r] for r in ids if isinstance(labels[r],set)]
    if len(sets)<2: continue
    for i in range(len(sets)):
        for j in range(i+1,len(sets)):
            a,b=sets[i],sets[j]
            if len(a|b)==0: continue
            tot+=1; 
            inter=len(a&b); uni=len(a|b)
            jac.append(inter/uni)
print("mean pairwise Jaccard within station-date (train):", np.mean(jac), "n=",len(jac))
print("exact-equal rate:", np.mean([1 if abs(j-1)<1e-9 else 0 for j in jac]))
# group sizes
print("avg group size", np.mean([len(v) for v in gtr.values()]))
# how many test recs have a train rec same station+date
print("test recs with train same sd:", sum(1 for r in te if sd(r) in gtr),"/",len(te))
# distribution of per-species mean by station
