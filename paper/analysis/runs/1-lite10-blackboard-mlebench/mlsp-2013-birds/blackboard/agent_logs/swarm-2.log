"""Perch v2 in PyTorch: an unofficial port of Google DeepMind's bioacoustics model.

    from perchv2_pytorch import PerchV2, load_audio, frame_audio
    model = PerchV2.from_pretrained()
    out = model(frame_audio(load_audio('recording.wav')))
