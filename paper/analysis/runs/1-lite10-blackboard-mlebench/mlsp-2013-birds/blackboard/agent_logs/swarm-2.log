from collections import defaultdict
groups=defaultdict(list)
for i,r in enumerate(recs): groups[sess(r)].append(i)
def gauc(P): return roc_auc_score(Y.ravel(),P.ravel())
def mac(P): return np.mean([roc_auc_score(Y[:,c],P[:,c]) for c in range(19) if 0<Y[:,c].sum()<len(Y)])
