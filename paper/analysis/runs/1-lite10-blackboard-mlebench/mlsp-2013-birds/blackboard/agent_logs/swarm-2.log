"""Shared utilities for MLSP-2013 birds (rigel_omega).

Data parsing + a consistent repeated-CV macro-AUC harness so all agents can
compare models on identical folds.
"""
import os
import numpy as np

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
DATA = os.path.join(ROOT, "data")
N_CLASSES = 19


def label_path():
    return os.path.join(DATA, "essential_data", "rec_labels_test_hidden.txt")


def folds_path():
    return os.path.join(DATA, "essential_data", "CVfolds_2.txt")


def load_labels():
    """Return dict rec_id -> list[int] or None for hidden test."""
    labs = {}
    with open(label_path()) as f:
        f.readline()
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split(",")
            rec = int(parts[0])
            if len(parts) == 1 or parts[1] == "":
                labs[rec] = []
            elif parts[1] == "?":
                labs[rec] = None
            else:
                labs[rec] = [int(x) for x in parts[1:]]
    return labs


def load_folds():
    folds = {}
    with open(folds_path()) as f:
        f.readline()
        for line in f:
            line = line.strip()
            if not line:
                continue
            r, fo = line.split(",")
            folds[int(r)] = int(fo)
    return folds


def load_dataset():
    """Return (train_recs, Y, test_recs, rec2fold).

    train_recs sorted list of labeled rec_ids, Y is (n_train,19) float32.
    """
    labs = load_labels()
    folds = load_folds()
    train = sorted([r for r, v in labs.items() if v is not None])
    test = sorted([r for r, v in labs.items() if v is None])
    Y = np.zeros((len(train), N_CLASSES), dtype=np.float32)
    for i, r in enumerate(train):
        for c in labs[r]:
            Y[i, c] = 1.0
    rec2fold = {r: folds.get(r, -1) for r in train + test}
    return train, Y, test, rec2fold


def load_histogram():
    """rec_id -> np.array(100,)"""
    out = {}
    path = os.path.join(DATA, "supplemental_data", "histogram_of_segments.txt")
    with open(path) as f:
        f.readline()
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split(",")
            rec = int(parts[0])
            out[rec] = np.array([float(x) for x in parts[1:]], dtype=np.float32)
    return out


def load_segment_features():
    """rec_id -> np.array(n_segments, 38)"""
    out = {}
    path = os.path.join(DATA, "supplemental_data", "segment_features.txt")
    with open(path) as f:
        f.readline()
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split(",")
            rec = int(parts[0])
            vec = np.array([float(x) for x in parts[2:]], dtype=np.float32)
            out.setdefault(rec, []).append(vec)
    return {k: np.vstack(v) for k, v in out.items()}


def agg_segment_features(seg, agg=("mean", "std", "min", "max")):
    """Aggregate per-segment (n,38) features into one vector + count."""
    chunks = []
    if "mean" in agg:
        chunks.append(seg.mean(0))
    if "std" in agg:
        chunks.append(seg.std(0))
    if "min" in agg:
        chunks.append(seg.min(0))
    if "max" in agg:
        chunks.append(seg.max(0))
    return np.concatenate(chunks)


def build_tabular(train_recs, test_recs, seg_agg=("mean", "std", "min", "max")):
