import os, sys, time, json
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import common as C
import eval_feats as EF

HERE = os.path.dirname(os.path.abspath(__file__))


def load_ast():
    z = np.load(os.path.join(HERE, "ast_feats.npz"), allow_pickle=True)
    recs = list(z["recs"])
    m = {r: (z["emb"][i], z["logits"][i]) for i, r in enumerate(recs)}
    return m


def get_blocks(train, test):
    meta_tr, _ = EF.build_metadata(train)
    meta_te, _ = EF.build_metadata(test)
    amap = EF.load_audio()
    A_tr = np.vstack([amap[r] for r in train]).astype(np.float32)
    A_te = np.vstack([amap[r] for r in test]).astype(np.float32)
    hist = C.load_histogram()
    H_tr = np.vstack([hist.get(r, np.zeros(100, dtype=np.float32)) for r in train])
    H_te = np.vstack([hist.get(r, np.zeros(100, dtype=np.float32)) for r in test])
    seg = C.load_segment_features()
    def segagg(recs):
        X = np.zeros((len(recs), 38 * 4 + 1), dtype=np.float32)
        for i, r in enumerate(recs):
            if r in seg:
                s = seg[r]
                X[i] = np.concatenate([s.mean(0), s.std(0), s.min(0), s.max(0), [len(s)]])
        return X
    am = load_ast()
    E_tr = np.vstack([am[r][0] for r in train]).astype(np.float32)
    E_te = np.vstack([am[r][0] for r in test]).astype(np.float32)
    L_tr = np.vstack([am[r][1] for r in train]).astype(np.float32)
    L_te = np.vstack([am[r][1] for r in test]).astype(np.float32)
    out = dict(meta=(meta_tr, meta_te), audio=(A_tr, A_te), hist=(H_tr, H_te),
               seg=(segagg(train), segagg(test)), ast=(E_tr, E_te), astlog=(L_tr, L_te))
    for nm in ("astmean", "wav2vec2", "hubert", "wavlm"):
        p = os.path.join(HERE, f"emb_{nm}.npz")
        if os.path.exists(p):
            z = np.load(p, allow_pickle=True)
            m = {r: z["X"][i] for i, r in enumerate(list(z["recs"]))}
            out[f"emb_{nm}"] = (np.vstack([m[r] for r in train]),
                                np.vstack([m[r] for r in test]))
    for nm in ("resnet18", "efficientnet_b0", "convnext_tiny"):
        p = os.path.join(HERE, f"spec_{nm}.npz")
        if os.path.exists(p):
            z = np.load(p, allow_pickle=True)
            m = {r: z["X"][i] for i, r in enumerate(list(z["recs"]))}
            out[f"spec_{nm}"] = (np.vstack([m[r] for r in train]),
                                 np.vstack([m[r] for r in test]))
    return out


def global_auc(Y, P):
    from sklearn.metrics import roc_auc_score
    return roc_auc_score(Y, P, average="micro")


def main():
    train, Y, test, _ = C.load_dataset()
    F = get_blocks(train, test)
    import lightgbm as lgb
    from sklearn.decomposition import PCA
    from sklearn.linear_model import LogisticRegression
    from sklearn.preprocessing import StandardScaler
    from sklearn.pipeline import make_pipeline

    folds = C.make_folds(Y, n_splits=5, n_repeats=3, seed=0)

    def lgbm():
        return lgb.LGBMClassifier(n_estimators=300, learning_rate=0.03, num_leaves=15,
                                  subsample=0.8, subsample_freq=1, colsample_bytree=0.6,
                                  min_child_samples=5, reg_lambda=1.0,
                                  class_weight="balanced", n_jobs=2, random_state=0,
                                  verbose=-1)

    def logreg():
        return make_pipeline(StandardScaler(),
                             LogisticRegression(C=0.05, max_iter=3000,
                                                class_weight="balanced"))

    tests = [
        ("ast_emb(logreg)", ["ast"], logreg),
        ("ast_emb(lgbm)", ["ast"], lgbm),
        ("ast_log(lgbm)", ["astlog"], lgbm),
        ("ast_emb+meta(lgbm)", ["ast", "meta"], lgbm),
        ("ast_emb+log+meta(lgbm)", ["ast", "astlog", "meta"], lgbm),
        ("all(lgbm)", ["ast", "astlog", "meta", "audio", "hist", "seg"], lgbm),
        ("all(logreg)", ["ast", "astlog", "meta", "audio", "hist", "seg"], logreg),
    ]
    for name, keys, fac in tests:
        Xtr = np.hstack([F[k][0] for k in keys])
        t = time.time()
        auc, oof = C.cv_evaluate(Xtr, Y, fac, folds)
        g = global_auc(Y, oof)
        print(f"{name:26s} macro={auc:.4f} global={g:.4f} ({time.time()-t:.1f}s)", flush=True)
        np.savez(os.path.join(HERE, f"oof_{name.split('(')[0]}.npz"),
                 recs=np.array(train), Y=Y, oof=oof)


if __name__ == "__main__":
    main()
