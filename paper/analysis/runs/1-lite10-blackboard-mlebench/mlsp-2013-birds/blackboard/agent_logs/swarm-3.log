+def proba_matrix(clf, X, n_classes=NSPEC):
+    raw = clf.predict_proba(X)
+    out = np.zeros((X.shape[0], n_classes), dtype=np.float64)
+    for i in range(n_classes):
+        classes = clf.classes_[i]
+        p = raw[i]
+        if p.ndim == 1:
+            p = p[:, None]
+        if 1 in classes:
+            out[:, i] = p[:, int(np.where(classes == 1)[0][0])]
+        else:
+            out[:, i] = 0.0
+    return out
+
