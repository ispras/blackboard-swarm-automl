"""Extract Perch v2 (Google DeepMind bioacoustics) embeddings, mean+max pooled."""
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import common as C

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "perchv2_pytorch_src"))


def rec2file():
    d = {}
    with open(os.path.join(C.DATA, "essential_data", "rec_id2filename.txt")) as f:
        f.readline()
        for line in f:
            line = line.strip()
            if not line:
                continue
            r, fn = line.split(",")
            d[int(r)] = fn
    return d


def main():
    import torch
    from perchv2_pytorch import PerchV2, load_audio, frame_audio
    torch.set_num_threads(8)
    model = PerchV2.from_pretrained(embeddings_only=True).cuda().eval()
    r2f = rec2file(); recs = sorted(r2f.keys())
    Emean, Emax = [], []
    t0 = time.time()
    with torch.inference_mode(), torch.autocast("cuda", dtype=torch.float16):
        for i, r in enumerate(recs):
            w = frame_audio(load_audio(os.path.join(C.DATA, "essential_data", "src_wavs",
                                                    r2f[r] + ".wav"))).cuda()
            e = model(w)["embedding"].float().cpu().numpy()
            Emean.append(e.mean(0)); Emax.append(e.max(0))
            if (i + 1) % 50 == 0:
                print(i + 1, round(time.time() - t0, 1), flush=True)
    M = np.vstack(Emean).astype(np.float32); X = np.vstack(Emax).astype(np.float32)
    np.savez(os.path.join(HERE, "emb_perch.npz"), recs=np.array(recs), X=M)
    np.savez(os.path.join(HERE, "emb_perchmax.npz"), recs=np.array(recs), X=X)
    print("saved perch", M.shape, round(time.time() - t0, 1))


if __name__ == "__main__":
    main()
