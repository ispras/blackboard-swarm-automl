import csv, os, numpy as np

ROOT = "/download_job_code/payload/sandbox"
ED = os.path.join(ROOT, "data/essential_data")
SD = os.path.join(ROOT, "data/supplemental_data")
NSPEC = 19


def load_ids():
    fold = {}
    with open(os.path.join(ED, "CVfolds_2.txt")) as f:
        r = csv.reader(f); next(r)
        for row in r:
            fold[int(row[0])] = int(row[1])
    return fold


def load_labels():
    labs = {}
    with open(os.path.join(ED, "rec_labels_test_hidden.txt")) as f:
        r = csv.reader(f); next(r)
        for row in r:
            if len(row) > 1 and row[1] == "?":
                continue
            rid = int(row[0])
            labs[rid] = set(int(x) for x in row[1:] if x != "")
    return labs


def load_hist():
    X = {}
    with open(os.path.join(SD, "histogram_of_segments.txt")) as f:
        r = csv.reader(f); next(r)
        for row in r:
            X[int(row[0])] = np.array([float(v) for v in row[1:]], dtype=np.float32)
    return X


def load_segfeat():
    segs = {}
    with open(os.path.join(SD, "segment_features.txt")) as f:
        r = csv.reader(f); next(r)
        for row in r:
            rid = int(row[0]); seg = int(row[1])
            feats = np.array([float(v) for v in row[2:]], dtype=np.float32)
            segs.setdefault(rid, []).append(feats)
    return segs


def y_matrix(recs, labels):
    Y = np.zeros((len(recs), NSPEC), dtype=np.int8)
    for i, rid in enumerate(recs):
        for s in labels[rid]:
            Y[i, s] = 1
    return Y


def global_auc(y_true, y_pred):
    from sklearn.metrics import roc_auc_score
    return roc_auc_score(y_true.ravel(), y_pred.ravel())


def make_cv(fold, labels, seed=0, n_splits=5):
    """Return list of (tr_idx, va_idx) referencing the ordered train rec list."""
    from sklearn.model_selection import KFold
    train_recs = sorted([r for r in labels if fold[r] == 0])
    kf = KFold(n_splits=n_splits, shuffle=True, random_state=seed)
    idx = np.arange(len(train_recs))
    return train_recs, list(kf.split(idx))
