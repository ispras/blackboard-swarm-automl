=== hub.py ===
"""Locating and reading the published weights.

Files (in the Hugging Face repo, the GitHub release, or a local directory):
    model.safetensors     full model: encoder + 14,795-class prototype classifier (~388 MB)
    encoder.safetensors   encoder only, for embeddings (~41 MB)
    labels.csv            index, label (scientific name / sound class), ebird_code
"""

import csv
import os
import pathlib

HF_REPO = 'matijama/perch-v2-pytorch'
GITHUB_RELEASE = 'https://github.com/matijama/perch-v2-pytorch/releases/download/v1.0.0/'
FILES = ('model.safetensors', 'encoder.safetensors', 'labels.csv')


def _local_cache() -> pathlib.Path:
    root = os.environ.get('PERCHV2_PYTORCH_CACHE') or os.path.join(
        os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'perchv2_pytorch')
    return pathlib.Path(root)


def fetch(filename: str, source: str = HF_REPO, cache_dir: str | None = None) -> pathlib.Path:
    """Path to `filename` from a local directory or a Hugging Face repo (downloaded once, cached).

    For the default repo, falls back to the GitHub release if Hugging Face cannot be reached.
    """
    local = pathlib.Path(source).expanduser()
    if local.is_dir():
        path = local / filename
        if not path.is_file():
            raise FileNotFoundError(
                f"'{filename}' not found in local directory '{local}'. It should contain {', '.join(FILES)}.")
        return path
    try:
        from huggingface_hub import hf_hub_download

        return pathlib.Path(hf_hub_download(source, filename, cache_dir=cache_dir))
    except Exception as hf_error:  # noqa: BLE001 - offline, blocked, hub outage, missing package...
        if source != HF_REPO:
            raise FileNotFoundError(
                f"Could not get '{filename}' from '{source}': it is neither a local directory nor a "
                f'reachable Hugging Face repo ({type(hf_error).__name__}: {hf_error}).') from hf_error
        target = pathlib.Path(cache_dir) / filename if cache_dir else _local_cache() / filename
        if not target.is_file():
            import torch

            target.parent.mkdir(parents=True, exist_ok=True)
            try:
                torch.hub.download_url_to_file(GITHUB_RELEASE + filename, str(target))
            except Exception as gh_error:  # noqa: BLE001
                raise RuntimeError(
                    f"Could not download '{filename}'.\n  Hugging Face ({HF_REPO}): "
                    f'{type(hf_error).__name__}: {hf_error}\n  GitHub release: {type(gh_error).__name__}: {gh_error}\n'
                    'Download the files manually and pass the folder: PerchV2.from_pretrained("/path/to/folder").'
                ) from gh_error
        return target


def load_labels(path) -> tuple[list[str], list[str]]:
    with open(path, newline='') as fh:
        rows = list(csv.DictReader(fh))
    return [r['label'] for r in rows], [r['ebird_code'] for r in rows]


def load_safetensors(path) -> dict:
    from safetensors.torch import load_file

    return load_file(str(path))
