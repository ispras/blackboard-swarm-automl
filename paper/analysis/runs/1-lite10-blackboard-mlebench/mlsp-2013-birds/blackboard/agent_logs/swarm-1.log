import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import common as C, meta
train, Y, test, _ = C.load_dataset()
r2f = meta.rec2file()
info = {r: meta.parse(r2f[r]) for r in r2f}
def key_sd(r): return (info[r][0], info[r][5])
def key_sdt(r): return (info[r][0], info[r][5], info[r][3])
from collections import Counter
tr_sd = Counter(key_sd(r) for r in train)
te_sd = Counter(key_sd(r) for r in test)
tr_sdt = set(key_sdt(r) for r in train)
print("train station+date groups:", len(tr_sd), "test s+d groups:", len(te_sd))
matched_sd = sum(1 for r in test if key_sd(r) in tr_sd)
matched_sdt = sum(1 for r in test if key_sdt(r) in tr_sdt)
print(f"test recs with s+d match: {matched_sd}/{len(test)}")
print(f"test recs with s+d+t exact session match: {matched_sdt}/{len(test)}")
# distribution of matches
print("per test s+d group train counts:", sorted(tr_sd.get(key_sd(r),0) for r in test))
# label correlation within same s+d: for train pairs
import numpy as np
lab = {r: set(l for l in (C.load_labels()[r] or [])) for r in train}
# average jaccard within same s+d
import random
from itertools import combinations
groups={}
for r in train: groups.setdefault(key_sd(r),[]).append(r)
js=[]
for k,g in groups.items():
    if len(g)>=2:
        for a,b in combinations(g,2):
            A,B=lab[a],lab[b]
            if not A and not B: continue
            u=len(A|B); 
            if u: js.append(len(A&B)/u)
print("mean jaccard same s+d:", np.mean(js) if js else None, "n", len(js))
# same station+date+time
groups={}
for r in train: groups.setdefault(key_sdt(r),[]).append(r)
js=[]
for k,g in groups.items():
    if len(g)>=2:
        for a,b in combinations(g,2):
            A,B=lab[a],lab[b]
            if not A and not B: continue
            u=len(A|B)
            if u: js.append(len(A&B)/u)
print("mean jaccard same exact session:", np.mean(js) if js else None, "n", len(js))
