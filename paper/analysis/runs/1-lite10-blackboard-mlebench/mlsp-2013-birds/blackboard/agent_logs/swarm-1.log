"""Heads and a wrapper for fine-tuning Perch v2.

Heads (the "decoder" on top of the encoder's [B, 16, 4, 1536] spatial embedding):
  * 'pretrained' - Perch's own prototype classifier, restricted to your classes and initialised
                   from the pretrained prototypes of the Perch classes with the same names.
                   Untrained, it reproduces Perch's logits for those classes (zero-shot).
  * 'linear'     - a new linear layer on the mean-pooled 1536-d embedding (linear probe).
  * 'prototype'  - a new, randomly initialised prototype classifier (4 prototypes per class).

PerchWithHead combines the encoder with a head. With train_encoder=False only the head learns and
the encoder output can be cached; with train_encoder=True everything is trained, with batch-norm
statistics kept frozen by default.
"""

import difflib

import torch
import torch.nn.functional as F
from torch import nn

from perchv2_pytorch.model import PerchV2, PrototypeClassifier

HEAD_KINDS = ('pretrained', 'linear', 'prototype')


class LinearHead(nn.Module):
    def __init__(self, num_classes: int, embed_dim: int = PerchV2.embedding_dim, dropout: float = 0.0):
        super().__init__()
        self.dropout = nn.Dropout(dropout)
        self.fc = nn.Linear(embed_dim, num_classes)

    def forward(self, spatial: torch.Tensor) -> torch.Tensor:
        return self.fc(self.dropout(spatial.mean(dim=(1, 2))))


def match_perch_labels(classes: list[str], perch_labels: list[str]) -> list[int]:
    """Index of each class name in Perch's label list; raises with suggestions if one is missing."""
    index = {name: i for i, name in enumerate(perch_labels)}
    missing = [c for c in classes if c not in index]
    if missing:
        hints = []
        for c in missing:
            close = difflib.get_close_matches(c, perch_labels, n=3, cutoff=0.6)
            hints.append(f"  '{c}'" + (f' - did you mean {close}?' if close else ' - no similar Perch label'))
        raise ValueError(
            "The 'pretrained' head needs every class to be a Perch v2 label (scientific names, see "
            'model.labels). Not found:\n' + '\n'.join(hints) +
            "\nRename these classes, or use a new head ('linear' or 'prototype') for classes Perch does not know.")
    return [index[c] for c in classes]


def make_head(kind: str, classes: list[str], base: PerchV2 | None = None, seed: int = 0,
              dropout: float = 0.0) -> nn.Module:
    """Build a head for `classes`. kind='pretrained' needs `base` loaded with its classifier."""
    g = torch.Generator().manual_seed(seed)
    if kind == 'linear':
        return LinearHead(len(classes), dropout=dropout)
    if kind == 'prototype':
        head = PrototypeClassifier(num_classes=len(classes))
        with torch.no_grad():
            # Same element scale as the pretrained prototypes, so the same learning rates work.
            head.prototypes.copy_(0.18 * torch.randn(head.prototypes.shape, generator=g))
            head.prototype_weights.fill_(1.0)
        return head
    if kind == 'pretrained':
        if base is None or base.classifier is None:
            raise ValueError("the 'pretrained' head needs the full model: PerchV2.from_pretrained() "
                             'without embeddings_only=True')
        src = match_perch_labels(classes, base.labels)
        head = PrototypeClassifier(num_classes=len(classes))
        with torch.no_grad():
            head.prototypes.copy_(base.classifier.prototypes[src])
            head.prototype_weights.copy_(base.classifier.prototype_weights[src])
            head.bias.copy_(base.classifier.bias[src])
        return head
    raise ValueError(f'unknown head {kind!r}; choose from {HEAD_KINDS}')


class PerchWithHead(nn.Module):
    """Perch v2 frontend + encoder + a head over your own classes. forward(waveform) -> logits [B, C]."""

    def __init__(self, base: PerchV2, head: nn.Module, classes: list[str], head_kind: str,
                 train_encoder: bool = False, bn_train: bool = False):
        super().__init__()
        self.frontend = base.frontend
        self.encoder = base.encoder
        self.head = head
        self.classes = list(classes)
        self.head_kind = head_kind
        self.train_encoder = train_encoder
        self.bn_train = bn_train
        self.encoder.requires_grad_(train_encoder)

    def train(self, mode: bool = True):
        super().train(mode)
        # A frozen encoder always stays in eval mode. A trained encoder keeps its batch-norm
        # running statistics frozen by default: small datasets would otherwise overwrite them.
        if not self.train_encoder:
            self.encoder.eval()
        elif not self.bn_train:
            for m in self.encoder.modules():
                if isinstance(m, nn.BatchNorm2d):
                    m.eval()
        return self

    def spatial(self, waveform: torch.Tensor) -> torch.Tensor:
        x = self.frontend(waveform)[:, None]
        if x.is_cuda:
            x = x.contiguous(memory_format=torch.channels_last)
        with torch.set_grad_enabled(self.train_encoder and torch.is_grad_enabled()):
            return self.encoder(x).permute(0, 2, 3, 1)

    def forward(self, waveform: torch.Tensor) -> torch.Tensor:
        return self.head(self.spatial(waveform))

    def save(self, path: str) -> None:
        """Save the head, and the encoder only if it was trained (otherwise it is the public one)."""
        ckpt = {'classes': self.classes, 'head_kind': self.head_kind, 'head': self.head.state_dict()}
        if self.train_encoder:
            ckpt['encoder'] = self.encoder.state_dict()
        torch.save(ckpt, path)

    @classmethod
    def load(cls, path: str, base: PerchV2 | None = None, device=None) -> 'PerchWithHead':
        """Load a model written by save(). `base` defaults to the pretrained encoder."""
        ckpt = torch.load(path, map_location='cpu', weights_only=True)
        base = base or PerchV2.from_pretrained(embeddings_only=True)
        kind = 'prototype' if ckpt['head_kind'] == 'pretrained' else ckpt['head_kind']
        model = cls(base, make_head(kind, ckpt['classes']), ckpt['classes'], ckpt['head_kind'])
        model.head.load_state_dict(ckpt['head'])
        if 'encoder' in ckpt:
            model.encoder.load_state_dict(ckpt['encoder'])
        if device is not None:
            model.to(device)
        return model.eval()


def bce_loss(logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
    """Multi-label loss; computed in fp32 so it is safe under fp16 autocast."""
    return F.binary_cross_entropy_with_logits(logits.float(), targets.float())
