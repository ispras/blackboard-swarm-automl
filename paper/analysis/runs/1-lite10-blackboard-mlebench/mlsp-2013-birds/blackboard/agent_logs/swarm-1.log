import os, sys, glob, json
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from features import global_auc, macro_auc, NSPEC
from scipy.stats import rankdata
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline
from sklearn.model_selection import KFold

HERE = os.path.dirname(os.path.abspath(__file__))


def load_members(dirs=(HERE,)):
    members = {}
    for d in dirs:
        for f in sorted(glob.glob(os.path.join(d, "oof_*.npz"))):
            name = os.path.basename(f)[4:-4]
            z = np.load(f, allow_pickle=True)
            if "probs" not in z.files:
                continue
            recs = z["rec_ids"]
            oof = z["probs"]
            if "test_probs" not in z.files:
                continue
            tp = z["test_probs"]
            trecs = z["test_rec_ids"]
            members[name] = dict(recs=recs, oof=oof, test_rec_ids=trecs, test=tp)
    # align all to a common rec order
    base = None
    for n, m in members.items():
        if base is None:
            base = m["recs"]
        assert list(m["recs"]) == list(base), (n,)
    return members


def rank_norm(a):
    """per-column rank normalize to [0,1]"""
    out = np.zeros_like(a, dtype=np.float64)
    for j in range(a.shape[1]):
        r = rankdata(a[:, j])
        out[:, j] = (r - 1) / max(len(r) - 1, 1)
    return out


def blend(names, members, weights=None, use_rank=True):
    if weights is None:
        weights = {n: 1.0 for n in names}
    O = None
    T = None
    for n in names:
        m = members[n]
        o = rank_norm(m["oof"]) if use_rank else m["oof"]
        t = rank_norm(m["test"]) if use_rank else m["test"]
        w = weights[n]
        O = o * w if O is None else O + o * w
        T = t * w if T is None else T + t * w
    return O, T


def eval_names(names, members, Y, use_rank=True, weights=None):
    O, T = blend(names, members, weights, use_rank)
    return global_auc(Y, O), macro_auc(Y, O), O, T


def greedy(members, Y, names=None, n_iter=40, use_rank=True, verbose=False):
    names = names or list(members)
    chosen = {}
    O, T = blend([], members)  # zeros
    O = np.zeros((len(Y), NSPEC)); T = np.zeros((len(next(iter(members.values()))["test"]), NSPEC))
    best = -1
    for it in range(n_iter):
        best_add, best_score = None, best
        for n in names:
            cand = dict(chosen); cand[n] = cand.get(n, 0) + 1
            tot = sum(cand.values())
            w = {k: v / tot for k, v in cand.items()}
            o, t = blend(list(cand), members, w, use_rank)
            s = global_auc(Y, o)
            if s > best_score:
                best_score, best_add = s, n
        if best_add is None:
            break
        chosen[best_add] = chosen.get(best_add, 0) + 1
        best = best_score
        if verbose:
            print(f"  it{it}: +{best_add} -> {best:.4f}")
    tot = sum(chosen.values())
    w = {k: v / tot for k, v in chosen.items()}
    O, T = blend(list(chosen), members, w, use_rank)
    return chosen, w, best, O, T


def nested_greedy_eval(members, Y, seeds=(0, 1), n_splits=5, n_iter=25, use_rank=True):
    scores = []
    for seed in seeds:
        kf = KFold(n_splits=n_splits, shuffle=True, random_state=seed)
        for tri, vai in kf.split(Y):
            sub = {n: dict(recs=m["recs"], oof=m["oof"][tri], test=m["test"], test_rec_ids=m["test_rec_ids"])
                   for n, m in members.items()}
            _, w, _, Osub, _ = greedy(sub, Y[tri], names=list(members), n_iter=n_iter, use_rank=use_rank)
            # apply selected weights to held-out rows
            Ova = None
            for n, wt in w.items():
                o = rank_norm(members[n]["oof"][vai]) if use_rank else members[n]["oof"][vai]
                Ova = o * wt if Ova is None else Ova + o * wt
            scores.append(global_auc(Y[vai], Ova))
    return float(np.mean(scores)), float(np.std(scores))


def stack_logreg(members, Y, Ytest, names=None, C=0.3, seeds=(0, 1, 2), n_splits=5, use_rank=False):
    """Per-species logistic stacking on member predictions. Returns OOF stack, test stack, cv score."""
    names = names or list(members)
    M = len(names)
    nt = Y.shape[0]
    oof_stack = np.zeros((nt, NSPEC))
    test_stack = np.zeros((Ytest.shape[0], NSPEC))
    for j in range(NSPEC):
        X = np.column_stack([(rank_norm(members[n]["oof"])[:, j] if use_rank else members[n]["oof"][:, j]) for n in names])
        Xt = np.column_stack([(rank_norm(members[n]["test"])[:, j] if use_rank else members[n]["test"][:, j]) for n in names])
        y = Y[:, j]
        if y.min() == y.max():
            oof_stack[:, j] = y[0]; test_stack[:, j] = y[0]; continue
        kf = KFold(n_splits=n_splits, shuffle=True, random_state=0)
        for tri, vai in kf.split(X):
            clf = make_pipeline(StandardScaler(), LogisticRegression(C=C, max_iter=3000))
            clf.fit(X[tri], y[tri])
            oof_stack[vai, j] = clf.predict_proba(X[vai])[:, 1]
        clf = make_pipeline(StandardScaler(), LogisticRegression(C=C, max_iter=3000))
        clf.fit(X, y)
        test_stack[:, j] = clf.predict_proba(Xt)[:, 1]
    return oof_stack, test_stack, global_auc(Y, oof_stack), macro_auc(Y, oof_stack)


def nested_topk_eval(members, Y, ks, seeds=(0, 1, 2), n_splits=5, use_rank=False, mode="mean"):
    scored_all = sorted([global_auc(Y, m["oof"]) for m in members.values()], reverse=True)
    names = list(members)
    results = {k: [] for k in ks}
    for seed in seeds:
        kf = KFold(n_splits=n_splits, shuffle=True, random_state=seed)
        for tri, vai in kf.split(Y):
            sub = {n: dict(recs=m["recs"], oof=m["oof"][tri], test=m["test"], test_rec_ids=m["test_rec_ids"])
                   for n, m in members.items()}
            sc = sorted([(global_auc(Y[tri], m["oof"]), n) for n, m in sub.items()], reverse=True)
            for k in ks:
                ns = [n for _, n in sc[:k]]
                Ova = combine(members, ns, vai, use_rank=use_rank, mode=mode)
                results[k].append(global_auc(Y[vai], Ova))
    return {k: (float(np.mean(v)), float(np.std(v))) for k, v in results.items()}


def combine(members, names, rows, use_rank=False, mode="mean"):
    O = None
    for n in names:
        o = members[n]["oof"][rows]
        if use_rank:
            o = rank_norm(o)
        if mode == "logit":
            p = np.clip(o, 1e-6, 1 - 1e-6)
            o = np.log(p / (1 - p))
        O = o.copy() if O is None else O + o
    return O


if __name__ == "__main__":
    from features import load_ids, load_labels, y_matrix
    members = load_members()
    fold = load_ids(); labels = load_labels()
    base = members[list(members)[0]]["recs"]
    Y = y_matrix([int(r) for r in base], labels)
    names_all = list(members)
    print(f"members={len(names_all)}")

    scored = sorted([(global_auc(Y, m["oof"]), macro_auc(Y, m["oof"]), n)
                     for n, m in members.items()], reverse=True)

    print("\n-- simple rank mean --")
    for k in [3, 5, 8, 12, len(names_all)]:
        ns = [n for _, _, n in scored[:k]]
        g, mm, _, _ = eval_names(ns, members, Y, use_rank=True)
        print(f"  top{k:2d} rankmean g={g:.4f} m={mm:.4f}")

    print("\n-- simple prob mean --")
    for k in [3, 5, 8, 12, len(names_all)]:
        ns = [n for _, _, n in scored[:k]]
        g, mm, _, _ = eval_names(ns, members, Y, use_rank=False)
        print(f"  top{k:2d} probmean g={g:.4f} m={mm:.4f}")

    print("\n-- honest nested top-k probmean --")
    ks = [1, 2, 3, 5, 8, 10, 12, 15, 20, len(names_all)]
    res = nested_topk_eval(members, Y, ks, use_rank=False, mode="mean")
    for k in ks:
        print(f"  top{k:2d} nested probmean g={res[k][0]:.4f} +/- {res[k][1]:.4f}")

    print("\n-- honest nested top-k logit-mean --")
    resl = nested_topk_eval(members, Y, ks, use_rank=False, mode="logit")
    for k in ks:
        print(f"  top{k:2d} nested logitmean g={resl[k][0]:.4f} +/- {resl[k][1]:.4f}")

    print("\n-- greedy (full OOF, optimistic) --")
    chosen, w, best, O, T = greedy(members, Y, n_iter=30, use_rank=True)
    print("  weights:", {k: round(v, 3) for k, v in w.items()})
    print(f"  full-OOF g={best:.4f} m={macro_auc(Y, O):.4f}")

    print("\n-- nested greedy eval (honest) --")
    ng, ns_ = nested_greedy_eval(members, Y, seeds=(0, 1, 2), n_iter=25, use_rank=True)
    print(f"  nested g={ng:.4f} +/- {ns_:.4f}")

    print("\n-- logreg stack --")
    for k in [5, 8, 12, len(names_all)]:
        ns = [n for _, _, n in scored[:k]]
        oofs, tests, g, mm = stack_logreg(members, Y, np.zeros((64, NSPEC)), names=ns)
        print(f"  top{k:2d} stack g={g:.4f} m={mm:.4f}")
