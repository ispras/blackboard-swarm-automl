"""Fine-tune Perch v2 on your own labelled recordings.

    python examples/finetune.py --annotations my_labels.csv --audio-dir /path/to/audio --mode new-head

Ground truth is a CSV file (see examples/labels_example.csv):

    filename,labels,split
    frogs/hyla_001.wav,Hyla arborea,train
    frogs/pond_night_03.wav,Hyla arborea;Pelophylax ridibundus,train     <- several labels: separate with ;
    background/rain_01.wav,,train                                        <- no label = negative example
    frogs/hyla_014.wav,Hyla arborea,val

  filename  path relative to --audio-dir (WAV / FLAC / OGG / MP3, any sample rate)
  labels    the classes present anywhere in the recording; every 5 s window inherits them
  split     optional, 'train' or 'val'. Without it, 20% of the files are held out for validation.

Modes (what is trained):
  head      Perch's own classifier head for your classes, encoder frozen. Class names must be
            Perch labels (scientific names, e.g. "Hyla arborea"). Starts from zero-shot Perch.
  new-head  a new linear head on the frozen encoder (linear probe). Any class names. Fast, and
            a strong default.
  full      encoder + head trained together (--full-head new|pretrained). Usually the most
            accurate with enough data; needs a GPU.

The best model (by validation mean average precision) is saved with PerchWithHead.save() and can
be loaded again with PerchWithHead.load() - see the end of this file.
"""

import argparse
import csv
import math
import pathlib
import sys

import numpy as np
import torch

from perchv2_pytorch import PerchV2, PerchWithHead, frame_audio, load_audio, make_head
from perchv2_pytorch.heads import bce_loss

SR, N = PerchV2.sample_rate, PerchV2.window_samples
HERE = pathlib.Path(__file__).resolve().parent


def fail(message: str):
    sys.exit(f'\nERROR: {message}\n')


# --------------------------------------------------------------------------- ground truth + audio

def read_annotations(csv_path: pathlib.Path, audio_dir: pathlib.Path, val_fraction: float, seed: int):
    if not csv_path.is_file():
        fail(f'annotation file not found: {csv_path}')
    with open(csv_path, newline='') as fh:
        reader = csv.DictReader(fh)
        columns = [c.strip() for c in (reader.fieldnames or [])]
        if 'filename' not in columns or 'labels' not in columns:
            fail(f"{csv_path} must have the columns 'filename' and 'labels' (optional: 'split'); found {columns}. "
                 f'See {HERE / "labels_example.csv"}.')
        rows = [{k.strip(): (v or '').strip() for k, v in r.items() if k} for r in reader]
    rows = [r for r in rows if r['filename']]
    if not rows:
        fail(f'{csv_path} contains no recordings')

    if not audio_dir.is_dir():
        fail(f'audio directory not found: {audio_dir}\n'
             'Pass the folder that the filenames in the CSV are relative to with --audio-dir.')
    missing = [r['filename'] for r in rows if not (audio_dir / r['filename']).is_file()]
    if missing:
        shown = '\n'.join(f'    {audio_dir / m}' for m in missing[:10])
        more = f'\n    ... and {len(missing) - 10} more' if len(missing) > 10 else ''
        hint = ('\nThis is the example annotation file: it only shows the format and its audio is not part '
                'of the repository. Point --annotations and --audio-dir at your own data.'
                if csv_path.resolve() == (HERE / 'labels_example.csv').resolve() else
                '\nCheck --audio-dir and that the filenames in the CSV are relative to it.')
        fail(f'{len(missing)} of {len(rows)} audio files listed in {csv_path.name} were not found:\n{shown}{more}{hint}')

    for r in rows:
        r['labels'] = [x.strip() for x in r['labels'].split(';') if x.strip()]
        r['split'] = r.get('split', '').lower()
    bad = sorted({r['split'] for r in rows} - {'', 'train', 'val'})
    if bad:
        fail(f"the 'split' column may only contain 'train' or 'val' (or be empty); found {bad}")
    classes = sorted({c for r in rows for c in r['labels']})
    if not classes:
        fail("no labels found: the 'labels' column is empty for every recording")

    if not any(r['split'] for r in rows):  # no split given: hold out a random part of the files
        rng = np.random.default_rng(seed)
        order = rng.permutation(len(rows))
        n_val = max(1, round(val_fraction * len(rows))) if len(rows) > 1 else 0
        for i, j in enumerate(order):
            rows[j]['split'] = 'val' if i < n_val else 'train'
    for r in rows:
        r['split'] = r['split'] or 'train'

    train = [r for r in rows if r['split'] == 'train']
    val = [r for r in rows if r['split'] == 'val']
    no_train = [c for c in classes if not any(c in r['labels'] for r in train)]
    if no_train:
        fail(f'these classes have no training recording: {no_train}. Add recordings or adjust the split.')
    if not val:
        print('WARNING: no validation recordings; the last epoch will be saved without model selection.')
    return classes, train, val


def load_recordings(rows, audio_dir: pathlib.Path, classes):
    errors = []
    for r in rows:
        try:
            r['audio'] = load_audio(audio_dir / r['filename'])
        except (ValueError, FileNotFoundError) as e:
            errors.append(str(e))
            continue
        if len(r['audio']) < SR // 2:
            errors.append(f"{audio_dir / r['filename']}: only {len(r['audio']) / SR:.2f} s of audio (need at least 0.5 s)")
        r['target'] = torch.tensor([float(c in r['labels']) for c in classes])
    if errors:
        fail(f'{len(errors)} audio files could not be used:\n' + '\n'.join(f'    {e}' for e in errors[:10]) +
             (f'\n    ... and {len(errors) - 10} more' if len(errors) > 10 else ''))


def random_crop(audio: torch.Tensor, rng) -> torch.Tensor:
    if len(audio) <= N:
        return torch.nn.functional.pad(audio, (0, N - len(audio)))
    start = int(rng.integers(0, len(audio) - N + 1))
    return audio[start:start + N]


# ----------------------------------------------------------------------------------- evaluation

def average_precision(scores: np.ndarray, positive: np.ndarray) -> float:
    if positive.sum() == 0:
        return float('nan')
    order = np.argsort(-scores, kind='stable')
    hits = positive[order]
    return float((np.cumsum(hits) / np.arange(1, len(hits) + 1))[hits].mean())


def report(file_logits: np.ndarray, file_targets: np.ndarray, classes) -> tuple[float, list[float]]:
    aps = [average_precision(file_logits[:, c], file_targets[:, c] > 0.5) for c in range(len(classes))]
    return float(np.nanmean(aps)) if not np.all(np.isnan(aps)) else float('nan'), aps


# ----------------------------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0],
                                 epilog='See the top of this file for the CSV format and the modes.')
    ap.add_argument('--annotations', default=str(HERE / 'labels_example.csv'), help='ground-truth CSV')
    ap.add_argument('--audio-dir', default=None, help='folder the CSV filenames are relative to (default: the CSV folder)')
    ap.add_argument('--mode', choices=['head', 'new-head', 'full'], default='new-head')
    ap.add_argument('--full-head', choices=['new', 'pretrained'], default='new', help="head used by --mode full")
    ap.add_argument('--epochs', type=int, default=None, help='default: 30 (head, new-head), 10 (full)')
    ap.add_argument('--batch-size', type=int, default=32)
    ap.add_argument('--lr-head', type=float, default=1e-3)
    ap.add_argument('--lr-encoder', type=float, default=5e-5)
    ap.add_argument('--val-fraction', type=float, default=0.2)
    ap.add_argument('--weights', default=None, help='local folder with the Perch weights (default: download)')
    ap.add_argument('--out', default='finetuned_perch.pt')
    ap.add_argument('--seed', type=int, default=0)
    args = ap.parse_args()

    csv_path = pathlib.Path(args.annotations)
    audio_dir = pathlib.Path(args.audio_dir) if args.audio_dir else csv_path.parent
    classes, train, val = read_annotations(csv_path, audio_dir, args.val_fraction, args.seed)
    load_recordings(train + val, audio_dir, classes)
    hours = sum(len(r['audio']) for r in train + val) / SR / 3600
    print(f'{len(classes)} classes, {len(train)} training / {len(val)} validation recordings, {hours:.2f} h of audio')

    torch.manual_seed(args.seed)
    rng = np.random.default_rng(args.seed)
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    # fp16 autocast on GPU: ~2x faster and less memory, with no measurable loss (the loss itself is fp32).
    amp = dict(device_type=device.type, dtype=torch.float16, enabled=device.type == 'cuda')
    full = args.mode == 'full'
    if full and device.type != 'cuda':
        print('WARNING: --mode full on CPU is very slow; use a GPU or --mode new-head.')

    head_kind = {'head': 'pretrained', 'new-head': 'linear'}.get(args.mode) or \
        ('linear' if args.full_head == 'new' else 'pretrained')
    # The pretrained head needs Perch's classifier; otherwise the 41 MB encoder is enough.
    base = PerchV2.from_pretrained(*( [args.weights] if args.weights else [] ),
                                   embeddings_only=head_kind != 'pretrained')
    try:
        head = make_head(head_kind, classes, base, seed=args.seed)
    except ValueError as e:
        fail(f'{e}\nWith this script: --mode new-head, or --mode full (which uses a new head by default).')
    model = PerchWithHead(base, head, classes, head_kind, train_encoder=full).to(device)

    @torch.no_grad()
    def features(windows: torch.Tensor) -> torch.Tensor:
        """Encoder output for [n, 160000] windows (kept as fp16 on the CPU)."""
        model.eval()
        out = []
        for i in range(0, len(windows), 32):
            with torch.autocast(**amp):
                out.append(model.spatial(windows[i:i + 32].to(device)).half().cpu())
        return torch.cat(out)

    def pooled(spatial: torch.Tensor) -> torch.Tensor:
        # A linear head only needs the mean embedding: store [n, 1, 1, 1536] instead of [n, 16, 4, 1536].
        return spatial.float().mean(dim=(1, 2), keepdim=True).half() if head_kind == 'linear' else spatial

    # Validation windows; with a frozen encoder their features are computed once.
    val_windows = [frame_audio(r['audio']) for r in val]
    val_file = np.concatenate([np.full(len(w), i) for i, w in enumerate(val_windows)]) if val else np.array([], int)
    val_targets = torch.stack([r['target'] for r in val]).numpy() if val else None
    if not full:
        print('computing encoder features (once; the encoder is frozen) ...')
        val_feats = pooled(features(torch.cat(val_windows))) if val else None
        train_windows = [frame_audio(r['audio'], hop_seconds=2.5) for r in train]
        train_feats = pooled(features(torch.cat(train_windows)))
        train_targets = torch.cat([r['target'].expand(len(w), -1) for r, w in zip(train, train_windows)])
        steps_per_epoch = math.ceil(len(train_feats) / args.batch_size)
    else:
        steps_per_epoch = int(np.clip(sum(len(r['audio']) for r in train) / N / args.batch_size, 20, 400))

    @torch.no_grad()
    def validate():
        if not val:
            return float('nan'), []
        model.eval()
        if full:
            x = torch.cat(val_windows)
            logits = []
            for i in range(0, len(x), 32):
                with torch.autocast(**amp):
                    logits.append(model(x[i:i + 32].to(device)).float().cpu())
            logits = torch.cat(logits).numpy()
        else:
            logits = torch.cat([model.head(val_feats[i:i + 256].to(device).float()).cpu()
                                for i in range(0, len(val_feats), 256)]).numpy()
        file_logits = np.full((len(val), len(classes)), -np.inf)
        np.maximum.at(file_logits, val_file, logits)          # a recording scores the max of its windows
        return report(file_logits, val_targets, classes)

    epochs = args.epochs if args.epochs is not None else (10 if full else 30)
    groups = [{'params': model.head.parameters(), 'lr': args.lr_head}]
    if full:  # the pretrained encoder gets a much smaller learning rate than the head
        groups.append({'params': model.encoder.parameters(), 'lr': args.lr_encoder})
    opt = torch.optim.AdamW(groups, weight_decay=1e-4)
    total = max(1, epochs * steps_per_epoch)
    sched = torch.optim.lr_scheduler.LambdaLR(
        opt, lambda s: min(1.0, (s + 1) / min(100, total // 10 + 1)) * 0.5 * (1 + math.cos(math.pi * min(s, total) / total)))
    scaler = torch.amp.GradScaler(enabled=full and device.type == 'cuda')

    best_map, best_aps = validate()
    print(f'epoch  0  ' + ('zero-shot Perch ' if head_kind == 'pretrained' else 'untrained head ') + f'val mAP {best_map:.3f}')
    model.save(args.out)
    for epoch in range(1, epochs + 1):
        model.train()   # keeps a frozen encoder (and batch-norm statistics) in eval mode
        losses = []
        order = torch.randperm(len(train_feats)) if not full else None
        for step in range(steps_per_epoch):
            if full:
                picks = rng.integers(0, len(train), args.batch_size)
                gain = 10 ** (rng.uniform(-12, 6, args.batch_size) / 20)        # random level
                x = torch.stack([random_crop(train[i]['audio'], rng) * g for i, g in zip(picks, gain)])
                t = torch.stack([train[i]['target'] for i in picks])
                with torch.autocast(**amp):
                    logits = model(x.to(device))
            else:
                idx = order[step * args.batch_size:(step + 1) * args.batch_size]
                t = train_targets[idx]
                logits = model.head(train_feats[idx].to(device).float())
            loss = bce_loss(logits, t.to(device))     # multi-label: one sigmoid per class
            opt.zero_grad(set_to_none=True)
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            scaler.step(opt)
            scaler.update()
            sched.step()
            losses.append(loss.item())
        val_map, aps = validate()
        improved = not val or val_map > best_map
        if improved:
            best_map, best_aps = val_map, aps
            model.save(args.out)
        print(f'epoch {epoch:2d}  loss {np.mean(losses):.4f}  val mAP {val_map:.3f}' + ('  *' if improved and val else ''))

    if val:
        print(f'\nbest validation mAP {best_map:.3f}; average precision per class (recording level):')
        for c, a in zip(classes, best_aps):
            print(f'    {c:36s} {a:.3f}' if not math.isnan(a) else f'    {c:36s} (no validation recording)')
    print(f'\nsaved {args.out}. Use it like this:\n'
          '    from perchv2_pytorch import PerchWithHead, load_audio, frame_audio\n'
          f"    model = PerchWithHead.load('{args.out}')\n"
          "    logits = model(frame_audio(load_audio('recording.wav')))   # [windows, classes], order = model.classes\n"
          '    probabilities = logits.sigmoid()')


if __name__ == '__main__':
    main()
