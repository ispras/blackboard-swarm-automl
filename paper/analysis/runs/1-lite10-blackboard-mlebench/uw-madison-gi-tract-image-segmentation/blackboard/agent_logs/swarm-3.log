m=pd.read_csv('workspaces/regulus_alpha/cache/test_meta_320.csv').set_index('id')
def dec(seg,h,w,order):
    s=np.array(str(seg).split(),dtype=np.int64); out=np.zeros(h*w,dtype=np.uint8)
    for st,ln in zip(s[0::2]-1,s[1::2]): out[st:st+ln]=1
    return out.reshape((h,w),order=order)
nc=[];cnt=0
