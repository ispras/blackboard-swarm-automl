    ds=[]
    for c in range(3):
        p=pred[:,c].reshape(len(pred),-1); g=gt[:,c].reshape(len(gt),-1)
        inter=(p&g).sum(1); s=p.sum(1)+g.sum(1)
        d=np.where(s>0,2*inter/np.maximum(s,1),1.0)
        ds.append(d.mean())
    print("thr",thr,"per_cls",[round(float(x),4) for x in ds],"mean",round(float(np.mean(ds)),4))
