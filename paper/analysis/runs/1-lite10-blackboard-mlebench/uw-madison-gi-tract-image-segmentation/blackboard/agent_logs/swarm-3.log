# C connectivity on non-square
m=pd.read_csv('workspaces/regulus_alpha/cache/test_meta_320.csv').set_index('id')
def dec(seg,h,w):
    s=np.array(str(seg).split(),dtype=np.int64); out=np.zeros(h*w,dtype=np.uint8)
    for st,ln in zip(s[0::2]-1,s[1::2]): out[st:st+ln]=1
    return out.reshape((h,w),order='C')
nc=[];cnt=0
for _,r in sub[sub['predicted'].astype(str).str.len()>0].iterrows():
    p=m.loc[r['id'],'path']; b=os.path.basename(p).replace('.png','').split('_'); h,w=int(b[3]),int(b[2])
    if h==w: continue
    mm=dec(r['predicted'],h,w); lab,n=label(mm); nc.append(n); cnt+=1
    if cnt>=80: break
print('C-decode non-square mean comps',round(float(np.mean(nc)),2),'n',len(nc))
EOF
