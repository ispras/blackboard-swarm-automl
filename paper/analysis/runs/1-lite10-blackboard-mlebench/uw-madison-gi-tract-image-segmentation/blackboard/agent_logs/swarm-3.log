import sys; sys.path.insert(0,"workspaces/regulus_alpha")
import numpy as np, pandas as pd, torch, json
import segmentation_models_pytorch as smp
from train import GISeg, build_prev_next, batch_dice
m=pd.read_csv("workspaces/regulus_alpha/cache/train_meta_320.csv")
img=np.memmap("workspaces/regulus_alpha/cache/train_img_320.dat",dtype=np.uint8,mode="r",shape=(len(m),320,320))
msk=np.memmap("workspaces/regulus_alpha/cache/train_msk_320.dat",dtype=np.uint8,mode="r",shape=(len(m),3,320,320))
vj=json.load(open("workspaces/regulus_alpha/val_cases.json")); vs=set(vj["val_cases"])
isv=m["case"].isin(vs).values
prev,nxt=build_prev_next(m)
ck=torch.load("workspaces/regulus_alpha/runs/mit_b2_mc/best.pt",map_location="cpu")
net=smp.Unet(encoder_name="mit_b2",encoder_weights=None,in_channels=3,classes=4).cuda().eval(); net.load_state_dict(ck["model"])
def ev(gidx):
    ds=GISeg(gidx,prev[gidx],nxt[gidx],img,msk,train=False,size=320,multiclass=True)
    from torch.utils.data import DataLoader
    dl=DataLoader(ds,batch_size=32)
    ds_all=[]; ds_pos=[]
    with torch.no_grad():
        for x,y in dl:
            o=net(x.cuda()); pr=o.argmax(1)
            p=torch.stack([pr==(c+1) for c in range(3)],1); g=torch.stack([y.cuda()==(c+1) for c in range(3)],1)
            d=batch_dice(p,g); ds_all.append(d.cpu()); has=g.sum((2,3))>0; ds_pos.append(d[has.cpu()])
    d=torch.cat(ds_all); dp=torch.cat(ds_pos)
    return d.mean().item(), dp.mean().item()
tri=np.where(~isv)[0][::20][:2000]; vai=np.where(isv)[0][::20][:800]
print("train2000 dice",ev(tri)); print("val800 dice",ev(vai))
EOF' 2>&1 | tail -4
