p='workspaces/regulus_alpha/metric.py'
s=open(p).read()
old='''def hd3d(gt3, pred3, z_norm=True):
    """gt3,pred3: (Z,H,W) bool. Returns normalized bounded distance in [0,inf) ~[0,1]."""
    Z, H, W = gt3.shape
    a = np.argwhere(gt3)
    b = np.argwhere(pred3)
    if len(a) == 0 and len(b) == 0:
        return 0.0
    if len(a) == 0 or len(b) == 0:
        return 1.0
    sz = (1.0 / Z) if z_norm else 1.0
    sampling = (sz, 1.0 / H, 1.0 / W)
    d1 = directed_hd(a, pred3, sampling)
    d2 = directed_hd(b, gt3, sampling)
    return min(max(d1, d2), 1.0)'''
new='''def hd3d(gt3, pred3, z_norm=True):
    """gt3,pred3: (Z,H,W) bool. Returns normalized bounded distance in [0,1]."""
    Z, H, W = gt3.shape
    a = np.argwhere(gt3)
    b = np.argwhere(pred3)
    if len(a) == 0 and len(b) == 0:
        return 0.0
    if len(a) == 0 or len(b) == 0:
        return 1.0
    # crop to union bbox (translation invariant, distances unchanged)
    lo = np.minimum(a.min(0), b.min(0))
    hi = np.maximum(a.max(0), b.max(0)) + 1
    sl = tuple(slice(int(lo[k]), int(hi[k])) for k in range(3))
    g = gt3[sl]; p = pred3[sl]
    a2 = np.argwhere(g); b2 = np.argwhere(p)
    sz = (1.0 / Z) if z_norm else 1.0
    sampling = (sz, 1.0 / H, 1.0 / W)
    d1 = directed_hd(a2, p, sampling)
    d2 = directed_hd(b2, g, sampling)
    return min(max(d1, d2), 1.0)'''
assert old in s
open(p,'w').write(s.replace(old,new))
print('patched')
EOF
