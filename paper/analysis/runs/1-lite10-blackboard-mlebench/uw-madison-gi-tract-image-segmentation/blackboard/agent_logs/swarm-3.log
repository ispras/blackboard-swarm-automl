    v=s.split()
    if len(v)%2: ok=False; break
    a=np.array(v,dtype=np.int64); st,ln=a[0::2],a[1::2]
    if (st<1).any() or (ln<1).any() or (np.diff(st)<=0).any() or (st[1:]<= (st+ln-1)[:-1]).any(): ok=False; break
print('RLE valid:',ok)
