ncomp=[]; cnt=0
for _,r in d[d['predicted'].notna()].iterrows():
    p=m.loc[r['id'],'path']; b=os.path.basename(p).replace('.png','').split('_'); h,w=int(b[3]),int(b[2])
    if h==w: continue
    mm=dec(r['predicted'],h,w,'C'); lab,n=label(mm); sz=np.bincount(lab.ravel()); sz[0]=0
    ncomp.append(n); cnt+=1
    if cnt>=40: break
print('C mean ncomp',round(np.mean(ncomp),2),'n',len(ncomp))
