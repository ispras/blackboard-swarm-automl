import pandas as pd, numpy as np, os
from scipy.ndimage import label
d=pd.read_csv('final_solution/submission.csv'); m=pd.read_csv('workspaces/regulus_alpha/cache/test_meta_320.csv').set_index('id')
def dec(seg,h,w,order):
    s=np.array(str(seg).split(),dtype=np.int64); out=np.zeros(h*w,dtype=np.uint8)
    for st,ln in zip(s[0::2]-1,s[1::2]): out[st:st+ln]=1
    return out.reshape((h,w),order=order)
for order in ['C','F']:
    nc=[];cnt=0
    for _,r in d[d['predicted'].notna()].iterrows():
        p=m.loc[r['id'],'path']; b=os.path.basename(p).replace('.png','').split('_'); h,w=int(b[3]),int(b[2])
        if h==w: continue
        mm=dec(r['predicted'],h,w,order); lab,n=label(mm); sz=np.bincount(lab.ravel()); sz[0]=0
        nc.append(n); cnt+=1
        if cnt>=60: break
    print(order,'mean ncomp',round(float(np.mean(nc)),2),'n',len(nc))
EOF
