    if h==w: continue
    mm=dec(r['predicted'],h,w,'C'); lab,n=label(mm); sz=np.bincount(lab.ravel()); sz[0]=0
    nc.append(n); cnt+=1
    if cnt>=40: break
print('C mean ncomp',round(np.mean(nc),2))
EOF
