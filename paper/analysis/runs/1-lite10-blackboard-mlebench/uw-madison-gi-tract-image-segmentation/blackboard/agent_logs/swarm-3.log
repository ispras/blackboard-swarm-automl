import pandas as pd, numpy as np, cv2, os
from scipy.ndimage import label
meta=pd.read_csv('workspaces/regulus_alpha/cache/train_meta_320.csv').set_index('id')
df=pd.read_csv('data/train.csv'); df=df[df.segmentation.notna()]
def dec(seg,h,w,order):
    s=np.array(seg.split(),dtype=np.int64)
    out=np.zeros(h*w,dtype=np.uint8)
    for st,ln in zip(s[0::2]-1,s[1::2]): out[st:st+ln]=1
    return out.reshape((h,w),order=order)
# find non-square slices with big stomach mask
cands=[]
for _,r in df.iterrows():
    p=meta.loc[r['id'],'path']; b=os.path.basename(p).replace('.png','').split('_'); h,w=int(b[3]),int(b[2])
    if h!=w: cands.append((r['id'],r['class'],r['segmentation'],h,w))
    if len(cands)>=200: break
print('non-square candidates',len(cands), 'example h,w',cands[0][3],cands[0][4])
# pick stomach
st=[c for c in cands if c[1]=='stomach'][:6]
for sid,cls,seg,h,w in st:
    mF=dec(seg,h,w,'F'); mC=dec(seg,h,w,'C')
    def stat(m):
        lab,n=label(m); sz=np.bincount(lab.ravel()); sz[0]=0
        return n, (sz.max()/max(1,m.sum()))
    print(sid,h,w,'F',stat(mF),'C',stat(mC))
# save overlays for first stomach non-square
sid,cls,seg,h,w=st[0]
p=meta.loc[sid,'path']; im=cv2.imread(p,cv2.IMREAD_UNCHANGED).astype(np.float32)
im=(im-im.min())/(im.max()-im.min()+1e-6)*255
for order in ['F','C']:
    m=dec(seg,h,w,order)
    rgb=np.stack([im]*3,-1).astype(np.uint8)
    cont,_=cv2.findContours(m.astype(np.uint8),cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_SIMPLE)
    cv2.drawContours(rgb,cont,-1,(255,0,0),2)
    cv2.imwrite(f'workspaces/regulus_alpha/overlay_{order}.png',cv2.cvtColor(rgb,cv2.COLOR_RGB2BGR))
print('saved overlays for',sid,cls,'h,w',h,w)
