import sys, os, argparse, json
import numpy as np, pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import hausdorff3d
ROOT="/download_job_code/payload/sandbox"; CLASSES=["large_bowel","small_bowel","stomach"]
ap=argparse.ArgumentParser(); ap.add_argument("--w",required=True); ap.add_argument("--thr",default="0.50,0.45,0.40")
a=ap.parse_args(); w=[float(x) for x in a.w.split(",")]; wsum=sum(w); w=[x/wsum for x in w]
thr=[float(x) for x in a.thr.split(",")]
base=pd.read_csv("workspaces/aldebaran_omicron/probs/val_A_AC_probs_index.csv").reset_index(drop=True)
ids=base.id.tolist()
models=[("workspaces/aldebaran_omicron/probs/val_A_AC_probs.npy","workspaces/aldebaran_omicron/probs/val_A_AC_probs_index.csv"),
        ("workspaces/regulus_alpha/probs/val_B2_ep6_probs.npy","workspaces/regulus_alpha/probs/val_B2_ep6_ids.csv"),
        ("workspaces/regulus_alpha/probs/val_C3.npy","workspaces/regulus_alpha/probs/val_C3_ids.csv")]
N=len(ids); out=np.zeros((N,3,320,320),np.uint8)
step=512
for s in range(0,N,step):
    e=min(N,s+step); acc=np.zeros((e-s,3,320,320),np.float32)
    for wi,(p,idf) in enumerate(models):
        pr=np.load(p,mmap_mode="r"); ii=pd.read_csv(idf); col="id" if "id" in ii.columns else ii.columns[0]
        mp={x:j for j,x in enumerate(ii[col])}
        for k in range(s,e):
            j=mp.get(ids[k])
            if j is not None: acc[k-s]+=w[wi]*pr[j].astype(np.float32)
    out[s:e]=(acc).round().clip(0,255).astype(np.uint8)
cidx=pd.read_csv(f"{ROOT}/data/cache_train_320/index.csv"); id2row=dict(zip(cidx.id,range(len(cidx))))
masks=np.load(f"{ROOT}/data/cache_train_320/masks_u8.npy",mmap_mode="r")
base["row"]=np.arange(N)
groups=[(cd,sub.sort_values("slice_int")["row"].values) for cd,sub in base.groupby("case_day")]
tot_d=0.0; tot_h=0.0; rows=[]
for ci,c in enumerate(CLASSES):
    dsum=0.0; dn=0; hs=0.0
    for cd,idxs in groups:
        gv=np.stack([(masks[id2row[base.at[i,"id"]]]==ci+1) for i in idxs],0).transpose(1,2,0).astype(bool)
        pv=np.stack([out[i,ci].astype(np.float32)/255.0 for i in idxs],0).transpose(1,2,0)
        pred=pv>thr[ci]
        ps=pred.sum(axis=(0,1)); gs=gv.sum(axis=(0,1)); isl=np.logical_and(pred,gv).sum(axis=(0,1))
        s2=ps+gs; d=np.where(s2>0,2*isl/np.maximum(s2,1),1.0); dsum+=d.sum(); dn+=len(d)
        if pred.any() and gv.any():
            hd=hausdorff3d(pred,gv); hs+=1-min(1.0,hd/320.0)
        elif not pred.any() and not gv.any(): hs+=1.0
        else: hs+=0.0
    dice=dsum/dn; hdsc=hs/len(groups); combo=0.4*dice+0.6*hdsc
    rows.append((c,round(dice,4),round(hdsc,4),round(combo,4))); tot_d+=dice; tot_h+=hdsc
od=tot_d/3; oh=tot_h/3; oc=0.4*od+0.6*oh
print("w",w,"per_class",rows); print("OVERALL dice %.4f hd %.4f combo %.4f"%(od,oh,oc))
PY
