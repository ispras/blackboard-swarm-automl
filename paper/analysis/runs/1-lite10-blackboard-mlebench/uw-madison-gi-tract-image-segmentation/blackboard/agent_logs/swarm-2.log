import sys
import numpy as np, pandas as pd
sub=pd.read_csv("final_solution/submission.csv")
te=pd.read_csv("data/test.csv")
idx=pd.read_csv("data/cache_test_320/index.csv")
hw=dict(zip(idx.id,zip(idx.orig_h,idx.orig_w)))
print("rows",len(sub),"cols",list(sub.columns))
print("rowset",set(zip(sub.id,sub['class']))==set(zip(te.id,te['class'])))
print("order",len(sub)==len(te) and (sub.id.values==te.id.values).all() and (sub['class'].values==te['class'].values).all())
bad=0; maxratio=0.0; nz=0
for r in sub.itertuples(index=False):
    pred=r[2]
    if not isinstance(pred,str) or pred.strip()=="":
        continue
    nz+=1
    s=pred.split()
    if len(s)%2: bad+=1; continue
    st=np.array(s[0::2],np.int64); ln=np.array(s[1::2],np.int64)
    h,w=hw[r.id]; tot=h*w
    if (ln<=0).any() or (st<=0).any() or (np.diff(st)<=0).any(): bad+=1; continue
    ends=st+ln-1
    if (ends>=tot).any(): bad+=1
    if len(st)>1 and (st[1:]<=ends[:-1]).any(): bad+=1
    maxratio=max(maxratio,float(ends.max())/tot)
print("nonempty",nz,"frac",round(nz/len(sub),4),"bad rows",bad,"max end/total",round(maxratio,4))
print("nonempty by class",sub.assign(nz=sub.predicted.notna()).groupby('class').nz.mean().round(4).to_dict())
print("train rates",pd.read_csv("data/train.csv").assign(nz=lambda d:d.segmentation.notna()).groupby('class').nz.mean().round(4).to_dict())
