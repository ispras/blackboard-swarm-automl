import pandas as pd, numpy as np, re, glob, cv2
from scipy import ndimage
d=pd.read_csv("workspaces/aldebaran_omicron/probs/cand_final_alldata_zs_v2_ordered.csv")
nz=d[d.predicted.notna()].reset_index(drop=True)
acc={c:[] for c in ["large_bowel","small_bowel","stomach"]}
comp={c:[] for c in ["large_bowel","small_bowel","stomach"]}
n=0
for _,r in nz.iterrows():
    cls=r["class"]
    m=re.match(r"(case\d+)_(day\d+)_slice_(\d+)$",r["id"])
    g=glob.glob(f"data/test/{m.group(1)}/{m.group(1)}_{m.group(2)}/scans/slice_{m.group(3)}_*.png")
    if not g: continue
    H,W=cv2.imread(g[0],cv2.IMREAD_UNCHANGED).shape
    s=str(r["predicted"]).split(); st=np.array(s[0::2],int)-1; ln=np.array(s[1::2],int)
    flat=np.zeros(H*W,np.uint8)
    for a,b in zip(st,ln): flat[a:a+b]=1
    mk=flat.reshape(H,W,order="C")
    acc[cls].append(mk.sum()/(H*W))
    if H!=W:
        _,k=ndimage.label(mk,np.ones((3,3))); comp[cls].append(k)
    n+=1
    if n>=900: break
for c in acc:
    v=acc[c]; print(c,"n",len(v),"median",round(float(np.median(v)),4),"p90",round(float(np.percentile(v,90)),4),"max",round(float(np.max(v)),4),"frac>0.5",round(float(np.mean(np.array(v)>0.5)),4))
    if comp[c]: print("   nonsquare comps median",round(float(np.median(comp[c])),2))
