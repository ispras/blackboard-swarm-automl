import sys, os
import numpy as np, pandas as pd
from scipy import ndimage
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import hausdorff3d
ROOT="/download_job_code/payload/sandbox"; CLASSES=["large_bowel","small_bowel","stomach"]
meta=pd.read_csv("workspaces/aldebaran_omicron/probs/val_A_AC_probs_index.csv").reset_index(drop=True)
probs=np.load("workspaces/aldebaran_omicron/probs/val_fused3_zs15.npy",mmap_mode="r")
cidx=pd.read_csv(f"{ROOT}/data/cache_train_320/index.csv"); id2row=dict(zip(cidx.id,range(len(cidx))))
masks=np.load(f"{ROOT}/data/cache_train_320/masks_u8.npy",mmap_mode="r")
thrs=[0.50,0.45,0.40]
meta["row"]=np.arange(len(meta))
groups=[(cd,sub.sort_values("slice_int")["row"].values) for cd,sub in meta.groupby("case_day")]
st=np.zeros((3,3),np.uint8)
for ci,c in enumerate(CLASSES):
    vol=[]
    for cd,idxs in groups:
        gv=np.stack([(masks[id2row[meta.at[i,"id"]]]==ci+1) for i in idxs],0).transpose(1,2,0).astype(bool)
        pv=np.stack([probs[i,ci].astype(np.float32)/255.0 for i in idxs],0).transpose(1,2,0)
        vol.append((gv,pv))
    for dil in [0,1,2]:
        dsum=0.0;dn=0;hs=0.0
        for gv,pv in vol:
            pred=pv>thrs[ci]
            if dil>0:
                pred=np.stack([ndimage.binary_dilation(pred[:,:,z],st) for z in range(pred.shape[2])],2)
            ps=pred.sum(axis=(0,1)); gs=gv.sum(axis=(0,1)); isl=np.logical_and(pred,gv).sum(axis=(0,1))
            s2=ps+gs; d=np.where(s2>0,2*isl/np.maximum(s2,1),1.0); dsum+=d.sum(); dn+=len(d)
            if pred.any() and gv.any(): hs+=1-min(1.0,hausdorff3d(pred,gv)/320.0)
            elif not pred.any() and not gv.any(): hs+=1.0
        dice=dsum/dn; hd=hs/len(vol); combo=0.4*dice+0.6*hd
        print(c,"dil",dil,"dice %.4f hd %.4f combo %.4f"%(dice,hd,combo))
PY
