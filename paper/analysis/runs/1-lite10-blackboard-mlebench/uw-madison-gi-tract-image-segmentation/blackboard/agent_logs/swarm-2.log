def dec(rle,h,w):
    s=str(rle).split(); st=np.array(s[0::2],int)-1; ln=np.array(s[1::2],int); flat=np.zeros(h*w,np.uint8)
    for a,b in zip(st,ln): flat[a:a+b]=1
    return flat.reshape(h,w,order="C")
cc=[];n=0
for r in sub[sub.predicted.notna()].itertuples(index=False):
    m=re.match(r"(case\d+)_(day\d+)_slice_(\d+)$",r.id); g=glob.glob(f"data/test/{m.group(1)}/{m.group(1)}_{m.group(2)}/scans/slice_{m.group(3)}_*.png")
    if not g: continue
    H,W=cv2.imread(g[0],cv2.IMREAD_UNCHANGED).shape
    if H==W: continue
    mk=dec(r.predicted,H,W); _,k=ndimage.label(mk,np.ones((3,3))); cc.append(k); n+=1
    if n>=200: break
print("nonsquare C mean comps",round(float(np.mean(cc)),2),"n",n)
