import sys, os, argparse
import numpy as np, pandas as pd
ROOT="/download_job_code/payload/sandbox"
ap=argparse.ArgumentParser(); ap.add_argument("--prob",required=True); ap.add_argument("--index",required=True)
ap.add_argument("--thr",default="0.5,0.5,0.5"); ap.add_argument("--min_size",type=int,default=0)
a=ap.parse_args()
thr=[float(x) for x in a.thr.split(",")]
meta=pd.read_csv(a.index).reset_index(drop=True)
probs=np.load(a.prob,mmap_mode="r")
cidx=pd.read_csv(f"{ROOT}/data/cache_train_320/index.csv")
m=dict(zip(cidx.id, range(len(cidx))))
masks=np.load(f"{ROOT}/data/cache_train_320/masks_u8.npy",mmap_mode="r")
from scipy import ndimage
acc=np.zeros(3); posacc=np.zeros(3); posn=np.zeros(3); n=0
for i,r in enumerate(meta.itertuples(index=False)):
    gi=m.get(r.id)
    if gi is None: continue
    g=masks[gi]
    for c in range(3):
        gt=(g==c+1)
        pr=probs[i,c]/255.0>thr[c]
        if a.min_size>0 and pr.any():
            lab,kk=ndimage.label(pr,np.ones((3,3)))
            if kk>1:
                sz=ndimage.sum(pr,lab,range(1,kk+1)); keep=sz>=a.min_size
                pr=keep[lab-1] if keep.any() else np.zeros_like(pr)
        s=pr.sum()+gt.sum()
        d=1.0 if s==0 else 2.0*np.logical_and(pr,gt).sum()/s
        acc[c]+=d
        if gt.sum()>0:
            posacc[c]+=d; posn[c]+=1
    n+=1
print("n",n,"dice_per_class",(acc/n).round(4),"mean",round(float(acc.mean()/n),4))
print("pos_only_per_class",(posacc/np.maximum(posn,1)).round(4),"pos_counts",posn.astype(int))
