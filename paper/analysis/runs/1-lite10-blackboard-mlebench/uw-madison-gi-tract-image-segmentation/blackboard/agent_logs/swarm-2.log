import pandas as pd, numpy as np, re, os
from scipy import ndimage
sub=pd.read_csv("final_solution/submission.csv")
te=pd.read_csv("data/test.csv")
print("rows",len(sub),"expected",len(te),"cols",list(sub.columns))
print("ids match order", (sub.id.values==te.id.values).all() if len(sub)==len(te) else "len mismatch")
nz=sub[sub.predicted.notna()].copy(); print("nonempty frac",len(nz)/len(sub))
# focused non-square decode test
def dec(rle,h,w,order):
    s=str(rle).split()
    if len(s)==0: return np.zeros((h,w),np.uint8)
    st=np.array(s[0::2],int)-1; ln=np.array(s[1::2],int); flat=np.zeros(h*w,np.uint8)
    for a,b in zip(st,ln): flat[a:a+b]=1
    return flat.reshape(h,w,order=order)
# map test non-square ids
import glob
cmp_c=[];cmp_f=[]
cnt=0
for r in nz.itertuples(index=False):
    m=re.match(r"(case\d+)_(day\d+)_slice_(\d+)$",r.id)
    if not m: continue
    g=glob.glob(f"data/test/{m.group(1)}/{m.group(1)}_{m.group(2)}/scans/slice_{m.group(3)}_*.png")
    if not g: continue
    import cv2
    H,W=cv2.imread(g[0],cv2.IMREAD_UNCHANGED).shape
    if H==W: continue
    for o,acc in [("C",cmp_c),("F",cmp_f)]:
        mk=dec(r.predicted,H,W,o)
        if mk.sum()==0: acc.append(0); continue
        lab,n=ndimage.label(mk,np.ones((3,3))); acc.append(n)
    cnt+=1
    if cnt>=300: break
print("nonsquare rows sampled",cnt,"mean comps C",round(float(np.mean(cmp_c)),2),"F",round(float(np.mean(cmp_f)),2))
