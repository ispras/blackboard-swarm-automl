def dec(rle,h,w):
    s=rle.split(); st=np.array(s[0::2],int)-1; ln=np.array(s[1::2],int)
    flat=np.zeros(h*w,np.uint8)
    for a,b in zip(st,ln): flat[a:a+b]=1
    return flat.reshape(h,w,order="F")
for cls in ["large_bowel","small_bowel","stomach"]:
    rle=piv.at[rid,cls]
    if not isinstance(rle,str): continue
    a=dec(rle,310,360); b=dec(rle,360,310)
    a320=cv2.resize(a,(320,320),interpolation=cv2.INTER_NEAREST)
    b320=cv2.resize(b,(320,320),interpolation=cv2.INTER_NEAREST)
    cmask=(cm==["large_bowel","small_bowel","stomach"].index(cls)+1)
    def iou(x,y): return (x&y).sum()/max(1,(x|y).sum())
    print(cls,"iou correct-vs-canopus",round(float(iou(a320>0,cmask)),3),"wrong-vs-canopus",round(float(iou(b320>0,cmask)),3),"area",a.sum(),b.sum(),cmask.sum())
