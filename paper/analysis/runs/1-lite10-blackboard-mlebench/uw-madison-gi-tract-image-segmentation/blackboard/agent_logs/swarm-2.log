import sys, os, argparse, json
import numpy as np, pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import dice3d, hausdorff3d
from scipy import ndimage
ROOT="/download_job_code/payload/sandbox"
CLASSES=["large_bowel","small_bowel","stomach"]
ap=argparse.ArgumentParser()
ap.add_argument("--prob",required=True); ap.add_argument("--index",required=True)
ap.add_argument("--thr",default="0.5,0.5,0.5"); ap.add_argument("--min_size",default="0,0,0")
ap.add_argument("--largest3d",action="store_true")
a=ap.parse_args()
thr=[float(x) for x in a.thr.split(",")]; mn=[int(x) for x in a.min_size.split(",")]
meta=pd.read_csv(a.index).reset_index(drop=True)
probs=np.load(a.prob,mmap_mode="r")
cidx=pd.read_csv(f"{ROOT}/data/cache_train_320/index.csv")
m=dict(zip(cidx.id,range(len(cidx))))
masks=np.load(f"{ROOT}/data/cache_train_320/masks_u8.npy",mmap_mode="r")
rows=[]
meta["row"]=np.arange(len(meta))
for cd,sub in meta.groupby("case_day"):
    sub=sub.sort_values("slice_int")
    idxs=sub["row"].values
    for ci,c in enumerate(CLASSES):
        gv=[];pv=[]
        for i in idxs:
            gi=m[meta.at[i,"id"]]
            gv.append(masks[gi]==ci+1)
            pr=(probs[i,ci]/255.0>thr[ci])
            if mn[ci]>0 and pr.any():
                lab,n=ndimage.label(pr,np.ones((3,3)))
                if n>1:
                    sz=ndimage.sum(pr,lab,range(1,n+1)); keep=sz>=mn[ci]
                    pr=keep[lab-1] if keep.any() else np.zeros_like(pr)
            pv.append(pr)
        g=np.stack(gv,0).transpose(1,2,0).astype(bool)
        p=np.stack(pv,0).transpose(1,2,0).astype(bool)
        if a.largest3d and p.any():
            lab,n=ndimage.label(p,np.ones((3,3,3)))
            if n>1:
                sz=ndimage.sum(p,lab,range(1,n+1)); keep=np.argmax(sz)+1
                p=lab==keep
        d1=dice3d(p,g,1.0); d0=dice3d(p,g,0.0)
        H,W,Z=g.shape
        if p.any() and g.any():
            hd=hausdorff3d(p,g,spacing=(1,1,1)); hdn=min(1.0,hd/max(H,W))
        elif not p.any() and not g.any(): hdn=0.0
        else: hdn=1.0
        rows.append((cd,c,d1,d0,hdn,0.4*d1+0.6*(1-hdn),bool(g.any())))
df=pd.DataFrame(rows,columns=["cd","cls","dice1","dice0","hdn","combo","gtpos"])
print(json.dumps({k:round(float(df[k].mean()),4) for k in ["dice1","dice0","hdn","combo"]}))
print("gtpos_vols",int(df.gtpos.sum()),"/",len(df))
print("combo gtpos",round(float(df[df.gtpos].combo.mean()),4),"combo gtneg",round(float(df[~df.gtpos].combo.mean()),4))
print("per_class",df.groupby("cls")[["dice1","combo"]].mean().round(4).to_dict())
