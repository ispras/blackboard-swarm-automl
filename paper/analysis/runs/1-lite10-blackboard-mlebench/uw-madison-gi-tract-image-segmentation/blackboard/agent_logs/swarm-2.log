import sys, os, json, argparse
import numpy as np, pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import hausdorff3d
ROOT="/download_job_code/payload/sandbox"; CLASSES=["large_bowel","small_bowel","stomach"]
ap=argparse.ArgumentParser(); ap.add_argument("--prob",required=True); ap.add_argument("--index",required=True)
ap.add_argument("--grid",default="0.35,0.425,0.50,0.575,0.65"); ap.add_argument("--sigma",type=float,default=0)
a=ap.parse_args()
meta=pd.read_csv(a.index).reset_index(drop=True)
probs=np.load(a.prob,mmap_mode="r")
cidx=pd.read_csv(f"{ROOT}/data/cache_train_320/index.csv"); id2row=dict(zip(cidx.id,range(len(cidx))))
masks=np.load(f"{ROOT}/data/cache_train_320/masks_u8.npy",mmap_mode="r")
grid=[float(x) for x in a.grid.split(",")]
meta["row"]=np.arange(len(meta))
groups=[(cd,sub.sort_values("slice_int")["row"].values) for cd,sub in meta.groupby("case_day")]
print("case_days",len(groups),"slices",len(meta))
for ci,c in enumerate(CLASSES):
    gtvols=[]; probvols=[]
    for cd,idxs in groups:
        gv=np.stack([(masks[id2row[meta.at[i,"id"]]]==ci+1) for i in idxs],0).transpose(1,2,0).astype(bool)
        pv=np.stack([probs[i,ci].astype(np.float32)/255.0 for i in idxs],0).transpose(1,2,0)
        gtvols.append(gv); probvols.append(pv)
    rows=[]
    for thr in grid:
        inter=0.0; ssum=0.0; ns=0
        hdsum=0.0
        for gv,pv in zip(gtvols,probvols):
            pred=pv>thr
            inter += np.logical_and(pred,gv).sum(axis=(0,1)).sum()
            ssum += pred.sum(axis=(0,1)).sum()+gv.sum(axis=(0,1)).sum()
            # per-slice dice with empty=1
            ps=pred.sum(axis=(0,1)); gs=gv.sum(axis=(0,1)); isl=np.logical_and(pred,gv).sum(axis=(0,1))
            s=ps+gs
            d=np.where(s>0, 2*isl/np.maximum(s,1), 1.0)
            rows.append(("dice_slice_sum", d.sum(), len(d))) if False else None
            # accumulate slice dice
            if 'dsum' not in dir(): pass
        # recompute slice dice efficiently
        dsum=0.0; dn=0
        for gv,pv in zip(gtvols,probvols):
            pred=pv>thr
            ps=pred.sum(axis=(0,1)); gs=gv.sum(axis=(0,1)); isl=np.logical_and(pred,gv).sum(axis=(0,1))
            s=ps+gs; d=np.where(s>0, 2*isl/np.maximum(s,1), 1.0); dsum+=d.sum(); dn+=len(d)
            if pred.any() and gv.any():
                hd=hausdorff3d(pred,gv,spacing=(1,1,1)); hdsum += 1-min(1.0, hd/320.0)
            elif not pred.any() and not gv.any(): hdsum += 1.0
            else: hdsum += 0.0
        dice=float(dsum/dn); hdscore=float(hdsum/len(gtvols))
        combo=0.4*dice+0.6*hdscore
        rows.append((thr,round(dice,4),round(hdscore,4),round(combo,4)))
    print("CLASS",c)
    for r in rows: print("  thr %.3f dice %.4f hd %.4f combo %.4f"%r)
