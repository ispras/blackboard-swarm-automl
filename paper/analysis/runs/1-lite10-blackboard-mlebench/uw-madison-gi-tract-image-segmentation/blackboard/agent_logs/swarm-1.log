import os, sys, json, time, argparse
import numpy as np, pandas as pd, torch
from torch.utils.data import DataLoader
import segmentation_models_pytorch as smp
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from data import GISegDataset, CACHE_TR, CLASSES

ROOT = "/download_job_code/payload/sandbox"
WS = f"{ROOT}/workspaces/canopus_phi"

def dice_metrics(logits, target, thr=0.5, eps=1e-6):
    pred = (torch.sigmoid(logits) > thr).float()
    dims = (0, 2, 3)
    inter = (pred * target).sum(dims)
    s = pred.sum(dims) + target.sum(dims)
    dice = torch.where(s > 0, 2 * inter / (s + eps), torch.ones_like(s))
    pos = s > 0
    pdice = torch.where(pos, dice, torch.zeros_like(dice))
    return dice, pdice, pos

class DiceBCELoss(torch.nn.Module):
    def __init__(self, bce_w=0.5):
        super().__init__(); self.bce = torch.nn.BCEWithLogitsLoss(); self.bce_w = bce_w
    def forward(self, logits, target):
        b = self.bce(logits, target)
        p = torch.sigmoid(logits); dims = (0, 2, 3)
        inter = (p * target).sum(dims); s = p.sum(dims) + target.sum(dims)
        d = (2 * inter + 1.0) / (s + 1.0)
        return self.bce_w * b + (1 - self.bce_w) * (1 - d.mean())

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--encoder", default="efficientnet-b3")
    ap.add_argument("--arch", default="UnetPlusPlus")
    ap.add_argument("--stack", type=int, default=3)
    ap.add_argument("--epochs", type=int, default=30)
    ap.add_argument("--batch", type=int, default=32)
    ap.add_argument("--lr", type=float, default=3e-4)
    ap.add_argument("--workers", type=int, default=6)
    ap.add_argument("--tag", default="modelC")
    ap.add_argument("--train_all", action="store_true")
    ap.add_argument("--val_cases", default=f"{ROOT}/workspaces/regulus_alpha/val_cases.json")
    args = ap.parse_args()

    torch.manual_seed(1337); np.random.seed(1337)
    outdir = f"{WS}/runs/{args.tag}"; os.makedirs(outdir, exist_ok=True)
    print("args", vars(args), flush=True)

    index = pd.read_csv(f"{CACHE_TR}/index.csv")
    images = np.load(f"{CACHE_TR}/images_u8.npy", mmap_mode="r")
    masks = np.load(f"{CACHE_TR}/masks_u8.npy", mmap_mode="r")

    if args.train_all:
        val_cases = set()
    else:
        val_cases = set(json.load(open(args.val_cases))["val_cases"])
    is_val = index['case'].isin(val_cases).values
    tr_idx = np.where(~is_val)[0]; va_idx = np.where(is_val)[0]
    print("train", len(tr_idx), "val", len(va_idx), "val_cases", len(val_cases), flush=True)

    ds_tr = GISegDataset(index, images, masks, True, tr_idx, args.stack)
    dl_tr = DataLoader(ds_tr, batch_size=args.batch, shuffle=True, num_workers=args.workers,
                       pin_memory=True, drop_last=True, persistent_workers=args.workers > 0)
    ds_va = GISegDataset(index, images, masks, False, va_idx, args.stack)
    dl_va = DataLoader(ds_va, batch_size=args.batch, shuffle=False, num_workers=args.workers,
                       pin_memory=True, persistent_workers=args.workers > 0)

    model = getattr(smp, args.arch)(encoder_name=args.encoder, encoder_weights="imagenet",
                                   in_channels=args.stack, classes=3).cuda()
    crit = DiceBCELoss().cuda()
    opt = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=1e-4)
    steps = max(1, len(dl_tr) * args.epochs)
    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=args.lr, total_steps=steps, pct_start=0.1)
    scaler = torch.cuda.amp.GradScaler()

    best = -1; log = []
    for ep in range(args.epochs):
        model.train(); t0 = time.time(); run = 0; nb = 0
        for x, y in dl_tr:
            x = x.cuda(non_blocking=True); y = y.cuda(non_blocking=True)
            opt.zero_grad(set_to_none=True)
            with torch.cuda.amp.autocast(dtype=torch.bfloat16):
                o = model(x); loss = crit(o.float(), y)
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            scaler.step(opt); scaler.update(); sched.step()
            run += loss.item(); nb += 1
        model.eval()
        dsum = torch.zeros(3, device="cuda"); psum = torch.zeros(3, device="cuda")
        pcnt = torch.zeros(3, device="cuda"); n = 0
        with torch.no_grad():
            for x, y in dl_va:
                x = x.cuda(non_blocking=True); y = y.cuda(non_blocking=True)
                with torch.cuda.amp.autocast(dtype=torch.bfloat16):
                    o = model(x)
                d, pd, pos = dice_metrics(o.float(), y)
                dsum += d.sum(0); psum += pd.sum(0); pcnt += pos.sum(0).float(); n += x.shape[0]
        md = (dsum / n).cpu().numpy(); mp = (psum / pcnt.clamp(min=1)).cpu().numpy()
        score = float(md.mean())
        rec = dict(epoch=ep, loss=run / max(nb, 1), dice=score, dice_per_class=md.tolist(),
                   pos_dice_per_class=mp.tolist(), sec=time.time() - t0)
        print(json.dumps(rec), flush=True); log.append(rec)
        if len(va_idx) > 0 and score > best:
            best = score
            torch.save(dict(state=model.state_dict(), args=vars(args), score=score,
                            val_cases=sorted(val_cases)), f"{outdir}/best.pt")
            print("saved best", best, flush=True)
        else:
            torch.save(dict(state=model.state_dict(), args=vars(args), score=best,
                            val_cases=sorted(val_cases)), f"{outdir}/last.pt")
        json.dump(log, open(f"{outdir}/log.json", "w"), indent=1)
    if len(va_idx) == 0:
        os.replace(f"{outdir}/last.pt", f"{outdir}/best.pt")
    print("DONE best", best, flush=True)

if __name__ == '__main__':
    main()
