    print(name,'pos slices',pos.sum(),'dice(pos)',d.mean(),'pred_area',p.sum()/pos.sum(),'gt_area',gg.sum()/pos.sum(),'centroid_dist',np.mean(dc) if dc else None)
    # best shift dice for first 30
    best=[]
