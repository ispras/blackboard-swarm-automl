import argparse, json, sys, os
import numpy as np, pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import evaluate
from postproc3d import clean_volume
from scipy import ndimage

ROOT = "/download_job_code/payload/sandbox"
CACHE = f"{ROOT}/data/cache_train_320"

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--probs', required=True)
    ap.add_argument('--ids', required=True)
    ap.add_argument('--thr', type=float, default=0.5)
    ap.add_argument('--min_vol', type=int, default=0)
    ap.add_argument('--keep_top', type=int, default=0)
    ap.add_argument('--min_slice_area', type=int, default=0)
    ap.add_argument('--detail_out', default=None)
    a = ap.parse_args()
    index = pd.read_csv(f'{CACHE}/index.csv')
    pos = {v: i for i, v in enumerate(index['id'].values)}
    ids = pd.read_csv(a.ids)['id'].values
    rows = np.array([pos[v] for v in ids])
    vi = index.iloc[rows].reset_index(drop=True)
    gt = np.asarray(np.load(f'{CACHE}/masks_u8.npy', mmap_mode='r')[rows])
    P = np.asarray(np.load(a.probs, mmap_mode='r'))
    assert len(P) == len(rows)
    pred = P > int(a.thr*255)
    if a.min_vol or a.min_slice_area:
        for cd, g in vi.groupby('case_day'):
            ii = g.index.values
            for c in range(3):
                pred[ii, c] = clean_volume(pred[ii, c], a.min_vol, a.keep_top, a.min_slice_area)
    r, m = evaluate(pred.astype(np.uint8)*255, vi, gt, 0.5)
    print(json.dumps(m, indent=1))
    print(r.groupby('cls')[['dice','hd','combo']].mean())
    if a.detail_out:
        r.to_csv(a.detail_out, index=False)

if __name__ == '__main__':
    main()
