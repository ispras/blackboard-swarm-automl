import pandas as pd, numpy as np, cv2
sub=pd.read_csv('final_solution/submission.csv'); te=pd.read_csv('data/test.csv')
print('rows',len(sub),'order', (sub.id.values==te.id.values).all() and (sub['class'].values==te['class'].values).all())
print('nonempty',int((sub.predicted.fillna('')!='').sum()))
print(sub.assign(ne=sub.predicted.fillna('')!='').groupby('class').ne.mean().round(4).to_dict())
bad=0
for s in sub.predicted.fillna(''):
    if not s: continue
    v=np.array(s.split(),dtype=np.int64)
    if len(v)%2 or len(v)==0: bad+=1; continue
    st=v[0::2]; ln=v[1::2]
    if (st<1).any() or (ln<1).any() or (np.diff(st)<=0).any(): bad+=1
print('bad',bad)
# decode a few non-square rows and check compactness
from scipy import ndimage
tei=pd.read_csv('data/cache_test_320/index.csv')
nonsq=tei[tei.orig_h!=tei.orig_w].id.unique()[:200]
subidx=sub.set_index(['id','class'])
cnt=[]
for _id in nonsq[:60]:
    r=tei[tei.id==_id].iloc[0]; H,W=int(r.orig_h),int(r.orig_w)
    for cls in ['large_bowel','small_bowel','stomach']:
        try: s=subidx.loc[(_id,cls),'predicted']
        except KeyError: continue
        if not isinstance(s,str) or not s: continue
        v=np.array(s.split(),dtype=np.int64); st=v[0::2]-1; ln=v[1::2]
        m=np.zeros(H*W,np.uint8)
        for a,b in zip(st,ln): m[a:a+b]=1
        m=m.reshape((H,W),order='C')
        n,_=ndimage.label(m,structure=np.ones((3,3),np.uint8)); cnt.append(n)
print('nonsquare C-decode mean comps', float(np.mean(cnt)), 'max', int(np.max(cnt)))
