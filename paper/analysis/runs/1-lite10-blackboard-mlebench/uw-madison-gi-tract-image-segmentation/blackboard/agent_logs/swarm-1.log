    inter=(p&gg).reshape(len(p),-1).sum(1); s=p.reshape(len(p),-1).sum(1)+gg.reshape(len(gg),-1).sum(1)
    d=np.where(s>0,2*inter/np.maximum(s,1),1.0)
    # centroid
    def cent(m):
