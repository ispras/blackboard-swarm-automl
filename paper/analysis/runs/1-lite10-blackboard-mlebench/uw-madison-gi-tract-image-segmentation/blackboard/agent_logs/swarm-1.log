                aa=np.roll(np.roll(a,dy,0),dx,1)
                ii=np.logical_and(aa,b).sum(); ss=aa.sum()+b.sum()
                dd=2*ii/ss if ss else 1
                if dd>bd: bd=dd;bs=(dy,dx)
        best.append((np.logical_and(a,b).sum()*2/(a.sum()+b.sum()), bd, bs))
    best=np.array(best)
    print('  base dice',best[:,0].mean(),'best-shift dice',best[:,1].mean(),'best shifts sample',[tuple(x) for x in best[:5,2].astype(int)])
