def dice_metrics(logits, target, thr=0.5, eps=1e-6):
    pred=(torch.sigmoid(logits)>thr).float()
    dims=(0,2,3)
    inter=(pred*target).sum(dims); s=pred.sum(dims)+target.sum(dims)
    dice=torch.where(s>0, 2*inter/(s+eps), torch.ones_like(s))
    return dice
