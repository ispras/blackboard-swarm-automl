import numpy as np, cv2

def clean_slice(mask, min_area=0, keep_largest=False, fill_holes=False):
    """mask: HxW bool. Remove components < min_area; optionally keep largest; fill holes."""
    if mask.sum() == 0:
        return mask
    m = mask.astype(np.uint8)
    n, lab, stats, _ = cv2.connectedComponentsWithStats(m, connectivity=8)
    out = np.zeros_like(m)
    areas = stats[1:, cv2.CC_STAT_AREA]
    if keep_largest and len(areas):
        k = 1 + int(np.argmax(areas))
        out[lab == k] = 1
    else:
        for k in range(1, n):
            if stats[k, cv2.CC_STAT_AREA] >= min_area:
                out[lab == k] = 1
    if fill_holes and out.sum() > 0:
        # flood fill background from border on inverse
        inv = (1 - out).astype(np.uint8)
        ff = inv.copy()
        h, w = out.shape
        mask2 = np.zeros((h + 2, w + 2), np.uint8)
        cv2.floodFill(ff, mask2, (0, 0), 2)
        holes = (ff == 1).astype(np.uint8)
        out = np.maximum(out, holes)
    return out.astype(bool)

def postprocess_batch(pred, min_area=0, keep_largest=False, fill_holes=False):
    """pred: (N,3,H,W) bool -> same after per-slice cleaning."""
    out = np.empty_like(pred)
    for i in range(pred.shape[0]):
        for c in range(pred.shape[1]):
            out[i, c] = clean_slice(pred[i, c], min_area, keep_largest, fill_holes)
    return out
