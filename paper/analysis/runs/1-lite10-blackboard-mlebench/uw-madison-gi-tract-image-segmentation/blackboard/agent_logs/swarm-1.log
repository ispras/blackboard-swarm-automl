from scipy.ndimage import gaussian_filter1d
sys.path.insert(0,'.')
from metric import hd_score, points_of
CACHE='/download_job_code/payload/sandbox/data/cache_train_320'
index=pd.read_csv(CACHE+'/index.csv'); mp={v:i for i,v in enumerate(index['id'])}
vc=set(json.load(open('/download_job_code/payload/sandbox/workspaces/regulus_alpha/val_cases.json'))['val_cases'])
val_ids=index[index.case.isin(vc)]['id'].values
canon=pd.DataFrame({'id':val_ids}); pos={v:i for i,v in enumerate(val_ids)}
models={
 'A':('/download_job_code/payload/sandbox/workspaces/aldebaran_omicron/probs/val_A_AC_probs.npy','/download_job_code/payload/sandbox/workspaces/aldebaran_omicron/probs/val_A_AC_probs_index.csv'),
 'B':('/download_job_code/payload/sandbox/workspaces/regulus_alpha/probs/val_B2_ep6_probs.npy','/download_job_code/payload/sandbox/workspaces/regulus_alpha/probs/val_B2_ep6_ids.csv'),
 'C':('val_C3_probs.npy','val_C3_probs_ids.csv')}
maps={}
for k,(np_,idf) in models.items():
    mid=pd.read_csv(idf)['id'].values; pm={v:i for i,v in enumerate(mid)}
    maps[k]=np.array([pm[v] for v in val_ids])
Pm={k:np.load(v[0],mmap_mode='r') for k,v in models.items()}
vi=index.set_index('id').loc[val_ids].reset_index()
gt=np.asarray(np.load(CACHE+'/masks_u8.npy',mmap_mode='r')[[mp[v] for v in val_ids]])
groups=[(cd,g.index.values) for cd,g in vi.groupby('case_day')]
SIG=1.5
combos={'A':(1,0,0),'B':(0,1,0),'C':(0,0,1),'AB':(1,1,0),'AC':(1,0,1),'BC':(0,1,1),'ABC':(1,1,1)}
THR=[0.50,0.45,0.40]
res={c:{k:dict(d=0.0,h=0.0,n=0) for k in combos} for c in range(3)}
for cd,ii in groups:
    D=len(ii)
    gts={c:(gt[ii]==c+1) for c in range(3)}
    # precompute smoothed per-model per-class for this group
    sm={}
    for k in ['A','B','C']:
        arr=np.asarray(Pm[k][maps[k][ii]]).astype(np.float32)  # (D,3,320,320)
        for c in range(3):
            sm[(k,c)]=gaussian_filter1d(arr[:,c],sigma=SIG,axis=0,mode='nearest')
    for c in range(3):
        g=gts[c]
        for name,w in combos.items():
            q=(w[0]*sm[('A',c)]+w[1]*sm[('B',c)]+w[2]*sm[('C',c)])/sum(w)
            pv=q>int(THR[c]*255)
            inter=np.logical_and(pv,g).reshape(D,-1).sum(1); s=pv.reshape(D,-1).sum(1)+g.reshape(D,-1).sum(1)
            d=float(np.where(s>0,2*inter/np.maximum(s,1),1.0).mean())
            h=hd_score(points_of(pv),points_of(g))
            r=res[c][name]; r['d']+=d; r['h']+=h; r['n']+=1
out={}
for c in range(3):
    print('class',c)
    best=None
    for name in combos:
        r=res[c][name]; d=r['d']/r['n']; h=r['h']/r['n']; combo=0.4*d+0.6*h
        print(f'  {name:4s} dice={d:.4f} hd={h:.4f} combo={combo:.4f}')
        if best is None or combo>best[1]: best=(name,combo)
    out[c]=best
print('BEST PER CLASS',out)
print('equal ABC overall', float(np.mean([0.4*res[c]['ABC']['d']/res[c]['ABC']['n']+0.6*res[c]['ABC']['h']/res[c]['ABC']['n'] for c in range(3)])))
print('oracle per-class overall', float(np.mean([v[1] for v in out.values()])))
PY
