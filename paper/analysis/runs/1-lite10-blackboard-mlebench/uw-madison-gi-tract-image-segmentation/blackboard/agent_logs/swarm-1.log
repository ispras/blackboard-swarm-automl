import argparse, json, sys, os
import numpy as np, pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import hd_score, points_of, CLASSES
from postproc3d import clean_volume

ROOT = "/download_job_code/payload/sandbox"
CACHE = f"{ROOT}/data/cache_train_320"

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--probs', required=True)
    ap.add_argument('--ids', required=True)
    ap.add_argument('--thrs', default='0.30,0.40,0.45,0.50,0.55,0.60,0.65,0.70')
    ap.add_argument('--min_vols', default='0,30,80,150,300,600,1000,2000')
    ap.add_argument('--min_slice_areas', default='0,20,50')
    ap.add_argument('--out', required=True)
    a = ap.parse_args()
    index = pd.read_csv(f'{CACHE}/index.csv')
    pos = {v: i for i, v in enumerate(index['id'].values)}
    ids = pd.read_csv(a.ids)['id'].values
    rows = np.array([pos[v] for v in ids])
    vi = index.iloc[rows].reset_index(drop=True)
    gt = np.asarray(np.load(f'{CACHE}/masks_u8.npy', mmap_mode='r')[rows])
    P = np.asarray(np.load(a.probs, mmap_mode='r'))
    groups = [(cd, g.index.values) for cd, g in vi.groupby('case_day')]
    thrs = [float(x) for x in a.thrs.split(',')]
    min_vols = [int(x) for x in a.min_vols.split(',')]
    msas = [int(x) for x in a.min_slice_areas.split(',')]

    best_per_class = {}
    for c in range(3):
        gvols = [(gv, (gt[ii] == c+1)) for _, ii in groups for gv in [None]]
        best = None
        for t in thrs:
            pv = P[:, c] > int(t*255)
            dices, hds = [], []
            for cd, ii in groups:
                pvv = pv[ii]
                gvv = (gt[ii] == c+1)
                inter = np.logical_and(pvv, gvv).sum(); s = pvv.sum()+gvv.sum()
                d = 1.0 if s == 0 else 2*inter/s
                h = hd_score(points_of(pvv), points_of(gvv))
                dices.append(d); hds.append(h)
            d, h = float(np.mean(dices)), float(np.mean(hds)); combo = 0.4*d+0.6*h
            print(f'cls={c} thr={t:.2f} dice={d:.4f} hd={h:.4f} combo={combo:.4f}', flush=True)
            if best is None or combo > best['combo']:
                best = dict(thr=t, dice=d, hd=h, combo=combo)
        best_per_class[c] = best
    print('BEST THR', json.dumps(best_per_class), flush=True)

    # volume cleanup sweep with best thr per class
    final = {}
    for c in range(3):
        t = best_per_class[c]['thr']
        pv_all = P[:, c] > int(t*255)
        best = None
        for mv in min_vols:
            for msa in msas:
                dices, hds = [], []
                for cd, ii in groups:
                    pvv = pv_all[ii]
                    gvv = (gt[ii] == c+1)
                    if mv or msa:
                        pvv = clean_volume(pvv, min_vol=mv, min_slice_area=msa)
                    inter = np.logical_and(pvv, gvv).sum(); s = pvv.sum()+gvv.sum()
                    d = 1.0 if s == 0 else 2*inter/s
                    h = hd_score(points_of(pvv), points_of(gvv))
                    dices.append(d); hds.append(h)
                d, h = float(np.mean(dices)), float(np.mean(hds)); combo = 0.4*d+0.6*h
                if best is None or combo > best['combo']:
                    best = dict(thr=t, min_vol=mv, msa=msa, dice=d, hd=h, combo=combo)
        print(f'cls={c} BEST POST {json.dumps(best)}', flush=True)
        final[c] = best
    overall = float(np.mean([v['combo'] for v in final.values()]))
    out = dict(per_class=final, overall_combo=overall)
    print('FINAL', json.dumps(out), flush=True)
    json.dump(out, open(a.out, 'w'), indent=1)

if __name__ == '__main__':
    main()
