import argparse, json, itertools, sys, os
import numpy as np, pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from metric import hd_score, points_of, CLASSES
from postproc3d import clean_volume

ROOT = "/download_job_code/payload/sandbox"
CACHE = f"{ROOT}/data/cache_train_320"

def build_pred(P, thr):
    return P > int(thr*255)

def eval_vol(pred_vol, gt_vol):
    # pred_vol, gt_vol: (D,H,W) bool
    inter = np.logical_and(pred_vol, gt_vol).sum(); s = pred_vol.sum()+gt_vol.sum()
    dice = 1.0 if s == 0 else 2*inter/s
    hs = hd_score(points_of(pred_vol), points_of(gt_vol))
    return dice, hs

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--probs', required=True)
    ap.add_argument('--thr', type=float, default=0.5)
    ap.add_argument('--grid', action='store_true')
    a = ap.parse_args()
    index = pd.read_csv(f'{CACHE}/index.csv')
    vc = set(json.load(open(f'{ROOT}/workspaces/regulus_alpha/val_cases.json'))['val_cases'])
    idx = np.where(index['case'].isin(vc).values)[0]
    vi = index.iloc[idx].reset_index(drop=True)
    gt = np.asarray(np.load(f'{CACHE}/masks_u8.npy', mmap_mode='r')[idx])
    P = np.asarray(np.load(a.probs, mmap_mode='r'))
    assert len(P) == len(idx)
    pred = build_pred(P, a.thr)
    # precompute per case-day slice positions
    groups = [(cd, g.index.values) for cd, g in vi.groupby('case_day')]
    configs = [(0,0,0)]
    if a.grid:
        configs = []
        for mv in [0, 30, 100, 300, 1000]:
            for msa in [0, 20, 50]:
                for kt in ([0, 2] if mv > 0 else [0]):
                    configs.append((mv, kt, msa))
    results = []
    for mv, kt, msa in configs:
        dices, hds = [], []
        for cd, ii in groups:
            for c in range(3):
                pv = pred[ii, c]
                gv = (gt[ii] == c+1)
                if mv or msa:
                    pv = clean_volume(pv, min_vol=mv, keep_top=kt, min_slice_area=msa)
                d, h = eval_vol(pv, gv)
                dices.append(d); hds.append(h)
        d = float(np.mean(dices)); h = float(np.mean(hds)); combo = 0.4*d+0.6*h
        print(f'mv={mv} keep_top={kt} msa={msa} dice={d:.4f} hd={h:.4f} combo={combo:.4f}', flush=True)
        results.append(dict(mv=mv, kt=kt, msa=msa, dice=d, hd=h, combo=combo))
    best = max(results, key=lambda r: r['combo'])
    print('BEST', json.dumps(best), flush=True)
    json.dump(results, open(a.probs.replace('.npy','_postproc.json'), 'w'), indent=1)

if __name__ == '__main__':
    main()
