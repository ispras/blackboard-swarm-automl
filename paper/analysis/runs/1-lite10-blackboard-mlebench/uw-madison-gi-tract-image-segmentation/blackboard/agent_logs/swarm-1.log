        er=cv2.erode(m,np.ones((3,3),np.uint8)); bd=(m-er)>0
        res[o].append(g[bd].mean() if bd.sum() else np.nan)
    n+=1
for o in ['F','C']:
    print(o,'nonsquare n',n,'boundary gradient mean',np.nanmean(res[o]))
