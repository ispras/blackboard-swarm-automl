ids=pd.read_csv('/download_job_code/payload/sandbox/workspaces/regulus_alpha/probs/val_B_holdout_ids.csv')['id'].values
rows=np.array([mp[v] for v in ids]); gt=np.asarray(np.load(CACHE+'/masks_u8.npy',mmap_mode='r')[rows])
P=np.asarray(np.load('/download_job_code/payload/sandbox/workspaces/regulus_alpha/probs/val_B_holdout_probs.npy',mmap_mode='r'))
pred=P>int(0.35*255)
for c,name in enumerate(['lb','sb','st']):
    g=(gt==c+1); pos=g.reshape(len(g),-1).sum(1)>0
