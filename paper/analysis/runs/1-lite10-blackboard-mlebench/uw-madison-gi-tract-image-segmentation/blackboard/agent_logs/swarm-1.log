def dec(rle,h,w,order):
    s=rle.split(); st=np.asarray(s[0::2],int)-1; ln=np.asarray(s[1::2],int)
    m=np.zeros(h*w,np.uint8)
    for a,b in zip(st,ln): m[a:a+b]=1
    return m.reshape((h,w),order=order)
res={'F':[], 'C':[]}; n=0
for r in rows.itertuples(index=False):
    parts=r.id.split('_'); case=parts[0]; cd='_'.join(parts[:2]); sn=int(parts[3])
    p=f'data/train/{case}/{cd}/scans'
    fn=[f for f in os.listdir(p) if f.startswith(f'slice_{sn:04d}_')][0]
    img=cv2.imread(os.path.join(p,fn),cv2.IMREAD_UNCHANGED).astype(np.float32); h,w=img.shape
    if h==w: continue
    img=(img-img.min())/(img.max()-img.min()+1e-6)
    gx=cv2.Sobel(img,cv2.CV_32F,1,0,ksize=3); gy=cv2.Sobel(img,cv2.CV_32F,0,1,ksize=3)
