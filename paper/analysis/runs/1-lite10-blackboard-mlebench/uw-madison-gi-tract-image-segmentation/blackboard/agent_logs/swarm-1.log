import numpy as np, pandas as pd
from scipy.spatial import cKDTree

ROOT = "/download_job_code/payload/sandbox"
CACHE_TR = f"{ROOT}/data/cache_train_320"
CLASSES = ["large_bowel", "small_bowel", "stomach"]

def hd_score(a_pts, b_pts, max_pts=2000):
    if len(a_pts) == 0 and len(b_pts) == 0:
        return 1.0
    if len(a_pts) == 0 or len(b_pts) == 0:
        return 0.0
    if len(a_pts) > max_pts:
        a_pts = a_pts[np.linspace(0, len(a_pts)-1, max_pts).astype(int)]
    if len(b_pts) > max_pts:
        b_pts = b_pts[np.linspace(0, len(b_pts)-1, max_pts).astype(int)]
    ta, tb = cKDTree(a_pts), cKDTree(b_pts)
    da, _ = tb.query(a_pts); db, _ = ta.query(b_pts)
    hd = max(da.max(), db.max())
    return float(max(0.0, 1.0 - hd))

def points_of(vol, normalize=True):
    zz, yy, xx = np.nonzero(vol)
    if len(zz) == 0:
        return np.zeros((0, 3), np.float32)
    d, h, w = vol.shape
    z = zz / max(d - 1, 1); y = yy / max(h - 1, 1); x = xx / max(w - 1, 1)
    return np.stack([z, y, x], 1).astype(np.float32)

def evaluate(probs, index, gt_masks, thr=0.5, empty_empty_one=True, mode='per_class'):
    """probs: (N,3,320,320) uint8; index: rows matching N; gt_masks: (N,320,320) combined."""
    pred = probs > int(thr * 255)  # (N,3,H,W) bool
    df = index[['case_day']].copy()
    rows = []
    for cd, g in df.groupby('case_day'):
        ii = g.index.values
        for c in range(3):
            pv = pred[ii, c].astype(bool)
            gv = (np.asarray(gt_masks[ii]) == c + 1)
            inter = np.logical_and(pv, gv).sum(); s = pv.sum() + gv.sum()
            if s == 0:
                dice = 1.0 if empty_empty_one else 0.0
            else:
                dice = 2 * inter / s
            hs = hd_score(points_of(pv), points_of(gv))
            rows.append(dict(case_day=cd, cls=CLASSES[c], dice=dice, hd=hs,
                             combo=0.4 * dice + 0.6 * hs, npred=pv.sum(), ngt=gv.sum()))
    r = pd.DataFrame(rows)
    return r, dict(dice=r.dice.mean(), hd=r.hd.mean(), combo=r.combo.mean())
