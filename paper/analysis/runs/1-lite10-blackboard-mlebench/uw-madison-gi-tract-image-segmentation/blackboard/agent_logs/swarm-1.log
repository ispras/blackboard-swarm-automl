import sys, numpy as np, pandas as pd
from scipy.ndimage import gaussian_filter1d, label, sum as ndsum
sys.path.insert(0,'.')
from metric import hd_score, points_of
CACHE='/download_job_code/payload/sandbox/data/cache_train_320'
index=pd.read_csv(CACHE+'/index.csv'); mp={v:i for i,v in enumerate(index['id'])}
ids=pd.read_csv('fused3_val_probs_ids.csv')['id'].values; rows=np.array([mp[v] for v in ids])
vi=index.iloc[rows].reset_index(drop=True)
gt=np.asarray(np.load(CACHE+'/masks_u8.npy',mmap_mode='r')[rows])
P=np.load('fused3_val_probs.npy',mmap_mode='r')
groups=[(cd,g.index.values) for cd,g in vi.groupby('case_day')]
g=(gt==2)
gpts=[points_of(g[ii]) for _,ii in groups]
def evalpred(pv):
    inter=np.logical_and(pv,g).reshape(len(pv),-1).sum(1); s=pv.reshape(len(pv),-1).sum(1)+g.reshape(len(g),-1).sum(1)
    dice=float(np.where(s>0,2*inter/np.maximum(s,1),1.0).mean())
    hd=float(np.mean([hd_score(points_of(pv[ii]),gpts[k]) for k,(_,ii) in enumerate(groups)]))
    return dice,hd,0.4*dice+0.6*hd
def keep_cc(pv, mode):
    out=pv.copy()
    for _,ii in groups:
        v=out[ii].astype(np.uint8)
        if v.sum()==0: continue
        lab,n=label(v,structure=np.ones((3,3,3),np.uint8))
        if n<=1: continue
        sizes=ndsum(v,lab,range(1,n+1))
        if mode=='largest':
            keep=1+int(np.argmax(sizes))
        elif mode=='top2':
            keep=set((np.argsort(sizes)[-2:]+1).tolist())
        elif mode=='frac50':
            mx=sizes.max(); keep=set((np.where(sizes>=0.5*mx)[0]+1).tolist())
        keep=keep if isinstance(keep,set) else {keep}
        out[ii]=np.isin(lab,list(keep))
    return out
for sig in [0,1.25,1.5,2.0]:
    Q=np.asarray(P[:,2]).astype(np.float32)
    if sig>0:
        for _,ii in groups: Q[ii]=gaussian_filter1d(Q[ii],sigma=sig,axis=0,mode='nearest')
    for thr in [0.35,0.40,0.45,0.50]:
        pv=Q>int(thr*255)
        base=evalpred(pv)
        res={'none':base}
        for mode in ['largest','top2','frac50']:
            res[mode]=evalpred(keep_cc(pv,mode))
        best=max(res.items(), key=lambda kv: kv[1][2])
        print(f'sig={sig} thr={thr} none={base[2]:.4f} largest={res["largest"][2]:.4f} top2={res["top2"][2]:.4f} frac50={res["frac50"][2]:.4f} BEST={best[0]}',flush=True)
PY
