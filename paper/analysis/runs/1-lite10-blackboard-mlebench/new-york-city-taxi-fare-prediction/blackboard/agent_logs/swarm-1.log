import numpy as np, pandas as pd, glob, os
from scipy.optimize import nnls
B='/download_job_code/payload/sandbox/workspaces'
def load(agent,tag,sub=''):
    o=np.load(f'{B}/{agent}/{sub}holdout_orig_{tag}.npy'); p=np.load(f'{B}/{agent}/{sub}holdout_pred_{tag}.npy')
    return o,p
models={
 'can_g54m':('canopus_pi','canopus_g54m','preds/'),
 'can_f54m':('canopus_pi','canopus_f54m','preds/'),
 'mim_xgb2lg':('mimosa_omicron','xgb2lg_full',''),
 'mim_xgb2t3lg':('mimosa_omicron','xgb2t3lg_full',''),
 'mim_xgb2log':('mimosa_omicron','xgb2log_full',''),
 'mim_nn':('mimosa_omicron','nn_full',''),
 'mim_xgbnote':('mimosa_omicron','xgb_full',''),
 'ald_catS':('aldebaran_omicron','catS',''),
 'ald_xgbS':('aldebaran_omicron','xgbS',''),
 'ald_catL':('aldebaran_omicron','catL',''),
 'ald_lgbHub':('aldebaran_omicron','lgbHub',''),
}
data={}
for k,v in models.items():
    try: data[k]=load(*v)
    except Exception as e: print('skip',k,e)
idx=None
for k,(o,p) in data.items():
    s=set(o.tolist()); idx=s if idx is None else idx&s
idx=np.array(sorted(idx)); print('n',len(idx))
def al(o,p):
    pos=pd.Series(np.arange(len(o)),index=o); return p[pos.loc[idx].to_numpy()].astype(np.float64)
cols={k:al(*v) for k,v in data.items()}
to=np.load(f'{B}/canopus_pi/preds/holdout_orig_canopus_g54m.npy'); ty=np.load(f'{B}/canopus_pi/preds/holdout_true_canopus_g54m.npy')
y=ty[pd.Series(np.arange(len(to)),index=to).loc[idx].to_numpy()].astype(np.float64)
for k,v in sorted(cols.items(), key=lambda kv: np.sqrt(np.mean((kv[1]-y)**2))):
    print(f'{np.sqrt(np.mean((v-y)**2)):.4f}  {k}')
names=list(cols); A=np.stack([cols[k] for k in names],1)
rng=np.random.default_rng(0); fold=rng.integers(0,5,len(y)); cv=np.zeros(len(y))
for f in range(5):
    tr=fold!=f; va=fold==f; w,_=nnls(A[tr],y[tr]); cv[va]=A[va]@w
print('CV blend all',np.sqrt(np.mean((cv-y)**2)))
w,_=nnls(A,y); print('weights',dict(zip(names,np.round(w,3))))
# without canopus
n2=[k for k in names if not k.startswith('can_')]; A2=A[:,[names.index(k) for k in n2]]; cv2=np.zeros(len(y))
for f in range(5):
    tr=fold!=f; va=fold==f; w2,_=nnls(A2[tr],y[tr]); cv2[va]=A2[va]@w2
print('CV blend WITHOUT canopus',np.sqrt(np.mean((cv2-y)**2)))
EOF
