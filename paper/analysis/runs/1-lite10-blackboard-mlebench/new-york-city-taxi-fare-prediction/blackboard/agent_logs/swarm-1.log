import pandas as pd, numpy as np, glob, os, sys, argparse, gc, time
import lightgbm as lgb
P='/download_job_code/payload/sandbox/workspaces/canopus_pi/prep'
ap=argparse.ArgumentParser()
ap.add_argument('--maxrows', type=int, default=12_000_000)
ap.add_argument('--rounds', type=int, default=3000)
ap.add_argument('--lr', type=float, default=0.05)
ap.add_argument('--leaves', type=int, default=255)
ap.add_argument('--threads', type=int, default=12)
ap.add_argument('--tag', type=str, default='v2')
ap.add_argument('--no_te', action='store_true')
ap.add_argument('--seed', type=int, default=42)
ap.add_argument('--min_data', type=int, default=50)
ap.add_argument('--patience', type=int, default=150)
ap.add_argument('--min_fare', type=float, default=2.5)
ap.add_argument('--ff', type=float, default=0.85)
ap.add_argument('--bf', type=float, default=0.8)
ap.add_argument('--l2', type=float, default=1.0)
ap.add_argument('--save', action='store_true')
args=ap.parse_args()
t0=time.time()
files=sorted(glob.glob(P+'/parts/part_*.parquet'))
df=pd.concat([pd.read_parquet(f) for f in files], ignore_index=True)
df=df[df['fare_amount']>=args.min_fare].reset_index(drop=True); gc.collect()
print('loaded', df.shape, f'{time.time()-t0:.0f}s', flush=True)
# airport interaction features
df['p_air_min']=df[['p_jfk','p_lga','p_ewr']].min(axis=1).astype(np.float32)
df['d_air_min']=df[['d_jfk','d_lga','d_ewr']].min(axis=1).astype(np.float32)
df['air_trip']=((df['p_air_min']<2)|(df['d_air_min']<2)).astype(np.float32)
df['jfk_manh']=(((df['p_jfk']<2)&(df['d_ctr']<8))|((df['d_jfk']<2)&(df['p_ctr']<8))).astype(np.float32)

rng=np.random.default_rng(args.seed)
ho_all=(df['orig_idx'].to_numpy()%100==0)
ho_idx=np.where(ho_all)[0]
tr_pool=np.where(~ho_all)[0]
if len(tr_pool)>args.maxrows:
    tr_idx=rng.choice(tr_pool, size=args.maxrows, replace=False)
else:
    tr_idx=tr_pool
tr_idx=np.sort(tr_idx)
print('train rows',len(tr_idx),'holdout rows',len(ho_idx), flush=True)

y=df['fare_amount'].to_numpy(np.float32)
pc=(df['pcell'].to_numpy()*100).astype(np.int64)
dc=(df['dcell'].to_numpy()*100).astype(np.int64)
pc3=(df['pcell3'].to_numpy()*1000).astype(np.int64)
od=pc*10_000_000+dc
df['_pc']=pc; df['_dc']=dc; df['_pc3']=pc3; df['_od']=od
del pc,dc,pc3,od; gc.collect()

tr_mask=np.zeros(len(df),bool); tr_mask[tr_idx]=True
ho_mask=np.zeros(len(df),bool); ho_mask[ho_idx]=True
if not args.no_te:
    nf=5
    fold=np.full(len(df),-1,dtype=np.int8)
    fold[tr_idx]=rng.integers(0,nf,len(tr_idx))
    prior=float(y[tr_idx].mean())
    def te_add(key,m):
        arr=np.full(len(df),prior,dtype=np.float32); cnt=np.zeros(len(df),dtype=np.float32)
        for f in range(nf):
            fit=tr_mask&(fold!=f); val=tr_mask&(fold==f)
            g=df.loc[fit].groupby(key)['fare_amount']; s=g.sum(); c=g.count()
            te=((s+prior*m)/(c+m)).to_dict(); cp=c.to_dict()
            sel=np.where(val)[0]
            arr[sel]=df[key].iloc[sel].map(te).fillna(prior).to_numpy(np.float32)
            cnt[sel]=np.log1p(df[key].iloc[sel].map(cp).fillna(0).to_numpy()).astype(np.float32)
        # holdout: full train map
        g=df.loc[tr_mask].groupby(key)['fare_amount']; s=g.sum(); c=g.count()
        te=((s+prior*m)/(c+m)).to_dict(); cp=c.to_dict()
        sel=ho_idx
        arr[sel]=df[key].iloc[sel].map(te).fillna(prior).to_numpy(np.float32)
        cnt[sel]=np.log1p(df[key].iloc[sel].map(cp).fillna(0).to_numpy()).astype(np.float32)
        df[key+'_te']=arr; df[key+'_cnt']=cnt
    for key,m in [('_pc',20.0),('_dc',20.0),('_od',10.0),('_pc3',10.0)]:
        te_add(key,m)
    del fold; gc.collect()
    print('TE done', f'{time.time()-t0:.0f}s', flush=True)

feats=[c for c in df.columns if c not in ('fare_amount','_pc','_dc','_pc3','_od','orig_idx','pcell','dcell','pcell3')]
print('nfeat',len(feats), flush=True)
all_idx=np.concatenate([tr_idx,ho_idx])
X=df.iloc[all_idx][feats].to_numpy(np.float32)
yall=y[all_idx]
ntr=len(tr_idx)
del df; gc.collect()
Xtr,ytr=X[:ntr],yall[:ntr]; Xho,yho=X[ntr:],yall[ntr:]
ho_orig=ho_all  # not needed
ho_orig_idx=ho_idx
print('data ready', Xtr.shape, Xho.shape, f'{time.time()-t0:.0f}s', flush=True)
params=dict(objective='regression', metric='rmse', learning_rate=args.lr,
    num_leaves=args.leaves, min_data_in_leaf=args.min_data, feature_fraction=args.ff,
    bagging_fraction=args.bf, bagging_freq=1, lambda_l2=args.l2, max_bin=255,
    num_threads=args.threads, seed=args.seed, verbosity=-1)
dtr=lgb.Dataset(Xtr, label=ytr)
dho=lgb.Dataset(Xho, label=yho, reference=dtr)
model=lgb.train(params, dtr, num_boost_round=args.rounds, valid_sets=[dho],
