print('nnls',dict(zip(names,np.round(w,3))),'rmse',np.sqrt(np.mean((A@w-y)**2)))
for combo in [['can_e19fix',best],['can_e19fix','mim_xgb2lg','mim_xgb2','mim_nn','mim_xgbnote']]:
    names=[k for k in combo if k in cols]; A2=np.stack([cols[k] for k in names],1); w2,_=nnls(A2,y)
