for k,(o1,p1) in data.items():
    s=set(o1.tolist()); idx=s if idx is None else idx&s
idx=np.array(sorted(idx))
def al(o1,p1):
    pos=pd.Series(np.arange(len(o1)),index=o1); return p1[pos.loc[idx].to_numpy()].astype(np.float64)
cols={k:al(*v) for k,v in data.items()}
y=yv[pd.Series(np.arange(len(oi)),index=oi).loc[idx].to_numpy()].astype(np.float64)
