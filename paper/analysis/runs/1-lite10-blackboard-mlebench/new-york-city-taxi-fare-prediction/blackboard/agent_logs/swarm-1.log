print('with o54log CV',np.sqrt(np.mean((cv-y)**2)))
w,_=nnls(A,y); print('weights',dict(zip(names,np.round(w,3))))
n2=[k for k in names if k!='can_o54log']; A2=A[:,[names.index(k) for k in n2]]; cv2=np.zeros(len(y))
for f in range(5):
    tr=fold!=f; va=fold==f; w2,_=nnls(A2[tr],y[tr]); cv2[va]=A2[va]@w2
print('without o54log CV',np.sqrt(np.mean((cv2-y)**2)))
