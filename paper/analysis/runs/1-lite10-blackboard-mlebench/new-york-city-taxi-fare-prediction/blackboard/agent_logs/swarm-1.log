import pandas as pd, numpy as np, glob, gc, time
P='/download_job_code/payload/sandbox/workspaces/canopus_pi/prep'
t0=time.time()
cols=['plon','plat','dlon','dlat','year','month','day','hour','minute','fare_amount','orig_idx']
d=pd.concat([pd.read_parquet(f,columns=cols) for f in sorted(glob.glob(P+'/parts/part_*.parquet'))],ignore_index=True)
d=d[d.orig_idx.to_numpy()%100!=0]
print('train',len(d),f'{time.time()-t0:.0f}s',flush=True)
d['k']=(d.plat.astype(np.float64)*1e6).round().astype(np.int64)
for c,m in [('plon',1e6),('dlat',1e6),('dlon',1e6)]:
    d['k']=d['k']*100000000+ (d[c].astype(np.float64)*m).round().astype(np.int64)
for c in ['year','month','day','hour','minute']:
    d['k']=d['k']*100+(d[c].astype(np.int64))
print('built keys',f'{time.time()-t0:.0f}s',flush=True)
g=d.groupby('k')['fare_amount'].agg(['mean','count'])
multi=g[g['count']>1]
print('train unique keys',len(g),'dup keys',len(multi),'rows in dup keys',int(multi['count'].sum()),flush=True)
h=pd.read_parquet(P+'/holdout.parquet')
h['k']=(h.plat.astype(np.float64)*1e6).round().astype(np.int64)
for c,m in [('plon',1e6),('dlat',1e6),('dlon',1e6)]:
    h['k']=h['k']*100000000+ (h[c].astype(np.float64)*m).round().astype(np.int64)
for c in ['year','month','day','hour','minute']:
    h['k']=h['k']*100+(h[c].astype(np.int64))
mm=h.merge(g,left_on='k',right_index=True,how='inner')
print('holdout',len(h),'exact-match rows',len(mm),'frac',len(mm)/len(h),flush=True)
if len(mm):
    err=np.sqrt(np.mean((mm['mean']-mm['fare_amount'])**2))
    print('match-fare RMSE',err,'mean abs',np.mean(np.abs(mm['mean']-mm['fare_amount'])))
    # compare to predicting global mean on same rows
    print('const RMSE same rows',np.sqrt(np.mean((mm['fare_amount']-mm['fare_amount'].mean())**2)))
    # multi-count matches
    mm2=mm[mm['count']>1].head(10)
    print(mm2[['fare_amount','mean','count']].to_string() if len(mm2) else 'no multi')
print('DONE',f'{time.time()-t0:.0f}s')
EOF
