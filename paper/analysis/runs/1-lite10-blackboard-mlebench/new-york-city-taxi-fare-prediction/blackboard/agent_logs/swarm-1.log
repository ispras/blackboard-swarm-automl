ws=[]
for f in range(5):
    tr=fold!=f; w,_=nnls(A[tr],y[tr]); ws.append(w)
w=np.mean(ws,0); print('avg-fold weights',np.round(w,3),'rmse',np.sqrt(np.mean((A@w-y)**2)))
