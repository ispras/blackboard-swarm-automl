base=np.zeros(len(y)); cal=np.zeros(len(y)); cal2=np.zeros(len(y))
for f in range(5):
    tr=fold!=f; va=fold==f
    w,_=nnls(A[tr],y[tr]); base[va]=A[va]@w
    a=np.concatenate([A[tr],np.ones((tr.sum(),1))],1)
    coef,*_=np.linalg.lstsq(a,y[tr],rcond=None)
    cal[va]=coef[-1]+A[va]@coef[:-1]
    # quantile-preserving linear: fit y = a*base+b using base from train? use base[tr] (in-sample) 
    bb=np.stack([base[tr],np.ones(tr.sum())],1); c2,*_=np.linalg.lstsq(bb,y[tr],rcond=None)
    cal2[va]=c2[0]*base[va]+c2[1]
print('base OOF',np.sqrt(np.mean((base-y)**2)))
print('linear recal (weights+intercept)',np.sqrt(np.mean((cal-y)**2)))
print('recal base only',np.sqrt(np.mean((cal2-y)**2)))
# simple additive bias
for f in range(5):
    tr=fold!=f; va=fold==f
    pass
bias=np.mean(y-base); print('global bias',bias,'rmse after bias',np.sqrt(np.mean((base+bias-y)**2)))
# clip
print('clip 2.5,300',np.sqrt(np.mean((np.clip(base,2.5,300)-y)**2)))
