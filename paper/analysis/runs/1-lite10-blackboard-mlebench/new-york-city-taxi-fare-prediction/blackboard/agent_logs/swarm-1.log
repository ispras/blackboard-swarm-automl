best=min(cols,key=lambda k: np.sqrt(np.mean((cols[k]-y)**2)))
for k,v in cols.items(): print(f'resid corr {best} vs {k}: {np.corrcoef(cols[best]-y,v-y)[0,1]:.4f}')
