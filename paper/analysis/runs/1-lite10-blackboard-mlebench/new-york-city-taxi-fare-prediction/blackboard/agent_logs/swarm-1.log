def cv(trim):
    pred=np.zeros(len(y))
    for f in range(5):
        tr=fold!=f; va=fold==f; m=tr&(y<=trim) if trim else tr
        w,_=nnls(A[m],y[m]); pred[va]=A[va]@w
    return np.sqrt(np.mean((pred-y)**2))
