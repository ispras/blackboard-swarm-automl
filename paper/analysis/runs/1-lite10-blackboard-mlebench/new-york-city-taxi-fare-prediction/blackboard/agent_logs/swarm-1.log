import pandas as pd, numpy as np, glob, os, sys, argparse, gc, time
import lightgbm as lgb

P='/download_job_code/payload/sandbox/workspaces/canopus_pi/prep'
ap=argparse.ArgumentParser()
ap.add_argument('--maxrows', type=int, default=12_000_000)
ap.add_argument('--holdout', type=int, default=500_000)
ap.add_argument('--rounds', type=int, default=3000)
ap.add_argument('--lr', type=float, default=0.05)
ap.add_argument('--leaves', type=int, default=255)
ap.add_argument('--threads', type=int, default=8)
ap.add_argument('--tag', type=str, default='v1')
ap.add_argument('--no_te', action='store_true')
ap.add_argument('--seed', type=int, default=42)
ap.add_argument('--min_data', type=int, default=50)
args=ap.parse_args()

t0=time.time()
files=sorted(glob.glob(P+'/parts/part_*.parquet'))
df=pd.concat([pd.read_parquet(f) for f in files], ignore_index=True)
print('loaded', df.shape, f'{time.time()-t0:.0f}s', flush=True)
if len(df)>args.maxrows:
    df=df.sample(n=args.maxrows, random_state=args.seed).reset_index(drop=True)
    gc.collect()
print('using', df.shape, flush=True)

rng=np.random.default_rng(args.seed)
idx=rng.permutation(len(df))
ho=idx[:args.holdout]; tr=idx[args.holdout:]
df['_ho']=False; df.loc[ho,'_ho']=True

# integer codes
pc=(df['pcell'].to_numpy()*100).astype(np.int64)
dc=(df['dcell'].to_numpy()*100).astype(np.int64)
pc3=(df['pcell3'].to_numpy()*1000).astype(np.int64)
od=pc*10_000_000+dc
df['_pc']=pc; df['_dc']=dc; df['_pc3']=pc3; df['_od']=od
del pc,dc,pc3,od; gc.collect()

y=df['fare_amount'].to_numpy(np.float32)
raw_feats=[c for c in df.columns if c not in ('fare_amount','_ho','_pc','_dc','_pc3','_od')]

def add_te(train_mask, keys, m, prefix, oof_folds=None):
    # returns dict of series aligned to df index for TE and count
    tr_idx=df.index[train_mask]
    prior=float(y[train_mask].mean())
    out={}
    for key,m_s in keys:
        if oof_folds is None:
            g=df.loc[tr_idx].groupby(key)['fare_amount']
            s=g.sum(); c=g.count()
            te=(s+prior*m_s)/(c+m_s)
            mp=te.to_dict(); cp=c.to_dict()
            out[prefix+key+'_te']=df[key].map(mp).astype(np.float32)
            out[prefix+key+'_cnt']=np.log1p(df[key].map(cp).fillna(0).to_numpy()).astype(np.float32)
        else:
            te_arr=np.full(len(df),prior,dtype=np.float32)
            cnt_arr=np.zeros(len(df),dtype=np.float32)
            for f in range(oof_folds):
                valmask=(df['_fold']==f)
                fitmask=train_mask&(~valmask)
                g=df.loc[fitmask].groupby(key)['fare_amount']
                s=g.sum(); c=g.count()
                te=(s+prior*m_s)/(c+m_s); mp=te.to_dict(); cp=c.to_dict()
                sel=valmask
                te_arr[sel]=df.loc[sel,key].map(mp).fillna(prior).to_numpy(np.float32)
                cnt_arr[sel]=np.log1p(df.loc[sel,key].map(cp).fillna(0).to_numpy()).astype(np.float32)
            out[prefix+key+'_te']=te_arr
            out[prefix+key+'_cnt']=cnt_arr
    return out

if not args.no_te:
    nf=5
    fold=rng.integers(0,nf,len(df))
    df['_fold']=fold
    keys=[('_pc',20.0),('_dc',20.0)]
    for k,v in add_te(~df['_ho'].to_numpy(),keys,0,'',oof_folds=nf).items():
        df[k]=v
    keys_od=[('_od',10.0),('_pc3',10.0)]
    for k,v in add_te(~df['_ho'].to_numpy(),keys_od,0,'',oof_folds=nf).items():
        df[k]=v
    # for holdout and final: full-train maps
    for key,m_s in [('_pc',20.0),('_dc',20.0),('_od',10.0),('_pc3',10.0)]:
        tm=~df['_ho'].to_numpy()
        prior=float(y[tm].mean())
        g=df.loc[tm].groupby(key)['fare_amount']; s=g.sum(); c=g.count()
        te=((s+prior*m_s)/(c+m_s)).to_dict(); cp=c.to_dict()
        hm=df['_ho'].to_numpy()
        df.loc[hm,key+'_te']=df.loc[hm,key].map(te).fillna(prior).to_numpy(np.float32)
        df.loc[hm,key+'_cnt']=np.log1p(df.loc[hm,key].map(cp).fillna(0).to_numpy()).astype(np.float32)
    del fold; gc.collect()
    print('TE done', f'{time.time()-t0:.0f}s', flush=True)

feats=[c for c in df.columns if c not in ('fare_amount','_ho','_pc','_dc','_pc3','_od','_fold')]
print('nfeat',len(feats), feats, flush=True)
X=df[feats].to_numpy(np.float32)
trm=(~df['_ho']).to_numpy(); hom=df['_ho'].to_numpy()
Xtr,ytr=X[trm],y[trm]; Xho,yho=X[hom],y[hom]
del df,X; gc.collect()
print('data ready', Xtr.shape, f'{time.time()-t0:.0f}s', flush=True)

params=dict(objective='regression', metric='rmse', learning_rate=args.lr,
    num_leaves=args.leaves, min_data_in_leaf=args.min_data, feature_fraction=0.85,
    bagging_fraction=0.8, bagging_freq=1, lambda_l2=1.0, max_bin=255,
    num_threads=args.threads, seed=args.seed, verbosity=-1)
dtr=lgb.Dataset(Xtr, label=ytr)
dho=lgb.Dataset(Xho, label=yho, reference=dtr)
ev={}
model=lgb.train(params, dtr, num_boost_round=args.rounds, valid_sets=[dho],
    callbacks=[lgb.early_stopping(100), lgb.log_evaluation(100), lgb.record_evaluation(ev)])
rmse=model.best_score['valid_0']['rmse']
print('HOLDOUT_RMSE', rmse, 'best_iter', model.best_iteration, flush=True)
os.makedirs('models',exist_ok=True)
model.save_model(f'models/lgb_{args.tag}.txt')
np.save(f'models/lgb_{args.tag}_feats.npy', np.array(feats))
imp=sorted(zip(feats,model.feature_importance('gain')), key=lambda x:-x[1])
for f,i in imp[:20]: print(f'{f}: {i:.0f}')
print('DONE', f'{time.time()-t0:.0f}s')
