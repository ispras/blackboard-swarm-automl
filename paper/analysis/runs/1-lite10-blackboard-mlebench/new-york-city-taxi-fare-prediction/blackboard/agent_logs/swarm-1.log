import numpy as np, pandas as pd, os, glob
from scipy.optimize import nnls
B='/download_job_code/payload/sandbox/workspaces'
def pairs(agent,sub=''):
    d={}
    for f in glob.glob(f'{B}/{agent}/{sub}holdout_pred_*.npy'):
        tag=os.path.basename(f)[len('holdout_pred_'):-4]
        o=f'{B}/{agent}/{sub}holdout_orig_{tag}.npy'
        if os.path.exists(o): d[tag]=(o,f)
    return d
allp={}
for agent,sub in [('canopus_pi','preds/'),('mimosa_omicron',''),('aldebaran_omicron','')]:
    for tag,(o,f) in pairs(agent,sub).items():
        allp[f'{agent[:3]}_{tag}']=(o,f)
print('models:',sorted(allp))
idx=None; cache={}
for k,(o,f) in allp.items():
    oi=np.load(o); s=set(oi.tolist()); idx=s if idx is None else idx&s
idx=np.array(sorted(idx)); print('common rows',len(idx))
def align(o,f):
    oi=np.load(o); p=np.load(f); pos=pd.Series(np.arange(len(oi)),index=oi); return p[pos.loc[idx].to_numpy()].astype(np.float64)
cols={k:align(*v) for k,v in allp.items()}
# y from any canopus true
y=np.load(f'{B}/canopus_pi/preds/holdout_true_canopus_f54m.npy'); oi=np.load(f'{B}/canopus_pi/preds/holdout_orig_canopus_f54m.npy')
y=y[pd.Series(np.arange(len(oi)),index=oi).loc[idx].to_numpy()].astype(np.float64)
res=[]
for k,v in cols.items(): res.append((np.sqrt(np.mean((v-y)**2)),k))
for r,k in sorted(res): print(f'{r:.4f}  {k}')
# keep models with rmse<3.6 and not corrupt/fallback
keep=[k for r,k in sorted(res) if r<3.6 and 'corrupt' not in k and 'fallback' not in k and 'smoke' not in k and 'dbg' not in k]
print('keep',keep)
names=keep; A=np.stack([cols[k] for k in names],1)
# 5fold CV
rng=np.random.default_rng(0); fold=rng.integers(0,5,len(y))
predcv=np.zeros(len(y))
for f in range(5):
    tr=fold!=f; va=fold==f
    w,_=nnls(A[tr],y[tr]); predcv[va]=A[va]@w
print('CV blend rmse',np.sqrt(np.mean((predcv-y)**2)))
w,_=nnls(A,y)
print('full weights',dict(zip(names,np.round(w,3))))
print('full in-sample',np.sqrt(np.mean((A@w-y)**2)))
EOF
