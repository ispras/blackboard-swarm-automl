import numpy as np, pandas as pd
from scipy.optimize import nnls
B='/download_job_code/payload/sandbox/workspaces'
def load(a,t,s=''):
    return np.load(f'{B}/{a}/{s}holdout_orig_{t}.npy'), np.load(f'{B}/{a}/{s}holdout_pred_{t}.npy')
models={'can_j54m':('canopus_pi','canopus_j54m','preds/'),'can_g54m':('canopus_pi','canopus_g54m','preds/'),
 'mim_16384':('mimosa_omicron','xgb2t3lg16384_full',''),'mim_log':('mimosa_omicron','xgb2log_full',''),
 'mim_nn':('mimosa_omicron','nn_full','')}
data={k:load(*v) for k,v in models.items()}
idx=None
for k,(o,p) in data.items():
    s=set(o.tolist()); idx=s if idx is None else idx&s
idx=np.array(sorted(idx)); print('n',len(idx))
def al(o,p):
    pos=pd.Series(np.arange(len(o)),index=o); return p[pos.loc[idx].to_numpy()].astype(np.float64)
cols={k:al(*v) for k,v in data.items()}
to=np.load(f'{B}/canopus_pi/preds/holdout_orig_canopus_j54m.npy'); ty=np.load(f'{B}/canopus_pi/preds/holdout_true_canopus_j54m.npy')
y=ty[pd.Series(np.arange(len(to)),index=to).loc[idx].to_numpy()].astype(np.float64)
names=list(cols); A=np.stack([cols[k] for k in names],1)
rng=np.random.default_rng(0); fold=rng.integers(0,5,len(y))
# nested OOF: fit blend weights on 4 folds, eval on 1; then residual correction trained on 4 folds' residuals
base=np.zeros(len(y)); corr=np.zeros(len(y))
# load holdout cells aligned by orig_idx
h=pd.read_parquet('/download_job_code/payload/sandbox/workspaces/canopus_pi/prep/holdout.parquet',columns=['plon','plat','orig_idx'])
h=h.set_index('orig_idx').loc[idx]
def cell(la,lo):
    ilat=((la-40.0)*100).round().astype(np.int64); ilon=((lo+74.0)*100).round().astype(np.int64)
    return (ilat+1000)*100000+(ilon+5000)
pc=cell(h.plat.values,h.plon.values)
# also dropoff cell
h2=pd.read_parquet('/download_job_code/payload/sandbox/workspaces/canopus_pi/prep/holdout.parquet',columns=['dlon','dlat','orig_idx']).set_index('orig_idx').loc[idx]
dc=cell(h2.dlat.values,h2.dlon.values)
print('cells',len(np.unique(pc)),len(np.unique(dc)))
for f in range(5):
    tr=fold!=f; va=fold==f
    w,_=nnls(A[tr],y[tr]); base[va]=A[va]@w
print('blend OOF base rmse',np.sqrt(np.mean((base-y)**2)))
res=y-base
for name,cellarr,m in [('pc',pc,100.0),('dc',dc,100.0)]:
    for f in range(5):
        tr=fold!=f; va=fold==f
        g=pd.Series(res[tr]).groupby(cellarr[tr]).agg(['sum','count'])
        prior=res[tr].mean()
        mp=((g['sum']+prior*m)/(g['count']+m)).to_dict()
        cc=pd.Series(cellarr[va]).map(mp).fillna(prior).to_numpy()
        corr[va]=cc
    pred=base+corr
    print(name,'corrected rmse',np.sqrt(np.mean((pred-y)**2)),'corr mean',corr.mean())
# combined pc+dc
corr2=np.zeros(len(y)); 
for f in range(5):
    tr=fold!=f; va=fold==f
    add=np.zeros(va.sum())
    for cellarr in [pc,dc]:
        g=pd.Series(res[tr]).groupby(cellarr[tr]).agg(['sum','count']); prior=res[tr].mean()
        mp=((g['sum']+prior*100)/(g['count']+100)).to_dict()
        add+=pd.Series(cellarr[va]).map(mp).fillna(0).to_numpy()
    corr2[va]=add  # note: using res from base (not iteratively)
pred=base+corr2
print('pc+dc corrected rmse',np.sqrt(np.mean((pred-y)**2)))
