x=ex[clean,2]; y=fare[clean]; m=~np.isnan(x)
# best affine
A=np.vstack([x[m],np.ones(m.sum())]).T; coef=np.linalg.lstsq(A,y[m],rcond=None)[0]
print('te_r linear rmse',np.sqrt(np.mean((A@coef-y[m])**2)),coef)
