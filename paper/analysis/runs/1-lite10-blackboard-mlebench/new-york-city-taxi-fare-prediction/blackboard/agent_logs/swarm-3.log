print('hybrid all',np.sqrt(np.mean((hybrid-y)**2)))
print('one-valid: model',np.sqrt(np.mean((oof[ov]-y[ov])**2)),'cellmean',np.sqrt(np.mean((hybrid[ov]-y[ov])**2)),'const',np.sqrt(np.mean((y[ov]-y[ov].mean())**2)))
print('both-zero unchanged',np.sqrt(np.mean((hybrid[bz]-y[bz])**2)))
# blend model and cellmean on one-valid
for a in [0.0,0.3,0.5,0.7,1.0]:
    p=hybrid.copy(); p[ov]=a*oof[ov]+(1-a)*np.where(pv[ov],pm[ov],dm[ov])
    print('alpha(model)',a,'all',np.sqrt(np.mean((p-y)**2)))
