import os, json, time, argparse
import numpy as np
import pandas as pd
import xgboost as xgb
from common import NONSPATIAL, parts_v2

OUT = "/download_job_code/payload/sandbox/workspaces/mimosa_omicron"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--rounds", type=int, default=1200)
    ap.add_argument("--eta", type=float, default=0.05)
    ap.add_argument("--depth", type=int, default=8)
    ap.add_argument("--tag", type=str, default="fallback")
    ap.add_argument("--threads", type=int, default=16)
    args = ap.parse_args()
    pl = parts_v2()
    dfs = [pd.read_parquet(p, columns=["orig_idx", "fare_amount"] + NONSPATIAL) for p in pl]
    df = pd.concat(dfs, ignore_index=True)
    del dfs
    hold = (df["orig_idx"].to_numpy() % 100 == 0)
    y = df["fare_amount"].to_numpy(np.float32)
    X = df[NONSPATIAL].to_numpy(np.float32)
    Xtr, ytr = X[~hold], y[~hold]
    Xva, yva = X[hold], y[hold]
    params = {"device": "cuda", "tree_method": "hist", "max_bin": 128,
              "objective": "reg:squarederror", "eval_metric": "rmse",
              "eta": args.eta, "max_depth": args.depth, "min_child_weight": 300,
              "subsample": 0.8, "colsample_bytree": 0.8, "reg_lambda": 1.0,
              "seed": 42, "nthread": args.threads, "verbosity": 1}
    dtr = xgb.DMatrix(Xtr, label=ytr, feature_names=NONSPATIAL)
    dva = xgb.DMatrix(Xva, label=yva, feature_names=NONSPATIAL)
    bst = xgb.train(params, dtr, num_boost_round=args.rounds, evals=[(dva, "val")],
                    early_stopping_rounds=50, verbose_eval=100)
    best = bst.best_iteration
    pv = bst.predict(dva, iteration_range=(0, best + 1))
    rmse = float(np.sqrt(np.mean((pv - yva) ** 2)))
    print(f"FALLBACK_HOLDOUT_RMSE={rmse:.5f} best={best}", flush=True)
    bst.save_model(os.path.join(OUT, f"model_{args.tag}.json"))
    np.save(os.path.join(OUT, f"holdout_pred_{args.tag}.npy"), pv.astype(np.float32))
    with open(os.path.join(OUT, f"result_{args.tag}.json"), "w") as f:
        json.dump({"rmse": rmse, "best": int(best), "features": NONSPATIAL}, f, indent=2)


if __name__ == "__main__":
    main()
