def cell(lat,lon,res=0.01):
    clat=np.floor((lat-40.0)/res).astype(np.int64); clon=np.floor((lon+75.0)/res).astype(np.int64)
    return clat*10000+clon
# build separate keys
kp=np.where(pv, cell(df['p_lat'].to_numpy(np.float64),df['p_lon'].to_numpy(np.float64)), -1)
kd=np.where(dv, cell(df['d_lat'].to_numpy(np.float64),df['d_lon'].to_numpy(np.float64)), -1)
prior=float(y.mean()); K=10.0; fold=oi%5
def oof_cell_mean(keys, mask_valid):
    out=np.full(len(y), np.nan, np.float32)
    for f in range(5):
        tr=(fold!=f)
        s=pd.Series(y[tr]).groupby(keys[tr]).agg(['sum','count'])
        m=((s['sum']+K*prior)/(s['count']+K))
        sel=(fold==f)
        out[sel]=pd.Series(keys[sel]).map(m).fillna(prior).to_numpy(np.float32)
    return out
pm=oof_cell_mean(kp, pv); dm=oof_cell_mean(kd, dv)
hybrid=oof.copy()
hybrid[ov]=np.where(pv[ov], pm[ov], dm[ov])
