import pyarrow.parquet as pq, numpy as np
pf=pq.ParquetFile('features_train.parquet')
b=next(pf.iter_batches(batch_size=300000, columns=['fare_amount','dist','plat','plon','dlat','dlon','passenger_count','year','hour']))
d={c:b.column(c).to_numpy(zero_copy_only=False).astype(np.float32) for c in b.schema.names}
fare=d['fare_amount']; dist=d['dist']
clean=(fare>=2.5)&(fare<=500)&(d['plat']>-75)&(d['plat']<42)&(d['plon']>-75)&(d['plon']<-72)&(d['dlat']>39)&(d['dlat']<42)&(d['dlon']>-75)&(d['dlon']<-72)
print('clean frac',clean.mean())
print('fare mean',fare[clean].mean(),'rmse mean',np.sqrt(np.mean((fare[clean]-fare[clean].mean())**2)))
# linear on dist
import numpy as np
x=dist[clean]; y=fare[clean]
A=np.vstack([x,np.ones_like(x)]).T
coef,_,_,_=np.linalg.lstsq(A,y,rcond=None)
pred=A@coef
print('coef',coef,'linear rmse',np.sqrt(np.mean((y-pred)**2)))
print('dist quantiles',np.quantile(x,[0,.01,.5,.99,1]))
print('fare quantiles',np.quantile(y,[0,.01,.5,.99,1]))
# high fare
print('frac fare>100',(y>100).mean(),'mse contrib>100',np.mean((y-pred)**2*0))
