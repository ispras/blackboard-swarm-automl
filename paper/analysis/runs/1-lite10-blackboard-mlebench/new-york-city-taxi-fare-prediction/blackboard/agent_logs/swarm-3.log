    fare=d['fare_amount']
    bad=lambda lon,lat:(lon<LONMIN)|(lon>LONMAX)|(lat<LATMIN)|(lat>LATMAX)
    cm=bad(d['plon'],d['plat'])|bad(d['dlon'],d['dlat'])
    clean=(fare>=2.5)&(fare<=500)&(d['passenger_count']<=8)
    rows.append((clean&cm, fare, cm))
    if len(rows)*750_000>12_000_000: break
cm=np.concatenate([r[0] for r in rows]); fare=np.concatenate([r[1] for r in rows]); anycm=np.concatenate([r[2] for r in rows])
