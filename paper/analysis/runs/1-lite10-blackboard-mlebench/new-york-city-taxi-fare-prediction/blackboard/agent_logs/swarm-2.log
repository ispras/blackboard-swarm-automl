print('not both rmse model',np.sqrt(np.mean((oof[~pz]-y[~pz])**2)),'const',np.sqrt(np.mean((y[~pz]-y[~pz].mean())**2)))
np.save('/download_job_code/payload/sandbox/workspaces/aldebaran_omicron/corrupt_oof.npy',oof)
