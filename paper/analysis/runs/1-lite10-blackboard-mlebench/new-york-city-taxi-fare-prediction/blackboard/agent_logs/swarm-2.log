import numpy as np, pandas as pd
from common import parts_v2
for res in [0.01, 0.005, 0.003]:
    pl = parts_v2()
    allr = []
    for p in pl:
        df = pd.read_parquet(p, columns=["pickup_latitude","pickup_longitude","dropoff_latitude","dropoff_longitude"])
        def cell(lat, lon):
            clat=np.floor((lat.to_numpy()-40.0)/res).astype(np.int64)
            clon=np.floor((lon.to_numpy()+75.0)/res).astype(np.int64)
            return clat*10000+clon
        pc=cell(df.pickup_latitude, df.pickup_longitude); dc=cell(df.dropoff_latitude, df.dropoff_longitude)
        allr.append((pc+1200000)*8000000+(dc+1200000))
    r=np.concatenate(allr)
    u=np.unique(r)
    print("res",res,"unique routes",len(u),"avg rows",len(r)/len(u), flush=True)
EOF
