import json
from rapidfuzz.distance import Levenshtein
h={x['id']:x for x in json.load(open('holdout.json'))}
rows=[json.loads(l) for l in open('rerank_200.jsonl')]
print('n',len(rows), 'ids', rows[0]['id'], rows[-1]['id'])
def ins(toks,gap,w): return ' '.join(toks[:gap]+[w]+toks[gap:])
# their MAP: max gpt2 logp (4th field)
ds=[];gacc=0;wacc=0;oracle=[]
for r in rows:
    t=h[r['id']]; cands=r['cands']
    best=max(cands,key=lambda c:c[3])
    pred=ins(t['inp'],best[0],best[1])
    ds.append(Levenshtein.distance(' '.join(t['true']),pred))
    gacc+=int(best[0]==t['gap']); wacc+=int(best[0]==t['gap'] and best[1]==t['word'])
    oracle.append(min(Levenshtein.distance(' '.join(t['true']),ins(t['inp'],c[0],c[1])) for c in cands))
