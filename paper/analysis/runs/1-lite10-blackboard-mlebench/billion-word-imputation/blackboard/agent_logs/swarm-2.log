    o=json.loads(l); casc[o['id']]={int(c[0]):c for c in o['cands']}
xl={}
for l in open(f'{A}/rm_t1_rev_2000.jsonl'):
    o=json.loads(l); xl[o['id']]={int(c[0]):float(c[2]) for c in o['cands']}
qw={}
for l in open(f'{BASE}/../castor_iota/rrk_qwen15_2000.jsonl'):
    o=json.loads(l); qw[o['id']]={int(c[0]):float(c[2]) for c in o['cands']}
sm={}
for l in open(f'{BASE}/../castor_iota/rrk_smol17_2000.jsonl'):
    o=json.loads(l); sm[o['id']]={int(c[0]):float(c[2]) for c in o['cands']}
SHORT=['e','a','s','t','i','o','in','to','of','the','and']
ids=sorted(set(truth)&set(mlm)&set(casc)&set(xl)&set(qw)&set(sm))
res={'top1':[], 'median8':[], 'median_short':[], 'oracle_word':[]}
for i in ids:
    t=truth[i]; toks=t['sentence'].split(); b=casc[i]
    top3=sorted(b,key=lambda g:-b[g][2])[:3]
    mlmg={int(g):gl for g,gl in mlm[i]['gaps']}
    # choose gap by blend top (raw); compute word variants
    blend={g:(b[g][2]+xl[i].get(g,b[g][2])+qw[i].get(g,b[g][2])+sm[i].get(g,b[g][2]))/4 for g in top3}
    g=max(blend,key=blend.get)
    gl=mlmg.get(g,[])
    if not gl: 
        for k in res: res[k].append(Levenshtein.distance(t['orig'],t['sentence']))
        continue
    ws=[w for p,w in gl][:8]; ps=np.array([p for p,w in gl][:8],float); ps/=ps.sum()
    def cost(w): return Levenshtein.distance(t['orig'],' '.join(toks[:g]+[w]+toks[g:]))
    res['top1'].append(cost(ws[0]))
    cand=list(ws)
    def med(cands):
        best=(1e9,None)
        for w in cands:
            e=sum(ps[idx]*Levenshtein.distance(w,v) for idx,v in enumerate(ws))
            if e<best[0]: best=(e,w)
        return best[1]
    res['median8'].append(cost(med(ws)))
    cs=ws+[s for s in SHORT if s not in ws]
    res['median_short'].append(cost(med(cs)))
    res['oracle_word'].append(min(cost(w) for w in ws))
for k,v in res.items(): print(k, round(float(np.mean(v)),4))
