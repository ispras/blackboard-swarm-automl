import json, numpy as np
from rapidfuzz.distance import Levenshtein
BASE="/download_job_code/payload/sandbox/workspaces/alkaid_pi"
A="/download_job_code/payload/sandbox/workspaces/achernar_tau"
truth={t['id']:t for t in (json.loads(l) for l in open(f'{BASE}/holdout/holdout_truth.jsonl'))}
ft={}
for l in open(f'{A}/rm_ftmedium_holdout.jsonl'):
    o=json.loads(l); ft[o['id']]={int(c[0]):float(c[2]) for c in o['cands']}
casc={r['id']:r for r in (json.loads(l) for l in open(f'{A}/cascade_holdout_k4_1997.jsonl'))}
seen=set(json.load(open('/tmp/opencode/seen_ids.json')))
allids=sorted(set(casc)&set(ft))
def ident(i): return len(truth[i]['word'])+1
def cost(i,g,w):
    t=truth[i]; toks=t['sentence'].split()
    return Levenshtein.distance(t['orig'],' '.join(toks[:g]+[w]+toks[g:])),(g==t['gap'])
def evalv(ids,members,tau):
    cs=[];gok=0
    for i in ids:
        rows=[]
        for c in casc[i]['cands']:
            g=int(c[0]); d=dict(base=c[4],xl=c[5],qwen=c[6],smol=c[7]); d['ft']=ft[i].get(g,np.nan); rows.append((g,c[1],d))
        s=np.array([np.mean([d[m] for m in members]) for _,_,d in rows])
        j=int(np.argmax(s)); margin=s[j]-(np.sort(s)[-2] if len(s)>1 else s[j])
        if margin<tau: cs.append(ident(i))
        else:
            c,ok=cost(i,rows[j][0],rows[j][1]);cs.append(c);gok+=int(ok)
    return np.array(cs),gok/len(ids)
def best(ids,members):
    b=(1e9,None,None)
    for tau in np.arange(0,0.3,0.005):
        c,g=evalv(ids,members,tau)
        if c.mean()<b[0]: b=(c.mean(),tau,(c,g))
    return b
def ci(a,b,n=2000):
    d=a-b;rng=np.random.default_rng(0)
    bs=[d[rng.integers(0,len(d),len(d))].mean() for _ in range(n)]
    return d.mean(),*np.percentile(bs,[2.5,97.5])
for name,ids in [('ALL',allids),('UNSEEN',[i for i in allids if i not in seen]),('SEEN',[i for i in allids if i in seen])]:
    b4=best(ids,['base','xl','qwen','smol']); b5=best(ids,['base','xl','qwen','smol','ft'])
    dm,lo,hi=ci(b5[2][0],b4[2][0])
    print(f'{name:7s} n={len(ids):5d} 4m={b4[0]:.4f}(tau{b4[1]:.3f}) 5m={b5[0]:.4f}(tau{b5[1]:.3f}) diff={dm:+.4f} CI[{lo:+.4f},{hi:+.4f}] gap5={b5[2][1]:.3f}')
EOF
