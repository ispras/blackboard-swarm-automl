orc=df.groupby('id').cost.min(); order=orc.index.values
ident=np.array([tw[i] for i in order])
def report(pred,name):
    d=df[['id','cost']].copy(); d['pc']=pred
    idx=d.groupby('id')['pc'].idxmin(); sel=d.loc[idx].set_index('id')
    c=sel['cost'].reindex(order).values; pc=sel['pc'].reindex(order).values; idc=ident
    print(f'[{name}] nofb={c.mean():.4f}',end=' ')
    best=(1e9,None)
    for tau in np.arange(4.0,7.51,0.125):
        v=np.where(pc>tau,idc,c).mean()
        if v<best[0]: best=(v,tau)
    print(f'bestfb={best[0]:.4f} tau={best[1]:.3f}')
print('rows',len(df),'ids',df.id.nunique(),'oracle+id',np.minimum(orc.values,ident).mean())
gkf=GroupKFold(5)
params=dict(objective='regression',metric='l2',num_leaves=127,learning_rate=0.03,n_estimators=1200,
