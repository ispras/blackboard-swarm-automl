import pandas as pd, numpy as np, json
df=pd.read_parquet('cascade_k4_feats.parquet'); truth={t['id']:t for t in (json.loads(l) for l in open('holdout/holdout_truth.jsonl'))}
tw={i:len(t['word'])+1 for i,t in truth.items()}
ids=sorted(df.id.unique())
# per id get: blend margin, cascade top cost, base top (among all gaps) cost -- but df only top4 by base; base top1 is in df (base rank 0)
res=[]
for i in ids:
    g=df[df.id==i]
    bs=g.blend.values; order=np.argsort(-bs); top=g.iloc[order[0]]; sec=g.iloc[order[1]] if len(g)>1 else top
    margin=top.blend-sec.blend
    btop=g.iloc[np.argmax(g.base.values)]
    res.append((i,margin,top.cost,btop.cost,tw[i]))
res=pd.DataFrame(res,columns=['id','margin','casc_cost','base_top_cost','ident'])
print('n',len(res))
for tau in [0.02,0.04,0.06,0.08,0.10]:
    lo=res[res.margin<tau]
    print(f'tau {tau}: n={len(lo)} identity={lo.ident.mean():.3f} cascade_top={lo.casc_cost.mean():.3f} base_top={lo.base_top_cost.mean():.3f} min(ident,base_top)={np.minimum(lo.ident,lo.base_top_cost).mean():.3f}')
EOF
