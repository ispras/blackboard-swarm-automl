import pandas as pd, numpy as np, lightgbm as lgb, json
from sklearn.model_selection import GroupKFold
df=pd.read_parquet('cascade_feats_holdout.parquet')
truth={t['id']:t for t in (json.loads(l) for l in open('holdout/holdout_truth.jsonl'))}
tw={i:len(t['word'])+1 for i,t in truth.items()}
# top blend row per id
idx=df.groupby('id')['blend'].idxmax(); top=df.loc[idx].reset_index(drop=True)
top['ident']=[tw[i] for i in top.id]
top['insert_better']=(top['cost']<top['ident']).astype(int)
# add margin and second blend
sec=df.drop(idx).groupby('id')['blend'].max().rename('blend2')
top=top.merge(sec,on='id',how='left'); top['blend_margin']=top['blend']-top['blend2'].fillna(top['blend'])
drop=['id','g','w','cost','insert_better','ident','blend2']
feats=[c for c in top.columns if c not in drop]
print('ids',len(top),'insert_better rate',top.insert_better.mean())
gkf=GroupKFold(5); oof=np.zeros(len(top)); groups=top.id.values
params=dict(objective='binary',metric='auc',num_leaves=15,learning_rate=0.05,n_estimators=400,
            min_child_samples=40,subsample=0.8,colsample_bytree=0.8,reg_lambda=2.0,n_jobs=8,verbose=-1)
for tr,va in gkf.split(top,groups=groups):
    m=lgb.LGBMClassifier(**params); m.fit(top.iloc[tr][feats],top.iloc[tr].insert_better); oof[va]=m.predict_proba(top.iloc[va][feats])[:,1]
best=(1e9,None)
for tau in np.arange(0.05,0.96,0.01):
    v=np.where(oof>tau,top.cost.values,top.ident.values).mean()
    if v<best[0]: best=(v,tau)
print('binary insert/identity: best=%.4f tau=%.2f'%best)
print('always insert=%.4f always identity=%.4f'%(top.cost.mean(),top.ident.mean()))
# raw margin rule on this set
best=(1e9,None)
for tau in np.arange(0,0.5,0.005):
    v=np.where(top.blend_margin.values<tau,top.ident.values,top.cost.values).mean()
    if v<best[0]: best=(v,tau)
print('raw margin rule best=%.4f tau=%.3f'%best)
