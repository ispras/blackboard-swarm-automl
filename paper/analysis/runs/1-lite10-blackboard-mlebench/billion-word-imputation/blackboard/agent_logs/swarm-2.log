import pandas as pd, numpy as np, lightgbm as lgb, json
from sklearn.model_selection import GroupKFold
df=pd.read_parquet("cascade_k4_feats.parquet")
truth={t["id"]:t for t in (json.loads(l) for l in open("holdout/holdout_truth.jsonl"))}
tw={i:len(t["word"])+1 for i,t in truth.items()}
idx=df.groupby("id")["blend"].idxmax(); top=df.loc[idx].reset_index(drop=True)
top["ident"]=[tw[i] for i in top.id]; top["ib"]=(top.cost<top.ident).astype(int)
sec=df.drop(idx).groupby("id")["blend"].max().rename("blend2"); top=top.merge(sec,on="id",how="left")
top["blend_margin"]=top.blend-top.blend2.fillna(top.blend)
drop=["id","g","w","cost","ib","ident","blend2"]
feats=[c for c in top.columns if c not in drop]
gkf=GroupKFold(5); oof=np.zeros(len(top)); groups=top.id.values
params=dict(objective="binary",metric="auc",num_leaves=15,learning_rate=0.05,n_estimators=400,min_child_samples=50,subsample=0.8,colsample_bytree=0.8,reg_lambda=3.0,n_jobs=8,verbose=-1)
