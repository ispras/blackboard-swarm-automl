gidx={i:np.where(df.id.values==i)[0] for i in ids}
yv=df[["id","cost","g"]].copy()
tg={i:int(truth[i]["gap"]) for i in ids}

def evalw(w,tau=0.06):
    sc=S@w
    cost=[];gapok=0
    for i in order:
        ii=gidx[i]; s=sc[ii]; c=df.cost.values[ii]; g=df.g.values[ii]
        j=int(np.argmax(s)); margin=s[j]-(np.sort(s)[-2] if len(s)>1 else s[j])
        if margin<tau: cost.append(tw[i]); continue
        cost.append(c[j]); gapok+=int(g[j]==tg[i])
    return float(np.mean(cost)), gapok/len(order)

eq=np.array([.25,.25,.25,.25])
print("equal allgaps-top3 mean/gapacc", evalw(eq))
best=(1e9,None)
rng=np.random.default_rng(0)
for it in range(4000):
    w=rng.dirichlet(np.ones(4))
    m,ga=evalw(w)
    if m<best[0]: best=(m,w.copy(),ga)
print("best random", best[0], best[1], best[2])
# refine around best
bw=best[1]
for it in range(3000):
    w=np.abs(bw+rng.normal(0,0.05,4)); w/=w.sum()
    m,ga=evalw(w)
    if m<best[0]: best=(m,w.copy(),ga); bw=w
print("refined", best[0], best[1], best[2])
# CV honest for weights fitted per fold
sc_all=S.copy()
gkf=GroupKFold(5)
oof_cost=np.zeros(len(order)); 
acc=[]
for tr_ids,va_ids in gkf.split(order,groups=order):
    trset=set(order[tr_ids]); vaset=set(order[va_ids])
    trmask=np.array([i in trset for i in df.id.values])
    def ev(w,tau=0.06):
        sc=S@w; out={}
        for i in order[tr_ids]:
            ii=gidx[i]; s=sc[ii]; c=df.cost.values[ii]; j=int(np.argmax(s)); margin=s[j]-(np.sort(s)[-2] if len(s)>1 else s[j])
            out[i]= tw[i] if margin<tau else c[j]
        return np.mean(list(out.values()))
    bb=(1e9,None)
    for it in range(1500):
        w=rng.dirichlet(np.ones(4)); 
        v=ev(w)
        if v<bb[0]: bb=(v,w.copy())
    w=bb[1]
    for k,i in enumerate(order[va_ids]):
        ii=gidx[i]; s=(S@w)[ii]; c=df.cost.values[ii]; j=int(np.argmax(s)); margin=s[j]-(np.sort(s)[-2] if len(s)>1 else s[j])
        oof_cost[va_ids[k]]= tw[i] if margin<0.06 else c[j]
print("CV weight-optimized mean", oof_cost.mean())
print("CV equal-weight mean", None)
