MAXLINE=9_000_000
captured={}   # line_idx -> n_tokens
boundary=None
cum=0
with open('train_v2.txt',encoding='utf-8') as f:
    for i,line in enumerate(f):
        if i>=MAXLINE: break
        if boundary is None:
            cum+=len(line)
            if cum>=200_000_000: boundary=i
        if i in sset:
