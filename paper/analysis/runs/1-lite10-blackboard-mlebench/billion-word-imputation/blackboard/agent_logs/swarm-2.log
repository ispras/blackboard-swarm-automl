print('boundary line',boundary,'captured kept',len(kept))
print('ids <=1990:',len([j for j in id2line if j<=1990]),'seen among them:',len([j for j in seen if j<=1990]))
print('seen ids sample', [j for j in seen if j<=1990][:20])
json.dump({str(j):ln for j,ln in id2line.items()}, open('/tmp/opencode/id2line.json','w'))
json.dump(seen, open('/tmp/opencode/seen_ids.json','w'))
EOF
