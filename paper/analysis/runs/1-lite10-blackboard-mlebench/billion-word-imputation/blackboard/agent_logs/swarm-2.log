import json, numpy as np
from rapidfuzz.distance import Levenshtein
BASE='/download_job_code/payload/sandbox/workspaces/alkaid_pi'
A='/download_job_code/payload/sandbox/workspaces/achernar_tau'
truth={t['id']:t for t in (json.loads(l) for l in open(f'{BASE}/holdout/holdout_truth.jsonl'))}
mlm={m['id']:m for m in (json.loads(l) for l in open(f'{A}/mlm_cands_holdout.jsonl'))}
casc={r['id']:r for r in (json.loads(l) for l in open(f'{A}/cascade_holdout_k4_1997.jsonl'))}
t5={}
for l in open(f'{A}/rm_t5_fwd_2000.jsonl'):
    o=json.loads(l); d={}
    for c in o['cands']:
        d.setdefault(int(c[0]),[]).append((c[1],float(c[2])))
    t5[o['id']]=d
tw={i:len(t['word'])+1 for i,t in truth.items()}
ids=sorted(set(casc)&set(mlm)&set(t5))
base_cost=[]; xl_cost=[]; bigr_cost=[]; oracle=[]
for i in ids:
    t=truth[i]; toks=t['sentence'].split()
    cands=casc[i]['cands']; blends=[c[2] for c in cands]
    j=int(np.argmax(blends)); g=int(cands[j][0])
    # cascade margin fallback
    margin=blends[j]-(sorted(blends)[-2] if len(blends)>1 else blends[j])
    mlmg={int(gg):gl for gg,gl in mlm[i]['gaps']}
    gl=mlmg.get(g,[])
    def cost(w): return Levenshtein.distance(t['orig'],' '.join(toks[:g]+[w]+toks[g:]))
    if margin<0.06:
        base_cost.append(tw[i]); xl_cost.append(tw[i]); bigr_cost.append(tw[i]); oracle.append(tw[i]); continue
    w_mlm=gl[0][1] if gl else cands[j][1]
    base_cost.append(cost(w_mlm))
    opts=t5[i].get(g,[])
    if opts:
        w_xl=max(opts,key=lambda x:x[1])[0]
    else: w_xl=w_mlm
    xl_cost.append(cost(w_xl))
    # bigram-based choose among mlm top8 minimizing expected lev
    ws=[w for p,w in gl][:8]; ps=np.array([p for p,w in gl][:8],float)
    if len(ws):
        ps=ps/ps.sum()
        best=(1e9,None)
        for w in ws:
            e=sum(ps[k]*Levenshtein.distance(w,v) for k,v in enumerate(ws))
            if e<best[0]: best=(e,w)
        w_b=best[1]
    else: w_b=w_mlm
    bigr_cost.append(cost(w_b))
    oracle.append(min(cost(w) for w in ws) if len(ws) else cost(w_mlm))
for name,v in [('mlm_top1',base_cost),('xl_top5_word',xl_cost),('median_string',bigr_cost),('oracle_word',oracle)]:
    print(name, round(float(np.mean(v)),4))
