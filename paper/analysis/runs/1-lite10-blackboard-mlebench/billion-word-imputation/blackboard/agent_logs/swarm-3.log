    else: word="the"
    if gap==t["gap"]:
        gc+=1
        if word==t["word"]: wc+=1
    tot+=Levenshtein.distance(t["orig"],recon(toks,gap,word))
print(f"combined(causal gap + mlm word) n={nn} mean={tot/nn:.4f} gap_acc={gc/nn:.3f} word_acc={wc/nn:.3f}")
# also causal gap + best word over top3 words from mlm at that gap
tot=0
for sid,gaps in cl.items():
    if sid not in mlm: continue
    t=truth[sid]; toks=lines[sid].split()
    ordered=sorted(gaps,key=lambda g:-g[1]); gap=ordered[0][0]
    word=mlm[sid].get(gap,[["",'the']])[0][1] if mlm[sid].get(gap) else "the"
    tot+=Levenshtein.distance(t["orig"],recon(toks,gap,word))
print("same mean",tot/nn)
