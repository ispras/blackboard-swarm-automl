import json
from rapidfuzz.distance import Levenshtein
BASE="/download_job_code/payload/sandbox/workspaces/alkaid_pi"
truth={json.loads(l)["id"]:json.loads(l) for l in open(f"{BASE}/holdout/holdout_truth.jsonl")}
lines=[l.rstrip("\n") for l in open(f"{BASE}/holdout/holdout_test.txt") if l.strip()]
def load(fn, scorer=None):
    d={}
    for line in open(fn):
        x=json.loads(line); d[x["id"]]=x["cands"]
    return d
q=load("/download_job_code/payload/sandbox/workspaces/castor_iota/rrk_qwen15_2000.jsonl")
xl=load("rerank_holdout_t1.jsonl")
def recon(toks,gap,word): return " ".join(toks[:gap]+[word]+toks[gap:])
def ev(getscore, ths):
    best=(9,0)
    for th in ths:
        tot=0;gc=0;wc=0;n=0
        for sid,cands in q.items():
            if sid not in xl: continue
            t=truth[sid]; toks=lines[sid].split();n+=1
            # build map
            sc=[]
            for c in cands:
                gap,word=c[0],c[1]
                # find in xl
                xm=None
                for xc in xl[sid]:
                    if xc[0]==gap and xc[1]==word: xm=xc;break
                sc.append((gap,word,getscore(c,xm)))
            order=sorted(sc,key=lambda z:z[2],reverse=True); b=order[0]
            m=b[2]-(order[1][2] if len(order)>1 else -1e9)
            if m<th:p=lines[sid]
            else:
                p=recon(toks,b[0],b[1])
                if b[0]==t["gap"]:
                    gc+=1
                    if b[1]==t["word"]:wc+=1
            tot+=Levenshtein.distance(t["orig"],p)
        v=tot/n
        if v<best[0]:best=(v,th,gc/n,wc/n,n)
    return best
