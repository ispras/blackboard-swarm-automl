print("mean surprise correct",sum(surp_correct)/max(1,len(surp_correct)),"wrong",sum(surp_wrong)/max(1,len(surp_wrong)))
# combined: causal gap + MLM word top1 at that gap
from rapidfuzz.distance import Levenshtein
