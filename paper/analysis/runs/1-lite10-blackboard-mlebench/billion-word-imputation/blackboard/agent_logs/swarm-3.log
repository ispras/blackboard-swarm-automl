import random, json, os, sys

BASE = "/download_job_code/payload/sandbox"
TRAIN = f"{BASE}/workspaces/alkaid_pi/train_v2.txt"
OUT = f"{BASE}/workspaces/alkaid_pi/holdout"
os.makedirs(OUT, exist_ok=True)

N = int(sys.argv[1]) if len(sys.argv) > 1 else 10000
SEED = 42
rng = random.Random(SEED)

# reservoir-sample line indices so offset distribution is uniform over the file
idx = sorted(rng.sample(range(30_000_000), N))
idx_set = set(idx)
rows = {}
with open(TRAIN, encoding="utf-8") as f:
    for i, line in enumerate(f):
        if i in idx_set:
            rows[i] = line.rstrip("\n")
            if len(rows) == len(idx_set):
                break

kept = [rows[i] for i in idx if i in rows and len(rows[i].split()) >= 3]

removed = []      # (id, sentence_without_word, true_word, gap_index, orig_sentence)
for j, s in enumerate(kept):
    toks = s.split()
    n = len(toks)
    # removed word is never first (idx 0) nor last (idx n-1) -> k in 1..n-2
    k = rng.randint(1, n - 2)
    tw = toks[k]
    sent = " ".join(toks[:k] + toks[k + 1:])
    removed.append((j, sent, tw, k, s))

with open(f"{OUT}/holdout_test.txt", "w", encoding="utf-8") as f:
    for j, sent, tw, k, s in removed:
        f.write(sent + "\n")

with open(f"{OUT}/holdout_truth.jsonl", "w", encoding="utf-8") as f:
    for j, sent, tw, k, s in removed:
        f.write(json.dumps({"id": j, "sentence": sent, "word": tw, "gap": k,
                            "orig": s}, ensure_ascii=False) + "\n")

print("wrote", len(removed), "holdout rows to", OUT)
