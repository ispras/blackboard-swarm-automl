print("top3 base=large [large,xl,qwen,smol]",sim(3,[lg,xl,q,sm],[.25]*4,ths,lg))
print("top3 base=large [large,xl,qwen,smol,gj]",sim(3,[lg,xl,q,sm,gj],[.2]*5,ths,lg))
print("top5 base=large [large,xl,qwen,smol]",sim(5,[lg,xl,q,sm],[.25]*4,ths,lg))
