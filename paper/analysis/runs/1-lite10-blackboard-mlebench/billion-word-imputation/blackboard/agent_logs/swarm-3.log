xl=load("rerank_holdout_t1.jsonl"); q=load("/download_job_code/payload/sandbox/workspaces/castor_iota/rrk_qwen15_2000.jsonl"); sm=load("/download_job_code/payload/sandbox/workspaces/castor_iota/rrk_smol17_2000.jsonl"); gj=load("rm_gptj_1000.jsonl")
def recon(toks,gap,word): return " ".join(toks[:gap]+[word]+toks[gap:])
def sim(K, models, weights, ths, restrict_base=True):
