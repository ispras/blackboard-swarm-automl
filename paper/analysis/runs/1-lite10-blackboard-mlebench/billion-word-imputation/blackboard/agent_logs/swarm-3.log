D=[base,xl,q,sm,ft,fl]
ids=[i for i in sorted(set(base)&set(xl)&set(q)&set(sm)&set(ft)&set(fl)) if i<1994]
un200=[i for i in ids if line_of.get(i,0)>=n200]
un350=[i for i in ids if line_of.get(i,0)>=n350]
# precompute candidates with V matrix and costs
def build(idlist):
    out=[]
    for sid in idlist:
        toks=lines[sid].split(); t=truth[sid]
        common=set(base[sid])
        for d in D[1:]: common&=set(d[sid])
        gs={}
        for g,w in common: gs.setdefault(g,[]).append(base[sid][(g,w)])
        gaps=sorted(gs,key=lambda gg:-max(gs[gg]))[:4]
        V=[];Cst=[]
        for g in gaps:
            words=[(w,base[sid][(g,w)]) for gg,w in common if gg==g]
            w=max(words,key=lambda z:z[1])[0]
            V.append([d[sid][(g,w)] for d in D])
            Cst.append(Levenshtein.distance(t["orig"]," ".join(toks[:g]+[w]+toks[g:])))
        out.append((np.array(V),np.array(Cst),Levenshtein.distance(t["orig"],lines[sid])))
    return out
def fuse(V,kind):
    if kind=='mean': f=V.mean(axis=1)
    elif kind=='zscore':
        mu=V.mean(axis=0); sd=V.std(axis=0)+1e-9
        f=((V-mu)/sd).mean(axis=1)
    elif kind=='rank':
        # rank within each member across candidates (higher score -> higher rank)
        R=np.zeros_like(V)
        for j in range(V.shape[1]):
            order=np.argsort(np.argsort(V[:,j]))
            R[:,j]=order/max(1,(V.shape[0]-1))
        f=R.mean(axis=1)
    elif kind=='median': f=np.median(V,axis=1)
    elif kind=='trim':
        f=(V.sum(axis=1)-V.min(axis=1)-V.max(axis=1))/(V.shape[1]-2)
    return f
def evalrole(data,kind,th):
