import json, math, pickle
from rapidfuzz.distance import Levenshtein
BASE="/download_job_code/payload/sandbox/workspaces/alkaid_pi"
truth={json.loads(l)["id"]:json.loads(l) for l in open(f"{BASE}/holdout/holdout_truth.jsonl")}
lines=[l.rstrip("\n") for l in open(f"{BASE}/holdout/holdout_test.txt") if l.strip()]
rr={}
for line in open("rerank_holdout_t1.jsonl"):
    d=json.loads(line); rr[d["id"]]=d["cands"]
mlm={}
for line in open("mlm_cands_holdout.jsonl"):
    d=json.loads(line); mlm[d["id"]]={g[0]:g[1] for g in d["gaps"]}
def recon(toks,gap,word): return " ".join(toks[:gap]+[word]+toks[gap:])
# attach mlm prob
for sid,cands in rr.items():
    for c in cands:
        gap,word=c[0],c[1]
        p=0.0
        if gap in mlm[sid]:
            for pp,ww in mlm[sid][gap]:
                if ww==word: p=pp;break
        c.append(p)  # c[4]=mlm prob
# oracle among candidates
def evaluate(scorefn, th):
    tot=0
    for sid,cands in rr.items():
        t=truth[sid]; toks=lines[sid].split()
        order=sorted(cands,key=scorefn,reverse=True)
        b=order[0]
        m=scorefn(b)-(scorefn(order[1]) if len(order)>1 else -1e9)
        if m<th: p=lines[sid]
        else: p=recon(toks,b[0],b[1])
        tot+=Levenshtein.distance(t["orig"],p)
    return tot/len(rr)
# λ sweep (score = mean + λ*log(p))
for lam in [0,0.02,0.05,0.1,0.2,0.5]:
    fn=lambda c,lam=lam: c[2]+lam*math.log(max(c[4],1e-9))
    best=(9,0)
    for th in [0,0.02,0.05,0.08,0.1,0.12,0.15,0.2]:
        v=evaluate(fn,th)
        if v<best[0]: best=(v,th)
    print(f"lam={lam}: best mean={best[0]:.4f} at th={best[1]}")
# oracle over candidate (gap,word) with correct
orac=0
for sid,cands in rr.items():
    t=truth[sid]; toks=lines[sid].split()
    # best possible among candidates + identity
    bestc=Levenshtein.distance(t["orig"],lines[sid])
    for c in cands:
        bestc=min(bestc,Levenshtein.distance(t["orig"],recon(toks,c[0],c[1])))
    orac+=bestc
print("oracle-over-cands mean",orac/len(rr))
