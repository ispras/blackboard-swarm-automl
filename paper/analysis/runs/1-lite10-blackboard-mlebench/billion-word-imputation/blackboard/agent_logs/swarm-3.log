"""Score a prediction file against the shared holdout.

Prediction file format (either is accepted):
  - CSV:  id,"sentence"          (same as submission.csv; "" escapes a quote)
  - TSV:  id<TAB>sentence

Usage: python score.py preds.csv [--verbose]
Prints mean character-level Levenshtein vs the hidden holdout originals.
"""
import sys, csv, json, io
from rapidfuzz.distance import Levenshtein

BASE = "/download_job_code/payload/sandbox/workspaces/alkaid_pi"
TRUTH = f"{BASE}/holdout/holdout_truth.jsonl"


def load_preds(path):
    preds = {}
    with open(path, encoding="utf-8", newline="") as f:
        first = f.readline()
    if "," in first and first.lstrip().lower().startswith(('id', '"id"')):
        with open(path, encoding="utf-8", newline="") as f:
            r = csv.reader(f, quotechar='"', doublequote=True)
            for row in r:
                if len(row) < 2:
                    continue
                if row[0].strip().lower() == "id":
                    continue
                preds[int(row[0])] = row[1]
    else:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip("\n")
                if not line:
                    continue
                a, b = line.split("\t", 1)
                if a.strip().lower() == "id":
                    continue
                preds[int(a)] = b
    return preds


def main():
    path = sys.argv[1]
    verbose = "--verbose" in sys.argv
    preds = load_preds(path)
    truth = [json.loads(l) for l in open(TRUTH, encoding="utf-8")]
    tot, n, miss = 0, 0, 0
    by_len = {}
    for t in truth:
        pid = t["id"]
        if pid not in preds:
            miss += 1
            continue
        d = Levenshtein.distance(t["orig"], preds[pid])
        tot += d
        n += 1
        by_len.setdefault(len(t["word"]), []).append(d)
    print(f"rows={n} missing={miss} mean_levenshtein={tot/n:.4f}")
    if verbose:
        for L in sorted(by_len):
            a = by_len[L]
            print(f"  true_word_len={L:2d}  n={len(a):5d}  mean={sum(a)/len(a):.3f}")


if __name__ == "__main__":
    main()
