import json
from rapidfuzz.distance import Levenshtein
BASE="/download_job_code/payload/sandbox/workspaces/alkaid_pi"
truth={json.loads(l)["id"]:json.loads(l) for l in open(f"{BASE}/holdout/holdout_truth.jsonl")}
lines=[l.rstrip("\n") for l in open(f"{BASE}/holdout/holdout_test.txt") if l.strip()]
def load(fn):
    d={}
    for line in open(fn):
        x=json.loads(line); d[x["id"]]={(c[0],c[1]):c[2] for c in x["cands"]}
    return d
xl=load("rerank_holdout_t1.jsonl"); q=load("/download_job_code/payload/sandbox/workspaces/castor_iota/rrk_qwen15_2000.jsonl"); sm=load("/download_job_code/payload/sandbox/workspaces/castor_iota/rrk_smol17_2000.jsonl"); gj=load("rm_gptj_1000.jsonl"); lg=load("rm_gpt2large_1000.jsonl")
def recon(toks,gap,word): return " ".join(toks[:gap]+[word]+toks[gap:])
def sim(K, models, weights, ths, basemodel):
    ids=[i for i in set(xl)&set(q)&set(sm)&set(gj)&set(lg) if i<998]
    best=(9,0)
    for th in ths:
        tot=0;gc=0;n=0
        for sid in ids:
            t=truth[sid]; toks=lines[sid].split();n+=1
            common=set(xl[sid])
            for m in models: common&=set(m[sid])
            gscore={}
            for g,w in common: gscore.setdefault(g,[]).append(basemodel[sid][(g,w)])
            gaps=sorted(gscore,key=lambda gg:-max(gscore[gg]))[:K]
            keep=set(gaps)
            sc=[(g,w,sum(wt*m[sid][(g,w)] for m,wt in zip(models,weights))) for g,w in common if g in keep]
            order=sorted(sc,key=lambda z:z[2],reverse=True); b=order[0]
            m2=b[2]-(order[1][2] if len(order)>1 else -1e9)
            if m2<th:p=lines[sid]
            else:
                p=recon(toks,b[0],b[1])
                if b[0]==t["gap"]:gc+=1
            tot+=Levenshtein.distance(t["orig"],p)
        v=tot/n
        if v<best[0]:best=(v,th,gc/n)
    return best
ths=[0,0.02,0.04,0.05,0.06,0.08,0.1,0.12,0.15]
