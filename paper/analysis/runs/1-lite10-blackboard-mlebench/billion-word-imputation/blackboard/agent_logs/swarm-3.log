"""Unified feature builder used for BOTH training and test inference.

Inputs per sentence:
  toks        : list[str] masked sentence tokens
  mlm_gaps    : list[[gap, [[p, word], ...], ...]]  (MLM top-k per interior gap)
  rerank_cands: list[[gap, word, mean_logp, total_logp], ...]  (one per gap; total may be 0)
  lm          : BigramLM
Returns list of dict rows (one per candidate word per gap).
"""
import math
import numpy as np
from rapidfuzz.distance import Levenshtein
from ngram_lm import BigramLM, N_TOK

PUNCT = set(".,;:!?\"'()-–—`%")
BETAS = [0.1, 0.2, 0.3, 0.5, 0.8, 1.2, 2.0, 3.0]
EC = [(0.3, 1.0), (0.3, 2.0), (0.5, 1.0), (0.5, 2.0), (0.5, 3.0),
      (0.8, 1.0), (0.8, 2.0), (0.8, 3.0), (1.2, 2.0), (1.2, 3.0)]
TOPK = 1

FEATURES = None  # filled after first build


def build_rows(sid, toks, mlm_gaps, rerank_cands, lm, topk=TOPK):
    n = len(toks)
    ids = lm.ids(toks)
    mlmg = {int(g): gl for g, gl in mlm_gaps}
    rc = [c for c in rerank_cands if 1 <= int(c[0]) < n]
    if not rc:
        return []
    gaps = [int(c[0]) for c in rc]
    mean = np.array([float(c[2]) for c in rc], dtype=float)
    total = np.array([float(c[3]) for c in rc], dtype=float)
    if np.all(total == 0.0):
        total = mean * (n + 1)  # fallback when only mean stored
    elif np.any(total == 0.0):
        total = np.where(total == 0.0, mean * (n + 1), total)
    rword = {int(c[0]): c[1] for c in rc}

    # per-gap word distributions
    wdist = {}
    lbars, masses, top1ps = [], [], []
    for g in gaps:
        gl = mlmg.get(g, [])
        if not gl:
            w = rword[g]
            gl = [[1.0, w]]
        gl = gl[:max(topk, 8)]
        ws = [w for p, w in gl]
        ps = np.array([p for p, w in gl], dtype=float)
        if ps.sum() <= 0:
            ps = np.ones_like(ps)
        pn = ps / ps.sum()
        wdist[g] = (ws, ps, pn, Levenshtein.distance)
        lbars.append(float(np.dot([len(w) for w in ws], pn)))
        masses.append(float(ps.sum()))
        top1ps.append(float(ps[0]))
    Lbar = float(np.mean(lbars)) if lbars else 4.5

    order = np.argsort(-total)
    rank = {gaps[j]: r for r, j in enumerate(order)}
    rmass = {gaps[j]: r for r, j in enumerate(np.argsort(-np.array(masses)))}
    rtop1 = {gaps[j]: r for r, j in enumerate(np.argsort(-np.array(top1ps)))}
    pmax = total.max()
    pmean = total.mean()

    pvals = {}
    for beta in BETAS:
        z = beta * total; z -= z.max(); p = np.exp(z); p /= p.sum()
        for j, g in enumerate(gaps):
            pvals.setdefault(g, {})[beta] = float(p[j])
    z = 1.0 * total; z -= z.max(); p1 = np.exp(z); p1 /= p1.sum()
    pg_ent = float(-(p1 * np.log(p1 + 1e-12)).sum())
    pg_max = float(p1.max()); pg_top2 = float(np.sort(p1)[-2:].sum())

    rows = []
    for g in gaps:
        l, rr = ids[g - 1], ids[g]
        clr = lm.c_succ(l, rr); lp_rl = lm.logP_r_given_l(l, rr)
        ws, ps, pn, _ = wdist[g]
        kk = min(len(ws), 8)
        wtop = ws[:kk]; ptop = pn[:kk]
        top1_word = wtop[0]
        cand_words = list(wtop[:topk])
        if rword[g] not in cand_words:
            cand_words.append(rword[g])
        for w in cand_words:
            a = wtop.index(w) if w in wtop else -1
            pw = float(ptop[a]) if a >= 0 else 0.0
            dists = np.array([Levenshtein.distance(w, v) for v in wtop])
            exp_dist_j = float(np.dot(dists, ptop))
            minlev = float(np.min(np.delete(dists, a))) if a >= 0 and kk > 1 else (float(np.min(dists)) if kk > 0 else 0.0)
            levtop = float(dists[0]) if kk > 0 else 0.0
            wi = lm.w2i.get(w, -1)
            clw = lm.c_succ(l, wi); cwr = lm.c_pred(rr, wi)
            lp_wl = lm.logP_w_given_l(l, wi); lp_rw = lm.logP_r_given_w(rr, wi)
            gain = lp_wl + lp_rw - lp_rl
            ulogp = math.log((lm.u(wi) + 0.5) / N_TOK) if wi >= 0 else -20.0
            explev = exp_dist_j
            d = dict(
                id=sid, g=g, w=w, n=n,
                gpt2=float(total[gaps.index(g)]),
                gpt2_pertok=float(total[gaps.index(g)] / (n + 1)),
                gpt2_margin=float(total[gaps.index(g)] - pmax),
                gpt2_rank=rank[g], gpt2_z=float(total[gaps.index(g)] - pmean),
                mlm_p=pw, mlm_rank=a, gap_top1p=float(ptop[0]),
                gap_mass=float(ps.sum()), gap_ent=float(-(ptop * np.log(ptop + 1e-12)).sum()),
                is_top1=int(w == top1_word),
                exp_lev=explev, min_lev_to_other=minlev, lev_to_top1=levtop,
                c_lw=clw, c_wr=cwr, c_lr=clr,
                lp_wl=lp_wl, lp_rw=lp_rw, lp_rl=lp_rl, gain=gain,
                has_lw=int(clw > 0), has_wr=int(cwr > 0), has_both=int(clw > 0 and cwr > 0),
                ulogp=ulogp, wlen=len(w), llen=len(toks[g - 1]), rlen=len(toks[g]),
                is_punct=int(w in PUNCT), gap_frac=g / n,
                Lbar=Lbar, ngaps=len(gaps), gap_rank=rank[g], mass_rank=rmass[g],
                top1_rank=rtop1[g], pg_ent=pg_ent, pg_max=pg_max, pg_top2=pg_top2,
            )
            for beta in BETAS:
                d[f"pg{beta}"] = pvals[g][beta]
            for beta, C in EC:
                d[f"ec_{beta}_{C}"] = pvals[g][beta] * explev + (1 - pvals[g][beta]) * (len(w) + Lbar + C)
            rows.append(d)
    return rows


ALL_FEATURES = None


def get_feature_names(df):
    global ALL_FEATURES
    drop = {"id", "g", "w", "tg", "y_gap", "cost", "Lbar", "wlen"}
    # keep Lbar; drop only labels/ids
    drop = {"id", "g", "w", "tg", "y_gap", "cost"}
    ALL_FEATURES = [c for c in df.columns if c not in drop]
    return ALL_FEATURES
