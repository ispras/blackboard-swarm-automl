            gaps=sorted({g for g,w in common}, key=lambda gg:-max(xl[sid][(gg,w)] for w in [ww for g2,ww in common if g2==gg]))
            keepg=set(gaps[:K]) if restrict_base else set(gaps)
            sc=[(g,w,sum(wt*m[sid][(g,w)] for m,wt in zip(models,weights))) for g,w in common if g in keepg]
            order=sorted(sc,key=lambda z:z[2],reverse=True); b=order[0]
            m2=b[2]-(order[1][2] if len(order)>1 else -1e9)
            if m2<th:p=lines[sid]
            else:
                p=recon(toks,b[0],b[1])
                if b[0]==t["gap"]:gc+=1
            tot+=Levenshtein.distance(t["orig"],p)
        v=tot/n
        if v<best[0]:best=(v,th,gc/n,n)
    return best
