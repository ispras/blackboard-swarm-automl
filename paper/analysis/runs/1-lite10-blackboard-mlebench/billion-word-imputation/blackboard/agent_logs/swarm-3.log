import json
from rapidfuzz.distance import Levenshtein
BASE="/download_job_code/payload/sandbox/workspaces/alkaid_pi"; C="/download_job_code/payload/sandbox/workspaces/castor_iota"
truth={json.loads(l)["id"]:json.loads(l) for l in open(f"{BASE}/holdout/holdout_truth.jsonl")}
lines=[l.rstrip("\n") for l in open(f"{BASE}/holdout/holdout_test.txt") if l.strip()]
def load(fn):
    d={}
    for line in open(fn):
        x=json.loads(line); d[x["id"]]={(c[0],c[1]):c[2] for c in x["cands"]}
    return d
ft=load("rm_ftmedium_holdout.jsonl"); base=load(f"{C}/rrk_large_2000.jsonl"); xl=load("rerank_holdout_t1.jsonl"); q=load(f"{C}/rrk_qwen15_2000.jsonl"); sm=load(f"{C}/rrk_smol17_2000.jsonl")
def recon(toks,gap,word): return " ".join(toks[:gap]+[word]+toks[gap:])
def ev(dicts,weights,ths,K=4,ids=None):
    if ids is None: ids=[i for i in sorted(set(dicts[0])) if all(i in d for d in dicts)]
    best=(9,0)
    for th in ths:
        tot=0;gc=0;n=0
        for sid in ids:
            toks=lines[sid].split();t=truth[sid];n+=1
            common=set(dicts[0][sid])
            for d in dicts[1:]: common&=set(d[sid])
            gs={}
            for g,w in common: gs.setdefault(g,[]).append(dicts[0][sid][(g,w)])
            gaps=sorted(gs,key=lambda gg:-max(gs[gg]))[:K];keep=set(gaps)
            cs=[(g,w,sum(wt*d[sid][(g,w)] for d,wt in zip(dicts,weights))) for g,w in common if g in keep]
            cs=sorted(cs,key=lambda z:z[2],reverse=True);b=cs[0]
            m=b[2]-(cs[1][2] if len(cs)>1 else -1e9)
            if m<th:p=lines[sid]
            else:
                p=recon(toks,b[0],b[1])
                if b[0]==t["gap"]:gc+=1
            tot+=Levenshtein.distance(t["orig"],p)
        v=tot/n
        if v<best[0]:best=(v,th,gc/n,n)
    return best
