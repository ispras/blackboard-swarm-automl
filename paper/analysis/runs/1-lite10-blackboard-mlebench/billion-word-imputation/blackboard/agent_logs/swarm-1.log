"""Cost-aware decoder: MLM candidates + causal-LM gap scores -> submission.

Usage (test):
  python decode.py --mlm-glob 'mlm_test_parts/part_*.jsonl' \
                   --rerank-dir rerank_test_parts \
                   --out submission.csv \
                   [--retrieval retrieval_recovered.tsv] [--start 0 --end N]

Rerank files must share the MLM part basenames (castor_iota's rerank_test.py does).
Any id without MLM+rerank output is written as identity (masked sentence), so the
output is always a valid full-length submission.
"""
import argparse, csv, glob, json, os, sys
import numpy as np
import pandas as pd
import lightgbm as lgb
from ngram_lm import BigramLM
from featlib import build_rows

BASE = "/download_job_code/payload/sandbox/workspaces/alkaid_pi"


def load_sentences(path, plain=False):
    out = {}
    if plain:
        with open(path, encoding="utf-8") as f:
            for i, line in enumerate(f):
                out[i] = line.rstrip("\n")
        return out
    with open(path, encoding="utf-8", newline="") as f:
        r = csv.reader(f, quotechar='"', doublequote=True)
        next(r)
        for row in r:
            if len(row) >= 2:
                out[int(row[0])] = row[1]
    return out


def open_jsonl(path):
    if path.endswith(".gz"):
        import gzip
        return gzip.open(path, "rt", encoding="utf-8")
    return open(path, encoding="utf-8")


def load_records(path):
    d = {}
    with open_jsonl(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            o = json.loads(line)
            d[o["id"]] = o
    return d


def insert(toks, g, w):
    return " ".join(toks[:g] + [w] + toks[g:])


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mlm-glob", required=True)
    ap.add_argument("--rerank-dir", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--sentences", default="/download_job_code/payload/sandbox/data/test_v2.txt")
    ap.add_argument("--plain", action="store_true")
    ap.add_argument("--retrieval", default="")
    ap.add_argument("--model", default=f"{BASE}/decoder_model.txt")
    ap.add_argument("--meta", default=f"{BASE}/decoder_meta.json")
    ap.add_argument("--tau", type=float, default=None)
    ap.add_argument("--margin-fallback", type=float, default=None,
                    help="if set, ignore model and use mean-logp + margin rule")
    ap.add_argument("--start", type=int, default=0)
    ap.add_argument("--end", type=int, default=10**9)
    ap.add_argument("--limit", type=int, default=0)
    args = ap.parse_args()

    meta = json.load(open(args.meta))
    feats = meta["features"]
    tau = args.tau if args.tau is not None else meta["tau"]
    booster = lgb.Booster(model_file=args.model)
    lm = BigramLM()

    sents = load_sentences(args.sentences, plain=args.plain)
    retrieval = {}
    if args.retrieval:
        with open(args.retrieval, encoding="utf-8") as f:
            rd = csv.reader(f, delimiter="\t")
            hdr = next(rd)
            for row in rd:
                retrieval[int(row[0])] = (int(row[1]), row[2])

    parts = sorted(glob.glob(args.mlm_glob))
    written = set()
    n_done = 0
    fout = open(args.out, "w", encoding="utf-8", newline="")
    fout.write('id,"sentence"\n')

    def emit(i, toks, g=None, w=None):
        if i in retrieval:
            g, w = retrieval[i]
        if g is not None and w is not None:
            s = insert(toks, int(g), w)
        else:
            s = " ".join(toks)
        fout.write(str(i) + ',"' + s.replace('"', '""') + '"\n')
        written.add(i)

    for pi, mp in enumerate(parts):
        base = os.path.basename(mp)
        if base.endswith(".gz"):
            base = base[:-3]
        rp = os.path.join(args.rerank_dir, base)
        if not os.path.exists(rp):
            rp2 = rp + ".gz"
            rp = rp2 if os.path.exists(rp2) else None
        mrec = load_records(mp)
        ids = sorted(mrec)
