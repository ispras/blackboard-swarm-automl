import argparse, json, time
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

ap=argparse.ArgumentParser()
ap.add_argument("--model",default="gpt2-xl")
ap.add_argument("--mlm",default="mlm_cands_holdout.jsonl")
ap.add_argument("--input",default="/download_job_code/payload/sandbox/workspaces/alkaid_pi/holdout/holdout_test.txt")
ap.add_argument("--out",default="rerank_multi.jsonl")
ap.add_argument("--topw",type=int,default=1)
ap.add_argument("--nsent",type=int,default=2000)
ap.add_argument("--batch",type=int,default=128)
ap.add_argument("--rev",action="store_true")
args=ap.parse_args()

BASE="/download_job_code/payload/sandbox/workspaces/alkaid_pi"
lines=[l.rstrip("\n") for l in open(args.input,encoding="utf-8") if l.strip()]
mlm={}
for line in open(args.mlm,encoding="utf-8"):
    d=json.loads(line); mlm[d["id"]]=d["gaps"]

t0=time.time()
tok=AutoTokenizer.from_pretrained(args.model)
tok.pad_token=tok.eos_token
model=AutoModelForCausalLM.from_pretrained(args.model,torch_dtype=torch.float16).cuda().eval()
print("loaded",round(time.time()-t0,1),flush=True)

def score_texts(texts):
    enc=[]
    for i,text in enumerate(texts):
        ids=tok(text,add_special_tokens=False,truncation=True,max_length=200)["input_ids"]
        enc.append((len(ids),i,ids))
    enc.sort(key=lambda x:x[0])
    out_score=[0.0]*len(texts)
    B=args.batch
    with torch.no_grad():
        for st in range(0,len(enc),B):
            chunk=enc[st:st+B]
            maxlen=max(x[0] for x in chunk)
            ids=torch.full((len(chunk),maxlen),tok.eos_token_id,dtype=torch.long)
            attn=torch.zeros((len(chunk),maxlen),dtype=torch.long)
            for r,(L,i,x) in enumerate(chunk):
                ids[r,:L]=torch.tensor(x); attn[r,:L]=1
            ids=ids.cuda();attn=attn.cuda()
            with torch.autocast(device_type="cuda",dtype=torch.float16):
                logits=model(ids,attention_mask=attn).logits.float()
            lp=torch.log_softmax(logits,dim=-1)
            for r,(L,i,x) in enumerate(chunk):
                s=0.0
                for pos in range(1,L): s+=float(lp[r,pos-1,x[pos]])
                out_score[i]=s/max(1,L-1)
    return out_score

res={}
sids=[sid for sid in sorted(mlm) if sid < args.nsent]
for ci,sid in enumerate(sids):
    toks=lines[sid].split()
    cands=[]
    for gap,cw in mlm[sid]:
        for _,w in cw[:args.topw]:
            if w: cands.append((gap,w))
    texts=[" ".join(toks[:g]+[w]+toks[g:]) for g,w in cands]
    fwd=score_texts(texts)
    if args.rev:
        rtexts=[" ".join(text.split()[::-1]) for text in texts]
        rev=score_texts(rtexts)
    else:
        rev=[0.0]*len(texts)
    res[sid]=[[g,w,f,r] for (g,w),f,r in zip(cands,fwd,rev)]
    if ci%200==0: print("prog",ci,"/",len(sids),flush=True)

with open(args.out,"w") as f:
    for sid in sids: f.write(json.dumps({"id":sid,"cands":res[sid]})+"\n")
print("done",round(time.time()-t0,1),flush=True)
