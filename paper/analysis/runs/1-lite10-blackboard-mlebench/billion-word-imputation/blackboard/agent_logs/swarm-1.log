def run(ids,models,K):
    def choose(sid):
        cs=sorted([(c[2],g) for g,c in lg[sid].items()],reverse=True)[:K]
        merged=[]
        for _,g in cs:
            vals=[lg[sid][g][2]]
            ok=True
            for mm in models[1:]:
                if sid in mm and g in mm[sid]: vals.append(mm[sid][g][2])
                else: ok=False
            if ok: merged.append((sum(vals)/len(vals),g))
        merged.sort(reverse=True)
        return merged[0][1], (merged[0][0]-merged[1][0] if len(merged)>1 else 1)
