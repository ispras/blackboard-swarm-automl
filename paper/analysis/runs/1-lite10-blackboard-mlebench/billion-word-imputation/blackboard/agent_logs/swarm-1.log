ids = sorted(mrec)
        if not ids:
            continue
        if rp is None:
            rrec = {}
        else:
            rrec = load_records(rp)
        for i in ids:
            if i < args.start or i >= args.end:
                continue
            toks = sents.get(i, "").split()
            if i in retrieval or i not in rrec or len(toks) < 3:
                emit(i, toks)
                continue
            gaps = mrec[i]["gaps"]
            cands = rrec[i]["cands"]
            # dedupe gaps: keep max total logp per gap
            best_gap = {}
            for c in cands:
                g = int(c[0])
                t = float(c[3]) if len(c) > 3 else 0.0
                if g not in best_gap or t > float(best_gap[g][3] if len(best_gap[g]) > 3 else 0.0):
                    best_gap[g] = c
            cands = list(best_gap.values())
            if args.margin_fallback is not None:
                # robust rule: max mean logp gap, fallback on margin
                if not cands:
                    emit(i, toks); continue
                cs = sorted(cands, key=lambda c: -float(c[2]))
                margin = float(cs[0][2]) - (float(cs[1][2]) if len(cs) > 1 else float(cs[0][2]))
                if margin < args.margin_fallback:
                    emit(i, toks)
                else:
                    emit(i, toks, int(cs[0][0]), cs[0][1])
                n_done += 1
                continue
            rows = build_rows(i, toks, gaps, cands, lm, topk=1)
            if not rows:
                emit(i, toks); continue
            d = pd.DataFrame(rows)
            pc = booster.predict(d[feats])
            j = int(np.argmin(pc))
            if float(pc[j]) > tau:
                emit(i, toks)
            else:
                emit(i, toks, int(d.iloc[j]["g"]), d.iloc[j]["w"])
            n_done += 1
        # flush
        fout.flush()
        if args.limit and len(written) >= args.limit:
            break

    # identity for any uncovered ids
    for i in sorted(sents):
        if i not in written and args.start <= i < args.end:
            emit(i, sents[i].split())
    fout.close()
    print(f"done ids={len(written)} decoded={n_done} out={args.out}")


if __name__ == "__main__":
    main()
