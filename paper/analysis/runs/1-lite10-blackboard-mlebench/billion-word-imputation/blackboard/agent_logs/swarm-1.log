# cascade: top3 by large, choose by avg raw mean
def casc_avg(sid):
    top3=sorted([(c[2],g) for g,c in lg[sid].items()],reverse=True)[:3]
    best=max(top3,key=lambda x: 0.5*lg[sid][x[1]][2]+0.5*xl[sid][x[1]][2])
    vals=sorted([0.5*lg[sid][g][2]+0.5*xl[sid][g][2] for _,g in top3],reverse=True)
    return best[1],(vals[0]-vals[1] if len(vals)>1 else 1)
print("casc large-top3 -> avg noFB",ev(casc_avg),"bestFB",bfb(casc_avg))
# cascade top5 by large choose avg
def casc_avg5(sid):
    top=[(c[2],g) for g,c in lg[sid].items()]
    top=sorted(top,reverse=True)[:5]
    best=max(top,key=lambda x: 0.5*lg[sid][x[1]][2]+0.5*xl[sid][x[1]][2])
    vals=sorted([0.5*lg[sid][g][2]+0.5*xl[sid][g][2] for _,g in top],reverse=True)
    return best[1],(vals[0]-vals[1] if len(vals)>1 else 1)
print("casc large-top5 -> avg noFB",ev(casc_avg5),"bestFB",bfb(casc_avg5))
# large-top3 -> avg + gptj top3
def casc_avg_gj(sid):
    top=sorted([(c[2],g) for g,c in lg[sid].items()],reverse=True)[:3]
    best=max(top,key=lambda x: (lg[sid][x[1]][2]+xl[sid][x[1]][2]+gj[sid][x[1]][2])/3)
    vals=sorted([(lg[sid][g][2]+xl[sid][g][2]+gj[sid][g][2])/3 for _,g in top],reverse=True)
    return best[1],(vals[0]-vals[1] if len(vals)>1 else 1)
print("casc large-top3 -> avg(xl,gj) noFB",ev(casc_avg_gj),"bestFB",bfb(casc_avg_gj))
