        m=cands[0][0]-cands[1][0] if len(cands)>1 else 1
        if m>=tau:
            _,g,wd=cands[0]; pred=" ".join(toks[:g]+[wd]+toks[g:])
        else: pred=" ".join(toks)
        ds.append(Levenshtein.distance(pred,orig))
    return ds
# equal baseline OOF (no tuning: equal/tau .06)
base=cost_for(0.06,(1,1,1,1,1,1))
print("equal tau .06 ALL mean",statistics.mean(base))
# random/coarse search with 5-fold CV
rng=random.Random(0)
N=len(data); fold=[rng.randrange(5) for _ in range(N)]
configs=[(1,)+w for w in itertools.product([0,1,2],repeat=5)]
configs=[c for c in configs if sum(c)>0]
print("configs",len(configs))
best=None
for w in configs:
    ds=[None]*N
    for tau in taus:
        c=cost_for(tau,w)
        # evaluate per-fold using this global tau; approximate (tau not tuned per fold)
        pass
# simpler: choose best (w,tau) on ALL, then report; risk overfit but we check vs equal
best=(9,None,None)
for w in configs:
    for tau in taus:
        c=cost_for(tau,w); mm=statistics.mean(c)
        if mm<best[0]: best=(mm,w,tau,c)
print("best on ALL",best[0],"w",best[1],"tau",best[2])
# 5-fold honest: tune (w,tau) on train folds, eval val
oof=[None]*N
for f in range(5):
    val=[i for i in range(N) if fold[i]==f]
    tr=[i for i in range(N) if fold[i]!=f]
    def part_cost(rows_idx,tau,w):
        # compute on subset
        sw=sum(w); ds=[]
        for i in rows_idx:
            sid,toks,tg,tw,orig,gaps=data[i]
            cands=sorted(((sum(wi*si for wi,si in zip(w,sc))/sw,g,wd) for g,wd,sc in gaps),reverse=True)
            m=cands[0][0]-cands[1][0] if len(cands)>1 else 1
            if m>=tau:
                _,g,wd=cands[0]; pred=" ".join(toks[:g]+[wd]+toks[g:])
            else: pred=" ".join(toks)
            ds.append(Levenshtein.distance(pred,orig))
        return ds
    bf=(9,None,None)
    for w in configs:
        for tau in taus:
            mm=statistics.mean(part_cost(tr,tau,w))
            if mm<bf[0]: bf=(mm,w,tau)
    w=bf[1]; tau=bf[2]
    # assign val costs
    sw=sum(w)
    for i in val:
        sid,toks,tg,tw,orig,gaps=data[i]
        cands=sorted(((sum(wi*si for wi,si in zip(w,sc))/sw,g,wd) for g,wd,sc in gaps),reverse=True)
        m=cands[0][0]-cands[1][0] if len(cands)>1 else 1
        if m>=tau:
            _,g,wd=cands[0]; pred=" ".join(toks[:g]+[wd]+toks[g:])
        else: pred=" ".join(toks)
        oof[i]=Levenshtein.distance(pred,orig)
    print("fold",f,"chose",w,tau,"train",round(bf[0],4))
print("OOF weighted",statistics.mean(oof))
print("OOF equal tau.06",statistics.mean(base))
EOF
