def metric(rows, w, tau):
    ds=[]
    for d in rows:
        t=truth[d["id"]]; toks=t["sentence"].split()
        cands=[]
        for c in d["cands"]:
            s=sum(w[i]*c[4+i] for i in range(4))/sum(w)
            cands.append((s,c[0],c[1]))
        cands.sort(reverse=True)
        marg=cands[0][0]-cands[1][0] if len(cands)>1 else 1
        if marg>=tau:
            _,g,word=cands[0]; pred=" ".join(toks[:g]+[word]+toks[g:])
        else: pred=t["sentence"]
        ds.append(Levenshtein.distance(pred,t["orig"]))
    return statistics.mean(ds)
