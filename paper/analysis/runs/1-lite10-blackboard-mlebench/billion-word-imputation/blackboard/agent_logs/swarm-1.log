import json, statistics, itertools
from rapidfuzz.distance import Levenshtein
B="/download_job_code/payload/sandbox/workspaces"
truth={}
for l in open(f"{B}/alkaid_pi/holdout/holdout_truth.jsonl"):
    d=json.loads(l); truth[d["id"]]=d
def load(p):
    rr={}
    for l in open(p):
        d=json.loads(l); rr[d["id"]]={c[0]:c for c in d["cands"]}
    return rr
M={"xl":load(f"{B}/achernar_tau/rerank_holdout_t1.jsonl"),
   "large":load(f"{B}/achernar_tau/rm_gpt2large_1000.jsonl"),
   "gptj":load(f"{B}/achernar_tau/rm_gptj_1000.jsonl"),
   "neo":load(f"{B}/achernar_tau/rm_neo27_1000.jsonl")}
ids=sorted(set.intersection(*[set(M[k]) for k in M]))
print("common",len(ids))
def zfun(m):
    cache={}
    def f(sid,g):
        if sid not in cache:
            vals=[c[2] for c in M[m][sid].values()]; mu=statistics.mean(vals); sd=statistics.pstdev(vals) or 1; cache[sid]=(mu,sd)
        mu,sd=cache[sid]; return (M[m][sid][g][2]-mu)/sd
    return f
Z={m:zfun(m) for m in M}
def ev(getscore,thr=None):
    ds=[];ga=0;wa=0
    for sid in ids:
        t=truth[sid]; toks=t["sentence"].split()
        sc=sorted([(getscore(sid,g),g) for g in M["xl"][sid]],reverse=True)
        use=True
        if thr is not None: use=(sc[0][0]-sc[1][0])>=thr if len(sc)>1 else True
        if use:
            _,g=sc[0]; w=M["xl"][sid][g][1]; pred=" ".join(toks[:g]+[w]+toks[g:])
            if g==t["gap"]:ga+=1
            if g==t["gap"] and w==t["word"]:wa+=1
        else: pred=t["sentence"]
        ds.append(Levenshtein.distance(pred,t["orig"]))
    return statistics.mean(ds),ga/len(ids),wa/len(ids)
def bfb(getscore):
    return min((ev(getscore,t) for t in [0,0.05,0.1,0.15,0.2,0.25,0.3,0.4,0.5]),key=lambda x:x[0])
for combo,ws in [ (("xl","large"),(0.5,0.5)),(("xl","large"),(0.3,0.7)),(("xl","large","gptj"),(1/3,1/3,1/3)),(("xl","large","gptj"),(0.2,0.4,0.4)),(("xl","large","gptj","neo"),(0.25,)*4)]:
    def f(sid,g,combo=combo,ws=ws): return sum(w*Z[m](sid,g) for m,w in zip(combo,ws))
    print(combo,ws,"noFB",ev(f),"bestFB",bfb(f))
