import argparse, json, time
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

ap = argparse.ArgumentParser()
ap.add_argument("--model", default="gpt2-xl")
ap.add_argument("--input", default="/download_job_code/payload/sandbox/workspaces/alkaid_pi/holdout/holdout_test.txt")
ap.add_argument("--out", default="causal_loc_holdout.jsonl")
ap.add_argument("--n", type=int, default=100000)
ap.add_argument("--batch", type=int, default=48)
ap.add_argument("--maxlen", type=int, default=200)
args = ap.parse_args()

t0=time.time()
tok=AutoTokenizer.from_pretrained(args.model, add_prefix_space=True)
tok.pad_token=tok.eos_token
model=AutoModelForCausalLM.from_pretrained(args.model, torch_dtype=torch.float16).cuda().eval()
print("loaded",args.model, round(time.time()-t0,1),flush=True)

lines=[]
for line in open(args.input,encoding="utf-8"):
    s=line.rstrip("\n")
    if s.strip(): lines.append(s)
    if len(lines)>=args.n: break
print("sentences",len(lines),flush=True)

encs=[]
for sid,s in enumerate(lines):
    e=tok(s, return_tensors="pt", add_special_tokens=False, truncation=True, max_length=args.maxlen-1)
    ids=e["input_ids"][0].tolist()
    wids=tok(s, add_special_tokens=False, truncation=True, max_length=args.maxlen-1, return_offsets_mapping=False).word_ids() if False else None
    # map word index -> token positions via is_split_into_words
    toks=s.split()
    e2=tok(toks, is_split_into_words=True, add_special_tokens=False, truncation=True, max_length=args.maxlen-1)
    ids2=e2["input_ids"]
    word_ids=e2.word_ids()
    # span of each word in token ids
    spans={}
    for pos,wi in enumerate(word_ids):
        if wi is None: continue
        spans.setdefault(wi,[pos,pos])
        spans[wi][1]=pos
    encs.append((len(ids2),sid,ids2,spans))

encs.sort(key=lambda x:x[0])
res={}
B=args.batch
t1=time.time()
with torch.no_grad():
    for st in range(0,len(encs),B):
        chunk=encs[st:st+B]
        maxlen=max(x[0] for x in chunk)
        ids=torch.full((len(chunk),maxlen),tok.eos_token_id,dtype=torch.long)
        attn=torch.zeros((len(chunk),maxlen),dtype=torch.long)
        for r,(L,sid,x,sp) in enumerate(chunk):
            ids[r,:L]=torch.tensor(x); attn[r,:L]=1
        ids=ids.cuda(); attn=attn.cuda()
        with torch.autocast(device_type="cuda",dtype=torch.float16):
            out=model(ids, attention_mask=attn).logits.float()
        logp=torch.log_softmax(out,dim=-1)
