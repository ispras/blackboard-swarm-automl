import json, statistics
from rapidfuzz.distance import Levenshtein
B="/download_job_code/payload/sandbox/workspaces"
truth={}
for l in open(f"{B}/alkaid_pi/holdout/holdout_truth.jsonl"):
    d=json.loads(l)
    if d["id"]<2000: truth[d["id"]]=d
# topw=5 file
rr={}
for l in open(f"{B}/achernar_tau/rm_t5_fwd_2000.jsonl"):
    d=json.loads(l); rr[d["id"]]=d["cands"]
print("ids",len(rr),"cands/sent",statistics.mean(len(v) for v in rr.values()))

def ev(sel,thr=None,name=""):
    ds=[];ga=0;wa=0
    for sid,cands in rr.items():
        t=truth[sid]; orig=t["orig"]; toks=t["sentence"].split()
        # group by gap, keep best word per gap by fwd score
        best_by_gap={}
        for c in cands:
            g=c[0]; f=c[2]
            if g not in best_by_gap or f>best_by_gap[g][2]: best_by_gap[g]=c
        gaps=sorted(best_by_gap.values(),key=lambda c:c[2],reverse=True)
        use=True
        if thr is not None:
            m=gaps[0][2]-gaps[1][2] if len(gaps)>1 else 1.0
            use=m>=thr
        if use:
            c=gaps[0]; g,w=c[0],c[1]
            pred=" ".join(toks[:g]+[w]+toks[g:])
            if g==t["gap"]:ga+=1
            if g==t["gap"] and w==t["word"]:wa+=1
        else: pred=t["sentence"]
        ds.append(Levenshtein.distance(pred,orig))
    return statistics.mean(ds),ga/len(rr),wa/len(rr)
print("topw5, best word/gap by fwd, noFB",ev(None,None))
for thr in [0.04,0.06,0.08,0.10,0.12,0.15]:
    print("  thr",thr,ev(None,thr))
# also allow choosing any of top-5 words at best gap (max fwd) = same as above.
# oracle over all topw5 candidates: use true gap+word if present
hit=0
for sid,cands in rr.items():
    t=truth[sid]
    if any(c[0]==t["gap"] and c[1]==t["word"] for c in cands): hit+=1
print("true(gap,word) present in topw5 cands:",hit/len(rr))
EOF
