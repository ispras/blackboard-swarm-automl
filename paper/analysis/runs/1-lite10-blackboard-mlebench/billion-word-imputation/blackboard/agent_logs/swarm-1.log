import csv,random,statistics
from rapidfuzz.distance import Levenshtein
rows=list(csv.DictReader(open('holdout_20k.tsv'),delimiter='\t'))
rng=random.Random(3)
def C(sub,orig): return Levenshtein.distance(sub,orig)
for w in ['to','a','the','']:
    wc=[]
    for d in rows:
        toks=d['masked'].split(); p=int(d['pos']); n=len(toks)+1
        cands=[g for g in range(1,n-1) if g!=p]
        if not cands: continue
        g=rng.choice(cands)
        toks2=toks[:g]+([w] if w else [])+toks[g:]
        wc.append(C(' '.join(toks2),d['original']))
    print("wrong-gap insert",repr(w),"mean",round(statistics.mean(wc),3))
# break-even for accuracy a using right-gap cost r and wrong-gap cost W vs identity I
I=statistics.mean(C(d['masked'],d['original']) for d in rows)
print("identity",round(I,3))
# oracle gap fixed to: cost at right gap
for w in ['to','a','the']:
    rc=[]
    for d in rows:
        toks=d['masked'].split(); p=int(d['pos'])
        rc.append(C(' '.join(toks[:p]+[w]+toks[p:]),d['original']))
    W=[]
    for d in rows:
        toks=d['masked'].split(); p=int(d['pos']); n=len(toks)+1
        cands=[g for g in range(1,n-1) if g!=p]
        g=rng.choice(cands); W.append(C(' '.join(toks[:g]+[w]+toks[g:]),d['original']))
    r=statistics.mean(rc); ww=statistics.mean(W)
    a=(ww-I)/(ww-r)
    print(f"word {w!r}: rightgap={r:.3f} wronggap={ww:.3f} breakeven_gap_acc={a:.3f}")
