import json, statistics
from rapidfuzz.distance import Levenshtein
B="/download_job_code/payload/sandbox/workspaces"
truth={}
for l in open(f"{B}/alkaid_pi/holdout/holdout_truth.jsonl"):
    d=json.loads(l); truth[d["id"]]=d
def load(p):
    rr={}
    for l in open(p):
        d=json.loads(l); rr[d["id"]]={c[0]:c for c in d["cands"]}
    return rr
g=load(f"{B}/achernar_tau/rm_gptj_1000.jsonl")
x=load(f"{B}/achernar_tau/rerank_holdout_t1.jsonl")
ids=sorted(set(g)&set(x))
def ev(fn):
    ds=[];ga=0;wa=0
    for sid in ids:
        cand=fn(sid)
        t=truth[sid]; toks=t["sentence"].split()
        if cand is None: pred=t["sentence"]
        else:
            gg,w=cand
            pred=" ".join(toks[:gg]+[w]+toks[gg:])
            if gg==t["gap"]:ga+=1
            if gg==t["gap"] and w==t["word"]:wa+=1
        ds.append(Levenshtein.distance(pred,t["orig"]))
    return statistics.mean(ds),ga/len(ids),wa/len(ids)
def top3(sid):
    xs=x[sid]
    return sorted(xs.items(), key=lambda kv: kv[1][2], reverse=True)[:3]
def sel_gptj_top3(sid):
    t3=top3(sid)
    best=max(t3,key=lambda kv: g[sid][kv[0]][2] if kv[0] in g[sid] else -1e9)
    return (best[0],best[1][1])
def sel_combo(sid):
    t3=top3(sid)
    # z-normalize both scores within the top3 (or full)
    xs=x[sid]; gs={k:g[sid][k][2] for k in g[sid]}
    allx=[c[2] for c in xs.values()]; allg=[gs[k] for k in gs]
    mx,sx=statistics.mean(allx),statistics.pstdev(allx)
    mg,sg=statistics.mean(allg),statistics.pstdev(allg)
    def zx(k): return (xs[k][2]-mx)/(sx or 1)
    def zg(k): return (gs[k]-mg)/(sg or 1)
    best=max(t3,key=lambda kv: 0.5*zx(kv[0])+0.5*zg(kv[0]))
    return (best[0],best[1][1])
print("gpt2-xl only",ev(lambda sid:(max(x[sid].items(),key=lambda kv:kv[1][2])[0],max(x[sid].items(),key=lambda kv:kv[1][2])[1][1])))
print("gptj only",ev(lambda sid:(max(g[sid].items(),key=lambda kv:kv[1][2])[0],max(g[sid].items(),key=lambda kv:kv[1][2])[1][1])))
print("cascade gpt2-xl top3 -> gptj",ev(sel_gptj_top3))
print("combo z 50/50",ev(sel_combo))
for a in [0.2,0.3,0.4,0.6,0.7,0.8]:
    def sc(sid,a=a):
        t3=top3(sid); xs=x[sid]; gs={k:g[sid][k][2] for k in g[sid]}
        allx=[c[2] for c in xs.values()]; allg=[gs[k] for k in gs]
        mx,sx=statistics.mean(allx),statistics.pstdev(allx); mg,sg=statistics.mean(allg),statistics.pstdev(allg)
        best=max(t3,key=lambda kv: a*(xs[kv[0]][2]-mx)/(sx or 1)+(1-a)*(gs[kv[0]]-mg)/(sg or 1))
        return (best[0],best[1][1])
    print("combo a=",a,ev(sc))
