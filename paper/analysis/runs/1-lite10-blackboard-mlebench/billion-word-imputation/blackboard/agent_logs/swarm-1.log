import argparse, json, os, sys, time
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--model", default="roberta-large")
    ap.add_argument("--input", default="/download_job_code/payload/sandbox/workspaces/alkaid_pi/holdout/holdout_test.txt")
    ap.add_argument("--out", default="mlm_cands_holdout.jsonl")
    ap.add_argument("--n", type=int, default=100000)
    ap.add_argument("--topk", type=int, default=8)
    ap.add_argument("--batch", type=int, default=192)
    ap.add_argument("--maxlen", type=int, default=160)
    args = ap.parse_args()

    t0 = time.time()
    tok = AutoTokenizer.from_pretrained(args.model, use_fast=True)
    model = AutoModelForMaskedLM.from_pretrained(args.model, torch_dtype=torch.float16).cuda().eval()
    mask_id = tok.mask_token_id
    print("loaded", args.model, "mask_id", mask_id, "in", round(time.time()-t0,1), flush=True)

    lines = []
    with open(args.input, encoding="utf-8") as f:
        for line in f:
            s = line.rstrip("\n")
            if s.strip():
                lines.append(s)
            if len(lines) >= args.n:
                break
    print("sentences", len(lines), flush=True)

    jobs = []  # (sid, gap, text)
    toks_all = [ln.split() for ln in lines]
    for sid, toks in enumerate(toks_all):
        n = len(toks)
        if n < 3:
            continue
        for j in range(1, n):
            text = " ".join(toks[:j]) + " " + tok.mask_token + " " + " ".join(toks[j:])
            jobs.append((sid, j, text))
    print("jobs", len(jobs), flush=True)

    # tokenize; record index of the mask token
    enc = []
    for sid, j, text in jobs:
        ids = tok(text, add_special_tokens=True, truncation=True, max_length=args.maxlen)["input_ids"]
        try:
            mpos = ids.index(mask_id)
        except ValueError:
            continue
        enc.append((len(ids), sid, j, ids, mpos))
    enc.sort(key=lambda x: x[0])
    print("encoded", len(enc), flush=True)
    del jobs

    results = {}
    B = args.batch
    tk = args.topk
    t1 = time.time()
    with torch.no_grad():
        for s in range(0, len(enc), B):
            chunk = enc[s:s+B]
            maxlen = max(x[0] for x in chunk)
            input_ids = torch.full((len(chunk), maxlen), tok.pad_token_id, dtype=torch.long)
            attn = torch.zeros((len(chunk), maxlen), dtype=torch.long)
            mpos = []
            for r, (L, sid, j, ids, mp) in enumerate(chunk):
                input_ids[r, :L] = torch.tensor(ids, dtype=torch.long)
                attn[r, :L] = 1
                mpos.append(mp)
            input_ids = input_ids.cuda(); attn = attn.cuda()
            mpos_t = torch.tensor(mpos, device="cuda")
            with torch.autocast(device_type="cuda", dtype=torch.float16):
                logits = model(input_ids, attention_mask=attn).logits
            sel = logits[torch.arange(len(chunk), device="cuda"), mpos_t, :].float()
            probs = torch.softmax(sel, dim=-1)
            topv, topi = torch.topk(probs, tk, dim=-1)
            topv = topv.cpu().numpy(); topi = topi.cpu().numpy()
            for r, (L, sid, j, ids, mp) in enumerate(chunk):
                cands = []
                for v, ii in zip(topv[r], topi[r]):
                    w = tok.decode([int(ii)]).strip()
                    if w:
                        cands.append([float(v), w])
                results.setdefault(sid, []).append([j, cands])
            if s % (B*40) == 0:
                el = time.time()-t1
                done = s+len(chunk)
                print(f"progress {done}/{len(enc)} {done/max(el,1e-9):.1f} job/s elapsed {el:.0f}s", flush=True)

    with open(args.out, "w", encoding="utf-8") as f:
        for sid in sorted(results):
            f.write(json.dumps({"id": sid, "gaps": results[sid]}, ensure_ascii=False) + "\n")
    print("done", len(results), "elapsed", round(time.time()-t0,1), flush=True)

if __name__ == "__main__":
    main()
