import csv, collections, time
TEST='test_v2.txt'; TRAIN='train_v2.txt'
rows=[]
with open(TEST,newline='',encoding='utf-8') as f:
    r=csv.reader(f); next(r)
    for row in r:
        toks=row[1].split(); m=len(toks)
        if 6<=m<=11: rows.append((int(row[0]),toks))
print("short test rows",len(rows),flush=True)
key2ids=collections.defaultdict(list)
for tid,toks in rows:
    key2ids[(toks[0],toks[-1],len(toks)+1)].append(tid)
print("keys",len(key2ids),flush=True)
testmap={tid:toks for tid,toks in rows}
def match(S,T):
    if len(S)!=len(T)+1: return None
    i=0
    while i<len(T) and S[i]==T[i]: i+=1
    if S[i+1:]==T[i:]: return i
    return None
found=collections.defaultdict(collections.Counter)
t0=time.time()
with open(TRAIN,encoding='utf-8') as f:
    for ln,line in enumerate(f):
        toks=line.rstrip('\n').split(); L=len(toks)
        if L<7 or L>12: continue
        key=(toks[0],toks[-1],L)
        ids=key2ids.get(key)
        if not ids: continue
        for tid in ids:
            T=testmap[tid]
            p=match(toks,T)
            if p is not None:
                found[tid][(p,toks[p])]+=1
        if ln%3000000==0: print("line",ln,"found",len(found),"t",round(time.time()-t0,1),flush=True)
print("found ids",len(found),"time",round(time.time()-t0,1),flush=True)
# existing retrieval
existing=set()
with open('retrieval_recovered.tsv',encoding='utf-8') as f:
    r=csv.reader(f,delimiter='\t'); next(r)
    for row in r: existing.add(int(row[0]))
new={}
for tid,c in found.items():
    if tid in existing: continue
    (p,w),cnt=c.most_common(1)[0]
    new[tid]=(p,w,len(c))
print("new recoveries (not in existing)",len(new),flush=True)
if new:
    with open('retrieval_short_extra.tsv','w',encoding='utf-8',newline='') as g:
        wcsv=csv.writer(g,delimiter='\t'); wcsv.writerow(['id','pos','word','n_variants'])
        for tid,(p,w_,nv) in sorted(new.items()): wcsv.writerow([tid,p,w_,nv])
    print("wrote retrieval_short_extra.tsv")
EOF
