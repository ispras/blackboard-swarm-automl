import json, statistics
from rapidfuzz.distance import Levenshtein
B="/download_job_code/payload/sandbox/workspaces"
truth={}
for l in open(f"{B}/alkaid_pi/holdout/holdout_truth.jsonl"):
    d=json.loads(l)
    if d["id"]<2000: truth[d["id"]]=d
rrm={}
for l in open(f"{B}/achernar_tau/rm_t1_rev_2000.jsonl"):
    d=json.loads(l); rrm[d["id"]]=d["cands"]
print("ids",len(rrm))

def ev(scorefn,name,thr=0.0,use_margin=True):
    ds=[];ga=0;wa=0
    for sid,cands in rrm.items():
        t=truth[sid]; orig=t["orig"]; toks=t["sentence"].split()
        scored=[(scorefn(c),c[0],c[1]) for c in cands]
        scored.sort(key=lambda x:-x[0])
        use=True
        if use_margin and len(scored)>1:
            m=scored[0][0]-scored[1][0]
            if m<thr: use=False
        if use:
            _,g,w=scored[0]
            pred=" ".join(toks[:g]+[w]+toks[g:])
            if g==t["gap"]:ga+=1
            if g==t["gap"] and w==t["word"]:wa+=1
        else:
            pred=t["sentence"]
        ds.append(Levenshtein.distance(pred,orig))
    return statistics.mean(ds),ga/len(rrm),wa/len(rrm)

for name,fn in [("fwd",lambda c:c[2]),("rev",lambda c:c[3]),("fwd+rev",lambda c:c[2]+c[3]),("0.5f+0.5r",lambda c:0.5*c[2]+0.5*c[3])]:
    base=ev(fn,name,use_margin=False); print(name,"noFB",base)
    best=min((ev(fn,name,thr=t) for t in [0.0,0.02,0.04,0.06,0.08,0.1,0.12,0.15,0.2,0.25,0.3]),key=lambda x:x[0])
    print("   bestFB",best)
