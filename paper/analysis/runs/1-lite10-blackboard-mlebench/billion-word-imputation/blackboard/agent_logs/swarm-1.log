def casc_xl(sid):
    top3=sorted([(c[2],g) for g,c in lg[sid].items()],reverse=True)[:3]
    best=max(top3,key=lambda x: xl[sid][x[1]][2])
    # confidence: xl best - xl second among top3
    xs=sorted([xl[sid][g][2] for _,g in top3],reverse=True)
