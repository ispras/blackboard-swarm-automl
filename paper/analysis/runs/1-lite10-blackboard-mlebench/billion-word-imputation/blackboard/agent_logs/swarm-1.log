def load(p):
    m={}
    for l in open(p):
        d=json.loads(l); m[d["id"]]={c[0]:c[2] for c in d["cands"]}
    return m
ftm=load(f"{B}/achernar_tau/rm_ftmedium_holdout.jsonl")
