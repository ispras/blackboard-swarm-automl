        t=truth[sid]; toks=t["sentence"].split()
        g,conf=choose(sid)
        use=(conf>=thr) if thr is not None else True
        if use:
            w=lg[sid][g][1]; pred=" ".join(toks[:g]+[w]+toks[g:])
            if g==t["gap"]:ga+=1
            if g==t["gap"] and w==t["word"]:wa+=1
        else: pred=t["sentence"]
        ds.append(Levenshtein.distance(pred,t["orig"]))
    return statistics.mean(ds),ga/len(ids),wa/len(ids)
def bfb(f):
    return min((ev(f,t) for t in [0,0.02,0.04,0.06,0.08,0.1,0.12,0.15,0.2,0.25,0.3,0.4,0.5]),key=lambda x:x[0])
def lg_alone(sid):
    sc=sorted([(c[2],g) for g,c in lg[sid].items()],reverse=True); return sc[0][1],sc[0][0]-sc[1][0] if len(sc)>1 else 1
print("large alone noFB",ev(lg_alone),"bestFB",bfb(lg_alone))
for K in [2,3,4,5]:
    def casc(sid,K=K):
        top=sorted([(c[2],g) for g,c in lg[sid].items()],reverse=True)[:K]
        merged=sorted([(0.5*lg[sid][g][2]+0.5*xl[sid][g][2],g) for _,g in top],reverse=True)
        return merged[0][1],(merged[0][0]-merged[1][0] if len(merged)>1 else 1)
    print(f"casc large-top{K} -> avg xl noFB",ev(casc),"bestFB",bfb(casc))
