gts=vt["InChI"].tolist()
def lenient(s):
    c=canonicalize(s)
    if c: return c
    for kw in [dict(sanitize=False,removeHs=False), dict(sanitize=False)]:
        try:
            m=Chem.MolFromInchi(s, **kw)
            if m is None: continue
            try:
                out=rdinchi.MolToInchi(m)
                if out: return out
            except Exception: pass
        except Exception: pass
    return s
def canon(s): return canonicalize(s) or s
