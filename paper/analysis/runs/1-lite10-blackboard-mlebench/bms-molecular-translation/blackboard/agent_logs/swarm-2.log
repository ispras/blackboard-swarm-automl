"""Chemistry-aware postprocessing for predicted InChI strings.

Verified: rdkit.MolFromInchi -> MolToInchi reproduces GT exactly (mean Lev 0.0 on
2000 holdout) => GT strings are standard InChI, so canonicalizing a *valid*
prediction can never move it away from the GT format.

Usage:
    import sys; sys.path.insert(0, 'workspaces/altair_lambda/rdlibs')
    from inchi_post import canonicalize, is_valid, repair
"""
import os
import sys

_RD = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "rdlibs")
_RD = os.path.abspath(_RD)
if _RD not in sys.path:
    sys.path.append(_RD)

_Chem = None


def _lazy():
    global _Chem
    if _Chem is None:
        from rdkit import Chem, RDLogger
        RDLogger.DisableLog("rdApp.*")
        _Chem = Chem
    return _Chem


def is_valid(s):
    Chem = _lazy()
    return Chem.MolFromInchi(s) is not None


def canonicalize(s):
    """Return standard InChI for s, or None if s does not parse."""
    Chem = _lazy()
    from rdkit.Chem import inchi
    m = Chem.MolFromInchi(s)
    if m is None:
        return None
    try:
        return inchi.MolToInchi(m)
    except Exception:
        return None


def repair(pred, fallback=None):
    """Canonicalize pred if valid; else return fallback (or pred unchanged)."""
    c = canonicalize(pred)
    if c is not None:
        return c
    return fallback if fallback is not None else pred


if __name__ == "__main__":
    import pandas as pd
    from rapidfuzz.distance import Levenshtein
    impo
