=== prep.py ===
import os, numpy as np, pandas as pd

DATA='/download_job_code/payload/sandbox/data'
OUT='/download_job_code/payload/sandbox/workspaces/dubhe_phi'

df = pd.read_csv(f'{DATA}/train_labels.csv')
df = df.sort_values('image_id').reset_index(drop=True)

# image path from id: id is 12 hex chars; path = train/<c0>/<c1>/<c2>/<id>.png
ids = df['image_id'].values
paths = np.array([f"{DATA}/train/{i[0]}/{i[1]}/{i[2]}/{i}.png" for i in ids])

# char vocab from all labels (use train only)
chars = set()
for x in df['InChI'].values:
    chars.update(x)
chars = sorted(chars)
print('num chars', len(chars))
print(''.join(chars))
# specials
itos = ['<pad>','<sos>','<eos>'] + chars
stoi = {c:i for i,c in enumerate(itos)}
np.save(f'{OUT}/vocab.npy', np.array(itos, dtype=object))

# deterministic split
n=len(df); val_n=20000
rng=np.random.RandomState(42)
val_idx=rng.choice(n, val_n, replace=False)
mask=np.ones(n, dtype=bool); mask[val_idx]=False
tr_idx=np.where(mask)[0]

np.savez(f'{OUT}/index.npz',
         train_paths=paths[tr_idx], train_labels=df['InChI'].values[tr_idx],
         val_paths=paths[val_idx], val_labels=df['InChI'].values[val_idx])
print('train', len(tr_idx), 'val', val_idx.shape[0])
print('vocab size', len(itos))
=== bench.py ===
import time, numpy as np, torch, torch.nn as nn, cv2
from torch.utils.data import Dataset, DataLoader
from model import Img2InChI, causal_mask

OUT='/download_job_code/payload/sandbox/workspaces/dubhe_phi'
dev='cuda'

from data import InChIDataset, PadCollate

def bench_loader(stoi, nw=12, bs=64, steps=30):
    z=np.load(f'{OUT}/index.npz', allow_pickle=True)
    ds=InChIDataset(z['train_paths'][:5000], z['train_labels'][:5000], stoi)
    dl=DataLoader(ds,batch_size=bs,shuffle=True,num_workers=nw,prefetch_factor=2,
                  drop_last=True, collate_fn=PadCollate())
    t=time.time(); c=0
    for i,(x,y) in enumerate(dl):
        c+=x.shape[0]
        if i+1>=steps: break
    print(f'loader: {c/(time.time()-t):.0f} img/s with {nw} workers')

def bench_model(enc, bs=48, steps=20, size=384):
    m=Img2InChI(41, encoder_name=enc).to(dev)
    nparam=sum(p.numel() for p in m.parameters())/1e6
    opt=torch.optim.AdamW(m.parameters(), lr=1e-4)
    scaler=torch.cuda.amp.GradScaler()
    x=torch.randn(bs,1,size,size,device=dev)
    L=130
    y=torch.randint(3,41,(bs,L),device=dev)
    m.train()
    # warmup
    for _ in range(3):
        with torch.cuda.amp.autocast():
            out=m(x,y[:,:-1]); loss=nn.functional.cross_entropy(out.reshape(-1,out.size(-1)),y[:,1:].reshape(-1))
        scaler.scale(loss).backward(); scaler.step(opt); scaler.update(); opt.zero_grad()
    torch.cuda.synchronize(); t=time.time()
    for _ in range(steps):
        with torch.cuda.amp.autocast():
            out=m(x,y[:,:-1]); loss=nn.functional.cross_entropy(out.reshape(-1,out.size(-1)),y[:,1:].reshape(-1))
        scaler.scale(loss).backward(); scaler.step(opt); scaler.update(); opt.zero_grad()
    torch.cuda.synchronize()
    dt=(time.time()-t)/steps
    print(f'{enc}: {bs} params={nparam:.1f}M step={dt*1000:.0f}ms  {bs*L/dt:.0f} tok/s {bs/dt:.0f} img/s  mem={torch.cuda.max_memory_allocated()/1e9:.1f}GB')

if __name__=='__main__':
    import sys
    itos=np.load(f'{OUT}/vocab.npy', allow_pickle=True)
    stoi={c:i for i,c in enumerate(itos)}
    if 'loader' in sys.argv:
        bench_loader(stoi, nw=12)
    else:
        bench_model(sys.argv[2] if len(sys.argv)>2 else 'convnext_tiny.fb_in22k_ft_in1k', bs=int(sys.argv[3]) if len(sys.argv)>3 else 48, size=int(sys.argv[4]) if len(sys.argv)>4 else 384)
