=== train.py (dubhe) ===
import os, sys, time, math, argparse, numpy as np, torch, torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader
from data import InChIDataset, PadCollate
from model import Img2InChI
from rapidfuzz.distance import Levenshtein

OUT='/download_job_code/payload/sandbox/workspaces/dubhe_phi'

def get_args():
    p=argparse.ArgumentParser()
    p.add_argument('--encoder', default='convnext_tiny.fb_in22k_ft_in1k')
    p.add_argument('--size', type=int, default=384)
    p.add_argument('--d', type=int, default=512)
    p.add_argument('--nlayers', type=int, default=6)
    p.add_argument('--dim_ff', type=int, default=2048)
    p.add_argument('--batch', type=int, default=128)
    p.add_argument('--lr', type=float, default=2e-4)
    p.add_argument('--enc_lr_mult', type=float, default=0.5)
    p.add_argument('--wd', type=float, default=0.01)
    p.add_argument('--warmup', type=int, default=1000)
    p.add_argument('--epochs', type=int, default=100)
    p.add_argument('--max_hours', type=float, default=7.0)
    p.add_argument('--subset', type=int, default=1200000)
    p.add_argument('--val_n', type=int, default=2000)
    p.add_argument('--workers', type=int, default=10)
    p.add_argument('--tag', default='run1')
    p.add_argument('--resume', default='')
    return p.parse_args()

def lr_at(step, total, warmup, base):
    if step < warmup:
        return base * step / max(1, warmup)
    p = (step - warmup) / max(1, total - warmup)
    return base * 0.5 * (1 + math.cos(math.pi * min(1.0, p)))

def main():
    a=get_args()
    torch.backends.cudnn.benchmark=True
    dev='cuda'
    itos=np.load(f'{OUT}/vocab.npy', allow_pickle=True)
    stoi={c:i for i,c in enumerate(itos)}
    PAD, SOS, EOS = stoi['<pad>'], stoi['<sos>'], stoi['<eos>']

    z=np.load(f'{OUT}/index.npz', allow_pickle=True)
    tp, tl = z['train_paths'], z['train_labels']
    vp, vl = z['val_paths'], z['val_labels']
    if a.subset and a.subset < len(tp):
        rng=np.random.RandomState(0); sel=rng.choice(len(tp), a.subset, replace=False)
        tp, tl = tp[sel], tl[sel]
    print(f'train={len(tp)} val={len(vp)}', flush=True)

    tr=InChIDataset(tp, tl, stoi, size=a.size)
    dl=DataLoader(tr, batch_size=a.batch, shuffle=True, num_workers=a.workers,
                  pin_memory=True, drop_last=True, persistent_workers=a.workers>0,
                  collate_fn=PadCollate(PAD), prefetch_factor=3)
    steps_per_epoch=len(dl)
    total_steps=steps_per_epoch*a.epochs
    print(f'steps/epoch={steps_per_epoch} total={total_steps}', flush=True)

    model=Img2InChI(len(itos), encoder_name=a.encoder, d=a.d, nlayers=a.nlayers,
                    dim_ff=a.dim_ff, size=a.size).to(dev)
    enc_params=[p for n,p in model.named_parameters() if n.startswith('encoder')]
    dec_params=[p for n,p in model.named_parameters() if not n.startswith('encoder')]
    opt=torch.optim.AdamW([{'params':enc_params,'lr':a.lr*a.enc_lr_mult},
                           {'params':dec_params,'lr':a.lr}], weight_decay=a.wd, betas=(0.9,0.98))
    start_step=0; best=1e9
    if a.resume and os.path.exists(a.resume):
        ck=torch.load(a.resume, map_location=dev)
        model.load_state_dict(ck['model']); opt.load_state_dict(ck['opt'])
        start_step=ck['step']; best=ck.get('best',1e9)
        print('resumed from', a.resume, 'step', start_step, flush=True)

    log=open(f'{OUT}/{a.tag}.log','a')
    def L(msg):
        print(msg, flush=True); log.write(msg+'\n'); log.flush()

    scaler=None
    t0=time.time(); step=start_step
    stop=False
    for ep in range(a.epochs):
        if stop: break
        model.train()
        run=0.0; n=0; te=time.time()
        for x,y in dl:
            if step>=total_steps: break
            x=x.to(dev, non_blocking=True); y=y.to(dev, non_blocking=True)
            for g in opt.param_groups:
                g['lr']=lr_at(step, total_steps, a.warmup, a.lr if g is opt.param_groups[1] else a.lr*a.enc_lr_mult)
            with torch.autocast('cuda', dtype=torch.bfloat16):
                out=model(x, y[:, :-1])
                loss=F.cross_entropy(out.reshape(-1,out.size(-1)), y[:,1:].reshape(-1),
                                     ignore_index=PAD, label_smoothing=0.1)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step(); opt.zero_grad(set_to_none=True)
            run+=loss.item(); n+=1; step+=1
            if n%100==0:
                el=time.time()-te
                L(f'[{a.tag}] ep{ep} step{step}/{total_steps} loss={run/n:.4f} lr={opt.param_groups[1]["lr"]:.2e} {n/el:.2f}it/s {el:.0f}s')
                run=0.0; n=0; te=time.time()
            if (time.time()-t0)/3600 > a.max_hours:
                L(f'[{a.tag}] time budget reached'); stop=True; break
        # ---- validation (greedy) ----
        if not stop:
            model.eval()
            vi=np.random.RandomState(ep).choice(len(vp), min(a.val_n,len(vp)), replace=False)
            vp_s, vl_s = vp[vi], vl[vi]
            vd=InChIDataset(vp_s, vl_s, stoi, size=a.size, train=False)
            vdl=DataLoader(vd, batch_size=128, shuffle=False, num_workers=6, collate_fn=PadCollate(PAD))
            tot=0.0; cnt=0
            with torch.no_grad():
                for x,y in vdl:
                    x=x.to(dev)
                    pred=model.greedy(x, SOS, EOS, max_len=430)
                    for k in range(pred.shape[0]):
                        ids=pred[k].tolist()
                        if EOS in ids: ids=ids[:ids.index(EOS)]
                        s=''.join(itos[i] for i in ids)
                        tot+=Levenshtein.distance(s, vl_s[cnt]); cnt+=1
            ml=tot/cnt
            L(f'[{a.tag}] VAL mean_levenshtein={ml:.4f} on {cnt}')
            if ml<best:
                best=ml
                torch.save({'model':model.state_dict(),'opt':opt.state_dict(),'step':step,
                            'best':best,'args':vars(a)}, f'{OUT}/{a.tag}_best.pt')
                L(f'[{a.tag}] saved best {best:.4f}')
        torch.save({'model':model.state_dict(),'opt':opt.state_dict(),'step':step,'best':best,
                    'args':vars(a)}, f'{OUT}/{a.tag}_last.pt')
        L(f'[{a.tag}] checkpoint ep{ep} saved')
    L(f'[{a.tag}] DONE best={best:.4f}')

if __name__=='__main__':
    main()
