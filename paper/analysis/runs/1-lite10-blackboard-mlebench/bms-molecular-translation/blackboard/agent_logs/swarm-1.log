=== dubhe model.py ===
import math, torch, torch.nn as nn, timm

class Encoder(nn.Module):
    def __init__(self, name='convnext_tiny.fb_in22k_ft_in1k', d_model=512):
        super().__init__()
        self.backbone = timm.create_model(name, pretrained=True, features_only=True)
        c = self.backbone.feature_info.channels()[-1]
        self.proj = nn.Conv2d(c, d_model, 1)

    def forward(self, x):
        if x.shape[1] == 1:
            x = x.repeat(1, 3, 1, 1)
        f = self.backbone(x)[-1]          # [B,C,h,w]
        f = self.proj(f)                  # [B,d,h,w]
        B, d, h, w = f.shape
        f = f.flatten(2).transpose(1, 2)  # [B,h*w,d]
        return f, h, w

class Decoder(nn.Module):
    def __init__(self, vocab, d_model=512, nhead=8, nlayers=6, dim_ff=2048, max_len=440, dropout=0.1):
        super().__init__()
        self.embed = nn.Embedding(vocab, d_model)
        self.pos = nn.Embedding(max_len, d_model)
        self.drop = nn.Dropout(dropout)
        layer = nn.TransformerDecoderLayer(d_model, nhead, dim_ff, dropout, batch_first=True,
                                           norm_first=True, activation='gelu')
        self.body = nn.TransformerDecoder(layer, nlayers)
        self.norm = nn.LayerNorm(d_model)
        self.head = nn.Linear(d_model, vocab)
        self.d_model = d_model

    def forward(self, tgt, memory, tgt_mask=None, tgt_pad_mask=None):
        B, L = tgt.shape
        pos = torch.arange(L, device=tgt.device).unsqueeze(0)
        x = self.embed(tgt) * math.sqrt(self.d_model) + self.pos(pos)
        x = self.drop(x)
        out = self.body(x, memory, tgt_mask=tgt_mask, tgt_key_padding_mask=tgt_pad_mask)
        return self.head(self.norm(out))

class Img2InChI(nn.Module):
    def __init__(self, vocab, encoder_name='convnext_tiny.fb_in22k_ft_in1k',
                 d_model=512, nhead=8, nlayers=6, dim_ff=2048, max_len=440):
        super().__init__()
        self.encoder = Encoder(encoder_name, d_model)
        self.decoder = Decoder(vocab, d_model, nhead, nlayers, dim_ff, max_len)

    def encode(self, x):
        mem, h, w = self.encoder(x)
        return mem

    def forward(self, images, tgt, tgt_mask=None, tgt_pad_mask=None):
        mem = self.encode(images)
        return self.decoder(tgt, mem, tgt_mask, tgt_pad_mask)

def causal_mask(L, device):
    return torch.triu(torch.full((L, L), float('-inf'), device=device), diagonal=1)
=== dubhe data.py ===
import numpy as np, torch, cv2
from torch.utils.data import Dataset

class InChIDataset(Dataset):
    def __init__(self, paths, labels, stoi, size=384, train=True):
        self.paths=paths; self.labels=labels; self.stoi=stoi
        self.size=size; self.train=train
    def __len__(self): return len(self.paths)
    def _img(self, i):
        img=cv2.imread(self.paths[i], cv2.IMREAD_GRAYSCALE)
        h,w=img.shape
        s=self.size/max(h,w)
        nh,nw=max(1,int(round(h*s))),max(1,int(round(w*s)))
        interp=cv2.INTER_AREA if s<1 else cv2.INTER_LINEAR
        img=cv2.resize(img,(nw,nh),interpolation=interp)
        canvas=np.full((self.size,self.size),255,np.uint8)
        canvas[:nh,:nw]=img
        t=torch.from_numpy(canvas).float().div(255).sub(0.5).div(0.5).unsqueeze(0)
        return t
    def __getitem__(self, i):
        x=self._img(i)
        lab=self.labels[i]
        toks=[self.stoi['<sos>']]+[self.stoi[c] for c in lab]+[self.stoi['<eos>']]
        return x, torch.tensor(toks, dtype=torch.long)

class PadCollate:
    def __init__(self, pad=0): self.pad=pad
    def __call__(self, batch):
        xs=[b[0] for b in batch]; ys=[b[1] for b in batch]
        T=max(y.numel() for y in ys)
        Y=torch.full((len(ys),T), self.pad, dtype=torch.long)
        for i,y in enumerate(ys): Y[i,:y.numel()]=y
        return torch.stack(xs,0), Y
