from model import Img2InChI  # source of truth (dubhe_phi)
import beam_search as bs


class ImgDS(Dataset):
    def __init__(self, paths, size=384):
        self.paths = paths
        self.size = size

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, i):
        img = cv2.imread(self.paths[i], cv2.IMREAD_GRAYSCALE)
        h, w = img.shape
        s = self.size / max(h, w)
        nh, nw = max(1, int(round(h * s))), max(1, int(round(w * s)))
        interp = cv2.INTER_AREA if s < 1 else cv2.INTER_LINEAR
        img = cv2.resize(img, (nw, nh), interpolation=interp)
        canvas = np.full((self.size, self.size), 255, np.uint8)
        canvas[:nh, :nw] = img
        return torch.from_numpy(canvas).float().div(255).unsqueeze(0)


def load_model(ckpt, encoder, vocab_n, d, nhead, nlayers, dim_ff, max_len, size, device):
    ck = torch.load(ckpt, map_location='cpu')
    sd = ck['model'] if isinstance(ck, dict) and 'model' in ck else ck
    if isinstance(ck, dict) and isinstance(ck.get('args'), dict):
        aa = ck['args']
        encoder = aa.get('encoder', encoder)
        d = aa.get('d', d)
        nlayers = aa.get('nlayers', nlayers)
        dim_ff = aa.get('dim_ff', dim_ff)
        size = aa.get('size', size)
        max_len = aa.get('max_len', max_len)
    sd = {k.replace('module.', ''): v for k, v in sd.items()}
    print(f'config: encoder={encoder} d={d} nlayers={nlayers} dim_ff={dim_ff} size={size} max_len={max_len}', flush=True)
    model = Img2InChI(vocab_n, encoder_name=encoder, d=d, nhead=nhead,
                      nlayers=nlayers, dim_ff=dim_ff, max_len=max_len, size=size)
    missing = model.load_state_dict(sd, strict=False)
    model.to(device).eval()
    return model, missing


