import math
import torch
import torch.nn.functional as F


def _split(t, nhead, hd):
    B, L, _ = t.shape
    return t.view(B, L, nhead, hd).transpose(1, 2)


@torch.no_grad()
def init_cross(decoder, memory):
    """Precompute cross-attn K,V per layer. decoder = model.decoder."""
    nhead = decoder.layers[0].cross_attn.nhead
    hd = decoder.layers[0].cross_attn.hd
    cross = []
    for layer in decoder.layers:
        a = layer.cross_attn
        K = a.k(memory)
        V = a.v(memory)
        B, S, _ = memory.shape
        K = K.view(B, S, nhead, hd).transpose(1, 2).contiguous()
        V = V.view(B, S, nhead, hd).transpose(1, 2).contiguous()
        cross.append((K, V))
    return cross


@torch.no_grad()
def step(decoder, tok, pos, self_caches, cross):
    """tok: (R,) new tokens; pos: int; returns logits (R,V) and updates self_caches in place."""
    nhead = decoder.layers[0].cross_attn.nhead
    hd = decoder.layers[0].cross_attn.hd
    d = decoder.d
    R = tok.shape[0]
    x = decoder.embed(tok)[:, None, :] * math.sqrt(d) + decoder.pos(torch.full((R, 1), pos, dtype=torch.long, device=tok.device))
    for li, layer in enumerate(decoder.layers):
        # self attention (cached)
        h = layer.n1(x)
        a = layer.self_attn
        q = _split(a.q(h), nhead, hd)
        k = _split(a.k(h), nhead, hd)
        v = _split(a.v(h), nhead, hd)
        ck, cv = self_caches[li]
        if ck is not None:
            k = torch.cat([ck, k], dim=2)
            v = torch.cat([cv, v], dim=2)
        self_caches[li] = (k, v)
        o = F.scaled_dot_product_attention(q, k, v)
        o = o.transpose(1, 2).reshape(R, 1, d)
        x = h + a.o(o)
        # cross attention
        h = layer.n2(x)
        ca = layer.cross_attn
        qc = _split(ca.q(h), nhead, hd)
        Kc, Vc = cross[li]
        oc = F.scaled_dot_product_attention(qc, Kc, Vc)
        oc = oc.transpose(1, 2).reshape(R, 1, d)
        x = x + ca.o(oc)
        # ffn
        x = x + layer.ff(layer.n3(x))
    return decoder.head(decoder.norm(x))[:, 0]


@torch.no_grad()
def greedy(decoder, memory, prefix, eos, max_len=400):
    """prefix: list of ids starting with SOS. Returns list of id-lists (prefix removed, eos removed)."""
    dev = memory.device
    B = memory.shape[0]
    cross = init_cross(decoder, memory)
    self_caches = [(None, None) for _ in decoder.layers]
    # teacher-force prefix
    P = len(prefix)
    toks = torch.tensor(prefix, dtype=torch.long, device=dev).unsqueeze(0).expand(B, -1).contiguous()
    logits = None
    for p in range(P):
        logits = step(decoder, toks[:, p], p, self_caches, cross)
    out = [[] for _ in range(B)]
    done = [False] * B
    for t in range(max_len):
        nxt = logits.argmax(-1)  # (B,)
        for i in range(B):
            if not done[i]:
                if int(nxt[i]) == eos:
                    done[i] = True
                else:
                    out[i].append(int(nxt[i]))
        if all(done):
            break
        logits = step(decoder, nxt, P + t, self_caches, cross)
    return out


@torch.no_grad()
def beam(decoder, memory, prefix, eos, beam_size=4, max_len=400, lp_alpha=0.0):
    """Beam search. Returns (list of id-lists (no prefix/eos), list of scores)."""
    dev = memory.device
    B = memory.shape[0]
    K = beam_size
    V = decoder.head.out_features
    cross1 = init_cross(decoder, memory)

    def expand(t, k):
        return t.repeat_interleave(k, dim=0)

    cross = [(expand(Kc, K), expand(Vc, K)) for Kc, Vc in cross1]
    mem = expand(memory, K)
    self_caches = [(None, None) for _ in decoder.layers]
    P = len(prefix)
    toks = torch.tensor(prefix, dtype=torch.long, device=dev).unsqueeze(0).expand(B, -1).contiguous()
    logits = None
    for p in range(P):
        logits = step(decoder, expand(toks[:, p], K), p, self_caches, cross)

    scores = torch.zeros(B * K, device=dev)
    finished = [[] for _ in range(B)]
    fin_scores = [[] for _ in range(B)]
    # track token history for output
    hist = torch.full((B * K, P), 0, dtype=torch.long, device=dev)
    for p in range(P):
        hist[:, p] = toks[:, p].repeat_interleave(K)

    for t in range(max_len):
        logp = F.log_softmax(logits.float(), -1)          # (B*K, V)
        cand = scores[:, None] + logp                     # (B*K, V)
        cand = cand.view(B, K * V)
        topv, topi = cand.topk(K, dim=1)                  # (B,K)
        parent = topi // V
        token = topi % V
        new_scores = topv.reshape(-1)                     # (B*K,)
        # reorder caches: rows are B*K, parent index within item
        row = torch.arange(B, device=dev).unsqueeze(1) * K + parent  # (B,K) source rows
        src = row.reshape(-1)
        for li in range(len(self_caches)):
            ck, cv = self_caches[li]
            self_caches[li] = (ck[src], cv[src])
        hist = hist[src]
        hist = torch.cat([hist, token.reshape(-1, 1)], dim=1)
        scores = new_scores

        eos_mask = token == eos
        for b in range(B):
            for k in range(K):
                if eos_mask[b, k]:
                    idx = b * K + k
                    finished[b].append(hist[idx, P:].tolist())
                    fin_scores[b].append(float(scores[idx] / max(1, (hist.shape[1] - P)) ** 0))
                    scores[idx] = -1e9
        nxt = token.reshape(-1)
        logits = step(decoder, nxt, P + t, self_caches, cross)

    # collect
    best_tokens = []
    best_score = []
    for b in range(B):
        cand_list = list(zip(fin_scores[b], finished[b]))
        if not cand_list:
            # take best active
            rows = slice(b * K, (b + 1) * K)
            s = scores[rows]
            j = int(s.argmax())
            cand_list = [(float(s[j]), hist[b * K + j, P:].tolist())]
        cand_list.sort(key=lambda x: -x[0])
        best_score.append(cand_list[0][0])
        best_tokens.append(cand_list[0][1])
    return best_tokens, best_score
