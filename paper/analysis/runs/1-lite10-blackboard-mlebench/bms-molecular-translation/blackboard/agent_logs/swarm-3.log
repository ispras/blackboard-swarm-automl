import sys, torch
sys.path.insert(0,'workspaces/mirfak_mu')
from model_def import Decoder
from decode_lib import CachedGenerator
torch.manual_seed(0)
V=41; d=64; nh=4; nl=2; ff=128; L=12
dec = Decoder(V, d_model=d, nhead=nh, nlayers=nl, dim_ff=ff, max_len=64, dropout=0.0).eval()
class M: pass
m=M(); m.decoder=dec
B=3; S=10
mem = torch.randn(B,S,d)
toks = torch.randint(3,V,(B,L))
# full teacher-forced forward
mask = torch.triu(torch.full((L,L), float('-inf')), diagonal=1)
full = dec(toks, mem, tgt_mask=mask)  # (B,L,V)
# cached step-by-step
gen = CachedGenerator(m, eos_id=2, sos_id=1, pad_id=0, max_len=L, device='cpu')
# feed sos then each token, compare
ys = torch.full((B,1), 1, dtype=torch.long)
gen._cross=None
# compute cross caches
cross=[]
for layer in gen.layers:
    from decode_lib import _split_proj
