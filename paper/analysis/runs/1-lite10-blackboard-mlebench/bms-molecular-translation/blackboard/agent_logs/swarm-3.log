+def beam_nbest(decoder, memory, prefix, eos, beam_size=5, max_len=400, out_k=5):
+    """Return per-item list of (score, tokens) — top out_k candidates (finished + active)."""
+    dev = memory.device
+    B = memory.shape[0]
+    K = beam_size
+    V = decoder.head.out_features
+    cross1 = init_cross(decoder, memory)
+    cross = [(_exp(Kc, K), _exp(Vc, K)) for Kc, Vc in cross1]
+    P = len(prefix)
+    self_caches = [(None, None) for _ in decoder.layers]
+    toks = torch.tensor(prefix, dtype=torch.long, device=dev).unsqueeze(0).expand(B, -1).contiguous()
+    logits = None
+    for p in range(P):
+        logits = step(decoder, _exp(toks[:, p], K), p, self_caches, cross)
+    scores = torch.zeros(B * K, device=dev)
+    hist = torch.zeros((B * K, P), dtype=torch.long, device=dev)
+    for p in range(P):
+        hist[:, p] = toks[:, p].repeat_interleave(K)
+    finished = [[] for _ in range(B)]
+    for t in range(max_len):
+        logp = F.log_softmax(logits.float(), -1)
+        cand = (scores[:, None] + logp).view(B, K * V)
+        topv, topi = cand.topk(K, dim=1)
+        parent = topi // V
+        token = topi % V
+        scores = topv.reshape(-1)
+        src = (torch.arange(B, device=dev).unsqueeze(1) * K + parent).reshape(-1)
+        for li in range(len(self_caches)):
+            ck, cv = self_caches[li]
+            self_caches[li] = (ck[src], cv[src])
+        hist = torch.cat([hist[src], token.reshape(-1, 1)], dim=1)
+        eos_mask = token == eos
+        for b in range(B):
+            for k in range(K):
+                if eos_mask[b, k]:
+                    idx = b * K + k
+                    finished[b].append((float(scores[idx]), hist[idx, P:].tolist()))
+                    scores[idx] = -1e9
+        logits = step(decoder, token.reshape(-1), P + t, self_caches, cross)
+    result = []
+    for b in range(B):
+        act = []
+        for k in range(K):
+            idx = b * K + k
+            if scores[idx] > -1e8:
+                act.append((float(scores[idx]), hist[idx, P:].tolist()))
+        allb = finished[b] + act
+        if not allb:
+            allb = [(0.0, [])]
+        allb.sort(key=lambda x: -x[0])
+        result.append(allb[:out_k])
+    return result
+
+
+def _exp(t, k):
+    return t.repeat_interleave(k, dim=0)
+
