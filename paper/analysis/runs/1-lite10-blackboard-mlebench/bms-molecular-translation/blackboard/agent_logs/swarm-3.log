from model import Img2InChI
from importlib import import_module
ev=import_module('eval_variants') if False else None
class ImgDS(Dataset):
    def __init__(s,paths,size): s.paths=paths; s.size=size
    def __len__(s): return len(s.paths)
    def __getitem__(s,i):
        img=cv2.imread(s.paths[i],cv2.IMREAD_GRAYSCALE); h,w=img.shape
        sc=s.size/max(h,w); nh,nw=max(1,int(round(h*sc))),max(1,int(round(w*sc)))
        img=cv2.resize(img,(nw,nh),interpolation=cv2.INTER_AREA if sc<1 else cv2.INTER_LINEAR)
        c=np.full((s.size,s.size),255,np.uint8); c[:nh,:nw]=img
        return torch.from_numpy(c).float().div(255).unsqueeze(0)
dev='cuda'
