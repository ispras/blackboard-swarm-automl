import pandas as pd, numpy as np, os, json
from rapidfuzz.distance import Levenshtein as Lev
OUT='workspaces/mirfak_mu'
rng=np.random.RandomState(11)
df=pd.read_csv('data/train_labels.csv')
s=df.sample(60000, random_state=7).reset_index(drop=True)
def size_of(i, split='train'):
    p=f"data/{split}/{i[0]}/{i[1]}/{i[2]}/{i}.png"
    try: return os.path.getsize(p)
    except: return -1
sizes=np.array([size_of(i) for i in s['image_id'].values])
strings=s['InChI'].values
valid=sizes>0
sizes=sizes[valid]; strings=strings[valid]
nb=10
edges=np.quantile(sizes, np.linspace(0,1,nb+1)); edges[0]-=1; edges[-1]+=1
def medoid(pool, ref):
    best=None; bm=1e9
    for c in pool:
        m=np.mean([Lev.distance(c,r) for r in ref])
        if m<bm: bm=m; best=c
    return best
medoids=[]
for b in range(nb):
    lo,hi=edges[b],edges[b+1]
    m=(sizes>=lo)&(sizes<hi)
    pool=strings[m]
    if len(pool)>3000: pool=pool[rng.choice(len(pool),3000,replace=False)]
    ref=pool if len(pool)<=800 else pool[rng.choice(len(pool),800,replace=False)]
    c=medoid(pool, ref)
    medoids.append(c)
    print(f"bin{b} [{lo:.0f},{hi:.0f}) n={m.sum()} medoid_dist={np.mean([Lev.distance(c,r) for r in ref]):.2f}")
json.dump({'edges':[float(e) for e in edges],'medoids':[str(x) for x in medoids]}, open(f'{OUT}/cond_medoid.json','w'), indent=1)
# build test submission
sub=pd.read_csv('data/sample_submission.csv')
ids=sub['image_id'].values
tsz=np.array([size_of(i,'test') for i in ids])
bins=np.digitize(tsz, edges[1:-1])
preds=np.array([medoids[min(max(b,0),nb-1)] for b in bins], dtype=object)
sub['InChI']=preds
sub.to_csv(f'{OUT}/fallback_submission.csv', index=False)
print("wrote fallback_submission.csv", len(sub), "bin counts", np.bincount(bins))
EOF
