import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
rng = np.random.RandomState(1)
df = pd.read_csv('data/train_labels.csv')
S = df['InChI'].values
idx = rng.choice(len(S), 2000, replace=False)
sample = S[idx]
# pairwise among 2000 -> use first 400 x 400 subset to estimate
A = sample[:400]; B = sample[400:800]
ds=[]
for a in A:
    ds.extend(Lev.distance(a,b) for b in B)
ds=np.array(ds)
print("random-pair mean lev:", ds.mean(), "median:", np.median(ds), "p10/p90:", np.percentile(ds,10), np.percentile(ds,90))
# length stats
lens = np.array([len(x) for x in sample])
print("len mean", lens.mean())
# prefix shared: first differing index
def shared_prefix(a,b):
    n=min(len(a),len(b))
    i=0
    while i<n and a[i]==b[i]: i+=1
    return i
sp = [shared_prefix(a,b) for a in A[:100] for b in B[:100]]
print("shared prefix mean/median:", np.mean(sp), np.median(sp))
# direct check: medoid vs ref
med = np.load('workspaces/mirfak_mu/medoid.npy')[0]
ref = sample[:200]
print("medoid dist mean to 200:", np.mean([Lev.distance(med,r) for r in ref]))
print("water dist mean to 200:", np.mean([Lev.distance("InChI=1S/H2O/h1H2",r) for r in ref]))
EOF
