import pandas as pd, numpy as np, os
from PIL import Image
from rapidfuzz.distance import Levenshtein as Lev
df=pd.read_csv('data/train_labels.csv')
s=df.sample(40000, random_state=7).reset_index(drop=True)
sizes=[]
for i in s['image_id'].values:
    p=f"data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png"
    sizes.append(os.path.getsize(p))
sizes=np.array(sizes); L=np.array([len(x) for x in s['InChI'].values])
strings=s['InChI'].values
rng=np.random.RandomState(0)
# split into fit/eval
idx=rng.permutation(len(s)); fit=idx[:20000]; ev=idx[20000:]
# global medoid
def medoid(pool_str, ref_str):
    best=None; bm=1e9
    for c in pool_str:
        m=np.mean([Lev.distance(c,r) for r in ref_str])
        if m<bm: bm=m; best=c
    return best,bm
# global
gm,gmeval=medoid(strings[fit][:1500], strings[ev][:600])
print("global medoid eval:", gmeval)
# per size bin
nb=8
edges=np.quantile(sizes[fit], np.linspace(0,1,nb+1))
edges[0]-=1; edges[-1]+=1
preds=np.empty(len(ev),dtype=object)
tot=0.0; cnt=0
for b in range(nb):
    if b<nb-1:
        mfit=(sizes[fit]>=edges[b])&(sizes[fit]<edges[b+1])
        mev=(sizes[ev]>=edges[b])&(sizes[ev]<edges[b+1])
    else:
        mfit=(sizes[fit]>=edges[b]); mev=(sizes[ev]>=edges[b])
    pool=strings[fit][mfit]; ref=strings[ev][mev]
    if len(pool)==0 or len(ref)==0: continue
    # subsample pool for speed
    if len(pool)>1500: pool=pool[rng.choice(len(pool),1500,replace=False)]
    ref2=ref[:min(len(ref),400)]
    c,m=medoid(pool,ref2)
    d=np.mean([Lev.distance(c,r) for r in ref])
    tot+=d*len(ref); cnt+=len(ref)
    print(f"bin{b} size[{edges[b]:.0f},{edges[b+1]:.0f}) n_eval={len(ref)} meanlen={np.mean([len(x) for x in ref]):.0f} medoid_dist={d:.2f}")
print("COND MEDOID eval:", tot/cnt)
EOF
