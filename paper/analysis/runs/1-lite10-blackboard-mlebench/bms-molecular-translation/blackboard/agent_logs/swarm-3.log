import pandas as pd, numpy as np, sys, time
from rapidfuzz.distance import Levenshtein as Lev
sys.path.insert(0,'workspaces/altair_lambda/shared')
from inchi_post import canonicalize, is_valid

def longest_valid(p):
    if canonicalize(p) is not None:
        return canonicalize(p)
    parts=p.split('/')
    for k in range(len(parts)-1, 1, -1):
        cand='/'.join(parts[:k])
        c=canonicalize(cand)
        if c is not None:
            return c
    return None

df=pd.read_csv('workspaces/mirfak_mu/val_true_pred.csv')
p0=list(df['InChI']); g=list(df['gt'])
base=np.array([Lev.distance(p,x) for p,x in zip(p0,g)])
canon=np.array([Lev.distance(canonicalize(p) or p,x) for p,x in zip(p0,g)])
t=time.time(); rep=[]
for p in p0:
    r=longest_valid(p)
    rep.append(r if r is not None else p)
el=time.time()-t
repa=np.array([Lev.distance(p,x) for p,x in zip(rep,g)])
print(f"n={len(p0)} base={base.mean():.4f} canon={canon.mean():.4f} longest-valid={repa.mean():.4f} (time {el:.0f}s)")
# how many changed by longest-valid vs canon, and improved/worsened
ch=np.array([a!=b for a,b in zip(rep,[canonicalize(p) or p for p in p0])])
imp=np.sum((repa<canon)&ch); wor=np.sum((repa>canon)&ch)
print(f"longest-valid changes vs canon: {int(ch.sum())} improved={imp} worsened={wor}")
EOF
