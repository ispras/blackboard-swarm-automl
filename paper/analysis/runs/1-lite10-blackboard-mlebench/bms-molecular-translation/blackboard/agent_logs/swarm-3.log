import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein as Lev
rng=np.random.RandomState(3)
df=pd.read_csv('data/train_labels.csv')
s=df.sample(30000, random_state=5).reset_index(drop=True)
strings=s['InChI'].values; L=np.array([len(x) for x in strings])
idx=rng.permutation(len(s)); fit=idx[:15000]; ev=idx[15000:]
# oracle: per exact-length medoid
tot=0; cnt=0
for l in np.unique(L[ev]):
    pool=strings[fit][L[fit]==l]; ref=strings[ev][L[ev]==l]
    if len(pool)==0 or len(ref)==0: continue
    if len(pool)>800: pool=pool[rng.choice(len(pool),800,replace=False)]
    # medoid of pool wrt itself is costly; approximate with pool[0]? do proper small
    best=None;bm=1e9
    sub=pool[:600]
    for c in sub:
        m=np.mean([Lev.distance(c,r) for r in sub[:200]])
        if m<bm: bm=m;best=c
    d=np.mean([Lev.distance(best,r) for r in ref])
    tot+=d*len(ref); cnt+=len(ref)
print("ORACLE exact-length conditional medoid:", tot/cnt, "on", cnt)
# also: use only GT length rounded to nearest 20 and medoid within +-20
for tol in [10,20,30]:
    tot=0;cnt=0
    for l in range(30,404,10):
        pool=strings[fit][(L[fit]>=l-tol)&(L[fit]<=l+tol)]
        ref=strings[ev][(L[ev]>=l-tol)&(L[ev]<l+tol+10)]
        if len(pool)==0 or len(ref)==0: continue
        if len(pool)>800: pool=pool[rng.choice(len(pool),800,replace=False)]
        best=None;bm=1e9
        for c in pool[:500]:
            m=np.mean([Lev.distance(c,r) for r in pool[:150]])
            if m<bm: bm=m;best=c
        d=np.mean([Lev.distance(best,r) for r in ref])
        tot+=d*len(ref);cnt+=len(ref)
    print(f"tol={tol} length-bucket medoid: {tot/cnt:.2f} (n={cnt})")
EOF
