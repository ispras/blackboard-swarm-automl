import numpy as np, torch, cv2
from torch.utils.data import Dataset

def worker_init_fn(wid):
    seed = torch.initial_seed() % (2**31)
    np.random.seed(seed)

class InChIDataset(Dataset):
    def __init__(self, paths, labels, stoi, size=384, train=True):
        self.paths=paths; self.labels=labels; self.stoi=stoi
        self.size=size; self.train=train
    def __len__(self): return len(self.paths)

    def _img(self, i):
        img=cv2.imread(self.paths[i], cv2.IMREAD_GRAYSCALE)
        h,w=img.shape
        s=self.size/max(h,w)
        nh,nw=max(1,int(round(h*s))),max(1,int(round(w*s)))
        interp=cv2.INTER_AREA if s<1 else cv2.INTER_LINEAR
        img=cv2.resize(img,(nw,nh),interpolation=interp)
        if self.train:
            ang=np.random.uniform(-5,5); sc=np.random.uniform(0.93,1.07)
            M=cv2.getRotationMatrix2D((nw/2,nh/2), ang, sc)
            M[0,2]+=np.random.uniform(-0.03,0.03)*nw
            M[1,2]+=np.random.uniform(-0.03,0.03)*nh
            img=cv2.warpAffine(img,M,(nw,nh),borderValue=255)
            a=np.random.uniform(0.8,1.2); b=np.random.uniform(-25,25)
            img=np.clip(img.astype(np.float32)*a+b,0,255).astype(np.uint8)
        canvas=np.full((self.size,self.size),255,np.uint8)
        canvas[:nh,:nw]=img
        t=torch.from_numpy(canvas).float().div(255).unsqueeze(0)  # [0,1], 1ch
        return t

    def __getitem__(self, i):
        x=self._img(i)
        lab=self.labels[i]
        toks=[self.stoi['<sos>']]+[self.stoi[c] for c in lab]+[self.stoi['<eos>']]
        return x, torch.tensor(toks, dtype=torch.long)

class PadCollate:
    def __init__(self, pad=0): self.pad=pad
    def __call__(self, batch):
        xs=[b[0] for b in batch]; ys=[b[1] for b in batch]
        T=max(y.numel() for y in ys)
        Y=torch.full((len(ys),T), self.pad, dtype=torch.long)
        for i,y in enumerate(ys): Y[i,:y.numel()]=y
        return torch.stack(xs,0), Y
