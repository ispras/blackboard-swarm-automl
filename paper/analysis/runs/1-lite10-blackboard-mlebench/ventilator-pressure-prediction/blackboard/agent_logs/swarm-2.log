import pandas as pd, numpy as np
tr = pd.read_csv('data/train.csv')
te = pd.read_csv('data/test.csv')
print('train shape', tr.shape, 'test', te.shape)
print('unique breaths train', tr.breath_id.nunique(), 'test', te.breath_id.nunique())
print('rows per breath', tr.groupby('breath_id').size().value_counts().to_dict())
print('R', tr.R.unique(), 'C', tr.C.unique())
print(tr.groupby(['R','C']).breath_id.nunique())
print('test R/C'); print(te.groupby(['R','C']).breath_id.nunique())
val = tr[tr.breath_id % 10 == 0].breath_id.nunique()
print('val breaths if id%10==0:', val, 'frac', val/tr.breath_id.nunique())
print('inspiratory frac', (tr.u_out==0).mean())
print('pressure stats', tr.pressure.describe())
# per breath u_out pattern
g=tr.groupby('breath_id').u_out.apply(lambda s:(s==0).sum())
print('insp per breath', g.describe())
EOF
