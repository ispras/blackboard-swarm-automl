import pandas as pd, numpy as np, glob, os, json
from scipy.optimize import minimize
base=pd.read_csv('workspaces/antares_nu/preds/val_seed42_bilstm320.csv')
tr=pd.read_csv('data/train.csv',usecols=['id','u_out','pressure']).set_index('id')
d=base.join(tr,on='id',rsuffix='_t'); ids=d.id.values; y=d.pressure_t.values; insp=(d.u_out.values==0)
bid=pd.read_csv('data/train.csv',usecols=['id','breath_id']).set_index('id').loc[ids].breath_id.values
c={}
for f in glob.glob('workspaces/*/preds/val_seed42*.csv'):
    nm=os.path.basename(f)[:-4]
    if 'smoke' in nm: continue
    v=pd.read_csv(f)
    if len(v)!=len(ids): continue
    v=v.set_index('id').reindex(ids)
    if v.pressure.isna().any(): continue
    c[nm]=v.pressure.values
keys=list(c); Pi=np.stack([c[k][insp] for k in keys],1); yi=y[insp]; bi=bid[insp]
ub=np.unique(bi); rng=np.random.RandomState(0); rng.shuffle(ub)
folds=np.array_split(ub,5); oof=np.zeros(len(yi))
def fitw(P,yy):
    def f(w): return np.abs(P@w-yy).mean()
    best=None
    for s in range(4):
        w0=rng.dirichlet(np.ones(P.shape[1]))
        r=minimize(f,w0,method='SLSQP',bounds=[(0,1)]*P.shape[1],constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':300,'ftol':1e-9})
        if best is None or r.fun<best.fun: best=r
    return best.x
for k in range(5):
    va=np.isin(bi,folds[k]); trn=~va
    w=fitw(Pi[trn],yi[trn])
    oof[va]=Pi[va]@w
print('honest 5-fold breath-grouped blend MAE:',round(np.abs(oof-yi).mean(),5))
# global weights on all
w=fitw(Pi,yi); print('global wmean',round(np.abs(Pi@w-yi).mean(),5))
print({kk:round(float(ww),3) for kk,ww in zip(keys,w) if ww>1e-3})
EOF
