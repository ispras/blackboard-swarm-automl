import pandas as pd, numpy as np, json
from scipy.optimize import minimize
CACHE='workspaces/sirius_tau/cache'; SEQ=80
man=json.load(open('final_solution/code/manifest_final6.json'))
val_idx=np.load(f'{CACHE}/val_idx.npy'); idtr=np.load(f'{CACHE}/id_train.npy')
val_ids=idtr[val_idx].reshape(-1)
tr=pd.read_csv('data/train.csv',usecols=['id','pressure','u_out','R','C','breath_id']).set_index('id')
t=tr.reindex(val_ids); y=t.pressure.values.astype(np.float64); m=(t.u_out.values==0)
bid=t.breath_id.values; R=t.R.values.astype(int); C=t.C.values.astype(int)
step=np.tile(np.arange(SEQ),len(val_idx))
P=np.stack([pd.read_csv(e['val']).drop_duplicates('id').set_index('id').pressure.reindex(val_ids).values for e in man],1)
print('members',P.shape,flush=True)
Pi=P[m]; yi=y[m]; bi=bid[m]; Ri=R[m]; Ci=C[m]; si=step[m]; k=P.shape[1]
# honest 5-fold cross-fitted blend -> OOF
ub=np.unique(bi); np.random.RandomState(0).shuffle(ub); folds=np.array_split(ub,5); foldid=np.zeros(len(bi),int)
for f,bs in enumerate(folds): foldid[np.isin(bi,bs)]=f
oof=np.zeros(len(bi)); wfit=[]
rs=np.random.RandomState(3)
def fitw(Ptr,ytr):
    def o(ww): return np.abs(Ptr@ww-ytr).mean()
    bb=None
    starts=[np.ones(k)/k]+[rs.dirichlet(np.ones(k)) for _ in range(4)]
    single=np.array([o(np.eye(k)[j]) for j in range(k)]); e=np.zeros(k); e[np.argmin(single)]=1; starts.append(e)
    for s in starts:
        r=minimize(o,s,method='SLSQP',bounds=[(0,1)]*k,constraints={'type':'eq','fun':lambda ww:ww.sum()-1},options={'maxiter':500,'ftol':1e-11})
        if bb is None or r.fun<bb.fun: bb=r
    ww=np.clip(bb.x,0,None); return ww/ww.sum()
for f in range(5):
    va=foldid==f; trn=~va
    idx=np.where(trn)[0]
    if len(idx)>180000: idx=rs.choice(idx,180000,replace=False)
    w=fitw(Pi[idx],yi[idx]); wfit.append(w); oof[va]=Pi[va]@w
base=np.abs(oof-yi).mean(); print('honest OOF blend MAE',round(base,6),flush=True)
def cal_eval(name, fitfun):
    pred=np.zeros(len(yi))
    for f in range(5):
        va=foldid==f; trn=~va
        corr=fitfun(trn, va)
        pred[va]=corr
    print(f'{name:38s} MAE={np.abs(pred-yi).mean():.6f}  delta={np.abs(pred-yi).mean()-base:+.6f}',flush=True)
# 0 global median offset
cal_eval('global median offset', lambda trn,va: oof[va]+np.median(yi[trn]-oof[trn]))
# global affine a*p+b (L1)
def gaff(trn,va):
    o=oof[trn]; yy=yi[trn]
    f=lambda ab: np.abs(ab[0]*o+ab[1]-yy).mean()
    r=minimize(f,[1.0,0.0],method='Nelder-Mead',options={'maxiter':200})
    return r.x[0]*oof[va]+r.x[1]
cal_eval('global affine (L1)', gaff)
# per (R,C) median offset with shrinkage
def rc_med(trn,va,kind='rc'):
    if kind=='rc': key_tr=np.stack([Ri[trn],Ci[trn]],1); key_va=np.stack([Ri[va],Ci[va]],1)
    elif kind=='step': key_tr=si[trn][:,None]; key_va=si[va][:,None]
    else: key_tr=np.stack([Ri[trn],Ci[trn],si[trn]],1); key_va=np.stack([Ri[va],Ci[va],si[va]],1)
    df=pd.DataFrame(key_tr); df['r']=yi[trn]-oof[trn]
    g=df.groupby(list(range(key_tr.shape[1])))['r']; med=g.median(); cnt=g.size()
    tbl=(med*cnt/(cnt+200.0))
    d2=pd.DataFrame(key_va); idx=pd.MultiIndex.from_frame(d2)
    add=tbl.reindex(idx).fillna(0.0).values
    return oof[va]+add
cal_eval('per-(R,C) median offset (shrink)', lambda trn,va: rc_med(trn,va,'rc'))
cal_eval('per-step median offset (shrink)', lambda trn,va: rc_med(trn,va,'step'))
cal_eval('per-(R,C,step) median offset (shrink)', lambda trn,va: rc_med(trn,va,'rcs'))
# affine then group offset
def aff_then_rc(trn,va):
    a=gaff(trn,va)  # uses full arrays; recompute on trn only
    o=oof[trn]; yy=yi[trn]
    f=lambda ab: np.abs(ab[0]*o+ab[1]-yy).mean(); r=minimize(f,[1.0,0.0],method='Nelder-Mead',options={'maxiter':200})
    at=oof.copy(); at[va]=r.x[0]*oof[va]+r.x[1]; at[trn]=r.x[0]*oof[trn]+r.x[1]
    df=pd.DataFrame(np.stack([Ri[trn],Ci[trn]],1)); df['r']=yi[trn]-at[trn]
    g=df.groupby([0,1])['r']; med=g.median(); cnt=g.size(); tbl=med*cnt/(cnt+200.0)
    idx=pd.MultiIndex.from_arrays([Ri[va],Ci[va]]); return at[va]+tbl.reindex(idx).fillna(0.0).values
cal_eval('global affine + per-(R,C) offset', aff_then_rc)
EOF
