import pandas as pd, numpy as np, glob, os, json
rec=json.load(open('workspaces/antares_nu/blend_recipe.json'))
models=rec['models']; w=np.array(rec['weights'],float)
sub=pd.read_csv('data/sample_submission.csv')
idv=sub.id.values
def find_test(key):
    if key=='val_seed42_lstm_c2_s21':
        return 'workspaces/antares_nu/preds/test_lstm_c2_s21_full.csv'
    suf=key.replace('val_seed42_pred_','').replace('val_seed42_','')
    cands=glob.glob('workspaces/*/preds/test_*.csv')
    best=None
    for f in cands:
        st=os.path.basename(f)[5:-4]
        if st==suf: return f
        if st.endswith(suf) or suf.endswith(st): best=f
    return best
P=np.zeros(len(idv)); used=[]
for k,wi in zip(models,w):
    if wi<1e-4: continue
    f=find_test(k)
    if f is None or not os.path.exists(f):
        print('MISSING',k); continue
    t=pd.read_csv(f).set_index('id').reindex(idv)
    assert t.pressure.notna().all(), (k,f)
    P+=wi*t.pressure.values; used.append((k,round(float(wi),3),os.path.basename(f)))
# clip
P=np.clip(P,-2.9,65.5)
out=pd.DataFrame({'id':idv,'pressure':P})
out.to_csv('workspaces/antares_nu/submission_candidate.csv',index=False)
print('used:',used)
print('rows',len(out),'nan',out.pressure.isna().sum(),'min/max/mean',out.pressure.min(),out.pressure.max(),out.pressure.mean())
# compare with sirius submission candidates
for f in glob.glob('workspaces/sirius_tau/sub*.csv')+glob.glob('workspaces/dubhe_phi/preds/submission_blend*.csv'):
    try:
        s=pd.read_csv(f).set_index('id').reindex(idv)
        if s.pressure.notna().all():
            print('vs',f,'mean|diff|=',np.abs(s.pressure.values-P).mean(),'max|diff|=',np.abs(s.pressure.values-P).max())
    except Exception as e: print('skip',f,e)
EOF
