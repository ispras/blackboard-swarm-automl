from scipy.optimize import minimize
CACHE='workspaces/sirius_tau/cache'; SEQ=80
man=json.load(open('final_solution/code/manifest_final5.json'))
val_idx=np.load(f'{CACHE}/val_idx.npy'); idtr=np.load(f'{CACHE}/id_train.npy')
val_ids=idtr[val_idx].reshape(-1)
tr=pd.read_csv('data/train.csv',usecols=['id','pressure','u_out','breath_id']).set_index('id')
t=tr.reindex(val_ids); y=t.pressure.values.astype(np.float64); m=(t.u_out.values==0)
bid=t.breath_id.values
def readp(p,ids):
    df=pd.read_csv(p); s=df.drop_duplicates('id').set_index('id')['pressure']
    return s.reindex(ids).values.astype(np.float64)
V=[]; names=[]
for e in man:
    v=readp(e['val'],val_ids)
    assert not np.isnan(v).any(), e['name']
    V.append(v); names.append(e['name'])
P=np.stack(V,1)
# fit multi-start SLSQP on insp
Pi=P[m]; yi=y[m]; rng=np.random.RandomState(1); k=len(names)
def obj(w): return np.abs(Pi@w-yi).mean()
starts=[np.ones(k)/k]+[rng.dirichlet(np.ones(k)) for _ in range(8)]
single=np.array([obj(np.eye(k)[j]) for j in range(k)]); e=np.zeros(k); e[np.argmin(single)]=1; starts.append(e)
best=None
for s in starts:
    r=minimize(obj,s,method='SLSQP',bounds=[(0,1)]*k,constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':600,'ftol':1e-12})
    if best is None or r.fun<best.fun: best=r
w=np.clip(best.x,0,None); w=w/w.sum()
print('fit holdout insp MAE',round(obj(w),5))
print('weights',{n:round(float(x),3) for n,x in zip(names,w) if x>1e-3})
# honest 5-fold breath-grouped CV
ub=np.unique(bid[m]); rng.shuffle? if False else None
rs=np.random.RandomState(0); rs.shuffle(ub); folds=np.array_split(ub,5)
oof=np.zeros(m.sum())
for f in range(5):
    va=np.isin(bid[m],folds[f]); trn=~va
    bb=None
    for s in [np.ones(k)/k]+[rs.dirichlet(np.ones(k)) for _ in range(5)]:
        r=minimize(lambda ww: np.abs(Pi[trn]@ww-yi[trn]).mean(),s,method='SLSQP',bounds=[(0,1)]*k,constraints={'type':'eq','fun':lambda ww:ww.sum()-1},options={'maxiter':500,'ftol':1e-11})
        if bb is None or r.fun<bb.fun: bb=r
    ww=np.clip(bb.x,0,None); ww=ww/ww.sum(); oof[va]=Pi[va]@ww
print('honest 5-fold breath CV insp MAE',round(np.abs(oof-yi).mean(),5))
# test blend from manifest test preds, compare shipped submission on insp rows
sub=pd.read_csv('data/sample_submission.csv'); te=pd.read_csv('data/test.csv',usecols=['id','u_out','breath_id'])
ids=sub.id.values; bl=np.zeros(len(ids))
for e,wi in zip(man,w):
    tp=readp(e['test'],ids); assert not np.isnan(tp).any(), e['test']
    bl+=wi*tp
ship=pd.read_csv('final_solution/submission.csv').set_index('id').reindex(ids).pressure.values
assert not np.isnan(ship).any()
mi=(te.u_out.values==0)
print('shipped vs my recompute (insp rows): corr',round(float(np.corrcoef(bl[mi],ship[mi])[0,1]),7),'mean|d|',round(float(np.abs(bl[mi]-ship[mi]).mean()),5),'max|d|',round(float(np.abs(bl[mi]-ship[mi]).max()),4))
print('shipped insp mean/std',round(float(ship[mi].mean()),4),round(float(ship[mi].std()),4),'my blend insp mean/std',round(float(bl[mi].mean()),4),round(float(bl[mi].std()),4))
