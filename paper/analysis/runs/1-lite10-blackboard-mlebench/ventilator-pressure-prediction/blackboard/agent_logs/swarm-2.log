import pandas as pd, numpy as np, glob, os
tr=pd.read_csv('data/train.csv',usecols=['id','u_out','pressure'])
files={
 'ant_lstm31':'workspaces/antares_nu/preds/val_seed42_bilstm320.csv',
 'ant_tcn':'workspaces/antares_nu/preds/val_seed42_tcn_c2.csv',
 'ant_gru':'workspaces/antares_nu/preds/val_seed42_gru_c2.csv',
 'sir_c2':'workspaces/sirius_tau/preds/val_seed42_c2_lstm384_s42.csv',
}
for f in glob.glob('workspaces/dubhe_phi/preds/val_seed42*_*.csv'):
    name='dub_'+os.path.basename(f).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    files[name]=f
base=tr.set_index('id')
dfs={}
for k,f in files.items():
    if not os.path.exists(f): continue
    v=pd.read_csv(f)
    if len(v)!=543200: 
        print('skip',k,len(v)); continue
    v=v.set_index('id').reindex(base.index)
    dfs[k]=v.pressure.values
y=base.pressure.values; insp=(base.u_out.values==0)
print('n',insp.sum())
for k,p in dfs.items():
    e=np.abs(p-y); print(f'{k:22s} insp={e[insp].mean():.5f} all={e.mean():.5f} nans={np.isnan(p).sum()}')
keys=[k for k in dfs if not np.isnan(dfs[k]).any()]
P=np.stack([dfs[k] for k in keys],1)  # (rows, models)
from scipy.optimize import minimize
def wmae(w):
    return np.abs(P@w - y)[insp].mean()
# subset insp rows for speed
Pi=P[insp]; yi=y[insp]
def f(w):
    return np.abs(Pi@w-yi).mean()
w0=np.ones(len(keys))/len(keys)
res=minimize(f,w0,method='SLSQP',bounds=[(0,1)]*len(keys),constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':200})
print('weights',dict(zip(keys,np.round(res.x,3))),'wmean',res.fun)
print('mean',np.abs(Pi.mean(1)-yi).mean(),'median',np.abs(np.median(Pi,1)-yi).mean())
Ps=np.sort(Pi,1); trim=Ps[:,1:-1].mean(1) if len(keys)>2 else Ps.mean(1)
print('trimmed',np.abs(trim-yi).mean())
EOF
