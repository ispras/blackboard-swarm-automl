import argparse, os, time, json
import numpy as np, pandas as pd, torch, torch.nn as nn
from math import cos, pi
CACHE='workspaces/sirius_tau/cache2'
class Net(nn.Module):
    def __init__(self, nf, hidden, layers, dropout=0.1, arch='lstm'):
        super().__init__()
        self.bn=nn.BatchNorm1d(nf)
        cls=nn.GRU if arch=='gru' else nn.LSTM
        self.rnn=cls(nf,hidden,num_layers=layers,batch_first=True,bidirectional=True,dropout=dropout)
        self.head=nn.Sequential(nn.Linear(hidden*2,256),nn.SiLU(),nn.Dropout(dropout),nn.Linear(256,1))
    def forward(self,x):
        b,t,f=x.shape; x=self.bn(x.reshape(-1,f)).reshape(b,t,f)
        o,_=self.rnn(x); return self.head(o).squeeze(-1)
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--base_tag',required=True)
    ap.add_argument('--tag',required=True)
    ap.add_argument('--hidden',type=int,required=True)
    ap.add_argument('--layers',type=int,default=4)
    ap.add_argument('--arch',type=str,default='lstm')
    ap.add_argument('--epochs',type=int,default=50)
    ap.add_argument('--lr',type=float,default=8e-5)
    ap.add_argument('--batch',type=int,default=512)
    ap.add_argument('--exp_w',type=float,default=0.1)
    a=ap.parse_args()
    out='workspaces/antares_nu'; dev='cuda'
    torch.manual_seed(123); np.random.seed(123)
    t0=time.time()
    X=np.asarray(np.load(f'{CACHE}/X_train.npy'),dtype=np.float32)
    y=np.load(f'{CACHE}/y_train.npy'); idtr=np.load(f'{CACHE}/id_train.npy')
    val_idx=np.load(f'{CACHE}/val_idx.npy')
    vm=np.zeros(len(X),bool); vm[val_idx]=True
    NF=X.shape[2]
    uo=np.ascontiguousarray(X[:,:,1]).copy()
    mu=np.load(f'{out}/cache2_mu.npy'); sd=np.load(f'{out}/cache2_sd.npy')
    X=((X-mu)/sd).astype(np.float32)
    Xt=torch.from_numpy(X[~vm]).to(dev); yt=torch.from_numpy(y[~vm]).to(dev)
    mt=torch.from_numpy((uo[~vm]==0).astype(np.float32)).to(dev)
    wt=torch.where(mt>0,torch.ones_like(mt),torch.full_like(mt,a.exp_w))
    Xv=torch.from_numpy(X[vm]).to(dev); yv=y[vm]; mva=(uo[vm]==0)
    model=Net(NF,a.hidden,a.layers,0.1,a.arch).to(dev)
    model.load_state_dict(torch.load(f'{out}/models/{a.base_tag}.pt',map_location=dev))
    opt=torch.optim.AdamW(model.parameters(),lr=a.lr,weight_decay=1e-4)
    n=len(Xt); steps=int(np.ceil(n/a.batch))
    def predict(Xz,bs=1024):
        model.eval(); o=[]
        with torch.no_grad():
            for i in range(0,len(Xz),bs): o.append(model(Xz[i:i+bs]).float().cpu().numpy())
        return np.concatenate(o,0)
    best=float(np.abs(predict(Xv)-yv)[mva].mean()); best_state={k:v.detach().cpu().clone() for k,v in model.state_dict().items()}
    print('start val',round(best,5),flush=True)
    for ep in range(1,a.epochs+1):
        lr=a.lr*0.5*(1+cos(pi*(ep-1)/a.epochs))
        for g in opt.param_groups: g['lr']=lr
        model.train(); idx=torch.randperm(n,device=dev); tot=0
        for i in range(0,n,a.batch):
            j=idx[i:i+a.batch]; opt.zero_grad(set_to_none=True)
            wb=wt[j]; loss=(torch.abs(model(Xt[j])-yt[j])*wb).sum()/wb.sum().clamp_min(1)
            loss.backward(); torch.nn.utils.clip_grad_norm_(model.parameters(),5.0); opt.step(); tot+=loss.item()*len(j)
        pv=predict(Xv); mae=float(np.abs(pv-yv)[mva].mean())
        if mae<best-1e-6:
            best=mae; best_state={k:v.detach().cpu().clone() for k,v in model.state_dict().items()}
        if ep%5==0 or ep==1: print(f'ep {ep} train {tot/n:.5f} val {mae:.5f} best {best:.5f} lr {lr:.2e} t {time.time()-t0:.0f}s',flush=True)
    model.load_state_dict(best_state); torch.save(model.state_dict(),f'{out}/models/{a.tag}.pt')
    pv=predict(Xv); pd.DataFrame({'id':idtr[vm].reshape(-1),'pressure':pv.reshape(-1)}).to_csv(f'{out}/preds/val_seed42_{a.tag}.csv',index=False)
    print(f'BEST VAL MAE {best:.6f} tag {a.tag}',flush=True)
    te=pd.read_csv('data/test.csv',usecols=['id','breath_id']); mp={b:g['id'].values for b,g in te.groupby('breath_id')}
    tb=np.load(f'{CACHE}/breath_ids_test.npy')
    Xte=((np.asarray(np.load(f'{CACHE}/X_test.npy'),dtype=np.float32)-mu)/sd).astype(np.float32)
    pr=predict(torch.from_numpy(Xte).to(dev)); ids=np.concatenate([mp[b] for b in tb])
    pd.DataFrame({'id':ids,'pressure':pr.reshape(-1)}).to_csv(f'{out}/preds/test_{a.tag}.csv',index=False)
    print('done',a.tag,f'{time.time()-t0:.0f}s',flush=True)
if __name__=='__main__': main()
EOF
