new_model='''class ResBlock(nn.Module):
    def __init__(self, ch, d, dropout):
        super().__init__()
        self.c1 = nn.Conv1d(ch, ch, 3, padding=d, dilation=d)
        self.b1 = nn.BatchNorm1d(ch)
        self.c2 = nn.Conv1d(ch, ch, 3, padding=d, dilation=d)
        self.b2 = nn.BatchNorm1d(ch)
        self.act = nn.GELU()
        self.drop = nn.Dropout(dropout)

    def forward(self, x):
        h = self.drop(self.act(self.b1(self.c1(x))))
        h = self.drop(self.act(self.b2(self.c2(h))))
        return x + h


class Net(nn.Module):
    def __init__(self, nf, hidden=256, layers=1, dropout=0.1, arch='tcn'):
        super().__init__()
        self.inp = nn.Conv1d(nf, hidden, 1)
        ds = [1, 2, 4, 8, 16, 32]
        self.blocks = nn.Sequential(*[ResBlock(hidden, d, dropout) for d in ds])
        self.gru = nn.GRU(hidden, 128, num_layers=2, batch_first=True,
                          bidirectional=True, dropout=dropout)
        self.head = nn.Sequential(
            nn.Linear(256, 128), nn.SiLU(), nn.Dropout(dropout), nn.Linear(128, 1))

    def forward(self, x):
        h = self.inp(x.transpose(1, 2))
        h = self.blocks(h)
        h = h.transpose(1, 2)
        o, _ = self.gru(h)
        return self.head(o).squeeze(-1)


'''
