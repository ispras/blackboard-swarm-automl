[0m$ [0mcd /download_job_code/payload/sandbox && cat > workspaces/antares_nu/blend_all.py <<'EOF'
import pandas as pd, numpy as np, glob, os, json
from scipy.optimize import minimize
base=pd.read_csv('workspaces/antares_nu/preds/val_seed42_bilstm320.csv')
tr=pd.read_csv('data/train.csv',usecols=['id','u_out','pressure']).set_index('id')
d=base.join(tr,on='id',rsuffix='_t')
ids=d.id.values; y=d.pressure_t.values; insp=(d.u_out.values==0)
cands={}
for f in glob.glob('workspaces/*/preds/val_seed42*.csv'):
    nm=os.path.basename(f)[:-4]
    if 'smoke' in nm: continue
    v=pd.read_csv(f)
    if len(v)!=len(ids): continue
    v=v.set_index('id').reindex(ids)
    if v.pressure.isna().any(): continue
    cands[nm]=v.pressure.values
for nm,p in cands.items():
    e=np.abs(p-y); print(f'{nm:34s} insp={e[insp].mean():.5f} all={e.mean():.5f}')
# also key models by tag
keys=list(cands)
Pi=np.stack([cands[k][insp] for k in keys],1); yi=y[insp]
def f(w): return np.abs(Pi@w-yi).mean()
res=minimize(f,np.ones(len(keys))/len(keys),method='SLSQP',bounds=[(0,1)]*len(keys),constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':500,'ftol':1e-9})
print('\\nN',len(keys))
print('weights', {k:round(float(w),3) for k,w in zip(keys,res.x) if w>1e-3})
print('wmean',round(res.fun,5))
print('mean ',round(np.abs(Pi.mean(1)-yi).mean(),5),' median',round(np.abs(np.median(Pi,1)-yi).mean(),5))
Ps=np.sort(Pi,1); print('trim1',round(np.abs(Ps[:,1:-1].mean(1)-yi).mean(),5) if len(keys)>2 else 'na')
# save recipe
json.dump({'models':keys,'weights':[float(x) for x in res.x],'wmean':float(res.fun)},open('workspaces/antares_nu/blend_recipe.json','w'),indent=1)
EOF
