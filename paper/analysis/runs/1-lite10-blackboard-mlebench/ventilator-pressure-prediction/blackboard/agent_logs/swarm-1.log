[0m$ [0mcd /download_job_code/payload/sandbox && cat > workspaces/dubhe_phi/blend.py <<'EOF'
import numpy as np, pandas as pd, glob, os, sys
from scipy.optimize import minimize
D='workspaces/dubhe_phi'; ROOT='.'
SEQ=80

# canonical val ids (seed42)
tr=pd.read_csv('data/train.csv',usecols=['id','breath_id','R','C','time_step','u_out','pressure'])
tr=tr.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
ub=np.sort(tr.breath_id.unique()); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
valb=ub[perm[:int(round(0.1*len(ub)))]]
vmask=tr.breath_id.isin(valb).values
val=tr[vmask].reset_index(drop=True)
val_ids=val.id.values
val_true=val.pressure.values; val_insp=(val.u_out.values==0)
val_RC=val.R.values*1000+val.C.values
val_step=np.tile(np.arange(SEQ),len(val)//SEQ)

te=pd.read_csv('data/test.csv',usecols=['id','breath_id','R','C','time_step'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values; test_RC=te.R.values*1000+te.C.values; test_step=np.tile(np.arange(SEQ),len(te)//SEQ)

# discover models
val_files=sorted(glob.glob('workspaces/*/preds/val_seed42*_*.csv'))
models={}
for vf in val_files:
    base=os.path.basename(vf).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    d='workspaces/'+vf.split('/')[1]+'/preds'
    tfs=glob.glob(f'{d}/test_{base}.csv')+glob.glob(f'{d}/test_pred_{base}.csv')
    if not tfs: 
        # try test file with model tag anywhere
        tfs=glob.glob(f'{d}/test*{base}*.csv')
    if not tfs: print('no test for',base,'in',d); continue
    v=pd.read_csv(vf); t=pd.read_csv(tfs[0])
    # align by id
    vm=v.set_index('id')['pressure'].reindex(val_ids).values
    tm=t.set_index('id')['pressure'].reindex(test_ids).values
    if np.isnan(vm).any() or np.isnan(tm).any():
        print('skip',base,'misaligned',np.isnan(vm).sum(),np.isnan(tm).sum()); continue
    mae=np.abs(vm[val_insp]-val_true[val_insp]).mean()
    models[base]=(vm,tm,mae)
    print(f'{base}: val_insp MAE {mae:.5f}',flush=True)

if not models:
    print('no models found'); sys.exit()
names=list(models.keys())
V=np.stack([models[n][0] for n in names]); T=np.stack([models[n][1] for n in names])
print('models',names,flush=True)

def ev(p, idx=None):
    if idx is None: idx=val_insp
    return float(np.abs(p[idx]-val_true[idx]).mean())

# candidate blends
res={}
res['mean']=V.mean(0); res['median']=np.median(V,0)
Vs=np.sort(V,0); k=len(names)
if k>=3: res['trimmed']=Vs[1:-1].mean(0)
# weight fit (non-negative, sum 1) on insp via scipy
def obj(w):
    w=np.abs(w); w=w/w.sum()
    return ev((w[:,None]*V).sum(0))
x0=np.ones(k)/k
bnds=[(0,1)]*k; cons={'type':'eq','fun':lambda w:w.sum()-1}
opt=minimize(obj,x0,method='SLSQP',bounds=bnds,constraints=cons,options={'maxiter':300})
w=np.abs(opt.x); w=w/w.sum()
res['wmean']= (w[:,None]*V).sum(0)
print('weights',dict(zip(names,np.round(w,3))),flush=True)
# weighted median
def wmedian(A,w):
    order=np.argsort(A,axis=0); As=np.take_along_axis(A,order,axis=0)
    ws=np.broadcast_to(w[:,None],A.shape); Ws=np.take_along_axis(ws,order,axis=0)
    c=np.cumsum(Ws,axis=0); thr=Ws.sum(0,keepdims=True)/2
    idx=(c>=thr).argmax(0)
    return As[idx,np.arange(A.shape[1])]
res['wmedian']=wmedian(V,w)

for kk,p in list(res.items()):
    print(f'{kk}: val {ev(p):.5f}',flush=True)
best=min(res,key=lambda kk:ev(res[kk]))
print('BEST BLEND',best,ev(res[best]),flush=True)

# bias correction by (RC,step) on best blend
P=res[best]
def biascorr(P,apply_to=None):
    key=val_RC.astype(np.int64)*100+val_step
    resid=val_true-P
    df=pd.DataFrame({'key':key[val_insp],'r':resid[val_insp]})
    g=df.groupby('key')['r'].agg(['median','mean','count'])
    shrink=g['count']/(g['count']+200.0)
    corr=(g['median']*shrink).to_dict()
    base=np.zeros_like(P); 
    allkey=(val_RC.astype(np.int64)*100+val_step)
    base=np.array([corr.get(kk,0.0) for kk in allkey])
    return P+base,corr
Pbc,corr=biascorr(P)
print('best+bias',ev(Pbc),flush=True)
if ev(Pbc)<ev(P)-1e-6:
    best='bias'; P=Pbc
    # apply to test
    allkey=test_RC.astype(np.int64)*100+test_step
    Tbest=T.mean(0)  # fallback
    Tfinal=res[best if best in res else 'wmean'] if best in res else None
    print('note: bias uses test keys',flush=True)

# choose test prediction from same recipe
if best in res: Tp=res[best]
else: Tp=res[best]  # Pbc path handled below
# recompute cleanly
if best=='bias':
    # recompute base blend best non-bias
    nb=min([kk for kk in res],key=lambda kk:ev(res[kk]))
    Tbase=res[nb]; allkey=test_RC.astype(np.int64)*100+test_step
    add=np.array([corr.get(kk,0.0) for kk in allkey])
    Tp=Tbase+add
    print('final recipe',nb,'+bias on test',flush=True)
else:
    print('final recipe',best,flush=True)
Tp=np.clip(Tp,-2.0,66.0)
sub=pd.DataFrame({'id':test_ids,'pressure':Tp})
sub.to_csv(f'{D}/preds/submission_blend.csv',index=False)
print('wrote submission_blend.csv',sub.shape,flush=True)
EOF
