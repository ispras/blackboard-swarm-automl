import pandas as pd, numpy as np, json
from scipy.optimize import nnls
fs=pd.read_csv('final_solution/submission.csv')
man=json.load(open('final_solution/code/manifest_final5.json'))
te=pd.read_csv('data/test.csv',usecols=['id','breath_id','time_step','u_out'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values; insp=(te.u_out.values==0)
T=np.stack([pd.read_csv(m['test']).set_index('id')['pressure'].reindex(test_ids).values.astype(np.float64) for m in man])
sub=fs.set_index('id')['pressure'].reindex(test_ids).values.astype(np.float64)
A=T[:,insp].T; b=sub[insp]
w,res=nnls(A,b)
pred=A@w
print('nnls weights',dict(zip([m['name'] for m in man],np.round(w,4))))
print('sum w',w.sum(),'maxabs residual',float(np.abs(pred-b).max()),'meanabs',float(np.abs(pred-b).mean()),'nnls resnorm',float(res))
# also check with cols where w>0 only
print('sub insp mean',float(b.mean()))
EOF
