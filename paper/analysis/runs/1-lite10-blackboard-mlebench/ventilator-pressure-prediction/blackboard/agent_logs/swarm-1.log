import numpy as np, pandas as pd, glob, os, sys, time
import lightgbm as lgb
from sklearn.model_selection import GroupKFold
SEQ=80; D='workspaces/dubhe_phi'; SKIP=('smoke',)
t0=time.time()

tr=pd.read_csv('data/train.csv',usecols=['id','breath_id','R','C','time_step','u_in','u_out','pressure'])
tr=tr.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
ub=np.sort(tr.breath_id.unique()); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
valb=ub[perm[:int(round(0.1*len(ub)))]]
val=tr[tr.breath_id.isin(valb)].reset_index(drop=True)
val_ids=val.id.values; val_breath=val.breath_id.values
val_y=val.pressure.values.astype(np.float32); val_insp=(val.u_out.values==0)
te=pd.read_csv('data/test.csv',usecols=['id','breath_id','R','C','time_step','u_in'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values; test_breath=te.breath_id.values

def feats(df):
    b=df.breath_id.values
    def gc(s):
        # cumsum within breath
        g=df.groupby('breath_id')
        return g[s].cumsum().values
    u=df.u_in.values.astype(np.float32); ts=df.time_step.values.astype(np.float32)
    R=df.R.values.astype(np.float32); C=df.C.values.astype(np.float32)
    step=np.tile(np.arange(SEQ),len(df)//SEQ).astype(np.float32)
    cum=gc('u_in').astype(np.float32)
    F={'u_in':u,'cum':cum,'time':ts,'step':step,'R':R,'C':C,
       'Ru':R*u,'cumC':cum/C,'phys':R*u+cum/C,'invC':1.0/C,'invR':1.0/R}
    return pd.DataFrame(F)
FV=feats(val); FT=feats(te)

# models
models={}
for vf in sorted(glob.glob('workspaces/*/preds/val_seed42*_*.csv')):
    base=os.path.basename(vf).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    if any(s in base for s in SKIP): continue
    agent=vf.split('/')[1]; dd=f'workspaces/{agent}/preds'
    tfs=[f'{dd}/test_{base}.csv']+glob.glob(f'{dd}/test*{base}*.csv')
    tfs=[t for t in tfs if os.path.exists(t)]
    if not tfs: continue
    v=pd.read_csv(vf).set_index('id')['pressure'].reindex(val_ids).values
    t=pd.read_csv(tfs[0]).set_index('id')['pressure'].reindex(test_ids).values
    if np.isnan(v).any() or np.isnan(t).any(): print('skip',base); continue
    models[base]=(v,t); print(base,float(np.abs(v[val_insp]-val_y[val_insp]).mean()),flush=True)
names=list(models.keys()); V=np.stack([models[n][0] for n in names]); T=np.stack([models[n][1] for n in names])

def addpred(dfp, P):
    dfp=dfp.copy()
    for i,n in enumerate(names): dfp['p_'+n]=P[i]
    dfp['p_mean']=P.mean(0); dfp['p_std']=P.std(0); dfp['p_min']=P.min(0); dfp['p_max']=P.max(0); dfp['p_med']=np.median(P,0)
    return dfp
FV2=addpred(FV,V); FT2=addpred(FT,T)
pcols=['p_'+n for n in names]+['p_mean','p_std','p_min','p_max','p_med']
allcols=pcols+['u_in','cum','time','step','R','C','Ru','cumC','phys','invC','invR']

# baseline wmean via SLSQP on insp (global)
from scipy.optimize import minimize
def wfit(P,idx):
    def obj(w):
        w=np.abs(w); w=w/w.sum(); return np.abs((w[:,None]*P)[:,idx]-val_y[idx]).mean()
    k=len(P); o=minimize(obj,np.ones(k)/k,method='SLSQP',bounds=[(0,1)]*k,constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':400})
    w=np.abs(o.x); return w/w.sum()
wg=wfit(V,val_insp)
base_pred=(wg[:,None]*V).sum(0)
base_mae=np.abs(base_pred[val_insp]-val_y[val_insp]).mean()
print('baseline wmean',base_mae,'weights',dict(zip(names,np.round(wg,3))),flush=True)

vi=np.where(val_insp)[0]
def run(cols, tag, n_est=700):
    Xv=FV2.iloc[vi][cols].values.astype(np.float32); yv=val_y[vi]
    groups=val_breath[vi]
    gkf=GroupKFold(n_splits=5)
    oof=np.zeros(len(vi))
    for f,(ti,ei) in enumerate(gkf.split(Xv,yv,groups)):
        m=lgb.LGBMRegressor(n_estimators=n_est,learning_rate=0.05,num_leaves=63,
            min_child_samples=40,subsample=0.8,colsample_bytree=0.8,reg_lambda=1.0,
            n_jobs=4,verbose=-1)
        m.fit(Xv[ti],yv[ti])
        oof[ei]=m.predict(Xv[ei])
    mae=np.abs(oof-yv).mean()
    print(f'{tag}: OOF MAE {mae:.5f}  (vs base {base_mae:.5f})  t={time.time()-t0:.0f}',flush=True)
    return mae,oof

mae_a,_=run(pcols,'LGB basepreds')
mae_b,oof_b=run(allcols,'LGB allfeats')
np.save(f'{D}/preds/stack_oof_all.npy',oof_b)
json_meta={'names':names,'wg':wg.tolist(),'base_mae':float(base_mae),'mae_all':float(mae_b),'mae_base':float(mae_a)}
import json; json.dump(json_meta,open(f'{D}/preds/stack_meta.json','w'))

# if allfeats better than base, fit on all insp and predict test insp
if mae_b < base_mae - 1e-5:
    Xv=FV2.iloc[vi][allcols].values.astype(np.float32); yv=val_y[vi]
    m=lgb.LGBMRegressor(n_estimators=900,learning_rate=0.04,num_leaves=63,min_child_samples=40,
        subsample=0.8,colsample_bytree=0.8,reg_lambda=1.0,n_jobs=4,verbose=-1)
    m.fit(Xv,yv)
    Ttest=np.where(te.u_out.values==0)[0] if 'u_out' in te else None
    # test.csv has no u_out; use time? We know insp = first ~29-32 steps => u_out==0 is all steps before exp.
    # reconstruct u_out from cumulative? test lacks u_out. Use R,C? Actually test.csv HAS no u_out column per header.
    print('test cols',te.columns.tolist(),flush=True)
    Xt=FT2.iloc[Ttest][allcols].values.astype(np.float32) if Ttest is not None else None
    if Xt is not None:
        pt=m.predict(Xt)
        # non-insp: use global wmean of exp-capable? just wmean all
        pfull=(wg[:,None]*T).sum(0)
        pfull[Ttest]=pt
        sub=pd.DataFrame({'id':test_ids,'pressure':np.clip(pfull,-2,66)})
        ss=pd.read_csv('data/sample_submission.csv')
        sub=sub.set_index('id').reindex(ss.id.values).reset_index()
        sub.to_csv(f'{D}/preds/submission_stack.csv',index=False)
        print('wrote submission_stack',sub.shape,flush=True)
else:
    print('stack not better than base',flush=True)
