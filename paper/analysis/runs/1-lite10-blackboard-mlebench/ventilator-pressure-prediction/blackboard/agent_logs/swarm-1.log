import pandas as pd, numpy as np, glob, os
s=pd.read_csv('final_solution/submission.csv')
te=pd.read_csv('data/test.csv')
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
s=s.set_index('id').reindex(te.id.values).reset_index()
p=s.pressure.values; u=te.u_out.values; R=te.R.values; C=te.C.values; st=np.tile(np.arange(80),len(te)//80)
print('all finite',bool(np.isfinite(p).all()),'rows',len(p))
print('insp rows',int((u==0).sum()),'exp rows',int((u==1).sum()))
print('insp mean/std',p[u==0].mean(),p[u==0].std())
print('train-like per RC (insp mean):')
tr=pd.read_csv('data/train.csv',usecols=['R','C','u_out','pressure'])
for r in (5,20,50):
    for c in (10,20,50):
        m=(R==r)&(C==c)&(u==0); t=tr[(tr.R==r)&(tr.C==c)&(tr.u_out==0)].pressure
        print(f'  R{r} C{c}: pred {p[m].mean():.2f} std {p[m].std():.2f} | train {t.mean():.2f} std {t.std():.2f}')
# smoothness across steps
d=np.abs(np.diff(p.reshape(-1,80),axis=1))
print('mean |dp| consecutive steps',float(d.mean()),'p99',float(np.percentile(d,99)),'max',float(d.max()))
# compare to sirius sub_final6 if exists
f=glob.glob('workspaces/sirius_tau/sub_final6.csv')+glob.glob('workspaces/sirius_tau/sub_final5.csv')
for ff in f:
    o=pd.read_csv(ff).set_index('id').pressure.reindex(te.id.values).values
    print('vs',os.path.basename(ff),'maxabs',float(np.abs(o-p).max()),'meanabs',float(np.abs(o-p).mean()))
EOF
