import numpy as np, pandas as pd, glob, os, sys
from scipy.optimize import minimize
D='workspaces/dubhe_phi'; SEQ=80
SKIP=('smoke','smoke_tcn')

tr=pd.read_csv('data/train.csv',usecols=['id','breath_id','R','C','u_out','pressure'])
tr=tr.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
ub=np.sort(tr.breath_id.unique()); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
valb=ub[perm[:int(round(0.1*len(ub)))]]
val=tr[tr.breath_id.isin(valb)].reset_index(drop=True)
val_ids=val.id.values; val_true=val.pressure.values; val_insp=(val.u_out.values==0)
val_key=val.R.values.astype(np.int64)*1000+val.C.values
val_step=np.tile(np.arange(SEQ),len(val)//SEQ); val_ck=val_key*100+val_step

te=pd.read_csv('data/test.csv',usecols=['id','breath_id','R','C','time_step'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values
test_ck=(te.R.values.astype(np.int64)*1000+te.C.values)*100+np.tile(np.arange(SEQ),len(te)//SEQ)

models={}
for vf in sorted(glob.glob('workspaces/*/preds/val_seed42*_*.csv')):
    base=os.path.basename(vf).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    if any(s in base for s in SKIP): continue
    agent=vf.split('/')[1]; d=f'workspaces/{agent}/preds'
    tfs=[f'{d}/test_{base}.csv',f'{d}/test_pred_{base}.csv']
    tfs=[t for t in tfs if os.path.exists(t)] or glob.glob(f'{d}/test*{base}*.csv')
    if not tfs: print('no test for',base); continue
    v=pd.read_csv(vf).set_index('id')['pressure'].reindex(val_ids).values
    t=pd.read_csv(tfs[0]).set_index('id')['pressure'].reindex(test_ids).values
    if np.isnan(v).any() or np.isnan(t).any(): print('skip misaligned',base); continue
    mae=np.abs(v[val_insp]-val_true[val_insp]).mean()
    models[base]=(v,t,mae); print(f'{base}: val_insp MAE {mae:.5f}',flush=True)
if not models: print('none'); sys.exit()
names=list(models.keys()); V=np.stack([models[n][0] for n in names]); T=np.stack([models[n][1] for n in names])
k=len(names)
def ev(p,idx=val_insp): return float(np.abs(p[idx]-val_true[idx]).mean())
res={}
res['mean']=V.mean(0); res['median']=np.median(V,0)
if k>=3:
    Vs=np.sort(V,0); res['trimmed']=Vs[1:-1].mean(0)
def obj(w):
    w=np.abs(w); w=w/w.sum(); return ev((w[:,None]*V).sum(0))
opt=minimize(obj,np.ones(k)/k,method='SLSQP',bounds=[(0,1)]*k,
             constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':500})
w=np.abs(opt.x); w=w/w.sum(); res['wmean']=(w[:,None]*V).sum(0)
def wmedian(A,w):
    o=np.argsort(A,axis=0); As=np.take_along_axis(A,o,axis=0)
    Ws=np.take_along_axis(np.broadcast_to(w[:,None],A.shape),o,axis=0)
    idx=(np.cumsum(Ws,axis=0)>=Ws.sum(0,keepdims=True)/2).argmax(0)
    return As[idx,np.arange(A.shape[1])]
res['wmedian']=wmedian(V,w)
print('weights',dict(zip(names,np.round(w,3))),flush=True)
for kk in res: print(f'{kk}: val {ev(res[kk]):.5f}',flush=True)
best=min(res,key=lambda kk:ev(res[kk])); bestP=res[best]; bestT=None
# map test of chosen recipe
if best=='wmean': bestT=(w[:,None]*T).sum(0)
elif best=='wmedian': bestT=wmedian(T,w)
elif best=='mean': bestT=T.mean(0)
elif best=='median': bestT=np.median(T,0)
else:
    Ts=np.sort(T,0); bestT=Ts[1:-1].mean(0)
# bias correction per (R,C,step)
resid=val_true-bestP
df=pd.DataFrame({'key':val_ck[val_insp],'r':resid[val_insp]})
g=df.groupby('key')['r'].agg(['median','mean','count'])
shrink=(g['count']/(g['count']+200.0))
corr_med=(g['median']*shrink); corr_mean=(g['mean']*shrink)
addv_med=np.array([corr_med.get(x,0.0) for x in val_ck])
addt_med=np.array([corr_med.get(x,0.0) for x in test_ck])
addv_mean=np.array([corr_mean.get(x,0.0) for x in val_ck])
addt_mean=np.array([corr_mean.get(x,0.0) for x in test_ck])
cands={'raw':(ev(bestP),bestT),'bias_med':(ev(bestP+addv_med),bestT+addt_med),
       'bias_mean':(ev(bestP+addv_mean),bestT+addt_mean)}
for kk,(e,_) in cands.items(): print(f'{best}+{kk}: val {e:.5f}',flush=True)
bk=min(cands,key=lambda kk:cands[kk][0]); fe,fT=cands[bk]
print('FINAL',best,'+',bk,'val',fe,flush=True)
fT=np.clip(fT,-2.0,66.0)
out=pd.DataFrame({'id':test_ids,'pressure':fT}); out.to_csv(f'{D}/preds/submission_blend.csv',index=False)
print('wrote',out.shape,flush=True)
EOF
