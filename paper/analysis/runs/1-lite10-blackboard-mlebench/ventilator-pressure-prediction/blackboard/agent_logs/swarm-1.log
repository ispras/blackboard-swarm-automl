import numpy as np, torch, torch.nn as nn, argparse, time, json, os
from contextlib import nullcontext
from torch.utils.data import TensorDataset, DataLoader

p=argparse.ArgumentParser()
p.add_argument('--fold',type=int,default=0)
p.add_argument('--split',type=str,default='fold',choices=['fold','seed42','full'])
p.add_argument('--model',type=str,default='lstm',choices=['lstm','gru','transformer','cnn_lstm'])
p.add_argument('--epochs',type=int,default=130)
p.add_argument('--hidden',type=int,default=384)
p.add_argument('--layers',type=int,default=4)
p.add_argument('--bs',type=int,default=512)
p.add_argument('--lr',type=float,default=1.5e-3)
p.add_argument('--wd',type=float,default=1e-5)
p.add_argument('--seed',type=int,default=0)
p.add_argument('--dropout',type=float,default=0.1)
p.add_argument('--unscored_w',type=float,default=0.1)
p.add_argument('--tag',type=str,default='v2')
p.add_argument('--patience',type=int,default=30)
p.add_argument('--data',type=str,default='workspaces/dubhe_phi/data2.npz')
a=p.parse_args()
torch.manual_seed(a.seed); np.random.seed(a.seed)
dev='cuda'; D='workspaces/dubhe_phi'; SEQ=80
def ac():
    return torch.autocast('cuda',dtype=torch.bfloat16) if a.model in ('lstm','gru') else nullcontext()
d=np.load(a.data)
X=d['Xtr']; y=d['ytr']; folds=d['folds']; seed42=d['seed42']; Xte=d['Xte']; btr=d['btr']
F=X.shape[2]
if a.split=='fold':
    tri=np.where(folds!=a.fold)[0]; vai=np.where(folds==a.fold)[0]
elif a.split=='seed42':
    tri=np.where(~seed42)[0]; vai=np.where(seed42)[0]
else:
    tri=np.arange(len(X)); vai=np.where(seed42)[0]
print(f'{a.tag} split={a.split} fold={a.fold} train {len(tri)} val {len(vai)} F={F}',flush=True)

class LSTMNet(nn.Module):
    def __init__(self,nf,h,layers,drop,rnn='lstm'):
        super().__init__()
        cls=nn.LSTM if rnn=='lstm' else nn.GRU
        self.rnn=cls(nf,h,layers,batch_first=True,bidirectional=True,dropout=drop if layers>1 else 0)
        self.head=nn.Sequential(nn.Linear(h*2,h),nn.GELU(),nn.Dropout(drop),nn.Linear(h,1))
    def forward(self,x):
        o,_=self.rnn(x); return self.head(o).squeeze(-1)

class CNNLSTM(nn.Module):
    def __init__(self,nf,h,layers,drop):
        super().__init__()
        ch=min(h,256)
        self.conv=nn.Sequential(
            nn.Conv1d(nf,ch,5,padding=2),nn.GELU(),nn.BatchNorm1d(ch),
            nn.Conv1d(ch,ch,5,padding=2),nn.GELU(),nn.BatchNorm1d(ch),
            nn.Conv1d(ch,ch,3,padding=1),nn.GELU(),nn.BatchNorm1d(ch))
        self.rnn=nn.LSTM(ch,h,max(2,layers-1),batch_first=True,bidirectional=True,dropout=drop)
        self.head=nn.Sequential(nn.Linear(h*2,h),nn.GELU(),nn.Dropout(drop),nn.Linear(h,1))
    def forward(self,x):
        z=self.conv(x.transpose(1,2)).transpose(1,2)
        o,_=self.rnn(z); return self.head(o).squeeze(-1)

class TransformerNet(nn.Module):
    def __init__(self,nf,h,layers,drop):
        super().__init__()
        self.proj=nn.Linear(nf,h); self.pos=nn.Parameter(torch.zeros(1,SEQ,h))
        nn.init.trunc_normal_(self.pos,std=0.02)
        self.enc=nn.TransformerEncoder(nn.TransformerEncoderLayer(h,8,h*4,drop,batch_first=True,activation='gelu',norm_first=True),layers)
        self.norm=nn.LayerNorm(h)
        self.head=nn.Sequential(nn.Linear(h,h),nn.GELU(),nn.Dropout(drop),nn.Linear(h,1))
    def forward(self,x):
        z=self.proj(x)+self.pos[:,:x.size(1)]; z=self.norm(self.enc(z))
        return self.head(z).squeeze(-1)

if a.model=='transformer': model=TransformerNet(F,a.hidden,a.layers,a.dropout).to(dev)
elif a.model=='cnn_lstm': model=CNNLSTM(F,a.hidden,a.layers,a.dropout).to(dev)
else: model=LSTMNet(F,a.hidden,a.layers,a.dropout,a.model).to(dev)
print('params',sum(p.numel() for p in model.parameters()),flush=True)
opt=torch.optim.AdamW(model.parameters(),lr=a.lr,weight_decay=a.wd)
nb=(len(tri)+a.bs-1)//a.bs
sched=torch.optim.lr_scheduler.OneCycleLR(opt,max_lr=a.lr,total_steps=a.epochs*nb,pct_start=0.1)
uo=list(d['feats']).index('u_out')
mtr=(X[tri][...,uo]==0)
