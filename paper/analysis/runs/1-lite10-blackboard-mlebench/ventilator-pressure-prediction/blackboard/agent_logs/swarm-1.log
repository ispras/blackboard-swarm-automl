import pandas as pd, numpy as np, os, json, time
from sklearn.model_selection import GroupKFold
OUT='workspaces/dubhe_phi'; SEQ=80; t0=time.time()

def build(df,is_train):
    df=df.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
    n=len(df)//SEQ
    bid=df['breath_id'].values[::SEQ]
    u_in=df['u_in'].values.reshape(n,SEQ).astype(np.float32)
    u_out=df['u_out'].values.reshape(n,SEQ).astype(np.float32)
    ts=df['time_step'].values.reshape(n,SEQ).astype(np.float32)
    R=df['R'].values.reshape(n,SEQ)[:,:1].astype(np.float32)
    C=df['C'].values.reshape(n,SEQ)[:,:1].astype(np.float32)
    f={}
    f['u_in']=u_in; f['u_out']=u_out; f['time_step']=ts
    f['step']=np.broadcast_to(np.arange(SEQ,dtype=np.float32),(n,SEQ)).copy()
    dt=np.empty_like(ts); dt[:,0]=ts[:,0]; dt[:,1:]=ts[:,1:]-ts[:,:-1]; f['dt']=dt
    f['R']=np.broadcast_to(R,(n,SEQ)).copy(); f['C']=np.broadcast_to(C,(n,SEQ)).copy()
    f['RC']=(R*C).repeat(SEQ,axis=1); f['R_plus_C']=(R+C).repeat(SEQ,axis=1)
    f['R_div_C']=(R/C).repeat(SEQ,axis=1)
    udt=u_in*dt
    vol=np.cumsum(udt,axis=1)
    cum=np.cumsum(u_in,axis=1)
    f['u_in_cumsum']=cum
    f['u_in_cummean']=cum/(np.arange(SEQ,dtype=np.float32)+1)
    f['u_in_cummax']=np.maximum.accumulate(u_in,axis=1)
    f['u_in_cummin']=np.minimum.accumulate(u_in,axis=1)
    f['u_in_cumsum_dt']=cum*dt
    f['vol']=vol
    f['vol_over_C']=vol/C
    f['R_times_u_in']=R*u_in
    f['phys_pressure']=R*u_in+vol/C
    f['u_in_over_C']=u_in/C; f['u_in_over_RC']=u_in/(R*C)
    f['u_in_sq']=u_in**2; f['time_u_in']=ts*u_in
    tot=vol[:,-1:].copy(); tot[tot<1e-6]=1
    f['tot_vol']=np.broadcast_to(tot,(n,SEQ)).copy()
    f['cum_frac']=vol/tot
    umax=u_in.max(1,keepdims=True); umax[umax<1e-6]=1
    f['u_in_frac']=u_in/umax
    def rollmean(a,w):
        c=np.cumsum(np.pad(a,((0,0),(w,w)),mode='edge'),axis=1)
        return (c[:,2*w:]-c[:,:-2*w])/(2*w+1)
    def rollstd(a,w):
        m=rollmean(a,w); m2=rollmean(a*a,w); return np.sqrt(np.maximum(m2-m*m,0))
    for w in (3,5):
        f[f'u_in_roll_mean{w}']=rollmean(u_in,w); f[f'u_in_roll_std{w}']=rollstd(u_in,w)
    for k in (1,2,3,4,6):
        lag=np.empty_like(u_in); lag[:,:k]=u_in[:,:1]; lag[:,k:]=u_in[:,:-k]; f[f'u_in_lag{k}']=lag
    for k in (1,2,3):
        le=np.empty_like(u_in); le[:,-k:]=u_in[:,-1:]; le[:,:-k]=u_in[:,k:]; f[f'u_in_lead{k}']=le
    d1=np.empty_like(u_in); d1[:,0]=0; d1[:,1:]=u_in[:,1:]-u_in[:,:-1]
    d2=np.empty_like(u_in); d2[:,0]=0; d2[:,1:]=d1[:,1:]-d1[:,:-1]
    f['u_in_diff1']=d1; f['u_in_diff2']=d2
    for v in (5,20,50): f[f'R_{v}']=np.broadcast_to((R==v).astype(np.float32),(n,SEQ)).copy()
    for v in (10,20,50): f[f'C_{v}']=np.broadcast_to((C==v).astype(np.float32),(n,SEQ)).copy()
    names=list(f.keys()); X=np.stack([f[k] for k in names],axis=-1).astype(np.float32)
    y=df['pressure'].values.reshape(n,SEQ).astype(np.float32) if is_train else None
    ids=df['id'].values.reshape(n,SEQ) if not is_train else None
    return X,y,bid,names,ids

if __name__=='__main__':
    tr=pd.read_csv('data/train.csv'); te=pd.read_csv('data/test.csv')
    Xtr,ytr,btr,names,_=build(tr,True)
    Xte,_,bte,names2,idte=build(te,False)
    assert names==names2
    print('shapes',Xtr.shape,Xte.shape,'nfeat',len(names),flush=True)
    mu=Xtr.reshape(-1,len(names)).mean(0); sd=Xtr.reshape(-1,len(names)).std(0); sd[sd<1e-6]=1
    Xtr=(Xtr-mu)/sd; Xte=(Xte-mu)/sd
    gkf=GroupKFold(n_splits=5); folds=np.zeros(len(btr),dtype=np.int8)
    for k,(_,vi) in enumerate(gkf.split(btr,btr,btr)): folds[vi]=k
    ub=np.sort(np.unique(btr)); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
    val_b=ub[perm[:int(round(0.1*len(ub)))]]
    seed42=np.isin(btr,val_b)
    np.savez_compressed(f'{OUT}/data2.npz',Xtr=Xtr,ytr=ytr,btr=btr,Xte=Xte,bte=bte,idte=idte,
        folds=folds,seed42=seed42,mu=mu,sd=sd,feats=np.array(names))
    open(f'{OUT}/feature_names2.txt','w').write('\n'.join(names))
    print('saved data2', 'seed42',seed42.sum(),'folds',np.bincount(folds),'t',time.time()-t0,flush=True)
