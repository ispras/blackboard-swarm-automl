import numpy as np, torch, torch.nn as nn, argparse, time, json, os, math
from torch.utils.data import TensorDataset, DataLoader

p=argparse.ArgumentParser()
p.add_argument('--fold',type=int,default=0)
p.add_argument('--model',type=str,default='transformer')
p.add_argument('--epochs',type=int,default=110)
p.add_argument('--hidden',type=int,default=256)
p.add_argument('--layers',type=int,default=3)
p.add_argument('--bs',type=int,default=512)
p.add_argument('--lr',type=float,default=1.5e-3)
p.add_argument('--wd',type=float,default=1e-5)
p.add_argument('--seed',type=int,default=1)
p.add_argument('--dropout',type=float,default=0.15)
p.add_argument('--unscored_w',type=float,default=0.1)
p.add_argument('--full',action='store_true')
p.add_argument('--tag',type=str,default='arch')
p.add_argument('--patience',type=int,default=25)
a=p.parse_args()
torch.manual_seed(a.seed); np.random.seed(a.seed)
dev='cuda'; D='workspaces/dubhe_phi'
d=np.load(f'{D}/data.npz')
X=d['Xtr']; y=d['ytr']; m=d['mtr']; folds=d['folds']; Xte=d['Xte']; idte=d['idte']
F=X.shape[2]
if a.full: tri=np.arange(len(X)); vai=np.arange(len(X))
else: tri=np.where(folds!=a.fold)[0]; vai=np.where(folds==a.fold)[0]
print(f'fold {a.fold} {a.model} train {len(tri)} val {len(vai)} F={F}',flush=True)

class Transformer(nn.Module):
    def __init__(self,inp,h,layers,drop):
        super().__init__()
        self.proj=nn.Linear(inp,h)
        enc=nn.TransformerEncoderLayer(h,8,h*4,drop,batch_first=True,activation='gelu',norm_first=True)
        self.enc=nn.TransformerEncoder(enc,layers)
        self.pos=nn.Parameter(torch.zeros(1,80,h))
        nn.init.trunc_normal_(self.pos,std=0.02)
        self.head=nn.Sequential(nn.LayerNorm(h),nn.Linear(h,128),nn.GELU(),nn.Dropout(drop),nn.Linear(128,1))
    def forward(self,x):
        z=self.proj(x)+self.pos[:,:x.size(1)]
        z=self.enc(z)
        return self.head(z).squeeze(-1)

class GRUNet(nn.Module):
    def __init__(self,inp,h,layers,drop):
        super().__init__()
        self.gru=nn.GRU(inp,h,num_layers=layers,batch_first=True,bidirectional=True,
                        dropout=drop if layers>1 else 0)
        self.head=nn.Sequential(nn.Linear(h*2,128),nn.GELU(),nn.Dropout(drop),nn.Linear(128,1))
    def forward(self,x):
        o,_=self.gru(x); return self.head(o).squeeze(-1)

class CNNGRU(nn.Module):
    def __init__(self,inp,h,layers,drop):
        super().__init__()
        self.conv=nn.Sequential(
            nn.Conv1d(inp,h,5,padding=2),nn.GELU(),nn.BatchNorm1d(h),
            nn.Conv1d(h,h,5,padding=2),nn.GELU(),nn.BatchNorm1d(h))
        self.gru=nn.GRU(h,h,num_layers=max(2,layers-1),batch_first=True,bidirectional=True,
                        dropout=drop if layers>2 else 0)
        self.head=nn.Sequential(nn.Linear(h*2,128),nn.GELU(),nn.Dropout(drop),nn.Linear(128,1))
    def forward(self,x):
        z=self.conv(x.transpose(1,2)).transpose(1,2)
        o,_=self.gru(z); return self.head(o).squeeze(-1)

M={'transformer':Transformer,'gru':GRUNet,'cnn_gru':CNNGRU}
model=M[a.model](F,a.hidden,a.layers,a.dropout).to(dev)
opt=torch.optim.AdamW(model.parameters(),lr=a.lr,weight_decay=a.wd)
sched=torch.optim.lr_scheduler.OneCycleLR(opt,max_lr=a.lr,total_steps=a.epochs*((len(tri)+a.bs-1)//a.bs),pct_start=0.1)
ds=TensorDataset(torch.from_numpy(X[tri]),torch.from_numpy(y[tri]),torch.from_numpy(m[tri]))
dl=DataLoader(ds,batch_size=a.bs,shuffle=True,num_workers=4,pin_memory=True,drop_last=True)
Xva=torch.from_numpy(X[vai]).to(dev); yva=torch.from_numpy(y[vai]).to(dev); mva=torch.from_numpy(m[vai]).to(dev)
w=torch.where(mva,torch.tensor(1.0,device=dev),torch.tensor(a.unscored_w,device=dev))
def predict(Xar,bs=1024):
    model.eval(); outs=[]
    with torch.no_grad(), torch.autocast('cuda',dtype=torch.bfloat16):
        for i in range(0,len(Xar),bs): outs.append(model(Xar[i:i+bs]).float())
    return torch.cat(outs)
best=1e9; best_state=None; bad=0
for ep in range(a.epochs):
    model.train(); t0=time.time(); tot=0; n=0
    for xb,yb,mb in dl:
        xb=xb.to(dev,non_blocking=True); yb=yb.to(dev,non_blocking=True); mb=mb.to(dev,non_blocking=True)
        opt.zero_grad()
        with torch.autocast('cuda',dtype=torch.bfloat16):
            pred=model(xb)
            wb=torch.where(mb,torch.tensor(1.0,device=dev),torch.tensor(a.unscored_w,device=dev))
            loss=(torch.abs(pred-yb)*wb).sum()/wb.sum()
        loss.backward(); torch.nn.utils.clip_grad_norm_(model.parameters(),1.0); opt.step(); sched.step()
        tot+=loss.item()*len(xb); n+=len(xb)
    if a.full:
        if ep%10==0 or ep==a.epochs-1: print(f'ep {ep} loss {tot/n:.4f} t {time.time()-t0:.1f}',flush=True)
        continue
    with torch.no_grad(), torch.autocast('cuda',dtype=torch.bfloat16): pv=model(Xva).float()
    mae_s=((pv-yva).abs()*mva).sum()/mva.sum()
    if mae_s.item()<best:
        best=mae_s.item(); best_state={k:v.detach().cpu().clone() for k,v in model.state_dict().items()}; bad=0
    else: bad+=1
    if ep%5==0 or bad==0: print(f'ep {ep} loss {tot/n:.4f} valMAE {mae_s.item():.5f} best {best:.5f} bad {bad} t {time.time()-t0:.1f}',flush=True)
    if bad>=a.patience: print('early stop',flush=True); break
os.makedirs(f'{D}/models',exist_ok=True)
if not a.full:
    model.load_state_dict(best_state)
    torch.save(best_state,f'{D}/models/{a.tag}_f{a.fold}_s{a.seed}.pt')
    json.dump({'fold':a.fold,'seed':a.seed,'val_mae':best,'hidden':a.hidden,'layers':a.layers,'model':a.model,
               'epochs':a.epochs,'dropout':a.dropout,'tag':a.tag},open(f'{D}/models/{a.tag}_f{a.fold}_s{a.seed}.json','w'))
    np.save(f'{D}/models/{a.tag}_f{a.fold}_s{a.seed}_valpred.npy',predict(Xva).cpu().numpy())
pt=predict(torch.from_numpy(Xte).to(dev)).cpu().numpy()
np.save(f'{D}/models/{a.tag}_f{a.fold}_s{a.seed}_testpred.npy',pt)
print('BEST',best,'done',flush=True)
EOF
