    df=df.copy()
    g=df.groupby('breath_id')
    df['time_diff']=g['time_step'].diff().fillna(0).astype(np.float32)
    df['u_in_cumsum']=g['u_in'].cumsum().astype(np.float32)
    df['cnt']=g.cumcount()+1
    df['u_in_cummean']=(df['u_in_cumsum']/df['cnt']).astype(np.float32)
    for lag in [1,2,3,4]:
        df[f'u_in_lag{lag}']=g['u_in'].shift(lag).fillna(0).astype(np.float32)
    for lead in [1,2]:
        df[f'u_in_lead{lead}']=g['u_in'].shift(-lead).fillna(0).astype(np.float32)
    df['u_in_diff1']=(df['u_in']-df['u_in_lag1']).astype(np.float32)
    df['u_in_diff2']=(df['u_in']-df['u_in_lag2']).astype(np.float32)
    df['u_in_cummax']=g['u_in'].cummax().astype(np.float32)
    df['u_in_cummin']=g['u_in'].cummin().astype(np.float32)
    # physically motivated
    df['R_u_in']=(df['R']*df['u_in']).astype(np.float32)
    df['vol_over_C']=(df['u_in_cumsum']/df['C']).astype(np.float32)
    df['R_vol_over_C']=(df['R']*df['u_in_cumsum']/df['C']).astype(np.float32)
    df['u_in_sq']=(df['u_in']**2).astype(np.float32)
    df['time_u_in']=(df['time_step']*df['u_in']).astype(np.float32)
    # one-hots
    for r in [5,20,50]: df[f'R_{r}']=(df['R']==r).astype(np.float32)
    for c in [10,20,50]: df[f'C_{c}']=(df['C']==c).astype(np.float32)
    df['RC']=(df['R']*df['C']).astype(np.float32)
    df['R_div_C']=(df['R'].astype(np.float32)/df['C']).astype(np.float32)
    return df

FEATS=['R','C','u_in','u_out','time_step','time_diff','u_in_cumsum','u_in_cummean',
 'u_in_lag1','u_in_lag2','u_in_lag3','u_in_lag4','u_in_lead1','u_in_lead2',
 'u_in_diff1','u_in_diff2','u_in_cummax','u_in_cummin','R_u_in','vol_over_C',
 'R_vol_over_C','u_in_sq','time_u_in','R_5','R_20','R_50','C_10','C_20','C_50','RC','R_div_C']

def to_arrays(df, is_train):
    df=fe(df)
    b=df['breath_id'].values
    # assumes all breaths have 80 rows and are contiguous
    n=len(df)//80
    X=df[FEATS].values.astype(np.float32).reshape(n,80,len(FEATS))
    bids=df['breath_id'].values.reshape(n,80)[:,0]
    if is_train:
        y=df['pressure'].values.astype(np.float32).reshape(n,80)
        mask=(df['u_out'].values==0).reshape(n,80)
        return X,y,mask,bids
    ids=df['id'].values.reshape(n,80)
    return X,bids,ids

if __name__=='__main__':
    tr=pd.read_csv('data/train.csv')
    te=pd.read_csv('data/test.csv')
    Xtr,ytr,mtr,btr=to_arrays(tr,True)
    Xte,bte,idte=to_arrays(te,False)
    print(Xtr.shape,Xte.shape,'feats',len(FEATS))
    # global scaler on train
    mu=Xtr.reshape(-1,len(FEATS)).mean(0)
    sd=Xtr.reshape(-1,len(FEATS)).std(0); sd[sd<1e-6]=1
    Xtr=(Xtr-mu)/sd; Xte=(Xte-mu)/sd
    # 5-fold group split by breath id
    gkf=GroupKFold(n_splits=5)
    folds=np.zeros(len(btr),dtype=np.int8)
    for f,(_,vi) in enumerate(gkf.split(btr,btr,btr)):
        folds[vi]=f
    np.savez_compressed(f'{OUT}/data.npz',Xtr=Xtr,ytr=ytr,mtr=mtr,btr=btr,
        Xte=Xte,bte=bte,idte=idte,folds=folds,feats=np.array(FEATS))
    json.dump({'mu':mu.tolist(),'sd':sd.tolist(),'feats':FEATS},open(f'{OUT}/scaler.json','w'))
    print('saved. folds',np.bincount(folds),'pos steps',mtr.sum())
