import numpy as np, pandas as pd, glob, os, time
from scipy.optimize import minimize
SEQ=80; D='workspaces/dubhe_phi'; SKIP=('smoke',); t0=time.time()
tr=pd.read_csv('data/train.csv',usecols=['id','breath_id','R','C','time_step','u_out','pressure'])
tr=tr.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
ub=np.sort(tr.breath_id.unique()); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
valb=ub[perm[:int(round(0.1*len(ub)))]]
val=tr[tr.breath_id.isin(valb)].reset_index(drop=True)
val_ids=val.id.values; val_y=val.pressure.values.astype(np.float32); val_insp=(val.u_out.values==0)
val_breath=val.breath_id.values; val_RC=val.R.values.astype(np.int64)*1000+val.C.values
val_step=np.tile(np.arange(SEQ),len(val)//SEQ)
te=pd.read_csv('data/test.csv',usecols=['id','breath_id','R','C','time_step','u_out'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values
test_RC=te.R.values.astype(np.int64)*1000+te.C.values; test_step=np.tile(np.arange(SEQ),len(te)//SEQ)

models={}
for vf in sorted(glob.glob('workspaces/*/preds/val_seed42*_*.csv')):
    base=os.path.basename(vf).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    if any(s in base for s in SKIP): continue
    agent=vf.split('/')[1]; dd=f'workspaces/{agent}/preds'
    tfs=[f'{dd}/test_{base}.csv']+glob.glob(f'{dd}/test*{base}*.csv')
    tfs=[t for t in tfs if os.path.exists(t)]
    if not tfs: continue
    v=pd.read_csv(vf).set_index('id')['pressure'].reindex(val_ids).values
    t=pd.read_csv(tfs[0]).set_index('id')['pressure'].reindex(test_ids).values
    if np.isnan(v).any() or np.isnan(t).any(): continue
    models[base]=(v.astype(np.float32),t.astype(np.float32))
    print(base,'single',float(np.abs(v[val_insp]-val_y[val_insp]).mean()),flush=True)
names=list(models.keys()); V=np.stack([models[n][0] for n in names]); T=np.stack([models[n][1] for n in names]); k=len(names)
vi=np.where(val_insp)[0]; Vs=V[:,vi]; ys=val_y[vi]; bs=val_breath[vi]; cks=(val_RC*100+val_step)[vi]
testv=np.where(te.u_out.values==0)[0]; Ts=T[:,testv]; ckt=(test_RC*100+test_step)[testv]
def mae(p,y): return float(np.abs(p-y).mean())

def fit_w(P,y,starts=6,seed=0):
    r=np.random.RandomState(seed); best=(1e9,None)
    inits=[np.ones(P.shape[0])/P.shape[0]]
    for _ in range(starts-1): inits.append(r.dirichlet(np.ones(P.shape[0])))
    for x0 in inits:
        def obj(w):
            w=np.abs(w); s=w.sum(); 
            if s<1e-9: return 1e9
            w=w/s; return np.abs(w@P-y).mean()
        o=minimize(obj,x0,method='SLSQP',bounds=[(0,1)]*P.shape[0],
                   constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':200,'ftol':1e-9})
        w=np.abs(o.x); w=w/w.sum(); f=obj(w)
        if f<best[0]: best=(f,w)
    return best[1],best[0]

# honest cross-fitted comparison across recipes
from sklearn.model_selection import GroupKFold
gkf=GroupKFold(n_splits=5); folds=list(gkf.split(Vs.T,ys,bs))
recipes={}
# non-fit recipes
for nm,fn in [('mean',lambda P:P.mean(0)),('median',lambda P:np.median(P,0))]:
    oof=np.zeros(len(ys))
    for ti,ei in folds: oof[ei]=fn(Vs[:,ti])  # no fitting needed, but eval on ei
    # recompute properly: recipe applied to all, eval subset
    p=fn(Vs); recipes[nm]=mae(p,ys)
# trimmed
p=np.sort(Vs,0)[1:-1].mean(0); recipes['trimmed']=mae(p,ys)
# wmean cross-fitted
oof=np.zeros(len(ys))
for ti,ei in folds:
    w,_=fit_w(Vs[:,ti],ys[ti],starts=5,seed=1)
    oof[ei]=w@Vs[:,ei]
recipes['wmean_cv']=mae(oof,ys)
print('recipe CV MAE',{k:round(v,5) for k,v in recipes.items()},flush=True)
best=min(recipes,key=lambda x:recipes[x]); print('best recipe',best,flush=True)
# final weights on all insp
wf,fin=fit_w(Vs,ys,starts=8,seed=7); print('final weights',dict(zip(names,np.round(wf,3))),'fit MAE',fin,flush=True)

# bias correction honest CV on top of wmean CV
resid=ys-oof
corr_map={}
# fit per fold, eval on held-out
oofbc=oof.copy()
for ti,ei in folds:
    df=pd.DataFrame({'key':cks[ti],'r':resid[ti]})
    g=df.groupby('key')['r'].agg(['median','count'])
    sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
    oofbc[ei]=oof[ei]+np.array([corr.get(x,0.0) for x in cks[ei]])
mae_bc=mae(oofbc,ys); print('wmean_cv+bias_cv',mae_bc,flush=True)

# choose
use_bias = mae_bc < recipes['wmean_cv']-1e-6
if best!='wmean_cv':
    # recipes without weight fit: apply directly
    P={'mean':V.mean(0),'median':np.median(V,0),'trimmed':np.sort(V,0)[1:-1].mean(0)}[best]
    Tp={'mean':T.mean(0),'median':np.median(T,0),'trimmed':np.sort(T,0)[1:-1].mean(0)}[best]
    print('using',best,flush=True)
else:
    Tp=wf@T; print('using wmean + bias' if use_bias else 'using wmean',flush=True)
    if use_bias:
        df=pd.DataFrame({'key':cks,'r':resid})
        g=df.groupby('key')['r'].agg(['median','count']); sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
        addt=np.array([corr.get(x,0.0) for x in ckt]); Tp=Tp.copy(); Tp[testv]+=addt
Tp=np.clip(Tp,-2.0,66.0)
sub=pd.DataFrame({'id':test_ids,'pressure':Tp}); ss=pd.read_csv('data/sample_submission.csv')
sub=sub.set_index('id').reindex(ss.id.values).reset_index(); assert sub.pressure.notna().all()
sub.to_csv(f'{D}/preds/submission_blend3.csv',index=False)
import json; json.dump({'recipes':recipes,'mae_bc':mae_bc,'weights':dict(zip(names,wf.tolist())),'use_bias':bool(use_bias),'best':best},open(f'{D}/preds/blend3_meta.json','w'),indent=1)
print('wrote submission_blend3.csv',sub.shape,'t',time.time()-t0,flush=True)
