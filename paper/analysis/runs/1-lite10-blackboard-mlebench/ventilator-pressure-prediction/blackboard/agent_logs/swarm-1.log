import numpy as np, pandas as pd, glob, os, time, json
from scipy.optimize import minimize
from sklearn.model_selection import GroupKFold
SEQ=80; D='workspaces/dubhe_phi'; SKIP=('smoke',); t0=time.time()
DROPIN={'blstm512ft3':'blstm512ft3full','blstm512ft':'blstm512ftfull','lstm_c2_s21':'lstm_c2_s21_full'}
tr=pd.read_csv('data/train.csv',usecols=['id','breath_id','R','C','time_step','u_out','pressure'])
tr=tr.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
ub=np.sort(tr.breath_id.unique()); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
valb=ub[perm[:int(round(0.1*len(ub)))]]
val=tr[tr.breath_id.isin(valb)].reset_index(drop=True)
val_ids=val.id.values; val_y=val.pressure.values.astype(np.float32); val_insp=(val.u_out.values==0)
val_breath=val.breath_id.values; val_RC=val.R.values.astype(np.int64)*1000+val.C.values; val_step=np.tile(np.arange(SEQ),len(val)//SEQ)
te=pd.read_csv('data/test.csv',usecols=['id','breath_id','R','C','time_step','u_out'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values; test_RC=te.R.values.astype(np.int64)*1000+te.C.values; test_step=np.tile(np.arange(SEQ),len(te)//SEQ)
models={}
for vf in sorted(glob.glob('workspaces/*/preds/val_seed42*_*.csv')):
    base=os.path.basename(vf).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    if any(s in base for s in SKIP) or base in DROPIN and False: continue
    agent=vf.split('/')[1]; dd=f'workspaces/{agent}/preds'
    tfs=[f'{dd}/test_{base}.csv']+glob.glob(f'{dd}/test*{base}*.csv'); tfs=[t for t in tfs if os.path.exists(t)]
    if not tfs: continue
    v=pd.read_csv(vf).set_index('id')['pressure'].reindex(val_ids).values.astype(np.float32)
    t=pd.read_csv(tfs[0]).set_index('id')['pressure'].reindex(test_ids).values.astype(np.float32)
    if np.isnan(v).any() or np.isnan(t).any(): continue
    models[base]=(v,t)
names=list(models.keys()); V=np.stack([models[n][0] for n in names]); T=np.stack([models[n][1] for n in names])
# apply drop-in to test arrays
used=[]
for i,n in enumerate(names):
    if n in DROPIN:
        cands=glob.glob(f'workspaces/*/preds/test_{DROPIN[n]}.csv')
        if cands:
            td=pd.read_csv(cands[0]).set_index('id')['pressure'].reindex(test_ids).values.astype(np.float32)
            if not np.isnan(td).any():
                T[i]=td; used.append((n,DROPIN[n]))
print('dropins applied',used,flush=True)
k=len(names); vi=np.where(val_insp)[0]; Vs=V[:,vi]; ys=val_y[vi]; bs=val_breath[vi]; rc=(val_RC*100+val_step)[vi]
testv=np.where(te.u_out.values==0)[0]; rct=(test_RC*100+test_step)[testv]
def mae(p,y): return float(np.abs(p-y).mean())
def fit_w(P,y,starts=6,seed=0):
    r=np.random.RandomState(seed); best=(1e9,None)
    inits=[np.ones(P.shape[0])/P.shape[0]]+[r.dirichlet(np.ones(P.shape[0])) for _ in range(starts-1)]
    for x0 in inits:
        def obj(w):
            w=np.abs(w); s=w.sum()
            if s<1e-9: return 1e9
            w=w/s; return np.abs(w@P-y).mean()
        o=minimize(obj,x0,method='SLSQP',bounds=[(0,1)]*P.shape[0],constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':250,'ftol':1e-10})
        w=np.abs(o.x); w=w/w.sum(); f=obj(w)
        if f<best[0]: best=(f,w)
    return best[1]
folds=list(GroupKFold(n_splits=5).split(Vs.T,ys,bs))
oof=np.zeros(len(ys))
for ti,ei in folds:
    w=fit_w(Vs[:,ti],ys[ti],5,1); oof[ei]=w@Vs[:,ei]
cv=mae(oof,ys)
# bias
resid=ys-oof; oofbc=oof.copy()
for ti,ei in folds:
    df=pd.DataFrame({'key':rc[ti],'r':resid[ti]}); g=df.groupby('key')['r'].agg(['median','count'])
    sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
    oofbc[ei]=oof[ei]+np.array([corr.get(x,0.0) for x in rc[ei]])
cvbc=mae(oofbc,ys); use_bc=cvbc<cv-1e-6
print('CV wmean',cv,'+bias',cvbc,'use_bc',use_bc,flush=True)
wf=fit_w(Vs,ys,8,7)
print('weights',dict(zip(names,np.round(wf,4))),flush=True)
Tp=wf@T
if use_bc:
    df=pd.DataFrame({'key':rc,'r':ys-oof}); g=df.groupby('key')['r'].agg(['median','count'])
    sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
    Tp=Tp+np.array([corr.get(x,0.0) for x in (test_RC*100+test_step)])
Tp=np.clip(Tp,-2.0,66.0)
sub=pd.DataFrame({'id':test_ids,'pressure':Tp}); ss=pd.read_csv('data/sample_submission.csv')
sub=sub.set_index('id').reindex(ss.id.values).reset_index(); assert sub.pressure.notna().all()
sub.to_csv(f'{D}/preds/submission_final.csv',index=False)
json.dump({'cv_wmean':cv,'cv_bias':cvbc,'use_bias':use_bc,'weights':dict(zip(names,wf.tolist())),'dropins':used},open(f'{D}/preds/final_meta.json','w'),indent=1)
print('wrote submission_final.csv',sub.shape,'t',time.time()-t0,flush=True)
