print('ids==sample order',bool((fs.id.values==ss.id.values).all()),'unique',fs.id.nunique(),'nan',int(fs.pressure.isna().sum()))
print('range',float(fs.pressure.min()),float(fs.pressure.max()))
# compare to sirius sub_final3
s3=pd.read_csv('workspaces/sirius_tau/sub_final3.csv')
print('rows sub_final3',s3.shape,'ids match',bool((s3.id.values==fs.id.values).all()),
      'maxabs diff',float(np.abs(s3.pressure.values-fs.pressure.values).max()))
# recompute from manifest
man=json.load(open('workspaces/sirius_tau/manifest_final3.json'))
rep=json.load(open('workspaces/sirius_tau/sub_final3_report.json'))
wi=np.array(rep['w_insp']); we=np.array(rep['w_exp'])
te=pd.read_csv('data/test.csv',usecols=['id','breath_id','time_step','u_out'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values; insp=(te.u_out.values==0)
T=[]
for m in man:
    t=pd.read_csv(m['test'])
    t=t.set_index('id')['pressure'].reindex(test_ids).values.astype(np.float64)
    assert not np.isnan(t).any(), m['name']
    T.append(t)
T=np.stack(T)
pred=T.copy()
pred[:,insp]=(wi[:,None]*T[:,insp]).sum(0)
pred[:,~insp]=(we[:,None]*T[:,~insp]).sum(0)
pred=np.clip(pred,-2.0,66.0)
