import numpy as np, pandas as pd, glob, os, time, json
from scipy.optimize import minimize
from sklearn.model_selection import GroupKFold
SEQ=80; D='workspaces/dubhe_phi'; SKIP=('smoke',); t0=time.time()
tr=pd.read_csv('data/train.csv',usecols=['id','breath_id','R','C','time_step','u_out','pressure'])
tr=tr.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
ub=np.sort(tr.breath_id.unique()); rng=np.random.RandomState(42); perm=rng.permutation(len(ub))
valb=ub[perm[:int(round(0.1*len(ub)))]]
val=tr[tr.breath_id.isin(valb)].reset_index(drop=True)
val_ids=val.id.values; val_y=val.pressure.values.astype(np.float32); val_insp=(val.u_out.values==0)
val_breath=val.breath_id.values; val_RC=(val.R.values.astype(np.int64)*1000+val.C.values)
val_step=np.tile(np.arange(SEQ),len(val)//SEQ)
te=pd.read_csv('data/test.csv',usecols=['id','breath_id','R','C','time_step','u_out'])
te=te.sort_values(['breath_id','time_step','id'],kind='mergesort').reset_index(drop=True)
test_ids=te.id.values; test_RC=(te.R.values.astype(np.int64)*1000+te.C.values); test_step=np.tile(np.arange(SEQ),len(te)//SEQ)
models={}
for vf in sorted(glob.glob('workspaces/*/preds/val_seed42*_*.csv')):
    base=os.path.basename(vf).replace('val_seed42_pred_','').replace('val_seed42_','').replace('.csv','')
    if any(s in base for s in SKIP): continue
    agent=vf.split('/')[1]; dd=f'workspaces/{agent}/preds'
    tfs=[f'{dd}/test_{base}.csv']+glob.glob(f'{dd}/test*{base}*.csv'); tfs=[t for t in tfs if os.path.exists(t)]
    if not tfs: continue
    v=pd.read_csv(vf).set_index('id')['pressure'].reindex(val_ids).values.astype(np.float32)
    t=pd.read_csv(tfs[0]).set_index('id')['pressure'].reindex(test_ids).values.astype(np.float32)
    if np.isnan(v).any() or np.isnan(t).any(): continue
    models[base]=(v,t)
names=list(models.keys()); V=np.stack([models[n][0] for n in names]); T=np.stack([models[n][1] for n in names]); k=len(names)
vi=np.where(val_insp)[0]; Vs=V[:,vi]; ys=val_y[vi]; bs=val_breath[vi]; rc=(val_RC*100+val_step)[vi]
testv=np.where(te.u_out.values==0)[0]; Ts=T[:,testv]; rct=(test_RC*100+test_step)[testv]
def mae(p,y): return float(np.abs(p-y).mean())
def fit_w(P,y,starts=5,seed=0):
    r=np.random.RandomState(seed); best=(1e9,None)
    inits=[np.ones(P.shape[0])/P.shape[0]]+[r.dirichlet(np.ones(P.shape[0])) for _ in range(starts-1)]
    for x0 in inits:
        def obj(w):
            w=np.abs(w); s=w.sum()
            if s<1e-9: return 1e9
            w=w/s; return np.abs(w@P-y).mean()
        o=minimize(obj,x0,method='SLSQP',bounds=[(0,1)]*P.shape[0],constraints={'type':'eq','fun':lambda w:w.sum()-1},options={'maxiter':200,'ftol':1e-9})
        w=np.abs(o.x); w=w/w.sum(); f=obj(w)
        if f<best[0]: best=(f,w)
    return best[1]
gkf=GroupKFold(n_splits=5); folds=list(gkf.split(Vs.T,ys,bs))
# global CV
oofg=np.zeros(len(ys))
for ti,ei in folds:
    w=fit_w(Vs[:,ti],ys[ti],5,1); oofg[ei]=w@Vs[:,ei]
# per-RC CV
oofr=np.zeros(len(ys))
rcg=rc//100  # group key R*1000+C
for ti,ei in folds:
    for g in np.unique(rcg):
        gm=rcg==g; tii=ti[gm[ti]]; eii=ei[gm[ei]]
        if len(tii)<500:
            w=fit_w(Vs[:,ti],ys[ti],5,1)
        else:
            w=fit_w(Vs[:,tii],ys[tii],5,2)
        oofr[eii]=w@Vs[:,eii]
print('CV global',mae(oofg,ys),'perRC',mae(oofr,ys),flush=True)
# bias on top of each
def biascv(oof):
    resid=ys-oof; out=oof.copy()
    for ti,ei in folds:
        df=pd.DataFrame({'key':rc[ti],'r':resid[ti]}); g=df.groupby('key')['r'].agg(['median','count'])
        sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
        out[ei]=oof[ei]+np.array([corr.get(x,0.0) for x in rc[ei]])
    return out
cand={'global':oofg,'perrc':oofr,'global_b':biascv(oofg),'perrc_b':biascv(oofr)}
for kk in cand: print(kk,mae(cand[kk],ys),flush=True)
best=min(cand,key=lambda x:mae(cand[x],ys)); print('BEST',best,flush=True)
# final fit + test
if best.startswith('perrc'):
    Tp=np.zeros(len(testv))
    for g in np.unique(rcg):
        gm=rcg==g; tim=np.where(gm)[0]; tg=np.where(rct//100==g)[0]
        w=fit_w(Vs[:,tim],ys[tim],7,3); Tp[tg]=w@Ts[:,tg]
    if best.endswith('_b'):
        df=pd.DataFrame({'key':rc,'r':ys-oofr}); g=df.groupby('key')['r'].agg(['median','count'])
        sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
        Tp=Tp+np.array([corr.get(x,0.0) for x in rct])
else:
    w=fit_w(Vs,ys,8,7); Tp=w@Ts
    if best.endswith('_b'):
        df=pd.DataFrame({'key':rc,'r':ys-oofg}); g=df.groupby('key')['r'].agg(['median','count'])
        sh=g['count']/(g['count']+200.0); corr=(g['median']*sh)
        Tp=Tp+np.array([corr.get(x,0.0) for x in rct])
# keep exp rows from simple wmean of all models (not scored) - better: global wmean all rows
# use global wmean over all rows for exp as fallback
wf=fit_w(Vs,ys,5,7); Tfull=wf@T
Tfull=Tfull.copy(); Tfull[testv]=Tp
Tfull=np.clip(Tfull,-2.0,66.0)
sub=pd.DataFrame({'id':test_ids,'pressure':Tfull}); ss=pd.read_csv('data/sample_submission.csv')
sub=sub.set_index('id').reindex(ss.id.values).reset_index(); assert sub.pressure.notna().all()
sub.to_csv(f'{D}/preds/submission_blend4.csv',index=False)
json.dump({'cv':{kk:mae(cand[kk],ys) for kk in cand},'best':best},open(f'{D}/preds/blend4_meta.json','w'),indent=1)
print('wrote submission_blend4 t',time.time()-t0,flush=True)
EOF
