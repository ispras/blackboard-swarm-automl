        p_s = P @ wg
        for st, w in wstep.items():
            rows = step == st
            p_s[rows] = P[rows] @ ((1-lam)*wg + lam*w)
        print(f'per-step shrink lam={lam}: eval(B)={mae(y, p_s, B):.5f}')
'''
