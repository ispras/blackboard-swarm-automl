import numpy as np,pandas as pd,os
from collections import Counter
tr=pd.read_json('../../data/train.json',lines=True)
T=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
Y=np.zeros((len(tr),107,5));vv=np.stack([np.stack(tr[c].values) for c in T],-1);M=np.zeros((len(tr),107))
for i,n in enumerate(tr.seq_scored.values):Y[i,:n]=vv[i,:n];M[i,:n]=1
sn=(tr.SN_filter.values==1);Ms=M*sn[:,None]
def sc(P):return np.mean([np.sqrt((((Y[...,c]-P[...,c])**2)*Ms).sum()/Ms.sum()) for c in (0,1,3)])
runs={
 'bigru_s42':'run_d_tta','bigru_s1':'run_seed1_tta','bigru_s2':'run_seed2_tta',
 'bigru_ema':'run_ema_tta','bigru_hub':'run_hub_tta','bigru_aux05':'run_aux05_tta',
 'cnn':'run_cnn_tta','cnn2':'run_cnn2_tta','tf':'run_tf_tta','tf2':'run_tf2_tta',
 'errw':'run_errw_tta','errw13':'run_errw13_tta','errw14':'run_errw14_tta'}
P={k:np.load(f'{v}/oof.npy') for k,v in runs.items()}
Tst={k:np.load(f'{v}/test.npy') for k,v in runs.items()}
E=np.mean([P[k] for k in ['errw','errw13','errw14']],0)
print('errw3',round(float(sc(E)),5))
P['errw3']=E
Tst['errw3']=np.mean([Tst[k] for k in ['errw','errw13','errw14']],0)
for k,v in P.items(): print(k,round(float(sc(v)),5))
os.makedirs('ensemble',exist_ok=True)
for k in runs:
    np.save(f'ensemble/oof_{k}.npy',P[k][:,:68][:,:,[0,1,3]]); np.save(f'ensemble/test_{k}.npy',Tst[k][:,:68][:,:,[0,1,3]])
np.save('ensemble/oof_errw3.npy',E[:,:68][:,:,[0,1,3]]); np.save('ensemble/test_errw3.npy',Tst['errw3'][:,:68][:,:,[0,1,3]])
# greedy over unique-ish pool (avoid duplicates: use errw3 + bigru variants + tf + cnn)
pool={k:P[k] for k in P if k not in ['errw','errw13','errw14']}
names=list(pool);cur=np.zeros_like(P['bigru_s1']);cnt=0;chosen=[];best=1e9
for it in range(40):
    bp=None;bs=1e9
    for k in names:
        cand=(cur*cnt+pool[k])/(cnt+1);s=sc(np.maximum(cand,-0.5))
        if s<bs:bs=s;bp=k
    if bs>=best-1e-7 and it>2:break
    cur=(cur*cnt+pool[bp])/(cnt+1);cnt+=1;best=bs;chosen.append(bp)
    print(it,bp,round(bs,5))
print('greedy',round(best,5),Counter(chosen))
# test blend by same counts
tc=sum(Tst[k] for k in chosen)/len(chosen)
np.save('ensemble/oof_deneb_blend.npy',np.maximum(cur,-0.5)[:,:68][:,:,[0,1,3]])
np.save('ensemble/test_deneb_blend.npy',np.maximum(tc,-0.5)[:,:68][:,:,[0,1,3]])
print('saved')
