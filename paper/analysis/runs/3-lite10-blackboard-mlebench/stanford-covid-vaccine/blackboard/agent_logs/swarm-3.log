addition = '''

class RNAModelCNN(nn.Module):
    def __init__(self, conv_ch=256, dilations=(1,2,4,8), dropout=0.3):
        super().__init__()
        self.stem = nn.Sequential(nn.Conv1d(14, conv_ch, 5, padding=2), nn.BatchNorm1d(conv_ch), nn.ELU())
        self.blocks = nn.ModuleList()
        for d in dilations:
            self.blocks.append(nn.Sequential(
                nn.Conv1d(conv_ch, conv_ch, 3, padding=d, dilation=d), nn.BatchNorm1d(conv_ch), nn.ELU(), nn.Dropout(dropout),
                nn.Conv1d(conv_ch, conv_ch, 3, padding=d, dilation=d), nn.BatchNorm1d(conv_ch), nn.ELU(), nn.Dropout(dropout)))
        self.head = nn.Sequential(nn.Conv1d(conv_ch, 256, 3, padding=1), nn.BatchNorm1d(256), nn.ELU(),
                                  nn.Dropout(dropout), nn.Conv1d(256, 5, 1))

    def forward(self, x):
        h = self.stem(x.transpose(1, 2))
        for b in self.blocks:
            h = h + b(h)
        return self.head(h).transpose(1, 2)


class RNAModelTransformer(nn.Module):
    def __init__(self, conv_ch=256, d_model=256, nhead=8, layers=4, dropout=0.1):
        super().__init__()
        self.stem = nn.Sequential(nn.Conv1d(14, conv_ch, 5, padding=2), nn.BatchNorm1d(conv_ch), nn.ELU(),
                                  nn.Conv1d(conv_ch, d_model, 3, padding=1), nn.BatchNorm1d(d_model), nn.ELU())
        self.pos = nn.Parameter(torch.zeros(1, 200, d_model))
        nn.init.normal_(self.pos, std=0.02)
        enc = nn.TransformerEncoderLayer(d_model=d_model, nhead=nhead, dim_feedforward=4*d_model,
                                         dropout=dropout, activation='gelu', batch_first=True, norm_first=True)
        self.enc = nn.TransformerEncoder(enc, num_layers=layers)
        self.head = nn.Sequential(nn.Linear(d_model, 256), nn.ELU(), nn.Dropout(0.2), nn.Linear(256, 5))

    def forward(self, x):
        h = self.stem(x.transpose(1, 2)).transpose(1, 2)
        h = h + self.pos[:, :h.size(1)]
        h = self.enc(h)
        return self.head(h)
'''
