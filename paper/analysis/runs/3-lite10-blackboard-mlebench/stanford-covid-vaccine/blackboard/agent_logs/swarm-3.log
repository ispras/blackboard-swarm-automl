import numpy as np,pandas as pd,os
from collections import Counter
tr=pd.read_json('../../data/train.json',lines=True)
T=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
Y=np.zeros((len(tr),107,5));vv=np.stack([np.stack(tr[c].values) for c in T],-1);M=np.zeros((len(tr),107))
for i,n in enumerate(tr.seq_scored.values):Y[i,:n]=vv[i,:n];M[i,:n]=1
sn=(tr.SN_filter.values==1);Ms=M*sn[:,None]
def sc(P):return np.mean([np.sqrt((((Y[...,c]-P[...,c])**2)*Ms).sum()/Ms.sum()) for c in (0,1,3)])
mdirs=['run_mcr28_tta','run_mcr29_tta','run_mcr32_tta','run_mcr33_tta']
MB=[np.load(f'{d}/oof.npy') for d in mdirs];MT=[np.load(f'{d}/test.npy') for d in mdirs]
mcr4=sum(MB)/4;mt4=sum(MT)/4;print('mcr4',round(float(sc(mcr4)),5))
np.save('ensemble/oof_errw_big_mcr4.npy',mcr4[:,:68][:,:,[0,1,3]]);np.save('ensemble/test_errw_big_mcr4.npy',mt4[:,:68][:,:,[0,1,3]])
# merge into existing deneb blend pool reconstruction (reuse ensemble files)
import glob
names=[os.path.basename(p)[4:-4] for p in glob.glob('ensemble/oof_*.npy')]
names=[n for n in names if n not in ('deneb_blend','myblend_greedy')]
P={n:np.load(f'ensemble/oof_{n}.npy') for n in names}
Tst={n:np.load(f'ensemble/test_{n}.npy') for n in names}
cur=np.zeros((len(tr),68,3),np.float32);cnt=0;chosen=[];best=1e9
def sc3(Pp):
    p=np.maximum(Pp,-0.5);return float(np.mean([np.sqrt((((Y[:,:68,c]-p[:,:,i])**2)*Ms[:,:68]).sum()/Ms[:,:68].sum()) for i,c in enumerate((0,1,3))]))
for it in range(100):
    bp=None;bs=1e9
    for n in names:
        cand=(cur*cnt+P[n])/(cnt+1);s=sc3(cand)
        if s<bs:bs=s;bp=n
    if bs>=best-1e-7 and it>2:break
    cur=(cur*cnt+P[bp])/(cnt+1);cnt+=1;best=bs;chosen.append(bp)
    if it<12:print(it,bp,round(bs,5))
print('blend',round(best,5),Counter(chosen))
tc=sum(Tst[n] for n in chosen)/len(chosen)
np.save('ensemble/oof_deneb_blend.npy',np.maximum(cur,-0.5));np.save('ensemble/test_deneb_blend.npy',np.maximum(tc,-0.5))
print('saved')
