def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--epochs', type=int, default=40)
    ap.add_argument('--batch_size', type=int, default=64)
    ap.add_argument('--lr', type=float, default=1e-3)
    ap.add_argument('--wd', type=float, default=1e-4)
    ap.add_argument('--dropout', type=float, default=0.3)
    ap.add_argument('--conv_ch', type=int, default=256)
    ap.add_argument('--rnn_hidden', type=int, default=256)
    ap.add_argument('--rnn_layers', type=int, default=2)
    ap.add_argument('--folds', type=int, default=5)
    ap.add_argument('--seed', type=int, default=42)
    ap.add_argument('--split_seed', type=int, default=42)
    ap.add_argument('--rev_aug', action='store_true')
    ap.add_argument('--clip', type=float, default=0.0)
    ap.add_argument('--scale', action='store_true')
    ap.add_argument('--select_sn', action='store_true')
    ap.add_argument('--sn_only', action='store_true')
    ap.add_argument('--loss', type=str, default='mse')
    ap.add_argument('--aux_weight', type=float, default=1.0)
    ap.add_argument('--out', type=str, default='run1')
    ap.add_argument('--device', type=str, default='cuda' if torch.cuda.is_available() else 'cpu')
    ap.add_argument('--only_fold', type=int, default=-1)
    args = ap.parse_args()

    random.seed(args.seed); np.random.seed(args.seed); torch.manual_seed(args.seed)
    torch.backends.cudnn.benchmark = True
    tr = pd.read_json(os.path.join(DATA_DIR, 'train.json'), lines=True)
    te = pd.read_json(os.path.join(DATA_DIR, 'test.json'), lines=True)
    os.makedirs(args.out, exist_ok=True)

    kf = KFold(n_splits=args.folds, shuffle=True, random_state=args.split_seed)
    oof = np.zeros((len(tr), 107, 5), dtype=np.float32)
    test_pred = np.zeros((len(te), 107, 5), dtype=np.float32)
    fold_scores = []
    for fold,(ti,vi) in enumerate(kf.split(tr)):
        if args.only_fold >= 0 and fold != args.only_fold: continue
        print(f"=== fold {fold} ===", flush=True)
        model, best, bep = train_fold(tr.iloc[ti], tr.iloc[vi], args, fold)
        tr_fit = tr.iloc[ti]
        if args.sn_only: tr_fit = tr_fit[tr_fit['SN_filter']==1]
        tmean, tstd = get_stats(tr_fit) if args.scale else (None, None)
        p = predict(model, tr.iloc[vi], args, tmean, tstd)
        oof[vi] = p
        tp = predict(model, te, args, tmean, tstd)
        test_pred += tp / (args.folds if args.only_fold<0 else 1)
        fold_scores.append(best)
        print(f"fold {fold} best {best:.5f} ep {bep}", flush=True)
        torch.save(model.state_dict(), os.path.join(args.out, f'model_f{fold}.pt'))

    np.save(os.path.join(args.out, 'oof.npy'), oof)
    np.save(os.path.join(args.out, 'test.npy'), test_pred)
    np.save(os.path.join(args.out, 'oof_3cols.npy'), oof[:, :68][:, :, [0,1,3]])
    np.save(os.path.join(args.out, 'test_3cols.npy'), test_pred[:, :68][:, :, [0,1,3]])
    # scores
    Y = np.zeros((len(tr),107,5),dtype=np.float32)
    vv = np.stack([np.stack(tr[c].values) for c in TARGETS], axis=-1)
    M = np.zeros((len(tr),107),dtype=np.float32)
    for i,n in enumerate(tr['seq_scored'].values):
        Y[i,:n]=vv[i,:n]; M[i,:n]=1.0
    allsc = np.mean([np.sqrt((((Y[...,c]-oof[...,c])**2)*M).sum()/M.sum()) for c in (0,1,3)])
    sn = tr['SN_filter'].values==1
    Ms = M* sn[:,None]
    snsc = np.mean([np.sqrt((((Y[...,c]-oof[...,c])**2)*Ms).sum()/Ms.sum()) for c in (0,1,3)])
    oofc = np.maximum(oof, -0.5)
    snsc_c = np.mean([np.sqrt((((Y[...,c]-oofc[...,c])**2)*Ms).sum()/Ms.sum()) for c in (0,1,3)])
    print(f"OOF MCRMSE all={allsc:.5f} SN={snsc:.5f} SN_clip-0.5={snsc_c:.5f} folds={fold_scores}", flush=True)
    with open(os.path.join(args.out,'result.json'),'w') as f:
        json.dump({'oof':float(allsc),'oof_sn':float(snsc),'oof_sn_clip':float(snsc_c),'folds':[float(x) for x in fold_scores],'args':vars(args)}, f, indent=2)


if __name__=='__main__':
    main()
