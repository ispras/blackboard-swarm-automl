    net=Net(args.d,args.h,args.layers,args.drop,extra=args.extra,pos=args.pos).to(dev)
    opt=torch.optim.AdamW(net.parameters(),lr=args.lr,weight_decay=args.wd)
    sched=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=args.epochs,eta_min=args.lr*0.02)
    scaler=torch.cuda.amp.GradScaler()
    m68=torch.zeros(107,dtype=torch.float32); m68[:68]=1
    sn=feats_sn
    snva=sn[va_idx]>1.0
    best=9e9; best_state=None; best_ep=0; bad=0
    for ep in range(args.epochs):
        net.train(); tl=0; n=0
        for xb,yb in ltr:
            xb=xb.to(dev); yb=yb.to(dev); m=m68.to(dev).expand(xb.size(0),107)
            opt.zero_grad()
            with torch.cuda.amp.autocast(): loss=masked_loss(net(xb),yb,m)
            scaler.scale(loss).backward(); scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(net.parameters(),1.0)
            scaler.step(opt); scaler.update(); tl+=loss.item()*xb.size(0); n+=xb.size(0)
        sched.step()
        net.eval(); pr=[]
        with torch.no_grad():
            for xb,yb in lva:
                with torch.cuda.amp.autocast(): o=net(xb.to(dev))
                pr.append(o.float().cpu().numpy())
        pred=np.concatenate(pr,0); yv=y[va_idx]
        if snva.sum()>10: sc=mcrmse(pred[snva],yv[snva],np.ones((snva.sum(),107),bool),clip=-0.5)
        else: sc=mcrmse(pred,yv,np.ones((len(va_idx),107),bool),clip=-0.5)
        if sc<best-1e-5:
            best=sc; best_ep=ep; best_state={k:v.detach().cpu().clone() for k,v in net.state_dict().items()}; bad=0
        else: bad+=1
        if ep%10==0 or bad>=args.patience:
            print(f"   ep{ep:03d} loss{tl/max(n,1):.4f} snval{sc:.4f} best{best:.4f}@{best_ep}",flush=True)
        if bad>=args.patience: break
    net.load_state_dict(best_state); net.eval()
    oofp=predict_ds(net,dva,tta=bool(args.tta))
    # report tta comparison on sn val
    if args.tta:
        snva_=sn[va_idx]>1.0
        yv=y[va_idx]
        sc_tta=mcrmse(oofp[snva_],yv[snva_],np.ones((snva_.sum(),107),bool),clip=-0.5)
        print(f"   TTA snval {sc_tta:.4f}",flush=True)
    return best,best_ep,oofp,net

def infer(net,feats,tta=False):
    ds=DS(feats)
    return predict_ds(net,ds,tta=tta)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=int,default=5); ap.add_argument('--fold',type=int,default=-1)
    ap.add_argument('--epochs',type=int,default=70); ap.add_argument('--patience',type=int,default=15)
    ap.add_argument('--bs',type=int,default=64); ap.add_argument('--d',type=int,default=100)
    ap.add_argument('--h',type=int,default=256); ap.add_argument('--layers',type=int,default=3)
    ap.add_argument('--drop',type=float,default=0.3); ap.add_argument('--lr',type=float,default=1e-3)
    ap.add_argument('--wd',type=float,default=1e-4); ap.add_argument('--seeds',type=int,default=1)
