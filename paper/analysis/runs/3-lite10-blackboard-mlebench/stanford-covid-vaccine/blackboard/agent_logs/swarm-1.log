import os,glob,json,numpy as np
from sklearn.model_selection import KFold
from common import load_train,mcrmse,SCORE_IDX,WS
AGG=WS+'/agg';tr=load_train();n=len(tr['seq'])
snf=np.array([r['SN_filter'] for r in tr['rows']],bool);mask=tr['mask'][:,:68]
yv=tr['y'][:,:68,:][:,:,SCORE_IDX]
sets={
 'curated13':['fom_erraw','fom_werr6','fom_fwd9','fom_noaug','deneb_deneb_blend','deneb_errw3','deneb_tf2','deneb_errw_tf','errwgru','errwlstm','errwcnn','cnn256','lstm512sp7'],
 'curated9':['fom_erraw','fom_werr6','deneb_deneb_blend','deneb_errw3','deneb_tf2','errwgru','errwlstm','cnn256','lstm512sp7'],
 'anchors4':['fom_erraw','deneb_deneb_blend','errwgru','deneb_errw_tf'],
}
def run(names,bags=1):
  O=np.stack([np.load(f'{AGG}/oof_{m}.npy') for m in names]).astype(np.float32)
  M=len(names)
  def score(p,rows):
    r=snf[rows];return mcrmse(yv[rows][r],p[r],mask[rows][r],cols=[0,1,2])[0]
  def greedy(rows,iters=30):
    cnt=np.zeros(M,dtype=np.float32);cur=np.zeros((len(rows),68,3),np.float32);hist=[]
    Ot=np.take(O,rows,axis=1)
    for it in range(iters):
      bs,bj=1e9,-1
      for j in range(M):
        cand=np.maximum((cur*cnt.sum()+Ot[j])/(cnt.sum()+1),-0.5)
        s=score(cand,rows)
        if s<bs:bs,bj=s,j
      cnt[bj]+=1;cur=(cur*(cnt.sum()-1)+Ot[bj])/cnt.sum();hist.append(bs)
      if it>5 and hist[-1]>hist[-2]-1e-5:break
    return cnt/cnt.sum()
  kf=KFold(5,shuffle=True,random_state=42);pred=np.zeros_like(yv)
  for ti,vi in kf.split(np.arange(n)):
    w=greedy(ti);pred[vi]=np.einsum('m,mptc->ptc',w,np.take(O,vi,axis=1))
  pred=np.maximum(pred,-0.5)
  sn=mcrmse(yv[snf],pred[snf],mask[snf],cols=[0,1,2])[0]
  w=greedy(np.arange(n))
  return sn,w
for k,names in sets.items():
  sn,w=run(names)
  print(k,'nested_sn=%.4f'%sn,{names[i]:round(float(w[i]),2) for i in range(len(names)) if w[i]>1e-4})
EOF
