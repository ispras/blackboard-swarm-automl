class RNADataset(Dataset):
    def __init__(self, df, train=True, rev_aug=False, clip=None, tmean=None, tstd=None):
        self.df = df.reset_index(drop=True)
        self.train = train
        self.rev_aug = rev_aug
        self.clip = clip
        self.tmean = tmean
        self.tstd = tstd
        self.seqs = [encode(s, SEQ_VOCAB, 4) for s in df['sequence']]
        self.structs = [encode(s, STRUCT_VOCAB, 3) for s in df['structure']]
        self.loops = [encode(s, LOOP_VOCAB, 7) for s in df['predicted_loop_type']]
        if train:
            N = len(df)
            self.y = np.zeros((N, 107, 5), dtype=np.float32)
            vals = np.stack([np.stack(df[c].values).astype(np.float32) for c in TARGETS], axis=-1)  # N,68,5
            self.mask = np.zeros((N, 107), dtype=np.float32)
            for i, n in enumerate(df['seq_scored'].values):
                self.y[i, :n] = vals[i, :n]
                self.mask[i, :n] = 1.0
            if clip is not None and clip > 0:
                self.y = np.clip(self.y, -clip, clip)
            if tmean is not None:
                self.y = (self.y - tmean) / tstd

    def __len__(self):
        return len(self.df)

    def __getitem__(self, i):
        x = np.concatenate([self.seqs[i], self.structs[i], self.loops[i]], axis=1)  # L,14
        if not self.train:
            return torch.from_numpy(x)
        y = self.y[i]; m = self.mask[i]
        if self.rev_aug and random.random() < 0.5:
            x = x[::-1].copy()
            # reverse structure: swap ( and )
            x[:, 5], x[:, 6] = x[:, 6].copy(), x[:, 5].copy()
            y = y[::-1].copy(); m = m[::-1].copy()
        return torch.from_numpy(x), torch.from_numpy(y), torch.from_numpy(m)


class RNAModel(nn.Module):
    def __init__(self, conv_ch=256, rnn_hidden=256, rnn_layers=2, dropout=0.3):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv1d(14, conv_ch, 5, padding=2), nn.BatchNorm1d(conv_ch), nn.ELU(), nn.Dropout(dropout),
            nn.Conv1d(conv_ch, conv_ch, 3, padding=1), nn.BatchNorm1d(conv_ch), nn.ELU(), nn.Dropout(dropout),
        )
        self.rnn = nn.GRU(conv_ch, rnn_hidden, num_layers=rnn_layers, batch_first=True,
                          bidirectional=True, dropout=dropout)
        self.head = nn.Sequential(
            nn.Linear(rnn_hidden*2, 256), nn.ELU(), nn.Dropout(dropout),
            nn.Linear(256, 5),
        )

    def forward(self, x):
        h = x.transpose(1, 2)
        h = self.conv(h).transpose(1, 2)
        h, _ = self.rnn(h)
        return self.head(h)


def mcrmse(y, p, mask, cols_idx=(0,1,3)):
    # y,p: B,L,5 ; mask B,L
    rm = []
    for c in cols_idx:
        d = ((y[...,c]-p[...,c])**2)[mask]
        rm.append(torch.sqrt(d.mean()+1e-12).item())
    return float(np.mean(rm))


def get_stats(df):
    vals = np.stack([np.concatenate([np.array(x) for x in df[c].values]) for c in TARGETS])
    m = vals.mean(1).astype(np.float32); sd = vals.std(1).astype(np.float32)
    return m, sd


def train_fold(df_tr, df_va, args, fold):
    dev = args.device
    if args.sn_only:
        df_tr = df_tr[df_tr['SN_filter']==1]
    tmean, tstd = get_stats(df_tr) if args.scale else (None, None)
    tr_ds = RNADataset(df_tr, True, rev_aug=args.rev_aug, clip=args.clip, tmean=tmean, tstd=tstd)
    va_ds = RNADataset(df_va, True)
    tr_dl = DataLoader(tr_ds, batch_size=args.batch_size, shuffle=True, num_workers=4, drop_last=True)
    va_dl = DataLoader(va_ds, batch_size=args.batch_size, shuffle=False, num_workers=4)
    model = RNAModel(args.conv_ch, args.rnn_hidden, args.rnn_layers, args.dropout).to(dev)
    opt = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.wd)
    steps = len(tr_dl)*args.epochs
    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=args.lr, total_steps=steps, pct_start=0.1)
    best = 1e9; best_state = None; best_ep = -1
    for ep in range(args.epochs):
        model.train(); t0=time.time(); tot=0; n=0
        for x,y,m in tr_dl:
            x,y,m = x.to(dev),y.to(dev),m.to(dev)
            p = model(x)
            if args.loss == 'huber':
                el = torch.nn.functional.smooth_l1_loss(p, y, beta=1.0, reduction='none')
            else:
                el = (p-y)**2
            w = torch.tensor([1.,1.,args.aux_weight,1.,args.aux_weight], device=dev).view(1,1,5)
            loss = ((el*w).mean(-1)*m).sum()/m.sum()
            opt.zero_grad(); loss.backward()
            nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            opt.step(); sched.step()
            tot += loss.item()*x.size(0); n += x.size(0)
        # validate
        model.eval(); preds=[]; ys=[]; ms=[]
        with torch.no_grad():
            for x,y,m in va_dl:
                p = model(x.to(dev))
                preds.append(p.cpu().numpy()); ys.append(y.numpy()); ms.append(m.numpy())
        P=np.concatenate(preds); Y=np.concatenate(ys); M=np.concatenate(ms)
        if tmean is not None:
            P = P*tstd + tmean
        sc = np.mean([np.sqrt((((Y[...,c]-P[...,c])**2)*M).sum()/M.sum()) for c in (0,1,3)])
        snm = (df_va['SN_filter'].values==1).astype(np.float32)
        Ms = M*snm[:,None]
        scsn = np.mean([np.sqrt((((Y[...,c]-P[...,c])**2)*Ms).sum()/Ms.sum()) for c in (0,1,3)])
        sel = scsn if args.select_sn else sc
        if sel < best:
            best=sel; best_ep=ep
            best_state={k:v.detach().cpu().clone() for k,v in model.state_dict().items()}
        if ep % 5 == 0 or sel <= best:
            print(f"  fold{fold} ep{ep:02d} loss {tot/n:.4f} val {sc:.5f} sn {scsn:.5f} best {best:.5f} ({time.time()-t0:.1f}s)", flush=True)
    model.load_state_dict(best_state)
    return model, best, best_ep


def predict(model, df, args, tmean=None, tstd=None):
    ds = RNADataset(df, False)
    dl = DataLoader(ds, batch_size=args.batch_size, shuffle=False, num_workers=4)
    model.eval(); out=[]
    with torch.no_grad():
        for x in dl:
            out.append(model(x.to(args.device)).cpu().numpy())
    out = np.concatenate(out)
    if tmean is not None:
        out = out*tstd + tmean
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--epochs', type=int, default=40)
    ap.add_argument('--batch_size', type=int, default=64)
