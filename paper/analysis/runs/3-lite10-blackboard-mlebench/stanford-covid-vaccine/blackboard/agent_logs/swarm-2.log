import numpy as np,pandas as pd,sys
tr=pd.read_json('data/train.json',lines=True)
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
Y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32); y=Y[:,:,[0,1,3]]
snf=tr['SN_filter'].values.astype(bool); sn=tr['signal_to_noise'].values>1.0
def mcr(p,t,clip=None):
    m=np.ones((len(t),68),bool); v=[]
    for c in range(3):
        pp=p[:,:,c][m].copy(); tt=t[:,:,c][m]
        if clip is not None: pp=np.maximum(pp,clip)
        v.append(np.sqrt(np.mean((pp-tt)**2)))
    return round(float(np.mean(v)),4),[round(x,4) for x in v]
for path in sys.argv[1:]:
    p=np.load(path)
    print(path.split('/')[-1],'SNf',mcr(p[snf],y[snf]),'SNfclip',mcr(p[snf],y[snf],-0.5),'sn1',mcr(p[sn],y[sn]))
EOF
