import numpy as np, pandas as pd, itertools, json
OUT='workspaces/fomalhaut_zeta/oof'; DATA='data'
tr=pd.read_json(DATA+'/train.json',lines=True)
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
Y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32); y=Y[:,:,[0,1,3]]
snf=tr['SN_filter'].values.astype(bool)
names=['erraw12','mcr6','wide','erraw9','werr6','fwd9','noaug','snf']
O=np.stack([np.load(f'{OUT}/oof_lstm_{n}.npy') for n in names])
T=np.stack([np.load(f'{OUT}/test_lstm_{n}.npy') for n in names])
def mcr(p):
    m=np.ones((snf.sum(),68),bool)
    return float(np.mean([np.sqrt(np.mean((p[:,:,c][m]-y[snf,:,c][m])**2)) for c in range(3)]))
best=(9e9,None)
for r in range(1,len(names)+1):
    for combo in itertools.combinations(range(len(names)),r):
        p=O[list(combo)].mean(0)
        s=mcr(p[snf])
        if s<best[0]: best=(s,combo)
print('best subset',best[0],[names[i] for i in best[1]])
combo=list(best[1])
np.save(f'{OUT}/oof_lstm_avg.npy',O[combo].mean(0).astype(np.float32))
np.save(f'{OUT}/test_lstm_avg.npy',T[combo].mean(0).astype(np.float32))
# full 5-col avg for those tags
for kind in ['oof5','test5']:
    arrs=[np.load(f'{OUT}/{kind}_lstm_{names[i]}.npy') for i in combo]
    np.save(f'{OUT}/{kind}_lstm_avg.npy',np.mean(arrs,0).astype(np.float32))
print('saved avg')
EOF
