import os, json, argparse, glob, numpy as np, pandas as pd
from sklearn.model_selection import KFold
from sklearn.linear_model import Ridge
ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data')
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']; SC=[0,1,3]

def load_truth():
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True)
    y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32)[:,:,[0,1,3]]
    return y, tr['signal_to_noise'].values

def mcr(p,t,mask):
    return float(np.mean([np.sqrt(np.mean((p[:,:,c][mask]-t[:,:,c][mask])**2)) for c in range(3)]))

def greedy_blend(oofs, y, mask, iters=30):
    # greedy Caruana with replacement, minimize MCRMSE
    n=len(oofs); chosen=[]; best=1e9
    cur=np.zeros_like(y)
    for it in range(iters):
        bc=None
        for k in range(n):
            cand=(cur*len(chosen)+oofs[k])/(len(chosen)+1)
            s=mcr(cand,y,mask)
            if s<best-1e-6: best=s; bc=k
        if bc is None: break
        cur=(cur*len(chosen)+oofs[bc])/(len(chosen)+1); chosen.append(bc)
    w=np.zeros(n)
    for c in chosen: w[c]+=1.0/len(chosen)
    return w,best

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--models',nargs='+',required=True,help='name=oofpath,testpath pairs e.g. deneb=path1,path2')
    ap.add_argument('--out',default='')
    args=ap.parse_args()
    y,sn=load_truth(); N=len(y); snm=sn>1
    names=[]; oofs=[]; tests=[]
    for spec in args.models:
        nm,paths=spec.split('=',1); op,tp=paths.split(',')
        o=np.load(op); t=np.load(tp)
        assert o.shape==(N,68,3), (nm,o.shape)
        names.append(nm); oofs.append(o.astype(np.float32)); tests.append(t.astype(np.float32))
    oofs=np.stack(oofs); tests=np.stack(tests)
    print('models',names)
    for i,nm in enumerate(names):
        print(f'  {nm:24s} SN {mcr(oofs[i],y,np.ones((N,68),bool),):.4f}'.replace(': .4f',''))
    # equal avg on SN
    eq=oofs.mean(0); print('equal avg SN',round(mcr(eq,y,snm[:,None].repeat(68,1)),4))
    # nested CV ridge per column
    splits=list(KFold(5,shuffle=True,random_state=42).split(np.arange(N)))
    pred_cv=np.zeros_like(y)
    for tr_i,va_i in splits:
        tri=tr_i[sn[tr_i]>1]; vai=va_i[sn[va_i]>1]
        Xtr=oofs[:,tri,:].reshape(len(names),-1).T; Xva=oofs[:,vai,:].reshape(len(names),-1).T
        for c in range(3):
            r=Ridge(alpha=1e-3,positive=True,fit_intercept=True)
            r.fit(Xtr[:,c::3],y[tri,:,c].reshape(-1))
            pred_cv[vai,:,c]=r.predict(Xva[:,c::3]).reshape(len(vai),68)
    m_cv=np.ones((snm.sum(),68),bool)
    print('nested ridge SN',round(mcr(pred_cv[snm],y[snm],m_cv),4))
    # fit final ridge on all SN, apply to test
    tri=np.where(sn>1)[0]
    X=oofs[:,tri,:].reshape(len(names),-1).T
    coefs=[]
    for c in range(3):
        r=Ridge(alpha=1e-3,positive=True,fit_intercept=True); r.fit(X[:,c::3],y[tri,:,c].reshape(-1))
        coefs.append((r.coef_.copy(),float(r.intercept_)))
        print('col',c,'coef',dict(zip(names,np.round(r.coef_,3))),'b',round(float(r.intercept_),3))
    Xt=tests.reshape(len(names),-1).T
    test_pred=np.zeros((tests.shape[1],68,3),np.float32)
    for c in range(3):
        co,b=coefs[c]; test_pred[:,:,c]=(Xt[:,c::3]@co+b).reshape(tests.shape[1],68)
    test_pred=np.maximum(test_pred,-0.5)
    if args.out:
        np.save(args.out,test_pred); print('saved',args.out)
    # also greedy
    w,sc=greedy_blend(oofs,y,snm[:,None].repeat(68,1))
    print('greedy SN',round(sc,4),'weights',dict(zip(names,np.round(w,3))))
main()
