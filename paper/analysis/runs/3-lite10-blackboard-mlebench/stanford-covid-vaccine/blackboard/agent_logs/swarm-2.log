[0m$ [0mcd /download_job_code/payload/sandbox && cat > workspaces/fomalhaut_zeta/blend.py <<'EOF'
import os, json, argparse, numpy as np, pandas as pd
from sklearn.model_selection import KFold
from scipy.optimize import nnls
ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data')
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']

def load_truth():
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True)
    Y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32)
    y=Y[:,:,[0,1,3]]
    return y, tr['SN_filter'].values.astype(bool)

def mcr(p,t,mask,clip=None):
    vals=[]
    for c in range(3):
        pp=p[:,:,c][mask].copy(); tt=t[:,:,c][mask]
        if clip is not None: pp=np.maximum(pp,clip)
        vals.append(np.sqrt(np.mean((pp-tt)**2)))
    return float(np.mean(vals))

def greedy_blend(oofs, y, mask, iters=40):
    n=len(oofs); chosen=[]; best=1e9; cur=np.zeros_like(y)
    for it in range(iters):
        bc=None
        for k in range(n):
            cand=(cur*len(chosen)+oofs[k])/(len(chosen)+1)
            s=mcr(cand,y,mask)
            if s<best-1e-6: best=s; bc=k
        if bc is None: break
        cur=(cur*len(chosen)+oofs[bc])/(len(chosen)+1); chosen.append(bc)
    w=np.zeros(n)
    for c in chosen: w[c]+=1.0/len(chosen)
    return w,best

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--models',nargs='+',required=True)
    ap.add_argument('--out',default='')
    ap.add_argument('--iters',type=int,default=40)
    args=ap.parse_args()
    y,snf=load_truth(); N=len(y); mask=np.ones((snf.sum(),68),bool)
    names=[]; oofs=[]; tests=[]
    for spec in args.models:
        nm,paths=spec.split('=',1); op,tp=paths.split(',')
        o=np.load(op); t=np.load(tp)
        assert o.shape==(N,68,3),(nm,o.shape); assert t.shape[1:]==(68,3),(nm,t.shape)
        names.append(nm); oofs.append(o.astype(np.float32)); tests.append(t.astype(np.float32))
    oofs=np.stack(oofs); tests=np.stack(tests)
    print('models',names)
    for i,nm in enumerate(names):
        print(f'  {nm:22s} SNfilter {mcr(oofs[i][snf],y[snf],mask):.4f}  all {mcr(oofs[i],y,np.ones((N,68),bool)):.4f}')
    print('equal avg SNfilter',round(mcr(oofs.mean(0)[snf],y[snf],mask),4))
    # nested CV nnls
    splits=list(KFold(5,shuffle=True,random_state=42).split(np.arange(N)))
    pcv=np.zeros_like(y)
    for tr_i,va_i in splits:
        tri=np.where(snf[tr_i])[0]; tri=tr_i[snf[tr_i]]; vai=va_i[snf[va_i]]
        for c in range(3):
            Xtr=oofs[:,tri,:,c].transpose(1,2,0).reshape(-1,len(names))
            Xva=oofs[:,vai,:,c].transpose(1,2,0).reshape(-1,len(names))
            w,_=nnls(Xtr,y[tri,:,c].reshape(-1))
            pcv[vai,:,c]=(Xva@w).reshape(len(vai),68)
    print('nested nnls SNfilter',round(mcr(pcv[snf],y[snf],mask),4))
    # final weights
    tri=np.where(snf)[0]; W=[]
    for c in range(3):
        Xc=oofs[:,tri,:,c].transpose(1,2,0).reshape(-1,len(names))
        w,_=nnls(Xc,y[tri,:,c].reshape(-1)); W.append(w)
        print('col',c,'w',dict(zip(names,np.round(w,3))))
    tp=np.zeros((tests.shape[1],68,3),np.float32)
    for c in range(3):
        X=tests[:,:,:,c].transpose(1,2,0).reshape(-1,len(names))
        tp[:,:,c]=(X@W[c]).reshape(tests.shape[1],68)
    tp=np.maximum(tp,-0.5)
    if args.out: np.save(args.out,tp); print('saved',args.out)
    w,sc=greedy_blend(oofs,y,mask,args.iters)
    print('greedy SNfilter',round(sc,4),'w',dict(zip(names,np.round(w,3))))
    # greedy test
    tg=np.tensordot(w,tests,axes=(0,0)); tg=np.maximum(tg,-0.5)
    if args.out: np.save(args.out.replace('.npy','_greedy.npy'),tg)
main()
