import os, json, time, argparse, random
import numpy as np, pandas as pd
import torch, torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import KFold
ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data'); OUT=os.path.join(ROOT,'workspaces/fomalhaut_zeta')
TGT5=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
ERR5=['reactivity_error','deg_error_Mg_pH10','deg_error_pH10','deg_error_Mg_50C','deg_error_50C']
SEQ_V='AGUC'; STR_V='.()'; LOOP_V='ESMIBHX'
def enc(s,v):
    m={c:i for i,c in enumerate(v)}; return [m.get(c,0) for c in s]
def build_partner(struct):
    n=len(struct); part=[-1]*n; st=[]
    for i,ch in enumerate(struct):
        if ch=='(': st.append(i)
        elif ch==')' and st: j=st.pop(); part[i]=j; part[j]=i
    return part
def featurize(df):
    seqs=df['sequence'].tolist(); sts=df['structure'].tolist(); lps=df['predicted_loop_type'].tolist()
    pb=[]; pd=[]
    for s,st in zip(seqs,sts):
        part=build_partner(st); b=[]; d=[]
        for i in range(len(s)):
            j=part[i]
            if j<0: b.append(4); d.append(6)
            else:
                b.append(enc(s[j],SEQ_V)[0]); dd=abs(i-j)
                d.append(0 if dd<=2 else 1 if dd<=5 else 2 if dd<=10 else 3 if dd<=20 else 4 if dd<=40 else 5)
        pb.append(b); pd.append(d)
    return seqs,sts,lps,pb,pd
class DS(Dataset):
    def __init__(self, feats, y=None, w=None, augment=False):
        self.s,self.st,self.lp,self.pb,self.pd=feats; self.y=y; self.w=w; self.aug=augment
    def __len__(self): return len(self.s)
    def __getitem__(self,i):
        n=len(self.s[i])
        x=np.stack([enc(self.s[i],SEQ_V),enc(self.st[i],STR_V),enc(self.lp[i],LOOP_V),self.pb[i],self.pd[i],list(range(n))],1).astype(np.int64)
        if self.y is None: return x
        yy=self.y[i].astype(np.float32); ww=self.w[i].astype(np.float32)
        if self.aug and random.random()<0.5:
            x=x[::-1].copy(); c=x[:,1].copy(); c[c==1]=2; c[c==2]=1; x[:,1]=c; x[:,5]=np.arange(n)
            yy=yy[::-1].copy(); ww=ww[::-1].copy()
        return x,yy,ww
class Net(nn.Module):
    def __init__(self,d=100,h=256,layers=3,drop=0.3):
        super().__init__()
        self.e0=nn.Embedding(len(SEQ_V),d); self.e1=nn.Embedding(len(STR_V),d); self.e2=nn.Embedding(len(LOOP_V),d)
        self.conv=nn.Conv1d(3*d,h,5,padding=2)
        self.lstm=nn.LSTM(h,h,num_layers=layers,batch_first=True,bidirectional=True,dropout=drop)
        self.drop=nn.Dropout(drop); self.fc=nn.Linear(2*h,5)
    def forward(self,x):
        e=torch.cat([self.e0(x[:,:,0]),self.e1(x[:,:,1]),self.e2(x[:,:,2])],-1)
        e=torch.relu(self.conv(e.transpose(1,2))).transpose(1,2); o,_=self.lstm(e); return self.fc(self.drop(o))
def mcrmse(pred,tgt,mask,clip=None):
    v=[]
    for c in (0,1,3):
        p=pred[:,:,c][mask].copy(); t=tgt[:,:,c][mask]
        if clip is not None: p=np.maximum(p,clip)
        v.append(np.sqrt(np.mean((p-t)**2)))
    return float(np.mean(v))
def wloss(pred,tgt,mask,W):
    # W (B,107,5) already normalized; mask (B,107)
    m=mask.unsqueeze(-1)
    num=0.; den=0.
    wts=(1.,1.,0.5,1.,0.5)
    for c in range(5):
        w=W[:,:,c]*m[:,:,0]*wts[c]
        num=num+ (w*(pred[:,:,c]-tgt[:,:,c])**2).sum(); den=den+w.sum()
    return num/den
def predict_ds(net,ds):
    dl=DataLoader(ds,batch_size=128,shuffle=False,num_workers=2); pr=[]; net.eval()
    with torch.no_grad():
        for batch in dl:
            xb=batch[0].to('cuda')
            with torch.cuda.amp.autocast(): o=net(xb)
            pr.append(o.float().cpu().numpy())
    return np.concatenate(pr,0)
def run_fold(args,tr_idx,va_idx,feats,ystd,yorig,W,seed):
    torch.manual_seed(seed); np.random.seed(seed); random.seed(seed); dev='cuda'
    dtr=DS([ [f[i] for i in tr_idx] for f in feats], ystd[tr_idx], W[tr_idx], augment=bool(args.aug))
    dva=DS([ [f[i] for i in va_idx] for f in feats], yorig[va_idx], W[va_idx])
    ltr=DataLoader(dtr,batch_size=args.bs,shuffle=True,num_workers=2,drop_last=True)
    lva=DataLoader(dva,batch_size=128,shuffle=False,num_workers=2)
    net=Net(args.d,args.h,args.layers,args.drop).to(dev)
    opt=torch.optim.AdamW(net.parameters(),lr=args.lr,weight_decay=args.wd)
    sched=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=args.epochs,eta_min=args.lr*0.02)
    scaler=torch.cuda.amp.GradScaler(); m68=torch.zeros(107,dtype=torch.float32); m68[:68]=1
    snf=feats_snf; snva=snf[va_idx]; best=9e9; bs=None; be=0; bad=0
    for ep in range(args.epochs):
        net.train(); tl=0; n=0
        for xb,yb,wb in ltr:
            xb=xb.to(dev); yb=yb.to(dev); wb=wb.to(dev); m=m68.to(dev).expand(xb.size(0),107)
            opt.zero_grad()
            with torch.cuda.amp.autocast(): loss=wloss(net(xb),yb,m,wb)
            scaler.scale(loss).backward(); scaler.unscale_(opt); torch.nn.utils.clip_grad_norm_(net.parameters(),1.0)
            scaler.step(opt); scaler.update(); tl+=loss.item()*xb.size(0); n+=xb.size(0)
        sched.step(); net.eval(); pr=[]
        with torch.no_grad():
            for xb,yb,wb in lva:
                with torch.cuda.amp.autocast(): o=net(xb.to(dev))
                pr.append(o.float().cpu().numpy())
        pred=np.concatenate(pr,0); yv=yorig[va_idx]
        mk=np.ones((snva.sum(),107),bool); mk[:,68:]=False
        sc=mcrmse(pred[snva],yv[snva],mk,clip=-0.5)
        if sc<best-1e-5: best=sc; be=ep; bs={k:v.detach().cpu().clone() for k,v in net.state_dict().items()}; bad=0
        else: bad+=1
        if ep%10==0 or bad>=args.patience: print(f"   ep{ep:03d} loss{tl/max(n,1):.4f} snval{sc:.4f} best{best:.4f}@{be}",flush=True)
        if bad>=args.patience: break
    net.load_state_dict(bs); net.eval(); oofp=predict_ds(net,dva)
    return best,be,oofp,net
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=int,default=5); ap.add_argument('--fold',type=int,default=-1)
    ap.add_argument('--epochs',type=int,default=90); ap.add_argument('--patience',type=int,default=20)
    ap.add_argument('--bs',type=int,default=64); ap.add_argument('--d',type=int,default=100)
    ap.add_argument('--h',type=int,default=256); ap.add_argument('--layers',type=int,default=3)
    ap.add_argument('--drop',type=float,default=0.3); ap.add_argument('--lr',type=float,default=1e-3)
    ap.add_argument('--wd',type=float,default=1e-4); ap.add_argument('--seeds',type=int,default=1)
    ap.add_argument('--seed_base',type=int,default=42); ap.add_argument('--aug',type=int,default=1)
    ap.add_argument('--tag',type=str,default='lstm_w'); ap.add_argument('--save',type=int,default=1)
    ap.add_argument('--wclip',type=float,default=5.0)
    args=ap.parse_args()
    global feats_snf
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True); te=pd.read_json(os.path.join(DATA,'test.json'),lines=True)
    feats_tr=featurize(tr); feats_te=featurize(te)
    Y=np.stack([np.stack(tr[t].values) for t in TGT5],-1).astype(np.float32)
    E=np.stack([np.stack(tr[t].values) for t in ERR5],-1).astype(np.float32)
    yfull=np.zeros((len(tr),107,5),np.float32); yfull[:,:68]=Y
    W=np.ones((len(tr),107,5),np.float32)
    ww=1.0/(E**2+0.02); ww=ww/ww.mean((0,1),keepdims=True); ww=np.clip(ww,0.05,args.wclip)
    W[:,:68,:]=ww
    feats_snf=tr['SN_filter'].values.astype(bool)
    N=len(tr); splits=list(KFold(5,shuffle=True,random_state=42).split(np.arange(N)))
    oof=np.zeros((N,107,5),np.float32); cnt=np.zeros(N,np.float32); test=np.zeros((len(te),107,5),np.float32); nm=0
    folds=range(5) if args.fold<0 else [args.fold]; allb=[]
    for f in folds:
        tr_idx,va_idx=splits[f]
        # train on SN>1 (loose) like the winning recipe
        tr_idx=tr_idx[tr['signal_to_noise'].values[tr_idx]>1.0]
        for sd in range(args.seeds):
            t0=time.time(); print(f"[fold {f} seed {sd}] ntr={len(tr_idx)}",flush=True)
            best,be,oofp,net=run_fold(args,tr_idx,va_idx,feats_tr,yfull,yfull,W,args.seed_base+sd)
            oof[va_idx]+=oofp; cnt[va_idx]+=1; allb.append(best)
            test+=predict_ds(net,DS(feats_te)); nm+=1
            print(f"[fold {f} seed {sd}] best {best:.4f} @ep{be} {time.time()-t0:.0f}s",flush=True)
    oof/=np.maximum(cnt[:,None,None],1); test/=max(nm,1)
    m68=np.zeros((N,107),bool); m68[:,:68]=True
    print('OOF SNfilter',round(mcrmse(oof[feats_snf],yfull[feats_snf],m68[feats_snf]),4),'all',round(mcrmse(oof,yfull,m68),4))
    if args.save:
        os.makedirs(os.path.join(OUT,'oof'),exist_ok=True)
        np.save(os.path.join(OUT,f'oof/oof_{args.tag}.npy'),oof[:,:68,:][:,:,[0,1,3]].astype(np.float32))
        np.save(os.path.join(OUT,f'oof/test_{args.tag}.npy'),test[:,:68,:][:,:,[0,1,3]].astype(np.float32))
        np.save(os.path.join(OUT,f'oof/oof5_{args.tag}.npy'),oof.astype(np.float32))
        np.save(os.path.join(OUT,f'oof/test5_{args.tag}.npy'),test.astype(np.float32))
        json.dump({'args':vars(args),'oof_snf':mcrmse(oof[feats_snf],yfull[feats_snf],m68[feats_snf]),'bests':allb},open(os.path.join(OUT,f'oof/meta_{args.tag}.json'),'w'),indent=2,default=str)
main()
EOF
