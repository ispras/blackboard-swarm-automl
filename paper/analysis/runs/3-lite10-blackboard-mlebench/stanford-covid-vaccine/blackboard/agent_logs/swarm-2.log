def mcrmse(pred,tgt,mask,clip=None):
    v=[]
    for c in (0,1,3):
        p=pred[:,:,c][mask].copy(); t=tgt[:,:,c][mask]
        if clip is not None: p=np.maximum(p,clip)
        v.append(np.sqrt(np.mean((p-t)**2)))
    return float(np.mean(v))
def wloss_mcr(pred,tgt,mask,W):
