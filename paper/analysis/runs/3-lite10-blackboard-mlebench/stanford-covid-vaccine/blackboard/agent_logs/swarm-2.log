import os, argparse, numpy as np, pandas as pd
from sklearn.model_selection import KFold
ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data')
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
def load_truth():
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True)
    Y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32)
    return Y[:,:,[0,1,3]], tr['SN_filter'].values.astype(bool)
def mcr(p,t):
    mask=np.ones((len(t),68),bool)
    return float(np.mean([np.sqrt(np.mean((p[:,:,c][mask]-t[:,:,c][mask])**2)) for c in range(3)]))
def greedy(oofs,y,snf,iters=60):
    mask=np.ones((snf.sum(),68),bool); n=len(oofs); chosen=[]; best=1e9; cur=np.zeros_like(y)
    for it in range(iters):
        bc=None
        for k in range(n):
            cand=(cur*len(chosen)+oofs[k])/(len(chosen)+1)
            s=mcr(cand[snf],y[snf])
            if s<best-1e-6: best=s; bc=k
        if bc is None: break
        cur=(cur*len(chosen)+oofs[bc])/(len(chosen)+1); chosen.append(bc)
    w=np.zeros(n)
    for c in chosen: w[c]+=1.0/max(len(chosen),1)
    return w,best
def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--models',nargs='+',required=True); ap.add_argument('--out',default=''); ap.add_argument('--iters',type=int,default=60)
    a=ap.parse_args(); y,snf=load_truth(); N=len(y)
    names=[];oofs=[];tests=[]
    for spec in a.models:
        nm,paths=spec.split('=',1); op,tp=paths.split(','); o=np.load(op); t=np.load(tp)
        assert o.shape==(N,68,3); names.append(nm); oofs.append(o.astype(np.float32)); tests.append(t.astype(np.float32))
    oofs=np.stack(oofs); tests=np.stack(tests)
    print('models',names)
    for i,nm in enumerate(names): print(f'  {nm:22s} SNf {mcr(oofs[i][snf],y[snf]):.4f}  all {mcr(oofs[i],y):.4f}')
    print('equal avg SNf',round(mcr(oofs.mean(0)[snf],y[snf]),4))
    w,sc=greedy(oofs,y,snf,a.iters)
    print('greedy SNf',round(sc,4),'w',dict(zip(names,np.round(w,3))))
    tg=np.tensordot(w,tests,axes=(0,0)); tg=np.maximum(tg,-0.5)
    tp=np.maximum(oofs.mean(0),-0.5); te=np.maximum(tests.mean(0),-0.5)
    if a.out:
        np.save(a.out,tg); np.save(a.out.replace('.npy','_avg.npy'),te); print('saved',a.out)
main()
