import os, sys, argparse, numpy as np, pandas as pd
ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data'); OUT=os.path.join(ROOT,'workspaces/fomalhaut_zeta','oof')
COLS=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--test5',default=os.path.join(OUT,'test5_lstm_tta.npy'))
    ap.add_argument('--out',default=os.path.join(ROOT,'final_solution','submission.csv'))
    ap.add_argument('--clip',type=float,default=-0.5)
    a=ap.parse_args()
    te=pd.read_json(os.path.join(DATA,'test.json'),lines=True)
    p=np.load(a.test5)  # (240,107,5)
    assert p.shape==(len(te),107,5), p.shape
    if a.clip is not None: p=np.maximum(p,a.clip)
    ids=[]
    for i in range(len(te)):
        for pos in range(107): ids.append(f"{te['id'].iloc[i]}_{pos}")
    df=pd.DataFrame({'id_seqpos':ids})
    for j,c in enumerate(COLS): df[c]=p[:,:,j].reshape(-1)
    # align to sample_submission order (should already match, but enforce)
    ss=pd.read_csv(os.path.join(DATA,'sample_submission.csv'),usecols=['id_seqpos'])
    df=df.set_index('id_seqpos').loc[ss['id_seqpos']].reset_index()
    os.makedirs(os.path.dirname(a.out),exist_ok=True)
    df.to_csv(a.out,index=False)
    print('wrote',a.out,df.shape)
main()
EOF
