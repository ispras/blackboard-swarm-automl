import os, sys, json, time, argparse, random
import numpy as np, pandas as pd
import torch, torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import KFold

ROOT = '/download_job_code/payload/sandbox'
DATA = os.path.join(ROOT, 'data')
OUT = os.path.join(ROOT, 'workspaces/fomalhaut_zeta')
TGT5 = ['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
SCORED = [0,1,3]

SEQ_V = "AGUC"; STR_V = ".()"; LOOP_V = "ESMI BHX".replace(" ","")
def enc(s, vocab):
    m = {c:i for i,c in enumerate(vocab)}
    return [m.get(c,0) for c in s]

class RnaDS(Dataset):
    def __init__(self, seq, struct, loop, y=None, augment=False):
        self.seq, self.struct, self.loop, self.y, self.aug = seq, struct, loop, y, augment
    def __len__(self): return len(self.seq)
    def __getitem__(self, i):
        s = enc(self.seq[i], SEQ_V)
        st = enc(self.struct[i], STR_V)
        lp = enc(self.loop[i], LOOP_V)
        x = np.stack([s,st,lp],1).astype(np.int64)
        if self.y is None:
            return x
        yy = self.y[i].astype(np.float32)
        if self.aug and random.random() < 0.5:
            x = x[::-1].copy()
            # swap structure parens
            col = x[:,1].copy()
            col[col==1] = 2; col[col==2] = 1
            x[:,1] = col
            yy = yy[::-1].copy()
        return x, yy

class Net(nn.Module):
    def __init__(self, d=100, h=256, layers=4, drop=0.3):
        super().__init__()
        self.es = nn.Embedding(len(SEQ_V), d)
        self.et = nn.Embedding(len(STR_V), d)
        self.el = nn.Embedding(len(LOOP_V), d)
        self.conv = nn.Conv1d(3*d, h, 5, padding=2)
        self.lstm = nn.LSTM(h, h, num_layers=layers, batch_first=True, bidirectional=True, dropout=drop)
        self.drop = nn.Dropout(drop)
        self.fc = nn.Linear(2*h, 5)
    def forward(self, x):
        e = torch.cat([self.es(x[:,:,0]), self.et(x[:,:,1]), self.el(x[:,:,2])], -1)
        e = torch.relu(self.conv(e.transpose(1,2))).transpose(1,2)
        o,_ = self.lstm(e)
        return self.fc(self.drop(o))

def mcrmse(pred, tgt, mask, cols=(0,1,3)):
    # pred,tgt (N,107,5) numpy, mask (N,107) bool
    vals=[]
    for c in cols:
        p=pred[:,:,c][mask]; t=tgt[:,:,c][mask]
        vals.append(np.sqrt(np.mean((p-t)**2)))
    return float(np.mean(vals))

def masked_loss(pred, tgt, mask, w=None):
    if w is None: w = torch.tensor([1.,1.,0.5,1.,0.5])
    loss = 0.
    for c in range(5):
        p=pred[:,:,c]; t=tgt[:,:,c]
        m=mask
        loss = loss + w[c]*(((p-t)**2)*m).sum()/m.sum()
    return loss/w.sum()

def train_fold(args, tr_idx, va_idx, data, seed):
    torch.manual_seed(seed); np.random.seed(seed); random.seed(seed)
    dev='cuda'
    seq,struct,loop,y = data
    dtr = RnaDS([seq[i] for i in tr_idx],[struct[i] for i in tr_idx],[loop[i] for i in tr_idx], y[tr_idx], augment=True)
    dva = RnaDS([seq[i] for i in va_idx],[struct[i] for i in va_idx],[loop[i] for i in va_idx], y[va_idx])
    ltr = DataLoader(dtr,batch_size=args.bs,shuffle=True,num_workers=2,drop_last=True)
    lva = DataLoader(dva,batch_size=args.bs,shuffle=False,num_workers=2)
    net=Net(args.d,args.h,args.layers,args.drop).to(dev)
    opt=torch.optim.AdamW(net.parameters(),lr=args.lr,weight_decay=args.wd)
    sched=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=args.epochs,eta_min=args.lr*0.01)
    scaler=torch.cuda.amp.GradScaler()
    mask68 = torch.zeros(107,dtype=torch.float32); mask68[:68]=1
    best=9e9; best_state=None; best_ep=0
    for ep in range(args.epochs):
        net.train(); tl=0; n=0
        for xb,yb in ltr:
            xb=xb.to(dev); yb=yb.to(dev); m=mask68.to(dev).expand(xb.size(0),107)
            opt.zero_grad()
            with torch.cuda.amp.autocast():
                out=net(xb); loss=masked_loss(out,yb,m)
            scaler.scale(loss).backward(); scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(net.parameters(),1.0)
            scaler.step(opt); scaler.update()
            tl+=loss.item()*xb.size(0); n+=xb.size(0)
        sched.step()
        # validate
        net.eval(); preds=[]
        with torch.no_grad():
            for xb,yb in lva:
                xb=xb.to(dev)
                with torch.cuda.amp.autocast(): out=net(xb)
                preds.append(out.float().cpu().numpy())
        pred=np.concatenate(preds,0)
        yv=y[va_idx]
        mk=np.zeros_like(yv,dtype=bool); mk[:,:68]=True
        sc=mcrmse(pred,yv,mk)
        if sc<best: best=sc; best_ep=ep; best_state={k:v.detach().cpu().clone() for k,v in net.state_dict().items()}
        if ep%10==0 or ep==args.epochs-1:
            print(f"  ep{ep:03d} loss{tl/n:.4f} val_mcrmse{sc:.4f} best{best:.4f}@{best_ep}",flush=True)
    net.load_state_dict(best_state); net.eval()
    # OOF preds (all 107)
    preds=[]
    with torch.no_grad():
        for xb,yb in lva:
            xb=xb.to(dev)
            with torch.cuda.amp.autocast(): out=net(xb)
            preds.append(out.float().cpu().numpy())
    oof=np.concatenate(preds,0).astype(np.float32)
    return best, oof, net

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=int,default=5)
    ap.add_argument('--fold',type=int,default=-1)
    ap.add_argument('--epochs',type=int,default=100)
    ap.add_argument('--bs',type=int,default=64)
    ap.add_argument('--d',type=int,default=100)
    ap.add_argument('--h',type=int,default=256)
    ap.add_argument('--layers',type=int,default=4)
    ap.add_argument('--drop',type=float,default=0.3)
    ap.add_argument('--lr',type=float,default=1e-3)
    ap.add_argument('--wd',type=float,default=1e-5)
    ap.add_argument('--seeds',type=int,default=1)
    ap.add_argument('--sn_only',type=int,default=0)
    ap.add_argument('--tag',type=str,default='base')
    ap.add_argument('--save',type=int,default=1)
    args=ap.parse_args()
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True)
    te=pd.read_json(os.path.join(DATA,'test.json'),lines=True)
    seq=tr['sequence'].tolist(); struct=tr['structure'].tolist(); loop=tr['predicted_loop_type'].tolist()
    y=np.stack([np.stack(tr[t].values) for t in TGT5],-1).astype(np.float32)  # N,68,5
    yfull=np.zeros((len(tr),107,5),dtype=np.float32); yfull[:,:68]=y
    data=(seq,struct,loop,yfull)
    N=len(tr)
    kf=KFold(n_splits=args.folds,shuffle=True,random_state=42)
    splits=list(kf.split(np.arange(N)))
    oof_all=np.zeros((N,107,5),dtype=np.float32); oof_cnt=np.zeros(N,dtype=np.float32)
    te_seq=te['sequence'].tolist(); te_struct=te['structure'].tolist(); te_loop=te['predicted_loop_type'].tolist()
    te_ds=RnaDS(te_seq,te_struct,te_loop)
    te_l=DataLoader(te_ds,batch_size=128,shuffle=False,num_workers=2)
    test_preds=np.zeros((len(te),107,5),dtype=np.float32); nmodels=0
    folds = range(args.folds) if args.fold<0 else [args.fold]
    scores=[]
    for f in folds:
        tr_idx,va_idx=splits[f]
        if args.sn_only:
            sn=tr['signal_to_noise'].values
            tr_idx=tr_idx[sn[tr_idx]>1.0]
        for sd in range(args.seeds):
            t0=time.time()
            print(f"[fold {f} seed {sd}] train={len(tr_idx)} val={len(va_idx)}",flush=True)
            best,oof,net=train_fold(args,tr_idx,va_idx,data,42+sd)
            oof_all[va_idx]+=oof; oof_cnt[va_idx]+=1
            scores.append(best)
            # test preds
            net.eval(); tp=[]
            with torch.no_grad():
                for xb in te_l:
                    xb=xb.to('cuda')
                    with torch.cuda.amp.autocast(): out=net(xb)
                    tp.append(out.float().cpu().numpy())
            test_preds+=np.concatenate(tp,0); nmodels+=1
            print(f"[fold {f} seed {sd}] best {best:.4f} time {time.time()-t0:.1f}s",flush=True)
    mask=np.zeros(N,dtype=bool); mask[:]=True
    # oof score on sn>1 subset too
    oof_all/=np.maximum(oof_cnt[:,None,None],1)
    m68=np.zeros((N,107),dtype=bool); m68[:,:68]=True
    print('CV MCRMSE all:',mcrmse(oof_all,yfull,m68))
    sn=tr['signal_to_noise'].values
    print('CV MCRMSE sn>1:',mcrmse(oof_all[sn>1],yfull[sn>1],m68[sn>1]))
    print('folds scores',np.round(scores,4))
    test_preds/=max(nmodels,1)
    if args.save:
        os.makedirs(os.path.join(OUT,'oof'),exist_ok=True)
        np.save(os.path.join(OUT,f'oof/oof_{args.tag}.npy'),oof_all)
        np.save(os.path.join(OUT,f'oof/test_{args.tag}.npy'),test_preds)
        with open(os.path.join(OUT,f'oof/meta_{args.tag}.json'),'w') as f:
            json.dump({'args':vars(args),'cv':mcrmse(oof_all,yfull,m68),
                       'cv_sn':mcrmse(oof_all[sn>1],yfull[sn>1],m68[sn>1]),
                       'fold_scores':scores},f,indent=2)
main()
