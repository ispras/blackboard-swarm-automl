import os, json, argparse, numpy as np, pandas as pd, lightgbm as lgb
from sklearn.model_selection import KFold
ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data'); OUT=os.path.join(ROOT,'workspaces/fomalhaut_zeta','oof')
TGT5=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
SEQM='AGUC'; STRM='.()'; LOOPM='ESMIBHX'

def build_partner(struct):
    n=len(struct); partner=[-1]*n; st=[]
    for i,ch in enumerate(struct):
        if ch=='(': st.append(i)
        elif ch==')' and st: j=st.pop(); partner[i]=j; partner[j]=i
    return partner

def single_hot(c,v):
    a=np.zeros(len(v),np.float32)
    if c in v: a[v.index(c)]=1.0
    return a

def featurize(df, W=3, L=107):
    rows=[]; owners=[]
    seqs=df['sequence'].tolist(); sts=df['structure'].tolist(); lps=df['predicted_loop_type'].tolist()
    for idx,(s,st,lp) in enumerate(zip(seqs,sts,lps)):
        part=build_partner(st)
        # precompute onehots
        so=[single_hot(c,SEQM) for c in s]; sto=[single_hot(c,STRM) for c in st]; lo=[single_hot(c,LOOPM) for c in lp]
        for p in range(68):
            f=[]
            for d in range(-W,W+1):
                q=min(max(p+d,0),L-1)
                f.append(so[q]); f.append(sto[q]); f.append(lo[q])
            extra=np.zeros(8,np.float32)
            extra[0]=p/67.0
            j=part[p]
            if j>=0:
                extra[1]=1.0; extra[2]=min(abs(p-j),60)/60.0
                pb=single_hot(s[j],SEQM); extra[3:3+len(pb)]=pb
            f.append(extra)
            rows.append(np.concatenate(f)); owners.append(idx)
    return np.asarray(rows,np.float32), np.asarray(owners,np.int32)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--tag',default='gbdt'); ap.add_argument('--trees',type=int,default=400)
    ap.add_argument('--lr',type=float,default=0.05); ap.add_argument('--leaves',type=int,default=31)
    ap.add_argument('--seeds',type=int,default=1)
    a=ap.parse_args()
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True); te=pd.read_json(os.path.join(DATA,'test.json'),lines=True)
    y=np.stack([np.stack(tr[t].values) for t in TGT5],-1).astype(np.float32)  # N,68,5
    sn=tr['signal_to_noise'].values
    print('featurizing train...',flush=True); Xtr,own=featurize(tr)
    print('featurizing test...',flush=True); Xte,ownte=featurize(te)
    print(Xtr.shape,Xte.shape,flush=True)
    N=len(tr); kf=KFold(5,shuffle=True,random_state=42); splits=list(kf.split(np.arange(N)))
    oof=np.zeros((N,68,3),np.float32)
    test=np.zeros((len(te),68,3),np.float32)
    # row indices per owner
    for f,(tr_idx,va_idx) in enumerate(splits):
        trn=tr_idx[sn[tr_idx]>1.0]
        rtr=np.concatenate([np.where(own==i)[0] for i in trn])
        rva=np.concatenate([np.where(own==i)[0] for i in va_idx])
        for ci,c in enumerate((0,1,3)):
            ytr=y[trn,:,c].reshape(-1)  # aligns with rows for i in trn in order
            # IMPORTANT: build y for rtr in same order as rtr built (owner order trn)
            ytr=np.concatenate([y[i,:,c] for i in trn])
            preds=np.zeros(len(rva),np.float32)
            for sd in range(a.seeds):
                m=lgb.LGBMRegressor(n_estimators=a.trees,learning_rate=a.lr,num_leaves=a.leaves,
                    subsample=0.8,subsample_freq=1,colsample_bytree=0.8,min_child_samples=20,
                    reg_lambda=1.0,n_jobs=4,verbose=-1,random_state=sd)
                m.fit(Xtr[rtr],ytr)
                preds+=m.predict(Xtr[rva])
            preds/=a.seeds
            # scatter into oof
            pos=0
            for i in va_idx:
                npred=68
                oof[i,:,ci]=preds[pos:pos+npred]; pos+=npred
            # test predictions use this fold model? better: average across folds
            for sd in range(a.seeds):
                m=lgb.LGBMRegressor(n_estimators=a.trees,learning_rate=a.lr,num_leaves=a.leaves,
                    subsample=0.8,subsample_freq=1,colsample_bytree=0.8,min_child_samples=20,
                    reg_lambda=1.0,n_jobs=4,verbose=-1,random_state=sd+100)
                m.fit(Xtr[rtr],ytr)
                pt=m.predict(Xte).reshape(len(te),68)
                test[:,:,ci]+=pt/(5.0*a.seeds)
        print('fold',f,'done',flush=True)
    y3=y[:,:,[0,1,3]]
    def mcr(p,t,mask):
        return float(np.mean([np.sqrt(np.mean((p[:,:,c][mask]-t[:,:,c][mask])**2)) for c in range(3)]))
    m=np.ones((N,68),bool); snm=sn>1; mn=np.ones((snm.sum(),68),bool)
    print('OOF all',round(mcr(oof,y3,m),4),'OOF SN',round(mcr(oof[snm],y3[snm],mn),4))
    os.makedirs(OUT,exist_ok=True)
    np.save(os.path.join(OUT,f'oof_{a.tag}.npy'),oof); np.save(os.path.join(OUT,f'test_{a.tag}.npy'),test.astype(np.float32))
    json.dump({'oof_all':mcr(oof,y3,m),'oof_sn':mcr(oof[snm],y3[snm],mn),'args':vars(a)},open(os.path.join(OUT,f'meta_{a.tag}.json'),'w'),indent=2)
main()
EOF
