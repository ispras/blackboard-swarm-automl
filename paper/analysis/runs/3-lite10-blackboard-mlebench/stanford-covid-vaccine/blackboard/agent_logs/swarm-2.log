        w=W[:,:,c]*m[:,:,0]*wts[c]
        vals.append(torch.sqrt((w*(pred[:,:,c]-tgt[:,:,c])**2).sum()/w.sum()+1e-6))
    return torch.stack(vals).mean()

def wloss(pred,tgt,mask,W):""")
