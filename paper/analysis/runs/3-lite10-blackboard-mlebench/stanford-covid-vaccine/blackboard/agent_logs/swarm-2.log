import numpy as np, pandas as pd
from sklearn.model_selection import KFold
tr=pd.read_json('data/train.json',lines=True)
oof=np.load('workspaces/fomalhaut_zeta/oof/oof5_lstm_tta.npy')
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32)
yf=np.zeros((len(tr),107,5),np.float32); yf[:,:68]=y
sn=tr['signal_to_noise'].values
def mcr(p,t,mask,cols=(0,1,3)):
    return float(np.mean([np.sqrt(np.mean((p[:,:,c][mask]-t[:,:,c][mask])**2)) for c in cols]))
N=len(tr); kf=KFold(5,shuffle=True,random_state=42); splits=list(kf.split(np.arange(N)))
for f,(a,b) in enumerate(splits):
    s=sn[b]>1; mk=np.zeros((s.sum(),107),bool); mk[:,:68]=1
    print('fold',f,'sn mcr',round(mcr(oof[b][s],yf[b][s],mk),4))
s=sn>1; mk=np.zeros((s.sum(),107),bool); mk[:,:68]=1
print('full sn',round(mcr(oof[s],yf[s],mk),4))
print('oof shape',oof.shape,'nonzero rows',(np.abs(oof).sum((1,2))>0).sum())
EOF
