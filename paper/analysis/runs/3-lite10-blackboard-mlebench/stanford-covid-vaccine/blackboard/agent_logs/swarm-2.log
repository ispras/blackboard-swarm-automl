import os, json, time, argparse, random
import numpy as np, pandas as pd
import torch, torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import KFold

ROOT='/download_job_code/payload/sandbox'; DATA=os.path.join(ROOT,'data'); OUT=os.path.join(ROOT,'workspaces/fomalhaut_zeta')
TGT5=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
SEQ_V='AGUC'; STR_V='.()'; LOOP_V='ESMIBHX'
PART_V='AGUCN'; DIST_V=list(range(7))  # 6 dist bins + unpaired

def enc(s,v):
    m={c:i for i,c in enumerate(v)}; return [m.get(c,0) for c in s]

def build_partner(struct):
    n=len(struct); partner=[-1]*n; stack=[]
    for i,ch in enumerate(struct):
        if ch=='(': stack.append(i)
        elif ch==')' and stack:
            j=stack.pop(); partner[i]=j; partner[j]=i
    return partner

def featurize(df):
    seqs=df['sequence'].tolist(); structs=df['structure'].tolist(); loops=df['predicted_loop_type'].tolist()
    # partner identity and distance bins
    pbase=[]; pdist=[]
    for s,st in zip(seqs,structs):
        part=build_partner(st)
        pb=[]; pd=[]
        for i in range(len(s)):
            j=part[i]
            if j<0:
                pb.append(4); pd.append(6)
            else:
                pb.append(enc(s[j],SEQ_V)[0]); d=abs(i-j)
                b=0 if d<=2 else 1 if d<=5 else 2 if d<=10 else 3 if d<=20 else 4 if d<=40 else 5
                pd.append(b)
        pbase.append(pb); pdist.append(pd)
    return seqs,structs,loops,pbase,pdist

class DS(Dataset):
    def __init__(self, feats, y=None, augment=False):
        self.s,self.st,self.lp,self.pb,self.pd=feats; self.y=y; self.aug=augment
    def __len__(self): return len(self.s)
    def __getitem__(self,i):
        n=len(self.s[i])
        pos=list(range(n))
        x=np.stack([enc(self.s[i],SEQ_V),enc(self.st[i],STR_V),enc(self.lp[i],LOOP_V),self.pb[i],self.pd[i],pos],1).astype(np.int64)
        if self.y is None: return x
        yy=self.y[i].astype(np.float32)
        if self.aug and random.random()<0.5:
            x=x[::-1].copy()
            c=x[:,1].copy(); c[c==1]=2; c[c==2]=1; x[:,1]=c
            # recompute partner features on reversed? approximate: reverse partner channels too
            yy=yy[::-1].copy()
        return x,yy

class Net(nn.Module):
    def __init__(self,d=100,h=256,layers=3,drop=0.3,npos=107):
        super().__init__()
        self.e0=nn.Embedding(len(SEQ_V),d); self.e1=nn.Embedding(len(STR_V),d); self.e2=nn.Embedding(len(LOOP_V),d)
        self.e3=nn.Embedding(len(PART_V),d//2); self.e4=nn.Embedding(len(DIST_V),d//2); self.e5=nn.Embedding(npos+1,d//2)
        cin=3*d+3*(d//2)
        self.conv=nn.Conv1d(cin,h,5,padding=2)
        self.lstm=nn.LSTM(h,h,num_layers=layers,batch_first=True,bidirectional=True,dropout=drop)
        self.drop=nn.Dropout(drop); self.fc=nn.Linear(2*h,5)
    def forward(self,x):
        e=torch.cat([self.e0(x[:,:,0]),self.e1(x[:,:,1]),self.e2(x[:,:,2]),self.e3(x[:,:,3]),self.e4(x[:,:,4]),self.e5(x[:,:,5])],-1)
        e=torch.relu(self.conv(e.transpose(1,2))).transpose(1,2)
        o,_=self.lstm(e); return self.fc(self.drop(o))

def mcrmse(pred,tgt,mask,cols=(0,1,3),clip=None):
    vals=[]
    for c in cols:
        p=pred[:,:,c][mask]; t=tgt[:,:,c][mask]
        if clip is not None: p=np.maximum(p,clip)
        vals.append(np.sqrt(np.mean((p-t)**2)))
    return float(np.mean(vals))

def masked_loss(pred,tgt,mask,w=(1.,1.,0.5,1.,0.5)):
    wt=torch.tensor(w,device=pred.device,dtype=pred.dtype); loss=0.
    for c in range(5):
        loss=loss+wt[c]*((((pred[:,:,c]-tgt[:,:,c])**2)*mask).sum()/mask.sum())
    return loss/wt.sum()

def run_fold(args,tr_idx,va_idx,feats,y,seed):
    torch.manual_seed(seed); np.random.seed(seed); random.seed(seed); dev='cuda'
    dtr=DS([ [f[i] for i in tr_idx] for f in feats], y[tr_idx], augment=True)
    dva=DS([ [f[i] for i in va_idx] for f in feats], y[va_idx])
    ltr=DataLoader(dtr,batch_size=args.bs,shuffle=True,num_workers=2,drop_last=True)
    lva=DataLoader(dva,batch_size=128,shuffle=False,num_workers=2)
    net=Net(args.d,args.h,args.layers,args.drop).to(dev)
    opt=torch.optim.AdamW(net.parameters(),lr=args.lr,weight_decay=args.wd)
    sched=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=args.epochs,eta_min=args.lr*0.02)
    scaler=torch.cuda.amp.GradScaler()
    m68=torch.zeros(107,dtype=torch.float32); m68[:68]=1
    sn=feats_sn
    snva=sn[va_idx]>1.0
    best=9e9; best_state=None; best_ep=0; bad=0
    for ep in range(args.epochs):
        net.train(); tl=0; n=0
        for xb,yb in ltr:
            xb=xb.to(dev); yb=yb.to(dev); m=m68.to(dev).expand(xb.size(0),107)
            opt.zero_grad()
            with torch.cuda.amp.autocast(): loss=masked_loss(net(xb),yb,m)
            scaler.scale(loss).backward(); scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(net.parameters(),1.0)
            scaler.step(opt); scaler.update(); tl+=loss.item()*xb.size(0); n+=xb.size(0)
        sched.step()
        net.eval(); pr=[]
        with torch.no_grad():
            for xb,yb in lva:
                with torch.cuda.amp.autocast(): o=net(xb.to(dev))
                pr.append(o.float().cpu().numpy())
        pred=np.concatenate(pr,0); yv=y[va_idx]
        if snva.sum()>10: sc=mcrmse(pred[snva],yv[snva],np.ones((snva.sum(),107),bool),clip=-0.5)
        else: sc=mcrmse(pred,yv,np.ones((len(va_idx),107),bool),clip=-0.5)
        if sc<best-1e-5:
            best=sc; best_ep=ep; best_state={k:v.detach().cpu().clone() for k,v in net.state_dict().items()}; bad=0
        else: bad+=1
        if ep%10==0 or bad>=args.patience:
            print(f"   ep{ep:03d} loss{tl/max(n,1):.4f} snval{sc:.4f} best{best:.4f}@{best_ep}",flush=True)
        if bad>=args.patience: break
    net.load_state_dict(best_state); net.eval()
    # predictions for val (all 107 positions, 5 targets)
    pr=[]
    with torch.no_grad():
        for xb,yb in lva:
            with torch.cuda.amp.autocast(): o=net(xb.to(dev))
            pr.append(o.float().cpu().numpy())
    return best,best_ep,np.concatenate(pr,0),net

def infer(net,feats):
    ds=DS(feats); dl=DataLoader(ds,batch_size=128,shuffle=False,num_workers=2); pr=[]
    net.eval()
    with torch.no_grad():
        for xb in dl:
            with torch.cuda.amp.autocast(): o=net(xb.to('cuda'))
            pr.append(o.float().cpu().numpy())
    return np.concatenate(pr,0)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=int,default=5); ap.add_argument('--fold',type=int,default=-1)
    ap.add_argument('--epochs',type=int,default=70); ap.add_argument('--patience',type=int,default=15)
    ap.add_argument('--bs',type=int,default=64); ap.add_argument('--d',type=int,default=100)
    ap.add_argument('--h',type=int,default=256); ap.add_argument('--layers',type=int,default=3)
    ap.add_argument('--drop',type=float,default=0.3); ap.add_argument('--lr',type=float,default=1e-3)
    ap.add_argument('--wd',type=float,default=1e-4); ap.add_argument('--seeds',type=int,default=1)
    ap.add_argument('--sn_only',type=int,default=1); ap.add_argument('--tag',type=str,default='lstm2')
    ap.add_argument('--save',type=int,default=1)
    args=ap.parse_args()
    global feats_sn
    tr=pd.read_json(os.path.join(DATA,'train.json'),lines=True); te=pd.read_json(os.path.join(DATA,'test.json'),lines=True)
    feats_tr=featurize(tr); feats_te=featurize(te)
    y=np.stack([np.stack(tr[t].values) for t in TGT5],-1).astype(np.float32)
    yfull=np.zeros((len(tr),107,5),np.float32); yfull[:,:68]=y
    feats_sn=tr['signal_to_noise'].values
    N=len(tr); kf=KFold(5,shuffle=True,random_state=42); splits=list(kf.split(np.arange(N)))
    oof=np.zeros((N,107,5),np.float32); cnt=np.zeros(N,np.float32)
    test=np.zeros((len(te),107,5),np.float32); nm=0
    folds=range(5) if args.fold<0 else [args.fold]
    allbest=[]
    for f in folds:
        tr_idx,va_idx=splits[f]
        if args.sn_only: tr_idx=tr_idx[feats_sn[tr_idx]>1.0]
        for sd in range(args.seeds):
            t0=time.time(); print(f"[fold {f} seed {sd}] ntr={len(tr_idx)} nva={len(va_idx)}",flush=True)
            best,bep,oofp,net=run_fold(args,tr_idx,va_idx,feats_tr,yfull,42+sd)
            oof[va_idx]+=oofp; cnt[va_idx]+=1; allbest.append(best)
            test+=infer(net,feats_te); nm+=1
            print(f"[fold {f} seed {sd}] best_sn {best:.4f} @ep{bep} {time.time()-t0:.0f}s",flush=True)
    oof/=np.maximum(cnt[:,None,None],1); test/=max(nm,1)
    m68=np.zeros((N,107),bool); m68[:,:68]=True
    print('OOF all',round(mcrmse(oof,yfull,m68),4),'OOF all clip',round(mcrmse(oof,yfull,m68,clip=-0.5),4))
    snm=feats_sn>1
    print('OOF sn>1',round(mcrmse(oof[snm],yfull[snm],m68[snm]),4),'clip',round(mcrmse(oof[snm],yfull[snm],m68[snm],clip=-0.5),4))
    print('fold bests',np.round(allbest,4))
    if args.save:
        os.makedirs(os.path.join(OUT,'oof'),exist_ok=True)
        # achernar format (2160,68,3) & (240,68,3) cols [0,1,3]
        oof3=oof[:,:68,:][:,:,[0,1,3]]; test3=test[:,:68,:][:,:,[0,1,3]]
        np.save(os.path.join(OUT,f'oof/oof_{args.tag}.npy'),oof3.astype(np.float32))
        np.save(os.path.join(OUT,f'oof/test_{args.tag}.npy'),test3.astype(np.float32))
        np.save(os.path.join(OUT,f'oof/oof5_{args.tag}.npy'),oof.astype(np.float32))
        np.save(os.path.join(OUT,f'oof/test5_{args.tag}.npy'),test.astype(np.float32))
        np.save(os.path.join(OUT,f'oof/mask_{args.tag}.npy'),(cnt>0))
        with open(os.path.join(OUT,f'oof/meta_{args.tag}.json'),'w') as fp:
            json.dump({'args':vars(args),'oof_all':mcrmse(oof,yfull,m68),'oof_all_clip':mcrmse(oof,yfull,m68,clip=-0.5),
                       'oof_sn':mcrmse(oof[snm],yfull[snm],m68[snm]),'oof_sn_clip':mcrmse(oof[snm],yfull[snm],m68[snm],clip=-0.5),
                       'fold_bests':allbest},fp,indent=2,default=str)
main()
