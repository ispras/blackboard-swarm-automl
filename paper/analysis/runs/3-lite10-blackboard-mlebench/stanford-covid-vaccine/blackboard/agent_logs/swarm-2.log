import numpy as np, pandas as pd, argparse
from sklearn.model_selection import KFold
ROOT='/download_job_code/payload/sandbox'; DATA=ROOT+'/data'
TGT=['reactivity','deg_Mg_pH10','deg_pH10','deg_Mg_50C','deg_50C']
def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--models',nargs='+',required=True); ap.add_argument('--iters',type=int,default=40)
    a=ap.parse_args()
    tr=pd.read_json(DATA+'/train.json',lines=True)
    Y=np.stack([np.stack(tr[t].values) for t in TGT],-1).astype(np.float32)
    y=Y[:,:,[0,1,3]]; snf=tr['SN_filter'].values.astype(bool); N=len(y)
    names=[];oofs=[]
    for spec in a.models:
        nm,paths=spec.split('=',1); op=paths.split(',')[0]
        names.append(nm); oofs.append(np.load(op).astype(np.float32))
    oofs=np.stack(oofs)
    def mcr(p,t):
        m=np.ones((len(t),68),bool)
        return float(np.mean([np.sqrt(np.mean((p[:,:,c][m]-t[:,:,c][m])**2)) for c in range(3)]))
    def greedy(idx, iters):
        yy=y[idx]; oo=oofs[:,idx]; n=len(names); chosen=[]; best=1e9; cur=np.zeros_like(yy)
        for it in range(iters):
            bc=None
            for k in range(n):
                cand=(cur*len(chosen)+oo[k])/(len(chosen)+1); s=mcr(cand,yy)
                if s<best-1e-6: best=s; bc=k
            if bc is None: break
            cur=(cur*len(chosen)+oo[bc])/(len(chosen)+1); chosen.append(bc)
        w=np.zeros(n)
        for c in chosen: w[c]+=1.0/max(len(chosen),1)
        return w
    splits=list(KFold(5,shuffle=True,random_state=42).split(np.arange(N)))
    pred=np.zeros_like(y)
    for f,(ti,vi) in enumerate(splits):
        tri=ti[snf[ti]]; vai=vi[snf[vi]]
        w=greedy(tri,a.iters)
        pred[vai]=np.tensordot(w,oofs[:,vai],axes=(0,0))
        print('fold',f,'w',dict(zip(names,np.round(w,3))),flush=True)
    m=np.ones((snf.sum(),68),bool)
    print('NESTED greedy SNf',round(mcr(pred[snf],y[snf]),4))
    # full-oof greedy reference
    w=greedy(np.where(snf)[0],a.iters); full=np.tensordot(w,oofs,axes=(0,0))
    print('FULL-OOF greedy SNf',round(mcr(full[snf],y[snf]),4),'w',dict(zip(names,np.round(w,3))))
main()
EOF
