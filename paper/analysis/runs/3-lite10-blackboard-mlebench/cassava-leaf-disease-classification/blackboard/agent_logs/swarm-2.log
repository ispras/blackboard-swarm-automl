import pandas as pd, numpy as np, os
s=pd.read_csv('data/sample_submission.csv')
def check(name, testp, sub=None, ids=None):
    t=np.load(testp); ok=True
    msg=f'{name}: shape{t.shape}'
    if ids and os.path.exists(ids):
        idf=pd.read_csv(ids)
        col=idf.columns[0]
        same=(idf[col].astype(str).values==s.image_id.astype(str).values)
        msg+=f' ids_match={same.mean():.3f} len={len(idf)}'
    if sub and os.path.exists(sub):
        subdf=pd.read_csv(sub)
        if 'image_id' in subdf.columns:
            idsame=(subdf.image_id.astype(str).values==s.image_id.astype(str).values)
            agree=(subdf.label.values==t.argmax(1))
            msg+=f' sub_ids_match={idsame.mean():.3f} argmax_agree={agree.mean():.3f}'
    print(msg)
