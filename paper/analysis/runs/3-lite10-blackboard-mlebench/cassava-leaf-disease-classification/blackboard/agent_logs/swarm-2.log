import os, numpy as np, pandas as pd
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
from scipy.optimize import minimize_scalar
ROOT='/download_job_code/payload/sandbox'
def norm(p):
    p=np.clip(np.asarray(p,dtype=np.float64),1e-9,None); return p/p.sum(1,keepdims=True)
cv=pd.read_csv(os.path.join(ROOT,'workspaces/aldebaran_epsilon/cv_split.csv')); va=cv[cv.fold==0].reset_index(drop=True)
y=va.label.values; va_ids=va.image_id.values
specs={
 'b5':('workspaces/bellatrix_delta/run_b5_512/tta4/val_probs_tta4.npy',None),
 'b5_640':('workspaces/bellatrix_delta/run_b5_640/tta4ms/val_probs_tta4.npy',None),
 'cnxt':('workspaces/bellatrix_delta/run_cnxt_384/tta4ms/val_probs_tta4.npy',None),
 'eva02':('workspaces/vega_eta/runs/eva02b448_f0_s42/val_probs_tta.npy',None),
 'caformer':('workspaces/vega_eta/runs/caformer384_f0_s42/val_probs_tta.npy',None),
 'swin':('workspaces/aldebaran_epsilon/swin/val_probs.npy','workspaces/aldebaran_epsilon/swin/val_ids.csv'),
 'vit':('workspaces/aldebaran_epsilon/vit/tta4/val_probs_tta4.npy','workspaces/aldebaran_epsilon/vit/val_ids.csv'),
 'cnv2':('workspaces/vega_eta/runs/cnv2b384_f0_s42/val_probs_tta.npy',None)}
names=list(specs); V=[]
for k in names:
    p,vi=specs[k]; v=norm(np.load(os.path.join(ROOT,p)))
    if vi and os.path.exists(os.path.join(ROOT,vi)):
        ids=pd.read_csv(os.path.join(ROOT,vi)).image_id.values
        if len(ids)==len(v) and not np.array_equal(ids,va_ids):
            o=pd.Index(ids); v=v[[o.get_loc(i) for i in va_ids]]
    V.append(v)
V=np.stack(V); n=len(names)
print('singles',{names[i]:round(float((V[i].argmax(1)==y).mean()),5) for i in range(n)})

def fit_T(P, yy):
    lp=np.log(np.clip(P,1e-9,None))
    def obj(logT):
        T=np.exp(logT); q=lp/T; q=q-q.max(1,keepdims=True); q=np.exp(q); q/=q.sum(1,keepdims=True)
        return -np.log(np.clip(q[np.arange(len(yy)),yy],1e-9,None)).mean()
    r=minimize_scalar(obj,bounds=(-2,2),method='bounded'); return np.exp(r.x)

def temps(P, yy):
    return np.stack([norm(np.log(np.clip(P[i],1e-9,None))/fit_T(P[i],yy)) for i in range(P.shape[0])])

def acc_w(P, yy):
    a=np.array([(P[i].argmax(1)==yy).mean() for i in range(P.shape[0])])
    w=np.clip(a-0.8,1e-3,None); return w/w.sum()

reps=5; seed=100
res={k:[] for k in ['uniform','temp_uniform','acc_weights','stack_lr']}
for r in range(reps):
    folds=list(StratifiedKFold(5,shuffle=True,random_state=seed+r).split(V[0],y))
    for tri,tei in folds:
        # uniform
        res['uniform'].append((V[:,tei].mean(0).argmax(1)==y[tei]).mean())
        # temp
        Tp=temps(V[:,tri],y[tri]); res['temp_uniform'].append((Tp[:,tei].mean(0).argmax(1)==y[tei]).mean())
        # acc weights
        w=acc_w(V[:,tri],y[tri]); res['acc_weights'].append((np.tensordot(w,V[:,tei],1).argmax(1)==y[tei]).mean())
        # stacking on log probs
        X=np.concatenate([np.log(np.clip(V[i],1e-9,None)) for i in range(n)],1)
        Xtr=X[tri]; Xte=X[tei]
        lr=LogisticRegression(max_iter=2000,C=0.05,multi_class='multinomial')
        lr.fit(Xtr,y[tri]); res['stack_lr'].append(lr.predict(Xte).mean() if False else (lr.predict(Xte)==y[tei]).mean())
base=np.array(res['uniform'])
print('\n--- last-mile nested CV (5 repeats x 5 folds) ---')
for k,a in res.items():
    a=np.array(a); d=a-base
    print(f'{k:14s} mean={a.mean():.5f}  vs_uniform={d.mean():+.5f} +/- {d.std(ddof=1)/np.sqrt(len(d)):.5f}  paired_wins={(d>0).mean():.2f}')
EOF
