from sklearn.model_selection import StratifiedKFold
paths={
"eva02":"runs/eva02b448_f0_s42/val_probs_tta.npy",
"caformer":"runs/caformer384_f0_s42/val_probs_tta.npy",
"cnv2":"runs/cnv2b384_f0_s42/val_probs_tta.npy",
"cnv2_512":"runs/cnv2_512/val_probs_tta.npy",
"b5":"../bellatrix_delta/run_b5_512/val_probs_fold0.npy",
"b5_640":"../bellatrix_delta/run_b5_640/val_probs_fold0.npy",
"cnxt":"../bellatrix_delta/run_cnxt_384/val_probs_fold0.npy",
"swin":"../aldebaran_epsilon/swin/val_probs.npy",
"vit":"../aldebaran_epsilon/vit/val_probs.npy",
}
d=pd.read_csv("split5_seed42.csv"); va=d[d.fold==0].reset_index(drop=True); y=va.label.values
P={}
for n,p in paths.items():
    x=np.load(p); x=x/x.sum(1,keepdims=True); P[n]=x
    assert x.shape[0]==len(y),(n,x.shape)
def acc(x): return float((x.argmax(1)==y).mean())
print("individual:")
for n,x in P.items(): print(f"  {n:10s} {acc(x):.5f}")
def blend(names): 
    m=np.mean([P[n] for n in names],0); return m
for label,names in [("all9",list(P)),("no_512",[n for n in P if n!="cnv2_512"])]:
    m=blend(names); print(label,acc(m),[n for n in names])
# nested CV uniform for all9 vs no_512
skf=StratifiedKFold(5,shuffle=True,random_state=11)
for label,names in [("all9",list(P)),("no_512",[n for n in P if n!="cnv2_512"])]:
    sc=[]
    for tr,te in skf.split(np.zeros(len(y)),y):
        # uniform has no fitting; just evaluate on held-out (same as full)
        sc.append(acc(blend(names)[te] if False else np.mean([P[n][te] for n in names],0)))
    print(label,"cv",round(float(np.mean(sc)),5),round(float(np.std(sc)),4))
