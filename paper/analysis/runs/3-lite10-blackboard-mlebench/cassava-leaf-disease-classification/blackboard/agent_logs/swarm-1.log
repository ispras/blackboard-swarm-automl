import numpy as np, pandas as pd
spl=pd.read_csv('workspaces/aldebaran_epsilon/cv_split.csv'); va=spl[spl.fold==0].reset_index(drop=True); y=va.label.values
paths={'b5':'workspaces/bellatrix_delta/run_b5_512/val_probs_fold0.npy','cnxt':'workspaces/bellatrix_delta/run_cnxt_384/val_probs_fold0.npy','eva02':'workspaces/vega_eta/runs/eva02b448_f0_s42/val_probs.npy','caformer':'workspaces/vega_eta/runs/caformer384_f0_s42/val_probs.npy','swin':'workspaces/aldebaran_epsilon/swin/val_probs.npy'}
keys=list(paths); P=np.stack([np.load(paths[k]) for k in keys])  # M,N,5
rng=np.random.default_rng(0)
def acc(w): return ((w[:,None,None]*P).sum(0).argmax(1)==y).mean()
best=(-1,None)
for _ in range(20000):
    w=rng.dirichlet(np.ones(len(keys))*0.7)
    a=acc(w)
    if a>best[0]: best=(a,w.copy())
# coordinate refine
a,w=best
for it in range(200):
    improved=False
    for i in range(len(keys)):
        for d in [0.6,0.8,1.2,1.4]:
            w2=w.copy(); w2[i]*=d; w2/=w2.sum()
            a2=acc(w2)
            if a2>a+1e-9: a,w=a2,w2; improved=True
    if not improved: break
print('best acc',a)
for k,wi in sorted(zip(keys,w),key=lambda t:-t[1]): print(f'  {k:9s} {wi:.3f}')
print('uniform',acc(np.ones(len(keys))/len(keys)))
# per-class accuracy
pred=(w[:,None,None]*P).sum(0).argmax(1)
print('per-class acc',[(c, round(((pred==c)&(y==c)).sum()/ (y==c).sum(),4)) for c in range(5)])
