from sklearn.model_selection import StratifiedKFold
def cvacc(ks):
    sk=StratifiedKFold(5,shuffle=True,random_state=1); out=[]
    for _,vi in sk.split(y,y):
        U=sum(P[k][vi] for k in ks)/len(ks); out.append((U.argmax(1)==y[vi]).mean())
    return np.mean(out)
for name,ks in [('5base',base),('5+vit',base+['vit']),('8all',keys),('6hedge-ish',base+['b5_640'])]:
    print('CV',name,round(cvacc(ks),5))
