import numpy as np, time, metric as MT
# synthetic organ: tube of area ~2000 per slice over 60 slices
def make(n=60,H=320,W=320,area=2000,seed=0):
    rng=np.random.RandomState(seed); v=np.zeros((n,H,W),np.uint8)
    cy,cx=rng.randint(100,220),rng.randint(100,220)
    r=int((area/np.pi)**0.5)
    yy,xx=np.ogrid[:H,:W]
    for z in range(n):
        dy,dx=rng.randint(-3,4),rng.randint(-3,4)
        v[z][(yy-(cy+dy))**2+(xx-(cx+dx))**2<=r*r]=1
    return v
a=make(seed=0); b=make(seed=1)
t=time.time(); h=MT.hausdorff_norm(a,b); print("one hausdorff %.3fs ->"%(time.time()-t),h)
t=time.time()
for i in range(6): MT.hausdorff_norm(a,make(seed=i))
print("6 calls %.2fs"%((time.time()-t)))
PY
