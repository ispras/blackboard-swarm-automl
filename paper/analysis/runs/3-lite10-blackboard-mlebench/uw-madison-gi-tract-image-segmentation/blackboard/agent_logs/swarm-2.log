    case,day,sl,sv=id_.split("_")
    f=glob.glob(os.path.join(DATA,"test",case,f"{case}_{day}","scans",f"{sl}_{sv}_*.png"))
    import cv2
    H,W=cv2.imread(f[0],cv2.IMREAD_UNCHANGED).shape[:2]
    if pred.strip()=="" : continue
    toks=list(map(int,pred.split()))
    if len(toks)%2: bad+=1; continue
    starts=toks[0::2]; lens=toks[1::2]
    if any(l<=0 for l in lens) or any(s<=0 for s in starts): bad+=1; continue
    if any(starts[i]+lens[i]<=starts[i-1]+lens[i-1] for i in range(1,len(starts))): bad+=1; continue
    if starts[-1]+lens[-1]-1 > H*W: bad+=1; continue
    if pred.strip(): nonempty+=1
print("nonempty rows",nonempty,"bad RLE",bad)
