bce=nn.BCEWithLogitsLoss(); dloss=smp.losses.DiceLoss(mode="multilabel",from_logits=True)
opt=torch.optim.AdamW(m.parameters(),lr=1e-3); sc=torch.cuda.amp.GradScaler()
it=iter(dl)
for _ in range(3):  # warmup
    x,y=next(it); x=x.to(dev);y=y.to(dev);opt.zero_grad()
    with torch.cuda.amp.autocast(): o=m(x); loss=0.5*bce(o,y)+0.5*dloss(o,y)
    sc.scale(loss).backward();sc.step(opt);sc.update()
torch.cuda.synchronize(); t0=time.time(); n=0
for x,y in it:
    x=x.to(dev);y=y.to(dev);opt.zero_grad()
    with torch.cuda.amp.autocast(): o=m(x); loss=0.5*bce(o,y)+0.5*dloss(o,y)
    sc.scale(loss).backward();sc.step(opt);sc.update(); n+=1
    if n>=25: break
torch.cuda.synchronize(); dt=(time.time()-t0)/n
print("combined sec/iter",round(dt,3),"it/s",round(1/dt,2),"est epoch 990it min",round(dt*990/60,1))
