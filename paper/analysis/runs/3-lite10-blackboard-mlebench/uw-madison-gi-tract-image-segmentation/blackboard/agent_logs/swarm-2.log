import pandas as pd, numpy as np, sys
def areas(series):
    out=[]
    for s in series:
        if not isinstance(s,str) or s.strip()=="": continue
        t=np.array(s.split(),dtype=np.int64)
        if len(t)%2: continue
        out.append(t[1::2].sum())  # sum of run lengths = area
    return np.array(out)
tr=pd.read_csv("../../data/train.csv")
sub=pd.read_csv("../../final_solution/submission.csv")
