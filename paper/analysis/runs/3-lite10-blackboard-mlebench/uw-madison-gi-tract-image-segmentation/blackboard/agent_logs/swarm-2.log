import sys, numpy as np, pandas as pd, os
sys.path.insert(0,".")
from common import rle_decode
ref=np.load("oof/unetpp_b3_f0_test_meta.npz",allow_pickle=True)
id2hw={str(i):(int(h),int(w)) for i,(h,w) in zip(ref["ids"],ref["orig_hw"])}
a=pd.read_csv(sys.argv[1]); b=pd.read_csv(sys.argv[2])
ss=pd.read_csv("../../data/sample_submission.csv")
print("A ids==sample:",(a["id"].values==ss["id"].values).all(),"B ids==sample:",(b["id"].values==ss["id"].values).all())
ia={}; ib={}
for id_,cls,p in zip(a["id"],a["class"],a["predicted"]): ia[(id_,cls)]="" if pd.isna(p) else str(p)
for id_,cls,p in zip(b["id"],b["class"],b["predicted"]): ib[(id_,cls)]="" if pd.isna(p) else str(p)
inter=0; sa=0; sb=0; identical=0; rows=0; dice_sum=0.0
for k in ia:
    H,W=id2hw[k[0]]
    ma=rle_decode(ia[k],H,W); mb=rle_decode(ib[k],H,W)
    i=int((ma&mb).sum()); x=int(ma.sum()); y=int(mb.sum())
    inter+=i; sa+=x; sb+=y; rows+=1
    if x==0 and y==0: dice_sum+=1.0
    elif x+y==0: dice_sum+=1.0
    else: dice_sum+=2*i/(x+y)
    if np.array_equal(ma,mb): identical+=1
print(f"rows {rows} mean_dice_agreement {dice_sum/rows:.4f} identical {identical/rows:.3f} voxelIoU {inter/max(1,(sa+sb-inter)):.4f}")
print("A nonempty",(a['predicted'].notna()).mean(),"B nonempty",(b['predicted'].notna()).mean())
PY
