import pandas as pd, numpy as np, glob, re
from scipy import ndimage
tr=pd.read_csv("../../data/train.csv")
def dec(rle,h,w,order):
    s=rle.split(); m=np.zeros(h*w, np.uint8)
    for i in range(0,len(s),2):
        st=int(s[i]); ln=int(s[i+1]); m[st-1:st-1+ln]=1
    return m.reshape((h,w),order=order)
# find non-square 360x310 slices
rows=tr[tr.segmentation.notna()].copy()
rows["case"]=rows.id.str.split("_").str[0]
rows["day"]=rows.id.str.split("_").str[1]
rows["sl"]=rows.id.str.split("_").str[2]
rows["sv"]=rows.id.str.split("_").str[3]
res={"C":[], "F":[]}
cnt=0
for _,r in rows.iterrows():
    fs=glob.glob(f"../../data/train/{r.case}/{r.case}_{r.day}/scans/{r.sl}_{r.sv}_*.png")
    m=re.search(r"slice_\d+_(\d+)_(\d+)_",fs[0])
    h,w=int(m.group(1)),int(m.group(2))
    if (h,w)!=(360,310): continue
    for o in ["C","F"]:
        mask=dec(r.segmentation,h,w,o)
        lab,n=ndimage.label(mask, structure=np.ones((3,3)))
        if n==0: continue
        sizes=ndimage.sum(mask,lab,range(1,n+1))
        res[o].append((n, sizes.max()/mask.sum()))
    cnt+=1
    if cnt>=15: break
for o in ["C","F"]:
    a=np.array(res[o]); print(o,"n_samples",len(a),"mean_ncomp",a[:,0].mean(),"mean_largest_frac",a[:,1].mean())
