for c in ["large_bowel","small_bowel","stomach"]:
    a=areas(tr[tr["class"]==c]["segmentation"])
    b=areas(sub[sub["class"]==c]["predicted"])
    print("%-12s %-8s | n=%-5d mean=%-7.0f med=%-6.0f p95=%-6.0f max=%-7.0f | n=%-5d mean=%-7.0f med=%-6.0f p95=%-6.0f max=%-7.0f"%(c,"",
      len(a),a.mean(),np.median(a),np.percentile(a,95),a.max(),
      len(b),b.mean(),np.median(b),np.percentile(b,95),b.max()))
# per-class nonempty fraction on test (6800 slices)
print("\ntest predicted nonempty fraction per class:")
for c in ["large_bowel","small_bowel","stomach"]:
    s=sub[sub["class"]==c]["predicted"]
    print(" ",c, round(s.notna().mean(),4), " mean area (nonzero)", round(areas(s).mean(),1))
