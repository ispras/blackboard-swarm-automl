import os, numpy as np, pandas as pd, cv2, torch
from torch.utils.data import Dataset
import albumentations as A

ROOT='/download_job_code/payload/sandbox'
CACHE=f'{ROOT}/workspaces/betelgeuse_pi/cache'
S=320

def load_index():
    idx=pd.read_csv(f'{CACHE}/train_index.csv')
    idx['row']=np.arange(len(idx))
    df=idx.sort_values(['case_day','slice']).reset_index(drop=True)
    prev=df['row'].values.copy(); nxt=df['row'].values.copy()
    for _,g in df.groupby('case_day'):
        pos=g.index.values  # positions in sorted df
        rows=df.loc[pos,'row'].values
        prev[pos[0]]=rows[0]; nxt[pos[-1]]=rows[-1]
        prev[pos[1:]]=rows[:-1]; nxt[pos[:-1]]=rows[1:]
    df['prev_row']=prev; df['next_row']=nxt
    return idx.merge(df[['row','prev_row','next_row']],on='row',how='left')

def make_tf(train=True):
    if train:
        return A.Compose([
            A.HorizontalFlip(p=0.5),
            A.VerticalFlip(p=0.5),
            A.ShiftScaleRotate(shift_limit=0.0625, scale_limit=0.15, rotate_limit=15,
                               border_mode=cv2.BORDER_REPLICATE, p=0.5),
            A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),
            A.OneOf([A.GaussNoise(var_limit=(5,30)), A.GaussianBlur(blur_limit=(3,5)), A.MotionBlur(blur_limit=5)], p=0.2),
        ])
    return None

class GIDataset(Dataset):
    def __init__(self, df, img_mm, msk_mm, train=True):
        self.df=df.reset_index(drop=True)
        self.img=img_mm; self.msk=msk_mm
        self.train=train; self.tf=make_tf(train)
    def __len__(self): return len(self.df)
    def __getitem__(self,p):
        r=self.df.iloc[p]
        c=int(r['row']); pr=int(r['prev_row']); nx=int(r['next_row'])
        img=np.stack([self.img[pr],self.img[c],self.img[nx]],axis=-1)
        bits=self.msk[c]
        msk=np.stack([(bits>>0)&1,(bits>>1)&1,(bits>>2)&1],axis=-1).astype(np.float32)
        if self.tf is not None:
            out=self.tf(image=img,mask=msk); img=out['image']; msk=out['mask']
        img=(img.astype(np.float32)/255.0).transpose(2,0,1)
        msk=msk.transpose(2,0,1)
        return torch.from_numpy(img), torch.from_numpy(msk)

def get_dataloaders(fold=0, bs=24, workers=6, res=S):
    idx=load_index()
    tr=idx[idx.fold!=fold].reset_index(drop=True)
    va=idx[idx.fold==fold].reset_index(drop=True)
    imgs=np.load(f'{CACHE}/train_img_u8.npy',mmap_mode='r')
    msks=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r')
    trds=GIDataset(tr,imgs,msks,train=True)
    vads=GIDataset(va,imgs,msks,train=False)
    return trds,vads
