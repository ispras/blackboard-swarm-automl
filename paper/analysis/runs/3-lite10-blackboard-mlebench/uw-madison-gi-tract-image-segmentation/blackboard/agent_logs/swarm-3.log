import pandas as pd, numpy as np
sub=pd.read_csv('final_solution/submission.csv', keep_default_na=False)
idx=pd.read_csv('workspaces/capella_zeta/cache/test_index.csv')
idx['case_day']=idx['case_day']; hw={r.id:(int(r.H),int(r.W)) for r in idx.itertuples()}
scan={r.id:r.case_day for r in idx.itertuples()}
# decode area per row (logical pixels)
from collections import defaultdict
present=defaultdict(set); vol=defaultdict(float)
areas=defaultdict(list)
for r in sub.itertuples():
    s=str(r.predicted).strip()
    if s=='': continue
    v=s.split(); ln=list(map(int,v[1::2]))
    a=sum(ln); areas[r._2].append(a); present[scan[r.id]].add(r._2); vol[(scan[r.id],r._2)]+=a
print('scans',len(present),'all have 3 organs:',all(len(v)==3 for v in present.values()))
empty_scan_class=sum(1 for sid in present for c in ['large_bowel','small_bowel','stomach'] if c not in present[sid])
print('empty scan-class cells:',empty_scan_class,'(0 means every scan predicts all 3 organs)')
for c in ['large_bowel','small_bowel','stomach']:
    a=np.array(areas[c]); print(c,'rows',len(a),'mean area',round(a.mean(),1),'p50',np.median(a),'p95',np.percentile(a,95))
print('md5 check done')
EOF
