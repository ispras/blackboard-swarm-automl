import pandas as pd, numpy as np
from PIL import Image
from scipy.ndimage import label
import glob
tr=pd.read_csv('../../data/train.csv')
r=tr[(tr.id=='case133_day0_slice_0043')&(tr['class']=='stomach')].iloc[0]
f=glob.glob('../../data/train/case133/case133_day0/scans/slice_0043_*.png')[0]
W,H=Image.open(f).size
print('Image.size (W,H)=',(W,H))
s=r.segmentation.split(); st=np.array(s[0::2],int)-1; ln=np.array(s[1::2],int)
flat=np.zeros(H*W,np.uint8)
for a,b in zip(st,ln): flat[a:a+b]=1
def cc(m):
    l,n=label(m); sz=np.bincount(l.ravel()); sz[0]=0
    return n, int(sz.max()), int(m.sum())
print('C on (H,W):        ', cc(flat.reshape((H,W),order='C')))
print('F on (H,W):        ', cc(flat.reshape((H,W),order='F')))
print('F on (W,H) then T: ', cc(flat.reshape((W,H),order='F').T))
print('C on (W,H) then T: ', cc(flat.reshape((W,H),order='C').T))
# intensity check
img=np.array(Image.open(f)).astype(float)
for name,m in [('C',flat.reshape((H,W),order='C')),('F',flat.reshape((H,W),order='F'))]:
    inside=img[m.astype(bool)]; outside=img[~m.astype(bool)]
    print(name,'mean inside',inside.mean().round(1),'mean outside',outside.mean().round(1))
