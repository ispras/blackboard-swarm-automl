def build_gt(groups, gt_file, class_idx, rows_cache):
    id2row = rows_cache
    vols = {}
    for cd, pos, gids, sl in groups:
        rows = np.array([id2row[i] for i in gids])
        vols[cd] = np.asarray(gt_file[rows, class_idx]).astype(np.uint8)
    return vols


def eval_cfg(groups, probs, gtvols, cls, cfg):
    dices = []; hds = []
    for cd, pos, gids, sl in groups:
        pvol = np.asarray(probs[pos, cls]).astype(np.float32)
        out = postproc_vol(pvol, cfg)
        gt = gtvols[cd]
        for z in range(len(gids)):
            dices.append(dice_bin(out[z], gt[z]))
        hds.append(hd_norm(out, gt))
    return float(np.mean(dices)), float(np.mean(hds)), 0.4 * np.mean(dices) + 0.6 * (1 - np.mean(hds))


def tune(prob_file, ids_file, gt_file, quick=False):
    probs = np.load(prob_file, mmap_mode="r")
    ids = pd.read_csv(ids_file)
    if len(ids) != probs.shape[0]:
        raise SystemExit(f"ids {len(ids)} != probs {probs.shape[0]}")
    idx = pd.read_csv(f"{WS}/cache/train_index.csv")
    id2row = dict(zip(idx["id"], np.arange(len(idx))))
    groups = scan_groups(ids)
    print("scans", len(groups), "slices", len(ids))
    gtm = np.load(gt_file, mmap_mode="r")
    best_all = {}
    for cls in range(3):
        gtvols = build_gt(groups, gtm, cls, id2row)
        # phase A threshold
        resA = []
        for thr in (0.35, 0.45, 0.55, 0.65, 0.75):
            cfg = {"thr": thr, "fill": True, "min_size2d": 0}
            d, h, c = eval_cfg(groups, probs, gtvols, cls, cfg)
            resA.append((c, d, h, thr))
            print(f"[{CLASSES[cls]}] thr {thr}: dice {d:.4f} hd {h:.4f} combo {c:.4f}", flush=True)
        resA.sort(reverse=True)
        thr = resA[0][3]
        # phase B 3D postproc at best (and 2nd) threshold
        cfgs = []
        for t in sorted({resA[0][3], resA[1][3]}):
            for mv in (0, 100, 300, 800):
                for kl in (False, True):
                    if kl and mv > 0:
                        continue
                    for se in (0, 300):
                        cfgs.append({"thr": t, "fill": True, "min_size2d": 0,
                                     "min_vol3d": mv, "keep_largest3d": kl, "scan_empty": se})
        resB = []
        for cfg in cfgs:
            d, h, c = eval_cfg(groups, probs, gtvols, cls, cfg)
            resB.append((c, d, h, dict(cfg)))
        resB.sort(key=lambda r: -r[0])
