"""Tune threshold + postprocessing on validation (OOF) prob dumps at 320 resolution."""
import os, sys, json, argparse, itertools
import numpy as np
from scipy import ndimage

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import dataset as D
import metric as MT

CACHE = D.CACHE


def load_gt_vol(meta, scan_id):
    m = [x for x in meta if x["scan_id"] == scan_id][0]
    gt = np.load(os.path.join(CACHE, m["msk"]), mmap_mode="r")
    return (np.asarray(gt) > 0).astype(np.uint8).transpose(3, 0, 1, 2)  # 3,N,H,W


def postproc(mask, min_size, fill_holes, keep_largest):
    if mask.sum() == 0:
        return mask
    if fill_holes:
        mask = ndimage.binary_fill_holes(mask).astype(np.uint8)
    if min_size > 0 or keep_largest:
        lab, n = ndimage.label(mask, structure=np.ones((3, 3)))
        if n > 0:
            sizes = ndimage.sum(mask, lab, range(1, n + 1))
            if keep_largest and n > 1:
                mask = (lab == (np.argmax(sizes) + 1)).astype(np.uint8)
            elif min_size > 0:
                keep = np.zeros(n + 1, np.uint8); keep[1:] = (sizes >= min_size).astype(np.uint8)
                mask = keep[lab]
    return mask.astype(np.uint8)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--prefixes", nargs="+", required=True)
    ap.add_argument("--weights", nargs="*", type=float, default=None)
    ap.add_argument("--val_cases", default="")
    a = ap.parse_args()

    meta = D.load_meta("train")
    wts = a.weights if a.weights else [1.0] * len(a.prefixes)
    prob_scan = {}  # scan_id -> (3,N,320,320) float32 accumulated
    wscan = {}
    for pref, w in zip(a.prefixes, wts):
        probs = np.load(pref + "_probs.npy")
        mz = np.load(pref + "_meta.npz", allow_pickle=True)
        sids = mz["scan_id"]; ks = mz["k"]
        for i in range(len(sids)):
            sid = str(sids[i]); k = int(ks[i])
            if sid not in prob_scan:
                n = [x for x in meta if x["scan_id"] == sid][0]["n"]
                prob_scan[sid] = np.zeros((3, n, 320, 320), np.float32)
                wscan[sid] = 0.0
            prob_scan[sid][:, k] += probs[i].astype(np.float32) * w
        if w > 0:
            for sid in prob_scan:
                pass
    # normalize (divide by weight sum); weights uniform per model per scan
    for sid in prob_scan:
        prob_scan[sid] /= sum(wts)

    gts = {sid: load_gt_vol(meta, sid) for sid in prob_scan}
    print(f"scans {len(prob_scan)}")

    def score(th, min_size, fill, keep):
        ds = []; hs = []
        for sid, pv in prob_scan.items():
            pred = np.zeros_like(pv, dtype=np.uint8)
            gt = gts[sid]
            n = pv.shape[1]
            for c in range(3):
                for z in range(n):
                    m = (pv[c, z] > th).astype(np.uint8)
                    if m.sum():
                        m = postproc(m, min_size, fill, keep)
                    pred[c, z] = m
                    ds.append(MT.dice_bin(m, gt[c, z]))       # per-slice dice (grader)
                hs.append(MT.hausdorff_norm(pred[c], gt[c]))  # per-scan 3D hd
        dice = float(np.mean(ds)); hd = float(np.mean(hs))
        return dice, hd, 0.4 * dice + 0.6 * (1 - hd)

    results = []
    for th in [0.3, 0.4, 0.5, 0.6, 0.7]:
        for min_size in [0, 25, 100, 300]:
            d, h, c = score(th, min_size, 1, 0)
            results.append((th, min_size, 1, 0, d, h, c))
            print(f"th {th} min_size {min_size} fill1 keep0 -> dice {d:.4f} hd {h:.4f} combo {c:.4f}", flush=True)
    results.sort(key=lambda r: -r[6])
    print("BEST:", results[0])


if __name__ == "__main__":
    main()
