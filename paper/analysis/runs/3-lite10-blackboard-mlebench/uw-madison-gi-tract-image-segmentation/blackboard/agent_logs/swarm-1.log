import sys, json, argparse, numpy as np, pandas as pd
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CACHE, CLASSES
from scipy import ndimage
from scipy.spatial import cKDTree

def pp2d(p,thr,ma,fill=True):
    m=p>thr
    if not m.any(): return np.zeros((320,320),np.uint8)
    if fill: m=ndimage.binary_fill_holes(m)
    if ma>0:
        lab,n=ndimage.label(m)
        if n>1:
            sz=ndimage.sum(m,lab,range(1,n+1)); keep=np.where(sz>=ma)[0]+1
            m=np.isin(lab,keep)
    return m.astype(np.uint8)

def cc_keep(P,minvol):
    if P.sum()==0: return P
    lab,n=ndimage.label(P>0,np.ones((3,3,3)))
    if n==0: return P
    sz=ndimage.sum(P>0,lab,range(1,n+1))
    keep=np.where(sz>=minvol)[0]+1
    return np.isin(lab,keep).astype(np.uint8)

def cc_dist(P,minvol,D):
    if P.sum()==0: return P
    lab,n=ndimage.label(P>0,np.ones((3,3,3)))
    if n==0: return P
    sz=ndimage.sum(P>0,lab,range(1,n+1))
    keep_ids=np.where(sz>=minvol)[0]+1
    if len(keep_ids)==0: return np.zeros_like(P)
    Q=np.isin(lab,keep_ids)
    lab,n=ndimage.label(Q,np.ones((3,3,3)))
    sz=ndimage.sum(Q,lab,range(1,n+1)); main=int(np.argmax(sz))+1
    if n==1: return Q.astype(np.uint8)
    dt=ndimage.distance_transform_edt(lab!=main)
    out=np.zeros_like(P)
    for k in range(1,n+1):
        if k==main: out|= (lab==k); continue
        d=dt[lab==k].min()
        if d<=D: out|=(lab==k)
    return out.astype(np.uint8)

def hd(P,G,sub=2):
    def pts(M):
        z,y,x=np.where(M>0)
        if sub>1: s=np.arange(0,len(z),sub); z,y,x=z[s],y[s],x[s]
        Z=M.shape[0]
        return np.stack([z/max(Z,1),y/320.,x/320.],1) if len(z) else np.zeros((0,3))
    p,g=pts(P),pts(G)
    if len(p)==0 and len(g)==0: return 0.0
    if len(p)==0 or len(g)==0: return 1.0
    return float(min(1.0,max(cKDTree(g).query(p)[0].max(),cKDTree(p).query(g)[0].max())/np.sqrt(3)))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs'); ap.add_argument('--ids'); ap.add_argument('--params')
    ap.add_argument('--minvol',type=int,default=400); ap.add_argument('--Ds',default='8,16,24')
    args=ap.parse_args()
    params=json.load(open(args.params)); ids=pd.read_csv(args.ids); probs=np.load(args.probs,mmap_mode='r')
    gtmm=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r'); ids['idx']=np.arange(len(ids))
    Ds=[int(x) for x in args.Ds.split(',')]
    # prebuild scan structures per class
    for c,cls in enumerate(CLASSES):
        p=params[cls]; thr=p['thr']; ma=p['min_area']
        scans=[]
        for cd,g in ids.groupby('case_day'):
            g=g.sort_values('slice'); idxs=g['idx'].values; rows=g['row'].values.astype(int)
            P=np.stack([pp2d(probs[i,c].astype(np.float32),thr,ma) for i in idxs]).astype(np.uint8)
            G=np.stack([((np.asarray(gtmm[r])>>c)&1) for r in rows]).astype(np.uint8)
            scans.append((P,G))
        def evaluate(fn):
            db=[]; hb=[]
            for P,G in scans:
                Q=fn(P)
                for z in range(len(Q)):
                    den=int(Q[z].sum())+int(G[z].sum()); db.append(1.0 if den==0 else 2*int((Q[z]&G[z]).sum())/den)
                hb.append(hd(Q,G))
            d=float(np.mean(db)); h=float(np.mean(hb)); return d,h,0.4*d+0.6*(1-h)
        d0,h0,c0=evaluate(lambda P: cc_keep(P,args.minvol))
        print(f'{cls} BASE(mv{args.minvol}) dice {d0:.4f} hd {h0:.4f} combo {c0:.4f}',flush=True)
        for D in Ds:
            d,h,co=evaluate(lambda P,D=D: cc_dist(P,max(100,args.minvol//2),D))
