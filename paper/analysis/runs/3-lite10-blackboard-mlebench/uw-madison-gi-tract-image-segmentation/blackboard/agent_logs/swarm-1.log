import sys, json, argparse, numpy as np, pandas as pd, cv2
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CLASSES, rle_encode
from scipy import ndimage

def pp2d(p,thr,minarea,fill=True):
    m=p>thr
    if not m.any(): return np.zeros((320,320),np.uint8)
    if fill: m=ndimage.binary_fill_holes(m)
    if minarea>0:
        lab,n=ndimage.label(m)
        if n>1:
            sz=ndimage.sum(m,lab,range(1,n+1)); keep=np.where(sz>=minarea)[0]+1
            m=np.isin(lab,keep)
    return m.astype(np.uint8)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True); ap.add_argument('--ids',required=True)
    ap.add_argument('--params',required=True); ap.add_argument('--out',required=True)
    ap.add_argument('--minvol3d',type=int,default=0)
    ap.add_argument('--sample',default='/download_job_code/payload/sandbox/data/sample_submission.csv')
    args=ap.parse_args()
    params=json.load(open(args.params)); ids=pd.read_csv(args.ids); probs=np.load(args.probs,mmap_mode='r')
    ids['idx']=np.arange(len(ids)); rle={}
    for c,cls in enumerate(CLASSES):
        p=params[cls]; thr=p['thr']; ma=p.get('min_area',0)
        for cd,g in ids.groupby('case_day'):
            g=g.sort_values('slice'); idxs=g['idx'].values
            P=np.stack([pp2d(probs[i,c].astype(np.float32),thr,ma) for i in idxs]).astype(np.uint8)
            if args.minvol3d>0 and P.sum()>0:
                lab,n=ndimage.label(P>0,np.ones((3,3,3)))
                if n>0:
                    sz=ndimage.sum(P>0,lab,range(1,n+1)); keep=np.where(sz>=args.minvol3d)[0]+1
                    P=np.isin(lab,keep).astype(np.uint8)
            for j,(_,r) in enumerate(g.iterrows()):
                H,W=int(r['H']),int(r['W'])
                m=cv2.resize(P[j],(W,H),interpolation=cv2.INTER_NEAREST)
                rle[(r['id'],cls)]=rle_encode(m) if m.max()>0 else ''
    ss=pd.read_csv(args.sample)
    ss['predicted']=[rle.get((a,b),'') for a,b in zip(ss['id'],ss['class'])]
    ss.to_csv(args.out,index=False)
    miss=sum(1 for a,b in zip(ss['id'],ss['class']) if (a,b) not in rle)
    print('wrote',args.out,'rows',len(ss),'nonempty',(ss['predicted']!='').sum(),'missing',miss,
          'perclass',ss[ss.predicted!=''].groupby('class').size().to_dict())
if __name__=='__main__': main()
