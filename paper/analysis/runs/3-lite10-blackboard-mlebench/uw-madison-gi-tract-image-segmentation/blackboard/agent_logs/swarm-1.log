import os, sys, time, argparse, numpy as np, torch, torch.nn as nn
from torch.utils.data import DataLoader
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from dataset import get_dataloaders, S
import segmentation_models_pytorch as smp
from torch.cuda.amp import autocast, GradScaler

p=argparse.ArgumentParser()
p.add_argument('--fold',type=int,default=0)
p.add_argument('--encoder',type=str,default='efficientnet-b4')
p.add_argument('--epochs',type=int,default=40)
p.add_argument('--bs',type=int,default=24)
p.add_argument('--lr',type=float,default=3e-4)
p.add_argument('--wd',type=float,default=1e-4)
p.add_argument('--workers',type=int,default=6)
p.add_argument('--tag',type=str,default='b4_f0')
p.add_argument('--max_steps',type=int,default=0)
p.add_argument('--val_limit',type=int,default=0)
p.add_argument('--seed',type=int,default=42)
args=p.parse_args()
torch.manual_seed(args.seed); np.random.seed(args.seed)
OUTD='/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/ckpt'
os.makedirs(OUTD,exist_ok=True)
dev='cuda'

trds,vads=get_dataloaders(args.fold,args.bs,args.workers)
if args.val_limit: vads.df=vads.df.iloc[:args.val_limit].reset_index(drop=True)
trl=DataLoader(trds,batch_size=args.bs,shuffle=True,num_workers=args.workers,drop_last=True,
               pin_memory=True,persistent_workers=True,prefetch_factor=4)
val=DataLoader(vads,batch_size=args.bs*2,shuffle=False,num_workers=args.workers,pin_memory=True,persistent_workers=True)
print(f"train {len(trds)} val {len(vads)} steps/epoch {len(trl)}",flush=True)

model=smp.Unet(encoder_name=args.encoder,encoder_weights='imagenet',in_channels=3,classes=3,activation=None).to(dev)
dice_loss=smp.losses.DiceLoss(mode='multilabel',smooth=1.0)
bce=nn.BCEWithLogitsLoss()
opt=torch.optim.AdamW(model.parameters(),lr=args.lr,weight_decay=args.wd)
total_steps=args.epochs*len(trl)
sched=torch.optim.lr_scheduler.OneCycleLR(opt,max_lr=args.lr,total_steps=total_steps,pct_start=0.05)
scaler=GradScaler()

@torch.no_grad()
def evaluate():
    model.eval(); inter=np.zeros(3); den=np.zeros(3); posinter=np.zeros(3); posden=np.zeros(3); npos=np.zeros(3); n=0
    for x,y in val:
        x=x.to(dev,non_blocking=True); y=y.to(dev,non_blocking=True)
        with autocast():
            lo=model(x)
        pr=(torch.sigmoid(lo)>0.5).float()
        inter+=(pr*y).sum((0,2,3)).cpu().numpy(); den+=(pr+y).sum((0,2,3)).cpu().numpy()
        for c in range(3):
            pc=pr[:,c]; yc=y[:,c]
            ip=(pc*yc).sum((1,2)); dp=(pc+yc).sum((1,2))
            pos=(yc.sum((1,2))>0)
            npos[c]+=pos.sum().item()
            posinter[c]+=ip[pos].sum().item(); posden[c]+=dp[pos].sum().item()
        n+=x.shape[0]
    dice=2*inter/(den+1e-6)
    posdice=2*posinter/(posden+1e-6)
    model.train()
    return dice,posdice,n,npos

best=-1; step=0; t0=time.time()
for ep in range(args.epochs):
    model.train(); run=0; nb=0; t1=time.time()
    for x,y in trl:
        x=x.to(dev,non_blocking=True); y=y.to(dev,non_blocking=True)
        opt.zero_grad(set_to_none=True)
        with autocast():
            lo=model(x)
            loss=0.5*bce(lo,y)+0.5*dice_loss(lo,y)
        scaler.scale(loss).backward(); scaler.step(opt); scaler.update(); sched.step()
        run+=loss.item(); nb+=1; step+=1
        if args.max_steps and step>=args.max_steps: break
        if nb%100==0: print(f"ep{ep} step{nb}/{len(trl)} loss {run/nb:.4f} lr {sched.get_last_lr()[0]:.2e} {(time.time()-t1)/nb:.2f}s/it",flush=True)
    dice,posdice,n,npos=evaluate()
    print(f"EPOCH {ep} train_loss {run/max(nb,1):.4f} time {time.time()-t1:.0f}s | dice {dice.round(4)} mean {dice.mean():.4f} | pos_dice {posdice.round(4)} mean {posdice.mean():.4f} | n {n} npos {npos}",flush=True)
    score=dice.mean()
    if score>best:
        best=score
        torch.save({'model':model.state_dict(),'encoder':args.encoder,'fold':args.fold,'dice':dice.tolist(),'score':score},f'{OUTD}/{args.tag}_best.pt')
        print(f"  saved best {best:.4f}",flush=True)
    if args.max_steps and step>=args.max_steps: break
print('DONE',args.tag,'best',best,'elapsed',time.time()-t0)
