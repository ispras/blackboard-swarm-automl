import pandas as pd, numpy as np, glob
from PIL import Image
tr=pd.read_csv('data/train.csv')
r=tr.dropna().iloc[0]
print(r.to_dict())
# find filename
import re
id=r['id']; case,day,sl=id.split('_slice_'); 
fs=glob.glob(f'data/train/{case}/{case}_{day}/scans/*.png')
print(fs[:3], len(fs))
# match slice number
num=int(sl)
f=[x for x in fs if f'slice_{num:04d}' in x][0]
im=np.array(Image.open(f)); print(f, im.shape, im.dtype, im.min(), im.max())
def rle_decode(rle,shape):
    s=rle.split(); starts=np.array(s[0::2],dtype=int); lens=np.array(s[1::2],dtype=int)
    img=np.zeros(shape[0]*shape[1],dtype=np.uint8)
    for st,l in zip(starts,lens):
        img[st-1:st-1+l]=1
    return img.reshape(shape,order='F')
m=rle_decode(r['segmentation'],im.shape)
ys,xs=np.where(m)
print("bbox rows",ys.min(),ys.max(),"cols",xs.min(),xs.max(),"n",m.sum())
# check other order
mr=m.reshape(im.shape,order='C')
print("C bbox", np.where(mr)[0].min(), np.where(mr)[0].max())
