import sys, numpy as np, pandas as pd
CACHE='/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/cache'
def main(sub, sample='/download_job_code/payload/sandbox/data/sample_submission.csv'):
    idx=pd.read_csv(f'{CACHE}/test_index.csv'); hw=dict(zip(idx['id'],zip(idx['H'],idx['W'])))
    ss=pd.read_csv(sample); sub=pd.read_csv(sub,keep_default_na=False)
    assert list(sub.columns)==['id','class','predicted'], sub.columns
    assert len(sub)==len(ss)
    assert (sub['id'].values==ss['id'].values).all(), 'id order'
    assert (sub['class'].values==ss['class'].values).all(), 'class order'
    nbad=0; nonempty=0; areas={}
    for id_,cls,s in zip(sub['id'],sub['class'],sub['predicted']):
        s=str(s).strip()
        if s=='' or s=='nan': continue
        nonempty+=1
        H,W=hw[id_]; N=H*W
        v=list(map(int,s.split()))
        if len(v)%2: nbad+=1; print('odd',id_,cls); continue
        st=np.array(v[0::2]); ln=np.array(v[1::2])
        if (st<1).any() or (ln<1).any(): nbad+=1; print('nonpos',id_,cls); continue
        if (st+ln-1>N).any(): nbad+=1; print('oob',id_,cls,int((st+ln-1).max()),N); continue
        if (np.diff(st)<=0).any(): nbad+=1; print('unsorted',id_,cls); continue
        if (st[1:]<=st[:-1]+ln[:-1]-1).any(): nbad+=1; print('overlap',id_,cls); continue
        areas.setdefault(cls,[]).append(int(ln.sum()))
    print('nonempty',nonempty,'bad',nbad)
    for cls,a in areas.items(): print(cls,'count',len(a),'mean_area',int(np.mean(a)),'median',int(np.median(a)))
if __name__=='__main__': main(sys.argv[1])
