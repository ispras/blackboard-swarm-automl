import os, re, glob, numpy as np, pandas as pd, cv2
from PIL import Image
from tqdm import tqdm

ROOT='/download_job_code/payload/sandbox'
OUT=f'{ROOT}/workspaces/betelgeuse_pi/cache'
os.makedirs(OUT,exist_ok=True)
S=320
CLASSES=['large_bowel','small_bowel','stomach']

def norm_img(a):
    a=a.astype(np.float32)
    p1,p99=np.percentile(a,(1,99))
    if p99<=p1: p99=p1+1
    a=np.clip(a,p1,p99)
    a=(a-p1)/(p99-p1)*255.0
    return a.astype(np.uint8)

def rle_decode(rle,H,W):
    m=np.zeros(H*W,np.uint8)
    if isinstance(rle,str) and len(rle)>0:
        s=rle.split()
        st=np.array(s[0::2],dtype=np.int64); ln=np.array(s[1::2],dtype=np.int64)
        for a,l in zip(st,ln):
            if l>0: m[a-1:a-1+l]=1
    return m.reshape((H,W))  # C-order

def build_index(split):
    base=f'{ROOT}/data/{split}'
    files=glob.glob(f'{base}/*/*/scans/*.png')
    rec=[]
    for f in files:
        name=os.path.basename(f)
        m=re.match(r'slice_(\d+)_',name)
        if not m: continue
        num=int(m.group(1))
        cd=os.path.basename(os.path.dirname(os.path.dirname(f)))
        case=cd.split('_day')[0]
        rec.append({'case_day':cd,'case':case,'slice':num,'path':f,'id':f'{cd}_slice_{num:04d}'})
    df=pd.DataFrame(rec)
    print(split,'files',len(df),'case_days',df.case_day.nunique(),'cases',df.case.nunique())
    return df

def main():
    tr_img=build_index('train'); te_img=build_index('test')
    # folds by case
    cases=sorted(tr_img['case'].unique())
    rng=np.random.RandomState(42); perm=rng.permutation(len(cases))
    fold={c:i%5 for i,c in enumerate(np.array(cases)[perm])}
    tr_img['fold']=tr_img['case'].map(fold)
    tr_img.to_csv(f'{OUT}/train_index.csv',index=False)
    te_img.to_csv(f'{OUT}/test_index.csv',index=False)
    np.save(f'{OUT}/val_cases.npy', np.array([c for c in cases if fold[c]==0]))

    # masks table
    lab=pd.read_csv(f'{ROOT}/data/train.csv')
    # per id -> 3 masks (decode at orig size later); store list
    from collections import defaultdict
    seg=defaultdict(dict)
    for r in lab.itertuples(index=False):
        if isinstance(r.segmentation,str):
            seg[r.id][r._1]=r.segmentation if hasattr(r,'_1') else None
        # itertuples names: id,class,segmentation
    # simpler
    seg=defaultdict(dict)
    for id_,cls,sg in zip(lab['id'],lab['class'],lab['segmentation']):
        if isinstance(sg,str): seg[id_][cls]=sg
    print('ids with masks',len(seg))

    N=len(tr_img)
    imgs=np.lib.format.open_memmap(f'{OUT}/train_img_u8.npy',mode='w+',dtype=np.uint8,shape=(N,S,S))
    msks=np.lib.format.open_memmap(f'{OUT}/train_mask_bits.npy',mode='w+',dtype=np.uint8,shape=(N,S,S))
    bad=0
    for i,r in enumerate(tqdm(tr_img.itertuples(index=False),total=N)):
        # id in index is cd_slice_XXXX; train.csv id may be same
        png=np.array(Image.open(r.path))
        H,W=png.shape
        im=cv2.resize(norm_img(png),(S,S),interpolation=cv2.INTER_AREA)
        imgs[i]=im
        flags=np.zeros((H,W),np.uint8)
        d=seg.get(r.id,{})
        for k,cls in enumerate(CLASSES):
            if cls in d:
                flags |= (rle_decode(d[cls],H,W)<<k)
        m=cv2.resize(flags,(S,S),interpolation=cv2.INTER_NEAREST)
        msks[i]=m
        if not d: bad+=1
    imgs.flush(); msks.flush()
    print('done. empty slices',bad)
    # val ids
    val=tr_img[tr_img.fold==0]
    print('val cases',len(val.case.unique()),'val slices',len(val))

if __name__=='__main__':
    main()
