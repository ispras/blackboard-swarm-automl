import os, sys, argparse, numpy as np, pandas as pd
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CLASSES, build_probs_native, rle_encode, CACHE, S
from scipy import ndimage

def post(mask, minsize=0, largest=False):
    if minsize<=0 and not largest: return mask
    lab,n=ndimage.label(mask)
    if n==0: return mask
    if largest:
        sizes=ndimage.sum(mask,lab,range(1,n+1)); k=int(np.argmax(sizes))+1
        return (lab==k).astype(np.uint8)
    sizes=ndimage.sum(mask,lab,range(1,n+1))
    keep=np.isin(lab,np.where(sizes>=minsize)[0]+1)
    return keep.astype(np.uint8)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True)
    ap.add_argument('--ids',required=True)
    ap.add_argument('--out',required=True)
    ap.add_argument('--thr',type=float,default=0.5)
    ap.add_argument('--minsize',type=int,default=0)
    ap.add_argument('--largest',action='store_true')
    ap.add_argument('--sample',default='/download_job_code/payload/sandbox/data/sample_submission.csv')
    args=ap.parse_args()
    import cv2
    ids=pd.read_csv(args.ids)
    probs=np.load(args.probs,mmap_mode='r')
    rle_map={}
    for i,r in ids.iterrows():
        H,W=int(r['H']),int(r['W'])
        for c,cls in enumerate(CLASSES):
            m=cv2.resize(probs[i,c].astype(np.float32),(W,H),interpolation=cv2.INTER_LINEAR)
            b=(m>args.thr).astype(np.uint8)
            b=post(b,args.minsize,args.largest)
            rle_map[(r['id'],cls)]=rle_encode(b) if b.max()>0 else ''
    samp=pd.read_csv(args.sample)
    pred=[rle_map.get((a,b),'') for a,b in zip(samp['id'],samp['class'])]
    samp['predicted']=pred
    samp.to_csv(args.out,index=False)
    print('written',args.out,'rows',len(samp),'nonempty',sum(1 for p in pred if p))
    miss=sum(1 for a,b in zip(samp['id'],samp['class']) if (a,b) not in rle_map)
    print('missing keys',miss)

if __name__=='__main__': main()
