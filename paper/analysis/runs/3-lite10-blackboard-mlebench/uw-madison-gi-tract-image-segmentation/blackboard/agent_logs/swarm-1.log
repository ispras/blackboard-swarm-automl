import os, glob, re, numpy as np, pandas as pd, cv2
ROOT='/download_job_code/payload/sandbox'
CACHE=f'{ROOT}/workspaces/betelgeuse_pi/cache'
S=320
CLASSES=['large_bowel','small_bowel','stomach']

def load_index(split='train'):
    df=pd.read_csv(f'{CACHE}/{split}_index.csv')
    df['row']=np.arange(len(df))
    s=df.sort_values(['case_day','slice']).reset_index(drop=True)
    prev=s['row'].values.copy(); nxt=s['row'].values.copy()
    for _,g in s.groupby('case_day'):
        pos=g.index.values; rows=s.loc[pos,'row'].values
        prev[pos[0]]=rows[0]; nxt[pos[-1]]=rows[-1]
        prev[pos[1:]]=rows[:-1]; nxt[pos[:-1]]=rows[1:]
    s['prev_row']=prev; s['next_row']=nxt
    return df.merge(s[['row','prev_row','next_row']],on='row',how='left')

def rle_decode(rle,H,W):
    flat=np.zeros(H*W,np.uint8)
    if isinstance(rle,str) and len(rle)>0:
        s=rle.split(); st=np.array(s[0::2],dtype=np.int64); ln=np.array(s[1::2],dtype=np.int64)
        for a,l in zip(st,ln):
            if l>0: flat[a-1:a-1+l]=1
    return flat.reshape((H,W),order='C')

def rle_encode(mask):
    p=mask.reshape(-1,order='C')
    if p.max()==0: return ''
    p=np.concatenate([[0],p,[0]]).astype(np.int8)
    runs=np.where(p[1:]!=p[:-1])[0]+1
    runs[1::2]-=runs[0::2]
    return ' '.join(map(str,runs.tolist()))

def keep_small_removed(mask,minsize=0):
    if minsize<=0: return mask
    from scipy import ndimage
    lab,n=ndimage.label(mask)
    if n==0: return mask
    sizes=ndimage.sum(mask,lab,range(1,n+1))
    keep=np.isin(lab,np.where(sizes>=minsize)[0]+1)
    return keep.astype(np.uint8)

def build_probs_native(prob, H, W, thr=0.5, minsize=0):
    # prob: [3,320,320] float
    out=[]
    for c in range(3):
        m=cv2.resize(prob[c],(W,H),interpolation=cv2.INTER_LINEAR)
        b=(m>thr).astype(np.uint8)
        b=keep_small_removed(b,minsize)
        out.append(b)
    return np.stack(out,0)
