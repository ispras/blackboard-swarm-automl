        for pr,idx,w,ln in srcs:
            # position of base id j in this source
            pos=None
            acc+=w*pr[0,0].astype(np.float32)  # placeholder
            break
        break
    # efficient: build per-source inverse mapping
    inv=[]
    for pr,idx,w,ln in srcs:
        m=np.full(N,-1,np.int64)
        for srcpos,basepos in enumerate(idx): m[basepos]=srcpos
        inv.append((pr,m,w))
