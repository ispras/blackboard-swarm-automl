import sys, argparse, numpy as np, pandas as pd, json
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CACHE, CLASSES
from scipy import ndimage

def pp(b,minsize,largest):
    if minsize<=0 and not largest: return b
    lab,n=ndimage.label(b)
    if n==0: return b
    sz=ndimage.sum(b,lab,range(1,n+1))
    if largest: return (lab==int(np.argmax(sz))+1).astype(np.uint8)
    return np.isin(lab,np.where(sz>=minsize)[0]+1).astype(np.uint8)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True); ap.add_argument('--ids',required=True)
    ap.add_argument('--out_json',default='')
    ap.add_argument('--maxrows',type=int,default=0)
    args=ap.parse_args()
    ids=pd.read_csv(args.ids)
    if args.maxrows: ids=ids.iloc[:args.maxrows].reset_index(drop=True)
    probs=np.load(args.probs,mmap_mode='r'); N=len(ids)
    gt=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r')
    rows=ids['row'].values.astype(int)
    gts=np.stack([ (np.asarray(gt[r])>>c)&1 for c in range(3)])  # 3,N,320,320? build per class
    # memory: 3*N*320*320 uint8 ~ 2GB; instead process per class
    thrs=np.arange(0.30,0.86,0.05)
    best_params={}
    for c in range(3):
        gtlist=[(np.asarray(gt[r])>>c)&1 for r in rows]
        # stage1 threshold
        scores=[]
        for t in thrs:
            ds=[]
            for i in range(N):
                b=probs[i,c]>t; g=gtlist[i]
                den=int(b.sum())+int(g.sum())
                ds.append(1.0 if den==0 else 2*int((b.astype(np.uint8)&g).sum())/den)
            scores.append((float(np.mean(ds)),float(t)))
        scores.sort(reverse=True)
        tbest=scores[0][1]
        print(CLASSES[c],'thr top:',[(round(s,4),round(t,2)) for s,t in scores[:3]],flush=True)
        # stage2 minsize
        best=None
        for m in [0,25,50,100,200,400]:
            ds=[]
            for i in range(N):
                b=(probs[i,c]>tbest).astype(np.uint8); b=pp(b,m,False); g=gtlist[i]
                den=int(b.sum())+int(g.sum())
                ds.append(1.0 if den==0 else 2*int((b&g).sum())/den)
            sc=float(np.mean(ds))
            print(f'  {CLASSES[c]} min {m}: dice {sc:.5f}',flush=True)
            if best is None or sc>best[0]: best=(sc,m)
        best_params[CLASSES[c]]={'thr':float(tbest),'min_area':int(best[1]),'keep_largest':False,'fill':True,'dice':best[0]}
        print(CLASSES[c],'chosen',best_params[CLASSES[c]],flush=True)
    print(json.dumps(best_params,indent=2))
    if args.out_json: json.dump(best_params,open(args.out_json,'w'),indent=2)
if __name__=='__main__': main()
PY
