import os, sys, time, argparse, numpy as np, pandas as pd, torch
from torch.utils.data import Dataset, DataLoader
from torch.cuda.amp import autocast
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import load_index, CACHE, S
import segmentation_models_pytorch as smp

class DS(Dataset):
    def __init__(self, df, img):
        self.df=df.reset_index(drop=True); self.img=img
    def __len__(self): return len(self.df)
    def __getitem__(self,p):
        r=self.df.iloc[p]; c=int(r['row']); pr=int(r['prev_row']); nx=int(r['next_row'])
        x=np.stack([self.img[pr],self.img[c],self.img[nx]],axis=-1).astype(np.float32)/255.0
        return torch.from_numpy(x.transpose(2,0,1))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ckpt',required=True)
    ap.add_argument('--split',default='test')
    ap.add_argument('--fold',type=int,default=0)
    ap.add_argument('--bs',type=int,default=64)
    ap.add_argument('--workers',type=int,default=4)
    ap.add_argument('--out',required=True)
    args=ap.parse_args()
    dev='cuda'
    ck=torch.load(args.ckpt,map_location='cpu')
    model=smp.Unet(encoder_name=ck['encoder'],encoder_weights=None,in_channels=3,classes=3,activation=None).to(dev).eval()
    model.load_state_dict(ck['model'])
    df=load_index(args.split)
    if args.split=='train':
        df=df[df.fold==args.fold].reset_index(drop=True)
    img=np.load(f'{CACHE}/{args.split}_img_u8.npy',mmap_mode='r')
    ds=DS(df,img); dl=DataLoader(ds,batch_size=args.bs,num_workers=args.workers,pin_memory=True)
    N=len(df); probs=np.lib.format.open_memmap(f'{args.out}_probs.npy',mode='w+',dtype=np.float16,shape=(N,3,S,S))
    p=0
    with torch.no_grad():
        for x in dl:
            x=x.to(dev,non_blocking=True)
            with autocast(): lo=model(x)
            pr=torch.sigmoid(lo).float().cpu().numpy().astype(np.float16)
            probs[p:p+len(pr)]=pr; p+=len(pr)
    probs.flush()
    df[['id','case_day','case','slice','H','W','row']].to_csv(f'{args.out}_ids.csv',index=False)
    print('saved',args.out,N,'p=',p)

if __name__=='__main__': main()
