import os, numpy as np, pandas as pd, cv2, torch
from torch.utils.data import Dataset
import albumentations as A

ROOT='/download_job_code/payload/sandbox'
CACHE=f'{ROOT}/workspaces/betelgeuse_pi/cache'
S=320

def build_neighbors(df):
    # df per split with slice, case_day sorted
    df=df.sort_values(['case_day','slice']).reset_index(drop=True)
    prev=np.arange(len(df)); nxt=np.arange(len(df))
    for _,idx in df.groupby('case_day').groups.items():
        idx=np.array(sorted(idx))
        prev[idx[0]]=idx[0]; nxt[idx[-1]]=idx[-1]
        prev[idx[1:]]=idx[:-1]; nxt[idx[:-1]]=idx[1:]
    df['prev_idx']=prev; df['next_idx']=nxt
    return df

def make_tf(train=True):
    if train:
        return A.Compose([
            A.HorizontalFlip(p=0.5),
            A.VerticalFlip(p=0.5),
            A.ShiftScaleRotate(shift_limit=0.0625, scale_limit=0.15, rotate_limit=15,
                               border_mode=cv2.BORDER_REPLICATE, p=0.5),
            A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),
            A.OneOf([A.GaussNoise(var_limit=(5,30)), A.GaussianBlur(blur_limit=(3,5)), A.MotionBlur(blur_limit=5)], p=0.2),
        ])
    return None

class GIDataset(Dataset):
    def __init__(self, idx, img_mm, msk_mm, train=True):
        self.df=idx.reset_index(drop=True)
        self.img=img_mm; self.msk=msk_mm
        self.train=train; self.tf=make_tf(train)
    def __len__(self): return len(self.df)
    def __getitem__(self,p):
        r=self.df.iloc[p]
        i=int(r.name) if False else None
        # store position via column
        c=int(r['pos'])
        pr=int(r['prev_idx']); nx=int(r['next_idx'])
        img=np.stack([self.img[pr],self.img[c],self.img[nx]],axis=-1)  # H,W,3 uint8
        bits=self.msk[c]
        msk=np.stack([(bits>>0)&1,(bits>>1)&1,(bits>>2)&1],axis=-1).astype(np.float32)
        if self.tf is not None:
            out=self.tf(image=img,mask=msk); img=out['image']; msk=out['mask']
        img=img.astype(np.float32)/255.0
        img=np.transpose(img,(2,0,1))
        msk=np.transpose(msk,(2,0,1))
        return torch.from_numpy(img), torch.from_numpy(msk)

def load_split(fold=0, res=S):
    idx=pd.read_csv(f'{CACHE}/train_index.csv')
    idx=build_neighbors(idx)
    tridx=idx[idx.fold!=fold].copy(); vaidx=idx[idx.fold==fold].copy()
    tridx['pos']=tridx.index; vaidx['pos']=vaidx.index
    # neighbors computed on full order; need remap to positions in each sub-df? prev_idx refers to sorted reset index of full df
    # rebuild mapping: full sorted df index == positions; we saved prev_idx based on sorted reset positions.
    return idx, tridx, vaidx
