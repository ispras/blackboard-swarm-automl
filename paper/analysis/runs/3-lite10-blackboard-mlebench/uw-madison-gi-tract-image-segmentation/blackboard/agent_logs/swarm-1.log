import sys, json, argparse, numpy as np, pandas as pd
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CACHE, CLASSES
from scipy import ndimage

def pp2d(p,thr,minarea,fill=True):
    m=p>thr
    if not m.any(): return np.zeros((320,320),np.uint8)
    if fill: m=ndimage.binary_fill_holes(m)
    if minarea>0:
        lab,n=ndimage.label(m)
        if n>1:
            sz=ndimage.sum(m,lab,range(1,n+1)); keep=np.where(sz>=minarea)[0]+1
            m=np.isin(lab,keep)
    return m.astype(np.uint8)

def dice_rows(preds,gts):
    ds=[]
    for b,g in zip(preds,gts):
        den=int(b.sum())+int(g.sum())
        ds.append(1.0 if den==0 else 2*int((b.astype(np.uint8)&g).sum())/den)
    return float(np.mean(ds))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True); ap.add_argument('--ids',required=True)
    ap.add_argument('--params',required=True)
    ap.add_argument('--vols',default='0,300,1000,3000,8000')
    args=ap.parse_args()
    params=json.load(open(args.params))
    ids=pd.read_csv(args.ids); probs=np.load(args.probs,mmap_mode='r')
    gtmm=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r')
    vols=[int(x) for x in args.vols.split(',')]
    ids['idx']=np.arange(len(ids))
    for c,cls in enumerate(CLASSES):
        p=params[cls]; thr=p['thr']; minarea=p['min_area']
        # build per-scan stacks
        scans=[]
        for cd,g in ids.groupby('case_day'):
            g=g.sort_values('slice')
            idxs=g['idx'].values; rows=g['row'].values.astype(int)
            P=np.stack([pp2d(probs[i,c].astype(np.float32),thr,minarea) for i in idxs])
            G=np.stack([((np.asarray(gtmm[r])>>c)&1) for r in rows]).astype(np.uint8)
            scans.append((P,G))
        gts=[g for _,g in scans]
        base=[P for P,_ in scans]
        # flatten in scan order
        d0=dice_rows([m for P in base for m in P],[m for G in gts for m in G])
        out=[('base',d0,0)]
        for V in vols:
            if V==0: continue
            preds=[]
            for P,G in scans:
                Q=P.copy()
                if Q.sum()>0:
                    lab,n=ndimage.label(Q>0,np.ones((3,3,3)))
                    if n>0:
                        sz=ndimage.sum(Q>0,lab,range(1,n+1))
                        keep=np.where(sz>=V)[0]+1
                        Q=np.isin(lab,keep).astype(np.uint8)
                preds.append(Q)
            df=dice_rows([m for Q in preds for m in Q],[m for G in gts for m in G])
            # count removed
            rem=int(sum((P>0).sum()-(Q>0).sum() for P,Q in zip(base,preds)))
            out.append((f'3dcc>={V}',df,rem))
        print('==',cls)
        for name,d,rem in out: print(f'  {name:12s} dice {d:.5f} removed_vox {rem}')
if __name__=='__main__': main()
PY
