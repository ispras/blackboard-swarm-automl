        for pr,m,w in inv:
            acc+=w*pr[int(m[j])].astype(np.float32)
        out[j]=(acc/W).astype(np.float16)
        if j%1000==0: print('row',j,flush=True)
    out.flush()
    base_ids.to_csv(args.out.replace('_probs.npy','_ids.csv'),index=False)
    print('ensembled',N,'->',args.out)
if __name__=='__main__': main()
