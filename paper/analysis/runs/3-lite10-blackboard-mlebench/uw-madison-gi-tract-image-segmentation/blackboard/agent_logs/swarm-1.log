import sys, argparse, numpy as np, pandas as pd
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--specs',nargs='+',required=True)
    ap.add_argument('--out',required=True)
    ap.add_argument('--base_ids',default='')
    ap.add_argument('--weights',default='')
    args=ap.parse_args()
    specs=[]
    for s in args.specs:
        p,i=s.split(':'); specs.append((p,i))
    weights=[float(x) for x in args.weights.split(',')] if args.weights else [1.0]*len(specs)
    base=pd.read_csv(args.base_ids) if args.base_ids else pd.read_csv(specs[0][1])
    bmap={k:j for j,k in enumerate(base['id'])}; N=len(base)
    invs=[]
    for p,i in specs:
        ids=pd.read_csv(i); assert set(ids['id'])==set(base['id'])
        inv=np.array([bmap[k] for k in ids['id']])
        invs.append((np.load(p,mmap_mode='r'),inv))
    W=sum(weights)
    out=np.lib.format.open_memmap(args.out,mode='w+',dtype=np.float16,shape=(N,3,320,320))
    bs=256
    for s in range(0,N,bs):
        acc=np.zeros((min(bs,N-s),3,320,320),np.float32)
        for (pr,inv),w in zip(invs,weights):
            acc+=w*pr[inv[s:s+bs]].astype(np.float32)
        out[s:s+bs]=(acc/W).astype(np.float16)
        if s%2048==0: print('row',s,flush=True)
    out.flush(); base.to_csv(args.out.replace('_probs.npy','_ids.csv'),index=False)
    print('out',args.out,N)
if __name__=='__main__': main()
PY
echo ok
ok
