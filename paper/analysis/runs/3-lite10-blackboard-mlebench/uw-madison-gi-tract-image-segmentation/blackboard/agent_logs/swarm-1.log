import sys, argparse, numpy as np, pandas as pd
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CACHE
from scipy import ndimage

def post(b,minsize,largest):
    if minsize<=0 and not largest: return b
    lab,n=ndimage.label(b)
    if n==0: return b
    sz=ndimage.sum(b,lab,range(1,n+1))
    if largest:
        return (lab==int(np.argmax(sz))+1).astype(np.uint8)
    return np.isin(lab,np.where(sz>=minsize)[0]+1).astype(np.uint8)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True); ap.add_argument('--ids',required=True)
    ap.add_argument('--thrs',default='0.3,0.4,0.5,0.6,0.7')
    ap.add_argument('--minsizes',default='0,20,50,100,200')
    ap.add_argument('--largest',action='store_true')
    ap.add_argument('--maxrows',type=int,default=0)
    args=ap.parse_args()
    ids=pd.read_csv(args.ids)
    if args.maxrows: ids=ids.iloc[:args.maxrows].reset_index(drop=True)
    probs=np.load(args.probs,mmap_mode='r')
    gt=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r')
    thrs=[float(x) for x in args.thrs.split(',')]
    mins=[int(x) for x in args.minsizes.split(',')]
    # accumulate dice sums per (thr,min)
    acc={}
    for i,r in ids.iterrows():
        bits=np.asarray(gt[int(r['row'])])
        gts=[(bits>>c)&1 for c in range(3)]
        for c in range(3):
            p=probs[i,c].astype(np.float32); g=gts[c]
            for t in thrs:
                b=(p>t).astype(np.uint8)
                for m in mins:
                    bb=post(b,m,args.largest)
                    den=int(bb.sum()+g.sum())
                    d=1.0 if den==0 else 2*int((bb&g).sum())/den
                    acc.setdefault((t,m),[])
                    acc[(t,m)].append(d)
    rows=[]
    for (t,m),v in acc.items():
        v=np.array(v); rows.append((t,m,float(v.mean())))
    rows.sort(key=lambda x:-x[2])
    print('thr minsize mean_dice')
    for t,m,d in rows: print(f'{t:.2f} {m:4d} {d:.5f}')
    print('BEST',rows[0])

if __name__=='__main__': main()
