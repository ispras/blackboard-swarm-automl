import os, sys, argparse, numpy as np, pandas as pd, cv2
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CLASSES, rle_decode
from scipy import ndimage
from scipy.spatial import cKDTree
ROOT='/download_job_code/payload/sandbox'

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True)
    ap.add_argument('--ids',required=True)
    ap.add_argument('--thr',type=float,default=0.5)
    ap.add_argument('--minsize',type=int,default=0)
    ap.add_argument('--largest',action='store_true')
    ap.add_argument('--cache_native',default='')
    ap.add_argument('--no_hd',action='store_true')
    args=ap.parse_args()
    ids=pd.read_csv(args.ids)
    probs=np.load(args.probs,mmap_mode='r')
    lab=pd.read_csv(f'{ROOT}/data/train.csv')
    gt={}
    for id_,cls,sg in zip(lab['id'],lab['class'],lab['segmentation']):
        if isinstance(sg,str): gt.setdefault(id_,{})[cls]=sg
    N=len(ids)
    # native probs cache (uint8)
    if args.cache_native and os.path.exists(args.cache_native):
        nat=np.load(args.cache_native,mmap_mode='r')
    else:
        nat=np.zeros((N,3,320,320),np.uint8)  # placeholder, but native sizes vary -> store per row? use dict
        nat=None
    dice_all=[]; dice_pos=[]; percls={c:[] for c in range(3)}; percls_pos={c:[] for c in range(3)}
    # for HD group by case_day
    vols={}
    for i,r in ids.iterrows():
        H,W=int(r['H']),int(r['W']); id_=r['id']; cd=r['case_day']
        g=gt.get(id_,{})
        for c,cls in enumerate(CLASSES):
            m=cv2.resize(probs[i,c].astype(np.float32),(W,H),interpolation=cv2.INTER_LINEAR)
            b=(m>args.thr).astype(np.uint8)
            if args.minsize>0 or args.largest:
                lb,nn=ndimage.label(b)
                if nn>0:
                    sz=ndimage.sum(b,lb,range(1,nn+1))
                    if args.largest:
                        k=int(np.argmax(sz))+1; b=(lb==k).astype(np.uint8)
                    else:
                        b=np.isin(lb,np.where(sz>=args.minsize)[0]+1).astype(np.uint8)
            gt_m=rle_decode(g.get(cls,''),H,W)
            inter=int((b&gt_m).sum()); den=int(b.sum()+gt_m.sum())
            d=1.0 if den==0 else 2*inter/den
            dice_all.append(d); percls[c].append(d)
            if gt_m.sum()>0:
                dice_pos.append(d); percls_pos[c].append(d)
            if not args.no_hd:
                vols.setdefault((cd,cls),[]).append((int(r['slice']),b,gt_m,H,W))
    dice_all=np.array(dice_all); percls={k:np.array(v) for k,v in percls.items()}
    print('rows',len(dice_all))
    print('DICE all rows mean %.4f'%dice_all.mean())
    print('DICE per class all', {CLASSES[c]:round(float(percls[c].mean()),4) for c in range(3)})
    print('DICE positive-only mean %.4f'%np.mean(dice_pos),'n',len(dice_pos))
    print('DICE pos per class',{CLASSES[c]:round(float(np.mean(percls_pos[c])),4) for c in range(3)})
    if not args.no_hd:
        combos=[]; hds=[]; d3s=[]
        for (cd,cls),items in vols.items():
            items.sort(key=lambda x:x[0])
            P=[];G=[]; zs=[]
            for z,b,gm,H,W in items:
                ys,xs=np.where(b>0); 
                P.append(np.stack([np.full(len(ys),z),ys/H,xs/W],1) if len(ys) else np.zeros((0,3)))
                ys,xs=np.where(gm>0)
                G.append(np.stack([np.full(len(ys),z),ys/H,xs/W],1) if len(ys) else np.zeros((0,3)))
                zs.append(z)
            P=np.concatenate(P,0); G=np.concatenate(G,0)
            zr=max(zs)-min(zs)+1
            P[:,0]/=max(zr,1); G[:,0]/=max(zr,1)
            ip=len(P); ig=len(G)
            d3 = 1.0 if ip+ig==0 else (0.0 if ip==0 or ig==0 else 2*0/ (ip+ig))
            # dice 3D voxel overlap not computed from points; approximate via total counts? recompute below
            # use voxel count dice from masks
            tp=0
            # build sets for dice using integer coords requires memory; do overlap via per-slice boolean already? skip
            # approximate dice3d by mean per-slice dice for positive items
            dl=[]
            for z,b,gm,H,W in items:
                den=int(b.sum()+gm.sum()); dl.append(1.0 if den==0 else 2*int((b&gt_m).sum())/den)
            d3=float(np.mean(dl))
            if ip==0 and ig==0:
                hd=0.0
            elif ip==0 or ig==0:
                hd=1.0
            else:
                tp=cKDTree(P); tg=cKDTree(G)
                dp,_=tg.query(P,k=1); dg,_=tp.query(G,k=1)
                hd=float(max(dp.max(),dg.max()))
            hs=max(0.0,1.0-hd/np.sqrt(3.0))
            combos.append(0.4*d3+0.6*hs); hds.append(hs); d3s.append(d3)
        print('SCAN-CLASS n',len(combos),'dice3d %.4f'%np.mean(d3s),'hdscore %.4f'%np.mean(hds),'COMBO %.4f'%np.mean(combos))
        print('DICE_POS_ONLY %.4f | COMBO %.4f'%(np.mean(dice_pos),np.mean(combos)))

if __name__=='__main__': main()
