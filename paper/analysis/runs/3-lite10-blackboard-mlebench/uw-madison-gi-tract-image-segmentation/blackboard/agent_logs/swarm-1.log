import sys, json, argparse, numpy as np, pandas as pd
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CACHE, CLASSES
from scipy import ndimage
from scipy.spatial import cKDTree

def pp2d(m,minarea,fill=True):
    m=m.astype(bool)
    if not m.any(): return np.zeros(m.shape,np.uint8)
    if fill: m=ndimage.binary_fill_holes(m)
    if minarea>0:
        lab,n=ndimage.label(m)
        if n>1:
            sz=ndimage.sum(m,lab,range(1,n+1)); keep=np.where(sz>=minarea)[0]+1
            m=np.isin(lab,keep)
    return m.astype(np.uint8)

def cc3d(P,minvol):
    if minvol<=0 or P.sum()==0: return P
    lab,n=ndimage.label(P>0,np.ones((3,3,3)))
    if n>0:
        sz=ndimage.sum(P>0,lab,range(1,n+1)); keep=np.where(sz>=minvol)[0]+1
        return np.isin(lab,keep).astype(np.uint8)
    return P

def hd(P,G,sub=2):
    def pts(M):
        z,y,x=np.where(M>0)
        if sub>1: sel=np.arange(0,len(z),sub); z,y,x=z[sel],y[sel],x[sel]
        Z=M.shape[0]
        return np.stack([z/max(Z,1),y/320.,x/320.],1) if len(z) else np.zeros((0,3))
    p,g=pts(P),pts(G)
    if len(p)==0 and len(g)==0: return 0.0
    if len(p)==0 or len(g)==0: return 1.0
    return float(min(1.0,max(cKDTree(g).query(p)[0].max(),cKDTree(p).query(g)[0].max())/np.sqrt(3)))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--specs',nargs='+',required=True,help='probs:ids:params_json  (params classes->thr,min_area|min_size2d,minvol3d|min_vol3d)')
    ap.add_argument('--mode',default='both')
    args=ap.parse_args()
    models=[]
    for s in args.specs:
        p,i,j=s.split(':'); models.append((np.load(p,mmap_mode='r'),pd.read_csv(i),json.load(open(j))))
    base_ids=models[0][1]; keep=['id','case_day','slice','row','H','W']
    ids=base_ids[keep].copy(); ids['idx']=np.arange(len(ids))
    maps=[]
    for pr,df,pa in models:
        maps.append({k:j for j,k in enumerate(df['id'])})
    gtmm=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r')
    variants=[]
    if args.mode in ('both','probavg'):
        for t in [0.40,0.45,0.50,0.55]: variants.append(('probavg',t))
    if args.mode in ('both','vote'):
        for t in [0.5,0.34]: variants.append(('vote',t))
    dice={v:[] for v in variants}; hds={v:[] for v in variants}
    for cd,g in ids.groupby('case_day'):
        g=g.sort_values('slice'); ii=g['idx'].values; rr=g['row'].values.astype(int)
        pos=[]
        for (pr,df,pa),mp in zip(models,maps):
            pos.append(np.array([mp[base_ids.loc[k,'id']] for k in ii]))
        for c,cls in enumerate(CLASSES):
            gts=np.stack([((np.asarray(gtmm[r])>>c)&1) for r in rr]).astype(np.uint8)
            probs=[np.stack([pr[int(pz[z]),c].astype(np.float32) for z in range(len(ii))]) for (pr,_,_),pz in zip(models,pos)]
            pa=[m[2] for m in models]
            # prob avg
            if args.mode in ('both','probavg'):
                avgp=np.mean(probs,axis=0)
                for t in [0.40,0.45,0.50,0.55]:
                    P=np.stack([pp2d(avgp[z]>t,50) for z in range(len(ii))]); P=cc3d(P,300)
                    v=('probavg',t)
                    for z in range(len(ii)):
                        den=int(P[z].sum())+int(gts[z].sum()); dice[v].append(1.0 if den==0 else 2*int((P[z]&gts[z]).sum())/den)
                    hds[v].append(hd(P,gts))
            if args.mode in ('both','vote'):
                bins=[]
                for mi in range(len(probs)):
                    pj=pa[mi][cls]; thr=pj['thr']; ma=pj.get('min_area',pj.get('min_size2d',0)); mv=pj.get('minvol3d',pj.get('min_vol3d',0))
                    B=np.stack([pp2d(probs[mi][z]>thr,ma) for z in range(len(ii))]); B=cc3d(B,mv); bins.append(B)
                vote=np.mean(bins,axis=0)
                for t in [0.5,0.34]:
                    P=cc3d((vote>=t).astype(np.uint8),300); v=('vote',t)
                    for z in range(len(ii)):
                        den=int(P[z].sum())+int(gts[z].sum()); dice[v].append(1.0 if den==0 else 2*int((P[z]&gts[z]).sum())/den)
                    hds[v].append(hd(P,gts))
    for v in variants:
        d=np.mean(dice[v]); h=np.mean(hds[v]); print(v,f'dice {d:.4f} hd {h:.4f} combo {0.4*d+0.6*(1-h):.4f}',flush=True)
if __name__=='__main__': main()
