import sys, json, argparse, numpy as np, pandas as pd
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/betelgeuse_pi/scripts')
from common import CACHE, CLASSES
from scipy import ndimage
from scipy.spatial import cKDTree

def pp2d(p,thr,minarea,fill=True):
    m=p>thr
    if not m.any(): return np.zeros((320,320),np.uint8)
    if fill: m=ndimage.binary_fill_holes(m)
    if minarea>0:
        lab,n=ndimage.label(m)
        if n>1:
            sz=ndimage.sum(m,lab,range(1,n+1)); keep=np.where(sz>=minarea)[0]+1
            m=np.isin(lab,keep)
    return m.astype(np.uint8)

def hd3d(P,G):
    if len(P)==0 and len(G)==0: return 0.0
    if len(P)==0 or len(G)==0: return 1.0
    dp=cKDTree(G).query(P)[0].max(); dg=cKDTree(P).query(G)[0].max()
    return float(min(1.0,max(dp,dg)/np.sqrt(3.0)))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--probs',required=True); ap.add_argument('--ids',required=True)
    ap.add_argument('--params',required=True); ap.add_argument('--minvol3d',type=int,default=0)
    ap.add_argument('--sub',type=int,default=2)
    args=ap.parse_args()
    params=json.load(open(args.params)); ids=pd.read_csv(args.ids); probs=np.load(args.probs,mmap_mode='r')
    gtmm=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r'); ids['idx']=np.arange(len(ids))
    all_dice=[]; all_hd=[]
    for c,cls in enumerate(CLASSES):
        p=params[cls]; thr=p['thr']; ma=p['min_area']
        dice=[]; hds=[]
        for cd,g in ids.groupby('case_day'):
            g=g.sort_values('slice'); idxs=g['idx'].values; rows=g['row'].values.astype(int)
            P=np.stack([pp2d(probs[i,c].astype(np.float32),thr,ma) for i in idxs]).astype(np.uint8)
            G=np.stack([((np.asarray(gtmm[r])>>c)&1) for r in rows]).astype(np.uint8)
            if args.minvol3d>0 and P.sum()>0:
                lab,n=ndimage.label(P>0,np.ones((3,3,3)))
                if n>0:
                    sz=ndimage.sum(P>0,lab,range(1,n+1)); keep=np.where(sz>=args.minvol3d)[0]+1
                    P=np.isin(lab,keep).astype(np.uint8)
            Z=len(P)
            for z in range(Z):
                den=int(P[z].sum())+int(G[z].sum())
                dice.append(1.0 if den==0 else 2*int((P[z]&G[z]).sum())/den)
            def pts(M):
                zz,yy,xx=np.where(M>0)
                if args.sub>1:
                    sel=np.arange(0,len(zz),args.sub); zz,yy,xx=zz[sel],yy[sel],xx[sel]
                return np.stack([zz/max(Z,1),yy/320.0,xx/320.0],1) if len(zz) else np.zeros((0,3))
            hds.append(hd3d(pts(P),pts(G)))
        d=float(np.mean(dice)); h=float(np.mean(hds))
        print(f'{cls}: dice {d:.4f} hd {h:.4f} combo {0.4*d+0.6*(1-h):.4f}',flush=True)
        all_dice.append(d); all_hd.append(h)
    d=float(np.mean(all_dice)); h=float(np.mean(all_hd))
    print(f'OVERALL dice {d:.4f} hd {h:.4f} COMBO {0.4*d+0.6*(1-h):.4f}')
if __name__=='__main__': main()
PY
