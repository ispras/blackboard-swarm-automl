import numpy as np, pandas as pd, collections
ROOT='/download_job_code/payload/sandbox'
CACHE=f'{ROOT}/workspaces/betelgeuse_pi/cache'
CL=['large_bowel','small_bowel','stomach']
# train GT scan-class presence
tid=pd.read_csv(f'{CACHE}/train_index.csv')
g=np.load(f'{CACHE}/train_mask_bits.npy',mmap_mode='r')
cd_of=dict(zip(tid['id'],tid['case_day'])); row_of=dict(zip(tid['id'],np.arange(len(tid))))
pres=collections.defaultdict(lambda: np.zeros(3,bool))
vol=collections.defaultdict(lambda: np.zeros(3,np.int64))
for id_,cd in cd_of.items():
    b=np.asarray(g[row_of[id_]])
    for c in range(3):
        m=((b>>c)&1)
        if m.any(): pres[cd][c]=True; vol[cd][c]+=int(m.sum())
train_pres=np.array([v for v in pres.values()])
print('TRAIN scan-class present fraction:',train_pres.mean(0).round(3))
tv=np.array([v for v in vol.values()])
print('TRAIN mean volume (320px) per scan-class (all):',tv.mean(0).round(0))
print('TRAIN mean volume when present:',np.array([tv[train_pres[:,c],c].mean() for c in range(3)]).round(0))
# test submission presence
sub=pd.read_csv(f'{ROOT}/final_solution/submission.csv',keep_default_na=False)
t2=pd.read_csv(f'{CACHE}/test_index.csv'); id2cd=dict(zip(t2['id'],t2['case_day']))
tpres=collections.defaultdict(lambda: np.zeros(3,bool)); tvol=collections.defaultdict(lambda: np.zeros(3,np.int64))
for id_,cls,s in zip(sub['id'],sub['class'],sub['predicted']):
    if not isinstance(s,str) or s.strip()=='': continue
    v=np.array(list(map(int,s.split())))
    if len(v)==0: continue
    c=CL.index(cls); cd=id2cd[id_]; tpres[cd][c]=True; tvol[cd][c]+=int(v[1::2].sum())
tp=np.array([v for v in tpres.values()]); tvv=np.array([v for v in tvol.values()])
print('TEST predicted scan-class present fraction:',tp.mean(0).round(3),'n scans',len(tp))
print('TEST mean volume per scan-class (all):',tvv.mean(0).round(0))
print('TEST mean volume when predicted:',np.array([tvv[tp[:,c],c].mean() for c in range(3)]).round(0))
# fully empty scan-class per class
print('TRAIN empty scan-class counts:',((~train_pres)).sum(0),'/',len(train_pres))
print('TEST  empty scan-class counts:',((~tp)).sum(0),'/',len(tp))
