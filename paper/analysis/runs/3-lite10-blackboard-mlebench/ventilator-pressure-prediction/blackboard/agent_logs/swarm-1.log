import numpy as np, json, glob
CACHE='/download_job_code/payload/sandbox/workspaces/aldebaran_eta/cache'
OUT='/download_job_code/payload/sandbox/workspaces/aldebaran_eta'
fold=np.load(f'{CACHE}/fold_train.npy'); y=np.load(f'{CACHE}/y_train.npy'); uo=np.load(f'{CACHE}/uout_train.npy')
n=len(y)
oof=np.full((n,80),np.nan,dtype=np.float32); test=np.zeros((7545,80),dtype=np.float32); cnt=0; per={}
for f in range(5):
    if f==0: tag='f0_t3_120'
    else: tag='t3_150'
    pv=np.load(f'{OUT}/preds/fold{f}_oof_{tag}.npy')
    pt=np.load(f'{OUT}/preds/fold{f}_test_{tag}.npy')
    idx=np.load(f'{OUT}/preds/fold{f}_idx_{tag}.npy')
    assert np.array_equal(idx,np.where(fold==f)[0])
    oof[idx]=pv; test+=pt; cnt+=1
    m=np.abs(pv-y[idx]); insp=uo[idx]==0
    per[f]=float((m*insp).sum()/insp.sum())
test/=cnt
assert not np.isnan(oof).any()
insp=uo==0
overall=float((np.abs(oof-y)*insp).sum()/insp.sum())
np.save(f'{OUT}/preds/oof_t3_5fold.npy',oof.reshape(-1))
np.save(f'{OUT}/preds/test_t3_5fold.npy',test.reshape(-1))
json.dump({'per_fold':per,'overall_oof':overall},open(f'{OUT}/preds/score_t3_5fold.json','w'),indent=2)
print('per_fold',per,'overall',overall)
