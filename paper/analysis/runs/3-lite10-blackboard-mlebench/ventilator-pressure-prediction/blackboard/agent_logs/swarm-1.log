import numpy as np, json
B='/download_job_code/payload/sandbox'
C=f'{B}/workspaces/aldebaran_eta/cache'
y=np.load(f'{C}/y_train.npy').reshape(-1,80)
uo=np.load(f'{C}/uout_train.npy').reshape(-1,80)
fold=np.load(f'{C}/fold_train.npy')
R=np.load(f'{B}/workspaces/bellatrix_omicron/R_train.npy') if False else None
# load R,C from cache? recompute from preprocess arrays not saved. read minimal csv
import pandas as pd
df=pd.read_csv(f'{B}/data/train.csv',usecols=['R','C','time_step'],dtype={'R':np.int16,'C':np.int16,'time_step':np.float32})
Rb=df.R.values.reshape(-1,80); Cb=df.C.values.reshape(-1,80); T=df.time_step.values.reshape(-1,80)
c34=np.load(f'{B}/workspaces/canopus_omega/runs/combined34_oof.npy').reshape(-1,80)
b50=np.load(f'{B}/workspaces/canopus_omega/runs/combined50_oof.npy').reshape(-1,80)
ald=np.load(f'{B}/workspaces/aldebaran_eta/preds/oof_t3_5fold.npy').reshape(-1,80)
w=np.array([0.2686714666056082,0.19731758270993466,0.5340109506844571])
blend=w[0]*b50+w[1]*c34+w[2]*ald
insp=uo==0
def mae(p,mask): return float(np.abs(p-y)[mask].mean())
print('member OOF',mae(c34,insp),mae(b50,insp),mae(ald,insp),'blend',mae(blend,insp))
# leave-one-fold-out evaluation of postproc variants
def lofo_cv(fit_fn,pred_fn):
    scores=[]
    for f in range(5):
        tr=insp&(fold[:,None]!=f); va=insp&(fold[:,None]==f)
        params=fit_fn(tr)
        pp=pred_fn(params,f)
        scores.append(float(np.abs(pp-y)[va].mean()))
    return np.mean(scores),scores
# 1 affine correction
def fit_affine(mask):
    a=blend[mask]; b=y[mask]
    A=np.stack([a,np.ones_like(a)],1)
    coef,_,_,_=np.linalg.lstsq(A,b,rcond=None)
    return coef
def pred_affine(coef,f): return coef[0]*blend+coef[1]
print('affine LOFO',lofo_cv(fit_affine,pred_affine))
# 2 per-step bias
def fit_stepbias(mask):
    full=np.zeros(80); cnt=np.zeros(80)
    d=(y-blend)
    for s in range(80):
        mm=mask[:,s]
        if mm.sum()>0: full[s]=d[mm,s].mean()
    return full
def pred_stepbias(bias,f): return blend+bias[None,:]
print('stepbias LOFO',lofo_cv(fit_stepbias,pred_stepbias))
# 3 per RC bias
combos=[(r,c) for r in [5,20,50] for c in [10,20,50]]
def fit_rcbias(mask):
    d=y-blend; out={}
    for r,c in combos:
        mm=mask&(Rb==r)&(Cb==c)
        out[(r,c)]=float(d[mm].mean()) if mm.sum()>0 else 0.0
    return out
def pred_rcbias(bias,f):
    out=blend.copy()
    for (r,c),v in bias.items(): out[(Rb==r)&(Cb==c)]+=v
    return out
print('rcbias LOFO',lofo_cv(fit_rcbias,pred_rcbias))
# 4 global bias
def fit_gbias(mask): return float((y-blend)[mask].mean())
def pred_gbias(v,f): return blend+v
print('gbias LOFO',lofo_cv(fit_gbias,pred_gbias))
# 5 clip to train target range
print('clip',mae(np.clip(blend,-2,65),insp))
# per RC blend weights? quick check on LOFO (fit weights per group)
from itertools import product
def fit_rcweights(mask):
    d={}
    for r,c in combos:
        mm=mask&(Rb==r)&(Cb==c)
        X=np.stack([b50[mm],c34[mm],ald[mm]],1)
        # project simplex via scipy
        from scipy.optimize import minimize
        def obj(w):
            return np.abs(X@w-y[mm]).mean()
        cons={'type':'eq','fun':lambda w:w.sum()-1}
        res=minimize(obj,np.array([1/3,1/3,1/3]),bounds=[(0,1)]*3,constraints=cons,method='SLSQP')
        d[(r,c)]=res.x
    return d
def pred_rcw(d,f):
    out=np.zeros_like(blend)
    for r,c in combos:
        ww=d[(r,c)]; out[(Rb==r)&(Cb==c)]=ww[0]*b50[(Rb==r)&(Cb==c)]+ww[1]*c34[(Rb==r)&(Cb==c)]+ww[2]*ald[(Rb==r)&(Cb==c)]
    return out
print('rc-weights LOFO',lofo_cv(fit_rcweights,pred_rcw))
