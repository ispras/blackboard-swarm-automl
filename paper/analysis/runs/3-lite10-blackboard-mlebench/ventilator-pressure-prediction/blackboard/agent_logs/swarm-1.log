import numpy as np, pandas as pd, os, time
from sklearn.model_selection import GroupKFold

OUT = os.path.dirname(os.path.abspath(__file__)) + '/../cache'
os.makedirs(OUT, exist_ok=True)
T0=time.time()

def log(*a): print(f'[{time.time()-T0:7.1f}s]', *a, flush=True)

usecols=['id','breath_id','R','C','time_step','u_in','u_out','pressure']
dtypes={'id':np.int64,'breath_id':np.int64,'R':np.int16,'C':np.int16,
        'time_step':np.float32,'u_in':np.float32,'u_out':np.int8,'pressure':np.float32}
tr = pd.read_csv('data/train.csv', usecols=usecols, dtype=dtypes)
te = pd.read_csv('data/test.csv', usecols=[c for c in usecols if c!='pressure'], dtype={k:v for k,v in dtypes.items() if k!='pressure'})
log('loaded', tr.shape, te.shape)

NST=80
# verify contiguous breaths in file order
assert len(tr)%NST==0 and len(te)%NST==0
bid_tr = tr.breath_id.values.reshape(-1,NST)
assert (bid_tr==bid_tr[:,:1]).all(), 'train breaths not contiguous in 80-row blocks'
bid_te = te.breath_id.values.reshape(-1,NST)
assert (bid_te==bid_te[:,:1]).all(), 'test breaths not contiguous'
assert np.all(np.diff(tr.id.values)==1) and np.all(np.diff(te.id.values)==1)
log('contiguity OK; train breaths', bid_tr.shape[0], 'test breaths', bid_te.shape[0])

def fe(df, is_train):
    n=len(df)//NST
    def arr(c): return df[c].values.reshape(n,NST).astype(np.float32)
    u=arr('u_in'); uo=arr('u_out').astype(np.float32); R=arr('R'); C=arr('C'); t=arr('time_step')
    step=np.arange(NST,dtype=np.float32)[None,:].repeat(n,0)
    dt=np.diff(t,axis=1,prepend=t[:,:1]); dt[:,0]=t[:,1]-t[:,0]
    cum=np.cumsum(u,axis=1)
    cum_t=(cum-np.cumsum(u*dt,axis=1))  # dummy
    vol=np.cumsum(u*dt,axis=1)
    cummean=cum/np.arange(1,NST+1,dtype=np.float32)[None,:]
    cummax=np.maximum.accumulate(u,axis=1)
    d1=np.diff(u,axis=1,prepend=u[:,:1]); d1[:,0]=0
    d2=np.diff(d1,axis=1,prepend=d1[:,:1]); d2[:,0]=0
    def lag(a,k):
        if k==0: return a
        out=np.empty_like(a); out[:,k:]=a[:,:-k]; out[:,:k]=a[:,:1]; return out
    def lead(a,k):
        out=np.empty_like(a); out[:,:-k]=a[:,k:]; out[:,-k:]=a[:,-1:]; return out
    def roll(a,w,kind='mean'):
        pad=np.pad(a,((0,0),(w-1,0)),mode='edge')
        if kind=='mean':
            c=np.cumsum(pad,axis=1,dtype=np.float64); return ((c[:,w:]-c[:,:-w])/w).astype(np.float32)
        if kind=='std':
            c=np.cumsum(pad,axis=1,dtype=np.float64); c2=np.cumsum(pad.astype(np.float64)**2,axis=1)
            m=(c[:,w:]-c[:,:-w])/w; v=(c2[:,w:]-c2[:,:-w])/w-m*m
            return np.maximum(v,0).astype(np.float32)**0.5
        if kind=='max':
            from numpy.lib.stride_tricks import sliding_window_view
            return sliding_window_view(pad,(w,),axis=1).max(-1)
    eps=1e-3
    invR=1.0/(R+eps); invC=1.0/(C+eps)
    p_res=u*invR          # flow proxy * resistance-unit
    p_comp=vol*invC       # volume / compliance
    p_phys=u*invR+vol*invC
    feats=[
      u,uo,R,C,t,step/NST,dt,
      d1,d2,lag(u,1),lag(u,2),lag(u,3),lag(u,4),lead(u,1),lead(u,2),
      cum,cummean,cummax,vol,
      roll(u,3,'mean'),roll(u,5,'mean'),roll(u,10,'mean'),
      roll(u,5,'std'),roll(u,10,'std'),roll(u,5,'max'),
      u*u,np.log1p(u),np.sqrt(u),
      invR,invC,p_res,p_comp,p_phys,
      vol*invC*invR, u*invC,
      (u>0).astype(np.float32), (uo>0.5).astype(np.float32)*step,
    ]
    X=np.stack(feats,axis=-1).astype(np.float32)
    return X

Xtr=fe(tr,True); Xte=fe(te,False)
y=tr.pressure.values.reshape(-1,NST).astype(np.float32)
uo_tr=tr.u_out.values.reshape(-1,NST).astype(np.uint8)
bid_tr_u=bid_tr[:,0]; bid_te_u=bid_te[:,0]
log('raw features', Xtr.shape, Xte.shape)

# fill any nan/inf
Xtr=np.nan_to_num(Xtr,nan=0.0,posinf=0.0,neginf=0.0)
Xte=np.nan_to_num(Xte,nan=0.0,posinf=0.0,neginf=0.0)

# standardize per feature (row-wise over all train rows)
mean=Xtr.reshape(-1,Xtr.shape[-1]).mean(0, dtype=np.float64).astype(np.float32)
std=Xtr.reshape(-1,Xtr.shape[-1]).std(0, dtype=np.float64).astype(np.float32)
std[std<1e-6]=1.0
Xtr=(Xtr-mean)/std; Xte=(Xte-mean)/std
log('standardized')

# canonical fold per canopus GroupKFold on sorted unique breath ids
b=np.sort(np.unique(bid_tr_u))
fold_b=np.zeros(len(b),dtype=np.int64)
for f,(_,va) in enumerate(GroupKFold(5).split(b,groups=b)): fold_b[va]=f
mapping=dict(zip(b.tolist(),fold_b.tolist()))
fold_tr=np.array([mapping[x] for x in bid_tr_u.tolist()],dtype=np.int64)
log('folds sizes', np.bincount(fold_tr))

np.save(f'{OUT}/X_train.npy',Xtr); np.save(f'{OUT}/X_test.npy',Xte)
np.save(f'{OUT}/y_train.npy',y); np.save(f'{OUT}/uout_train.npy',uo_tr)
np.save(f'{OUT}/bid_train.npy',bid_tr_u); np.save(f'{OUT}/bid_test.npy',bid_te_u)
np.save(f'{OUT}/fold_train.npy',fold_tr)
np.save(f'{OUT}/ids_test.npy',te.id.values)
np.save(f'{OUT}/norm_mean.npy',mean); np.save(f'{OUT}/norm_std.npy',std)
log('saved cache. n_features=',Xtr.shape[-1])
