import numpy as np, torch, torch.nn as nn
from torch.optim.lr_scheduler import ReduceLROnPlateau

CACHE='/download_job_code/payload/sandbox/workspaces/aldebaran_eta/cache'
OUT='/download_job_code/payload/sandbox/workspaces/aldebaran_eta'

def log(*a): print(*a, flush=True)

class Net(nn.Module):
    def __init__(self,nf,hidden=256,layers=4,drop=0.1,head=128):
        super().__init__()
        self.lstm=nn.LSTM(nf,hidden,layers,batch_first=True,bidirectional=True,
                          dropout=drop if layers>1 else 0.0)
        self.head=nn.Sequential(nn.Linear(hidden*2,head),nn.SiLU(),nn.Dropout(drop),nn.Linear(head,1))
    def forward(self,x):
        o,_=self.lstm(x)
        return self.head(o).squeeze(-1)

class AttnNet(nn.Module):
    def __init__(self,nf,hidden=256,layers=4,drop=0.1,head=128,nhead=4):
        super().__init__()
        self.inp=nn.Linear(nf,hidden)
        enc=nn.TransformerEncoderLayer(d_model=hidden,nhead=nhead,dim_feedforward=hidden*4,
                                       dropout=drop,batch_first=True,activation='gelu',norm_first=True)
        self.enc=nn.TransformerEncoder(enc,num_layers=layers)
        self.head=nn.Sequential(nn.Linear(hidden,head),nn.SiLU(),nn.Dropout(drop),nn.Linear(head,1))
    def forward(self,x):
        h=self.inp(x)
        o=self.enc(h)
        return self.head(o).squeeze(-1)

def build(args,nf):
    if args.arch=='lstm': return Net(nf,args.hidden,args.layers,args.drop,args.head)
    if args.arch=='attn': return AttnNet(nf,args.hidden,args.layers,args.drop,args.head,args.nhead)
    raise ValueError(args.arch)

def mask_weights(uout,loss):
    if loss=='full': return torch.ones_like(uout)
    if loss=='masked': return (uout<0.5).float()
    if loss=='weighted': return torch.where(uout<0.5,torch.ones_like(uout),torch.full_like(uout,0.2))
    raise ValueError(loss)

def run_fold(args,X,y,uout,fold,bid_tr,Xte,bid_te,test_start_end):
    dev='cuda'
    tr_idx=np.where(fold!=args.fold)[0]
    va_idx=np.where(fold==args.fold)[0]
    xva=X[va_idx]; yva=y[va_idx]; uva=uout[va_idx]
    # move all train data for this fold to GPU
    xtr=X[tr_idx]; ytr=y[tr_idx]; utr=uout[tr_idx]
    log(f'fold {args.fold}: train {len(tr_idx)} val {len(va_idx)} nf={X.shape[-1]}')
    model=build(args,X.shape[-1]).to(dev)
    opt=torch.optim.AdamW(model.parameters(),lr=args.lr,weight_decay=args.wd)
    sched=ReduceLROnPlateau(opt,mode='min',factor=0.5,patience=args.lr_patience,min_lr=1e-6)
    n=len(tr_idx); bs=args.batch
    best=1e9; best_state=None; bad=0
    t0=time.time()
    for ep in range(args.epochs):
        model.train()
        perm=np.random.permutation(n)
        tot=0.0; cnt=0
        for i in range(0,n,bs):
            idx=perm[i:i+bs]; idx=torch.from_numpy(idx).to(dev,non_blocking=True)
            xb=xtr[idx]; yb=ytr[idx]; ub=utr[idx]
            pred=model(xb)
            w=mask_weights(ub,args.loss)
            loss=((pred-yb).abs()*w).sum()/(w.sum()+1e-6)
            opt.zero_grad(set_to_none=True); loss.backward()
            nn.utils.clip_grad_norm_(model.parameters(),5.0)
            opt.step()
            tot+=loss.item()*len(idx); cnt+=len(idx)
        model.eval()
        with torch.no_grad():
            preds=[]
            for i in range(0,len(va_idx),1024):
                xb=xva[i:i+1024].to(dev)
                preds.append(model(xb).float().cpu())
            pv=torch.cat(preds)
        m=(pv-uva).abs()
        vmae=(m*(uva<0.5).float()).sum()/ (uva<0.5).float().sum()
        vmae=float(vmae)
        sched.step(vmae)
        if ep%5==0 or ep==args.epochs-1:
            log(f'  ep {ep:3d} loss {tot/max(cnt,1):.4f} val_insp {vmae:.5f} lr {opt.param_groups[0]["lr"]:.2e} {time.time()-t0:.0f}s')
        if vmae<best-1e-6:
            best=vmae; best_state={k:v.detach().clone() for k,v in model.state_dict().items()}; bad=0
        else:
            bad+=1
            if bad>=args.patience:
                log(f'  early stop ep {ep} best {best:.5f}'); break
    model.load_state_dict(best_state); model.eval()
    with torch.no_grad():
        preds=[]
        for i in range(0,len(va_idx),1024):
            preds.append(model(xva[i:i+1024].to(dev)).float().cpu())
        pv=torch.cat(preds).numpy()
        tp=[]
        for i in range(0,len(Xte),1024):
            tp.append(model(Xte[i:i+1024].to(dev)).float().cpu())
        pt=torch.cat(tp).numpy()
    m=np.abs(pv-yva); insp=(uva<0.5)
    vmae=float((m*insp).sum()/insp.sum())
    log(f'fold {args.fold} BEST val_insp {vmae:.5f} time {time.time()-t0:.0f}s')
    return vmae,pv,pt,best_state

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=str,default='0')
    ap.add_argument('--arch',type=str,default='lstm')
    ap.add_argument('--hidden',type=int,default=256)
    ap.add_argument('--layers',type=int,default=4)
    ap.add_argument('--drop',type=float,default=0.1)
    ap.add_argument('--head',type=int,default=128)
    ap.add_argument('--nhead',type=int,default=4)
    ap.add_argument('--batch',type=int,default=512)
    ap.add_argument('--lr',type=float,default=1e-3)
    ap.add_argument('--wd',type=float,default=1e-4)
    ap.add_argument('--epochs',type=int,default=150)
    ap.add_argument('--patience',type=int,default=25)
    ap.add_argument('--lr_patience',type=int,default=6)
    ap.add_argument('--loss',type=str,default='masked')
    ap.add_argument('--tag',type=str,default='lstm_main')
    ap.add_argument('--seed',type=int,default=42)
    ap.add_argument('--slice',type=str,default='all')  # for quick benchmarks: first N breaths
    args=ap.parse_args()
    np.random.seed(args.seed); torch.manual_seed(args.seed)
    X=np.load(f'{CACHE}/X_train.npy',mmap_mode='r')
    y=np.load(f'{CACHE}/y_train.npy')
    uout=np.load(f'{CACHE}/uout_train.npy')
    fold=np.load(f'{CACHE}/fold_train.npy')
    bid=np.load(f'{CACHE}/bid_train.npy')
    Xte=np.load(f'{CACHE}/X_test.npy')
    bid_te=np.load(f'{CACHE}/bid_test.npy')
    if args.slice!='all':
        n=int(args.slice); X=X[:n]; y=y[:n]; uout=uout[:n]; fold=fold[:n]; bid=bid[:n]
    X=np.ascontiguousarray(X); Xte=np.ascontiguousarray(Xte)
    Xt=torch.from_numpy(X).to('cuda'); yt=torch.from_numpy(y).to('cuda')
    ut=torch.from_numpy(uout.astype(np.float32)).to('cuda')
    Xte_t=torch.from_numpy(Xte).to('cuda')
    log(f'GPU tensors ready X {tuple(X.shape)} test {tuple(Xte.shape)}')
    folds=[int(x) for x in args.folds.split(',')]
    oof=np.zeros((X.shape[0],80),dtype=np.float32)
    test_pred=np.zeros((Xte.shape[0],80),dtype=np.float32)
    scores={}
    for f in folds:
        args.fold=f
        vmae,pv,pt,state=run_fold(args,Xt,yt,ut,fold,bid,Xte_t,bid_te,None)
        va_idx=np.where(fold==f)[0]
        oof[va_idx]=pv
        test_pred+=pt
        scores[f]=vmae
        torch.save(state,f'{OUT}/preds/{args.tag}_fold{f}.pt')
    test_pred/=len(folds)
    # flatten to row order
    oof_rows=oof.reshape(-1)
    test_rows=test_pred.reshape(-1)
    if args.slice=='all':
        np.save(f'{OUT}/preds/oof_{args.tag}.npy',oof_rows)
        np.save(f'{OUT}/preds/test_{args.tag}.npy',test_rows)
        # overall insp OOF on evaluated folds
        mask=np.zeros(X.shape[0],dtype=bool); mask[va_idx]=True if len(folds)==1 else True
        # compute on all folds present
        evfold=np.isin(fold,folds)
        m=np.abs(oof_rows.reshape(-1,80)-y)
        insp=(uout<0.5)&evfold[:,None]
        overall=float((m*insp).sum()/insp.sum())
        log(f'OVERALL OOF insp MAE ({folds}) = {overall:.5f}')
        json.dump({'tag':args.tag,'folds':folds,'scores':scores,'overall':overall,'args':vars(args)},
                  open(f'{OUT}/preds/score_{args.tag}.json','w'),indent=2)
    log('DONE')

if __name__=='__main__': main()
