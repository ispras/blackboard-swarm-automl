def log(*a): print(*a, flush=True)
class Net(nn.Module):
    def __init__(self,nf,hidden=512,layers=4,head_layers=2,drop=0.1,head=256):
        super().__init__()
        self.lstm1=nn.LSTM(nf,hidden,layers,batch_first=True,bidirectional=True,dropout=drop if layers>1 else 0.0)
        self.lstm2=nn.LSTM(hidden*2,hidden//2,head_layers,batch_first=True,bidirectional=True,dropout=drop if head_layers>1 else 0.0)
        self.head=nn.Sequential(nn.Linear(hidden,head),nn.SiLU(),nn.Dropout(drop),nn.Linear(head,1))
    def forward(self,x):
        h,_=self.lstm1(x); h,_=self.lstm2(h); return self.head(h).squeeze(-1)
def predict(model,X,dev,bs=1024):
    model.eval(); out=[]
    with torch.no_grad():
        for i in range(0,len(X),bs): out.append(model(X[i:i+bs]).float().cpu().numpy())
    return np.concatenate(out)
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--epochs',type=int,default=150)
    ap.add_argument('--batch',type=int,default=256)
    ap.add_argument('--hidden',type=int,default=512)
    ap.add_argument('--layers',type=int,default=4)
    ap.add_argument('--head_layers',type=int,default=2)
    ap.add_argument('--drop',type=float,default=0.1)
    ap.add_argument('--lr',type=float,default=2e-3)
    ap.add_argument('--wd',type=float,default=1e-4)
    ap.add_argument('--exp_weight',type=float,default=0.1)
    ap.add_argument('--seed',type=int,default=777)
    ap.add_argument('--tag',type=str,default='t3_all')
    args=ap.parse_args()
    np.random.seed(args.seed); torch.manual_seed(args.seed); torch.backends.cudnn.benchmark=True
    dev='cuda'
    Xtr=np.ascontiguousarray(np.load(f'{CACHE}/X_train.npy')); Xte=np.ascontiguousarray(np.load(f'{CACHE}/X_test.npy'))
    ytr=np.load(f'{CACHE}/y_train.npy'); uout=np.load(f'{CACHE}/uout_train.npy')
    ymu=float(ytr[uout==0].mean()); ysd=float(ytr[uout==0].std())
    Xt=torch.from_numpy(Xtr).to(dev); Xte_t=torch.from_numpy(Xte).to(dev)
    yt=torch.from_numpy((ytr-ymu)/ysd).to(dev)
    wt=torch.where(torch.from_numpy(uout.astype(np.float32)).to(dev)<0.5,
                   torch.ones(len(ytr),80,device=dev),torch.ones(len(ytr),80,device=dev)*args.exp_weight)
    n=len(ytr); bs=args.batch; steps=(n+bs-1)//bs
    model=Net(Xt.shape[-1],args.hidden,args.layers,args.head_layers,args.drop,args.head).to(dev)
    opt=torch.optim.AdamW(model.parameters(),lr=args.lr,weight_decay=args.wd)
    sched=OneCycleLR(opt,max_lr=args.lr,total_steps=args.epochs*steps,pct_start=0.12,div_factor=10,final_div_factor=100)
    scaler=torch.cuda.amp.GradScaler(enabled=True); t0=time.time()
    for ep in range(args.epochs):
        model.train(); perm=torch.randperm(n,device=dev); tot=0.0
        for i in range(steps):
            sel=perm[i*bs:(i+1)*bs]; opt.zero_grad(set_to_none=True)
            with torch.cuda.amp.autocast(enabled=True):
                out=model(Xt[sel]); loss=((out-yt[sel]).abs()*wt[sel]).sum()/(wt[sel].sum()+1e-8)
            scaler.scale(loss).backward(); scaler.unscale_(opt); nn.utils.clip_grad_norm_(model.parameters(),5.0)
            scaler.step(opt); scaler.update(); sched.step(); tot+=loss.item()
        if ep%10==0 or ep==args.epochs-1:
            log(f'  ep {ep:3d} loss {tot/steps:.4f} lr {sched.get_last_lr()[0]:.2e} {time.time()-t0:.0f}s')
    pt=predict(model,Xte_t,dev)*ysd+ymu
    np.save(f'{OUT}/preds/test_{args.tag}.npy',pt.reshape(-1).astype(np.float32))
    json.dump({'tag':args.tag,'args':vars(args)},open(f'{OUT}/preds/score_{args.tag}.json','w'),indent=2)
    log('saved all-data test preds', pt.shape)
if __name__=='__main__': main()
