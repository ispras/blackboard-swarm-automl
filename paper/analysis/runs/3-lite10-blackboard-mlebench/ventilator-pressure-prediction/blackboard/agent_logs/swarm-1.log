import pandas as pd, numpy as np
tr = pd.read_csv('data/train.csv', nrows=200000)
tr_full = pd.read_csv('data/train.csv')
print("train shape", tr_full.shape)
print("breaths", tr_full.breath_id.nunique())
g = tr_full.groupby('breath_id').size()
print("steps per breath:", g.value_counts().to_dict())
print("R unique", sorted(tr_full.R.unique()), "C unique", sorted(tr_full.C.unique()))
print("u_out frac", tr_full.u_out.mean())
# inspiratory: first u_out==1
insp = tr_full[tr_full.u_out==0]
print("insp rows", len(insp), "target rows scored approx", len(insp))
print("pressure mean/std", tr_full.pressure.mean(), tr_full.pressure.std())
print("u_in stats", tr_full.u_in.describe())
# per breath number of inspiratory steps
n_insp = tr_full.groupby('breath_id').apply(lambda d: (d.u_out==0).sum())
print("insp steps per breath", n_insp.value_counts().head(10).to_dict())
print("R,C combos counts:")
print(tr_full.groupby(['R','C']).breath_id.nunique())
