import argparse, os, time, json
import numpy as np, torch, torch.nn as nn
from torch.optim.lr_scheduler import ReduceLROnPlateau, OneCycleLR, CosineAnnealingLR

CACHE='/download_job_code/payload/sandbox/workspaces/aldebaran_eta/cache'
OUT='/download_job_code/payload/sandbox/workspaces/aldebaran_eta'

def log(*a): print(*a, flush=True)

class Net(nn.Module):
    def __init__(self,nf,hidden=512,layers=4,drop=0.1,head=128):
        super().__init__()
        self.lstm=nn.LSTM(nf,hidden,layers,batch_first=True,bidirectional=True,
                          dropout=drop if layers>1 else 0.0)
        self.head=nn.Sequential(nn.Linear(hidden*2,head),nn.SiLU(),nn.Dropout(drop),nn.Linear(head,1))
    def forward(self,x):
        o,_=self.lstm(x)
        return self.head(o).squeeze(-1)

def build(args,nf):
    return Net(nf,args.hidden,args.layers,args.drop,args.head)

def weights(uout,loss):
    if loss=='full': return torch.ones_like(uout)
    if loss=='masked': return (uout<0.5).float()
    if loss=='weighted': return torch.where(uout<0.5,torch.ones_like(uout),torch.full_like(uout,0.2))
    raise ValueError(loss)

def predict(model,X,dev,bs=2048):
    model.eval(); out=[]
    with torch.no_grad():
        for i in range(0,len(X),bs):
            out.append(model(X[i:i+bs]).float().cpu())
    return torch.cat(out).numpy()

def run_fold(args,fold):
    dev='cuda'
    Xt=torch.from_numpy(np.ascontiguousarray(np.load(f'{CACHE}/X_train.npy'))).to(dev)
    yt=torch.from_numpy(np.load(f'{CACHE}/y_train.npy')).to(dev)
    ut=torch.from_numpy(np.load(f'{CACHE}/uout_train.npy').astype(np.float32)).to(dev)
    fold_arr=np.load(f'{CACHE}/fold_train.npy')
    Xte=torch.from_numpy(np.ascontiguousarray(np.load(f'{CACHE}/X_test.npy'))).to(dev)
    tr_idx=np.where(fold_arr!=fold)[0]; va_idx=np.where(fold_arr==fold)[0]
    xtr=Xt[tr_idx]; ytr=yt[tr_idx]; utr=ut[tr_idx]
    xva=Xt[va_idx]; yva=yt[va_idx]; uva=ut[va_idx]
    log(f'fold {fold}: train {len(tr_idx)} val {len(va_idx)} nf={Xt.shape[-1]} amp={args.amp}')
    model=build(args,Xt.shape[-1]).to(dev)
    opt=torch.optim.AdamW(model.parameters(),lr=args.lr,weight_decay=args.wd)
    n=len(tr_idx); bs=args.batch; spe=(n+bs-1)//bs
    if args.sched=='onecycle':
        sched=OneCycleLR(opt,max_lr=args.lr,total_steps=args.epochs*spe,pct_start=args.pct_start,
                         div_factor=args.div_factor,final_div_factor=args.final_div)
    elif args.sched=='cosine': sched=CosineAnnealingLR(opt,T_max=args.epochs,eta_min=args.lr*0.01)
    else: sched=ReduceLROnPlateau(opt,mode='min',factor=0.5,patience=args.lr_patience,min_lr=1e-6)
    scaler=torch.cuda.amp.GradScaler(enabled=args.amp)
    best=1e9; best_state=None; bad=0; t0=time.time()
    for ep in range(args.epochs):
        model.train(); perm=np.random.permutation(n); tot=0.0; cnt=0
        for i in range(0,n,bs):
            idx=torch.from_numpy(perm[i:i+bs]).to(dev,non_blocking=True)
            xb=xtr[idx]; yb=ytr[idx]; ub=utr[idx]
            with torch.cuda.amp.autocast(enabled=args.amp):
                pred=model(xb)
                w=weights(ub,args.loss)
                loss=((pred-yb).abs()*w).sum()/(w.sum()+1e-6)
            opt.zero_grad(set_to_none=True)
            scaler.scale(loss).backward()
            scaler.unscale_(opt); nn.utils.clip_grad_norm_(model.parameters(),5.0)
            scaler.step(opt); scaler.update()
            if args.sched=='onecycle': sched.step()
            tot+=loss.item()*len(idx); cnt+=len(idx)
        model.eval()
        pv=predict(model,xva,dev)
        uva_c=uva.cpu().numpy(); yva_c=yva.cpu().numpy()
        insp=uva_c<0.5
        vmae=float((np.abs(pv-yva_c)*insp).sum()/insp.sum())
        if args.sched=='cosine': sched.step()
        if args.sched=='plateau': sched.step(vmae)
        if ep%10==0 or ep==args.epochs-1:
            log(f'  ep {ep:3d} loss {tot/max(cnt,1):.4f} val {vmae:.5f} lr {opt.param_groups[0]["lr"]:.2e} {time.time()-t0:.0f}s')
        if vmae<best-1e-6:
            best=vmae; best_state={k:v.detach().clone() for k,v in model.state_dict().items()}; bad=0
        elif args.patience>0:
            bad+=1
            if bad>=args.patience:
                log(f'  early stop ep {ep} best {best:.5f}'); break
    model.load_state_dict(best_state); model.eval()
    pv=predict(model,xva,dev)
    uva_c=uva.cpu().numpy(); yva_c=yva.cpu().numpy(); insp=uva_c<0.5
    vmae=float((np.abs(pv-yva_c)*insp).sum()/insp.sum())
    pt=predict(model,Xte,dev)
    log(f'fold {fold} BEST {vmae:.5f} time {time.time()-t0:.0f}s')
    # save per-fold
    os.makedirs(f'{OUT}/preds',exist_ok=True)
    np.save(f'{OUT}/preds/fold{fold}_oof_{args.tag}.npy',pv.astype(np.float32))
    np.save(f'{OUT}/preds/fold{fold}_test_{args.tag}.npy',pt.astype(np.float32))
    np.save(f'{OUT}/preds/fold{fold}_idx_{args.tag}.npy',va_idx)
    json.dump({'tag':args.tag,'fold':fold,'val_insp':vmae,'args':vars(args)},
              open(f'{OUT}/preds/fold{fold}_score_{args.tag}.json','w'),indent=2)
    return vmae

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=str,default='0')
    ap.add_argument('--hidden',type=int,default=512)
    ap.add_argument('--layers',type=int,default=4)
    ap.add_argument('--drop',type=float,default=0.1)
    ap.add_argument('--head',type=int,default=128)
    ap.add_argument('--batch',type=int,default=512)
    ap.add_argument('--lr',type=float,default=2e-3)
    ap.add_argument('--wd',type=float,default=1e-4)
    ap.add_argument('--epochs',type=int,default=280)
    ap.add_argument('--patience',type=int,default=0)
    ap.add_argument('--lr_patience',type=int,default=8)
    ap.add_argument('--sched',type=str,default='onecycle')
    ap.add_argument('--pct_start',type=float,default=0.1)
    ap.add_argument('--div_factor',type=float,default=20.0)
    ap.add_argument('--final_div',type=float,default=200.0)
    ap.add_argument('--loss',type=str,default='masked')
    ap.add_argument('--amp',action='store_true')
    ap.add_argument('--tag',type=str,default='lstm_main')
    ap.add_argument('--seed',type=int,default=42)
    args=ap.parse_args()
    np.random.seed(args.seed); torch.manual_seed(args.seed)
    scores={}
    for f in [int(x) for x in args.folds.split(',')]:
        scores[f]=run_fold(args,f)
    log('SCORES',scores)

if __name__=='__main__': main()
