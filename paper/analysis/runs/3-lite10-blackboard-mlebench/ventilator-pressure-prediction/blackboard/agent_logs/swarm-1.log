import argparse, os, time, json
import numpy as np, torch, torch.nn as nn
from torch.optim.lr_scheduler import OneCycleLR

CACHE='/download_job_code/payload/sandbox/workspaces/aldebaran_eta/cache'
OUT='/download_job_code/payload/sandbox/workspaces/aldebaran_eta'
def log(*a): print(*a, flush=True)

class Net(nn.Module):
    def __init__(self,nf,hidden=512,layers=4,head_layers=2,drop=0.1,head=256):
        super().__init__()
        self.lstm1=nn.LSTM(nf,hidden,layers,batch_first=True,bidirectional=True,
                           dropout=drop if layers>1 else 0.0)
        self.lstm2=nn.LSTM(hidden*2,hidden//2,head_layers,batch_first=True,bidirectional=True,
                           dropout=drop if head_layers>1 else 0.0)
        self.head=nn.Sequential(nn.Linear(hidden,head),nn.SiLU(),nn.Dropout(drop),nn.Linear(head,1))
    def forward(self,x):
        h,_=self.lstm1(x); h,_=self.lstm2(h)
        return self.head(h).squeeze(-1)

def predict(model,X,dev,bs=1024):
    model.eval(); out=[]
    with torch.no_grad():
        for i in range(0,len(X),bs): out.append(model(X[i:i+bs]).float().cpu().numpy())
    return np.concatenate(out)

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--folds',type=str,default='0')
    ap.add_argument('--hidden',type=int,default=512)
    ap.add_argument('--layers',type=int,default=4)
    ap.add_argument('--head_layers',type=int,default=2)
    ap.add_argument('--drop',type=float,default=0.1)
    ap.add_argument('--head',type=int,default=256)
    ap.add_argument('--batch',type=int,default=256)
    ap.add_argument('--lr',type=float,default=2e-3)
    ap.add_argument('--wd',type=float,default=1e-4)
    ap.add_argument('--epochs',type=int,default=160)
    ap.add_argument('--patience',type=int,default=20)
    ap.add_argument('--exp_weight',type=float,default=0.1)
    ap.add_argument('--pct_start',type=float,default=0.12)
    ap.add_argument('--div_factor',type=float,default=10.0)
    ap.add_argument('--final_div',type=float,default=100.0)
    ap.add_argument('--amp',action='store_true')
    ap.add_argument('--tag',type=str,default='lstm3')
    ap.add_argument('--seed',type=int,default=42)
    ap.add_argument('--slice',type=str,default='all')
    args=ap.parse_args()
    np.random.seed(args.seed); torch.manual_seed(args.seed)
    torch.backends.cudnn.benchmark=True
    dev='cuda'
    Xtr=np.load(f'{CACHE}/X_train.npy',mmap_mode='r'); Xte=np.load(f'{CACHE}/X_test.npy')
    ytr=np.load(f'{CACHE}/y_train.npy'); uout=np.load(f'{CACHE}/uout_train.npy')
    fold=np.load(f'{CACHE}/fold_train.npy')
    if args.slice!='all':
        n=int(args.slice); Xtr=Xtr[:n]; ytr=ytr[:n]; uout=uout[:n]; fold=fold[:n]
    Xtr=np.ascontiguousarray(Xtr); Xte=np.ascontiguousarray(Xte)
    ymu=float(ytr[uout==0].mean()); ysd=float(ytr[uout==0].std())
    log(f'features={Xtr.shape[-1]} target {ymu:.3f}/{ysd:.3f}')
    Xt=torch.from_numpy(Xtr).to(dev); Xte_t=torch.from_numpy(Xte).to(dev)
    yt=torch.from_numpy((ytr-ymu)/ysd).to(dev)
    wt=torch.where(torch.from_numpy(uout.astype(np.float32)).to(dev)<0.5,
                   torch.ones(len(ytr),80,device=dev)*1.0,
                   torch.ones(len(ytr),80,device=dev)*args.exp_weight)
    # keep raw y and uout on gpu for eval
    yraw=torch.from_numpy(ytr).to(dev); ugpu=torch.from_numpy(uout.astype(np.float32)).to(dev)
    scores={}
    for f in [int(x) for x in args.folds.split(',')]:
        tr_idx=np.where(fold!=f)[0]; va_idx=np.where(fold==f)[0]
        Xf=Xt[tr_idx]; yf=yt[tr_idx]; wf=wt[tr_idx]
        Xv=Xt[va_idx]; yv=yraw[va_idx]; uv=ugpu[va_idx]
        n=len(tr_idx); bs=args.batch; steps=(n+bs-1)//bs
        model=Net(Xt.shape[-1],args.hidden,args.layers,args.head_layers,args.drop,args.head).to(dev)
        opt=torch.optim.AdamW(model.parameters(),lr=args.lr,weight_decay=args.wd)
        sched=OneCycleLR(opt,max_lr=args.lr,total_steps=args.epochs*steps,pct_start=args.pct_start,
                         div_factor=args.div_factor,final_div_factor=args.final_div)
        scaler=torch.cuda.amp.GradScaler(enabled=args.amp)
        best=1e9; best_state=None; bad=0; t0=time.time()
        for ep in range(args.epochs):
            model.train(); perm=torch.randperm(n,device=dev); tot=0.0
            for i in range(steps):
                sel=perm[i*bs:(i+1)*bs]
                opt.zero_grad(set_to_none=True)
                with torch.cuda.amp.autocast(enabled=args.amp):
                    out=model(Xf[sel])
                    loss=((out-yf[sel]).abs()*wf[sel]).sum()/(wf[sel].sum()+1e-8)
                scaler.scale(loss).backward()
                scaler.unscale_(opt); nn.utils.clip_grad_norm_(model.parameters(),5.0)
                scaler.step(opt); scaler.update(); sched.step()
                tot+=loss.item()
            pv=predict(model,Xv,dev)*ysd+ymu
            yvn=yv.cpu().numpy(); uvn=uv.cpu().numpy(); insp=uvn<0.5
            vmae=float((np.abs(pv-yvn)*insp).sum()/insp.sum())
            if ep%10==0 or ep==args.epochs-1:
                log(f'  f{f} ep {ep:3d} loss {tot/steps:.4f} val {vmae:.5f} lr {sched.get_last_lr()[0]:.2e} {time.time()-t0:.0f}s')
            if vmae<best-1e-5:
                best=vmae; bad=0; best_state={k:v.detach().clone() for k,v in model.state_dict().items()}
            else:
                bad+=1
                if args.patience>0 and bad>=args.patience:
                    log(f'  early stop ep {ep} best {best:.5f}'); break
        model.load_state_dict(best_state); model.eval()
        pv=predict(model,Xv,dev)*ysd+ymu
        yvn=yv.cpu().numpy(); uvn=uv.cpu().numpy(); insp=uvn<0.5
        vmae=float((np.abs(pv-yvn)*insp).sum()/insp.sum())
        pt=predict(model,Xte_t,dev)*ysd+ymu
        log(f'FOLD {f} BEST {vmae:.5f} time {time.time()-t0:.0f}s')
        os.makedirs(f'{OUT}/preds',exist_ok=True)
        np.save(f'{OUT}/preds/fold{f}_oof_{args.tag}.npy',pv.astype(np.float32))
        np.save(f'{OUT}/preds/fold{f}_test_{args.tag}.npy',pt.astype(np.float32))
        np.save(f'{OUT}/preds/fold{f}_idx_{args.tag}.npy',va_idx)
        json.dump({'tag':args.tag,'fold':f,'val_insp':vmae,'args':vars(args)},
                  open(f'{OUT}/preds/fold{f}_score_{args.tag}.json','w'),indent=2)
        scores[f]=vmae
    log('SCORES',scores,'mean',float(np.mean(list(scores.values()))))

if __name__=='__main__': main()
