def eval_corr(folds_fit, folds_eval, mode):
  mf=np.zeros(n,bool); me=np.zeros(n,bool)
  for f in folds_fit: mf|=(fold==f)
  for f in folds_eval: me|=(fold==f)
  mf&=insp; me&=insp
