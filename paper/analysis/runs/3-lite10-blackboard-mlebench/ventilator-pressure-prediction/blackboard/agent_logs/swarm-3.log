import argparse, json, os
import numpy as np
import pandas as pd
from scipy.optimize import minimize

BASE = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
p = argparse.ArgumentParser()
p.add_argument('--models', type=str, required=True, help='comma list name=oof_path:test_path')
p.add_argument('--submission', type=str, default='')
p.add_argument('--report', type=str, default='blend2_report.json')
p.add_argument('--per_group', action='store_true')
p.add_argument('--cv_check', action='store_true')
args = p.parse_args()

tr = pd.read_csv(os.path.join(BASE, 'data/train.csv'), usecols=['id', 'u_out', 'pressure', 'R', 'C', 'breath_id'])
te = pd.read_csv(os.path.join(BASE, 'data/test.csv'), usecols=['id'])
y = tr.pressure.to_numpy(np.float64)
mask = (tr.u_out.to_numpy() == 0)
breaths = tr.breath_id.to_numpy()
names, oofs, tests = [], [], []
for spec in args.models.split(','):
    name, paths = spec.split('=')
    op, tpath = paths.split(':')
    o = np.load(op).reshape(-1).astype(np.float64)
    t = np.load(tpath).reshape(-1).astype(np.float64)
    assert len(o) == len(tr), (name, len(o), len(tr))
    assert len(t) == len(te), (name, len(t), len(te))
    names.append(name); oofs.append(o); tests.append(t)
    print(f'{name}: full OOF insp MAE {np.abs(o[mask & np.isfinite(o)]-y[mask & np.isfinite(o)]).mean():.5f} (finite {int(np.isfinite(o).sum())})')

O = np.stack(oofs, 1)
valid = mask & np.isfinite(O).all(1)
print('valid rows for blend', int(valid.sum()), 'of', int(mask.sum()), 'insp; folds:',
      {int(f): int(((breaths % 5 == f) & valid).sum()) for f in range(5)})
A = O[valid]
b = y[valid]
gR = tr.R.to_numpy()[valid]; gC = tr.C.to_numpy()[valid]
gid = breaths[valid]
w_eq = np.ones(len(names)) / len(names)
print('equal-weight MAE', np.abs(A @ w_eq - b).mean())


def opt_weights(Amat, bvec, x0=None):
    if x0 is None:
        x0 = np.ones(Amat.shape[1]) / Amat.shape[1]
    cons = [{'type': 'eq', 'fun': lambda w: w.sum() - 1}]
    res = minimize(lambda w: np.abs(Amat @ w - bvec).mean(), x0, method='SLSQP',
                   bounds=[(0, 1)] * Amat.shape[1], constraints=cons,
                   options={'maxiter': 300, 'ftol': 1e-10})
    return res.x


w = opt_weights(A, b)
print('global weights', dict(zip(names, np.round(w, 4))), 'MAE', np.abs(A @ w - b).mean())

wg = {}
if args.per_group:
    # breath-level 2-fold CV to compare global vs per-group honestly
    if args.cv_check:
        rng = np.random.RandomState(1)
