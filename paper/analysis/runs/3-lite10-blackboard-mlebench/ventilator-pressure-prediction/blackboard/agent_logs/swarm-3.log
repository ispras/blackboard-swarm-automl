import numpy as np
import pandas as pd

FEATURES = [
    'u_in', 'u_out', 'time_step', 'R', 'C',
    'u_in_cumsum', 'u_in_cummean', 'u_in_cummax', 'u_in_lag1',
    'u_in_lag2', 'u_in_lag3', 'u_in_lag4', 'u_in_diff1', 'u_in_diff2',
    'time_diff', 'area', 'RC', 'R_over_C', 'C_over_R',
    'u_in_cumsum_over_C', 'u_in_cummean_over_C', 'u_in_over_C',
    'u_in_cumsum_plus_C', 'u_in_cumsum_plus_R', 'u_in_cumsum_over_R_C',
    'step', 'u_in_duration', 'u_out_lead',
]
CAT_R = [5, 20, 50]
CAT_C = [10, 20, 50]


def make_features(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    g = df.groupby('breath_id', sort=False)
    df['step'] = g.cumcount().astype(np.float32)
    df['u_in_cumsum'] = g['u_in'].cumsum().astype(np.float32)
    df['u_in_cummean'] = (df['u_in_cumsum'] / (df['step'] + 1)).astype(np.float32)
    df['u_in_cummax'] = g['u_in'].cummax().astype(np.float32)
    for k in (1, 2, 3, 4):
        df[f'u_in_lag{k}'] = g['u_in'].shift(k).fillna(0).astype(np.float32)
    df['u_in_diff1'] = (df['u_in'] - df['u_in_lag1']).astype(np.float32)
    df['u_in_diff2'] = (df['u_in'] - df['u_in_lag2']).astype(np.float32)
    df['time_diff'] = g['time_step'].diff().fillna(0).astype(np.float32)
    df['area'] = (df['time_step'] * df['u_in_cumsum']).astype(np.float32)
    df['RC'] = (df['R'] * df['C']).astype(np.float32)
    df['R_over_C'] = (df['R'] / df['C']).astype(np.float32)
    df['C_over_R'] = (df['C'] / df['R']).astype(np.float32)
    df['u_in_cumsum_over_C'] = (df['u_in_cumsum'] / df['C']).astype(np.float32)
    df['u_in_cummean_over_C'] = (df['u_in_cummean'] / df['C']).astype(np.float32)
    df['u_in_over_C'] = (df['u_in'] / df['C']).astype(np.float32)
    df['u_in_cumsum_plus_C'] = (df['u_in_cumsum'] + df['C']).astype(np.float32)
    df['u_in_cumsum_plus_R'] = (df['u_in_cumsum'] + df['R']).astype(np.float32)
    df['u_in_cumsum_over_R_C'] = (df['u_in_cumsum'] / (df['R'] * df['C'])).astype(np.float32)
    df['u_in_duration'] = (df['step'] * df['time_diff']).astype(np.float32)
    df['u_out_lead'] = g['u_out'].shift(-1).fillna(0).astype(np.float32)
    for r in CAT_R:
        df[f'R_{r}'] = (df['R'] == r).astype(np.float32)
    for c in CAT_C:
        df[f'C_{c}'] = (df['C'] == c).astype(np.float32)
    return df


def feature_cols():
    return FEATURES + [f'R_{r}' for r in CAT_R] + [f'C_{c}' for c in CAT_C]


def load_df(path):
    df = pd.read_csv(path)
    df = make_features(df)
    return df
