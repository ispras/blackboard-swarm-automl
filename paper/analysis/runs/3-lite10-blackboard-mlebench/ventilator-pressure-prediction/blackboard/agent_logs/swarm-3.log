---merge script---
import os, glob
import numpy as np
import pandas as pd

BASE = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
tr = pd.read_csv(os.path.join(BASE, 'data/train.csv'), usecols=['id', 'u_out', 'pressure', 'breath_id'])
te = pd.read_csv(os.path.join(BASE, 'data/test.csv'), usecols=['id'])
n = len(tr)
y = tr.pressure.to_numpy(np.float64)
mask = (tr.u_out.to_numpy() == 0)
breaths = tr.breath_id.to_numpy()[::80]
row_fold = breaths % 5
br = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'bellatrix_omicron'))

candidates = {
    0: [f'{br}/oof_physfull_f0.npy', f'{br}/valid_pred_physfull_f0.npy'],
    1: ['runs/canox2_s42_f1_oof.npy', 'runs/canox2_s43_f1_oof.npy'],
    2: ['runs/canox2_s42_f2_oof.npy'],
    3: [f'{br}/valid_pred_physfull_f3.npy', f'{br}/oof_physfull_f3.npy'],
    4: [f'{br}/valid_pred_physfull_f4.npy', f'{br}/oof_physfull_f4.npy'],
}
test_map = {
    0: [f'{br}/test_physfull_f0.npy'],
    1: ['runs/canox2_s42_f1_test.npy', 'runs/canox2_s43_f1_test.npy'],
    2: ['runs/canox2_s42_f2_test.npy'],
    3: [f'{br}/test_physfull_f3.npy'],
    4: [f'{br}/test_physfull_f4.npy'],
}

full = np.full(n, np.nan, dtype=np.float64)
for f in range(5):
    bidx = np.where(row_fold == f)[0]
    rows = np.concatenate([np.arange(i * 80, (i + 1) * 80) for i in bidx])
    arrs = []
    for p in candidates.get(f, []):
        if not os.path.exists(p):
            print(f'  fold {f}: missing {p}'); continue
        a = np.load(p).reshape(-1)
        if a.size == n:
            b = a.reshape(-1, 80)[bidx]
            if np.isnan(b).all():
                continue
        elif a.size == len(bidx) * 80:
            b = a.reshape(-1, 80)
        else:
            print(f'  fold {f}: {p} unexpected size {a.size}'); continue
        arrs.append(b); print(f'  fold {f}: using {os.path.basename(p)}')
    if not arrs:
        print(f'fold {f}: MISSING'); continue
    avg = np.mean(arrs, axis=0)
    full[rows] = avg.reshape(-1)
    m = mask[rows]
    print(f'fold {f}: avg of {len(arrs)} -> MAE {np.abs(avg.reshape(-1)[m]-y[rows][m]).mean():.5f}')

mf = np.isfinite(full) & mask
print('coverage', np.isfinite(full).sum(), '/', n)
print('merged 50-feat OOF MAE', np.abs(full[mf] - y[mf]).mean())
np.save('runs/combined50_oof.npy', full.astype(np.float32))

fold_tests = []
for f in range(5):
    arrs = []
    for p in test_map.get(f, []):
        if os.path.exists(p):
            arrs.append(np.load(p).reshape(-1))
    if arrs:
        fold_tests.append(np.mean(arrs, axis=0))
        print('test fold', f, len(arrs), 'files')
tp = np.mean(fold_tests, axis=0)
np.save('runs/combined50_test.npy', tp.astype(np.float32))
print('test folds', len(fold_tests), 'saved runs/combined50_test.npy')
