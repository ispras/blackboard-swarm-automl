import argparse, json, os
import numpy as np
import pandas as pd
from scipy.optimize import minimize

BASE = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
p = argparse.ArgumentParser()
p.add_argument('--models', type=str, required=True,
               help='comma list name=oof_path:test_path')
p.add_argument('--submission', type=str, default='')
p.add_argument('--report', type=str, default='blend_report.json')
p.add_argument('--equal', action='store_true')
args = p.parse_args()

tr = pd.read_csv(os.path.join(BASE, 'data/train.csv'), usecols=['id', 'u_out', 'pressure', 'R', 'C', 'breath_id'])
te = pd.read_csv(os.path.join(BASE, 'data/test.csv'), usecols=['id'])
y = tr.pressure.to_numpy(np.float64)
mask = (tr.u_out.to_numpy() == 0)
names, oofs, tests = [], [], []
for spec in args.models.split(','):
    name, paths = spec.split('=')
    op, tpath = paths.split(':')
    o = np.load(op).reshape(-1).astype(np.float64)
    t = np.load(tpath).reshape(-1).astype(np.float64)
    assert len(o) == len(tr) or len(o) == int(mask.sum()), (name, len(o))
    names.append(name); oofs.append(o); tests.append(t)
    if len(o) == len(tr):
        print(f'{name}: OOF insp MAE {np.abs(o[mask]-y[mask]).mean():.5f}')
    else:
        print(f'{name}: OOF(partial) shape {len(o)}')

# Determine OOF matrix: full-row aligned required for MAE optimization
full = all(len(o) == len(tr) for o in oofs)
if full:
    A = np.stack([o[mask] for o in oofs], 1)
    b = y[mask]
    w_eq = np.ones(len(names)) / len(names)
    mae_eq = np.abs(A @ w_eq - b).mean()
    print('equal-weight MAE', mae_eq)
    if args.equal:
        w = w_eq
    else:
        def obj(w):
            return np.abs(A @ w - b).mean()
        x0 = w_eq
        cons = [{'type': 'eq', 'fun': lambda w: w.sum() - 1}]
        res = minimize(obj, x0, method='SLSQP', bounds=[(0, 1)] * len(names),
                       constraints=cons, options={'maxiter': 300, 'ftol': 1e-10})
        w = res.x
        print('optimized weights', dict(zip(names, np.round(w, 4))), 'MAE', res.fun)
    pred_insp = A @ w
    report = {'names': names, 'weights': list(map(float, w)), 'oof_mae': float(np.abs(pred_insp - b).mean())}
    print('FINAL OOF MAE', report['oof_mae'])
else:
    w = np.ones(len(names)) / len(names)
    report = {'names': names, 'weights': list(map(float, w))}

test_pred = sum(wi * t for wi, t in zip(w, tests))
if args.submission:
    pd.DataFrame({'id': te.id.to_numpy(), 'pressure': test_pred}).to_csv(args.submission, index=False)
    print('wrote', args.submission)
np.save(args.report.replace('.json', '_test.npy'), test_pred.astype(np.float32))
with open(args.report, 'w') as f:
    json.dump(report, f, indent=2)
