import argparse, os, time, json
import numpy as np
import torch
import torch.nn as nn
from features import load_df, feature_cols

p = argparse.ArgumentParser()
p.add_argument('--folds', type=str, default='0')
p.add_argument('--seed', type=int, default=42)
p.add_argument('--hidden', type=int, default=512)
p.add_argument('--layers', type=int, default=4)
p.add_argument('--head_layers', type=int, default=2)
p.add_argument('--epochs', type=int, default=60)
p.add_argument('--patience', type=int, default=15)
p.add_argument('--batch', type=int, default=256)
p.add_argument('--lr', type=float, default=2e-3)
p.add_argument('--wd', type=float, default=1e-4)
p.add_argument('--exp_weight', type=float, default=0.1)
p.add_argument('--dropout', type=float, default=0.1)
p.add_argument('--amp', type=int, default=1)
p.add_argument('--tag', type=str, default='lstm')
p.add_argument('--outdir', type=str, default='runs')
args = p.parse_args()
BASE = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
torch.manual_seed(args.seed); np.random.seed(args.seed)
torch.backends.cudnn.benchmark = True
os.makedirs(args.outdir, exist_ok=True)
device = 'cuda'

t0 = time.time()
tr = load_df(os.path.join(BASE, 'data/train.csv'))
te = load_df(os.path.join(BASE, 'data/test.csv'))
fc = feature_cols()
print(f'features={len(fc)} load={time.time()-t0:.1f}s', flush=True)


def to3(df):
    return df[fc].to_numpy(np.float32).reshape(-1, 80, len(fc))


Xtr = to3(tr); Xte = to3(te)
ytr = tr['pressure'].to_numpy(np.float32).reshape(-1, 80)
uout = tr['u_out'].to_numpy(np.float32).reshape(-1, 80)
breaths = tr['breath_id'].to_numpy()[::80]
mu = Xtr.reshape(-1, len(fc)).mean(0)
sd = Xtr.reshape(-1, len(fc)).std(0); sd[sd < 1e-6] = 1.0
Xtr = (Xtr - mu) / sd; Xte = (Xte - mu) / sd
ymu = float(ytr[uout == 0].mean()); ysd = float(ytr[uout == 0].std())
row_fold = (breaths % 5).astype(np.int64)
print(f'target {ymu:.3f}/{ysd:.3f}', flush=True)
Xte_t = torch.from_numpy(Xte).to(device)
yt = torch.from_numpy((ytr - ymu) / ysd).to(device)
wt = torch.where(torch.from_numpy(uout).to(device) == 0, 1.0, args.exp_weight)


class Net(nn.Module):
    def __init__(self, nf):
        super().__init__()
        self.lstm1 = nn.LSTM(nf, args.hidden, num_layers=args.layers, batch_first=True,
                             bidirectional=True, dropout=args.dropout if args.layers > 1 else 0.0)
        self.lstm2 = nn.LSTM(args.hidden * 2, args.hidden // 2, num_layers=args.head_layers,
                             batch_first=True, bidirectional=True,
                             dropout=args.dropout if args.head_layers > 1 else 0.0)
        self.head = nn.Sequential(nn.Linear(args.hidden, 256), nn.SiLU(),
                                  nn.Dropout(args.dropout), nn.Linear(256, 1))

    def forward(self, x):
        h, _ = self.lstm1(x)
        h, _ = self.lstm2(h)
        return self.head(h).squeeze(-1)


def predict(model, X, bs=512):
    out = []
    with torch.no_grad():
        for i in range(0, len(X), bs):
            out.append(model(X[i:i + bs]).float().cpu().numpy())
    return np.concatenate(out)


def run_fold(fold):
    tr_idx = np.where(row_fold != fold)[0]
    va_idx = np.where(row_fold == fold)[0]
    Xf = torch.from_numpy(Xtr[tr_idx]).to(device)
    yf = yt[tr_idx]; wf = wt[tr_idx]
    Xv = torch.from_numpy(Xtr[va_idx]).to(device)
    yv = ytr[va_idx]; uv = uout[va_idx]
    n = len(tr_idx); bs = args.batch
    steps = (n + bs - 1) // bs
    model = Net(len(fc)).to(device)
    opt = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.wd)
    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=args.lr, total_steps=args.epochs * steps,
                                                pct_start=0.12, div_factor=10, final_div_factor=100)
    scaler = torch.cuda.amp.GradScaler(enabled=bool(args.amp))
    best = 1e9; best_state = None; bad = 0; log = []
    for ep in range(args.epochs):
        model.train(); perm = torch.randperm(n, device=device); tot = 0.0
        for i in range(steps):
            sel = perm[i * bs:(i + 1) * bs]
            opt.zero_grad(set_to_none=True)
            with torch.cuda.amp.autocast(dtype=torch.float16, enabled=bool(args.amp)):
                out = model(Xf[sel])
                loss = ((out - yf[sel]).abs() * wf[sel]).sum() / (wf[sel].sum() + 1e-8)
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            nn.utils.clip_grad_norm_(model.parameters(), 5.0)
            scaler.step(opt); scaler.update(); sched.step()
            tot += loss.item()
        pred = predict(model, Xv) * ysd + ymu
        mae = float(np.abs(pred[uv == 0] - yv[uv == 0]).mean())
        log.append(mae)
        if mae < best - 1e-5:
            best = mae; bad = 0
            best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}
        else:
            bad += 1
        print(f'fold{fold} ep{ep} loss={tot/steps:.4f} valMAE={mae:.5f} best={best:.5f} bad={bad} lr={sched.get_last_lr()[0]:.2e} {time.time()-t0:.0f}s', flush=True)
        if bad >= args.patience:
            break
    model.load_state_dict(best_state); model.eval()
    val_pred = predict(model, Xv) * ysd + ymu
    test_pred = predict(model, Xte_t) * ysd + ymu
    mae = float(np.abs(val_pred[uv == 0] - yv[uv == 0]).mean())
    prefix = f'{args.outdir}/{args.tag}_s{args.seed}_f{fold}'
    np.save(prefix + '_oof.npy', val_pred.astype(np.float32))
    np.save(prefix + '_test.npy', test_pred.astype(np.float32))
    np.save(prefix + '_validx.npy', va_idx)
    with open(prefix + '_log.json', 'w') as f:
        json.dump({'fold': fold, 'seed': args.seed, 'best_mae': mae, 'log': log, 'args': vars(args)}, f)
    print(f'FOLD {fold} DONE best_mae={mae:.5f} elapsed={time.time()-t0:.0f}s', flush=True)
    return mae


res = {}
for f in [int(x) for x in args.folds.split(',')]:
    res[f] = run_fold(f)
print('RESULT', res, 'mean', float(np.mean(list(res.values()))), flush=True)
