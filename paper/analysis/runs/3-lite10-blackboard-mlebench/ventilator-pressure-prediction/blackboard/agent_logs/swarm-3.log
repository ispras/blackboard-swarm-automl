import numpy as np, pandas as pd, os, json
from scipy.optimize import minimize
BASE="/download_job_code/payload/sandbox"; ME=os.path.join(BASE,"workspaces/bellatrix_omicron")
tr=pd.read_csv(os.path.join(BASE,"data/train.csv"),usecols=["breath_id","u_out","pressure","R","C"])
y=tr.pressure.values.astype(np.float64); insp=(tr.u_out.values==0); n=len(y); T=80
bid=np.repeat(np.load(os.path.join(ME,"breath_train.npy")),T); fold=(bid%5)
def build50():
  oof=np.full(n,np.nan); tests=[]
  for f in [0,3,4]:
    o=np.load(os.path.join(ME,f"oof_physfull_f{f}.npy")); oof[~np.isnan(o)]=o[~np.isnan(o)]
    tests.append(np.load(os.path.join(ME,f"test_physfull_f{f}.npy")).reshape(-1))
  for f in [1,2]:
    p=os.path.join(BASE,f"workspaces/canopus_omega/runs/canox2_s42_f{f}")
    o=np.load(p+"_oof.npy").reshape(-1); idx=np.load(p+"_validx.npy")
    rows=(idx[:,None]*T+np.arange(T)[None,:]).reshape(-1); oof[rows]=o
    tests.append(np.load(p+"_test.npy").reshape(-1))
  return oof,np.mean(tests,0)
def build34():
  return np.load(os.path.join(BASE,"workspaces/canopus_omega/runs/combined34_oof.npy")).reshape(-1), np.load(os.path.join(BASE,"workspaces/canopus_omega/runs/combined34_test.npy")).reshape(-1)
def buildald():
  oof=np.full(n,np.nan); tests=[]
  specs={0:("fold0_oof_f0_t3_120.npy","fold0_idx_f0_t3_120.npy","fold0_test_f0_t3_120.npy"),
         1:("fold1_oof_t3_150.npy","fold1_idx_t3_150.npy","fold1_test_t3_150.npy"),
         2:("fold2_oof_t3_150.npy","fold2_idx_t3_150.npy","fold2_test_t3_150.npy"),
         3:("fold3_oof_t3_150.npy","fold3_idx_t3_150.npy","fold3_test_t3_150.npy"),
         4:("fold4_oof_t3_150.npy","fold4_idx_t3_150.npy","fold4_test_t3_150.npy")}
  for f in range(5):
    a,b,c=[os.path.join(BASE,"workspaces/aldebaran_eta/preds",x) for x in specs[f]]
    if not os.path.exists(a): continue
    o=np.load(a).reshape(-1); idx=np.load(b); rows=(idx[:,None]*T+np.arange(T)[None,:]).reshape(-1); oof[rows]=o; tests.append(np.load(c).reshape(-1))
  return oof,np.mean(tests,0)
b50,t50=build50(); c34,t34=build34(); ald,tald=buildald()
M=[b50,c34,ald]; names=["b50","c34","ald"]
mask0=insp&(fold==0); mask3=insp&(fold==3)
for m in M: mask0&=~np.isnan(m); mask3&=~np.isnan(m)
A0=np.stack([m[mask0] for m in M],1); A3=np.stack([m[mask3] for m in M],1); y0=y[mask0]; y3=y[mask3]
def fit(A,b):
  k=A.shape[1]; f=lambda w: np.abs(A@w-b).mean()
  r=minimize(f,np.ones(k)/k,method="SLSQP",bounds=[(0,1)]*k,constraints=[{"type":"eq","fun":lambda w:w.sum()-1}],options={"maxiter":400,"ftol":1e-12}); return r.x
# global
w=fit(A0,y0); print("global hold f3",np.abs(A3@w-y3).mean())
# per-step weights
ws=[]; preds=[]
step=np.repeat(np.arange(T),1)  # not per row
steprow=np.tile(np.arange(T), n//T)
for t in range(T):
  s0=mask0&(steprow==t); s3=mask3&(steprow==t)
  if s0.sum()<200: continue
  At=np.stack([m[s0] for m in M],1); Av=np.stack([m[s3] for m in M],1)
  wt=fit(At,y[s0]); ws.append(wt); preds.append(np.abs(Av@wt-y[s3]).mean())
print("per-step hold f3 (mean over steps weighted):", np.mean(preds))
# evaluate per-step precisely
pred3=np.zeros(mask3.sum()); idx3=np.where(mask3)[0]; sr3=steprow[mask3]
for t in range(T):
  s=sr3==t
  if not s.any(): continue
  s0=mask0&(steprow==t)
  At=np.stack([m[s0] for m in M],1); wt=fit(At,y[s0])
  pred3[s]=np.stack([m[idx3[s]] for m in M],1)@wt
print("per-step hold f3 exact", np.abs(pred3-y3).mean(), "global", np.abs(A3@w-y3).mean(), "eq", np.abs(A3.mean(1)-y3).mean())
# median and trimmed mean
print("median hold", np.abs(np.median(A3,1)-y3).mean())
print("mean hold", np.abs(A3.mean(1)-y3).mean())
EOF'
