import numpy as np, pandas as pd
tr=pd.read_csv('../../data/train.csv',usecols=['breath_id','R','C','u_out','pressure','id'])
pred=np.load('runs/lstm512_s42_f0_oof.npy'); idx=np.load('runs/lstm512_s42_f0_validx.npy')
b=tr.breath_id.to_numpy()[::80]
sel=np.isin(b, np.arange(len(b))[idx])  # not exactly; compute mapping
# instead build map from breath_id to row index
# fold0 validx are breath indices in order of unique breaths (as read)
# breaths array is tr.breath_id[::80]
fold=0
validx=idx
sub=tr.iloc[np.concatenate([np.arange(i*80,(i+1)*80) for i in validx])]
p=pred.reshape(-1)
print('len', len(sub), len(p))
m=sub.u_out.to_numpy()==0
y=sub.pressure.to_numpy()
print('insp MAE', np.abs(p[m]-y[m]).mean())
print('all MAE', np.abs(p-y).mean())
print('exp MAE', np.abs(p[~m]-y[~m]).mean())
sub=sub.assign(pred=p)
sub['err']=np.abs(sub.pred-sub.pressure)
# by group
print(sub[m].groupby(['R','C']).apply(lambda d: np.abs(d.pred-d.pressure).mean()))
# by u_out phase? by step within breath
sub['step']=sub.groupby('breath_id').cumcount()
print(sub[m].groupby(pd.cut(sub[m].step,[-1,10,20,30,40,50,60,70,79])).apply(lambda d: np.abs(d.pred-d.pressure).mean()))
# linear calibration on inspiratory
from sklearn.linear_model import LinearRegression
X=p[m].reshape(-1,1); yy=y[m]
lr=LinearRegression().fit(X,yy)
pc=lr.predict(p.reshape(-1,1))
print('calib coef',lr.coef_,lr.intercept_,'calib MAE',np.abs(pc[m]-yy).mean())
# per R,C linear calibration
pc2=p.copy()
for rc,d in sub[m].groupby(['R','C']):
    pass
