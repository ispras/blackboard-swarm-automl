import numpy as np, pandas as pd
tr=pd.read_csv('../../data/train.csv',usecols=['breath_id','R','C','u_out','pressure'])
pred=np.load('runs/lstm512_s42_f0_oof.npy'); idx=np.load('runs/lstm512_s42_f0_validx.npy')
rows=np.concatenate([np.arange(i*80,(i+1)*80) for i in idx])
d=tr.iloc[rows].copy(); d['pred']=pred.reshape(-1)
d=d[d.u_out==0]
rng=np.random.RandomState(0); b=d.breath_id.unique(); half=set(rng.choice(b,len(b)//2,replace=False))
d['h']=d.breath_id.isin(half)
base=np.abs(d.pred-d.pressure).mean(); print('base',base)
# fit per RC affine on h=1, eval h=0 and reverse
pred2=d.pred.to_numpy().copy()
for fit_h,ev_h in [(True,False),(False,True)]:
    fit=d[d.h==fit_h]; ev=d[d.h==ev_h]
    p=ev.pred.to_numpy(); y=ev.pressure.to_numpy(); pr=p.copy()
    for rc,g in fit.groupby(['R','C']):
        m=((ev.R==rc[0])&(ev.C==rc[1])).to_numpy()
        A=np.vstack([g.pred,g.pred*0+1]).T
        coef,_,_,_=np.linalg.lstsq(A,g.pressure,rcond=None)
        pr[m]=coef[0]*p[m]+coef[1]
    print('fit_h',fit_h,'affine MAE',np.abs(pr-y).mean())
# global isotonic
from sklearn.isotonic import IsotonicRegression
for fit_h,ev_h in [(True,False),(False,True)]:
    fit=d[d.h==fit_h]; ev=d[d.h==ev_h]
    iso=IsotonicRegression(out_of_bounds='clip').fit(fit.pred,fit.pressure)
    print('iso',fit_h,np.abs(iso.predict(ev.pred)-ev.pressure).mean())
EOF
