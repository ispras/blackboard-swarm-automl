    if flip==0: im=cv2.flip(im,0)
    elif flip==1: im=cv2.flip(im,1)
    im=cv2.cvtColor(im,cv2.COLOR_BGR2RGB); im=cv2.resize(im,(size,size),interpolation=cv2.INTER_AREA)
    im=(im.astype(np.float32)/255-MEAN)/STD; return np.transpose(im,(2,0,1))
def main():
    torch.set_num_threads(4)
    model=Model(369,enc_name=a.get('enc','convnext_tiny.fb_in22k_ft_in1k'),out_index=a.get('out_index',2),
        d_model=a.get('d_model',512),nhead=a.get('nhead',8),layers=a.get('layers',6),dim_ff=a.get('dim_ff',2048),
        dropout=0.0,max_len=320,pretrained=False); model.load_state_dict(ck['model']); model.to(DEV).eval()
    tok=Tokenizer.from_file(f'{W}/bpe1024.json'); BOS,EOS=tok.token_to_id('[BOS]'),tok.token_to_id('[EOS]')
    rig=pd.read_csv(f'{W}/rigel_val20k.csv').rename(columns={'InChI':'raw'})
    tta=pd.read_csv('/tmp/tta_rigel_invalid.csv')[['image_id','r180']]
    g=pd.read_csv(f'{W}/holdout_20k.csv')
    ms=pd.concat([pd.read_csv(f) for f in sorted(glob.glob('/tmp/opencode/h20k/s*.csv'))]).drop_duplicates('image_id')
    with ProcessPoolExecutor(32) as ex:
        ms['i1']=list(ex.map(smi_to_inchi_fallback, ms['smiles'].astype(str).tolist(),chunksize=200))
    m=g.merge(rig,on='image_id').merge(tta,on='image_id',how='left').merge(ms[['image_id','i1','score']],on='image_id',how='left')
    m['i1']=m['i1'].fillna('').astype(str); m['score']=m['score'].fillna(0.0); m['r180']=m['r180'].fillna('').astype(str)
    vraw=np.array([valid(x) for x in m['raw'].astype(str)]); v180=np.array([valid(x) for x in m['r180']])
    resid=np.where((~vraw)&(~v180))[0]
    print('residual rows',len(resid),flush=True)
    size=384; ids=m['image_id'].values
    fl={}
    for flip,name in [(0,'ud'),(1,'lr')]:
        res=[]
        with torch.no_grad():
            for k in range(0,len(resid),384):
                idx=resid[k:k+384]; ch=ids[idx]
                x=torch.from_numpy(np.stack([make(f'{R}/data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png',size,flip) for i in ch])).to(DEV)
                with torch.autocast('cuda',dtype=torch.bfloat16):
                    outs=model.generate_fast(x,BOS,EOS,max_len=320)
                res += [tok.decode(o) for o in outs]
        fl[name]=res
    for name in ['ud','lr']:
        col=np.array(['']*len(m),dtype=object); col[resid]=fl[name]; m['f_'+name]=col
    G=m['InChI'].astype(str).tolist()
    def D(pred): return np.array([Levenshtein.distance(str(a),str(b)) for a,b in zip(pred,G)])
    with ProcessPoolExecutor(32) as ex:
        for c in ['raw','r180','f_ud','f_lr']:
            m['c_'+c]=list(ex.map(canon,m[c].astype(str).tolist(),chunksize=200))
    vu=np.array([valid(x) for x in m['f_ud']]); vl=np.array([valid(x) for x in m['f_lr']]); v1=np.array([valid(x) for x in m['i1']])
    raw=m['raw'].values.astype(str); rc=m['c_raw'].values.astype(str); r180c=m['c_r180'].values.astype(str)
    udc=m['c_f_ud'].values.astype(str); lrc=m['c_f_lr'].values.astype(str); i1=m['i1'].values.astype(str)
    out=rc.copy()
    out=np.where((~vraw)&v180, r180c, out)
    out=np.where((~vraw)&(~v180)&vu, udc, out)
    out=np.where((~vraw)&(~v180)&(~vu)&vl, lrc, out)
    use1=(~vraw)&(~v180)&(~vu)&(~vl)&v1&(m['score'].values>=0.78)
    out=np.where(use1, i1, out)
    print('RULE C :', round(D(np.where(vraw,rc,np.where((~vraw)&v180,r180c,np.where((~vraw)&(~v180)&v1&(m['score'].values>=0.78),i1,rc)))).mean(),4))
    print('RULE D :', round(D(out).mean(),4), ' flipud valid',int(vu.sum()),'fliplr valid',int(vl.sum()),'1m',int(use1.sum()))
if __name__=='__main__': main()
