import sys, glob
sys.path.append('/usr/local/lib/python3.11/site-packages')
sys.path.append('/download_job_code/payload/sandbox/workspaces/altair_epsilon')
import pandas as pd, numpy as np
from concurrent.futures import ProcessPoolExecutor
from rapidfuzz.distance import Levenshtein
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
from postproc import smi_to_inchi_fallback

def canon(s):
    if not isinstance(s,str): return s
    try:
        m=Chem.MolFromInchi(s, sanitize=False, removeHs=False)
        if m is None: return s
        return Chem.MolToInchi(m)
    except Exception:
        return s

def valid(s):
    if not isinstance(s,str) or not s.startswith('InChI=1S/'): return False
    try: return Chem.MolFromInchi(s) is not None
    except Exception: return False

W='/download_job_code/payload/sandbox/workspaces/rigel_mu'
rig=pd.read_csv(f'{W}/rigel_val20k.csv').rename(columns={'InChI':'rig'})
ms=pd.concat([pd.read_csv(f) for f in sorted(glob.glob('/tmp/opencode/h20k/s*.csv'))]).drop_duplicates('image_id')
print('ms rows',len(ms))
with ProcessPoolExecutor(32) as ex:
    ms['i1']=list(ex.map(smi_to_inchi_fallback, ms['smiles'].astype(str).tolist(), chunksize=200))
with ProcessPoolExecutor(32) as ex:
    rig['can']=list(ex.map(canon, rig['rig'].astype(str).tolist(), chunksize=200))
g=pd.read_csv(f'{W}/holdout_20k.csv')
m=g.merge(rig[['image_id','rig','can']],on='image_id').merge(ms[['image_id','i1','score']],on='image_id',how='left')
print('merged',len(m))
with ProcessPoolExecutor(32) as ex:
    m['v1']=list(ex.map(valid, m['i1'].astype(str).tolist(), chunksize=200))
G=m['InChI'].astype(str).tolist()
def D(pred): return np.array([Levenshtein.distance(str(a),str(b)) for a,b in zip(pred,G)])
print('1m-alone', round(D(m['i1']).mean(),3))
print('rigel raw', round(D(m['rig']).mean(),3))
print('rigel canon', round(D(m['can']).mean(),3), '(changed rows:',int((m['can']!=m['rig']).sum()),')')
for T in [0.80,0.85,0.875,0.88,0.90,0.95]:
    pred=m['can'].copy()
    use=m['v1'] & (m['score']>=T)
    pred[use]=m['i1'][use]
    d=D(pred)
    print(f'canon + (1m valid & score>={T}) n1m={int(use.sum())} -> {d.mean():.3f}')
# raw (no canon) blend at 0.85 for comparison
pred=m['rig'].copy(); use=m['v1']&(m['score']>=0.85); pred[use]=m['i1'][use]
print('raw + 1m>=0.85 ->', round(D(pred).mean(),3))
EOF
