import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein
v=pd.read_csv('/tmp/rigel_val_valid.csv'); g=pd.read_csv('holdout_20k.csv')
m=v.merge(g,on='image_id').rename(columns={'InChI_p':'pred','InChI':'truth'})
inv=m[~m.v].copy()
inv['d']=[Levenshtein.distance(str(a),str(b)) for a,b in zip(inv['pred'],inv['truth'])]
for k in [0,1,2,3,5,10,20,50]:
    print(f'd<={k}: frac of invalid { (inv.d<=k).mean():.3f}  count {int((inv.d<=k).sum())}')
print('invalid d mean',round(inv.d.mean(),2))
# check: how many invalid preds become valid after replacing the GT? trivially. Instead check one-char-edit search on a small sample (200 rows) to estimate uniqueness
import sys; sys.path.append('/usr/local/lib/python3.11/site-packages')
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return Chem.MolFromInchi(s) is not None
    except Exception: return False
sample=inv[inv.d<=4].head(120)
chars='0123456789HCONSBFIPclmnrstb()+-/'
import time
found=[]; t0=time.time()
for _,r in sample.iterrows():
    s=str(r['pred']); gts=str(r['truth'])
    best=None; nvalid=0
    # try replacing each position by each char (limited to digits + a few)
    L=len(s)
    for i in range(L):
        for c in chars:
            if c==s[i]: continue
            t=s[:i]+c+s[i+1:]
            if valid(t):
                nvalid+=1
                if best is None: best=t
                if nvalid>3: break
        if nvalid>3: break
    if best is not None:
        found.append((r['d'], Levenshtein.distance(best,gts), nvalid))
print('sample size',len(sample),'elapsed',round(time.time()-t0,1),'s')
if found:
    import numpy as np
    f=np.array([(a,b) for a,b,n in found])
    print('repaired found',len(found),'orig d mean',f[:,0].mean(),'repaired d mean',f[:,1].mean(),'exact-recovered',int((f[:,1]==0).sum()))
