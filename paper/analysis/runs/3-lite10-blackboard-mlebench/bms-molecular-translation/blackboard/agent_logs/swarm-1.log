import sys, glob, argparse
sys.path.append('/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from concurrent.futures import ProcessPoolExecutor
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
ROOT='/download_job_code/payload/sandbox'
def canon(s):
    try:
        m=Chem.MolFromInchi(s, sanitize=False, removeHs=False)
        if m is None: return s
        r=Chem.MolToInchi(m); return r if r else s
    except Exception: return s
def valid(s):
    try: return isinstance(s,str) and s.startswith('InChI=1S/') and s.count('/')>=2 and Chem.MolFromInchi(s) is not None
    except Exception: return False
def read_rot(pat):
    fs=sorted(glob.glob(pat))
    df=pd.concat([pd.read_csv(f) for f in fs],ignore_index=True).drop_duplicates('image_id')
    c=[x for x in ['InChI','pred','inchi','smiles'] if x in df.columns][0]
    return df[['image_id',c]].rename(columns={c:'v'})
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--rigel',default=f'{ROOT}/workspaces/rigel_mu/rigel_test_all.csv')
    ap.add_argument('--p1m',default=f'{ROOT}/workspaces/altair_epsilon/preds1m_inchi.csv')
    ap.add_argument('--r180',default=f'{ROOT}/workspaces/altair_epsilon/preds_rigel_rot/r180_s*.csv')
    ap.add_argument('--flipud',default=f'{ROOT}/workspaces/altair_epsilon/preds_tf/t_flipud_s*.csv')
    ap.add_argument('--fliplr',default=f'{ROOT}/workspaces/altair_epsilon/preds_tf/t_fliplr_s*.csv')
    ap.add_argument('--T',type=float,default=0.78)
    ap.add_argument('--out',required=True); ap.add_argument('--workers',type=int,default=40)
    a=ap.parse_args()
    s=pd.read_csv(f'{ROOT}/data/sample_submission.csv')[['image_id']]
    r=pd.read_csv(a.rigel); rc=[c for c in ['InChI','pred','inchi'] if c in r.columns][0]
    r=r[['image_id',rc]].rename(columns={rc:'raw'}).drop_duplicates('image_id')
    d=pd.read_csv(a.p1m)[['image_id','inchi','valid','score']].rename(columns={'inchi':'i1','valid':'v1','score':'s1'})
    m=s.merge(r,on='image_id',how='left').merge(d,on='image_id',how='left')
    for name,pat in [('r180',a.r180),('fud',a.flipud),('flr',a.fliplr)]:
        if glob.glob(pat):
            t=read_rot(pat).rename(columns={'v':name}); m=m.merge(t,on='image_id',how='left')
        else:
            print('MISSING',name,pat); m[name]=''
    for c in ['raw','i1','r180','fud','flr']: m[c]=m[c].fillna('').astype(str)
    m['s1']=m['s1'].fillna(0.0); m['v1']=m['v1'].fillna(False).astype(bool)
    vraw=np.array([valid(x) for x in m['raw']]); vr=np.array([valid(x) for x in m['r180']])
    vu=np.array([valid(x) for x in m['fud']]); vl=np.array([valid(x) for x in m['flr']])
    with ProcessPoolExecutor(a.workers) as ex:
        for c in ['raw','r180','fud','flr']:
            m['c_'+c]=list(ex.map(canon, m[c].tolist(), chunksize=4000))
    rc_=m['c_raw'].values.astype(str); r18=m['c_r180'].values.astype(str); ud=m['c_fud'].values.astype(str); lr=m['c_flr'].values.astype(str)
    i1=m['i1'].values.astype(str)
    out=rc_.copy()
    out=np.where((~vraw)&vr, r18, out)
    out=np.where((~vraw)&(~vr)&vu, ud, out)
    out=np.where((~vraw)&(~vr)&(~vu)&vl, lr, out)
    use1=(~vraw)&(~vr)&(~vu)&(~vl)&m['v1'].values&(m['s1'].values>=a.T)
    out=np.where(use1, i1, out)
    out=np.array([x if len(str(x))>=6 else 'InChI=1S/' for x in out])
    sub=pd.DataFrame({'image_id':m['image_id'].values,'InChI':out})
    assert len(sub)==len(s) and sub.image_id.is_unique
    sub.to_csv(a.out,index=False)
    print('wrote',a.out,sub.shape,'rawvalid',int(vraw.sum()),'r180',int((~vraw&vr).sum()),
          'flipud',int((~vraw&~vr&vu).sum()),'fliplr',int((~vraw&~vr&~vu&vl).sum()),'1m',int(use1.sum()),'T',a.T)
if __name__=='__main__': main()
