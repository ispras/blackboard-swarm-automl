import sys
sys.path.append('/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np, random
from rdkit import Chem, RDLogger
from rdkit.Chem.MolStandardize import rdMolStandardize
from rapidfuzz.distance import Levenshtein
RDLogger.DisableLog('rdApp.*')
df = pd.read_csv('/download_job_code/payload/sandbox/data/train_labels.csv')
random.seed(0)
sample = df.sample(20000, random_state=0)
same = 0; d_rt = []; invalid = 0; d_smiles = []
for s in sample.InChI:
    try:
        m = Chem.MolFromInchi(s)
    except Exception:
        m = None
    if m is None:
        invalid += 1; d_rt.append(len(s)); continue
    try:
        s2 = Chem.MolToInchi(m)
    except Exception:
        s2 = ''
    if s2 == s: same += 1
    d_rt.append(Levenshtein.distance(s, s2))
    try:
        smi = Chem.MolToSmiles(m)
        m2 = Chem.MolFromSmiles(smi)
        s3 = Chem.MolToInchi(m2) if m2 is not None else ''
    except Exception:
        s3 = ''
    d_smiles.append(Levenshtein.distance(s, s3))
d_rt = np.array(d_rt); d_smiles = np.array(d_smiles)
print('n', len(sample), 'parse-invalid', invalid)
print('InChI->mol->InChI exact frac', same/len(sample))
print('roundtrip mean Lev', d_rt.mean(), 'median', np.median(d_rt), 'p90', np.percentile(d_rt,90))
print('full smiles roundtrip mean Lev', d_smiles.mean(), 'exact frac', (d_smiles==0).mean())
# examples of nonzero
cnt=0
for s,d in zip(sample.InChI, d_rt):
    if d>0 and cnt<5:
        m=Chem.MolFromInchi(s); s2=Chem.MolToInchi(m) if m else ''
        print('GT ',s[:140]); print('RT ',s2[:140]); print('d',d); cnt+=1
EOF
