# error type: does stripping after last '/' make it valid?
def try_repair(s):
    if not isinstance(s,str): return s
    s=s.strip()
    variants=[s]
    # remove trailing junk chars after last plausible layer
    variants.append(re.sub(r'[^A-Za-z0-9()\-+,/;H]+$','',s))
    # cut at last '/' if the last layer doesn't start with a known letter
    parts=s.split('/')
    if len(parts)>2 and (not parts[-1][:1].isalpha()):
        variants.append('/'.join(parts[:-1]))
    for t in variants:
        try:
            if Chem.MolFromInchi(t) is not None: return t
        except Exception: pass
    return s
cnt=0; gains=[]
for _,r in inv.iterrows():
    rp=try_repair(r.pred)
    if rp!=r.pred:
        d0=Levenshtein.distance(str(r.pred),str(r.gt)); d1=Levenshtein.distance(str(rp),str(r.gt))
        gains.append(d0-d1); cnt+=1
print('repairs changed string:',cnt,'sum lev gain',sum(gains),'mean gain',np.mean(gains) if gains else 0)
for _,r in inv.head(6).iterrows():
    print('P',str(r.pred)[:150]); print('G',str(r.gt)[:150]); print('d',Levenshtein.distance(str(r.pred),str(r.gt))); print()
