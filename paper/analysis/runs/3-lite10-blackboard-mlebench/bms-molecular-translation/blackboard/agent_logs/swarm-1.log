import sys; sys.path.append('/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from rapidfuzz.distance import Levenshtein
from concurrent.futures import ProcessPoolExecutor
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
def ok(s):
    try: return Chem.MolFromInchi(s) is not None
    except Exception: return False
P=pd.read_csv('/tmp/opencode/paired2000.csv')
r=pd.read_csv('rigel_val20k.csv').rename(columns={'InChI':'rg'})
m=P.merge(r,on='image_id',how='inner')
print('joined',len(m))
with ProcessPoolExecutor(24) as ex:
    m['vr']=list(ex.map(ok,m.rg.astype(str).tolist(),chunksize=200))
m['dr']=[Levenshtein.distance(str(a),str(b)) for a,b in zip(m.rg,m.gt)]
m['d1']=[Levenshtein.distance(str(a),str(b)) for a,b in zip(m.p1,m.gt)]
m['d2']=[Levenshtein.distance(str(a),str(b)) for a,b in zip(m.p2,m.gt)]
m['dgate']=[Levenshtein.distance(str(a),str(b)) for a,b in zip(m.gate,m.gt)]
def lev(pred):
    return np.mean([Levenshtein.distance(str(a),str(b)) for a,b in zip(pred,m.gt)])
rules={}
rules['rigel alone']=m.dr.mean()
rules['gate(1m->680k)']=m.dgate.mean()
rules['1m alone']=m.d1.mean()
# rule: rigel if valid else 1m
pred=m.rg.where(m.vr, m.p1); rules['rigel if valid else 1m']=lev(pred)
# rigel if valid else 680k if valid else 1m
pred2=m.rg.where(m.vr, m.p2.where(m.v2, m.p1)); rules['rigel if valid else 680k if valid else 1m']=lev(pred2)
# rigel if valid else (best of 1m/680k by score among valid)
sel2=m.p1.copy()
use2=(m.v2 & (~m.v1 | (m.s2>m.s1)))
sel2[use2]=m.p2[use2]
pred3=m.rg.where(m.vr, sel2); rules['rigel if valid else bestscore(1m,680k)']=lev(pred3)
# rigel if valid; else rigel raw but if invalid and 1m valid and 1m formula agrees? skip
for k,v in rules.items(): print(f'{k:55s} {v:.3f}')
inv=~m.vr
print('\nrigel-invalid rows n',int(inv.sum()),'frac',round(inv.mean(),3))
print(' on those: rigel',round(m.dr[inv].mean(),2),'1m',round(m.d1[inv].mean(),2),'680k',round(m.d2[inv].mean(),2),'gate',round(m.dgate[inv].mean(),2))
print(' 1m valid on rigel-invalid:',round(m.v1[inv].mean(),3),'680k valid:',round(m.v2[inv].mean(),3))
# when rigel invalid and 1m valid:
sub=inv&m.v1
print(' rigel-invalid & 1m-valid n',int(sub.sum()),'rigel',round(m.dr[sub].mean(),2),'1m',round(m.d1[sub].mean(),2))
sub2=inv&(~m.v1)&m.v2
print(' rigel-invalid & 1m-invalid & 680k-valid n',int(sub2.sum()),'rigel',round(m.dr[sub2].mean(),2),'680k',round(m.d2[sub2].mean(),2))
