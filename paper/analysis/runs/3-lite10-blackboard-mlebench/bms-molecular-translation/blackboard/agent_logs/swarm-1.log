import sys, glob, argparse
sys.path.append('/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np, os
from concurrent.futures import ProcessPoolExecutor
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
ROOT='/download_job_code/payload/sandbox'
def canon(s):
    try:
        m=Chem.MolFromInchi(s, sanitize=False, removeHs=False)
        if m is None: return s
        r=Chem.MolToInchi(m); return r if r else s
    except Exception: return s
def valid(s):
    try: return isinstance(s,str) and s.startswith('InChI=1S/') and s.count('/')>=2 and Chem.MolFromInchi(s) is not None
    except Exception: return False
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--rigel',default=f'{ROOT}/workspaces/rigel_mu/rigel_test_all.csv')
    ap.add_argument('--p1m',default=f'{ROOT}/workspaces/altair_epsilon/preds1m_inchi.csv')
    ap.add_argument('--rot',default=f'{ROOT}/workspaces/altair_epsilon/preds_rigel_rot/r180_s*.csv')
    ap.add_argument('--T',type=float,default=0.78)
    ap.add_argument('--out',required=True); ap.add_argument('--workers',type=int,default=40)
    a=ap.parse_args()
    s=pd.read_csv(f'{ROOT}/data/sample_submission.csv')[['image_id']]
    r=pd.read_csv(a.rigel); rc=[c for c in ['InChI','pred','inchi'] if c in r.columns][0]
    r=r[['image_id',rc]].rename(columns={rc:'raw'}).drop_duplicates('image_id')
    d=pd.read_csv(a.p1m)[['image_id','inchi','valid','score']].rename(columns={'inchi':'i1','valid':'v1','score':'s1'})
    rot=pd.concat([pd.read_csv(f) for f in sorted(glob.glob(a.rot))],ignore_index=True).drop_duplicates('image_id')
    rc2=[c for c in ['InChI','pred','inchi','smiles'] if c in rot.columns][0]
    rot=rot[['image_id',rc2]].rename(columns={rc2:'r180'})
    m=s.merge(r,on='image_id',how='left').merge(d,on='image_id',how='left').merge(rot,on='image_id',how='left')
    for c in ['raw','i1','r180']: m[c]=m[c].fillna('').astype(str)
    m['s1']=m['s1'].fillna(0.0); m['v1']=m['v1'].fillna(False).astype(bool)
    vraw=np.array([valid(x) for x in m['raw']]); v180=np.array([valid(x) for x in m['r180']])
    with ProcessPoolExecutor(a.workers) as ex:
        m['rc']=list(ex.map(canon, m['raw'].tolist(), chunksize=4000))
        m['r180c']=list(ex.map(canon, m['r180'].tolist(), chunksize=4000))
    rawc=m['rc'].values.astype(str); r180c=m['r180c'].values.astype(str); i1=m['i1'].values.astype(str)
    c1=vraw; c2=(~vraw)&v180; c3=(~vraw)&(~v180)&(m['v1'].values)&(m['s1'].values>=a.T)
    out=rawc.copy(); out=np.where(c1,rawc,out); out=np.where(c2,r180c,out); out=np.where(c3,i1,out)
    out=np.array([x if len(str(x))>=6 else 'InChI=1S/' for x in out])
    sub=pd.DataFrame({'image_id':m['image_id'].values,'InChI':out})
    assert len(sub)==len(s) and sub.image_id.is_unique
    sub.to_csv(a.out,index=False)
    print('wrote',a.out,sub.shape,'rawvalid',int(c1.sum()),'r180',int(c2.sum()),'1m',int(c3.sum()),'T',a.T)
if __name__=='__main__': main()
EOF
