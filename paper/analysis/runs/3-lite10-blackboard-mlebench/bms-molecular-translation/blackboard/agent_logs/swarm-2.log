import sys, os, time, argparse
sys.path.insert(0, '/download_job_code/payload/sandbox/workspaces/altair_epsilon/pylibs')
sys.path.insert(0, '/usr/local/lib/python3.11/site-packages')
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'MolScribe'))
import torch, pandas as pd, numpy as np, cv2
from molscribe import MolScribe
from postproc import smi_to_inchi_fallback, lev
ap=argparse.ArgumentParser(); ap.add_argument('--n',type=int,default=256); ap.add_argument('--bs',type=int,default=64)
ap.add_argument('--ckpt',default='weights/swin_base_char_aux_1m.pth'); ap.add_argument('--out',default='/tmp/tta.csv')
args=ap.parse_args()
def path(i): return f"../../data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png"
model=MolScribe(args.ckpt, device=torch.device('cuda'), num_workers=1); model.decoder.compute_confidence=True
df=pd.read_csv('../../analysis/holdout_20k.csv').iloc[:args.n].reset_index(drop=True)
res={}
for rot in [0,1,2,3]:
    imgs=[]
    for i in df.image_id:
        im=cv2.cvtColor(cv2.imread(path(i)),cv2.COLOR_BGR2RGB)
        if rot: im=np.ascontiguousarray(np.rot90(im,rot))
        imgs.append(im)
    rows=[]; t0=time.time()
    for k in range(0,len(imgs),args.bs):
        ims=[model.transform(image=im,keypoints=[])['image'] for im in imgs[k:k+args.bs]]
        x=torch.stack(ims).cuda()
        with torch.no_grad(), torch.autocast('cuda', dtype=torch.bfloat16):
            f,h=model.encoder(x); preds=model.decoder.decode(f,h)
        rows += [(p['chartok_coords']['smiles'], float(p.get('overall_score',0.0))) for p in preds]
    res[rot]=rows
    print('rot',rot*90,'done',round(time.time()-t0,1),'s',flush=True)
out=df[['image_id','InChI']].copy()
for rot in [0,1,2,3]:
    inj=[smi_to_inchi_fallback(s) for s,_ in res[rot]]
    out[f'smi{rot}']=[s for s,_ in res[rot]]; out[f'score{rot}']=[sc for _,sc in res[rot]]; out[f'inchi{rot}']=inj
    out[f'lev{rot}']=[lev(a,b) for a,b in zip(inj,out['InChI'])]
