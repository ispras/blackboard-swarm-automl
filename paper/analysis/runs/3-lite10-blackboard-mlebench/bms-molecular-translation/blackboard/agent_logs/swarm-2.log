import pandas as pd, numpy as np, sys
sys.path.append('/usr/local/lib/python3.11/site-packages')
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
from rdkit.Chem.MolStandardize import rdMolStandardize
from rapidfuzz.distance import Levenshtein as L
df=pd.read_csv('workspaces/altair_epsilon/val_eval_256.csv')

def conv(smi, mode, drop_dummy=False, largest=False):
    if not isinstance(smi,str) or smi in ('','<invalid>'): return ''
    try:
        m=Chem.MolFromSmiles(smi, sanitize=False)
        if m is None: return ''
        try: Chem.SanitizeMol(m)
        except: pass
        if drop_dummy:
            em=Chem.RWMol(m)
            idxs=[a.GetIdx() for a in m.GetAtoms() if a.GetAtomicNum()==0]
            for i in sorted(idxs, reverse=True): em.RemoveAtom(i)
            m=em.GetMol()
            try: Chem.SanitizeMol(m)
            except: pass
        if largest:
            try: m=rdMolStandardize.FragmentParent(m)
            except: pass
        return Chem.MolToInchi(m)
    except Exception:
        return ''

for drop in [False,True]:
  for lg in [False,True]:
    pred=[conv(s,None,drop,lg) for s in df.smiles]
    nonempty=np.mean([len(p)>0 for p in pred])
    lev=np.array([L.distance(str(t),p) for t,p in zip(df.InChI,pred)])
    print('drop_dummy',drop,'largest',lg,'nonempty',round(nonempty,3),'exact',round((lev==0).mean(),3),'mean',round(lev.mean(),2))
