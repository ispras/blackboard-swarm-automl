import sys,glob,pandas as pd,numpy as np
sys.path.append("/usr/local/lib/python3.11/site-packages"); sys.path.append("/download_job_code/payload/sandbox/workspaces/altair_epsilon")
from rdkit import Chem, RDLogger; RDLogger.DisableLog("rdApp.*")
from postproc import smi_to_inchi_fallback
from rapidfuzz.distance import Levenshtein as LV
from concurrent.futures import ProcessPoolExecutor
def work(s):
    try: return smi_to_inchi_fallback(s)
    except: return ""
def valid(s):
