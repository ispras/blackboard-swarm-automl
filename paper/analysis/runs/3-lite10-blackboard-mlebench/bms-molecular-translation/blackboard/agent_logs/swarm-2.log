        tag=(round(full,4),order,T,round(h1,4),round(h2,4))
        if best is None or full<best[0]: best=tag
        if (order,T) in [(('raw','r180','fud','flr'),0.78), (('raw','r180','flr','fud'),0.78)]:
            print(order,T,round(full,4),round(h1,4),round(h2,4))
