print('gate +rigel-on-both-invalid mean',round(score(p2).mean(),3))
# rule3: both valid & formula disagree -> rigel formula vote, else higher score
p3=[]
for _,x in m.iterrows():
    if x.v1 and x.v2:
        if x.f1==x.f2: p3.append(x.p1)
        else:
            if x.fr==x.f2 and x.fr!=x.f1: p3.append(x.p2)
            elif x.fr==x.f1 and x.fr!=x.f2: p3.append(x.p1)
            else: p3.append(x.p2 if x.sc2>x.sc1 else x.p1)
    elif x.v1: p3.append(x.p1)
    elif x.v2: p3.append(x.p2)
    else: p3.append(x.pr if (x.vr and isinstance(x.pr,str) and len(x.pr)>5) else x.p1)
print('rule3 3-vote+rigel mean',round(score(p3).mean(),3),'exact',round((score(p3)==0).mean(),3))
# rule4: both valid & formula disagree -> higher score (no 1m default), else rigel on invalid
p4=[]
for _,x in m.iterrows():
    if x.v1 and x.v2:
        p4.append(x.p2 if (x.f1!=x.f2 and x.sc2>x.sc1) else x.p1)
    elif x.v1: p4.append(x.p1)
    elif x.v2: p4.append(x.p2)
    else: p4.append(x.pr if (x.vr and isinstance(x.pr,str) and len(x.pr)>5) else x.p1)
