"""Resumable sharded test inference for MolScribe zero-shot (+postproc).
Run under systemd-run --scope. Writes shard csvs: image_id,InChI,zs_smiles
Usage: python infer_molscribe.py --start 0 --end 121000 --out shard_0.csv
"""
import sys, os, time, argparse
ROOT='/download_job_code/payload/sandbox'
sys.path.insert(0, f'{ROOT}/workspaces/altair_epsilon/pylibs')
sys.path.insert(0, '/usr/local/lib/python3.11/site-packages')
sys.path.insert(0, f'{ROOT}/workspaces/altair_epsilon/MolScribe')
import torch, pandas as pd, numpy as np, cv2
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')
try:
    from rdkit.Chem.MolStandardize import rdMolStandardize
except Exception:
    rdMolStandardize=None

def smi_to_inchi(smi):
    if not isinstance(smi,str) or smi in ('','<invalid>'): return ''
    try:
        m=Chem.MolFromSmiles(smi, sanitize=False)
        if m is None: return ''
        try: Chem.SanitizeMol(m)
        except: pass
        em=Chem.RWMol(m); idx=[a.GetIdx() for a in m.GetAtoms() if a.GetAtomicNum()==0]
        for i in sorted(idx, reverse=True): em.RemoveAtom(i)
        m=em.GetMol()
        try: Chem.SanitizeMol(m)
        except: pass
        if rdMolStandardize is not None:
            try: m=rdMolStandardize.FragmentParent(m)
            except: pass
        return Chem.MolToInchi(m)
    except Exception:
        return ''

def path(i): return f'{ROOT}/data/test/{i[0]}/{i[1]}/{i[2]}/{i}.png'

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--start',type=int,default=0); ap.add_argument('--end',type=int,default=-1)
    ap.add_argument('--bs',type=int,default=64); ap.add_argument('--out',required=True)
    ap.add_argument('--ckpt',default=f'{ROOT}/workspaces/altair_epsilon/weights/swin_base_char_aux_1m.pth')
    a=ap.parse_args()
    ids=pd.read_csv(f'{ROOT}/data/sample_submission.csv').image_id.tolist()
    end=len(ids) if a.end<0 else min(a.end,len(ids))
    ids=ids[a.start:end]
    from molscribe import MolScribe
    dev=torch.device('cuda')
    model=MolScribe(a.ckpt, device=dev, num_workers=1)
    rows=[]; t0=time.time(); done=0
    for k in range(0,len(ids),a.bs):
        chunk=ids[k:k+a.bs]
        imgs=[]
        for i in chunk:
            im=cv2.imread(path(i))
            imgs.append(cv2.cvtColor(im,cv2.COLOR_BGR2RGB) if im is not None else np.full((128,256,3),255,np.uint8))
        with torch.no_grad():
            out=model.predict_images(imgs,batch_size=a.bs)
        for i,o in zip(chunk,out):
            s=o['smiles']
            rows.append((i, smi_to_inchi(s), s))
        done+=len(chunk)
        if done % (a.bs*20)==0:
            el=time.time()-t0
            print(f'{done}/{len(ids)} {done/el:.2f} img/s eta {(len(ids)-done)/max(done/el,1e-9)/60:.1f} min', flush=True)
            pd.DataFrame(rows,columns=['image_id','InChI','zs_smiles']).to_csv(a.out,index=False)
    pd.DataFrame(rows,columns=['image_id','InChI','zs_smiles']).to_csv(a.out,index=False)
    print('done',len(rows),'in',time.time()-t0,'s ->',a.out)
if __name__=='__main__': main()
EOF
