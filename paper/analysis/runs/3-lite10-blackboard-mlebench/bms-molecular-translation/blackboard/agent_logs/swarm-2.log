"""Independent final assembler from altair's per-image InChI files.
Gate: 1m if valid; elif 680k if valid; elif rigel present -> rigel; else 1m string.
Optionally --rigel_mode valid_only|all_both_invalid to control.
Usage: python finalize.py --inchi1 W/altair_epsilon/preds1m_inchi.csv --inchi2 W/altair_epsilon/preds680_inchi.csv \
  [--rigel rigel_test_bothinvalid.csv] --out final_solution/submission.csv
"""
import argparse, pandas as pd, numpy as np, os
ROOT='/download_job_code/payload/sandbox'
def load(p, col='inchi'):
    d=pd.read_csv(p)
    if col not in d.columns:
        for c in ['InChI','pred','inchi','Inchi']:
            if c in d.columns: col=c; break
    return d[['image_id',col]].rename(columns={col:'p'}), d
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--inchi1',required=True); ap.add_argument('--inchi2',default='')
    ap.add_argument('--rigel',default=''); ap.add_argument('--out',required=True)
    a=ap.parse_args()
    s=pd.read_csv(f'{ROOT}/data/sample_submission.csv')[['image_id']]
    d1,raw1=load(a.inchi1)
    d1['v1']=raw1.get('valid', None) if 'valid' in raw1.columns else None
    if d1['v1'].isna().any() if d1['v1'] is not None else True:
        import sys; sys.path.append('/usr/local/lib/python3.11/site-packages')
        from rdkit import Chem, RDLogger; RDLogger.DisableLog('rdApp.*')
        d1['v1']=[(isinstance(x,str) and x.startswith('InChI=1S/') and x.count('/')>=2 and Chem.MolFromInchi(x) is not None) for x in d1['p']]
    m=s.merge(d1,on='image_id',how='left').rename(columns={'p':'p1','v1':'v1'})
    if a.inchi2:
        d2,raw2=load(a.inchi2)
        if 'valid' in raw2.columns: d2['v2']=raw2['valid']
        else:
            import sys; sys.path.append('/usr/local/lib/python3.11/site-packages')
            from rdkit import Chem, RDLogger; RDLogger.DisableLog('rdApp.*')
            d2['v2']=[(isinstance(x,str) and x.startswith('InChI=1S/') and x.count('/')>=2 and Chem.MolFromInchi(x) is not None) for x in d2['p']]
        m=m.merge(d2.rename(columns={'p':'p2','v2':'v2'}),on='image_id',how='left')
    else:
        m['p2']=None; m['v2']=False
    m['p1']=m.p1.fillna('').astype(str); m['p2']=m.p2.fillna('').astype(str)
    m['v1']=m.v1.fillna(False).astype(bool); m['v2']=m.v2.fillna(False).astype(bool)
    out=np.where(m.v1.values, m.p1.values, np.where(m.v2.values, m.p2.values, m.p1.values))
    if a.rigel:
        r=pd.read_csv(a.rigel)
        col=[c for c in ['InChI','pred','inchi'] if c in r.columns][0]
        r=r[['image_id',col]].rename(columns={col:'pr'})
        m=m.merge(r,on='image_id',how='left'); pr=m.pr.fillna('').astype(str).values
        none_valid=(~m.v1.values)&(~m.v2.values)
        use_r=none_valid & (np.char.str_len(pr.astype(str))>5) if hasattr(np.char,'str_len') else none_valid & np.array([len(x)>5 for x in pr])
        out=np.where(use_r, pr, out)
        print('rigel filled',int(use_r.sum()))
    out=out.astype(str)
    out[np.array([len(x)<6 for x in out])]='InChI=1S/'
    sub=pd.DataFrame({'image_id':m.image_id.values,'InChI':out})
    assert len(sub)==len(s) and sub.image_id.nunique()==len(s)
    os.makedirs(os.path.dirname(a.out),exist_ok=True); sub.to_csv(a.out,index=False)
    print('wrote',a.out,sub.shape,'placeholder',int((sub.InChI=='InChI=1S/').sum()),
          'v1',round(m.v1.mean(),4),'v2',round(m.v2.mean(),4))
if __name__=='__main__': main()
EOF
