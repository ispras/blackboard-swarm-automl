    with ProcessPoolExecutor(max_workers=24) as ex: d["inchi"]=list(ex.map(work,d.smiles.astype(str).tolist(),chunksize=200))
    d["valid"]=[valid(x) for x in d.inchi]; return d[["image_id","inchi","valid","score"]]
a=load("h1m").rename(columns={"inchi":"p1","valid":"v1","score":"s1"})
b=load("h680").rename(columns={"inchi":"p2","valid":"v2","score":"s2"})
m=truth.merge(a,on="image_id").merge(b,on="image_id")
m["l1"]=[LV.distance(g,str(p)) for g,p in zip(m.gt,m.p1)]
m["l2"]=[LV.distance(g,str(p)) for g,p in zip(m.gt,m.p2)]
print("N",len(m))
print("1m mean",round(m.l1.mean(),3),"exact",round((m.l1==0).mean(),3),"valid",round(m.v1.mean(),4))
print("680 mean",round(m.l2.mean(),3),"exact",round((m.l2==0).mean(),3),"valid",round(m.v2.mean(),4))
gate=np.where(m.v1,m.p1,np.where(m.v2,m.p2,m.p1))
m["gate"]=[LV.distance(g,str(p)) for g,p in zip(m.gt,gate)]
print("GATE mean",round(m.gate.mean(),3),"exact",round((m.gate==0).mean(),3))
print("oracle min",round(np.minimum(m.l1,m.l2).mean(),3))
bi=(~m.v1)&(~m.v2); print("both-invalid n",bi.sum(),round(bi.mean(),4),"gate there",round(m.loc[bi,"gate"].mean(),2))
oi=(~m.v1)&m.v2; print("1m-inv&680-valid n",oi.sum(),round(oi.mean(),4),"gate there",round(m.loc[oi,"gate"].mean(),2))
m[["image_id","gt","p1","p2","s1","s2","v1","v2","l1","l2","gate"]].to_csv("/tmp/opencode/paired2000.csv",index=False)
