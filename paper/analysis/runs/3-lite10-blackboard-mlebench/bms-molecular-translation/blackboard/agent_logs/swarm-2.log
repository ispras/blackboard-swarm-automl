p=[]
for i in range(len(t)):
    p.append(tta_pick([t[f'v{r}'].iloc[i] for r in rots],[t[f'inchi{r}'].iloc[i] for r in rots],S[i]))
t['tta']=[x if x is not None else t['inchi0'].iloc[i] for i,x in enumerate(p)]
t['tta_valid']=[x is not None for x in p]
t['l_tta']=[LV.distance(g,str(x)) for g,x in zip(t['gt'],t['tta'])]
print('N',len(t),'TTA mean',round(t.l_tta.mean(),2),'valid',round(np.mean(t.tta_valid),3))
if a.rigel:
    r=pd.read_csv(a.rigel); col=[c for c in ['InChI','pred','inchi'] if c in r.columns][0]
    r=r[['image_id',col]].rename(columns={col:'rp'})
    t=t.merge(r,on='image_id',how='left'); t['rp']=t.rp.fillna('').astype(str)
    t['rv']=[val(x) and len(x)>5 for x in t.rp]
    t['l_r']=[LV.distance(g,str(x)) for g,x in zip(t['gt'],t.rp)]
    print('rigel mean on these',round(t.l_r.mean(),2),'valid',round(np.mean(t.rv),3))
    # combined: TTA if valid else rigel if valid else tta(formula)
    comb=np.where(t.tta_valid, t.tta, np.where(t.rv, t.rp, t.tta))
    t['comb']=[LV.distance(g,str(x)) for g,x in zip(t['gt'],comb)]
    print('TTA->rigel mean',round(t.comb.mean(),2))
    print('rigel->TTA mean',round(np.mean([LV.distance(g,str(x)) for g,x in zip(t['gt'],np.where(t.rv,t.rp,t.tta))]),2))
    rv_only=~t.tta_valid
    print('TTA-invalid subset n',int(rv_only.sum()),'TTA',round(t.loc[rv_only,'l_tta'].mean(),2),'rigel',round(t.loc[rv_only,'l_r'].mean(),2),'rigel-valid',round(np.mean(t.loc[rv_only,'rv']),3))
t.to_csv('/tmp/opencode/bothinv_compare.csv',index=False)
