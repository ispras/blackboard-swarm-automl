    ap.add_argument('--layers', type=int, default=6)
    ap.add_argument('--dim_ff', type=int, default=2048)
    ap.add_argument('--dropout', type=float, default=0.1)
    ap.add_argument('--enc', default='convnext_tiny.fb_in22k_ft_in1k')
