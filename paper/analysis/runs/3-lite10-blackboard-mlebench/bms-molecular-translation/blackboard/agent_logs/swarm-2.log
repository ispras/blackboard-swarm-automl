import sys, os, time, argparse
ROOT='/download_job_code/payload/sandbox'
sys.path.insert(0, f'{ROOT}/workspaces/altair_epsilon/pylibs')
sys.path.insert(0, '/usr/local/lib/python3.11/site-packages')
sys.path.insert(0, f'{ROOT}/workspaces/altair_epsilon')
import torch, pandas as pd, numpy as np, cv2
from molscribe import MolScribe
from postproc import smi_to_inchi_fallback
ap=argparse.ArgumentParser()
ap.add_argument('--ids',required=True); ap.add_argument('--imgroot',default=f'{ROOT}/data/train')
ap.add_argument('--ckpt',default=f'{ROOT}/workspaces/altair_epsilon/weights/swin_base_char_aux_1m.pth')
ap.add_argument('--bs',type=int,default=64); ap.add_argument('--out',required=True)
ap.add_argument('--rots',default='0,1,2,3')
a=ap.parse_args()
rots=[int(x) for x in a.rots.split(',')]
model=MolScribe(a.ckpt, device=torch.device('cuda'), num_workers=1); model.decoder.compute_confidence=True
df=pd.read_csv(a.ids)
def path(i): return f"{a.imgroot}/{i[0]}/{i[1]}/{i[2]}/{i}.png"
out=df.copy(); t0=time.time()
for rot in rots:
    rows=[]
    for k in range(0,len(df),a.bs):
        chunk=df.image_id.iloc[k:k+a.bs].tolist(); imgs=[]
        for i in chunk:
            im=cv2.imread(path(i))
            if im is None: im=np.full((128,256,3),255,np.uint8)
            im=cv2.cvtColor(im,cv2.COLOR_BGR2RGB)
            if rot: im=np.ascontiguousarray(np.rot90(im,rot))
            imgs.append(im)
        ims=[model.transform(image=im,keypoints=[])['image'] for im in imgs]
        x=torch.stack(ims).cuda()
        with torch.no_grad(), torch.autocast('cuda',dtype=torch.bfloat16):
            f,h=model.encoder(x); preds=model.decoder.decode(f,h)
        rows += [(p['chartok_coords']['smiles'], float(p.get('overall_score',0.0))) for p in preds]
    out[f'smi{rot}']=[s for s,_ in rows]; out[f'score{rot}']=[sc for _,sc in rows]
    out[f'inchi{rot}']=[smi_to_inchi_fallback(s) for s,_ in rows]
    print('rot',rot*90,'done',round(time.time()-t0,1),'s',flush=True)
out.to_csv(a.out,index=False); print('wrote',a.out,out.shape,'total',round(time.time()-t0,1),'s')
EOF
