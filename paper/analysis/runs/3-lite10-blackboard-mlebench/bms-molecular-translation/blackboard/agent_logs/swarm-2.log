def to_inchi(smi, mode):
    if not isinstance(smi,str) or smi in ('','<invalid>'): return ''
    try:
        if mode=='plain':
            m=Chem.MolFromSmiles(smi)
        elif mode=='nosanitize':
            m=Chem.MolFromSmiles(smi, sanitize=False)
            if m is not None:
