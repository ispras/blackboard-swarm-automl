    tok = Tokenizer.from_file(f'{WORK}/bpe1024.json')
    PAD, BOS, EOS = tok.token_to_id('[PAD]'), tok.token_to_id('[BOS]'), tok.token_to_id('[EOS]')
    vocab = tok.get_vocab_size()

    meta = pd.read_csv(f'{WORK}/labels_meta.csv')
