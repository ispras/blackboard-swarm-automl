"""Assemble final submission: MolScribe 1m shards (+optional rescue shards e.g. 680k) (+optional rigel).
Rule: per image, among MolScribe candidates prefer RDKit-valid; if both valid prefer higher confidence
(with a margin); if none valid -> rigel fallback (validated better than empty); else formula fallback.
Usage:
 python assemble_final.py --ms '.../preds/shard*.csv' [--ms2 '.../rescue/*.csv'] [--rigel preds.csv] \
   --out final_solution/submission.csv
"""
import argparse, glob, sys, os
import pandas as pd, numpy as np
from concurrent.futures import ProcessPoolExecutor
ROOT='/download_job_code/payload/sandbox'
sys.path.append('/usr/local/lib/python3.11/site-packages'); sys.path.append(f'{ROOT}/workspaces/altair_epsilon')
from rdkit import Chem, RDLogger; RDLogger.DisableLog('rdApp.*')
from postproc import smi_to_inchi_fallback
_fc={}
def valid(s):
    if not isinstance(s,str) or not s.startswith('InChI=1S/') or s.count('/')<2: return False
    if s in _fc: return _fc[s]
    try: ok=Chem.MolFromInchi(s) is not None
    except Exception: ok=False
    _fc[s]=ok; return ok
def work(s):
    try: return smi_to_inchi_fallback(s)
    except Exception: return ''

def load_ms(pattern, workers, tag):
    files=sorted(glob.glob(pattern)); print(tag,'files',len(files))
    if not files: return None
    d=pd.concat([pd.read_csv(f) for f in files],ignore_index=True)
    if 'smiles' not in d.columns:
        print(tag,'no smiles col',d.columns.tolist()); return None
    d=d.drop_duplicates('image_id')
    with ProcessPoolExecutor(max_workers=workers) as ex:
        d[tag+'_inchi']=list(ex.map(work,d.smiles.astype(str).tolist(),chunksize=2000))
    d[tag+'_ok']=[valid(x) for x in d[tag+'_inchi']]
    if 'score' not in d.columns: d['score']=0.0
    d['score']=pd.to_numeric(d['score'],errors='coerce').fillna(0.0)
    print(tag,'rows',len(d),'valid',round(d[tag+'_ok'].mean(),4))
    return d[['image_id',tag+'_inchi',tag+'_ok','score']].rename(columns={'score':tag+'_score'})

def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--ms',required=True); ap.add_argument('--ms2',default='')
    ap.add_argument('--rigel',default=''); ap.add_argument('--out',required=True)
    ap.add_argument('--workers',type=int,default=32); ap.add_argument('--margin',type=float,default=0.0)
    a=ap.parse_args()
    m=pd.read_csv(f'{ROOT}/data/sample_submission.csv')[['image_id']]
    A=load_ms(a.ms,a.workers,'a')
    if A is not None: m=m.merge(A,on='image_id',how='left')
    B=load_ms(a.ms2,a.workers,'b') if a.ms2 else None
    if B is not None: m=m.merge(B,on='image_id',how='left')
    if 'a_inchi' not in m.columns: m['a_inchi']=''; m['a_ok']=False; m['a_score']=0.0
    if 'b_inchi' not in m.columns: m['b_inchi']=None; m['b_ok']=False; m['b_score']=0.0
    m['a_ok']=m.a_ok.fillna(False).astype(bool); m['b_ok']=m.b_ok.fillna(False).astype(bool)
    has_b=m.b_inchi.notna()
    out=m.a_inchi.fillna('').astype(str).copy()
    # both valid on has_b rows: pick higher score (margin favors a when nearly equal)
    both=has_b & m.a_ok & m.b_ok
    pick_b=both & (m.b_score > m.a_score + a.margin)
    out.loc[pick_b]=m.loc[pick_b,'b_inchi']
    # a invalid, b valid -> b
    only_b=has_b & (~m.a_ok) & m.b_ok
    out.loc[only_b]=m.loc[only_b,'b_inchi']
    # none valid -> keep a string for now (rigel later)
    if a.rigel:
        r=pd.read_csv(a.rigel)[['image_id','InChI']].rename(columns={'InChI':'r_inchi'})
        m2=pd.DataFrame({'image_id':m.image_id,'out':out}).merge(r,on='image_id',how='left')
        m['r_inchi']=m2.r_inchi.values
        none_valid=(~m.a_ok)&((~m.b_ok)|(~has_b))
        use_r=none_valid & m.r_inchi.notna() & (m.r_inchi.astype(str).str.len()>5)
        out.loc[use_r]=m.loc[use_r,'r_inchi']
        print('rigel filled',int(use_r.sum()))
    out=out.fillna('').astype(str)
    out[out.str.len()<6]='InChI=1S/'
    sub=pd.DataFrame({'image_id':m.image_id,'InChI':out})
    assert len(sub)==len(m) and sub.image_id.nunique()==len(m)
    os.makedirs(os.path.dirname(a.out),exist_ok=True); sub.to_csv(a.out,index=False)
    print('wrote',a.out,sub.shape,'placeholder',int((sub.InChI=='InChI=1S/').sum()),
          'a_valid',round(m.a_ok.mean(),4),'b_valid',round(m.b_ok.mean(),4) if B is not None else 'na')
if __name__=='__main__': main()
