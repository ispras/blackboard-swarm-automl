def load_model(ckpt,device):
    ck=torch.load(ckpt,map_location='cpu'); a=ck.get('args',{})
    m=Model(369,enc_name=a.get('enc','convnext_tiny.fb_in22k_ft_in1k'),out_index=a.get('out_index',2),d_model=a.get('d_model',512),nhead=a.get('nhead',8),layers=a.get('layers',6),dim_ff=a.get('dim_ff',2048),dropout=a.get('dropout',0.1),max_len=320,pretrained=False)
    m.load_state_dict(ck['model']); m.to(device).eval(); return m,a
def transform(img,tf):
    # img RGB
    if tf=='fliplr': return np.ascontiguousarray(img[:, ::-1])
    if tf=='flipud': return np.ascontiguousarray(img[::-1, :])
    if tf=='rot180_fliplr': return np.ascontiguousarray(np.rot90(img,2)[:, ::-1])
    if tf.startswith('rot'):
        deg=int(tf[3:]); h,w=img.shape[:2]; M=cv2.getRotationMatrix2D((w/2,h/2),deg,1.0); return cv2.warpAffine(img,M,(w,h),borderValue=(255,255,255))
    return img
def make_img(path,size,tf):
    img=cv2.imread(path)
    if img is None: return np.zeros((size,size,3),np.uint8)
    img=cv2.cvtColor(img,cv2.COLOR_BGR2RGB); img=transform(img,tf)
    img=cv2.resize(img,(size,size),interpolation=cv2.INTER_AREA)
    img=(img.astype(np.float32)/255.0-MEAN)/STD
    return np.transpose(img,(2,0,1))
ap=argparse.ArgumentParser()
ap.add_argument('--ids',required=True); ap.add_argument('--imgroot',required=True); ap.add_argument('--out',required=True)
ap.add_argument('--ckpt',default=f'{WORK}/ck_v1_last.pt'); ap.add_argument('--tf',default='fliplr'); ap.add_argument('--bs',type=int,default=192); ap.add_argument('--shard',type=int,default=0); ap.add_argument('--nshard',type=int,default=1)
args=ap.parse_args()
df=pd.read_csv(args.ids).iloc[args.shard::args.nshard].reset_index(drop=True); ids=df.image_id.tolist()
if os.path.exists(args.out):
    done=set(pd.read_csv(args.out).image_id.astype(str)); ids=[i for i in ids if i not in done]; print('resume skip',len(done),'remaining',len(ids),flush=True)
device=torch.device('cuda'); tok=Tokenizer.from_file(f'{WORK}/bpe1024.json'); BOS,EOS=tok.token_to_id('[BOS]'),tok.token_to_id('[EOS]')
model,a=load_model(args.ckpt,device); size=a.get('img_size',384)
rows=[]; t0=time.time()
with torch.no_grad():
    for k in range(0,len(ids),args.bs):
        chunk=ids[k:k+args.bs]
        imgs=[make_img(f'{args.imgroot}/{i[0]}/{i[1]}/{i[2]}/{i}.png',size,args.tf) for i in chunk]
