import pandas as pd,numpy as np,sys
sys.path.append('/usr/local/lib/python3.11/site-packages')
from rdkit import Chem,RDLogger; RDLogger.DisableLog('rdApp.*')
from rapidfuzz.distance import Levenshtein as LV
truth=pd.read_csv('analysis/holdout_20k.csv').rename(columns={'InChI':'gt'})
one=pd.read_csv('/tmp/opencode/h20k_1m_inchi.csv').rename(columns={'inchi':'p1','valid':'v1','score':'s1'})
raw=pd.read_csv('workspaces/rigel_mu/rigel_val20k.csv').rename(columns={'InChI':'raw'})
r180=pd.read_csv('/tmp/opencode/rigel_holdout_r180.csv').rename(columns={'InChI':'r180'})
fud=pd.read_csv('/tmp/opencode/resid_flipud.csv').rename(columns={'InChI':'fud'})
flr=pd.read_csv('/tmp/opencode/resid_fliplr.csv').rename(columns={'InChI':'flr'})
def canon(s):
    try:
        m=Chem.MolFromInchi(s, sanitize=False, removeHs=False)
        if m is None: return s
        r=Chem.MolToInchi(m); return r if r else s
    except: return s
def valid(s):
    try: return isinstance(s,str) and s.startswith('InChI=1S/') and s.count('/')>=2 and Chem.MolFromInchi(s) is not None
    except: return False
m=truth.merge(one[['image_id','p1','v1','s1']],on='image_id').merge(raw,on='image_id').merge(r180,on='image_id',how='left').merge(fud,on='image_id',how='left').merge(flr,on='image_id',how='left')
for c in ['r180','fud','flr']: m[c]=m[c].fillna('').astype(str)
for c,nr in [('rc','raw'),('r180c','r180'),('fudc','fud'),('flrc','flr')]:
    m[c]=m[nr].map(canon)
raw_ok=np.array([valid(x) for x in m.raw]); r_ok=np.array([valid(x) for x in m.r180])
fu_ok=np.array([valid(x) for x in m.fud]); fl_ok=np.array([valid(x) for x in m.flr])
G=m['gt'].astype(str).values; h=np.arange(len(m))<10000
def ev(mask,p): return np.mean([LV.distance(g,str(x)) for g,x in zip(G[mask],p[mask])])
for T in [0.75,0.78,0.80]:
    use1=m['v1'].values&(m['s1'].values>=T)
    pred=np.where(raw_ok,m.rc.values,np.where(r_ok,m.r180c.values,np.where(fu_ok,m.fudc.values,np.where(fl_ok,m.flrc.values,np.where(use1,m.p1.values,m.rc.values)))))
    print('RuleD T',T,'full',round(ev(np.ones(len(m),bool),pred),4),'h1',round(ev(h,pred),4),'h2',round(ev(~h,pred),4),
          'fu_rescue',int((fu_ok&~raw_ok&~r_ok).sum()),'fl_rescue',int((fl_ok&~raw_ok&~r_ok&~fu_ok).sum()))
# rule C for reference
use1=m['v1'].values&(m['s1'].values>=0.78)
predC=np.where(raw_ok,m.rc.values,np.where(r_ok,m.r180c.values,np.where(use1,m.p1.values,m.rc.values)))
print('RuleC',round(ev(np.ones(len(m),bool),predC),4))
