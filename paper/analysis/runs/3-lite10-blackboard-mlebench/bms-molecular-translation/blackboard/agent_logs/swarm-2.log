"""Assemble final submission from MolScribe shards (+optional rigel preds) with postproc.
Usage:
 python assemble_final.py --ms 'workspaces/altair_epsilon/preds/shard*.csv' \
   [--rigel work/rigel_val_or_test.csv] --out final_solution/submission.csv
Rule: use MolScribe valid full InChI; if MolScribe empty/trivial or invalid -> use rigel; else keep.
"""
import argparse, glob, sys, os, re
import pandas as pd, numpy as np
from concurrent.futures import ProcessPoolExecutor
ROOT='/download_job_code/payload/sandbox'
sys.path.append('/usr/local/lib/python3.11/site-packages')
sys.path.insert(0,f'{ROOT}/workspaces/altair_epsilon')
from postproc import smi_to_inchi_fallback

def work(s):
    try: return smi_to_inchi_fallback(s)
    except Exception: return ''

def full(s):
    return isinstance(s,str) and s.startswith('InChI=1S/') and s.count('/')>=2

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ms',required=True,help='glob of shard csvs (image_id,smiles[,score])')
    ap.add_argument('--rigel',default='')
    ap.add_argument('--out',required=True); ap.add_argument('--workers',type=int,default=32)
    a=ap.parse_args()
    files=sorted(glob.glob(a.ms)); print('shards',len(files))
    ms=pd.concat([pd.read_csv(f) for f in files],ignore_index=True).drop_duplicates('image_id')
    print('ms rows',len(ms))
    with ProcessPoolExecutor(max_workers=a.workers) as ex:
        ms['InChI']=list(ex.map(work, ms.smiles.astype(str).tolist(), chunksize=2000))
    ms['ok']=ms.InChI.map(full)
    print('ms full-inchi frac', round(ms.ok.mean(),4), 'empty', round((ms.InChI.astype(str).str.len()<6).mean(),4))
    samp=pd.read_csv(f'{ROOT}/data/sample_submission.csv')[['image_id']]
    m=samp.merge(ms[['image_id','InChI','ok']],on='image_id',how='left')
    if a.rigel:
        r=pd.read_csv(a.rigel)[['image_id','InChI']].rename(columns={'InChI':'rInChI'})
        m=m.merge(r,on='image_id',how='left')
        m['rfull']=m.rInChI.map(full)
        use_r=(~m.ok) & m.rInChI.notna() & (m.rInChI.astype(str).str.len()>5)
        print('rigel fill count', int(use_r.sum()))
        m.loc[use_r,'InChI']=m.loc[use_r,'rInChI']
    m['InChI']=m.InChI.fillna('InChI=1S/')
    out=m[['image_id','InChI']]
    assert len(out)==len(samp) and out.image_id.nunique()==len(samp)
    os.makedirs(os.path.dirname(a.out),exist_ok=True)
    out.to_csv(a.out,index=False)
    print('wrote',a.out,out.shape,'empty',int((out.InChI.astype(str).str.len()<6).sum()))

if __name__=='__main__': main()
