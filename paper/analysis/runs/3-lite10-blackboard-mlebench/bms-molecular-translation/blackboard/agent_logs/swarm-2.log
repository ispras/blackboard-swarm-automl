flr=pd.read_csv('/tmp/opencode/resid_fliplr.csv').rename(columns={'InChI':'flr'})
def canon(s):
    try:
        m=Chem.MolFromInchi(s, sanitize=False, removeHs=False)
        if m is None: return s
        r=Chem.MolToInchi(m); return r if r else s
    except: return s
def valid(s):
    try: return isinstance(s,str) and s.startswith('InChI=1S/') and s.count('/')>=2 and Chem.MolFromInchi(s) is not None
    except: return False
m=truth.merge(one[['image_id','p1','v1','s1']],on='image_id').merge(raw,on='image_id').merge(r180,on='image_id',how='left').merge(fud,on='image_id',how='left').merge(flr,on='image_id',how='left')
for c in ['r180','fud','flr']: m[c]=m[c].fillna('').astype(str)
C={}
for c,nr in [('rc','raw'),('r180c','r180'),('fudc','fud'),('flrc','flr')]: C[c]=m[nr].map(canon).values
V={k:np.array([valid(x) for x in m[nr]]) for k,nr in [('raw','raw'),('r180','r180'),('fud','fud'),('flr','flr')]}
G=m['gt'].astype(str).values; s1=m.s1.values; v1=m.v1.values; p1=m.p1.values
h=np.arange(len(m))<10000
def ev(p,mask=None):
    if mask is None: return np.mean([LV.distance(g,str(x)) for g,x in zip(G,p)])
    return np.mean([LV.distance(g,str(x)) for g,x in zip(G[mask],p[mask])])
def rule(order,T):
    use1=v1&(s1>=T)
    out=np.where(use1,p1,C['rc'])  # will override below by priority
    # apply in reverse priority so first in order wins
    out=C['rc'].copy()
    for key in reversed(order):
        mask=V[key]
        out=np.where(mask,C[{'raw':'rc','r180':'r180c','fud':'fudc','flr':'flrc'}[key]],out)
    # 1m only if none valid
    anytrans=np.zeros(len(m),bool)
    for key in order: anytrans|=V[key]
    out=np.where((~anytrans)&use1,p1,out)
    return out
best=None
