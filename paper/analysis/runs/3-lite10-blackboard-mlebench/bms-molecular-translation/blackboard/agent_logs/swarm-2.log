"""Evaluate combination rules for two prediction files on a holdout.
A=primary (e.g. rigel model), B=secondary (e.g. MolScribe).
Usage: python ensemble_eval.py --truth analysis/holdout_20k.csv --A a.csv --B b.csv [--Bconf mol_conf]
CSVs need image_id,InChI (extra cols allowed).
"""
import argparse, pandas as pd, numpy as np, sys, re
sys.path.append('/usr/local/lib/python3.11/site-packages')
from rapidfuzz.distance import Levenshtein as LV
from rdkit import Chem, RDLogger
RDLogger.DisableLog('rdApp.*')

def formula(s):
    if not isinstance(s,str): return ''
    m=re.match(r'InChI=[0-9A-Za-z]+/([^/]+)', s); return m.group(1) if m else ''
_valid={}
def valid_inchi(s):
    if not isinstance(s,str) or not s.startswith('InChI='): return False
    if s in _valid: return _valid[s]
    try: ok=Chem.MolFromInchi(s) is not None
    except Exception: ok=False
    _valid[s]=ok; return ok

def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--truth',default='analysis/holdout_20k.csv')
    ap.add_argument('--A',required=True); ap.add_argument('--B',required=True)
    ap.add_argument('--Bconf',default=None); ap.add_argument('--n',type=int,default=0)
    a=ap.parse_args()
    t=pd.read_csv(a.truth); A=pd.read_csv(a.A); B=pd.read_csv(a.B)
    m=t.merge(A[['image_id','InChI']].rename(columns={'InChI':'pa'}),on='image_id',how='inner')
    m=m.merge(B,on='image_id',how='left'); m=m.rename(columns={'InChI':'pb'})
    if a.n: m=m.head(a.n)
    pa=m.pa.fillna('').astype(str).tolist(); pb=m.pb.fillna('').astype(str).tolist(); gt=m.InChI.astype(str).tolist()
    da=np.array([LV.distance(g,x) for g,x in zip(gt,pa)]); db=np.array([LV.distance(g,x) for g,x in zip(gt,pb)])
    print(f'N={len(m)}  A mean {da.mean():.3f} (exact {(da==0).mean():.3f})  B mean {db.mean():.3f} (exact {(db==0).mean():.3f})  oracle min {np.minimum(da,db).mean():.3f}')
    va=np.array([valid_inchi(x) for x in pa]); vb=np.array([valid_inchi(x) for x in pb])
    def ev(name,pred): d=np.array([LV.distance(g,x) for g,x in zip(gt,pred)]); print(f'{name:34s} mean {d.mean():8.3f} exact {(d==0).mean():.3f}')
    ev('A only',pa); ev('B only',pb); ev('A if valid else B',[x if v else y for x,y,v in zip(pa,pb,va)]); ev('B if valid else A',[y if v else x for x,y,v in zip(pa,pb,vb)])
    ev('A if valid&same_formula else B',[x if (v and formula(x)==formula(y) and formula(x)) else y for x,y,v in zip(pa,pb,va)])
    agree=[x if x==y else (x if v else y) for x,y,v in zip(pa,pb,va)]
    ev('agree A==B else (A valid?A:B)',agree)
    confcol=a.Bconf
    if confcol and confcol in m.columns:
        conf=m[confcol].fillna(0).values
        for th in [0.3,0.5,0.6,0.7,0.8,0.9]:
            ev(f'B if conf>{th} & valid else A',[y if (c>th and v) else x for x,y,v,c in zip(pa,pb,vb,conf)])
    # write per-row for inspection
    m[['image_id','InChI','pa','pb']].assign(da=da,db=db,va=va,vb=vb).to_csv('/tmp/opencode/ens_rows.csv',index=False)
if __name__=='__main__': main()
EOF
