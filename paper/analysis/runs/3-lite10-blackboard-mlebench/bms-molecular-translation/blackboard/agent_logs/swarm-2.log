        rows += [(i,tok.decode(o)) for i,o in zip(chunk,outs)]
tmp=args.out+'.tmp'; pd.DataFrame(rows,columns=['image_id','InChI']).to_csv(tmp,index=False); os.replace(tmp,args.out)
print('DONE',len(rows),round(time.time()-t0,1),'s')
