import sys, argparse, os
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_epsilon/pylibs')
sys.path.insert(0,'/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
from postproc import lev
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
ap=argparse.ArgumentParser()
ap.add_argument('--truth',default='../../analysis/holdout_20k.csv')
ap.add_argument('--ms',default='holdout_1m.csv')
ap.add_argument('--ms680',default='holdout_680.csv')  # optional rescue on invalid
ap.add_argument('--rigel',default='/download_job_code/payload/sandbox/workspaces/rigel_mu/rigel_val20k.csv')
ap.add_argument('--n',type=int,default=0)
ap.add_argument('--tta',default='holdout_tta.csv')  # optional image_id,rot,inchi
args=ap.parse_args()
t=pd.read_csv(args.truth).fillna('')
ms=pd.read_csv(args.ms).fillna('')
ms['v1']=ms.inchi.map(valid)
df=t.merge(ms[['image_id','inchi','score','v1']],on='image_id',how='left')
df['inchi']=df.inchi.fillna(''); df['score']=df.score.fillna(0.0); df['v1']=df.v1.fillna(False)
if os.path.exists(args.ms680):
    m6=pd.read_csv(args.ms680).fillna(''); m6['v2']=m6.inchi.map(valid)
    df=df.merge(m6[['image_id','inchi','v2']].rename(columns={'inchi':'i2'}),on='image_id',how='left')
    df['i2']=df.i2.fillna(''); df['v2']=df.v2.fillna(False)
else:
    df['i2']=''; df['v2']=False
rig=pd.read_csv(args.rigel).fillna('')
col='InChI' if 'InChI' in rig.columns else ('inchi' if 'inchi' in rig.columns else 'pred')
rig=rig[['image_id',col]].rename(columns={col:'r'})
df=df.merge(rig,on='image_id',how='left'); df['r']=df.r.fillna('')
df['rv']=df.r.map(valid)
if args.n: df=df.iloc[:args.n]
gt=df['InChI'].tolist()
def score_of(s): return np.mean([lev(a,b) for a,b in zip(s,gt)])
base=np.where(df.v1,df.inchi,np.where(df.v2,df.i2,df.inchi))
print('n',len(df))
print('ms1 valid',df.v1.mean(),'ms1 lev',score_of(df.inchi.tolist()))
print('rigel all lev',score_of(df.r.tolist()),'rigel valid',df.rv.mean())
print('gate(1m/680) lev',score_of(list(base)))
print('rigel only lev',score_of(df.r.tolist()))
print('1m-valid else rigel lev',score_of([a if v else (c if c else a) for a,v,c in zip(df.inchi,df.v1,df.r)]))
for th in [0.0,0.3,0.5,0.7,0.85]:
    out=[]
    for a,v,s,c in zip(df.inchi,df.v1,df.score,df.r):
        if v and s>=th: out.append(a)
        elif c: out.append(c)
        else: out.append(a)
    print(f'1m-valid&score>={th} else rigel lev',round(score_of(out),3))
