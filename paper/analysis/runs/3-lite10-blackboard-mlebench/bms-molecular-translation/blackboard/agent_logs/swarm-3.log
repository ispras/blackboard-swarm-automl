import pandas as pd, numpy as np
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
ap=argparse.ArgumentParser()
ap.add_argument('--rigel',required=True)
ap.add_argument('--fallback',default='best_fallback.csv')
ap.add_argument('--sample',default='../../data/sample_submission.csv')
ap.add_argument('--out',default='submission_rigel.csv')
ap.add_argument('--rule',default='rigel_valid_else_fb', choices=['rigel_valid_else_fb','rigel_always_else_fb','rigel_nonempty_else_fb'])
args=ap.parse_args()
rig=pd.read_csv(args.rigel).fillna('')
col='InChI' if 'InChI' in rig.columns else ('inchi' if 'inchi' in rig.columns else 'pred')
rig=rig[['image_id',col]].rename(columns={col:'r'}).drop_duplicates('image_id')
fb=pd.read_csv(args.fallback).fillna(''); fb['best']=fb.best.astype(str)
m=fb[['image_id','best']].merge(rig,on='image_id',how='left')
m['r']=m.r.fillna('').astype(str)
if args.rule=='rigel_valid_else_fb':
    rv=m.r.map(valid); out=np.where(rv,m.r,m.best)
elif args.rule=='rigel_nonempty_else_fb':
    out=np.where(m.r!='',m.r,m.best)
else:
    out=m.r.tolist()
s=pd.read_csv(args.sample,usecols=['image_id'])
o=s.merge(pd.DataFrame({'image_id':m.image_id,'InChI':out}),on='image_id',how='left')
o['InChI']=o.InChI.fillna('').astype(str)
o.to_csv(args.out,index=False)
print('rule',args.rule,'rigel rows',len(rig),'valid rigel on matched',np.mean([valid(x) for x in m.r.head(5000)]))
print('wrote',args.out,'rows',len(o),'empty',(o.InChI=='').mean(),'valid',np.mean([valid(x) for x in o.InChI.head(20000)]))
