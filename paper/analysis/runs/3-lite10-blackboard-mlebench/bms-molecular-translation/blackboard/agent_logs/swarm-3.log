import pandas as pd, numpy as np
from multiprocessing import Pool
from rapidfuzz.distance import Levenshtein as L
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
def canon(s):
    try:
        mol=Chem.MolFromInchi(s,sanitize=False,removeHs=False,treatWarningAsError=False)
        if mol is None: return s
        o=Chem.MolToInchi(mol); return o if o else s
    except Exception: return s
m=pd.read_csv('h20k_full_rule.csv').fillna(''); m['v1']=m.v1.astype(bool)
for tf in ['flipud','fliplr']:
    d=pd.read_csv(f'/tmp/h20k_{tf}.csv').fillna('').rename(columns={'InChI':tf})
    m=m.merge(d,on='image_id',how='left')
m['flipud']=m.flipud.fillna(''); m['fliplr']=m.fliplr.fillna('')
m['vud']=m.flipud.map(valid); m['vlr']=m.fliplr.map(valid)
with Pool(48) as p:
    m['cud']=p.map(canon,m.flipud.tolist(),chunksize=200); m['clr']=p.map(canon,m.fliplr.tolist(),chunksize=200)
gt=np.array(m.InChI.tolist()); lev=lambda a,b: L.distance(a,b)
def L_(col): return np.array([lev(a,b) for a,b in zip(m[col],gt)])
rv=m.rv.astype(bool).values; rrv=m.rrv.astype(bool).values; vud=m.vud.values; vlr=m.vlr.values
lc={c:L_(c) for c in ['i1','cr','crr','cud','clr']}
idx=np.arange(len(m)); rng=np.random.RandomState(1); rng.shuffle(idx); h1=idx[:10000]; h2=idx[10000:]
def rep(name,out): print(f'{name}: full={out.mean():.4f} h1={out[h1].mean():.4f} h2={out[h2].mean():.4f}')
T=0.78; req=(m.v1&(m.s1>=T)).values
rep('C (current)', np.where(rv,lc['cr'],np.where(rrv,lc['crr'],np.where(req,lc['i1'],lc['cr']))))
for name,mask,col in [
  ('C+ud', (~rv)&(~rrv)&vud, 'cud'),
  ('C+lr', (~rv)&(~rrv)&vlr, 'clr'),
  ('C+ud+lr', None, None)]:
    if name=='C+ud':
        out=np.where(rv,lc['cr'],np.where(rrv,lc['crr'],np.where(vud,lc['cud'],np.where(req,lc['i1'],lc['cr']))))
    elif name=='C+lr':
        out=np.where(rv,lc['cr'],np.where(rrv,lc['crr'],np.where(vlr,lc['clr'],np.where(req,lc['i1'],lc['cr']))))
    else:
        out=np.where(rv,lc['cr'],np.where(rrv,lc['crr'],np.where(vud,lc['cud'],np.where(vlr,lc['clr'],np.where(req,lc['i1'],lc['cr'])))))
    rep(name,out)
# order: 1m before flips
out=np.where(rv,lc['cr'],np.where(rrv,lc['crr'],np.where(req,lc['i1'],np.where(vud,lc['cud'],np.where(vlr,lc['clr'],lc['cr'])))))
rep('C 1m>ud>lr',out)
print('vud',vud.mean(),'vlr',vlr.mean())
