import pandas as pd, numpy as np
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
from postproc import lev
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
d=pd.read_csv('/tmp/tta_both_preds.csv').fillna('')
gt=d['InChI_1'].tolist()
b=pd.read_csv('/tmp/tta_both_base.csv').set_index('image_id')
base=[str(b.loc[i,'base']) if isinstance(b.loc[i,'base'],str) else '' for i in d.image_id]
def evaluate(order):
    out=[]
    for i in range(len(d)):
        cands=[d.loc[i,f'inchi_{c}'] for c in order if valid(d.loc[i,f'inchi_{c}'])]
        out.append(cands[0] if cands else '')
    L=np.array([lev(a,c) for a,c in zip(out,gt)])
    vf=np.mean([valid(x) for x in out])
    return L.mean(),vf
import itertools
cfgs=['1m_1','1m_2','1m_3','680_1','680_2','680_3']
# single configs
for c in cfgs:
    L=np.array([lev(d.loc[i,f'inchi_{c}'],gt[i]) for i in range(len(d))])
    print(c,'valid',round(np.mean([valid(d.loc[i,f'inchi_{c}']) for i in range(len(d))]),3),'mean',round(L.mean(),1))
print('---pairs---')
for a,bb in itertools.combinations(cfgs,2):
    m,vf=evaluate([a,bb]); print(a,bb,'mean',round(m,1),'valid',round(vf,3))
print('---triples best---')
res=[]
for combo in itertools.combinations(cfgs,3):
    m,vf=evaluate(list(combo)); res.append((m,vf,combo))
for m,vf,c in sorted(res)[:5]: print(c,'mean',round(m,1),'valid',round(vf,3))
