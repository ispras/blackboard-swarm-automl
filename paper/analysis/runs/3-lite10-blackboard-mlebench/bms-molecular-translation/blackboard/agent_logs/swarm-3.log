print('rigel rows',len(rig),'rot rows',len(rot),'raw valid',m.rv.mean(),'rot valid',m.rrv.mean())
with Pool(args.workers) as p:
    m['cr']=p.map(canon,m.r.tolist(),chunksize=500); m['crr']=p.map(canon,m.rr.tolist(),chunksize=500)
req=m.valid & (m.score>=args.T)
m['final']=np.where(m.rv, m.cr, np.where(m.rrv, m.crr, np.where(req, m.inchi, m.cr)))
