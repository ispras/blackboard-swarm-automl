from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
ap=argparse.ArgumentParser(); ap.add_argument('--dir',default='preds_tta'); ap.add_argument('--gate',default='submission_gate.csv'); ap.add_argument('--out',default='submission_final.csv'); ap.add_argument('--workers',type=int,default=40)
args=ap.parse_args()
files=sorted(glob.glob(f'{args.dir}/1m_r*.csv')); print(files)
dfs=[]
for f in files:
    d=pd.read_csv(f); key=f.split('/')[-1].rsplit('.csv',1)[0]; d['cfg']=key; dfs.append(d[['image_id','smiles','score','cfg']])
