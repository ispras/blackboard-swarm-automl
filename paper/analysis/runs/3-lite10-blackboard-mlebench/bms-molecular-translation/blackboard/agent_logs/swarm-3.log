    lor=np.mean([min(lev(P[i][r],gt[i]) for r in [0,1,3]) for i in idx])
    print(f'bottom {q:.0%} n={len(idx)} rot0={l0:.1f} rot90={l90:.1f} rot270={l270:.1f} maj={lmj:.1f} oracle={lor:.1f}')
