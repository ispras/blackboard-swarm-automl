def try_parse(s):
    for kw in [dict(sanitize=False,removeHs=False,treatWarningAsError=False),dict(sanitize=False,removeHs=True,treatWarningAsError=False)]:
        try:
            mol=Chem.MolFromInchi(s,**kw)
        except Exception: mol=None
        if mol is not None:
            try: return Chem.MolToInchi(mol)
            except Exception: pass
    return None
def base_sc(x): return float(np.mean([lev(u,v) for u,v in zip(x,gt)]))
