from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
from postproc import lev
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
d=pd.read_csv('/tmp/tta_both_preds.csv').fillna(''); gt=d['InChI_1'].tolist()
b=pd.read_csv('/tmp/tta_both_base.csv').set_index('image_id')
base=[str(b.loc[i,'base']) if isinstance(b.loc[i,'base'],str) else '' for i in d.image_id]
Lb=np.array([lev(a,c) for a,c in zip(base,gt)])
print('gate baseline on 53:',Lb.mean())
def rule(cfgs):
    out=[]
    for i in range(len(d)):
        cands=[(d.loc[i,f'score_{c}'],d.loc[i,f'inchi_{c}']) for c in cfgs if valid(d.loc[i,f'inchi_{c}'])]
        out.append(max(cands)[1] if cands else '')
    return out
for name,cfgs in [('r90+180+270',['1m_1','1m_2','1m_3']),('r90+270',['1m_1','1m_3']),('r90',['1m_1'])]:
    o=rule(cfgs); L=np.array([lev(a,c) for a,c in zip(o,gt)])
    vf=np.mean([valid(x) for x in o])
    # where TTA invalid, keep baseline formula -> approximate final on these rows by combining
    mixed=[o[i] if o[i] else base[i] for i in range(len(d))]
    Lm=np.array([lev(a,c) for a,c in zip(mixed,gt)])
    overall=(35.3828125*512 - Lb.sum() + Lm.sum())/512
    print(name,'TTA-only mean(valid else empty) ',round(np.mean([lev(x,c) for x,c in zip([x if x else "" for x in o],gt)]),2),'valid',round(vf,3),'mixed mean',round(Lm.mean(),2),'overall est',round(overall,3))
