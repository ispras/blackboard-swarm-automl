import sys, glob, argparse
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_epsilon/pylibs')
sys.path.insert(0,'/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from multiprocessing import Pool
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
def canon(s):
    try:
        mol=Chem.MolFromInchi(s,sanitize=False,removeHs=False,treatWarningAsError=False)
        if mol is None: return s
        o=Chem.MolToInchi(mol); return o if o else s
    except Exception: return s
def load_glob(pat,col):
    dfs=[pd.read_csv(f).fillna('') for f in sorted(glob.glob(pat))]
    if not dfs: return pd.DataFrame(columns=['image_id',col])
    return pd.concat(dfs,ignore_index=True).drop_duplicates('image_id')[['image_id','InChI']].rename(columns={'InChI':col})
ap=argparse.ArgumentParser()
ap.add_argument('--rigel',default='../rigel_mu/rigel_test_all.csv'); ap.add_argument('--ms',default='preds1m_inchi.csv')
ap.add_argument('--sample',default='../../data/sample_submission.csv'); ap.add_argument('--T',type=float,default=0.78)
ap.add_argument('--rot',default='preds_rigel_rot'); ap.add_argument('--tf',default='preds_tf'); ap.add_argument('--workers',type=int,default=40)
ap.add_argument('--out',default='submission_rule_d.csv')
args=ap.parse_args()
ms=pd.read_csv(args.ms).fillna(''); ms['valid']=ms.valid.astype(bool)
rig=pd.read_csv(args.rigel).fillna('')[['image_id','InChI']].drop_duplicates('image_id').rename(columns={'InChI':'r'})
rot=load_glob(f'{args.rot}/*_s*.csv','rr'); ud=load_glob(f'{args.tf}/t_flipud_s*.csv','ud'); lr=load_glob(f'{args.tf}/t_fliplr_s*.csv','lr')
m=ms[['image_id','inchi','valid','score']].merge(rig,on='image_id',how='left').merge(rot,on='image_id',how='left').merge(ud,on='image_id',how='left').merge(lr,on='image_id',how='left')
for c in ['r','rr','ud','lr']: m[c]=m[c].fillna('')
rv=m.r.map(valid); rrv=m.rr.map(valid); vud=m.ud.map(valid); vlr=m.lr.map(valid)
print('raw-valid',int(rv.sum()),'r180',int(((~rv)&rrv).sum()),'flipud',int(((~rv)&(~rrv)&vud).sum()),'fliplr',int(((~rv)&(~rrv)&(~vud)&vlr).sum()))
with Pool(args.workers) as p:
    m['cr']=p.map(canon,m.r.tolist(),chunksize=500); m['crr']=p.map(canon,m.rr.tolist(),chunksize=500)
    m['cud']=p.map(canon,m.ud.tolist(),chunksize=500); m['clr']=p.map(canon,m.lr.tolist(),chunksize=500)
req=m.valid & (m.score>=args.T)
m['final']=np.where(rv,m.cr,np.where(rrv,m.crr,np.where(vud,m.cud,np.where(vlr,m.clr,np.where(req,m.inchi,m.cr)))))
print('1m used',int(((~rv)&(~rrv)&(~vud)&(~vlr)&req).sum()),'raw fallback',int(((~rv)&(~rrv)&(~vud)&(~vlr)&(~req)).sum()))
s=pd.read_csv(args.sample,usecols=['image_id'])
o=s.merge(m[['image_id','final']].rename(columns={'final':'InChI'}),on='image_id',how='left')
o['InChI']=o.InChI.fillna('').astype(str)
o.to_csv(args.out,index=False)
print('wrote',args.out,len(o),'empty',(o.InChI=='').mean(),'starts',o.InChI.str.startswith('InChI=1S/').mean())
EOF
