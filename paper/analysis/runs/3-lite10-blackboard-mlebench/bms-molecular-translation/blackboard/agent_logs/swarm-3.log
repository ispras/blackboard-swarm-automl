def clahe(im):
    g=cv2.cvtColor(im,cv2.COLOR_RGB2GRAY); c=cv2.createCLAHE(clipLimit=2.0,tileGridSize=(8,8)).apply(g); return cv2.cvtColor(c,cv2.COLOR_GRAY2RGB)
variants={'base':lambda im:im,'otsu':otsu,'median':median,'up2':up2,'clahe':clahe}
model=MolScribe(args.ckpt, device=torch.device('cuda'), num_workers=1)
