d=pd.read_csv('/tmp/ev1m_conf.csv')
gt=d['InChI'].fillna('').tolist(); pr=d.pred.fillna('').tolist()
def layers(s):
    # InChI=1S/formula/c.../h.../t.../m.../s...
    body=s.split('/',1)[1] if '/' in s else s
    return body.split('/')
def formula(s):
    p=s.split('/'); return p[1] if len(p)>1 else ''
