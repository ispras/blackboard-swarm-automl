import sys, os, argparse
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_epsilon/pylibs')
sys.path.insert(0,'/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid_inchi(s):
    if not isinstance(s,str) or not s: return False
    try: return Chem.MolFromInchi(s) is not None
    except Exception: return False
ap=argparse.ArgumentParser()
ap.add_argument('--main',default='preds1m_inchi.csv')
ap.add_argument('--rescue',default='preds680_inchi.csv')
ap.add_argument('--sample',default='../../data/sample_submission.csv')
ap.add_argument('--rigel',default='')
ap.add_argument('--out',default='submission.csv')
args=ap.parse_args()
m=pd.read_csv(args.main).fillna('')
m['v1']=m.inchi.map(valid_inchi)
if os.path.exists(args.rescue):
    r=pd.read_csv(args.rescue).fillna('')
    r['v2']=r.inchi.map(valid_inchi)
    m=m.merge(r[['image_id','inchi','v2']].rename(columns={'inchi':'inchi2'}),on='image_id',how='left')
    m['v2']=m.v2.fillna(False)
else:
    m['inchi2']=''; m['v2']=False
use2=(~m.v1)&m.v2
m['final']=np.where(use2,m.inchi2,m.inchi)
if args.rigel and os.path.exists(args.rigel):
    g=pd.read_csv(args.rigel).fillna('')
    g['v3']=g.InChI.map(valid_inchi)
    m=m.merge(g[['image_id','InChI','v3']].rename(columns={'InChI':'inchi3'}),on='image_id',how='left')
    m['inchi3']=m.inchi3.fillna(''); m['v3']=m.v3.fillna(False)
    use3=(~m.v1)&(~m.v2)&m.v3
    m['final']=np.where(use3,m.inchi3,m.final)
    print('rigel filled',use3.sum())
print('1m valid',m.v1.mean(),'rescue used',use2.sum(),'final empty',(m.final=='').mean())
s=pd.read_csv(args.sample,usecols=['image_id'])
out=s.merge(m[['image_id','final']].rename(columns={'final':'InChI'}),on='image_id',how='left')
out['InChI']=out['InChI'].fillna('').astype(str)
out.to_csv(args.out,index=False)
print('wrote',args.out,len(out),'empty frac',(out.InChI=='').mean(),'coverage',out.image_id.isin(m.image_id).mean())
EOF
