import sys; sys.path.insert(0,'/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from multiprocessing import Pool
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
from postproc import lev
def canon(s):
    try:
        mol=Chem.MolFromInchi(s,sanitize=False,removeHs=False,treatWarningAsError=False)
        if mol is None: return s
        o=Chem.MolToInchi(mol); return o if o else s
    except Exception: return s
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
m=pd.read_csv('holdout_4k_paired.csv').fillna('')
tta=pd.read_csv('/tmp/rigel_tta_inv.csv').fillna('')
m=m.merge(tta[['image_id','r2']],on='image_id',how='left'); m['r2']=m.r2.fillna('')
# augmented rigel: if raw invalid and r2 valid -> r2 else raw
raw_valid=m.rig.map(valid); r2_valid=m.r2.map(valid)
m['rig_aug']=np.where((~raw_valid)&r2_valid, m.r2, m.rig)
with Pool(48) as p: m['rc_aug']=p.map(canon,m.rig_aug.tolist(),chunksize=100)
gt=m['InChI'].tolist()
def sc(x): return round(float(np.mean([lev(u,v) for u,v in zip(x,gt)])),3)
print('raw rigel',sc(m.rig.tolist()))
print('canon raw',round(np.mean([lev(u,v) for u,v in zip(m.rc.values,gt)]),3) if 'rc' in m else 'n/a')
m['rc_raw']=[canon(s) for s in m.rig]
print('canon raw',sc(m.rc_raw.tolist()))
print('canon aug',sc(m.rc_aug.tolist()))
m['v1']=m.pred.map(valid); T=0.85
req=(m.v1&(m.score>=T)).values
