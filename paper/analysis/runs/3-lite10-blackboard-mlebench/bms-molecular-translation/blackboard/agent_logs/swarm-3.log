ap.add_argument('--ms',default='preds1m_inchi.csv'); ap.add_argument('--sample',default='../../data/sample_submission.csv')
ap.add_argument('--T',type=float,default=0.78); ap.add_argument('--workers',type=int,default=40); ap.add_argument('--out',default='submission_rule_c.csv')
args=ap.parse_args()
