m[['image_id','inchi','v1','i2','v2','i3','v3','best']].to_csv(args.out,index=False)
print('v1',m.v1.mean(),'v2 added',((~m.v1)&m.v2).mean(),'v3 added',((~m.v1)&(~m.v2)&m.v3).mean(),'best valid',m.best.map(valid).mean())
