print('n',len(m),'rigel',sc(m.r.tolist()),'rescued',int(((~rv)&rrv).sum()))
for T in [0.85,0.875]:
    req=(m.v1&(m.s1>=T)).values
    out=np.where(req,m.i1.values,m.augc.values)
    print(f'T={T} rule_r2={sc(out.tolist())} use1m={int(req.sum())}')
# also plain (no r2)
with Pool(48) as p: m['rc']=p.map(canon,m.r.tolist(),chunksize=200)
req=(m.v1&(m.s1>=0.85)).values
