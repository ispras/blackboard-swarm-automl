import torch, pandas as pd, numpy as np, cv2
from molscribe import MolScribe
from postproc import smi_to_inchi_fallback, lev
ap=argparse.ArgumentParser()
ap.add_argument('--ids', default='../../analysis/holdout_20k.csv')
ap.add_argument('--imgroot', default='../../data/train')
ap.add_argument('--ckpt', default='weights/swin_base_char_aux_1m.pth')
ap.add_argument('--n', type=int, default=512)
ap.add_argument('--bs', type=int, default=64)
ap.add_argument('--out', default='/tmp/evalf.csv')
args=ap.parse_args()
def path(root,i): return f"{root}/{i[0]}/{i[1]}/{i[2]}/{i}.png"
model=MolScribe(args.ckpt, device=torch.device('cuda'), num_workers=1)
df=pd.read_csv(args.ids).iloc[:args.n].reset_index(drop=True)
ids=df.image_id.tolist(); rows=[]; t0=time.time()
for k in range(0,len(ids),args.bs):
    chunk=ids[k:k+args.bs]; imgs=[]; ok=[]
    for i in chunk:
        im=cv2.imread(path(args.imgroot,i))
        if im is None: continue
        imgs.append(cv2.cvtColor(im,cv2.COLOR_BGR2RGB)); ok.append(i)
    if not imgs: continue
    ims=[model.transform(image=im,keypoints=[])['image'] for im in imgs]
    x=torch.stack(ims).cuda()
    with torch.no_grad():
        feats,hid=model.encoder(x); preds=model.decoder.decode(feats,hid)
    rows += [(i,p['chartok_coords']['smiles']) for i,p in zip(ok,preds)]
el=time.time()-t0
raw=pd.DataFrame(rows,columns=['image_id','smiles'])
df=df.merge(raw,on='image_id',how='left')
df['pred']=[smi_to_inchi_fallback(s) for s in df.smiles]
df['lev']=[lev(a,b) for a,b in zip(df.pred,df['InChI'])]
print('ckpt',os.path.basename(args.ckpt),'n',len(df),'time',round(el,1),'speed',round(len(df)/el,2),'img/s')
print('mean_lev',round(df.lev.mean(),3),'median',np.median(df.lev),'exact',round((df.lev==0).mean(),4),'empty',round((df.pred=='').mean(),4))
df.to_csv(args.out,index=False)
