    g=cv2.cvtColor(im,cv2.COLOR_RGB2GRAY); _,b=cv2.threshold(g,0,255,cv2.THRESH_BINARY+cv2.THRESH_OTSU); return cv2.cvtColor(b,cv2.COLOR_GRAY2RGB)
def median(im): return cv2.medianBlur(im,3)
def up2(im): 
