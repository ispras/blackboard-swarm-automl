rig=pd.read_csv(args.rigel).fillna('')[['image_id','InChI']].drop_duplicates('image_id').rename(columns={'InChI':'r'})
dfs=[pd.read_csv(f).fillna('').rename(columns={'InChI':'rr'}) for f in sorted(glob.glob(f'{args.rot}/*_s*.csv'))]
