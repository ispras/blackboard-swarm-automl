import sys, re; sys.path.insert(0,'/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from rdkit import Chem
from rdkit.Chem.MolStandardize import rdMolStandardize
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
d=pd.read_csv('val_variants_256.csv')
valid=set()
for z in range(1,119):
    s=Chem.GetPeriodicTable().GetElementSymbol(z); valid.add(s)
valid |= {'D','T'}
bracket=re.compile(r'\[([^\]]*)\]')
def elem_of(inner):
    m=re.match(r'\d*([A-Z][a-z]?|[a-z])', inner)
    return m.group(1) if m else ''
def sanitize(smi):
    if not isinstance(smi,str) or not smi: return ''
    smi=smi.replace('*','C')
    def rep(m):
        e=elem_of(m.group(1))
        return m.group(0) if e in valid else 'C'
    smi=bracket.sub(rep,smi)
    # remove empty fragments [,] -> C
    smi=re.sub(r'\[,\]','C',smi)
    return smi
def largest(smi):
    parts=[p for p in smi.split('.') if p and p not in ('[.]','*','[H]')]
    if not parts: return ''
    best='';bn=-1
    for p in parts:
        try:
            m=Chem.MolFromSmiles(p,sanitize=False)
            if m is None: continue
            n=m.GetNumAtoms()
        except Exception: continue
        if n>bn: bn=n;best=p
    return best
def to_inchi(smi, do_san=True, do_frag=True):
    if not isinstance(smi,str) or not smi or smi=='<invalid>': return ''
    if do_san: smi=sanitize(smi)
    if do_frag: smi=largest(smi)
    if not smi: return ''
    try:
        m=Chem.MolFromSmiles(smi,sanitize=False)
        if m is None: return ''
        try: Chem.SanitizeMol(m)
        except: pass
        return Chem.MolToInchi(m)
    except Exception: return ''
def lev(a,b):
    if len(a)<len(b): a,b=b,a
    prev=list(range(len(b)+1))
    for i,ca in enumerate(a,1):
        cur=[i]
        for j,cb in enumerate(b,1): cur.append(min(prev[j]+1,cur[j-1]+1,prev[j-1]+(ca!=cb)))
        prev=cur
    return prev[-1]
gt=d.gt.tolist()
for name,kw in [('raw_frag',dict(do_san=False)),('sanitize',dict(do_san=True,do_frag=False)),('sanitize_frag',dict(do_san=True,do_frag=True))]:
    p=[to_inchi(s,**kw) for s in d.raw]
    L=np.array([lev(a,b) for a,b in zip(p,gt)])
    print(name,'mean',round(L.mean(),2),'exact',round((L==0).mean(),3),'empty',round(np.mean([x=='' for x in p]),3))
    if name=='sanitize_frag': d['san_inchi']=p; d['san_lev']=L
# formula-only fallback: for empty sanitize_frag, output 'InChI=1S/'+formula from parsed smiles
def formula(smi):
    if not isinstance(smi,str) or not smi: return ''
    smi=sanitize(smi); smi=largest(smi)
    if not smi: return ''
    m=Chem.MolFromSmiles(smi,sanitize=False)
    if m is None: return ''
    try: Chem.SanitizeMol(m)
    except: pass
    from rdkit.Chem.rdMolDescriptors import CalcMolFormula
    try: return CalcMolFormula(m)
    except: return ''
fb=[]
for s,pi in zip(d.raw,d.san_inchi):
    if pi=='': 
        f=formula(s); fb.append('InChI=1S/'+f if f else '')
    else: fb.append(pi)
L=np.array([lev(a,b) for a,b in zip(fb,gt)])
print('sanitize_frag+formula_fallback','mean',round(L.mean(),2),'exact',round((L==0).mean(),3),'empty',round(np.mean([x=='' for x in fb]),3))
d['fb_inchi']=fb; d['fb_lev']=L
d.to_csv('val_postproc_256.csv',index=False)
