import sys, glob, argparse
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_epsilon/pylibs')
sys.path.insert(0,'/usr/local/lib/python3.11/site-packages')
import pandas as pd, numpy as np
from multiprocessing import Pool
from postproc import smi_to_inchi_fallback
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
ap=argparse.ArgumentParser()
ap.add_argument('--dir',default='preds_tta')
ap.add_argument('--gate',default='submission_gate.csv')
ap.add_argument('--out',default='submission_gate_tta.csv')
ap.add_argument('--order',default='1m_r90,680_r180')
ap.add_argument('--workers',type=int,default=40)
args=ap.parse_args()
files=sorted(glob.glob(f'{args.dir}/*_s*.csv'))
print(files)
dfs=[]
for f in files:
    d=pd.read_csv(f); key=f.split('/')[-1].rsplit('_s',1)[0]; d['cfg']=key; dfs.append(d[['image_id','smiles','score','cfg']])
d=pd.concat(dfs,ignore_index=True)
with Pool(args.workers) as p: inch=p.map(smi_to_inchi_fallback,d.smiles.tolist(),chunksize=500)
d['inchi']=[x if isinstance(x,str) else '' for x in inch]
d['valid']=[valid(x) for x in d.inchi]
print(d.groupby('cfg').valid.mean())
sub=pd.read_csv(args.gate).fillna('')
idx={i:n for n,i in enumerate(sub.image_id)}
chosen={}
order=args.order.split(',')
for cfg in order:
    dd=d[(d.cfg==cfg)&(d.valid)]
    for i,inc in zip(dd.image_id,dd.inchi):
        if i not in chosen: chosen[i]=inc
filled=0
for i,inc in chosen.items():
    if i in idx: sub.at[idx[i],'InChI']=inc; filled+=1
print('tta filled',filled,'of',len(chosen))
sub.to_csv(args.out,index=False)
print('wrote',args.out,'empty frac',(sub.InChI=='').mean())
EOF
