best={}
for i,x in cols: best.setdefault(i,[]).append(x)
# pick shortest valid? first
out=[]
for i in range(len(df)):
    if i in best: out.append(best[i][0])
    else: out.append('')
print('any-valid frac',len(best)/len(df),'mean lev of first-valid',np.mean([lev(out[i] or df.InChI[i],df.InChI[i]) for i in range(len(df))]))
# baseline: 1m formula fallback (current gate) from ev1m pred_1
a=pd.read_csv('/tmp/ev1m_conf.csv').fillna(''); mm=df[['image_id']].merge(a[['image_id','pred']],on='image_id',how='left')
base=mm.pred.fillna('').tolist()
print('current gate baseline on these rows meanlev',np.mean([lev(x,g) for x,g in zip(base,gt)]))
pd.DataFrame({'image_id':df.image_id,'gt':gt,'base':base}).to_csv('/tmp/tta_both_base.csv',index=False)
