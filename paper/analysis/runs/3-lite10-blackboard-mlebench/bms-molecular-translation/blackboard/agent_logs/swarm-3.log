# tta
files=sorted(glob.glob('preds_tta/1m_r*.csv')); dfs=[]
for f in files:
    d=pd.read_csv(f); k=f.split('/')[-1].rsplit('.csv',1)[0]; d['cfg']=k; dfs.append(d[['image_id','smiles','score','cfg']])
t=pd.concat(dfs,ignore_index=True)
with Pool(args.workers) as p: inc=p.map(smi_to_inchi_fallback,t.smiles.tolist(),chunksize=500)
t['inchi']=[x if isinstance(x,str) else '' for x in inc]; t['v3']=[valid(x) for x in t.inchi]
