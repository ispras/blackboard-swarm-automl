def smi_to_inchi(smi):
    if not smi: return ''
    try:
        mol = Chem.MolFromSmiles(smi)
        if mol is None: return ''
        return Chem.MolToInchi(mol)
    except Exception:
        return ''

def lev(a,b):
    if len(a)<len(b): a,b=b,a
    prev=list(range(len(b)+1))
    for i,ca in enumerate(a,1):
        cur=[i]
        for j,cb in enumerate(b,1):
            cur.append(min(prev[j]+1, cur[j-1]+1, prev[j-1]+(ca!=cb)))
        prev=cur
    return prev[-1]

def path(i): return f"../../data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png"

ap=argparse.ArgumentParser()
ap.add_argument('--n', type=int, default=256)
ap.add_argument('--offset', type=int, default=0)
ap.add_argument('--bs', type=int, default=32)
ap.add_argument('--ckpt', default='weights/swin_base_char_aux_1m.pth')
ap.add_argument('--out', default='val_eval.csv')
args=ap.parse_args()

dev=torch.device('cuda')
model=MolScribe(args.ckpt, device=dev, num_workers=1)
df=pd.read_csv('../../data/train_labels.csv', nrows=args.offset+args.n).iloc[args.offset:]
imgs=[cv2.cvtColor(cv2.imread(path(i)),cv2.COLOR_BGR2RGB) for i in df.image_id]
t=time.time()
preds=[]
for k in range(0,len(imgs),args.bs):
    out=model.predict_images(imgs[k:k+args.bs], batch_size=args.bs)
    preds += [o['smiles'] for o in out]
el=time.time()-t
print(f'images={len(imgs)} time={el:.1f}s speed={len(imgs)/el:.2f} img/s')
inchi=[smi_to_inchi(s) for s in preds]
ds=np.array([lev(a,b) for a,b in zip(inchi,df.InChI)])
print(f'mean_lev={ds.mean():.3f} median={np.median(ds):.1f} exact={np.mean(ds==0):.3f} empty={np.mean([x=="" for x in inchi]):.3f}')
out=df[['image_id','InChI']].copy(); out['smiles']=preds; out['pred']=inchi; out['lev']=ds
out.to_csv(args.out,index=False)
