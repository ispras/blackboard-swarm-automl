import torch, pandas as pd, numpy as np, cv2
from molscribe import MolScribe
from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def largest_frag_smiles(smi):
    parts=[p for p in smi.split('.') if p and p not in ('[.]','*','[H]')]
    if not parts: return ''
    best=None;bn=-1
    for p in parts:
        try:
            m=Chem.MolFromSmiles(p)
            if m is None: continue
            n=m.GetNumAtoms()
        except Exception: continue
        if n>bn: bn=n;best=p
    return best or ''
def to_inchi(smi, frag=False, sub=False):
    if not smi or smi=='<invalid>': return ''
    if frag: smi=largest_frag_smiles(smi)
    if not smi: return ''
    if sub: smi=smi.replace('*','C')
    try:
        m=Chem.MolFromSmiles(smi)
        if m is None: return ''
        return Chem.MolToInchi(m)
    except Exception: return ''
def lev(a,b):
    if len(a)<len(b): a,b=b,a
    prev=list(range(len(b)+1))
    for i,ca in enumerate(a,1):
        cur=[i]
        for j,cb in enumerate(b,1): cur.append(min(prev[j]+1,cur[j-1]+1,prev[j-1]+(ca!=cb)))
        prev=cur
    return prev[-1]
def path(i): return f"../../data/train/{i[0]}/{i[1]}/{i[2]}/{i}.png"
model=MolScribe('weights/swin_base_char_aux_1m.pth', device=torch.device('cuda'), num_workers=1)
df=pd.read_csv('../../data/train_labels.csv', nrows=256)
imgs=[cv2.cvtColor(cv2.imread(path(i)),cv2.COLOR_BGR2RGB) for i in df.image_id]
raw=[]
for k in range(0,len(imgs),64):
    ims=[model.transform(image=im,keypoints=[])['image'] for im in imgs[k:k+64]]
    x=torch.stack(ims).cuda()
    with torch.no_grad():
        feats,hid=model.encoder(x); preds=model.decoder.decode(feats,hid)
    raw += [p['chartok_coords']['smiles'] for p in preds]
utils=pd.read_csv('val_eval_256.csv')  # has converted smiles? no, has pred inchi
