ms=pd.read_csv(args.ms).fillna('')
ms['valid']=ms.valid.astype(bool)
rig=pd.read_csv(args.rigel).fillna(''); col='InChI' if 'InChI' in rig.columns else 'inchi'
rig=rig[['image_id',col]].rename(columns={col:'r'}).drop_duplicates('image_id')
print('rigel rows',len(rig))
with Pool(args.workers) as p: rig['rc']=p.map(canon,rig.r.tolist(),chunksize=500)
print('canonicalized; changed',(rig.r!=rig.rc).sum())
m=ms[['image_id','inchi','valid','score']].merge(rig[['image_id','r','rc']],on='image_id',how='left')
m['r']=m.r.fillna('').astype(str); m['rc']=m.rc.fillna('').astype(str)
use1m=m.valid & (m.score>=args.T)
out=np.where(use1m, m.inchi.values, np.where(m.rc!='', m.rc.values, m.inchi.values))
print('use1m',int(use1m.sum()),'rigel used',int((~use1m & (m.rc!='')).sum()),'1m fallback',int((~use1m & (m.rc=='')).sum()))
s=pd.read_csv(args.sample,usecols=['image_id'])
o=s.merge(pd.DataFrame({'image_id':m.image_id.values,'InChI':out}),on='image_id',how='left')
o['InChI']=o.InChI.fillna('').astype(str)
o.to_csv(args.out,index=False)
print('wrote',args.out,len(o),'empty',(o.InChI=='').mean(),'starts',o.InChI.str.startswith('InChI=1S/').mean())
EOF
