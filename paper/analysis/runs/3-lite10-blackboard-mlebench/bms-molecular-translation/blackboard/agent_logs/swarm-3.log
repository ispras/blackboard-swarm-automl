from rdkit import Chem
from rdkit import RDLogger; RDLogger.DisableLog('rdApp.*')
def valid(s):
    try: return isinstance(s,str) and s!='' and Chem.MolFromInchi(s) is not None
    except: return False
def canon(s):
    try:
        mol=Chem.MolFromInchi(s,sanitize=False,removeHs=False,treatWarningAsError=False)
        if mol is None: return s
        o=Chem.MolToInchi(mol); return o if o else s
    except Exception: return s
ap=argparse.ArgumentParser()
ap.add_argument('--rigel',default='../rigel_mu/rigel_test_all.csv'); ap.add_argument('--rot',default='preds_rigel_rot')
ap.add_argument('--ms',default='preds1m_inchi.csv'); ap.add_argument('--sample',default='../../data/sample_submission.csv')
ap.add_argument('--T',type=float,default=0.85); ap.add_argument('--workers',type=int,default=40); ap.add_argument('--out',default='submission_r2_rule.csv')
args=ap.parse_args()
ms=pd.read_csv(args.ms).fillna(''); ms['valid']=ms.valid.astype(bool)
rig=pd.read_csv(args.rigel).fillna(''); rig=rig[['image_id','InChI']].drop_duplicates('image_id')
dfs=[]
for f in sorted(glob.glob(f'{args.rot}/*_s*.csv')):
    dfs.append(pd.read_csv(f).fillna(''))
rot=pd.concat(dfs,ignore_index=True).drop_duplicates('image_id') if dfs else pd.DataFrame(columns=['image_id','InChI'])
print('rigel',len(rig),'rot rows',len(rot))
m=ms[['image_id','inchi','valid','score']].merge(rig,on='image_id',how='left').rename(columns={'InChI':'r'})
m=m.merge(rot.rename(columns={'InChI':'rr'}),on='image_id',how='left')
m['r']=m.r.fillna(''); m['rr']=m.rr.fillna('')
rv=m.r.map(valid); rrv=m.rr.map(valid)
m['aug']=np.where((~rv)&rrv, m.rr, m.r)
print('raw valid',rv.mean(),'rot valid',rrv.mean(),'rescued',int(((~rv)&rrv).sum()))
with Pool(args.workers) as p: m['augc']=p.map(canon,m.aug.tolist(),chunksize=500)
use1m=m.valid & (m.score>=args.T)
out=np.where(use1m, m.inchi.values, m.augc.values)
print('use1m',int(use1m.sum()))
s=pd.read_csv(args.sample,usecols=['image_id'])
o=s.merge(pd.DataFrame({'image_id':m.image_id.values,'InChI':out}),on='image_id',how='left')
o['InChI']=o.InChI.fillna('').astype(str)
o.to_csv(args.out,index=False)
print('wrote',args.out,len(o),'empty',(o.InChI=='').mean(),'starts',o.InChI.str.startswith('InChI=1S/').mean())
EOF
