print('formula match frac',fm.mean(),'lev|formula_match',L[fm].mean(),'lev|formula_diff',L[~fm].mean())
# strip stereo layers from prediction
def strip_stereo(s):
    if not s: return s
    parts=s.split('/')
    keep=[]
    for i,p in enumerate(parts):
        if i<2 or p[:1] not in ('t','m','s'): keep.append(p)
    return '/'.join(keep)
def strip_h(s):
    if not s: return s
    parts=s.split('/'); return '/'.join(p for i,p in enumerate(parts) if i<2 or p[:1]!='h')
for name,fn in [('strip_stereo',strip_stereo),('strip_h',strip_h)]:
    q=[fn(x) for x in pr]
    L2=np.array([lev(a,b) for a,b in zip(q,gt)])
