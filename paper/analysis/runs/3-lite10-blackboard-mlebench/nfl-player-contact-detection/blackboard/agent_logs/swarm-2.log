        es_gps=set(rng.choice(tr_gps,max(1,int(len(tr_gps)*es_frac)),replace=False))
        es_mask=np.isin(groups[tri_all],list(es_gps))
        es_idx=tri_all[es_mask]; fit_pool=tri_all[~es_mask]
        neg=fit_pool[y[fit_pool]==0]; pos=fit_pool[y[fit_pool]==1]
        if neg_frac<1.0:
            tri=np.sort(np.concatenate([pos,rng.choice(neg,int(len(neg)*neg_frac),replace=False)]))
        else: tri=fit_pool
        dtr=lgb.Dataset(X.iloc[tri],label=y[tri],free_raw_data=True)
        dva=lgb.Dataset(X.iloc[es_idx],label=y[es_idx],reference=dtr,free_raw_data=True)""",
