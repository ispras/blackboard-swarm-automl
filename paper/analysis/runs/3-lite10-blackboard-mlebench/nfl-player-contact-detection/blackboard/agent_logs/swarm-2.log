del dtr,dva,m; gc.collect()

# ---- evaluation helpers ----
def smooth(pred, gp, p1, p2, step, w):
    if w<=0: return pred
    d=pd.DataFrame({'p':pred,'gp':gp,'p1':p1,'p2':p2,'s':step})
    d=d.sort_values(['gp','p1','p2','s'])
    g=d.groupby(['gp','p1','p2'],sort=False,observed=True)['p']
    r=g.rolling(w,center=True,min_periods=1).mean()
    r.index=r.index.droplevel([0,1,2])
    return r.reindex(d.index).sort_index().values

def best_mcc(y,p,ths=None):
    if ths is None: ths=np.quantile(p,np.linspace(0.5,0.9995,300))
    order=np.argsort(-p); ps=p[order]; ys=y[order]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64)
    P=int(ys.sum()); N=len(ys)-P
    idx=np.searchsorted(-ps,-ths,side='left')  # number predicted positive
    idx=np.clip(idx,0,len(ys))
    tp=np.where(idx>0,cp[idx-1],0.0); fp=np.where(idx>0,cn[idx-1],0.0)
    fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den
    k=int(np.argmax(mcc))
    return float(mcc[k]),float(ths[k])

ig=df['is_ground'].values==1
base=np.where(ig, df['p_gr'].values, df['p_pp'].values).astype(np.float64)
base=np.nan_to_num(base,nan=0.0)
for name,prob in [('base',base),('stack',oof)]:
    res={}
    for task,mask in [('pp',~ig),('ground',ig)]:
        best=(-1,None,None)
        for w in [0,1,3,5]:
            p=smooth(prob[mask],df.gp.values[mask],df.p1.values[mask],df.p2.values[mask],df.step.values[mask],w)
            mcc,th=best_mcc(df.contact.values[mask],p)
            if mcc>best[0]: best=(mcc,th,w)
        res[task]=best; log(name,task,'mcc',round(best[0],5),'th',round(best[1],5),'w',best[2])
    # global with independent thresholds
    ypp=df.contact.values[~ig]; yg=df.contact.values[ig]
    mpp,thpp,wpp=res['pp']; mg,thg,wg=res['ground']
    ppp=smooth(prob[~ig],df.gp.values[~ig],df.p1.values[~ig],df.p2.values[~ig],df.step.values[~ig],wpp)
    pg=smooth(prob[ig],df.gp.values[ig],df.p1.values[ig],df.p2.values[ig],df.step.values[ig],wg)
    pred=np.concatenate([ppp>thpp,pg>thg]); y=np.concatenate([ypp,yg])
    g=matthews_corrcoef(y,pred); log(name,'GLOBAL',round(g,5))
    res['global']=(g,thpp,thg,wpp,wg)

df['stack_oof']=oof
df[['contact_id','stack_oof','fold','contact','is_ground']].to_parquet(f'{W}/oof_stack.parquet',index=False)
json.dump({'base':base_res,'stack':stack_res},open(f'{W}/stack_metrics.json','w'),indent=1,default=float)
log('done')
