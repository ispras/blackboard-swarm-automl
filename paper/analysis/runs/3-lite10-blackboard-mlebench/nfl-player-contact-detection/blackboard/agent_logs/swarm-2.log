p='workspaces/capella_pi/stack.py'
s=open(p).read()
s=s.replace("""def best_mcc(y,p):
    ths=np.unique(np.quantile(p,np.linspace(0.5,0.9995,400)))
    bm=-1; bt=0.5
    for th in ths:
        m=matthews_corrcoef(y,p>th)
        if m>bm: bm,bt=m,th
    return bm,bt""",
"""def best_mcc(y,p,ths=None):
    if ths is None: ths=np.quantile(p,np.linspace(0.5,0.9995,300))
    order=np.argsort(-p); ps=p[order]; ys=y[order]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64)
    P=int(ys.sum()); N=len(ys)-P
    idx=np.searchsorted(-ps,-ths,side='left')  # number predicted positive
    idx=np.clip(idx,0,len(ys))
    tp=np.where(idx>0,cp[idx-1],0.0); fp=np.where(idx>0,cn[idx-1],0.0)
    fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den
    k=int(np.argmax(mcc))
    return float(mcc[k]),float(ths[k])""")
open(p,'w').write(s); print('ok')
EOF
