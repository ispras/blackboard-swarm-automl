import pandas as pd, numpy as np
from sklearn.metrics import matthews_corrcoef, roc_auc_score
o=pd.read_parquet('workspaces/capella_pi/oof_stack_v2.parquet')
print(o.shape, o.is_ground.mean())
g=o[o.is_ground==1]
print('ground stack mcc raw @0.344', matthews_corrcoef(g.contact,g.stack_oof>0.34419))
# fast sweep verify
def best_mcc(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9995,300)); order=np.argsort(-p); ps=p[order]; ys=np.asarray(y)[order]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64)
    Pos=int(ys.sum()); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(mcc[k]),float(ths[k])
print('fast',best_mcc(g.contact.values,g.stack_oof.values))
# sklearn check around
y=g.contact.values; p=g.stack_oof.values
bs=(-1,0)
for th in np.quantile(p,np.linspace(.5,.9995,300)):
    v=matthews_corrcoef(y,p>th)
    if v>bs[0]: bs=(v,th)
print('sklearn',bs)
# simple blend ground gcnn+gb smoothed
def smooth(df,w):
    d=df[['gp','p1','p2','step','p']].copy(); d['p1']=d.p1.astype(str)
    d=d.sort_values(['gp','p1','p2','step'])
    r=d.groupby(['gp','p1','p2'])['p'].rolling(w,center=True,min_periods=1).mean()
    r.index=r.index.droplevel([0,1,2]); return r.reindex(d.index).sort_index().values
# parse ids
lab=pd.read_csv('data/train_labels.csv',usecols=['contact_id','game_play','step','nfl_player_id_1','contact'])
lab=lab[lab.contact_id.str.endswith('_G')]
def load(name,path,col='pred'):
    d=pd.read_parquet(path)[['contact_id',col]].rename(columns={col:name}); return d
gcnn=load('gcnn','workspaces/alkaid_psi/oof_ground_cnn_v1m.parquet')
cg=load('cg','workspaces/canopus_pi/preds/oof_ground_v3.parquet')
m=lab.merge(gcnn,on='contact_id').merge(cg,on='contact_id')
sp=m.contact_id.str.split('_'); m['gp']=sp.str[0]+'_'+sp.str[1]; m['p1']=sp.str[3].astype(int); m['p2']='G'; m['step']=sp.str[2].astype(int)
for a in [0.3,0.5,0.7]:
    m['p']=a*m.gcnn.rank(pct=True)+(1-a)*m.cg.rank(pct=True)
    for w in [0,5,7]:
        p=smooth(m,w); print('blend a',a,'w',w,best_mcc(m.contact.values,p))
