import pandas as pd, numpy as np
from sklearn.metrics import matthews_corrcoef
def best_mcc(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9995,300)); order=np.argsort(-p); ps=p[order]; ys=np.asarray(y)[order]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64)
    Pos=int(ys.sum()); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(mcc[k]),float(ths[k])
def logit(p,e=1e-6): p=np.clip(p,e,1-e); return np.log(p/(1-p))
def sv(df,col,w):
    if w<=0: return df[col].values
    d=pd.DataFrame({'p':df[col].values,'gp':df.gp.values,'p1':df.p1.values,'p2':df.p2.values,'s':df.step.values})
    d=d.sort_values(['gp','p1','p2','s']); g=d.groupby(['gp','p1','p2'],sort=False)['p']
    r=g.rolling(w,center=True,min_periods=1).mean(); r.index=r.index.droplevel([0,1,2])
    return r.reindex(d.index).sort_index().values
def ev(df,col,label):
    ig=df.is_ground.values==1; res={}
    for task,mask in [('pp',~ig),('ground',ig)]:
        best=(-1,0.5,0)
        for w in [0,1,3,5,7,9]:
            p=sv(df[mask],col,w); mcc,th=best_mcc(df.contact.values[mask],p)
            if mcc>best[0]: best=(mcc,th,w)
        res[task]=best
    mpp,thpp,wpp=res['pp']; mg,thg,wg=res['ground']
    ppp=sv(df[~ig],col,wpp); pg=sv(df[ig],col,wg)
    pred=np.concatenate([ppp>thpp,pg>thg]); y=np.concatenate([df.contact.values[~ig],df.contact.values[ig]])
    g=matthews_corrcoef(y,pred); print(f'{label:30s} pp {res["pp"][0]:.5f}(w{wpp}) gr {res["ground"][0]:.5f}(w{wg}) GLOBAL {g:.5f}'); return g
df=None
for tag in ['v4','v5','v7']:
    d=pd.read_parquet(f'workspaces/capella_pi/oof_stack_{tag}.parquet')[['contact_id','stack_oof']].rename(columns={'stack_oof':tag})
    df=d if df is None else df.merge(d,on='contact_id')
en=pd.read_parquet('workspaces/canopus_pi/preds/ens_oof_probs_v4.parquet')[['contact_id','p_pp','p_gr']]
df=df.merge(en,on='contact_id').merge(pd.read_csv('data/train_labels.csv',usecols=['contact_id','contact']),on='contact_id')
sp=df.contact_id.str.split('_'); df['gp']=sp.str[0]+'_'+sp.str[1]; df['step']=sp.str[2].astype(int); df['p1']=sp.str[3]; df['p2']=sp.str[4]
df['is_ground']=df.contact_id.str.endswith('_G'); df['ens']=np.where(df.is_ground.values,df.p_gr.values,df.p_pp.values)
L=lambda c: logit(df[c].values)
for lbl,w in [('v4',(1,0,0,0)),('v4+v5+ens (434)',(.4,.3,0,.3)),('v4+v7+ens (434)',(.4,0,.3,.3)),
              ('v4+v5+v7+ens (3/2/2/3)',(.3,.2,.2,.3)),('v4+v5+v7+ens (35/2/1/35)',(.35,.2,.1,.35)),
              ('v4+v5+v7+ens (3/25/15/3)',(.3,.25,.15,.3)),('v4+v5+v7+ens (25/25/25/25)',(.25,.25,.25,.25))]:
    df['mix']=w[0]*L('v4')+w[1]*L('v5')+w[2]*L('v7')+w[3]*L('ens'); ev(df,'mix',lbl)
EOF
