for vf in glob.glob(f"{OUT}/validx_f*_{TAG}.npy"):
    f = int(vf.split("_f")[1].split("_")[0])
    idx = np.load(vf)
    p = np.load(f"{OUT}/valpred_f{f}_{TAG}.npy")
    pred[idx] = p
print("candidate coverage", np.isfinite(pred).mean(), "n", len(pred))
