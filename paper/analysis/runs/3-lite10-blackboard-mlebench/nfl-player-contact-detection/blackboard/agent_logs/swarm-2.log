import pandas as pd, numpy as np
from sklearn.metrics import matthews_corrcoef
def best_mcc(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9995,300)); order=np.argsort(-p); ps=p[order]; ys=np.asarray(y)[order]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64)
    Pos=int(ys.sum()); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(mcc[k]),float(ths[k])
def smooth(df,col,w):
    if w<=0: return df[col].values
    d=pd.DataFrame({'gp':df.gp.values,'p1':df.p1.values,'p2':df.p2.values,'s':df.step.values,'p':df[col].values})
    d=d.sort_values(['gp','p1','p2','s']); g=d.groupby(['gp','p1','p2'],sort=False)['p']
    r=g.rolling(w,center=True,min_periods=1).mean(); r.index=r.index.droplevel([0,1,2])
    return r.reindex(d.index).sort_index().values
def logit(p,e=1e-6): p=np.clip(p,e,1-e); return np.log(p/(1-p))
stack=pd.read_parquet('workspaces/capella_pi/oof_stack_v3.parquet')
ens=pd.read_parquet('workspaces/canopus_pi/preds/ens_oof_probs_v3.parquet')[['contact_id','p_pp','p_gr','is_ground']].rename(columns={'p_pp':'ens_pp','p_gr':'ens_gr'})
df=stack.merge(ens[['contact_id','ens_pp','ens_gr']],on='contact_id',how='left')
sp=df.contact_id.str.split('_'); df['gp']=sp.str[0]+'_'+sp.str[1]; df['step']=sp.str[2].astype(int); df['p1']=sp.str[3]; df['p2']=sp.str[4]
ig=df.is_ground.values==1
df['ens']=np.where(ig,df.ens_gr.values,df.ens_pp.values)
def evaluate(col,label):
    res={}
    for task,mask in [('pp',~ig),('ground',ig)]:
        best=(-1,0.5,0)
        for w in [0,1,3,5,7,9]:
            p=smooth(df[mask].assign(x=df[mask][col]),'x',w)
            mcc,th=best_mcc(df.contact.values[mask],p)
            if mcc>best[0]: best=(mcc,th,w)
        res[task]=best
    mpp,thpp,wpp=res['pp']; mg,thg,wg=res['ground']
    ppp=smooth(df[~ig].assign(x=df[~ig][col]),'x',wpp); pg=smooth(df[ig].assign(x=df[ig][col]),'x',wg)
    pred=np.concatenate([ppp>thpp,pg>thg]); y=np.concatenate([df.contact.values[~ig],df.contact.values[ig]])
    g=matthews_corrcoef(y,pred)
    print(label,'pp',round(res['pp'][0],5),'w',wpp,'gr',round(res['ground'][0],5),'w',wg,'GLOBAL',round(g,5))
    return g
for ws in [0.5,0.6,0.7,0.8,0.9,1.0]:
    df['mix']=(ws*logit(df.stack_oof.values)+(1-ws)*logit(df.ens.values))
    evaluate('mix',f'stack{ws}/ens{round(1-ws,1)}')
evaluate('stack_oof','stack_v3')
evaluate('ens','canopus_ens')
