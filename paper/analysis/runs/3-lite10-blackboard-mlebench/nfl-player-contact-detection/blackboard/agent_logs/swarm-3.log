p='workspaces/canopus_pi/eval_post.py'
s=open(p).read()
old='''def sweep(y, p, lo=0.5, hi=0.9995, n=600):
    qs = np.unique(np.quantile(p, np.linspace(lo, hi, n)))
    best = (-1, 0.5)
    for th in qs:
        m = matthews_corrcoef(y, (p >= th).astype(np.int8))
        if m > best[0]:
            best = (m, th)
    return best'''
new='''def sweep(y, p, lo=0.5, hi=0.9995, n=600):
    order = np.argsort(-p, kind="stable")
    ys = y[order].astype(np.int64); ps = p[order]
    tp = np.cumsum(ys); fp = np.cumsum(1 - ys)
    P = int(ys.sum()); N = len(y) - P
    fn = P - tp; tn = N - fp
    den = np.sqrt((tp + fp).astype(np.float64) * (tp + fn) * (tn + fp) * (tn + fn))
    mcc = np.where(den > 0, (tp * tn - fp * fn) / np.maximum(den, 1e-12), 0.0)
    qlo, qhi = np.quantile(p, [lo, hi])
    valid = (ps >= qlo) & (ps <= qhi)
    mcc = np.where(valid, mcc, -1)
    i = int(np.argmax(mcc))
    return float(mcc[i]), float(ps[i])'''
assert old in s
s=s.replace(old,new)
open(p,'w').write(s)
print('ok')
