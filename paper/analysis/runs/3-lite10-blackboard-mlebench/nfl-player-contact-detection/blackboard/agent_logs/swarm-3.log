import pandas as pd, numpy as np, time
from sklearn.metrics import matthews_corrcoef
ROOT="/download_job_code/payload/sandbox"; t0=time.time()
def log(*a): print(f"[{time.time()-t0:6.1f}s]",*a,flush=True)
def parse(df):
    sp=df.contact_id.str.rsplit("_",n=3,expand=True); df=df.copy()
    df["gp"]=sp[0].values; df["step"]=sp[1].astype(int).values; df["p1"]=sp[2].values; df["p2"]=sp[3].values; return df
def smooth_vals(p,df,keys,w):
    if w<=0: return np.asarray(p)
    d=df[keys+["step"]].copy(); d["p"]=np.asarray(p); d["_l"]=np.arange(len(p)); d=d.sort_values(keys+["step"])
    g=d.groupby(keys,sort=False)["p"]; r=g.rolling(w,center=True,min_periods=1).mean(); r.index=r.index.droplevel(list(range(len(keys))))
    return r.reindex(d.index).sort_index().values
def best_th(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9999,400)); o=np.argsort(-p); ps=p[o]; ys=y[o]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64); Pos=ys.sum(); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(ths[k])
d=pd.read_parquet(f"{ROOT}/workspaces/alkaid_psi/oof_final_blend.parquet"); d=parse(d)
pp=~d.is_ground.values; gr=d.is_ground.values
S=np.empty(len(d))
S[pp]=smooth_vals(d.score.values[pp],d[pp].reset_index(drop=True),["gp","p1","p2"],1)
S[gr]=smooth_vals(d.score.values[gr],d[gr].reset_index(drop=True),["gp","p1"],2)
y=d.contact.values.astype(np.int8); gps=d.gp.values; plays=d.gp.unique()
CFG={"pp":0.7348651885986328,"gr":-0.8554849780039694}
IG={"pp":pp,"gr":gr}; THS={"pp":[],"gr":[]}; diffs=[]; rng=np.random.RandomState(21)
resA=[]; resB=[]; resO=[]
for it in range(40):
    hold=set(rng.choice(plays,24,replace=False)); hm=pd.Series(gps).isin(hold).values; tm=~hm
    predA=np.zeros(len(d),np.int8); predB=np.zeros(len(d),np.int8); predO=np.zeros(len(d),np.int8)
    for task in ["pp","gr"]:
        mi=IG[task]; th=best_th(y[mi&tm],S[mi&tm]); THS[task].append(th)
        predA[mi]=(S[mi]>=CFG[task])
        predO[mi]=(S[mi]>=th)
    med={t:float(np.median(THS[t][-1:])) for t in ["pp","gr"]}  # per-it median of current only (1) -> use running later
    # use running median of thresholds so far
    med={t:float(np.median(THS[t])) for t in ["pp","gr"]}
    for task in ["pp","gr"]:
        mi=IG[task]; predB[mi]=(S[mi]>=med[task])
    resA.append(matthews_corrcoef(y[hm],predA[hm])); resO.append(matthews_corrcoef(y[hm],predO[hm])); resB.append(matthews_corrcoef(y[hm],predB[hm]))
for task in ["pp","gr"]:
    v=np.array(THS[task]); log(task,"cfg",CFG[task],"median nested",np.median(v),"mean",v.mean(),"std",v.std())
log("holdout MCC cfg-threshold",round(float(np.mean(resA)),5),"±",round(float(np.std(resA)/np.sqrt(len(resA))),5))
log("holdout MCC nested-oracle",round(float(np.mean(resO)),5),"±",round(float(np.std(resO)/np.sqrt(len(resO))),5))
log("holdout MCC running-median-threshold",round(float(np.mean(resB)),5),"±",round(float(np.std(resB)/np.sqrt(len(resB))),5))
PY
