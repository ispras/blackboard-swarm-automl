import pandas as pd, numpy as np
meta = pd.read_parquet("workspaces/canopus_pi/features/all_features.parquet", columns=["contact_id","split"])
P="workspaces/canopus_pi/preds"
W="workspaces/alkaid_psi"; C="workspaces/capella_pi"

def load_pair(oof, test):
    o = pd.read_parquet(oof).set_index("contact_id")["pred"]
    t = pd.read_parquet(test).set_index("contact_id")["pred"]
    oo = meta.contact_id.map(o).values; tt = meta.contact_id.map(t).values
    return np.where(meta.split.values==0, oo, tt).astype(np.float32)

out = meta[["contact_id"]].copy()
out["cnn_v2tta"] = load_pair(f"{W}/oof_cnn_cand_v2tta.parquet", f"{W}/test_cnn_cand_v2tta.parquet")
out["cnn_v2m"] = load_pair(f"{W}/oof_cnn_cand_v2m.parquet", f"{W}/test_cnn_cand_v2m.parquet")
out["pp_gru"] = load_pair(f"{P}/oof_pp_gru_v1.parquet", f"{P}/test_pp_gru_v1.parquet")
out["cap_lgbm"] = load_pair(f"{C}/oof_lgbm.parquet", f"{C}/test_lgbm.parquet")
print(out.shape, out.notna().mean().to_dict())
out.to_parquet("workspaces/canopus_pi/features/pp_stack2.parquet", index=False)

ge = pd.read_parquet("workspaces/canopus_pi/features/ground_extra.parquet")
g = meta[["contact_id"]].copy()
g["ground_gru"] = load_pair(f"{P}/oof_ground_gru_v1.parquet", f"{P}/test_ground_gru_v1.parquet")
g["ground_cnn"] = load_pair(f"{W}/oof_ground_cnn_v1m.parquet", f"{W}/test_ground_cnn_v1m.parquet")
g["cap_lgbm"] = load_pair(f"{C}/oof_lgbm.parquet", f"{C}/test_lgbm.parquet")
gg = ge.merge(g, on="contact_id", how="left")
print(gg.shape, gg.notna().mean().to_dict())
gg.to_parquet("workspaces/canopus_pi/features/ground_extra2.parquet", index=False)
