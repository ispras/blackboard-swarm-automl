    o=np.argsort(-p,kind="stable"); ys=y[o].astype(np.int64); ps=p[o]
    tp=np.cumsum(ys); fp=np.cumsum(1-ys); P=int(ys.sum()); N=len(y)-P; fn=P-tp; tn=N-fp
    den=np.sqrt((tp+fp).astype(np.float64)*(tp+fn)*(tn+fp)*(tn+fn))
    mcc=np.where(den>0,(tp*tn-fp*fn)/np.maximum(den,1e-12),0.0)
    qlo,qhi=np.quantile(p,[lo,hi]); mcc=np.where((ps>=qlo)&(ps<=qhi),mcc,-1)
    i=int(np.argmax(mcc)); return float(mcc[i]),float(ps[i])
def evaluate(df, name):
    y=df.contact.values.astype(np.int8); p=df.pred.values; fold=df.fold.values
    print("==",name,"rows",len(df),"pos",y.mean())
    # global oracle
    mg,thg=sweep(y,p); print(" oracle global",round(mg,5),thg)
    preds_raw=np.zeros(len(df),np.int8); preds_q=np.zeros(len(df),np.int8); preds_perfold=np.zeros(len(df),np.int8)
    for k in range(5):
        tr=fold!=k; va=fold==k
        mtr,thtr=sweep(y[tr],p[tr]); rate=(p[tr]>=thtr).mean()
        # raw threshold transfer
        preds_raw[va]=(p[va]>=thtr)
        # quantile/rate transfer
        thq=np.quantile(p[va],1-rate)
        preds_q[va]=(p[va]>=thq)
        # per-fold optimal (oracle, reference)
        mv,thv=sweep(y[va],p[va]); preds_perfold[va]=(p[va]>=thv)
        print(f" fold{k} thtr {thtr:.4f} rate {rate:.5f} | heldout rate raw {(p[va]>=thtr).mean():.5f} q {rate:.5f} | mcc raw {matthews_corrcoef(y[va],preds_raw[va]):.4f} q {matthews_corrcoef(y[va],preds_q[va]):.4f} orac {mv:.4f}")
    print(" overall raw",round(matthews_corrcoef(y,preds_raw),5),"quantile",round(matthews_corrcoef(y,preds_q),5),"perfold-oracle",round(matthews_corrcoef(y,preds_perfold),5))
