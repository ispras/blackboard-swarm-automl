import pandas as pd, numpy as np
from sklearn.metrics import matthews_corrcoef
ROOT="/download_job_code/payload/sandbox"
def parse(df):
    sp=df.contact_id.str.rsplit("_",n=3,expand=True); df=df.copy()
    df["gp"]=sp[0].values; df["step"]=sp[1].astype(int).values; df["p1"]=sp[2].values; df["p2"]=sp[3].values; return df
def smooth_vals(p,df,keys,w):
    if w<=0: return np.asarray(p)
    d=df[keys+["step"]].copy(); d["p"]=np.asarray(p); d["_l"]=np.arange(len(p)); d=d.sort_values(keys+["step"])
    g=d.groupby(keys,sort=False)["p"]; r=g.rolling(w,center=True,min_periods=1).mean(); r.index=r.index.droplevel(list(range(len(keys))))
    return r.reindex(d.index).sort_index().values
def best_th(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9995,300)); o=np.argsort(-p); ps=p[o]; ys=y[o]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64); Pos=ys.sum(); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(ths[k])
def prep(path,col,ws):
    d=pd.read_parquet(path); d=parse(d); d=d.rename(columns={col:"score"})
    out=np.empty(len(d))
    for ig,w in [(False,ws[0]),(True,ws[1])]:
        m=(d.is_ground.values==ig); sub=d[m]
        out[m]=smooth_vals(sub.score.values,sub,["gp","p1","p2"],w)
    d["ps"]=out; return d[["gp","is_ground","contact","ps"]]
F=prep(f"{ROOT}/workspaces/alkaid_psi/oof_final_blend.parquet","score",(1,2))
M=prep(f"{ROOT}/workspaces/capella_pi/oof_stack_mixv3.parquet","stack_oof",(3,3))
print("prepared",len(F),len(M))
plays=F.gp.unique(); rng=np.random.RandomState(0)
res={"final":[],"mix3":[]}
for it in range(30):
    hold=set(rng.choice(plays,24,replace=False))
    hm=F.gp.isin(hold).values; tm=~hm
    for nm,d in [("final",F),("mix3",M)]:
        pred=np.zeros(len(d),np.int8)
        for ig in [False,True]:
            mi=(d.is_ground.values==ig)
            th=best_th(d.contact.values[mi&tm],d.ps.values[mi&tm])
            pred[mi]=(d.ps.values[mi]>=th).astype(np.int8)
        res[nm].append(matthews_corrcoef(d.contact.values[hm],pred[hm]))
for nm,v in res.items():
    print(nm,"mean",round(float(np.mean(v)),5),"std",round(float(np.std(v)),5),"min",round(float(np.min(v)),4),"max",round(float(np.max(v)),4))
print("final-mix3 mean diff",round(float(np.mean(res['final'])-np.mean(res['mix3'])),5))
