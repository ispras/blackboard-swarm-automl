import pandas as pd, numpy as np, time, itertools
from sklearn.metrics import matthews_corrcoef
ROOT="/download_job_code/payload/sandbox"; t0=time.time()
def log(*a): print(f"[{time.time()-t0:6.1f}s]",*a,flush=True)
def parse(df):
    sp=df.contact_id.str.rsplit("_",n=3,expand=True); df=df.copy()
    df["gp"]=sp[0].values; df["step"]=sp[1].astype(int).values; df["p1"]=sp[2].values; df["p2"]=sp[3].values; return df
def lgt(p): p=np.clip(np.asarray(p,float),1e-6,1-1e-6); return np.log(p/(1-p))
def smooth_vals(p,df,keys,w):
    if w<=0: return np.asarray(p)
    d=df[keys+["step"]].copy(); d["p"]=np.asarray(p); d["_l"]=np.arange(len(p)); d=d.sort_values(keys+["step"])
    g=d.groupby(keys,sort=False)["p"]; r=g.rolling(w,center=True,min_periods=1).mean(); r.index=r.index.droplevel(list(range(len(keys))))
    return r.reindex(d.index).sort_index().values
def best_th(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9995,300)); o=np.argsort(-p); ps=p[o]; ys=y[o]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64); Pos=ys.sum(); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(mcc[k])
# final blend (logit) smoothed per config
f=pd.read_parquet(f"{ROOT}/workspaces/alkaid_psi/oof_final_blend.parquet"); f=parse(f)
# mix3 logit
m=pd.read_parquet(f"{ROOT}/workspaces/capella_pi/oof_stack_mixv3.parquet"); m=parse(m)
# canopus ens v5
e=pd.read_parquet(f"{ROOT}/workspaces/canopus_pi/preds/ens_oof_probs_v5.parquet"); e=parse(e)
assert (f.contact_id.values==m.contact_id.values).all() and (f.contact_id.values==e.contact_id.values).all()
pp=~f.is_ground.values; gr=f.is_ground.values
def smooth_by_task(score, ws_pp, ws_gr):
    out=np.empty(len(score))
    out[pp]=smooth_vals(score[pp],f[pp].reset_index(drop=True),["gp","p1","p2"],ws_pp)
    out[gr]=smooth_vals(score[gr],f[gr].reset_index(drop=True),["gp","p1"],ws_gr)
    return out
F=smooth_by_task(f.score.values,1,2)
M=smooth_by_task(m.stack_oof.values,3,3)
E=score=np.where(gr, lgt(e.p_gr.values), lgt(e.p_pp.values))
E=smooth_by_task(E,3,7)
y=f.contact.values.astype(np.int8); gps=f.gp.values; plays=f.gp.unique()
# combos in logit space of smoothed sources
combos=[]
for a in [0,.25,.5,.75,1.0]:
    for b in [0,.15,.3]:
        if a+b<=1.0: combos.append((round(1-a-b,2),a,b))
log("combos",len(combos))
rng=np.random.RandomState(11); res={c:[] for c in combos}
for it in range(30):
    hold=set(rng.choice(plays,24,replace=False)); hm=pd.Series(gps).isin(hold).values; tm=~hm
    for c in combos:
        score=c[0]*F+c[1]*M+c[2]*E
        pred=np.zeros(len(f),np.int8)
        for ig in [False,True]:
            mi=(f.is_ground.values==ig)
            th=best_th(y[mi&tm],score[mi&tm]); pred[mi]=(score[mi]>=th)
        res[c].append(matthews_corrcoef(y[hm],pred[hm]))
rows=sorted([(np.mean(v),np.std(v),c) for c,v in res.items()],reverse=True)
for mu,s,c in rows[:10]: print(f"w_final={c[0]} w_mix3={c[1]} w_ens5={c[2]} mean={mu:.5f} std={s:.5f}")
