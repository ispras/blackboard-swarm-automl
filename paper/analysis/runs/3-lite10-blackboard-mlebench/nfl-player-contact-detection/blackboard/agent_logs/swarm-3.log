old='''def morph_group(prob, th, close_gap=0, min_len=1):
    b = prob >= th
    n=len(b)
    if close_gap>0:
        # fill gaps of <=close_gap zeros between ones
        i=0
        while i<n:
            if not b[i]:
                j=i
                while j<n and not b[j]: j+=1
                if i>0 and j<n and (j-i)<=close_gap:
                    b[i:j]=True
                i=j
            else: i+=1
    if min_len>1:
        i=0
        while i<n:
            if b[i]:
                j=i
                while j<n and b[j]: j+=1
                if (j-i)<min_len: b[i:j]=False
                i=j
            else: i+=1
    return b'''
new='''def morph_group(prob, th, close_gap=0, min_len=1):
    b = (prob >= th).astype(np.int8)
    n=len(b)
    d=np.diff(np.r_[0,b,0]); st=np.where(d==1)[0]; en=np.where(d==-1)[0]
    merged=[]
    for s,e in zip(st,en):
        if merged and s-merged[-1][1]<=close_gap:
            merged[-1][1]=e
        else:
            merged.append([s,e])
    out=np.zeros(n,dtype=bool)
    for s,e in merged:
        if e-s>=min_len: out[s:e]=True
    return out'''
assert old in s
s=s.replace(old,new)
open(p,'w').write(s)
