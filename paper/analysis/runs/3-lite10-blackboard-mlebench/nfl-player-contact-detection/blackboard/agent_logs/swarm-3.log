import pandas as pd, numpy as np, time
from sklearn.metrics import matthews_corrcoef
ROOT="/download_job_code/payload/sandbox"; t0=time.time()
def log(*a): print(f"[{time.time()-t0:6.1f}s]",*a,flush=True)
def parse(df):
    sp=df.contact_id.str.rsplit("_",n=3,expand=True); df=df.copy()
    df["gp"]=sp[0].values; df["step"]=sp[1].astype(int).values; df["p1"]=sp[2].values; df["p2"]=sp[3].values; return df
def lgt(p): p=np.clip(np.asarray(p,float),1e-6,1-1e-6); return np.log(p/(1-p))
def smooth(p,df,keys,w):
    if w<=0: return np.asarray(p)
    d=df[keys+["step"]].copy(); d["p"]=np.asarray(p); d["_l"]=np.arange(len(p)); d=d.sort_values(keys+["step"])
    g=d.groupby(keys,sort=False)["p"]; r=g.rolling(2*w+1,center=True,min_periods=1).mean(); r.index=r.index.droplevel(list(range(len(keys))))
    return r.reindex(d.index).sort_index().values
def best_th(y,p):
    ths=np.quantile(p,np.linspace(0.5,0.9999,400)); o=np.argsort(-p); ps=p[o]; ys=y[o]
    cp=np.cumsum(ys,dtype=np.float64); cn=np.cumsum(1-ys,dtype=np.float64); Pos=ys.sum(); Neg=len(ys)-Pos
    idx=np.clip(np.searchsorted(-ps,-ths,side='left'),0,len(ys))
    tp=np.where(idx>0,cp[np.maximum(idx-1,0)],0.0); fp=np.where(idx>0,cn[np.maximum(idx-1,0)],0.0)
    fn=Pos-tp; tn=Neg-fp; den=np.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))+1e-12
    mcc=(tp*tn-fp*fn)/den; k=int(np.argmax(mcc)); return float(mcc[k]),float(ths[k])
f=pd.read_parquet(f"{ROOT}/workspaces/alkaid_psi/oof_final_blend.parquet"); f=parse(f)
v=pd.read_parquet(f"{ROOT}/workspaces/canopus_pi/preds/oof_ground_gru_v6.parquet")
vs=v.set_index("contact_id")["pred"].reindex(f.contact_id.values).values
gr=f.is_ground.values; y=f.contact.values.astype(np.int8)
# base ground score smoothed as in final config (ws2)
base_s=smooth(f.score.values[gr],f[gr].reset_index(drop=True),["gp","p1"],2)
vg=lgt(vs[gr])
results={}
for w in [0,0.1,0.2,0.3,0.5,0.75,1.0]:
    for sw in [2,3,4,5]:
        sc=smooth(base_s+w*vg,f[gr].reset_index(drop=True),["gp","p1"],sw)
        m,th=best_th(y[gr],sc); results[(w,sw)]=(m,th)
best=sorted(results.items(),key=lambda kv:-kv[1][0])[:6]
for (w,sw),(m,th) in best: log("w",w,"sw",sw,"ground OOF MCC",round(m,5),"th",round(th,4))
# 24-play holdout compare best additive option vs base final on ground + full global
w,sw=best[0][0]; th=best[0][1][1]
sc_all=smooth(base_s+w*vg,f[gr].reset_index(drop=True),["gp","p1"],sw)
# base final ground
th0=best_th(y[gr],base_s)[1]
plays=f.gp.unique(); rng=np.random.RandomState(33); mA=[];mB=[]
for it in range(40):
    hold=set(rng.choice(plays,24,replace=False)); hm=pd.Series(f.gp.values).isin(hold).values
    yg=y[gr]; mg=hm[gr]
    pA=(base_s>=th0).astype(np.int8); pB=(sc_all>=th).astype(np.int8)
    mA.append(matthews_corrcoef(yg[mg],pA[mg])); mB.append(matthews_corrcoef(yg[mg],pB[mg]))
log("ground 24-play base",round(float(np.mean(mA)),5),"with_v6",round(float(np.mean(mB)),5),"diff",round(float(np.mean(mB)-np.mean(mA)),5))
PY
