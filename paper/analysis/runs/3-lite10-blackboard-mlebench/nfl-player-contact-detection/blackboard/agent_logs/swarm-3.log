import json, os, numpy as np, pandas as pd
ROOT="/download_job_code/payload/sandbox"; OUT=os.path.join(ROOT,"final_solution")
CFG=json.load(open(os.path.join(OUT,"final_config.json"))); RAW=set(CFG.get("raw_logit",[]))
def logit(p,e=1e-6): p=np.clip(np.asarray(p,float),e,1-e); return np.log(p/(1-p))
def base():
    sub=pd.read_csv(os.path.join(ROOT,"data","sample_submission.csv")); parts=sub.contact_id.str.rsplit("_",n=3,expand=True)
    out=pd.DataFrame({"contact_id":sub.contact_id,"game_play":parts[0],"step":parts[1].astype("int32"),"p1":parts[2].astype("int32"),"p2s":parts[3].astype(str)})
    out["is_ground"]=out.p2s=="G"; return out
def load(df,path,col,name):
    path=path if os.path.isabs(path) else os.path.join(ROOT,path)
    d=pd.read_parquet(path)[["contact_id",col]].rename(columns={col:name})
    return df.merge(d,on="contact_id",how="left")
def blend(df,w):
    n=len(df); num=np.zeros(n); den=np.zeros(n)
    for s,ww in w.items():
        z=df[s].values.astype(float) if s in RAW else logit(df[s].values); m=np.isfinite(z)
        num[m]+=ww*z[m]; den[m]+=ww
    return np.where(den>0,num/np.maximum(den,1e-12),0.0)
def smoother(df,mask,keys):
    sub=df.loc[mask,list(keys)+["step"]]
    code=pd.factorize(pd.MultiIndex.from_arrays([sub[k].values for k in keys]))[0]
    step=sub["step"].values; order=np.lexsort((step,code)); inv=np.empty(len(order),np.int64); inv[order]=np.arange(len(order)); cs=code[order]
    def f(score,ws):
        if not ws or ws<=0: return np.asarray(score,float)
        ss=np.asarray(score,float)[order]
        roll=pd.Series(ss).groupby(cs,sort=False).rolling(2*ws+1,center=True,min_periods=1).mean().values
        return roll[inv]
    return f
df=base()
for name,spec in CFG["sources"].items(): df=load(df,spec["path"],spec["column"],name)
pp=~df.is_ground.values; gr=df.is_ground.values
spp=smoother(df,pp,CFG["keys"]["pp"])(blend(df[pp].reset_index(drop=True),CFG["pp"]["weights"]),CFG["pp"]["ws"])
sgr=smoother(df,gr,CFG["keys"]["gr"])(blend(df[gr].reset_index(drop=True),CFG["gr"]["weights"]),CFG["gr"]["ws"])
pred=np.zeros(len(df),np.int8); pred[pp]=(spp>=CFG["pp"]["th"]); pred[gr]=(sgr>=CFG["gr"]["th"])
sub=pd.read_csv(os.path.join(OUT,"submission.csv"))
same=(pred==sub.contact.values).all()
print("config sources",list(CFG["sources"].keys()))
print("reproduced:",same,"diff count",int((pred!=sub.contact.values).sum()),"repro pos",pred.mean(),"file pos",sub.contact.mean())
