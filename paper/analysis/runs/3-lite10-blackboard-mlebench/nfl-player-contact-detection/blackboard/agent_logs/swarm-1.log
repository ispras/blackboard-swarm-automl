plays=o[["gp"]].drop_duplicates().gp.values
print("plays",len(plays))
def run(sub,rate,trmask,vamask):
    y=sub.contact.values; sc=sub.score.values
    sb=Sub(y[trmask],sc[trmask],"t"); ks,_=optimize_thresholds([sb]); k=ks[0]
    th=sb.th[k] if k>=0 else np.inf
    if rate:
        tp,fp=sb.counts(k); r=(tp+fp)/max(1,len(sb.y)); th=np.quantile(sc[vamask],1-r)
    yv=y[vamask];sv=sc[vamask]
    tp=int(((sv>=th)&(yv==1)).sum());fp=int(((sv>=th)&(yv==0)).sum());P=int(yv.sum());N=int((1-yv).sum())
    fn=P-tp;tn=N-fp;d=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))
    return 0 if d==0 else (tp*tn-fp*fn)/d
rng=np.random.default_rng(0)
res={"fixed":[], "rate":[]}
for it in range(40):
    test_plays=set(rng.choice(plays,24,replace=False))
    is_test=o.gp.isin(test_plays).values
    for name,rate in [("fixed",False),("rate",True)]:
        TP=FP=P=N=0
        for mask in [~o.is_ground.values,o.is_ground.values]:
            sub=o[mask]
            trm=~sub.gp.isin(test_plays).values; vam=~trm
            yv=sub.contact.values[vam];sc=sub.score.values[vam]
            # compute th via helper using same logic
            sbb=Sub(sub.contact.values[trm],sub.score.values[trm],"t");ks,_=optimize_thresholds([sbb]);k=ks[0]
            th=sbb.th[k] if k>=0 else np.inf
            if rate:
                tp,fp=sbb.counts(k);r=(tp+fp)/max(1,len(sbb.y));th=np.quantile(sub.score.values[vam],1-r)
            tp=int(((sc>=th)&(yv==1)).sum());fp=int(((sc>=th)&(yv==0)).sum());P+=int(yv.sum());N+=int((1-yv).sum());TP+=tp;FP+=fp
        fn=P-TP;tn=N-FP;d=np.sqrt(float(TP+FP)*(TP+fn)*(tn+FP)*(tn+fn))
        res[name].append(0 if d==0 else (TP*tn-FP*fn)/d)
import numpy as np
for k,v in res.items(): print(k,"mean",round(float(np.mean(v)),5),"median",round(float(np.median(v)),5),"std",round(float(np.std(v)),5))
