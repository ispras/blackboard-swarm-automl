import pandas as pd,numpy as np
def bm(y,p,K=800):
    o=np.argsort(-p); ys=y[o].astype(np.int64); ps=p[o]
    P=ys.sum();N=len(ys)-P; tp=np.cumsum(ys);fp=np.cumsum(1-ys)
    den=np.sqrt((tp+fp)*P*N*(N+P-fp-tp)); mcc=np.where(den>0,(tp*N-fp*P)/(den+1e-12),-1)
    idx=np.unique(np.linspace(0,len(ys)-1,K).astype(int)); j=idx[np.argmax(mcc[idx])]
    return mcc[j],ps[j]
for tag in ['v2tta','v2m']:
    c=pd.read_parquet(f'workspaces/alkaid_psi/oof_cnn_cand_{tag}.parquet').dropna()
    m,t=bm(c.contact.values.astype(float),c.pred.values)
    print(tag,'mcc',round(m,4),'th',round(float(t),3))
