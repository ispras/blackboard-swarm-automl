import pandas as pd,numpy as np,sys
sys.path.insert(0,"workspaces/alkaid_psi")
from blend_final import Sub,logit
def mcc(y,p,K=400):
    sb=Sub(y,p,"x")
    best=-2
    for k in range(-1,len(sb.ridx)):
        tp,fp=sb.counts(k); P=sb.P;N=sb.N;fn=P-tp;tn=N-fp
        d=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))
        m=0 if d==0 else (tp*tn-fp*fn)/d
        best=max(best,m)
    return best
tr=pd.read_parquet("workspaces/alkaid_psi/blend2_train.parquet")
g=tr[tr.is_ground].copy()
y=g.contact.values.astype(float)
z1=logit(g.can_gr.values); z0=logit(g.can_gr1.values); zcan=0.5*(z1+z0)
zcnn=logit(g.cnn_gr.values)
print("ground n",len(g),"pos",int(y.sum()))
print("can avg raw",round(mcc(y,zcan),4),"can avg+sm6",round(mcc(y, np.nan_to_num(pd.Series(zcan).groupby(pd.factorize(tr.loc[tr.is_ground,"game_play"].astype(str)+"|"+tr.loc[tr.is_ground,"p1"].astype(str))[0]).rolling(13,center=True,min_periods=1).mean().values)),4))
print("cnn raw",round(mcc(y,zcnn),4),"cnn+sm6",round(mcc(y, pd.Series(zcnn).groupby(pd.factorize(tr.loc[tr.is_ground,"game_play"].astype(str)+"|"+tr.loc[tr.is_ground,"p1"].astype(str))[0]).rolling(13,center=True,min_periods=1).mean().values),4))
for w in [0.5,0.8,1.0,1.2,1.5,2.0]:
    z=(zcan+w*zcnn)/(1+w)
    sm=pd.Series(z).groupby(pd.factorize(tr.loc[tr.is_ground,"game_play"].astype(str)+"|"+tr.loc[tr.is_ground,"p1"].astype(str))[0]).rolling(13,center=True,min_periods=1).mean().values
    print("blend w",w,"raw",round(mcc(y,z),4),"sm6",round(mcc(y,sm),4))
