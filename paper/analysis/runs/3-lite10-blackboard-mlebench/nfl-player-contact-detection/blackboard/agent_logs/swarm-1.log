def nested(df,scorecol,name,hedge=None):
    folds=df.fold.values; res={}
    for f in range(5):
        tr=df[folds!=f]; va=df[folds==f]
        subs_tr=[]; subs_va=[]
        for m,name2 in [(~tr.is_ground,"pp"),(tr.is_ground,"gr")]:
            subs_tr.append(Sub(tr.loc[m,"contact"].values,(tr.loc[m,scorecol] if hedge is None else 0.5*tr.loc[m,scorecol]+0.5*tr.loc[m,hedge]).values,name2))
        ks,_=optimize_thresholds(subs_tr)
        # apply to va
        tp=fp=P=N=0
        for (m,name2),sb,k in zip([(~tr.is_ground,"pp"),(tr.is_ground,"gr")],subs_tr,ks):
            mv=(~va.is_ground) if name2=="pp" else va.is_ground
            sv=va.loc[mv,scorecol].values if hedge is None else 0.5*va.loc[mv,scorecol].values+0.5*va.loc[mv,hedge].values
            th=sb.th[k] if k>=0 else np.inf
            y=va.loc[mv,"contact"].values
            tp+=int(((sv>=th)&(y==1)).sum()); fp+=int(((sv>=th)&(y==0)).sum()); P+=int(y.sum()); N+=int((1-y).sum())
        fn=P-tp; tn=N-fp; d=np.sqrt(float(tp+fp)*(tp+fn)*(tn+fp)*(tn+fn))
        res[f]=0 if d==0 else (tp*tn-fp*fn)/d
    print(name,"nested per-fold",{k:round(v,4) for k,v in res.items()},"mean",round(np.mean(list(res.values())),4))
nested(b,"score","blend3")
nested(b,"stack_oof","stack_mix")
nested(b,"score","hedge_blend3_mix",hedge="stack_oof")
