import os, sys, numpy as np, pandas as pd, torch
from torch.utils.data import Dataset, DataLoader
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from train_cnn import Net, normalize, OUT
import infer_cnn

class ValDS(Dataset):
    def __init__(self, split, idx):
        self.idx = np.asarray(idx, np.int64)
        self.arr = np.load(f"{OUT}/{split}_crops.npy", mmap_mode="r")
        self.geom = np.load(f"{OUT}/geom_{split}.npy", mmap_mode="r")
    def __len__(self): return len(self.idx)
    def __getitem__(self, i):
        r = int(self.idx[i])
        x = np.ascontiguousarray(np.asarray(self.arr[r]).transpose(0,3,1,2))
        return torch.from_numpy(x), torch.from_numpy(np.asarray(self.geom[r]).copy())

tag = sys.argv[1] if len(sys.argv)>1 else "v2"
device="cuda"
plan = pd.read_parquet(f"{OUT}/train_cand.parquet")
for f in range(5):
    idx = np.where(plan.fold.values==f)[0]
    ds = ValDS("train", idx)
    dl = DataLoader(ds, batch_size=512, shuffle=False, num_workers=4, pin_memory=True)
    model = Net("resnet18", ds.geom.shape[1]).to(device)
    wp=f"{OUT}/model_f{f}_{tag}_best.pt"
    if not os.path.exists(wp): wp=f"{OUT}/model_f{f}_{tag}.pt"
    model.load_state_dict(torch.load(wp, map_location=device))
    p = 0.5*(infer_cnn.pred_model(model, dl, device, False)+infer_cnn.pred_model(model, dl, device, True))
    np.save(f"{OUT}/valpred_f{f}_{tag}tta.npy", p)
    np.save(f"{OUT}/validx_f{f}_{tag}tta.npy", idx)
    print("fold",f,"done",len(idx),flush=True)
EOF
