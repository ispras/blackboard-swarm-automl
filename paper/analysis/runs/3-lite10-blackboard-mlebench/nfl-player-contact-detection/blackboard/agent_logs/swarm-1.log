import pandas as pd, numpy as np
lab=pd.read_csv("data/train_labels.csv",usecols=["contact_id","game_play","step","nfl_player_id_1","nfl_player_id_2","contact"])
pp=lab[lab.nfl_player_id_2!="G"].copy()
pp["p1"]=pp.nfl_player_id_1.astype("int32"); pp["p2"]=pd.to_numeric(pp.nfl_player_id_2).astype("int32")
tr=pd.read_csv("data/train_player_tracking.csv",usecols=["game_play","step","nfl_player_id","x_position","y_position"]).rename(columns={"nfl_player_id":"p1","x_position":"x1","y_position":"y1"})
pp=pp.merge(tr,on=["game_play","step","p1"],how="left")
tr=tr.rename(columns={"p1":"p2","x1":"x2","y1":"y2"}); pp=pp.merge(tr,on=["game_play","step","p2"],how="left")
pp["dist"]=np.sqrt((pp.x1-pp.x2)**2+(pp.y1-pp.y2)**2)
pp["frame"]=(300+5.994*pp.step).round().astype(int)
cand=pp[pp.dist<=2.5].copy(); print("cand",len(cand),"pos",cand.contact.sum())
hel=pd.read_csv("data/train_baseline_helmets.csv",usecols=["game_play","view","frame","nfl_player_id"]); hel=hel[hel.view.isin(["Sideline","Endzone"])].drop_duplicates()
for view in ["Sideline","Endzone"]:
    hv=hel[hel.view==view]
    # nearest frame within 6
    base=hv[["game_play","frame","nfl_player_id"]]
    for pl in ["p1","p2"]:
        m=cand[["contact_id","game_play","frame",pl]].merge(base.rename(columns={"nfl_player_id":pl}),on=["game_play","frame",pl],how="left",indicator=True)
        cand[f"{view}_{pl}"]=(m._merge=="both").values
cand["both_sid"]=cand.Sideline_p1&cand.Sideline_p2
cand["both_end"]=cand.Endzone_p1&cand.Endzone_p2
cand["any_both"]=cand.both_sid|cand.both_end
cand["none"]=~(cand.Sideline_p1|cand.Sideline_p2|cand.Endzone_p1|cand.Endzone_p2)
print(cand[["Sideline_p1","Sideline_p2","Endzone_p1","Endzone_p2","both_sid","both_end","any_both","none"]].mean().round(4))
print("pos with any_both",cand.loc[cand.contact==1,"any_both"].mean())
print("pos with none",cand.loc[cand.contact==1,"none"].mean())
