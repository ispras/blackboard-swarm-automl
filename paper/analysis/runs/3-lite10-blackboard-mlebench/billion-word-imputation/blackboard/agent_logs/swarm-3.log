import numpy as np, time, sys, json
import Levenshtein
from ngram_model import BigramLM
BASE='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
gaps=[l.rstrip('\n') for l in open(f'{BASE}/holdout_gap.txt')]
orig=[l.rstrip('\n') for l in open(f'{BASE}/holdout_orig.txt')]
meta=[l.rstrip('\n').split('\t') for l in open(f'{BASE}/holdout_meta.tsv')][1:]
N=int(sys.argv[1]) if len(sys.argv)>1 else len(gaps)
Ts=int(sys.argv[2]) if len(sys.argv)>2 else 100
Tp=int(sys.argv[3]) if len(sys.argv)>3 else 100
lm=BigramLM()
t0=time.time()
best=[]  # (gap, word, gain, score)
for i in range(N):
    toks=gaps[i].split(' ')
    c=lm.predict_sentence(toks,Ts,Tp,topk=3)
    if c:
        # best by score (c sorted by score desc within gap but interleaved) -> pick max gain
        cb=max(c,key=lambda x:x[3])
        best.append((cb[0],lm.vocab[cb[1]],cb[3]))
    else:
        best.append((-1,'',-1e9))
    if (i+1)%5000==0: print('done',i+1,round(time.time()-t0,1),flush=True)

np.save('/tmp/ant_best.npy',np.array([[b[0],b[1],b[2]] for b in best],dtype=object),allow_pickle=True)
# gap accuracy
corr=0; valid=0
for i,b in enumerate(best):
    if meta[i][2]=='-1': continue
    valid+=1
    if b[0]==int(meta[i][2]): corr+=1
print('gap acc all',corr/valid, 'valid',valid)
# metrics vs threshold on gain, using word=best predicted word
def insert(toks,k,c): return ' '.join(toks[:k]+[c]+toks[k:])
res=[]
for thr in [-10,-5,-3,-2,-1.5,-1,-0.5,0,0.5,1,1.5,2,2.5,3,4,5]:
    tot=0; app=0; locc=0; wc=0
    for i,b in enumerate(best):
        if b[0]==-1 or b[2]<thr:
            tot+=Levenshtein.distance(gaps[i],orig[i]); continue
        toks=gaps[i].split(' '); k=b[0]
        # guard: insertion position must be valid
        if k<1 or k>len(toks)-1:
            tot+=Levenshtein.distance(gaps[i],orig[i]); continue
        app+=1
        tot+=Levenshtein.distance(insert(toks,k,b[1]),orig[i])
        if meta[i][2]!='-1' and k==int(meta[i][2]): locc+=1
        if meta[i][2]!='-1' and k==int(meta[i][2]) and b[1]==meta[i][3]: wc+=1
    res.append((thr,tot/N,app/N,locc/N,wc/N))
print('thr   metric   apply  loc_acc word_exact')
for r in res:
    print(f'{r[0]:5} {r[1]:.4f} {r[2]:.3f} {r[3]:.3f} {r[4]:.3f}')
print('baseline',sum(Levenshtein.distance(gaps[i],orig[i]) for i in range(N))/N)
