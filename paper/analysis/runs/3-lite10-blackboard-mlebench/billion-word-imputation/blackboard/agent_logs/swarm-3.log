import pickle, numpy as np
from Levenshtein import distance as lev
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.model_selection import KFold
from sklearn.linear_model import LogisticRegression
HOLD='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
arc='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/'
sp='/download_job_code/payload/sandbox/workspaces/spica_psi/'
D=pickle.load(open(arc+'det_hold_mix3_arith.pkl','rb')); gp=D['gap_probs']; toks=D['tokens']
G=pickle.load(open(arc+'hold_chosen_gaps_mix3.pkl','rb')); C=np.load(arc+'hold_conf_mix3.npy')
zs=pickle.load(open(sp+'hold_mix3_zs.pkl','rb')); ft=pickle.load(open(sp+'hold_mix3_ft.pkl','rb')); base=pickle.load(open(sp+'hold_mix3_base.pkl','rb'))
orig=[l.rstrip('\n') for l in open(HOLD+'/holdout_orig.txt')]; gapf=[l.rstrip('\n') for l in open(HOLD+'/holdout_gap.txt')]
meta=[l.rstrip('\n').split('\t') for l in open(HOLD+'/holdout_meta.tsv')][1:]
N=len(gp); W=[0.5,0.3,0.2]; Ws=sum(W); topk=20
base_costs=np.array([lev(gapf[i],orig[i]) for i in range(N)])
COMMON=["the","a","an","to","of","and","in","that","is","for","on","it","was","with","as","at","by","be","this","from"]
def norm(d):
    s=sum(d.values()); return {w:v/s for w,v in d.items()} if s>0 else {}
def cands(ws,substr):
    c=set(ws); c.update(COMMON)
    for w in ws:
        n=len(w)
        for L in range(1,n): c.add(w[:L]); c.add(w[L:])
        for j in range(n): c.add(w[:j]+w[j+1:])
    if substr:
        for w in ws[:5]:
            if len(w)<=20:
                for a in range(len(w)):
                    for b in range(a+1,len(w)+1): c.add(w[a:b])
    return c
feats=[]; benefit=np.zeros(N); delta=np.zeros(N); valid=np.zeros(N,dtype=bool); sidx=[]
for i in range(N):
    g=G[i]; a=np.asarray(gp[i]); M=len(toks[i])
    if not g: continue
    k=int(g[0]) if isinstance(g,(list,tuple)) else int(g)
    if k<1 or k>M-1 or k>len(a): continue
    conf=float(C[i]); ngap=len(a); a_s=np.sort(a)
    margin=float(a_s[-1]-a_s[-2]) if len(a)>1 else 0.0
    comb={}
    for dump,wt in zip([zs,ft,base],W):
        gg=dump[i].get(k)
        if gg is None: continue
        d={}
        for w,p in zip(gg['w'][:topk],gg['p'][:topk]): d[w]=d.get(w,0.0)+p
        d=norm(d)
        for w,v in d.items(): comb[w]=comb.get(w,0.0)+wt*v/Ws
    if not comb: continue
    items=sorted(comb.items(), key=lambda kv:-kv[1])[:topk]
    ws=[w for w,_ in items]; ps=np.array([x for _,x in items])
    best=None;bw=None;braw=None
    for c in cands(ws,True):
        raw=sum(ps[j]*lev(c,ws[j]) for j in range(len(ws))); e=raw+0.05*len(c)
        if best is None or e<best: best=e;bw=c;braw=raw
    tokss=gapf[i].split(); cost=lev(' '.join(tokss[:k]+[bw]+tokss[k:]),orig[i])
    benefit[i]=base_costs[i]-cost; delta[i]=cost-base_costs[i]; valid[i]=True; sidx.append(i)
    feats.append([conf,margin,np.log(ngap),braw,len(bw),conf*margin,conf/max(1,np.sqrt(ngap))])
X=np.array(feats); y=benefit[valid]
print("valid",len(y),"positive-benefit frac",(y>0).mean(),"baseline",base_costs.mean())
kf=KFold(5,shuffle=True,random_state=0)
oof=np.zeros(N)
for tr,te in kf.split(X):
    m=HistGradientBoostingRegressor(max_iter=300,learning_rate=0.05,max_leaf_nodes=31,min_samples_leaf=50,l2_regularization=1.0)
    m.fit(X[tr],y[tr]); vi=np.array(sidx); oof[vi[te]]=m.predict(X[te])
# metric: insert where oof>thr
for thr in [0.0,0.05,0.1,0.15,0.2,0.3,0.5]:
    ins=(oof>thr)&valid
    s=np.where(ins,delta,0.0)
    print(f"GBM thr {thr}: metric {(base_costs+s).mean():.4f} apply {ins.mean():.4f}")
# logistic classifier target benefit>0
yc=(y>0).astype(int); oofc=np.zeros(N)
for tr,te in kf.split(X):
    m=LogisticRegression(max_iter=2000,C=0.5); m.fit(X[tr],yc[tr]); vi=np.array(sidx); oofc[vi[te]]=m.predict_proba(X[te])[:,1]
for thr in [0.4,0.45,0.5,0.55,0.6]:
    ins=(oofc>thr)&valid; s=np.where(ins,delta,0.0)
    print(f"LOG thr {thr}: metric {(base_costs+s).mean():.4f} apply {ins.mean():.4f}")
# v3b reference computed by current rule
ins=np.zeros(N,dtype=bool)
for i in sidx:
    conf=feats[sidx.index(i)][0] if False else None
# simpler compute current rule from feats arrays
conf=X[:,0]; cw=X[:,3]
ins=(conf>=0.5)|((conf>=0.30)&(cw<=0.30))
print("current v3b rule metric",(base_costs+np.where(ins,delta,0)).mean(),"apply",ins.mean())
