            k,w=chosen[i]; tokss=gapf[i].split(); tot+=lev(' '.join(tokss[:k]+[w]+tokss[k:]),orig[i]); app+=1
            loc+=(k==int(meta[i][2]))
        print(f'v3 substr {substr} tau {tau:.3f}: metric {tot/N:.4f} apply {app/N:.3f} loc {loc/max(1,app):.3f}',flush=True)
