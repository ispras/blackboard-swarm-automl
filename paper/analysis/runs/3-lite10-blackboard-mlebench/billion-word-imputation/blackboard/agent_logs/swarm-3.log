    W=np.array([float(x) for x in args.weights.split(',')]); Ws=W.sum()
    n=len(gp)
    S=[]
    for i in range(n):
        a=np.asarray(gp[i]); M=len(toks[i])
        if len(a)==0: S.append(None); continue
