def _refine_word(self, t, k, extra_tri=True):
    M=self.M
    a=int(t[k-1]); b=int(t[k])
    lo=int(np.searchsorted(self.Kb,a*M)); hi=int(np.searchsorted(self.Kb,(a+1)*M))
    succ=(self.Kb[lo:hi]-a*M)
    lo2=int(np.searchsorted(self.Kr,b*M)); hi2=int(np.searchsorted(self.Kr,(b+1)*M))
    pred=(self.Kr[lo2:hi2]-b*M)
    parts=[succ,pred]
    if extra_tri and k>=2:
        x=int(t[k-2]); base=(x*M+a)*M; lt=int(np.searchsorted(self.Kt,base)); ht=int(np.searchsorted(self.Kt,base+M))
        parts.append(self.Kt[lt:ht]%M)
    cand=np.unique(np.concatenate(parts)); cand=cand[cand<self.V]
    if len(cand)==0: return None
    sc,gain=self.score_gap(t,k,cand)
    j=int(np.argmax(gain))
    return int(cand[j]), float(sc[j]), float(gain[j]), cand, sc, gain

TrigramLM.refine_word=_refine_word
