import gzip, pickle, sys, time
inp=sys.argv[1]; out=sys.argv[2]
t0=time.time()
# stream, keep per-id dict of best-gain entry per gap
recs={}  # id -> {gap: (word,gain,score)}
last=None; cur=None
with gzip.open(inp,'rt',encoding='utf-8') as f:
