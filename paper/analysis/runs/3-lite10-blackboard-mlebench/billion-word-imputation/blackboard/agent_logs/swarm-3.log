import numpy as np, os
OUT='/download_job_code/payload/sandbox/workspaces/antares_upsilon/ngram'

class BigramLM:
    def __init__(self, out=OUT):
        self.vocab=np.load(f'{out}/vocab.npy',allow_pickle=True)
        self.V=len(self.vocab)
        self.vmap={w:i for i,w in enumerate(self.vocab)}
        self.U=np.load(f'{out}/U.npy')
        self.Kb=np.load(f'{out}/Kb.npy'); self.Cb=np.load(f'{out}/Cb.npy')
        M=self.V+1
        id1=(self.Kb//M).astype(np.int64); id2=(self.Kb%M).astype(np.int64)
        Kr=id2*M+id1
        order=np.argsort(Kr,kind='mergesort')
        self.Kr=Kr[order]; self.Cr=self.Cb[order]
        self.M=M
        self._succ={}; self._pred={}
        self.alpha=0.1
    def ids(self,toks):
        g=self.vmap.get
        return np.fromiter((g(t,self.V) for t in toks),dtype=np.int32,count=len(toks))
    def _top_slice(self,keys,cnts,base,T):
        lo=int(np.searchsorted(keys,base*self.M)); hi=int(np.searchsorted(keys,(base+1)*self.M))
        if hi<=lo: return np.empty(0,np.int32),np.empty(0,np.int64)
        ids=(keys[lo:hi]-base*self.M).astype(np.int32); cc=cnts[lo:hi]
        if len(ids)>T:
            sel=np.argpartition(cc,-T)[-T:]
            ids=ids[sel]; cc=cc[sel]
        o=np.argsort(-cc); return ids[o],cc[o]
    def top_succ(self,a,T=100):
        r=self._succ.get((a,T))
        if r is None:
            r=self._top_slice(self.Kb,self.Cb,a,T); self._succ[(a,T)]=r
        return r
    def top_pred(self,b,T=100):
        r=self._pred.get((b,T))
        if r is None:
            r=self._top_slice(self.Kr,self.Cr,b,T); self._pred[(b,T)]=r
        return r
    def count(self,a,b):
        a=np.asarray(a); b=np.asarray(b)
        key=a.astype(np.int64)*self.M+b.astype(np.int64)
        idx=np.searchsorted(self.Kb,key)
        idx=np.clip(idx,0,len(self.Kb)-1)
        ok=self.Kb[idx]==key
        return np.where(ok,self.Cb[idx],0)
    def gap_candidates(self,a,b,Ts=100,Tp=100):
        si,sc=self.top_succ(a,Ts); pi,pc=self.top_pred(b,Tp)
        cand=np.unique(np.concatenate([si,pi]))
        return cand
    def score_candidates(self,a,b,cand):
        ca=self.count(a,cand); cb=self.count(cand,b)
        Ua=max(self.U[a],1); Uc=np.maximum(self.U[cand],1)
        p1=np.log((ca+self.alpha)/(Ua+self.alpha*self.V))
        p2=np.log((cb+self.alpha)/(Uc+self.alpha*self.V))
        return p1+p2, ca, cb
    def base_score(self,a,b):
        cab=self.count(np.array([a]),np.array([b]))[0]
        Ua=max(self.U[a],1)
        return np.log((cab+self.alpha)/(Ua+self.alpha*self.V))
    def predict_sentence(self,toks,Ts=100,Tp=100,topk=5):
        ids=self.ids(toks); m=len(ids)
        cands=[]
        if m<3: return []
        for k in range(1,m):  # insert before token k, k in 1..m-1
            a=int(ids[k-1]); b=int(ids[k])
            cand=self.gap_candidates(a,b,Ts,Tp)
            if len(cand)==0: continue
            sc,ca,cb=self.score_candidates(a,b,cand)
            base=self.base_score(a,b)
            # best few
            o=np.argsort(-sc)[:topk]
            for j in o:
                cands.append((k,int(cand[j]),float(sc[j]),float(sc[j]-base)))
        return cands  # list of (gap, word_id, score, gain)

if __name__=='__main__':
    lm=BigramLM()
    print('loaded V',lm.V,'bigrams',len(lm.Kb),'U sum',lm.U.sum())
    toks='Ditto her cut-offs .'.split(' ')
    print(lm.predict_sentence(toks)[:10])
