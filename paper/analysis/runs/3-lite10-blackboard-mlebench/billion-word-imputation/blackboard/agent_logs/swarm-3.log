import pickle, numpy as np, time, sys
from Levenshtein import distance as lev
HOLD='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
D=pickle.load(open('det_hold_mix.pkl','rb')); gp=D['gap_probs']; toks_det=D.get('tokens')
G=pickle.load(open('hold_chosen_gaps_mix.pkl','rb'))
zs=pickle.load(open('hold_mix_zs.pkl','rb')); ft=pickle.load(open('hold_mix_ft.pkl','rb')); base=pickle.load(open('hold_mix_base.pkl','rb'))
orig=[l.rstrip('\n') for l in open(HOLD+'/holdout_orig.txt')]
gapf=[l.rstrip('\n') for l in open(HOLD+'/holdout_gap.txt')]
meta=[l.rstrip('\n').split('\t') for l in open(HOLD+'/holdout_meta.tsv')][1:]
N=len(gp); W=[0.5,0.3,0.2]; Ws=sum(W); topk=20; level=1.25; lam=0.05
base_costs=np.array([lev(gapf[i],orig[i]) for i in range(N)])
COMMON=["the","a","an","to","of","and","in","that","is","for","on","it","was","with","as","at","by","be","this","from"]
def norm(d):
    s=sum(d.values()); return {w:v/s for w,v in d.items()} if s>0 else {}
def comb_at(i,k):
    comb={}
    for dump,wt in zip([zs,ft,base],W):
        g=dump[i].get(k)
        if g is None: continue
        d={}
        for w,p in zip(g['w'][:topk],g['p'][:topk]): d[w]=d.get(w,0.0)+p
        d=norm(d)
        for w,v in d.items(): comb[w]=comb.get(w,0.0)+wt*v/Ws
    return comb
def cands_for(ws,kind):
    c=set(ws)
    for w in ws:
        for L in range(1,len(w)+1): c.add(w[:L])
    if kind>=1:
        for w in ws:
            for L in range(1,len(w)+1): c.add(w[-L:])
            for pos in range(len(w)):
                if len(w)>1: c.add(w[:pos]+w[pos+1:])
    if kind>=2:
        for w in ws[:5]:
            if len(w)<=20:
                for a in range(len(w)):
                    for b in range(a+1,len(w)+1): c.add(w[a:b])
    c.update(COMMON); return c
# precompute per-sentence combined items + conf/k
pre=[]
for i in range(N):
    g=G[i]
    if not g: pre.append(None); continue
    k=int(g[0]); a=np.asarray(gp[i]); M=len(toks_det[i]) if toks_det is not None else len(gapf[i].split())
    if k<1 or k>M-1 or k>len(a): pre.append(None); continue
    conf=float(a[k-1]); comb=comb_at(i,k)
    if not comb: pre.append(None); continue
    items=sorted(comb.items(), key=lambda kv:-kv[1])[:topk]
    ws=[w for w,_ in items]; ps=np.array([x for _,x in items])
    lg=np.log(ps+1e-12)/level; ps=np.exp(lg-lg.max()); ps/=ps.sum()
    pre.append((k,conf,ws,ps))
for kind,name in [(0,'prefix20'),(1,'pre+suf+del1_20'),(2,'pre+suf+del1+substr5')]:
    t0=time.time(); chosen=[None]*N
    for i,r in enumerate(pre):
        if r is None: continue
        k,conf,ws,ps=r
        best=None;bw=None
        for c in cands_for(ws,kind):
            e=sum(ps[j]*lev(c,ws[j]) for j in range(len(ws)))+lam*len(c)
            if best is None or e<best: best=e;bw=c
        chosen[i]=(k,bw)
    print(f'[{name}] chosen in {time.time()-t0:.1f}s',flush=True)
    for tau in [0.45,0.50,0.55,0.60,0.65,0.70,0.75,0.80]:
        tot=0.0;app=0;loc=0
        for i,r in enumerate(pre):
            if r is None or r[1]<tau or chosen[i] is None: tot+=base_costs[i]; continue
            k,w=chosen[i]; tokss=gapf[i].split()
            tot+=lev(' '.join(tokss[:k]+[w]+tokss[k:]),orig[i]); app+=1
            loc+=(k==int(meta[i][2]))
        print(f'  {name} tau {tau:.2f}: metric {tot/N:.4f} apply {app/N:.3f} loc {loc/max(1,app):.3f}',flush=True)
PY
