from Levenshtein import distance as lev
HOLD='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
D=pickle.load(open('det_hold_mix.pkl','rb')); gp=D['gap_probs']; toks=D['tokens']
G=pickle.load(open('hold_chosen_gaps_mix.pkl','rb'))
zs=pickle.load(open('hold_mix_zs.pkl','rb')); ft=pickle.load(open('hold_mix_ft.pkl','rb')); base=pickle.load(open('hold_mix_base.pkl','rb'))
orig=[l.rstrip('\n') for l in open(HOLD+'/holdout_orig.txt')]; gapf=[l.rstrip('\n') for l in open(HOLD+'/holdout_gap.txt')]
meta=[l.rstrip('\n').split('\t') for l in open(HOLD+'/holdout_meta.tsv')][1:]
N=len(gp); W=[0.5,0.3,0.2]; Ws=sum(W); topk=20
base_costs=np.array([lev(gapf[i],orig[i]) for i in range(N)])
COMMON=["the","a","an","to","of","and","in","that","is","for","on","it","was","with","as","at","by","be","this","from"]
def norm(d):
