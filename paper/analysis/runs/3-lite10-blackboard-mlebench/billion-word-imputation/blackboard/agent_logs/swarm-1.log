def fuse(l1,l2,w1,w2,eps=1e-6):
    d={}
    for k,(ws,ps,w) in enumerate([(l1[0],l1[1],w1),(l2[0],l2[1],w2)]):
        for ww,p in zip(ws,ps):
            if ww not in d: d[ww]=[np.log(eps)]*2
