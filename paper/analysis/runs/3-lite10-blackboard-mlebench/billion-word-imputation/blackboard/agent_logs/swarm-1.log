import pickle,sys,argparse,time,csv
import numpy as np, torch
from Levenshtein import distance as lev
sys.path.insert(0,'scripts')
from fusion_lib import build_X
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import GroupKFold
from transformers import AutoTokenizer, AutoModelForMaskedLM
from word_at_oracle import build_vocab

def cw(ws,ps,lam=0.2):
    S=sum(ps) or 1; pf=[p/S for p in ps]; best=None;bu=None
    for u in ws:
        e=sum(pf[i]*lev(u,ws[i]) for i in range(len(ws)))+lam*len(u)
        if best is None or e<best: best=e;bu=u
    return bu
def ins(t,g,w): return ' '.join(t[:g])+' '+str(w)+' '+' '.join(t[g:])

class WordModel:
    def __init__(self,ckpt,bs=64,topk=20,frac=0.15):
        torch.cuda.set_per_process_memory_fraction(frac,0)
        self.tok=AutoTokenizer.from_pretrained(ckpt)
        self.m=AutoModelForMaskedLM.from_pretrained(ckpt,torch_dtype=torch.float16).cuda().eval()
        self.ids_all,self.id2w=build_vocab(self.tok); self.ids_t=torch.tensor(self.ids_all,device='cuda')
        self.bs=bs; self.topk=topk
    def predict(self,toks,gaps,bs=None):
        bs=bs or self.bs; out={}
        idxs=[i for i,g in enumerate(gaps) if g and g>=1 and g<=len(toks[i])-1]
        texts=[' '.join(toks[i][:gaps[i]]+[self.tok.mask_token]+toks[i][gaps[i]:]) for i in idxs]
        for s in range(0,len(texts),bs):
            chunk=texts[s:s+bs]
            enc=self.tok(chunk,padding=True,truncation=True,max_length=200,return_tensors='pt')
            ii=enc['input_ids'].cuda(); am=enc['attention_mask'].cuda()
            with torch.no_grad(), torch.autocast('cuda',dtype=torch.float16):
                lo=self.m(input_ids=ii,attention_mask=am).logits
            mp=(ii==self.tok.mask_token_id); idx=mp.float().argmax(1); ar=torch.arange(len(chunk),device='cuda')
            pr=torch.softmax(torch.log_softmax(lo[ar,idx].float(),-1)[:,self.ids_t],-1)
            k=min(self.topk,pr.size(1)); tv,ti=torch.topk(pr,k,-1); tv=tv.cpu().numpy(); ti=ti.cpu().numpy()
            for r in range(len(chunk)):
                i=idxs[s+r]; out[i]=([self.id2w[int(self.ids_all[ti[r,j]])] for j in range(k)],[float(tv[r,j]) for j in range(k)])
        return out

def load_det(path):
    return pickle.load(open(path,'rb'))

def build_all(D,tri,meta_or_none,use):
    toks=D['tokens']; gps=D['gap_probs']; dws=D['detwp']
    Xs=[None]*len(toks)
    for i in range(len(toks)):
        tri_i = tri[i] if (tri is not None and i<len(tri)) else None
        Xs[i]=build_X(toks[i],gps[i],dws[i],tri_i,None,use)
    return Xs

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--hold_det',required=True); ap.add_argument('--hold_tri',required=True)
    ap.add_argument('--hold_meta',required=True); ap.add_argument('--hold_orig',required=True)
    ap.add_argument('--test_det',required=True); ap.add_argument('--test_tri',required=True)
    ap.add_argument('--test_csv',default='/download_job_code/payload/sandbox/data/test_v2.txt')
    ap.add_argument('--signals',default='det+tri')
    ap.add_argument('--tau',type=float,default=-1.0)
    ap.add_argument('--wl_ckpt',default='roberta-large'); ap.add_argument('--wlam',type=float,default=0.2)
    ap.add_argument('--out_decisions',required=True); ap.add_argument('--out_submission',default='')
    ap.add_argument('--out_stats',default='')
    args=ap.parse_args()
    use=tuple(args.signals.split('+'))
    # holdout
    HD=load_det(args.hold_det); HT=pickle.load(open(args.hold_tri,'rb'))
    hmeta=[l.rstrip('\n').split('\t') for l in open(args.hold_meta)][1:]
    horig=[l.rstrip('\n') for l in open(args.hold_orig)]
    hX=build_all(HD,HT,None,use)
    valid=[i for i in range(len(hX)) if hX[i] is not None and len(hmeta[i])>3 and hmeta[i][2]!='-1']
    Xall=np.vstack([hX[i] for i in valid]); yall=np.hstack([(np.arange(1,hX[i].shape[0]+1)==int(hmeta[i][2])).astype(int) for i in valid])
    gall=np.repeat(np.array(valid),[hX[i].shape[0] for i in valid]); local=np.concatenate([np.arange(hX[i].shape[0]) for i in valid])
    print('holdout gaps',len(yall),'pos',yall.sum(),flush=True)
    # OOF posterior
    gkf=GroupKFold(n_splits=3); oof={}
    for tr,te in gkf.split(Xall,yall,gall):
        sc=StandardScaler().fit(Xall[tr]); clf=LogisticRegression(max_iter=3000,C=1.0).fit(sc.transform(Xall[tr]),yall[tr])
        pr=clf.predict_proba(sc.transform(Xall[te]))[:,1]
        for j,gi in enumerate(te): oof.setdefault(int(gall[gi]),{})[int(local[gi])]=pr[j]
    post={}
    for i in valid:
        arr=np.zeros(hX[i].shape[0])
        for gi,v in oof[i].items(): arr[gi]=v
        post[i]=arr/arr.sum()
    # word model on holdout chosen gaps
    wm=WordModel(args.wl_ckpt)
    hgaps=[0]*len(HD['tokens']); hg=[int(post[i].argmax())+1 if i in post else 0 for i in range(len(HD['tokens']))]
    wl=wm.predict(HD['tokens'],hg)
    # tune tau
    res=[]
    for tau in [0.3,0.4,0.5,0.55,0.6,0.65,0.7,0.75,0.8]:
        tot=0;app=0;lok=0
        for i in range(len(HD['tokens'])):
            base=lev(horig[i],' '.join(HD['tokens'][i]))
            if i not in post: tot+=base; continue
            q=post[i]; gs=int(q.argmax()); pb=float(q[gs])
            if pb<tau or i not in wl: tot+=base; continue
            g=gs+1; ws,ps=wl[i]; u=cw(ws,ps,args.wlam)
            tot+=lev(ins(HD['tokens'][i],g,u),horig[i]); app+=1; lok+=(g==int(hmeta[i][2]))
        res.append((tot/len(HD['tokens']),tau,app/len(HD['tokens']),lok/max(app,1)))
        print('OOF tau %.2f metric %.4f apply %.3f loc %.3f'%(res[-1][1],res[-1][0],res[-1][2],res[-1][3]),flush=True)
    best=min(res); tau=args.tau if args.tau>=0 else best[1]
    print('chosen tau',tau,'best',best,flush=True)
    # fit full fusion on all holdout valid gaps
    sc=StandardScaler().fit(Xall); clf=LogisticRegression(max_iter=3000,C=1.0).fit(sc.transform(Xall),yall)
    # test
    TD=load_det(args.test_det); TT=pickle.load(open(args.test_tri,'rb')) if args.test_tri!='none' else None
    tX=build_all(TD,TT,None,use)
    tgaps=[0]*len(TD['tokens']); tpost=[None]*len(TD['tokens']); tapplied=[False]*len(TD['tokens'])
    for i in range(len(TD['tokens'])):
        X=tX[i]
        if X is None: continue
        pr=clf.predict_proba(sc.transform(X))[:,1]
        q=pr/pr.sum(); tpost[i]=q
        gs=int(q.argmax()); pb=float(q[gs])
        if pb>=tau: tgaps[i]=gs+1; tapplied[i]=True
    print('test applied',sum(tapplied),'/',len(tapplied),flush=True)
    twl=wm.predict(TD['tokens'],[g if a else 0 for g,a in zip(tgaps,tapplied)])
    ids=TD.get('ids') or []
    # decisions
    dec=[]; stats=[]
    for i in range(len(TD['tokens'])):
        if not tapplied[i] or i not in twl: continue
        ws,ps=twl[i]; u=cw(ws,ps,args.wlam); g=tgaps[i]
        if u is None or not (1<=g<=len(TD['tokens'][i])-1): continue
        dec.append((ids[i] if ids else i,g,u))
        stats.append((ids[i] if ids else i,g,float(tpost[i][g-1]),u,len(TD['tokens'][i])))
    with open(args.out_decisions,'w') as f:
        for row in dec: f.write('%d\t%d\t%s\n'%row)
    print('decisions',len(dec),'->',args.out_decisions,flush=True)
    if args.out_stats:
        with open(args.out_stats,'w') as f:
            f.write('id\tgap\tpbest\tword\tntok\n')
            for row in stats: f.write('%d\t%d\t%.5f\t%s\t%d\n'%row)
    if args.out_submission:
        decd={r[0]:r for r in dec}
        with open(args.test_csv,newline='') as f: rr=csv.reader(f); next(rr); rows=[(int(r[0]),r[1]) for r in rr]
        with open(args.out_submission,'w',newline='') as f:
            w=csv.writer(f,quoting=csv.QUOTE_NONNUMERIC,lineterminator='\n'); w.writerow(['id','sentence'])
            for i,s in rows:
                if i in decd:
                    _,g,u=decd[i]; t=s.split(); s=ins(t,g,u)
                w.writerow([i,s])
        print('wrote submission',args.out_submission)

if __name__=='__main__': main()
