[0m$ [0mcd workspaces/arcturus_kappa && cat > scripts/extract_feats.py <<'EOF'
import sys, json, pickle, math, numpy as np, torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from common import build_candidate_vocab, insert_gap_seq
MODEL='roberta-large'
N=int(sys.argv[1]) if len(sys.argv)>1 else 800
dels=[l.rstrip('\n') for l in open('val_del.txt')][:N]
refs=[l.rstrip('\n') for l in open('val_ref.txt')][:N]
meta=[json.loads(l) for l in open('val_meta.jsonl')][:N]
ng=pickle.load(open('ngram.pkl','rb'))
uni,bi,tri=ng['uni'],ng['bi'],ng['tri']
tok=AutoTokenizer.from_pretrained(MODEL)
model=AutoModelForMaskedLM.from_pretrained(MODEL).cuda().eval()
cid,cwords=build_candidate_vocab(tok); cid_t=torch.tensor(cid,device='cuda')
mask=tok.mask_token
def mlm_gap(tokens):
    n=len(tokens); seqs=[insert_gap_seq(tokens,g,mask) for g in range(1,n)]
    enc=tok(seqs,padding=True,return_tensors='pt'); enc={k:v.cuda() for k,v in enc.items()}
    with torch.no_grad(): out=model(**enc).logits
    mid=(enc['input_ids']==tok.mask_token_id); idx=mid.float().argmax(1)
    ar=torch.arange(len(seqs),device='cuda')
    logp=torch.log_softmax(out[ar,idx].float(),dim=-1)[:,cid_t]
    return logp.cpu().numpy()
EPS=1e-9
out=[]
for si in range(len(dels)):
    tokens=dels[si].split(); n=len(tokens); j=meta[si]['j']
    logp=mlm_gap(tokens); cw=cwords
    feats=[]; tops=[]
    for g in range(1,n):
        a,b=tokens[g-1],tokens[g]
        c1=uni.get(a,0)
        p_bi=(bi.get((a,b),0)+EPS)/(c1+EPS)
        p_bi_rev=(bi.get((b,a),0)+EPS)/(uni.get(b,0)+EPS)
        if g>=2:
            d=tokens[g-2]; ctri=tri.get((d,a,b),0); cbi=(bi.get((d,a),0)+EPS)
            p_tri=(ctri+EPS)/(cbi)
        else: p_tri=1.0
        mlp=float(logp[g-1].max()); wi=int(logp[g-1].argmax())
        feats.append([mlp, math.log(p_bi), math.log(p_bi_rev), math.log(p_tri), c1])
        tops.append(cw[wi])
    out.append({'tokens':tokens,'j':j,'feats':feats,'tops':tops,'ref':refs[si],'del':dels[si]})
pickle.dump(out,open('feats_%d.pkl'%N,'wb'),protocol=4)
print('saved',len(out))
EOF
