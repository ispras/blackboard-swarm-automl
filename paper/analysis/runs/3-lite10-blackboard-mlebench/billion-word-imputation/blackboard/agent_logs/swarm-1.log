import pickle,argparse,time
import numpy as np, torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
import sys; sys.path.insert(0,'scripts')
from word_at_oracle import build_vocab
def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--dump',default='dump_ck2000_5000.pkl')
    ap.add_argument('--win',type=int,default=10); ap.add_argument('--ckpt',default='roberta-large')
    ap.add_argument('--out',required=True); ap.add_argument('--bs',type=int,default=48)
    ap.add_argument('--gpu_frac',type=float,default=0.25)
    args=ap.parse_args(); torch.cuda.set_per_process_memory_fraction(args.gpu_frac,0)
    D=pickle.load(open(args.dump,'rb')); toks=D['tokens']; meta=D['meta']
    tok=AutoTokenizer.from_pretrained(args.ckpt); m=AutoModelForMaskedLM.from_pretrained(args.ckpt,torch_dtype=torch.float16).cuda().eval()
    ids_all,id2w=build_vocab(tok); ids_t=torch.tensor(ids_all,device='cuda')
    items=[]
    for i in range(len(toks)):
        g=int(meta[i][2]); t=toks[i]
        if g<1 or g>len(t)-1: continue
        lo=max(0,g-args.win); hi=min(len(t),g+args.win)
        tt=t[lo:hi]; gg=g-lo
        items.append((i,' '.join(tt[:gg]+[tok.mask_token]+tt[gg:])))
    out={}; t0=time.time()
    for s in range(0,len(items),args.bs):
        chunk=items[s:s+args.bs]
        enc=tok([c[1] for c in chunk],padding=True,truncation=True,max_length=80,return_tensors='pt')
        ii=enc['input_ids'].cuda(); am=enc['attention_mask'].cuda()
        with torch.no_grad(), torch.autocast('cuda',dtype=torch.float16):
            lo=m(input_ids=ii,attention_mask=am).logits
        mp=(ii==tok.mask_token_id); idx=mp.float().argmax(1); ar=torch.arange(len(chunk),device='cuda')
        pr=torch.softmax(torch.log_softmax(lo[ar,idx].float(),-1)[:,ids_t],-1)
        k=20; tv,ti=torch.topk(pr,k,-1); tv=tv.cpu().numpy(); ti=ti.cpu().numpy()
        for r in range(len(chunk)):
            out[chunk[r][0]]=([id2w[int(ids_all[ti[r,j]])] for j in range(k)],[float(tv[r,j]) for j in range(k)])
    pickle.dump(out,open(args.out,'wb'),protocol=4); print('saved',args.out,len(out),round(time.time()-t0,1))
if __name__=='__main__': main()
