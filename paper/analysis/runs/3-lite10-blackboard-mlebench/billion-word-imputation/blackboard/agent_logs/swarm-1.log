import pickle, numpy as np
from Levenshtein import distance as lev
d=pickle.load(open('feats_800.pkl','rb'))
N=len(d)
names=['mlm_best','logbi','logbi_rev','logtri','c1']
F=[np.array(x['feats']) for x in d]
# base metrics
none=[lev(x['ref'],x['del']) for x in d]
print('none',np.mean(none))
def eval_signal(score_fn, label):
    acc=0; levs=[]; levs_oracle=[]
    for x,f in zip(d,F):
        s=score_fn(f)   # [n-1] higher=more likely gap
        g=int(s.argmax())+1
        acc+= (g==x['j'])
        def mk(g,w): return ' '.join(x['tokens'][:g])+' '+w+' '+' '.join(x['tokens'][g:])
        levs.append(lev(x['ref'],mk(g,x['tops'][g-1])))
        levs_oracle.append(lev(x['ref'],mk(x['j'],x['tops'][x['j']-1])))
    print(f'{label:28s} gapacc={acc/N:.3f} lev={np.mean(levs):.3f} oracleGapWord={np.mean(levs_oracle):.3f}')
    return np.array(levs)
# individual (higher better)
eval_signal(lambda f: f[:,0], 'mlm_best')
eval_signal(lambda f: f[:,1], 'logbi')
eval_signal(lambda f: f[:,2], 'logbi_rev')
eval_signal(lambda f: f[:,3], 'logtri')
eval_signal(lambda f: -f[:,4], '-c1')
eval_signal(lambda f: f[:,1]+f[:,2], 'logbi+rev')
eval_signal(lambda f: f[:,1]+f[:,2]+f[:,3], 'bi+rev+tri')
def z(s): return (s-s.mean())/(s.std()+1e-9)
for wm in [0,0.5,1,2]:
    for wn in [1]:
        eval_signal(lambda f,wm=wm: wm*z(f[:,0]) + wn*z(f[:,1]+f[:,2]+f[:,3]), f'z: {wm}*mlm + ngram')
# mlm + bi
for wm in [0.5,1,2,3]:
    eval_signal(lambda f,wm=wm: wm*z(f[:,0]) + z(f[:,1]+f[:,2]), f'z: {wm}*mlm + bi')
EOF
