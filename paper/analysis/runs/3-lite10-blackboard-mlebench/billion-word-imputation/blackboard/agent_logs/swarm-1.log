A=pickle.load(open('wl_oracle_5000.pkl','rb')); B=pickle.load(open('wl_electra_5000.pkl','rb'))
def cw(ws,ps,lam=0.0):
    S=sum(ps) or 1; pf=[p/S for p in ps]; best=None;bu=None
    for u in ws:
        e=sum(pf[i]*lev(u,ws[i]) for i in range(len(ws)))+lam*len(u)
