import pickle,sys,argparse,time
import numpy as np, torch
from transformers import AutoTokenizer, AutoModelForMaskedLM

def build_vocab(tok):
    V=tok.vocab_size; ids=[]; id2w={}
    for i in range(V):
        s=tok.convert_ids_to_tokens(i)
        if s is None or s.startswith('<') or s.startswith('Ġ<'): continue
        if s.startswith('Ġ'):
            w=s[1:]
            if w=='': continue
            id2w[i]=w; ids.append(i)
    return np.array(ids,dtype=np.int64), id2w

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ckpt',required=True)
    ap.add_argument('--gap',required=True)
    ap.add_argument('--limit',type=int,default=0)
    ap.add_argument('--topk',type=int,default=5)
    ap.add_argument('--bs',type=int,default=384)
    ap.add_argument('--maxlen',type=int,default=200)
    ap.add_argument('--out',required=True)
    ap.add_argument('--device',default='cuda')
    args=ap.parse_args()
    toks=[l.rstrip('\n').split() for l in open(args.gap)]
    if args.limit: toks=toks[:args.limit]
    tok=AutoTokenizer.from_pretrained(args.ckpt); model=AutoModelForMaskedLM.from_pretrained(args.ckpt).to(args.device).eval()
    ids_all,id2w=build_vocab(tok); ids_t=torch.tensor(ids_all,device=args.device)
    meta=[];texts=[]
    for si,t in enumerate(toks):
        for g in range(1,len(t)):
            texts.append(' '.join(t[:g]+['<mask>']+t[g:])); meta.append((si,g))
    print('variants',len(texts),flush=True)
    out=[{} for _ in toks]
    t0=time.time()
    for s in range(0,len(texts),args.bs):
        chunk=texts[s:s+args.bs]
        enc=tok(chunk,padding=True,truncation=True,max_length=args.maxlen,return_tensors='pt')
        ii=enc['input_ids'].to(args.device); am=enc['attention_mask'].to(args.device)
        with torch.no_grad(): lo=model(input_ids=ii,attention_mask=am).logits
        mp=(ii==tok.mask_token_id); idx=mp.float().argmax(1)
        ar=torch.arange(len(chunk),device=args.device)
        pr=torch.softmax(torch.log_softmax(lo[ar,idx].float(),-1)[:,ids_t],-1)
        k=min(args.topk,pr.size(1)); tv,ti=torch.topk(pr,k,-1)
        tv=tv.cpu().numpy(); ti=ti.cpu().numpy()
        for r in range(len(chunk)):
            si,g=meta[s+r]
            ws=[id2w[int(ids_all[ti[r,j]])] for j in range(k)]
            ps=[float(tv[r,j]) for j in range(k)]
            out[si][g]={'w':ws,'p':ps,'maxp':ps[0] if ps else 0.0}
        if s%(args.bs*20)==0: print(s,'/',len(texts),round(time.time()-t0,1),flush=True)
    pickle.dump(out,open(args.out,'wb'),protocol=4)
    print('saved',args.out,'t',round(time.time()-t0,1))

if __name__=='__main__': main()
