import sys, pickle, time
from collections import Counter
num=int(sys.argv[1]) if len(sys.argv)>1 else 2000000
t0=time.time()
uni=Counter(); bi=Counter(); tri=Counter()
with open('train_v2.txt') as f:
    for i,line in enumerate(f):
        if i>=num: break
        t=line.split()
        uni.update(t)
        for a,b in zip(t,t[1:]): bi[(a,b)]+=1
        for a,b,c in zip(t,t[1:],t[2:]): tri[(a,b,c)]+=1
        if (i+1)%500000==0: print(i+1, 'bi uniq',len(bi),'tri uniq',len(tri),'t',round(time.time()-t0),flush=True)
print('done', len(uni),len(bi),len(tri),'t',round(time.time()-t0))
with open('ngram.pkl','wb') as f:
    pickle.dump({'uni':uni,'bi':bi,'tri':tri,'num':num},f,protocol=4)
print('saved')
EOF
