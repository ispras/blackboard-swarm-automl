import pickle,sys,argparse,time
import numpy as np, torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
sys.path.insert(0,'scripts')
from detok import detok_around
from word_at_oracle import build_vocab
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ckpt',default='roberta-large'); ap.add_argument('--dump',required=True)
    ap.add_argument('--topk',type=int,default=20); ap.add_argument('--bs',type=int,default=64)
    ap.add_argument('--maxlen',type=int,default=200); ap.add_argument('--out',required=True)
    ap.add_argument('--gpu_frac',type=float,default=0.15)
    args=ap.parse_args()
    torch.cuda.set_per_process_memory_fraction(args.gpu_frac,0)
    D=pickle.load(open(args.dump,'rb')); toks=D['tokens']; meta=D['meta']
    tok=AutoTokenizer.from_pretrained(args.ckpt); model=AutoModelForMaskedLM.from_pretrained(args.ckpt,torch_dtype=torch.float16).cuda().eval()
    ids_all,id2w=build_vocab(tok); ids_t=torch.tensor(ids_all,device='cuda')
    texts=[];keys=[]
    for i in range(len(toks)):
        g=int(meta[i][2]); t=toks[i]
        if g<1 or g>len(t)-1: continue
        texts.append(detok_around(t,g,tok.mask_token)); keys.append(i)
    print('n',len(texts),flush=True); out={}; t0=time.time()
    for s in range(0,len(texts),args.bs):
        chunk=texts[s:s+args.bs]
        enc=tok(chunk,padding=True,truncation=True,max_length=args.maxlen,return_tensors='pt')
        ii=enc['input_ids'].cuda(); am=enc['attention_mask'].cuda()
        with torch.no_grad(), torch.autocast('cuda',dtype=torch.float16):
            lo=model(input_ids=ii,attention_mask=am).logits
        mp=(ii==tok.mask_token_id); idx=mp.float().argmax(1); ar=torch.arange(len(chunk),device='cuda')
        pr=torch.softmax(torch.log_softmax(lo[ar,idx].float(),-1)[:,ids_t],-1)
        k=min(args.topk,pr.size(1)); tv,ti=torch.topk(pr,k,-1); tv=tv.cpu().numpy(); ti=ti.cpu().numpy()
        for r in range(len(chunk)):
            out[keys[s+r]]=([id2w[int(ids_all[ti[r,j]])] for j in range(k)],[float(tv[r,j]) for j in range(k)])
    pickle.dump(out,open(args.out,'wb'),protocol=4); print('saved',args.out,round(time.time()-t0,1))
if __name__=='__main__': main()
