import torch, numpy as np
from transformers import AutoTokenizer

def build_candidate_vocab(tok):
    vocab=tok.get_vocab()
    ids=[]; words=[]
    special=set(tok.all_special_ids)
    for t,i in vocab.items():
        if i in special: continue
        if not t.startswith('Ġ'): continue
        s=tok.convert_tokens_to_string([t]).strip()
        if s=='' or ' ' in s: continue
        ids.append(i); words.append(s)
    # punctuation may also appear non-G-space in mid-sentence? add common punctuation forms
    extra=[',','.',';',':','!','?','"','\'s','\'','--','-','(',')','%','$','&','@','#','``',"''"]
    for s in extra:
        for form in (s,):
            ii=tok.convert_tokens_to_ids('Ġ'+s)
            if ii is not None and ii!=tok.unk_token_id and ii not in ids:
                ids.append(ii); words.append(s)
    return np.array(ids), words

def insert_gap_seq(tokens, g, mask):
    return ' '.join(tokens[:g]) + ' ' + mask + ' ' + ' '.join(tokens[g:])
EOF
cat > scripts/mlm_detect.py <<'EOF'
import sys, json, numpy as np, torch, time
from transformers import AutoTokenizer, AutoModelForMaskedLM
from common import build_candidate_vocab, insert_gap_seq
from Levenshtein import distance as lev

MODEL=sys.argv[1] if len(sys.argv)>1 else 'roberta-large'
N=int(sys.argv[2]) if len(sys.argv)>2 else 1000
dels=[l.rstrip('\n') for l in open('val_del.txt')][:N]
refs=[l.rstrip('\n') for l in open('val_ref.txt')][:N]
meta=[json.loads(l) for l in open('val_meta.jsonl')][:N]
tok=AutoTokenizer.from_pretrained(MODEL)
model=AutoModelForMaskedLM.from_pretrained(MODEL).cuda().eval()
cid,cwords=build_candidate_vocab(tok)
cid_t=torch.tensor(cid,device='cuda')
mask=tok.mask_token
print('cands',len(cid),'mask',mask, flush=True)

def score_sentence(tokens):
    # returns array [n-1, V] logprobs restricted to candidates for each gap g=1..n-1
    n=len(tokens)
    seqs=[insert_gap_seq(tokens,g,mask) for g in range(1,n)]
    enc=tok(seqs,padding=True,return_tensors='pt')
    enc={k:v.cuda() for k,v in enc.items()}
    with torch.no_grad():
        out=model(**enc).logits
    # locate mask positions
    mid=(enc['input_ids']==tok.mask_token_id)
    idx=mid.float().argmax(1)  # [B]
    ar=torch.arange(len(seqs),device='cuda')
    logits=out[ar,idx]  # [B,V]
    logp=torch.log_softmax(logits.float(),dim=-1)[:,cid_t]  # [B,C]
    return logp.cpu().numpy(), cwords

gap_correct=0; tot=0
res=[]
t0=time.time()
for si in range(len(dels)):
    tokens=dels[si].split()
    if len(tokens)<2: continue
    logp,cw=score_sentence(tokens)
    best=logp.max(axis=1)
    gpred=int(best.argmax())+1   # g index 1..n-1
    jtrue=meta[si]['j']
    ok = (gpred==jtrue)
    gap_correct+=ok
    # top word at predicted gap
    gi=gpred-1
    wi=int(logp[gi].argmax())
    bestword=cw[wi]
    # build submitted sentence
    def mk(g,w):
        return ' '.join(tokens[:g])+' '+w+' '+' '.join(tokens[g:])
    sub=mk(gpred,bestword)
    d_insert=lev(refs[si],sub)
    d_none=lev(refs[si],dels[si])
    # oracle gap, same word method
    subo=mk(jtrue,cw[int(logp[jtrue-1].argmax())])
    d_oracle_gap=lev(refs[si],subo)
    res.append((d_none,d_insert,d_oracle_gap,float(best[gi]),float(logp[jtrue-1].max()),ok))
    tot+=1
    if (si+1)%200==0:
        print(si+1,'gapacc',gap_correct/tot,'elapsed',round(time.time()-t0,1), flush=True)
res=np.array(res)
print('MODEL',MODEL,'N',tot)
print('gap accuracy',gap_correct/tot)
print('mean lev none',res[:,0].mean())
print('mean lev insert(argmax gap+word)',res[:,1].mean())
print('mean lev oracle-gap word',res[:,2].mean())
np.save('res_%s.npy'%MODEL.replace('/','_'),res)
EOF
