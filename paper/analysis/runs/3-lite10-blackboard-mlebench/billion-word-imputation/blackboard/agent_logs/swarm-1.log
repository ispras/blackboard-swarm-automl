import pickle,argparse
import numpy as np
from Levenshtein import distance as lev
COMMON=["the","a","an","to","of","and","in","that","is","for","on","it","was","with","as","at","by","be","this","from"]
def norm(w,p):
    s=sum(p) or 1; return {a:b/s for a,b in zip(w,p)}
def cands(ws):
    c=set(ws); c.update(COMMON)
    for w in ws:
        n=len(w)
        for L in range(1,n): c.add(w[:L]); c.add(w[L:])
        for i in range(n): c.add(w[:i]+w[i+1:])
    return list(c)
def choose(comb,level,lam):
    items=sorted(comb.items(),key=lambda kv:-kv[1])[:20]
    ws=[w for w,_ in items]; ps=np.array([v for _,v in items],float)
    lg=np.log(ps+1e-12)/level; ps=np.exp(lg-lg.max()); ps/=ps.sum()
    best=None;bw=None
    for c in cands(ws):
        e=float(sum(ps[j]*lev(c,ws[j]) for j in range(len(ws))))+lam*len(c)
        if best is None or e<best: best=e;bw=c
    cw=float(sum(ps[j]*lev(bw,ws[j]) for j in range(len(ws))))
    return bw,cw
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--weights',default='0.38,0.22,0.15,0.25'); ap.add_argument('--level',type=float,default=1.0)
    ap.add_argument('--lam',type=float,default=0.08); ap.add_argument('--gate',type=int,default=1)
    ap.add_argument('--taulo',type=float,default=0.30); ap.add_argument('--cwmax',type=float,default=0.35)
    args=ap.parse_args()
    W=[float(x) for x in args.weights.split(',')]
    gaps=pickle.load(open('hold_chosen_gaps_mix3.pkl','rb')); conf=np.load('hold_conf_mix3.npy')
    dumps=[pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/hold_mix3_zs.pkl','rb')),
           pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/hold_mix3_ft.pkl','rb')),
           pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/hold_mix3_base.pkl','rb')),
           pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/hold_mix3_alb.pkl','rb'))]
    toks=[l.rstrip('\n').split() for l in open('/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout/holdout_gap.txt')]
    orig=[l.rstrip('\n') for l in open('/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout/holdout_orig.txt')]
    N=len(toks); base=[lev(orig[i],' '.join(toks[i])) for i in range(N)]
    rec=[None]*N
    for i in range(N):
        k=gaps[i]
        if not k or k<1 or k>len(toks[i])-1: continue
        comb={}
        for dump,wt in zip(dumps,W):
            if wt<=0: continue
            g=dump[i].get(k) if i<len(dump) else None
            if not g: continue
            d=norm(g['w'][:20],g['p'][:20])
            for w,v in d.items(): comb[w]=comb.get(w,0)+wt*v
        if not comb: continue
        s,cw=choose(comb,args.level,args.lam); rec[i]=(k,s,cw)
    def metric(rule):
        tot=0;app=0
        for i in range(N):
            if rec[i] is None: tot+=base[i]; continue
            k,s,cw=rec[i]; c=float(conf[i])
            ins = c>=0.50
            if not ins and args.gate and args.taulo<=c<0.50 and cw<=args.cwmax: ins=True
            if ins: tot+=lev(' '.join(toks[i][:k]+[s]+toks[i][k:]),orig[i]); app+=1
            else: tot+=base[i]
        return tot/N,app/N
    if args.gate:
        m,a=metric(1); print('W',W,'level',args.level,'lam',args.lam,'GATE taulo',args.taulo,'cwmax',args.cwmax,'metric',round(m,4),'apply',round(a,4))
    else:
        m,a=metric(0); print('W',W,'level',args.level,'lam',args.lam,'NO-GATE metric',round(m,4),'apply',round(a,4))
if __name__=='__main__': main()
