import pickle,numpy as np
from Levenshtein import distance as lev
D=pickle.load(open('dump_ck2000_5000.pkl','rb')); toks=D['tokens']; meta=D['meta']; orig=D['orig']
A=pickle.load(open('wl_oracle_5000.pkl','rb')); X=pickle.load(open('wl_xlnet_5000.pkl','rb'))
M=pickle.load(open('mlm_allgaps_5000.pkl','rb'))  # base at all gaps
def cw(ws,ps,lam=0.0):
    ps=np.array(ps,dtype=float); S=ps.sum() or 1; pf=ps/S; best=None;bu=None
    for u in ws:
        e=sum(pf[i]*lev(u,ws[i]) for i in range(len(ws)))+lam*len(u)
        if best is None or e<best: best=e;bu=u
    return bu
def fuse(lst,weights,eps=1e-6):
    d={}
    for k,((ws,ps),w) in enumerate(zip(lst,weights)):
        for ww,p in zip(ws,ps):
            if ww not in d: d[ww]=[np.log(eps)]*len(lst)
            d[ww][k]=w*np.log(max(p,eps))
    items=sorted([(w,sum(v)) for w,v in d.items()],key=lambda x:-x[1])[:25]
    mx=items[0][1]; ex=np.exp(np.array([s for w,s in items])-mx); return [w for w,s in items],(ex/ex.sum()).tolist()
def ins(t,g,w): return ' '.join(t[:g])+' '+str(w)+' '+' '.join(t[g:])
rows=[]
for i in range(len(toks)):
    g=int(meta[i][2])
    if g<1 or i not in A or i not in X: continue
    md=M[i].get(g) if i<len(M) else None
    rows.append((i,g,A[i],X[i],md,meta[i][3]))
print('rows',len(rows))
def ev(name,fn):
    cs=[];acc=[]
    for (i,g,a,x,md,rw) in rows:
        ws,ps=fn(a,x,md); u=cw(ws,ps); cs.append(lev(ins(toks[i],g,u),orig[i])); acc.append(u==rw)
    print(f'{name:24s} cost {np.mean(cs):.4f} acc {np.mean(acc):.4f}')
ev('roberta-large',lambda a,x,md:a)
ev('xlnet-large',lambda a,x,md:x)
for w in [(1,0.3),(1,0.5),(1,1),(0.5,1),(2,1)]:
    ev(f'rl,xl={w}',lambda a,x,md,w=w:fuse([a,x],list(w)))
for w in [(1,0.5,0.2),(1,0.5,0.5),(1,1,0.3)]:
    ev(f'rl,xl,base={w}',lambda a,x,md,w=w:fuse([a,x,md],[list(w)[0],list(w)[1],list(w)[2]]) if md else a)
