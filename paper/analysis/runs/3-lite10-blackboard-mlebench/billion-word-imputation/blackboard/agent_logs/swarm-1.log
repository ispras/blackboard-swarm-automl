import pickle,argparse
import numpy as np
from Levenshtein import distance as lev
COMMON=["the","a","an","to","of","and","in","that","is","for","on","it","was","with","as","at","by","be","this","from"]
def norm(w,p):
    s=sum(p) or 1; return {a:b/s for a,b in zip(w,p)}
def cands(ws):
    c=set(ws); c.update(COMMON)
    for w in ws:
        n=len(w)
        for L in range(1,n): c.add(w[:L]); c.add(w[L:])
        for i in range(n): c.add(w[:i]+w[i+1:])
    return list(c)
def choose(comb,level,lam):
    items=sorted(comb.items(),key=lambda kv:-kv[1])[:20]
    ws=[w for w,_ in items]; ps=np.array([v for _,v in items],float)
    lg=np.log(ps+1e-12)/level; ps=np.exp(lg-lg.max()); ps/=ps.sum()
    best=None;bw=None
    for c in cands(ws):
        e=float(sum(ps[j]*lev(c,ws[j]) for j in range(len(ws))))+lam*len(c)
        if best is None or e<best: best=e;bw=c
    cw=float(sum(ps[j]*lev(bw,ws[j]) for j in range(len(ws))))
    return bw,cw
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--weights',default='0.38,0.22,0.15,0.25'); ap.add_argument('--level',type=float,default=1.0)
    ap.add_argument('--lam',type=float,default=0.08); ap.add_argument('--taulo',type=float,default=0.30)
    ap.add_argument('--cwmax',type=float,default=0.40); ap.add_argument('--out',default='decisions_v4_indep.tsv')
    args=ap.parse_args(); W=[float(x) for x in args.weights.split(',')]
    gaps=pickle.load(open('test_chosen_gaps_mix3.pkl','rb')); conf=np.load('test_conf_mix3.npy')
    dumps=[pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/test_v3_zs.pkl','rb')),
           pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/test_v3_ft.pkl','rb')),
           pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/test_v3_base.pkl','rb')),
           pickle.load(open('/download_job_code/payload/sandbox/workspaces/spica_psi/test_v3_alb.pkl','rb'))]
    n=len(conf); out=[]
    for i in range(n):
        c=float(conf[i])
        if c<args.taulo: continue
        k=gaps[i]
        if not k or k<1: continue
        if c<0.50:
            pass
        comb={}
        for dump,wt in zip(dumps,W):
            g=dump[i].get(k) if i<len(dump) else None
            if not g: continue
            d=norm(g['w'][:20],g['p'][:20])
            for w,v in d.items(): comb[w]=comb.get(w,0)+wt*v
        if not comb: continue
        s,cw=choose(comb,args.level,args.lam)
        ins = c>=0.50 or (args.taulo<=c<0.50 and cw<=args.cwmax)
        if ins: out.append((i,k,s,cw,c))
        if i%50000==0: print('i',i,'out',len(out),flush=True)
    with open(args.out,'w') as f:
        for (i,k,s,cw,c) in out: f.write(f'{i}\t{k}\t{s}\n')
    print('decisions',len(out),'->',args.out)
if __name__=='__main__': main()
EOF
