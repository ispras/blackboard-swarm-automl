import zlib, numpy as np, random
random.seed(0)
N=29998384
# hash first 25M lines
lim=25000000
h=np.empty(lim,dtype=np.uint64)
with open('train_v2.txt','rb') as f:
    for i in range(lim):
        line=f.readline()
        h[i]=zlib.crc32(line.rstrip(b'\n')) & 0xffffffff
h.sort()
import bisect
def has(x): 
    x=x & 0xffffffff
    i=np.searchsorted(h,x); return i<len(h) and h[i]==x
# check last 12000 originals and deletions
refs=[l.rstrip('\n') for l in open('val_ref.txt')]
dels=[l.rstrip('\n') for l in open('val_del.txt')]
cnt_ref=sum(has(zlib.crc32(r.encode())) for r in refs)
cnt_del=sum(has(zlib.crc32(d.encode())) for d in dels)
print('val originals found verbatim in first25M:',cnt_ref,'/',len(refs))
print('val deleted found verbatim in first25M:',cnt_del,'/',len(dels))
# baseline duplicate rate among first 25M: sample 200k lines from 25M..26M
sample=[]
with open('train_v2.txt','rb') as f:
    for i,line in enumerate(f):
        if i<25000000: continue
        if i>=25200000: break
        sample.append(zlib.crc32(line.rstrip(b'\n'))&0xffffffff)
print('exact dup rate in random 200k vs first25M:', np.mean([has(x) for x in sample]))
EOF
