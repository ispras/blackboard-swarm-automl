orig=[l.rstrip('\n') for l in open('/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout/holdout_orig.txt')]
meta=[l.rstrip('\n').split('\t') for l in open('/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout/holdout_meta.tsv')][1:]
recs=[]
for i in range(len(toks)):
    k=gaps[i]; c=float(conf[i]); base=lev(orig[i],' '.join(toks[i]))
    r={'i':i,'base':base,'conf':c,'gap':k}
    if not k or k<1 or k>len(toks[i])-1 or c<0.30:
        r['ins']=False; recs.append(r); continue
    comb={}
    for dump,wt in zip(dumps,W):
        g=dump[i].get(k) if i<len(dump) else None
        if not g: continue
        d=norm(g['w'][:20],g['p'][:20])
        for w,v in d.items(): comb[w]=comb.get(w,0)+wt*v
    s,cw=choose(comb,1.0,0.08)
    ins = c>=0.5 or (c>=0.30 and cw<=0.40)
    r.update({'ins':ins,'s':s,'cw':cw,'len':len(s),'loc':(k==int(meta[i][2])),'word_exact':(s==meta[i][3]),
              'cost':lev(' '.join(toks[i][:k]+[s]+toks[i][k:]),orig[i]) if ins else base})
    recs.append(r)
pickle.dump(recs,open('v4_decomp.pkl','wb'),protocol=4)
metric=np.mean([r['cost'] for r in recs]); app=[r for r in recs if r.get('ins')]
print('v4 metric',round(metric,4),'apply',round(len(app)/len(recs),4))
na=[r for r in recs if not r.get('ins')]
print('not-applied',len(na),'cost',round(np.mean([r['base'] for r in na]),3),'contrib',round(sum(r['base'] for r in na)/len(recs),3))
lo=[r for r in app if not r['loc']]; hi=[r for r in app if r['loc']]
print('applied-loc-correct',len(hi),'cost',round(np.mean([r['cost'] for r in hi]),3),'word_exact_rate',round(np.mean([r['word_exact'] for r in hi]),3))
print('applied-loc-WRONG',len(lo),'cost',round(np.mean([r['cost'] for r in lo]),3))
print('word_exact overall',round(np.mean([r.get('word_exact',False) for r in app]),3))
print('mean inserted len',round(np.mean([r['len'] for r in app]),3))
