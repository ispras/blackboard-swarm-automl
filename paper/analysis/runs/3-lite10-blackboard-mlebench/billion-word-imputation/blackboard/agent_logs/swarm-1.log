import pickle,sys,argparse,json
import numpy as np
from Levenshtein import distance as lev

def load(p): return pickle.load(open(p,'rb'))

def choose_word(words,probs,lam=0.0):
    k=len(words)
    if k==0: return None
    S=sum(probs)
    if S<=0: return words[0]
    pf=[p/S for p in probs]
    best=None;bestu=None
    for u in words:
        e=sum(pf[i]*lev(u,words[i]) for i in range(k)) + lam*len(u)
        if best is None or e<best: best=e;bestu=u
    return bestu

def choose_word_top1(words,probs,lam=0.0):
    return words[0] if words else None

def ins(tokens,g,w): return ' '.join(tokens[:g])+' '+w+' '+' '.join(tokens[g:])

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--dump',required=True)
    ap.add_argument('--lam',type=float,default=0.0)
    ap.add_argument('--strategy',default='elev')  # elev|top1
    ap.add_argument('--skip_trunc',action='store_true')
    ap.add_argument('--save_records',default='')
    args=ap.parse_args()
    d=load(args.dump); toks=d['tokens']; res=d['res']; meta=d['meta']; orig=d['orig']
    N=len(toks)
    rows=[]
    for i in range(N):
        r=res[i]; t=toks[i]; n=len(t)
        rm_idx=int(meta[i][2]) if meta else -1
        rm_word=meta[i][3] if meta else None
        base=lev(orig[i],' '.join(t)) if orig else 0
        gp=r['gap_probs']
        if len(gp)==0 or (args.skip_trunc and r['trunc']):
            rows.append(dict(i=i,base=base,applied=False,gap=-1,pbest=0,word=None,pred=' '.join(t),
                             gap_ok=False,word_ok=False,trunc=r['trunc'],rm_idx=rm_idx))
            continue
        gstar=int(gp.argmax()); pbest=float(gp[gstar])
        words=r['words'][gstar]; probs=r['probs'][gstar]
        if args.strategy=='elev': w=choose_word(words,probs,args.lam)
        else: w=words[0]
        rows.append(dict(i=i,base=base,applied=True,gap=gstar+1,pbest=pbest,word=w,
                         pred=ins(t,gstar+1,w),gap_ok=(gstar+1==rm_idx),
                         word_ok=(w==rm_word),trunc=r['trunc'],rm_idx=rm_idx))
    # gap accuracy (all, excluding trunc)
    valid=[r for r in rows if not r['trunc']]
    gapacc=np.mean([r['gap_ok'] for r in valid]) if valid else 0
    # oracle gap + predicted word cost: use g=rm_idx, word from that gap (top1/elev)
    print('N',N,'trunc',sum(r['trunc'] for r in rows),'gap_acc(argmax)',round(gapacc,4))
    print('baseline',np.mean([r['base'] for r in rows]))
    # evaluate thresholds
    print(f"{'tau':>5} {'apply':>6} {'metric':>8} {'locprec_app':>11} {'wordtop1_app':>12}")
    best=None
    for tau in [0.0,0.05,0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.45,0.5,0.55,0.6,0.65,0.7,0.75,0.8]:
        tot=0;app=0;lok=0;wok=0
        for r in rows:
            if r['applied'] and r['pbest']>=tau and not r['trunc']:
                tot+=lev(r['pred'],orig[r['i']]); app+=1; lok+=r['gap_ok']; wok+=r['word_ok']
            else:
                tot+=r['base']
        m=tot/N
        print(f"{tau:5.2f} {app/N:6.3f} {m:8.4f} {lok/max(app,1):11.3f} {wok/max(app,1):12.3f}")
        if best is None or m<best[1]: best=(tau,m,app/N)
    print('BEST',best)
    if args.save_records:
        pickle.dump(rows,open(args.save_records,'wb'),protocol=4); print('saved records',args.save_records)

if __name__=='__main__': main()
