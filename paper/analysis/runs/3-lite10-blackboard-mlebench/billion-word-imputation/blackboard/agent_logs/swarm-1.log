# mlm*bigram interaction: mlm best but require low bi
for wm in [1,2,3]:
    ev(lambda f,wm=wm: wm*z(f[:,0]) - 0.5*z(f[:,1]+f[:,2]), f'{wm}*mlm -0.5(bi+rev)')
