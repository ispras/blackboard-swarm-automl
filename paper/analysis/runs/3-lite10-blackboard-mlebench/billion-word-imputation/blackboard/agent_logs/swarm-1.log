import pickle, numpy as np, torch, time
from transformers import AutoTokenizer, GPT2LMHeadModel
d=pickle.load(open('feats_800.pkl','rb')); N=len(d)
tok=AutoTokenizer.from_pretrained('gpt2')
model=GPT2LMHeadModel.from_pretrained('gpt2').eval()
def score(tokens):
    enc=tok(tokens,is_split_into_words=True,return_tensors='pt')
    wids=enc.word_ids(0)
    with torch.no_grad():
        logits=model(**{k:v for k,v in enc.items()}).logits[0]  # [T,V]
    logp=torch.log_softmax(logits,dim=-1)
    ids=enc['input_ids'][0]
    n=len(tokens)
    # first subtoken index for each word
    first=[None]*n
    for pos,w in enumerate(wids):
        if w is not None and first[w] is None: first[w]=pos
    surp=np.full(n,np.nan); ent=np.full(n,np.nan)
    for w in range(1,n):
        pos=first[w]
        if pos is None or pos==0: continue
        surp[w]=float(-logp[pos-1, ids[pos]])
        pr=logp[pos-1].exp(); ent[w]=float(-(pr*logp[pos-1]).sum())
    return surp,ent
S=[]; E=[]
for i,x in enumerate(d):
    s,e=score(x['tokens']); S.append(s); E.append(e)
# gap g corresponds to token index g (b=t[g]) -> surp[g]
def ev(fn,label):
    acc=0
    for x,s,e in zip(d,S,E):
        n=len(x['tokens']); vals=np.array([fn(s,e,g) for g in range(1,n)])
        vals=np.nan_to_num(vals,nan=-1e9)
        g=int(vals.argmax())+1; acc+=(g==x['j'])
    print(label,'gapacc',acc/N)
ev(lambda s,e,g: s[g], 'surprisal(b)')
ev(lambda s,e,g: e[g], 'entropy(before b)=H(next|prefix a)')
ev(lambda s,e,g: s[g]+e[g], 'surp+ent')
ev(lambda s,e,g: s[g]-s[g-1], 'surp diff')
pickle.dump({'S':S,'E':E},open('gpt2_800.pkl','wb'))
EOF
