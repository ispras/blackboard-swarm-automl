import pickle,sys,argparse,time
import numpy as np, torch
from transformers import AutoTokenizer, XLNetLMHeadModel
def build_vocab(tok):
    V=tok.vocab_size; ids=[]; id2w={}
    special=set(tok.all_special_ids)
    for i in range(V):
        if i in special: continue
        s=tok.convert_ids_to_tokens(i)
        if s is None or not s.startswith('▁'): continue
        w=s[1:]
        if w=='' or ' ' in w: continue
        id2w[i]=w; ids.append(i)
    return np.array(ids,dtype=np.int64), id2w
def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ckpt',default='xlnet-large-cased'); ap.add_argument('--dump',required=True)
    ap.add_argument('--topk',type=int,default=20); ap.add_argument('--bs',type=int,default=24)
    ap.add_argument('--maxlen',type=int,default=160); ap.add_argument('--out',required=True)
    ap.add_argument('--gpu_frac',type=float,default=0.35)
    args=ap.parse_args()
    torch.cuda.set_per_process_memory_fraction(args.gpu_frac,0)
    D=pickle.load(open(args.dump,'rb')); toks=D['tokens']; meta=D['meta']
    tok=AutoTokenizer.from_pretrained(args.ckpt); model=XLNetLMHeadModel.from_pretrained(args.ckpt,torch_dtype=torch.float16).cuda().eval()
    ids_all,id2w=build_vocab(tok); ids_t=torch.tensor(ids_all,device='cuda')
    items=[]
    for i in range(len(toks)):
        g=int(meta[i][2]); t=toks[i]
        if g<1 or g>len(t)-1: continue
        items.append((i,g,' '.join(t[:g]+[tok.mask_token]+t[g:])))
    print('n',len(items),flush=True); out={}; t0=time.time()
    for s in range(0,len(items),args.bs):
        chunk=items[s:s+args.bs]
        enc=tok([c[2] for c in chunk],padding=True,truncation=True,max_length=args.maxlen,return_tensors='pt')
        ii=enc['input_ids'].cuda(); am=enc['attention_mask'].cuda()
        B,T=ii.shape
        mp=(ii==tok.mask_token_id)
        perm=torch.zeros(B,T,T,device='cuda',dtype=torch.float32)
        tm=torch.zeros(B,1,T,device='cuda',dtype=torch.float32)
        keep=[]
        for r in range(B):
            pos=mp[r].nonzero(as_tuple=True)[0]
            if len(pos)==0: continue
            perm[r,pos[0],pos[0]]=1.0; tm[r,0,pos[0]]=1.0; keep.append(r)
        if not keep:
            continue
        with torch.no_grad(), torch.autocast('cuda',dtype=torch.float16):
            lo=model(input_ids=ii, attention_mask=am, perm_mask=perm, target_mapping=tm).logits  # [B,1,V]
        pr=torch.softmax(lo[:,0,:].float()[:,ids_t],-1)
        k=min(args.topk,pr.size(1)); tv,ti=torch.topk(pr,k,-1); tv=tv.cpu().numpy(); ti=ti.cpu().numpy()
        for r in keep:
            i,_=chunk[r][0],chunk[r][1]
            out[i]=([id2w[int(ids_all[ti[r,j]])] for j in range(k)],[float(tv[r,j]) for j in range(k)])
        if s%(args.bs*20)==0: print(s,'/',len(items),round(time.time()-t0,1),flush=True)
    pickle.dump(out,open(args.out,'wb'),protocol=4); print('saved',args.out,round(time.time()-t0,1))
if __name__=='__main__': main()
EOF
