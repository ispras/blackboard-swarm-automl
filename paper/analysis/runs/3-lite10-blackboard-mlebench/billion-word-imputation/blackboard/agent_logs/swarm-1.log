import pickle, math, numpy as np, time, sys
from collections import defaultdict
d=pickle.load(open('feats_800.pkl','rb')); N=len(d)
ng=pickle.load(open('ngram.pkl','rb')); uni,bi,tri=ng['uni'],ng['bi'],ng['tri']
t0=time.time()
# successors of a: dict a -> list[(w,c)] (top by count), restrict to a in vocab; build full then sort lazily
succ=defaultdict(list)
for (a,b),c in bi.items():
    succ[a].append((b,c))
print('succ built',len(succ),round(time.time()-t0),flush=True)
# prune each to top 150
for a in succ: 
    l=succ[a]
    if len(l)>150:
        l.sort(key=lambda x:-x[1]); del l[150:]
    succ[a]=l
print('pruned',round(time.time()-t0),flush=True)
EPS=1e-9
V=len(uni)
def gap_scores(tokens):
    n=len(tokens); S=[]
    for g in range(1,n):
        a,b=tokens[g-1],tokens[g]
        ca=uni.get(a,0); cb=uni.get(b,0)
        pba=(bi.get((a,b),0)+EPS)/(ca+EPS) if ca>0 else EPS/V
        # forward insertion LR
        best=-1e9
        for w,cw in succ.get(a,()):
            p_w_a=cw/(ca+EPS)
            p_b_w=(bi.get((w,b),0)+EPS)/(uni.get(w,0)+EPS)
            s=math.log(p_w_a)+math.log(p_b_w)
            if s>best: best=s
        gain_fwd=best-math.log(pba)
        S.append(gain_fwd)
    return np.array(S)
from Levenshtein import distance as lev
acc=0; levs=[]
for x in d:
    s=gap_scores(x['tokens'])
    g=int(s.argmax())+1; acc+=(g==x['j'])
    def mk(g,w): return ' '.join(x['tokens'][:g])+' '+w+' '+' '.join(x['tokens'][g:])
    levs.append(lev(x['ref'],mk(g,x['tops'][g-1])))
print('forward-LR detector gapacc',acc/N,'lev',np.mean(levs))
EOF
