import numpy as np
def build_X(tokens, gp, detwp, tri, mlm=None, use=('det','tri')):
    n=len(tokens); ng=n-1
    if gp is None or len(gp)!=ng: return None
    gpr=np.clip(gp,1e-6,1)
    detrank=np.argsort(np.argsort(-gp))
    frac=np.arange(1,ng+1)/n
    cols=[]
    if 'det' in use:
        cols += [gpr, np.log(gpr), -detrank, np.asarray(detwp)]
    if 'tri' in use:
        tg=np.full(ng,-30.0); tp=np.zeros(ng)
        if tri:
            for k,v in tri.items():
                if 1<=k<=ng:
                    tg[k-1]=v[1]; tp[k-1]=1.0
        trirank=np.argsort(np.argsort(-tg))
        cols += [np.clip(tg,-40,15), tp, -trirank]
    if 'mlm' in use:
        mm=np.zeros(ng); m2=np.zeros(ng)
        if mlm:
            for g in range(1,ng+1):
                d=mlm.get(g)
                if d:
                    mm[g-1]=d['maxp']; m2[g-1]=d['p'][1] if len(d['p'])>1 else 0.0
        mlmrank=np.argsort(np.argsort(-mm))
        cols += [mm, np.log(np.clip(mm,1e-6,1)), -mlmrank, mm-np.clip(m2,0,1)]
    return np.column_stack(cols+[frac])
EOF
