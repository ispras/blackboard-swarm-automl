[0m$ [0mcd workspaces/arcturus_kappa && cat > scripts/detok.py <<'EOF'
NO_BEFORE={'.',',',';',':','!','?',')',']','}','%','\'\'','n\'t',"'s","'re","'ve","'ll","'d","'m",'--','...'}
NO_AFTER={'(':'(', '[':'[', '{':'{', '$':'$', '#':'#', '``':'"'}
def detok_around(tokens,g,mask):
    # returns natural text with mask inserted at gap g (before tokens[g])
    out=''
    for i,tok in enumerate(tokens):
        if i==g: out+=(' ' if out and not out.endswith(' ') else '')+mask
        s=tok
        if s=='``': s='"'
        elif s=='\'\'': s='"'
        if not out:
            out=s
        elif s in NO_BEFORE:
            out+=s
        elif out.endswith('(') or out.endswith('[') or out.endswith('{') or out.endswith('$') or out.endswith('#') or out.endswith('"') and False:
            out+=s
        else:
            out+=' '+s
    if g>=len(tokens): out+=' '+mask
    return out
EOF
