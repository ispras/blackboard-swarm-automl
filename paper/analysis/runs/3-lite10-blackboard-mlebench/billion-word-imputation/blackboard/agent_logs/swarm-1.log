import pickle,numpy as np
from Levenshtein import distance as lev
D=pickle.load(open('dump_ck2000_5000.pkl','rb')); toks=D['tokens']; res=D['res']; meta=D['meta']; orig=D['orig']
M=pickle.load(open('mlm_allgaps_5000.pkl','rb'))
W=pickle.load(open('wl_oracle_5000.pkl','rb'))
def cw(words,probs,lam=0.0):
    S=sum(probs) or 1; pf=[p/S for p in probs]; best=None;bu=None
    for u in words:
        e=sum(pf[i]*lev(u,words[i]) for i in range(len(words)))+lam*len(u)
        if best is None or e<best: best=e;bu=u
    return bu
def fuse(a1,p1,a2,p2,wa,wb,eps=1e-6):
    d={}
    for w,p in zip(a1,p1): d[w]=[wa*np.log(max(p,eps)),wb*np.log(eps)]
    for w,p in zip(a2,p2):
        if w in d: d[w][1]=wb*np.log(max(p,eps))
        else: d[w]=[wa*np.log(eps),wb*np.log(max(p,eps))]
    items=sorted([(w,v[0]+v[1]) for w,v in d.items()],key=lambda x:-x[1])[:25]
    mx=items[0][1]; ex=np.exp(np.array([s for w,s in items])-mx)
    return [w for w,s in items],(ex/ex.sum()).tolist()
def ins(t,g,w): return ' '.join(t[:g])+' '+str(w)+' '+' '.join(t[g:])
