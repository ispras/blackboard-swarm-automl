import pickle,numpy as np
from Levenshtein import distance as lev
D=pickle.load(open('dump_ck2000_5000.pkl','rb')); toks=D['tokens']; meta=D['meta']; orig=D['orig']
A=pickle.load(open('wl_oracle_5000.pkl','rb'))
Ws={w:pickle.load(open(f'wl_win{w}.pkl','rb')) for w in [6,12,20]}
def cw(ws,ps,lam=0.0):
    ps=np.array(ps,float); ps=ps/ps.sum(); best=None;bu=None
    for u in ws:
        e=sum(ps[i]*lev(u,ws[i]) for i in range(len(ws)))+lam*len(u)
        if best is None or e<best: best=e;bu=u
    return bu
def fuse(lst,weights,eps=1e-6):
    d={}
    for k,((ws,ps),w) in enumerate(zip(lst,weights)):
        for ww,p in zip(ws,ps):
            if ww not in d: d[ww]=[np.log(eps)]*len(lst)
            d[ww][k]=w*np.log(max(p,eps))
    items=sorted([(w,sum(v)) for w,v in d.items()],key=lambda x:-x[1])[:25]
    mx=items[0][1]; ex=np.exp(np.array([s for w,s in items])-mx); return [w for w,s in items],(ex/ex.sum()).tolist()
def ins(t,g,w): return ' '.join(t[:g])+' '+str(w)+' '+''.join('')
def pred(t,g,w): return ' '.join(t[:g]+[w]+t[g:])
rows=[(i,int(meta[i][2]),A[i],{w:Ws[w].get(i) for w in Ws},meta[i][3]) for i in range(len(toks)) if i in A and int(meta[i][2])>=1]
def ev(name,fn):
    cs=[];acc=[]
    for (i,g,a,wd,rw) in rows:
