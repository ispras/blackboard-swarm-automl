import pickle, numpy as np
from Levenshtein import distance as lev
d=pickle.load(open('feats_800.pkl','rb')); N=len(d)
F=[np.array(x['feats']) for x in d]
def ev(fn,label):
    acc=0; levs=[]
    for x,f in zip(d,F):
        s=fn(f); g=int(s.argmax())+1; acc+=(g==x['j'])
        def mk(g,w): return ' '.join(x['tokens'][:g])+' '+w+' '+' '.join(x['tokens'][g:])
        levs.append(lev(x['ref'],mk(g,x['tops'][g-1])))
    print(f'{label:30s} acc={acc/N:.3f} lev={np.mean(levs):.3f}')
def z(s): return (s-s.mean())/(s.std()+1e-9)
ev(lambda f: -f[:,1], '-logbi')
ev(lambda f: -f[:,2], '-logbi_rev')
ev(lambda f: -f[:,3], '-logtri')
ev(lambda f: -(f[:,1]+f[:,2]), '-(bi+rev)')
ev(lambda f: -(f[:,1]+f[:,2]+f[:,3]), '-(bi+rev+tri)')
# combine min signals meaningfully: use -log p
for wm in [0.5,1,2,3,5]:
    ev(lambda f,wm=wm: wm*z(f[:,0]) - z(f[:,1]+f[:,2]), f'{wm}*mlm -(bi+rev)')
