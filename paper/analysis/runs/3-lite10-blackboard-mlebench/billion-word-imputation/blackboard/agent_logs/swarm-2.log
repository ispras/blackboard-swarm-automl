import pickle, numpy as np
from Levenshtein import distance as lev
HOLD='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
meta=[l.rstrip('\n').split('\t') for l in open(HOLD+'/holdout_meta.tsv')][1:]
zs=pickle.load(open('/tmp/w_oracle_zs.pkl','rb'))
ft=pickle.load(open('/tmp/w_oracle_ft.pkl','rb'))
base=pickle.load(open('mlm_holdout_c4000.pkl','rb'))
alb=pickle.load(open('/tmp/w_albert_5k.pkl','rb'))
N=5000
def dist(g,k=20):
    d={}
    for w,p in zip(g['w'][:k],g['p'][:k]): d[w]=d.get(w,0.0)+p
    s=sum(d.values()); return {w:v/s for w,v in d.items()} if s else {}
def ev(names,weights,temp=1.5,lam=0.05,topk=20):
    D={'zs':zs,'ft':ft,'base':base,'alb':alb}
    tot=0;n=0
    for i in range(N):
        rmi=int(meta[i][2]); rmw=meta[i][3]
        if rmi<0: continue
        comb={}
        for nm,wt in zip(names,weights):
            if wt<=0: continue
            g=D[nm][i].get(rmi)
            if g is None: continue
            for w,v in dist(g).items(): comb[w]=comb.get(w,0)+wt*v/sum(weights)
        if not comb: continue
        items=sorted(comb.items(),key=lambda kv:-kv[1])[:topk]
        ws=[w for w,_ in items]; ps=np.array([p for _,p in items])
        lg=np.log(ps+1e-12)/temp; ps=np.exp(lg-lg.max()); ps/=ps.sum()
        best=None
        for c in ws:
            e=float(sum(ps[j]*lev(c,ws[j]) for j in range(len(ws))))+lam*len(c)
            if best is None or e<best[0]: best=(e,c)
        tot+=lev(best[1],rmw); n+=1
    return tot/n,n
for names,weights in [(['alb'],[1]),(['zs','ft','base'],[0.5,0.3,0.2]),(['zs','ft','base','alb'],[0.4,0.25,0.15,0.2]),(['zs','ft','base','alb'],[0.45,0.2,0.15,0.2]),(['zs','ft','base','alb'],[0.35,0.2,0.1,0.35]),(['zs','alb'],[0.6,0.4])]:
    v,n=ev(names,weights); print(names,weights,round(v,4),n)
