recs=[]
for i in range(N):
    toks=gaps[i].split(' ')
    c=lm.predict_sentence(toks,topk=5)
    # per-gap best
    gd={}
    for (k,wid,sc,gain) in c:
        if k not in gd or gain>gd[k][1]:
            gd[k]=(lm.word(wid),gain,sc)
    arr=sorted(gd.items(), key=lambda kv:-kv[1][1])[:4]
    recs.append([(k,w,g,sc) for k,(w,g,sc) in arr])
    if (i+1)%5000==0: print('done',i+1,round(time.time()-t0,1),flush=True)
with open('/download_job_code/payload/sandbox/workspaces/antares_upsilon/ngram/feats_trigram_%d.pkl'%N,'wb') as f:
    pickle.dump(recs,f)
print('saved',N)
