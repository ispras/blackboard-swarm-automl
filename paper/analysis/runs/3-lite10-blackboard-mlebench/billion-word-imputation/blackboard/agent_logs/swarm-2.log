import pickle,sys,argparse,time
import numpy as np, torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from Levenshtein import distance as lev

def build_vocab(tok):
    V=tok.vocab_size; ids=[]; id2w={}
    for i in range(V):
        s=tok.convert_ids_to_tokens(i)
        if s is None or s.startswith('<') or s.startswith('Ġ<'): continue
        if s.startswith('Ġ'):
            w=s[1:]
            if w=='': continue
            id2w[i]=w; ids.append(i)
    return np.array(ids,dtype=np.int64), id2w

def ins(t,g,w): return ' '.join(t[:g])+' '+w+' '+' '.join(t[g:])

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--dump',required=True)
    ap.add_argument('--ckpt',required=True)
    ap.add_argument('--mode',default='oracle') # oracle|det
    ap.add_argument('--topk',type=int,default=20)
    ap.add_argument('--bs',type=int,default=128)
    ap.add_argument('--maxlen',type=int,default=192)
    ap.add_argument('--device',default='cuda')
    ap.add_argument('--out',default='')
    args=ap.parse_args()
    D=pickle.load(open(args.dump,'rb')); toks=D['tokens']; res=D['res']; meta=D['meta']; orig=D['orig']
    tok=AutoTokenizer.from_pretrained(args.ckpt); model=AutoModelForMaskedLM.from_pretrained(args.ckpt).to(args.device).eval()
    ids_all,id2w=build_vocab(tok); ids_t=torch.tensor(ids_all,device=args.device)
    texts=[];gaps=[];keep=[]
    for i in range(len(toks)):
        t=toks[i]; r=res[i]
        if args.mode=='oracle': g=int(meta[i][2])
        else:
            if len(r['gap_probs'])==0: continue
            g=int(r['gap_probs'].argmax())+1
        if g<1 or g>len(t)-1: continue
        texts.append(' '.join(t[:g]+['<mask>']+t[g:])); gaps.append(g); keep.append(i)
    print('n',len(texts),flush=True)
    out={}
    t0=time.time()
    for s in range(0,len(texts),args.bs):
        chunk=texts[s:s+args.bs]
        enc=tok(chunk,padding=True,truncation=True,max_length=args.maxlen,return_tensors='pt')
        ii=enc['input_ids'].to(args.device); am=enc['attention_mask'].to(args.device)
        with torch.no_grad(): lo=model(input_ids=ii,attention_mask=am).logits
        mp=(ii==tok.mask_token_id); idx=mp.float().argmax(1)
        ar=torch.arange(len(chunk),device=args.device)
        lp=torch.log_softmax(lo[ar,idx].float(),-1)[:,ids_t]
        pr=torch.softmax(lp,-1)
        k=min(args.topk,pr.size(1)); tv,ti=torch.topk(pr,k,-1)
        tv=tv.cpu().numpy(); ti=ti.cpu().numpy()
        for r in range(len(chunk)):
            ws=[id2w[int(ids_all[ti[r,j]])] for j in range(k)]
            ps=[float(tv[r,j]) for j in range(k)]
            out[keep[s+r]]=(gaps[s+r],ws,ps)
        if s% (args.bs*10)==0: print(s,'/',len(texts),round(time.time()-t0,1),flush=True)
    print('mlm done',round(time.time()-t0,1),flush=True)
    def cw(words,probs,lam=0.2):
        S=sum(probs) or 1; pf=[p/S for p in probs]; best=None;bu=None
        for u in words:
            e=sum(pf[i]*lev(u,words[i]) for i in range(len(words)))+lam*len(u)
            if best is None or e<best: best=e;bu=u
        return bu
    def fuse(wd,pd,wm,pm,a=1.0,b=1.0,eps=1e-4):
        d={}
        for w,p in zip(wd,pd): d[w]=d.get(w,0)+a*np.log(p+eps)
        for w,p in zip(wm,pm): d[w]=d.get(w,0)+b*np.log(p+eps)
        items=sorted(d.items(),key=lambda x:-x[1])[:20]
        ws=[k for k,v in items]; ex=np.exp(np.array([v for k,v in items])); ps=(ex/ex.sum()).tolist()
        return ws,ps
    # evaluate on oracle or det gap
    my_cost=[];fuse_cost=[];mlm_cost=[];acc_my=[];acc_mlm=[];acc_f=[]
    for i in range(len(toks)):
        if i not in out: continue
        g,ws_m,ps_m=out[i]; t=toks[i]
        r=res[i]
