print('avg 11000+14000+15625', round(acc(avg(['ck11000','ck14000','ck15625'])),4))
print('avg 4000+15625', round(acc(avg(['ck4000','ck15625'])),4))
# plus mlm maxp normalized
def with_mlm(base_probs, lam):
    out=[]
    for i in range(len(base_probs)):
        a=np.asarray(base_probs[i]).astype(np.float64)
        if len(a)==0: out.append(a); continue
        # mlm maxp per gap k -> array index k-1
        g=mlm[i]; mm=np.zeros(len(a))
        for k,val in g.items():
            if 1<=k<=len(a): mm[k-1]=val['maxp']
        s=mm.sum()
        mm = mm/s if s>0 else mm
        a=a/a.sum()
        out.append(a+lam*mm)
    return out
for lam in [0.2,0.5,1.0]:
    print('15625+mlm lam',lam, round(acc(with_mlm(G['ck15625'],lam)),4))
