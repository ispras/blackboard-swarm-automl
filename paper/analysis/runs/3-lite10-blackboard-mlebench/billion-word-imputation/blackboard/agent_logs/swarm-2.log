import numpy as np, time, sys
import Levenshtein
from trigram_model import TrigramLM
BASE='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
gaps=[l.rstrip('\n') for l in open(f'{BASE}/holdout_gap.txt')]
orig=[l.rstrip('\n') for l in open(f'{BASE}/holdout_orig.txt')]
meta=[l.rstrip('\n').split('\t') for l in open(f'{BASE}/holdout_meta.tsv')][1:]
N=int(sys.argv[1]) if len(sys.argv)>1 else len(gaps)
lm=TrigramLM(); t0=time.time()
best=[]
for i in range(N):
    toks=gaps[i].split(' ')
    c=lm.predict_sentence(toks)
    if c:
        cb=max(c,key=lambda x:x[3]); best.append((cb[0],lm.word(cb[1]),cb[3],cb[2]))
    else: best.append((-1,'',-1e9,0.0))
    if (i+1)%5000==0: print('done',i+1,round(time.time()-t0,1),flush=True)
np.save('/download_job_code/payload/sandbox/workspaces/antares_upsilon/ngram/best_trigram_%d.npy'%N, np.array(best,dtype=object), allow_pickle=True)
def insert(toks,k,c): return ' '.join(toks[:k]+[c]+toks[k:])
corr=valid=0
for i,b in enumerate(best):
    if meta[i][2]=='-1': continue
    valid+=1; corr+= (b[0]==int(meta[i][2]))
print('gap acc all',corr/valid)
for thr in [-2,-1,0,0.5,1,1.5,2,2.5,3,3.5,4,5,6,8]:
    tot=app=locc=wc=0
    for i,b in enumerate(best):
        if b[0]==-1 or b[2]<thr:
            tot+=Levenshtein.distance(gaps[i],orig[i]); continue
        toks=gaps[i].split(' '); k=b[0]
        if k<1 or k>len(toks)-1:
            tot+=Levenshtein.distance(gaps[i],orig[i]); continue
        app+=1; tot+=Levenshtein.distance(insert(toks,k,b[1]),orig[i])
        if meta[i][2]!='-1' and k==int(meta[i][2]): locc+=1
        if meta[i][2]!='-1' and k==int(meta[i][2]) and b[1]==meta[i][3]: wc+=1
    print(f'thr {thr:5} metric {tot/N:.4f} apply {app/N:.3f} loc {locc/N:.3f} word {wc/N:.3f}')
print('baseline',sum(Levenshtein.distance(gaps[i],orig[i]) for i in range(N))/N)
