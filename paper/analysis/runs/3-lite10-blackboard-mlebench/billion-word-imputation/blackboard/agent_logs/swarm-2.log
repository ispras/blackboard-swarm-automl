import pickle, numpy as np
from Levenshtein import distance as lev
HOLD='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
meta=[l.rstrip('\n').split('\t') for l in open(HOLD+'/holdout_meta.tsv')][1:]
zs=pickle.load(open('/tmp/w_oracle_zs.pkl','rb'))
ft=pickle.load(open('/tmp/w_oracle_ft.pkl','rb'))
base=pickle.load(open('mlm_holdout_c4000.pkl','rb'))
def dist(g, k=20):
    ws=g['w'][:k]; ps=np.array(g['p'][:k],dtype=np.float64)
    d={}
    for w,p in zip(ws,ps): d[w]=d.get(w,0.0)+p
    return d
def norm(d):
    s=sum(d.values()); return {w:v/s for w,v in d.items()} if s>0 else {}
def combine(i, rmi, weights):
    ds=[]
    for dump,wt in zip([zs,ft,base],weights):
        if wt<=0: continue
        g=dump[i].get(rmi)
        if g is None: continue
        ds.append((norm(dist(g)),wt))
    if not ds: return None
    comb={}
    tot=sum(wt for _,wt in ds)
    for d,wt in ds:
        for w,v in d.items(): comb[w]=comb.get(w,0)+wt*v/tot
    return comb
def ev(weights, temp=1.5, lam=0.05, topk=20):
    tot=0;n=0
    for i in range(len(zs)):
        rmi=int(meta[i][2]); rmw=meta[i][3]
        if rmi<0: continue
        comb=combine(i,rmi,weights)
        if not comb: continue
        # keep topk by prob
        items=sorted(comb.items(), key=lambda kv:-kv[1])[:topk]
        ws=[w for w,_ in items]; ps=np.array([p for _,p in items])
        if temp!=1.0:
            lg=np.log(ps+1e-12)/temp; ps=np.exp(lg-lg.max()); 
        ps=ps/ps.sum()
        best=None
        for c in ws:
            e=float(sum(ps[j]*lev(c,ws[j]) for j in range(len(ws))))+lam*len(c)
            if best is None or e<best[0]: best=(e,c)
        tot+=lev(best[1],rmw); n+=1
    return tot/n,n
for w in [(1,0,0),(0,1,0),(0,0,1),(0.7,0.3,0),(0.5,0.5,0),(0.6,0.2,0.2),(0.5,0.3,0.2),(0.8,0.2,0),(1/3,1/3,1/3),(0.4,0.4,0.2)]:
    v,n=ev(w); print(w, round(v,4), n)
