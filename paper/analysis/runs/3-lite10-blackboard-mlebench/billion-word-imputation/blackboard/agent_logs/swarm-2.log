      cand=(k,lm.word(rr[0]),rr[2],rr[0])         if bestr is None or cand[2]>bestr[2]: bestr=cand     refined2.append(bestr) pickle.dump(refined2,open("ngram/refined2_trigram_1000_30000.pkl","wb")) print("top2 refine time",round(time.time()-t0,1)) for thr in [2.5,3.0,3.5,4.0,4.5]:     s=0.0;app=0;we=0     for i,rf in enumerate(refined2):         if rf is None or g1[i]<thr: s+=base[i]; continue         k,w,_,_=rf; toks=gaps[i].split(" ")         if k<1 or k>len(toks)-1: s+=base[i]; continue         app+=1; s+=Levenshtein.distance(ins(toks,k,w),orig[i])         if meta[i][2]!="-1" and k==int(meta[i][2]) and w==meta[i][3]: we+=1     print("  top2 thr",thr,"metric",round(s/N,4),"apply",round(app/N,3),"word_exact",round(we/N,4)) PY
