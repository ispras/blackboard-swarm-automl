def acc(probs):
    c=0;n=0
    for i in range(len(probs)):
        rmi=int(meta[i][2]); a=np.asarray(probs[i])
        if rmi<0 or len(a)==0: continue
        n+=1; c+= (int(np.argmax(a))+1)==rmi
    return c/n
def avg(cks, w=None):
    out=[]
    for i in range(len(G['ck15625'])):
        arrs=[np.asarray(G[ck][i]) for ck in cks]
        L=min(len(a) for a in arrs)
        if L==0: out.append(np.zeros(0)); continue
        ww=np.ones(len(cks)) if w is None else np.array(w)
        out.append(sum(ww[j]*arrs[j][:L] for j in range(len(cks)))/ww.sum())
    return out
for ck in G: print(ck, round(acc(G[ck]),4))
