import pickle, numpy as np
from Levenshtein import distance as lev
import sys
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/antares_upsilon')
V=np.load('/download_job_code/payload/sandbox/workspaces/antares_upsilon/ngram/vocab.npy',allow_pickle=True)
U=np.load('/download_job_code/payload/sandbox/workspaces/antares_upsilon/ngram/U.npy')
print('vocab',len(V))
# build prefix -> best full word (most frequent longer word starting with prefix)
from collections import defaultdict
best_ext={}
vmap={str(w):i for i,w in enumerate(V)}
# For each word, consider its prefixes? expensive. Instead for each predicted token, search words starting with it.
# We'll do lazy lookup with sorted vocab via bisect
import bisect
Vlist=sorted((str(w) for w in V))
Ulist={}
for w,i in vmap.items(): Ulist[w]=int(U[i])
def ext_of(tok, maxlen_extra=8):
    # find words starting with tok, longer, most frequent
    lo=bisect.bisect_left(Vlist, tok)
    hi=bisect.bisect_left(Vlist, tok+chr(0x10ffff))
    best=None
    for w in Vlist[lo:hi]:
        if len(w)<=len(tok) or len(w)-len(tok)>maxlen_extra: continue
        c=Ulist.get(w,0)
        if best is None or c>best[0]: best=(c,w)
    return best[1] if best else None

HOLD='/download_job_code/payload/sandbox/workspaces/antares_upsilon/holdout'
meta=[l.rstrip('\n').split('\t') for l in open(HOLD+'/holdout_meta.tsv')][1:]
d=pickle.load(open('/tmp/w_oracle_zs.pkl','rb'))
def ev(mode, temp=1.5, lam=0.05, topk=20, nextk=5):
    tot=0;n=0
    for i in range(len(d)):
        rmi=int(meta[i][2]); rmw=meta[i][3]
        g=d[i].get(rmi)
        if g is None: continue
        ws=g['w'][:topk]; ps=np.array(g['p'][:topk],dtype=np.float64)
        lg=np.log(ps+1e-12)/temp; ps=np.exp(lg-lg.max()); ps/=ps.sum()
        cand=list(ws)
        if mode=='ext':
            for t in ws[:nextk]:
                e=ext_of(t)
                if e and e not in cand: cand.append(e)
        best=None
        for c in cand:
            e=float(sum(ps[j]*lev(c,ws[j]) for j in range(len(ws))))+lam*len(c)
            if best is None or e<best[0]: best=(e,c)
        tot+=lev(best[1],rmw); n+=1
    return tot/n
print('base', ev('base'))
for nk in [3,5,10,20]:
    print('ext nextk',nk, ev('ext',nextk=nk))
