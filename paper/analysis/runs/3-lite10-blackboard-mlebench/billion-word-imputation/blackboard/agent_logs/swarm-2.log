import os,sys,time,argparse,pickle,csv
import numpy as np, torch, torch.nn as nn
from transformers import AutoTokenizer, AutoModelForMaskedLM
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/arcturus_kappa/scripts')

class Detector(nn.Module):
    def __init__(self, base, Vw):
        super().__init__(); self.encoder=base
        H=base.config.hidden_size
        self.gap_head=nn.Linear(H,1); self.word_head=nn.Linear(H,Vw)

def build_text(tokens):
    return " ".join([w if k==0 else "<mask> "+w for k,w in enumerate(tokens)])

@torch.no_grad()
def predict(model,tok,tokens_list,bs=128,maxlen=192,device='cuda'):
    model.eval(); mask_id=tok.mask_token_id; res=[None]*len(tokens_list)
    order=sorted(range(len(tokens_list)),key=lambda i:len(tokens_list[i]))
    for s in range(0,len(order),bs):
        idxs=order[s:s+bs]
        texts=[build_text(tokens_list[i]) for i in idxs]
        enc=tok(texts,padding=True,truncation=True,max_length=maxlen,return_tensors='pt')
        ids=enc['input_ids'].to(device); attn=enc['attention_mask'].to(device)
        h=model.encoder(input_ids=ids,attention_mask=attn).last_hidden_state
        mp=(ids==mask_id)
        for r,i in enumerate(idxs):
            pos=mp[r].nonzero(as_tuple=True)[0]
            if len(pos)==0:
                res[i]={'gap_probs':np.zeros(0,np.float32),'trunc':True}; continue
            gl=model.gap_head(h[r,pos]).squeeze(-1).float()
            gp=torch.softmax(gl,dim=0).cpu().numpy()
            res[i]={'gap_probs':gp.astype(np.float32),'trunc': bool(mp[r].sum().item()!=max(len(tokens_list[i])-1,0))}
    return res

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('--ckpt',default='/download_job_code/payload/sandbox/workspaces/arcturus_kappa/detector_large/ckpt_4166.pt')
    ap.add_argument('--init',default='rlarge_ft/final')
    ap.add_argument('--input',required=True)
    ap.add_argument('--kind',default='csv',choices=['csv','txt'])
    ap.add_argument('--out',required=True)
    ap.add_argument('--limit',type=int,default=0)
    ap.add_argument('--bs',type=int,default=128)
    ap.add_argument('--maxlen',type=int,default=192)
    ap.add_argument('--device',default='cuda')
    ap.add_argument('--gpu_frac',type=float,default=0.0)
    args=ap.parse_args()
    if args.device=='cuda' and args.gpu_frac>0: torch.cuda.set_per_process_memory_fraction(args.gpu_frac,0)
    sd=torch.load(args.ckpt,map_location='cpu')
    tok=AutoTokenizer.from_pretrained(args.init)
    enc=AutoModelForMaskedLM.from_pretrained(args.init).roberta
    model=Detector(enc,len(sd['words']))
    model.encoder.load_state_dict(sd['encoder']); model.gap_head.load_state_dict(sd['gap_head']); model.word_head.load_state_dict(sd['word_head'])
    model.to(args.device)
    if args.kind=='csv':
        sents=[]
        with open(args.input,newline='') as f:
            rd=csv.reader(f); next(rd)
            for row in rd:
                if len(row)>=2: sents.append(row[1])
    else:
        sents=[l.rstrip('\n') for l in open(args.input)]
    toks=[s.split() for s in sents]
    if args.limit: toks=toks[:args.limit]
    print('sentences',len(toks),flush=True)
    t0=time.time(); res=predict(model,tok,toks,bs=args.bs,maxlen=args.maxlen,device=args.device)
    gp=[r['gap_probs'] for r in res]; trunc=[r['trunc'] for r in res]
    pickle.dump({'tokens':toks,'gap_probs':gp,'trunc':trunc},open(args.out,'wb'),protocol=4)
    print('saved',args.out,round(time.time()-t0,1),'trunc',sum(trunc),flush=True)

if __name__=='__main__': main()
