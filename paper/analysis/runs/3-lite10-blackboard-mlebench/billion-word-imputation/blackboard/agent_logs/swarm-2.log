import random, json, sys
random.seed(1234)
TRAIN="train_v2.txt"
# holdout pool = last 100k lines
N_TOTAL=29998384
POOL_START=N_TOTAL-100000
# read pool
lines=[]
with open(TRAIN,'rb') as f:
    pass
# stream to pool start
with open(TRAIN,'r',encoding='utf-8',errors='replace') as f:
    for i,line in enumerate(f):
        if i<POOL_START: continue
        line=line.rstrip('\n')
        if line.strip(): lines.append(line)
print("pool size",len(lines))
samp=random.sample(range(len(lines)),20000)
out=[]
for idx in samp:
    toks=lines[idx].split()
    if len(toks)<4: continue
    k=random.randint(1,len(toks)-2)
    word=toks[k]
    gap_tokens=toks[:k]+toks[k+1:]
    out.append({"id":idx,"gap":k,"word":word,"clean":toks,"gap_tokens":gap_tokens})
with open("holdout.json","w") as f: json.dump(out,f)
print("holdout",len(out))
lens=[len(o["word"]) for o in out]
print("mean removed word len",sum(lens)/len(lens))
EOF
