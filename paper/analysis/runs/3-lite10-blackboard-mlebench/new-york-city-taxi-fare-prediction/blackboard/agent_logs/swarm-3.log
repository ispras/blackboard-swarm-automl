import pandas as pd,numpy as np,lightgbm as lgb
full=pd.read_parquet('train_te.parquet')
va=full[full.holdout==1].reset_index(drop=True)
feats=[c for c in full.columns if c not in('key','fare_amount','holdout')]
m=lgb.Booster(model_file='te16m_model.txt'); va['pred']=m.predict(va[feats]); va['res']=va.fare_amount-va.pred
hf=va[(va.fare_amount>40)&~((va.p_jfk<1.6)|(va.d_jfk<1.6))]
print('n',len(hf),'rmse',np.sqrt((hf.res**2).mean()))
print('near LGA',((hf.p_lga<1.6)|(hf.d_lga<1.6)).sum(),'near EWR',((hf.p_ewr<1.6)|(hf.d_ewr<1.6)).sum())
print('near any airport',(((hf.p_lga<1.6)|(hf.d_lga<1.6)|(hf.p_ewr<1.6)|(hf.d_ewr<1.6))).sum())
for name,mask in [('LGA',(hf.p_lga<1.6)|(hf.d_lga<1.6)),('EWR',(hf.p_ewr<1.6)|(hf.d_ewr<1.6)),('none',~((hf.p_lga<1.6)|(hf.d_lga<1.6)|(hf.p_ewr<1.6)|(hf.d_ewr<1.6)))]:
    s=hf[mask]
    print('\n',name,len(s),'rmse',np.sqrt((s.res**2).mean()),'bias',s.res.mean())
    print(' fare top',s.fare_amount.round(1).value_counts().head(6).to_dict())
    print(' hav describe',np.percentile(s.haversine,[10,50,90]),'pred mean',s.pred.mean())
# none-airport, look at distance vs fare
s=hf[~((hf.p_lga<1.6)|(hf.d_lga<1.6)|(hf.p_ewr<1.6)|(hf.d_ewr<1.6))]
print('\nnone-airport corr hav-fare',np.corrcoef(s.haversine,s.fare_amount)[0,1])
print(s[['fare_amount','pred','haversine','year']].describe().T)
