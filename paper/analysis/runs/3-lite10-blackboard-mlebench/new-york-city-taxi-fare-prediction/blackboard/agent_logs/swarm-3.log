import pandas as pd,numpy as np,os
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import KFold
W="/download_job_code/payload/sandbox/workspaces";OUT=f"{W}/alkaid_phi"
exec(open(f"{OUT}/blender4.py").read().split("meta=pd.read_parquet")[0])
meta=pd.read_parquet(f"{OUT}/val_meta.parquet")
df=meta[["key","fare_amount","has_pickup","has_dropoff","distance_km"]].copy(); avail=[]
for n,(vp,tp) in M.items():
    if os.path.exists(vp) and os.path.exists(tp):
        v=load_val(vp)[["key","pred"]].drop_duplicates("key").rename(columns={"pred":n})
        df=df.merge(v,on="key",how="inner"); avail.append(n)
df=df.dropna(subset=avail).reset_index(drop=True)
df["missing"]=((df.has_pickup==0)|(df.has_dropoff==0))
df["degen"]=(~df.missing)&(df.distance_km<0.1)
df["clean"]=(~df.missing)&(~df.degen)
y=df.fare_amount.values
sub=[n for n in ["ant_xgb_le","ant_xgb_te","ant_xgb_lg","ant_cat","alkaid_v2lgb","arc_lgb30m","arc_lgb20m"] if n in avail]
print("clean n",df.clean.sum(),"degen",df.degen.sum(),"missing",df.missing.sum())
for n in avail:
    m=df.clean.values; print(f"{n:14s} clean_rmse {np.sqrt(((np.clip(df[n].values,2.5,200)[m]-y[m])**2).mean()):.4f}")
kf=KFold(5,shuffle=True,random_state=0)
def cv(groups):
    oof=np.zeros(len(df))
    for g in groups:
        idx=np.where(df[g].values)[0]; A=df.loc[idx,sub].values; yy=y[idx]
        for tr,va in kf.split(idx):
            lr=LinearRegression(positive=True).fit(A[tr],yy[tr]); oof[idx[va]]=lr.predict(A[va])
    oof=np.clip(oof,2.5,200); e=oof-y
    return np.sqrt((e**2).mean()),np.sqrt((e[df.clean.values]**2).mean()),np.sqrt((e[df.degen.values]**2).mean()),np.sqrt((e[df.missing.values]**2).mean())
print("nonmiss+miss",cv(["clean","degen","missing"]))
# 2-group: nonmiss global, missing sep
oof=np.zeros(len(df))
for g in [["clean","degen"],["missing"]]:
    idx=np.where(df[g].values.any(axis=0) if isinstance(df[g].values,np.ndarray) and df[g].values.ndim==2 else df[g].values)[0]
