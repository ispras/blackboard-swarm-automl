    print('const mean rmse',np.sqrt(((s.fare_amount.mean()-s.fare_amount)**2).mean()))
    print('by year:')
    print(s.groupby('year').apply(lambda x:pd.Series({'n':len(x),'mean':x.fare_amount.mean(),'std':x.fare_amount.std(),'model_rmse':np.sqrt(((x.blend-x.fare_amount)**2).mean()),'const_rmse':np.sqrt(((x.fare_amount.mean()-x.fare_amount)**2).mean())}),include_groups=False))
    # optimal scaling of blend toward group mean
    for w in [0,0.25,0.5,0.75,1.0]:
        pr=(1-w)*s.fare_amount.mean()+w*s.blend
        print('  shrink',w,'rmse',np.sqrt(((pr-s.fare_amount)**2).mean()))
