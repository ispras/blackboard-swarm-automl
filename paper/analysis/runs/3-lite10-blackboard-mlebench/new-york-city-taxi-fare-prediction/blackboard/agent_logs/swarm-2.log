import numpy as np, pyarrow as pa, pyarrow.parquet as pq, time
W='/download_job_code/payload/sandbox/workspaces/antares_omicron'
t0=time.time()
def days_from_civil(y,m,d):
    y=y.astype(np.int64); m=m.astype(np.int64); d=d.astype(np.int64)
    y2=y-(m<=2); era=np.where(y2>=0,y2//400,(y2-399)//400); yoe=y2-era*400
    mp=np.where(m>2,m-3,m+9); doy=(153*mp+2)//5+d-1
    doe=yoe*365+yoe//4-yoe//100+doy
    return era*146097+doe-719468
def load(f):
    cols=['year','month','day','hour','minute','lon1','lat1']
    t=pq.read_table(f,columns=cols)
    y=t['year'].to_numpy(); mo=t['month'].to_numpy(); d=t['day'].to_numpy(); h=t['hour'].to_numpy(); mi=t['minute'].to_numpy()
    days=days_from_civil(y,mo,d)
    mins=days*1440+h*60+mi
    lon=t['lon1'].to_numpy(); lat=t['lat1'].to_numpy()
    return mins,days,lon,lat,h
tr_mins,tr_days,tr_lon,tr_lat,tr_h=load(f'{W}/feat/train_feats.parquet')
te_mins,te_days,te_lon,te_lat,te_h=load(f'{W}/feat/test_feats.parquet')
print('loaded',time.time()-t0,flush=True)
srt=np.sort(tr_mins)
def win_count(q,radius):
    i=np.searchsorted(srt,q-radius,'left'); j=np.searchsorted(srt,q+radius,'right')
    return (j-i).astype(np.float32)
tr_c15=win_count(tr_mins,15); tr_c60=win_count(tr_mins,60)
te_c15=win_count(te_mins,15); te_c60=win_count(te_mins,60)
print('window counts',time.time()-t0,flush=True)
# date volume
dmin=tr_days.min(); dmax=tr_days.max(); nd=dmax-dmin+2
vol=np.bincount(tr_days-dmin,minlength=nd).astype(np.float32)
tr_vol=vol[tr_days-dmin]; te_vol=np.where((te_days>=dmin)&(te_days<=dmax),vol[np.clip(te_days-dmin,0,nd-1)],np.nan).astype(np.float32)
# zone-hour count (0.02 deg pickup cell x hour-of-day)
LON_MIN,LAT_MIN=-75.6,39.4; g=0.02; nlon=200; nlat=200; nc=nlon*nlat
def cell(lon,lat):
    ok=np.isfinite(lon)&np.isfinite(lat)
    il=np.clip(((np.nan_to_num(lon,nan=LON_MIN)-LON_MIN)/g).astype(np.int64),0,nlon-1)
    ia=np.clip(((np.nan_to_num(lat,nan=LAT_MIN)-LAT_MIN)/g).astype(np.int64),0,nlat-1)
    return (il*nlat+ia).astype(np.int64),ok
tc,tok=cell(tr_lon,tr_lat); code=tc*24+tr_h.astype(np.int64)
zh=np.bincount(code[tok],minlength=nc*24).astype(np.float32)
tr_zh=zh[code]; tr_zh[~tok]=np.nan
tec,teok=cell(te_lon,te_lat); tecode=tec*24+te_h.astype(np.int64)
te_zh=zh[tecode].astype(np.float32); te_zh[~teok]=np.nan
print('zone hour',time.time()-t0,flush=True)
ftr={'tr_c15':(tr_c15-1).astype(np.float32),'tr_c60':(tr_c60-1).astype(np.float32),'tr_vol':tr_vol,'tr_zh':tr_zh.astype(np.float32)}
fte={'tr_c15':te_c15,'tr_c60':te_c60,'tr_vol':te_vol,'tr_zh':te_zh}
pq.write_table(pa.table({k:pa.array(v) for k,v in ftr.items()}),f'{W}/feat/traffic_feats.parquet',compression='zstd')
pq.write_table(pa.table({k:pa.array(v) for k,v in fte.items()}),f'{W}/feat/traffic_test.parquet',compression='zstd')
print('saved',time.time()-t0,flush=True)
for k in ftr: print(k,'train mean',np.nanmean(ftr[k]),'test mean',np.nanmean(fte[k]))
