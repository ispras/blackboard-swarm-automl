import numpy as np, pyarrow.parquet as pq, torch, torch.nn as nn, time, sys, json, os
W='/download_job_code/payload/sandbox/workspaces/antares_omicron'
N=int(sys.argv[1]) if len(sys.argv)>1 else 0
EPOCHS=int(sys.argv[2]) if len(sys.argv)>2 else 12
TAG=sys.argv[3] if len(sys.argv)>3 else 'nn'
dev='cuda'; t0=time.time()
CAT=['year','month','day','hour','dow','passenger_count']
BASE=['lon1','lat1','lon2','lat2','passenger_count','year','month','day','hour','minute','dow','doy','is_weekend','dist_km','dlat','dlon','abs_dlat','abs_dlon','manhattan_km','bearing','p_jfk','d_jfk','min_jfk','p_lga','d_lga','min_lga','p_ewr','d_ewr','min_ewr','p_midtown','d_midtown','min_midtown','p_dt','d_dt','min_dt','swap_flag','has_pickup','has_dropoff','ts_days','log_dist','euclid_deg','manh_ratio','dist_ratio','bearing_sin','bearing_cos','p_air_min','d_air_min','is_airport_trip']
TE=['te_p01','te_d01','te_p05','te_d05','te_route05','same_cell05']
NUM=[f for f in BASE if f not in CAT]+TE
allcols=BASE+TE+['fare']
pf=pq.ParquetFile(f'{W}/feat/train_feats.parquet')
hc=np.load(f'{W}/feat/holdout_crc.npy')
if N>0:
    import pyarrow as pa
    parts=[]; nrows=0; rg=0
    while nrows<N:
        t=pf.read_row_group(rg,columns=[c for c in BASE+['fare']]); parts.append(t); nrows+=t.num_rows; rg+=1
    tab=pa.concat_tables(parts).slice(0,N); hc=hc[:N]
else:
    tab=pf.read(columns=[c for c in BASE+['fare']])
NROWS=tab.num_rows
print('loaded base',NROWS,time.time()-t0,flush=True)
Xc=np.empty((NROWS,len(CAT)),dtype=np.int64)
for i,c in enumerate(CAT): Xc[:,i]=tab[c].to_numpy(zero_copy_only=False).astype(np.int64)
Xn=np.empty((NROWS,len(NUM)),dtype=np.float32)
for i,c in enumerate(NUM):
    v=tab[c].to_numpy(zero_copy_only=False).astype(np.float32); Xn[:,i]=v
fare=tab['fare'].to_numpy(np.float32); del tab
tt=pq.read_table(f'{W}/feat/te_feats.parquet',columns=TE)
for j,c in enumerate(TE): Xn[:,len(NUM)-len(TE)+j]=tt[c].to_numpy(zero_copy_only=False)[:NROWS]
del tt
# standardize numeric on sample
samp=np.random.default_rng(0).choice(NROWS,size=min(2_000_000,NROWS),replace=False)
mean=np.nanmean(Xn[samp],axis=0); std=np.nanstd(Xn[samp],axis=0); std[std<1e-6]=1.0
np.nan_to_num(Xn,copy=False,nan=0.0)
Xn-=mean; Xn/=std; np.nan_to_num(Xn,copy=False,nan=0.0)
# clean mask
hp=Xn[:,NUM.index('has_pickup')]; hd=Xn[:,NUM.index('has_dropoff')]
raw_hp=tab=None
ok=(fare>=1)&(fare<=500)
print('prep',time.time()-t0,flush=True)
# cat cardinalities
card={c:int(Xc[:,i].max())+1 for i,c in enumerate(CAT)}
# move to gpu
dev='cuda'
Xc_t=torch.tensor(Xc,device=dev); Xn_t=torch.tensor(Xn,device=dev); y_t=torch.tensor(fare,device=dev)
ok_t=torch.tensor(ok,device=dev); hc_t=torch.tensor(hc,device=dev)
tr_idx=torch.where(ok_t & ~hc_t)[0]; va_idx=torch.where(ok_t & hc_t)[0]
print('gpu tensors',time.time()-t0,'tr',len(tr_idx),'va',len(va_idx),flush=True)
del Xc,Xn,fare,ok,hc
class Net(nn.Module):
    def __init__(self,dn,card):
        super().__init__()
        self.emb=nn.ModuleList([nn.Embedding(c,min(16,(c+1)//2)) for c in card.values()])
        ed=sum(e.embedding_dim for e in self.emb)
        d=dn+ed
        self.net=nn.Sequential(nn.Linear(d,512),nn.BatchNorm1d(512),nn.ReLU(),nn.Dropout(0.1),
            nn.Linear(512,256),nn.BatchNorm1d(256),nn.ReLU(),nn.Dropout(0.1),
            nn.Linear(256,128),nn.BatchNorm1d(128),nn.ReLU(),
            nn.Linear(128,1))
    def forward(self,xc,xn):
        e=[emb(xc[:,i]) for i,emb in enumerate(self.emb)]
        x=torch.cat([xn]+e,dim=1); return self.net(x).squeeze(1)
model=Net(len(NUM),card).to(dev)
opt=torch.optim.Adam(model.parameters(),lr=2e-3)
sched=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=EPOCHS)
lossf=nn.MSELoss()
BS=16384
def evaluate():
    model.eval(); preds=torch.empty(len(va_idx),device=dev)
    with torch.no_grad():
        for s in range(0,len(va_idx),BS*4):
            b=va_idx[s:s+BS*4]; preds[s:s+len(b)]=model(Xc_t[b],Xn_t[b])
    p=preds.clamp(2.5,200); yy=y_t[va_idx]
    return float(torch.sqrt(torch.mean((p-yy)**2)).item())
best=9; step=0
for ep in range(EPOCHS):
    model.train(); perm=torch.randperm(len(tr_idx),device=dev)
    for s in range(0,len(perm),BS):
        b=tr_idx[perm[s:s+BS]]
        opt.zero_grad(); out=model(Xc_t[b],Xn_t[b]); loss=lossf(out,y_t[b]); loss.backward(); opt.step(); step+=1
    sched.step()
    v=evaluate(); print(f'ep{ep} step{step} val {v:.4f} lr {sched.get_last_lr()[0]:.2e} t {time.time()-t0:.0f}',flush=True)
    if v<best: best=v; torch.save(model.state_dict(),f'{W}/{TAG}.pt'); json.dump({'rmse':best,'epoch':ep,'num':NUM,'cat':CAT,'card':card,'mean':mean.tolist(),'std':std.tolist()},open(f'{W}/{TAG}_meta.json','w'))
print('BEST',best,time.time()-t0,flush=True)
