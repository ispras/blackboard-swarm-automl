import numpy as np, pyarrow.parquet as pq, torch, torch.nn as nn, json
W='/download_job_code/payload/sandbox/workspaces/antares_omicron'; TAG='nn'
meta=json.load(open(f'{W}/{TAG}_meta.json')); NUM=meta['num']; CAT=meta['cat']; card=meta['card']
mean=np.array(meta['mean'],dtype=np.float32); std=np.array(meta['std'],dtype=np.float32)
TE=['te_p01','te_d01','te_p05','te_d05','te_route05','same_cell05']
NUMB=[f for f in NUM if f not in TE]
class Net(nn.Module):
    def __init__(self,dn,card):
        super().__init__(); self.emb=nn.ModuleList([nn.Embedding(c,min(16,(c+1)//2)) for c in card.values()])
        ed=sum(e.embedding_dim for e in self.emb); d=dn+ed
        self.net=nn.Sequential(nn.Linear(d,512),nn.BatchNorm1d(512),nn.ReLU(),nn.Dropout(0.1),
            nn.Linear(512,256),nn.BatchNorm1d(256),nn.ReLU(),nn.Dropout(0.1),
            nn.Linear(256,128),nn.BatchNorm1d(128),nn.ReLU(),nn.Linear(128,1))
    def forward(self,xc,xn):
        e=[emb(xc[:,i]) for i,emb in enumerate(self.emb)]
        return self.net(torch.cat([xn]+e,dim=1)).squeeze(1)
model=Net(len(NUM),card).cuda(); model.load_state_dict(torch.load(f'{W}/{TAG}.pt')); model.eval()
def prep(tab,te,tesel):
    n=tab.num_rows
    Xc=np.empty((n,len(CAT)),dtype=np.int64)
    for i,c in enumerate(CAT): Xc[:,i]=tab[c].to_numpy(zero_copy_only=False).astype(np.int64)
    Xn=np.empty((n,len(NUM)),dtype=np.float32)
    for i,c in enumerate(NUMB): Xn[:,i]=tab[c].to_numpy(zero_copy_only=False).astype(np.float32)
    fare=tab['fare'].to_numpy(zero_copy_only=False).astype(np.float32) if 'fare' in tab.column_names else None
    for j,c in enumerate(TE): Xn[:,len(NUMB)+j]=te[c].to_numpy(zero_copy_only=False)[tesel] if tesel is not None else te[c].to_numpy(zero_copy_only=False)
    np.nan_to_num(Xn,copy=False,nan=0.0); Xn-=mean; Xn/=std; np.nan_to_num(Xn,copy=False,nan=0.0)
    return Xc,Xn,fare
# val (holdout)
hc=np.load(f'{W}/feat/holdout_crc.npy'); idx=np.where(hc)[0]
tab=pq.read_table(f'{W}/feat/train_feats.parquet',columns=list(dict.fromkeys(NUMB+CAT+['fare']))).take(idx)
te=pq.read_table(f'{W}/feat/te_feats.parquet',columns=TE).take(idx)
Xc,Xn,fare=prep(tab,te,None)
hp=Xn[:,NUM.index('has_pickup')]; hd=Xn[:,NUM.index('has_dropoff')]
# note: standardized; sign preserved, so > (<) still works for flags
p1=(Xn[:,NUM.index('lon1')]*std[NUM.index('lon1')]+mean[NUM.index('lon1')]>=-75.5)
ok=(fare>=1)&(fare<=500)
# rebuild precise ok using raw flags from tab
hp_raw=tab['has_pickup'].to_numpy(); hd_raw=tab['has_dropoff'].to_numpy()
lon1=tab['lon1'].to_numpy(); lat1=tab['lat1'].to_numpy(); lon2=tab['lon2'].to_numpy(); lat2=tab['lat2'].to_numpy()
p1=(lon1>=-75.5)&(lon1<=-72.5)&(lat1>=39.5)&(lat1<=42); p2=(lon2>=-75.5)&(lon2<=-72.5)&(lat2>=39.5)&(lat2<=42)
ok&= (p1|(hp_raw<1))&(p2|(hd_raw<1))
pc=tab['passenger_count'].to_numpy(); ok&=(pc>=0)&(pc<=8)
okidx=np.where(ok)[0]
with torch.no_grad():
    pv=model(torch.tensor(Xc,device='cuda')[okidx],torch.tensor(Xn,device='cuda')[okidx]).cpu().numpy()
pv=np.clip(pv,2.5,200)
print('nn val all(both incl miss)',float(np.sqrt(np.mean((pv-fare[okidx])**2))),'n',len(pv))
np.save(f'{W}/{TAG}_valpred.npy',pv.astype(np.float32)); np.save(f'{W}/{TAG}_valmask_ok.npy',idx[okidx])
# test
tt=pq.read_table(f'{W}/feat/test_feats.parquet'); tte=pq.read_table(f'{W}/feat/te_test.parquet',columns=TE)
Xc2,Xn2,_=prep(tt,tte,None)
with torch.no_grad(): pt=model(torch.tensor(Xc2,device='cuda'),torch.tensor(Xn2,device='cuda')).cpu().numpy()
pt=np.clip(pt,2.5,200); np.save(f'{W}/{TAG}_testpred.npy',pt.astype(np.float32))
hp2=tt['has_pickup'].to_numpy(); hd2=tt['has_dropoff'].to_numpy(); miss=(hp2<1)|(hd2<1)
print('nn test mean',pt.mean(),'missing mean',pt[miss].mean(),'max',pt.max())
