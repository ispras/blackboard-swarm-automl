print('nonmiss',r(~mm)); print('miss',r(mm))
inc2=inc[df.index.get_indexer(sub.index)]
print('in arcturus 200k',r(inc2)); print('EXCLUDED 21k',r(~inc2))
print('weights',dict(zip(cov+['b'],np.round(w,3))))
