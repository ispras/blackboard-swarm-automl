m=(fare>=1)&(fare<=500)
ks=ks[m]; sec=sec[m]; fare=fare[m]; dk=dk[m]; yr=yr[m]
# residualize fare on distance via binning
bins=np.digitize(np.clip(dk,0,50),np.arange(0,51,0.5))
res=fare.copy()
for b in np.unique(bins):
    mm=bins==b; res[mm]=fare[mm]-fare[mm].mean()
print('std resid',res.std())
for lo,hi in [(100,200),(200,300),(300,400),(400,500),(500,600),(600,700),(700,800),(800,900),(900,1000)]:
    mm=(ks>=lo)&(ks<hi)
    print('ns',lo,hi,'n',int(mm.sum()),'mean resid',round(float(res[mm].mean()),3))
print('--- sec ---')
for s in range(0,60,6):
    mm=(sec>=s)&(sec<s+6); print('sec',s,'n',int(mm.sum()),'mean resid',round(float(res[mm].mean()),3))
