print(\"cat test miss mean\",round(float(m.pred[miss].mean()),2),\"nonmiss\",round(float(m.pred[~miss].mean()),2))
H=pd.read_parquet(\"workspaces/arcturus_upsilon/runs/holdout_flags.parquet\"); H[\"key\"]=nk(H.key); H=H.rename(columns={\"fare_amount\":\"y\"})
paths={\"xgb_te\":\"workspaces/antares_omicron/runs/xgb_te_val.parquet\",\"xgb_lg\":\"workspaces/antares_omicron/runs/xgb_lg_val.parquet\",\"xgb_v3\":\"workspaces/antares_omicron/runs/xgb_v3_val.parquet\",\"xgb_v2\":\"workspaces/antares_omicron/runs/xgb_v2_val.parquet\",\"alkaid_v2lgb\":\"workspaces/alkaid_phi/v2lgb_val.parquet\",\"lgb30m\":\"workspaces/arcturus_upsilon/runs/lgb30m_val.parquet\",\"lgb20m\":\"workspaces/arcturus_upsilon/runs/lgb20m_1023_val.parquet\",\"cat\":\"workspaces/antares_omicron/runs/cat_val.parquet\"}
d=H[[\"key\",\"y\",\"has_pickup\",\"has_dropoff\"]].copy()
for k,p in paths.items():
    v=pd.read_parquet(p); pc=\"pred\" if \"pred\" in v.columns else \"fare_amount\"; v[\"key\"]=nk(v.key)
    d=d.merge(v[[\"key\",pc]].rename(columns={pc:k}),on=\"key\",how=\"inner\")
print(\"common all\",len(d))
h=np.array([zlib.crc32(str(k).encode())%5 for k in d.key])
def cv(cols):
    X=d[cols].to_numpy(); y=d.y.to_numpy(); pred=np.zeros(len(d))
    for f in range(5):
        tr=h!=f;te=h==f
        A=np.column_stack([X[tr],np.ones(tr.sum())]); w,_=nnls(A,y[tr]); pred[te]=X[te]@w[:-1]+w[-1]
    e=np.clip(pred,2.5,200)-y; return round(float(np.sqrt(np.mean(e**2))),4)
sets={
 \"te_lg_alk_l30\":[\"xgb_te\",\"xgb_lg\",\"alkaid_v2lgb\",\"lgb30m\"],
 \"te_lg_alk_l30_l20\":[\"xgb_te\",\"xgb_lg\",\"alkaid_v2lgb\",\"lgb30m\",\"lgb20m\"],
