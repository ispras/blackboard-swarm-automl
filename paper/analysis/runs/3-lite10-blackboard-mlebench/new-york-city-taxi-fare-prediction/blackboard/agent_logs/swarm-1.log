import pandas as pd,numpy as np,json,pyarrow.dataset as ds
def nk(ks):
    return [ (lambda b,f: b+\".\"+f.ljust(9,\"0\")[:9])(*k.rsplit(\".\",1)) if \".\" in k else k for k in map(str,ks)]
meta=json.load(open(\"workspaces/arcturus_upsilon/runs/final_blend_meta.json\")); print(meta[\"models\"],meta[\"w_nonmiss\"])
H=pd.read_parquet(\"workspaces/arcturus_upsilon/runs/holdout_flags.parquet\"); H[\"key\"]=nk(H.key); H=H.rename(columns={\"fare_amount\":\"y\"})
d=H[[\"key\",\"y\",\"has_pickup\",\"has_dropoff\",\"airport_trip\",\"distance_km\"]].copy()
paths={\"xgb_te\":\"workspaces/antares_omicron/runs/xgb_te_val.parquet\",\"xgb_lg\":\"workspaces/antares_omicron/runs/xgb_lg_val.parquet\",\"cat\":\"workspaces/antares_omicron/runs/cat_val.parquet\",\"alkaid_v2lgb\":\"workspaces/alkaid_phi/v2lgb_val.parquet\",\"lgb30m\":\"workspaces/arcturus_upsilon/runs/lgb30m_val.parquet\"}
for m,p in paths.items():
    v=pd.read_parquet(p); pc=\"pred\" if \"pred\" in v.columns else \"fare_amount\"; v[\"key\"]=nk(v.key)
    d=d.merge(v[[\"key\",pc]].rename(columns={pc:m}),on=\"key\",how=\"inner\")
miss=((d.has_pickup==0)|(d.has_dropoff==0)).to_numpy()
wn=meta[\"w_nonmiss\"]; nm=meta[\"models\"]; wm=meta[\"w_miss\"]; sm=meta[\"missing_models\"]
p=np.empty(len(d)); p[~miss]=d.loc[~miss,nm].to_numpy()@np.array([wn[k] for k in nm])
p[miss]=d.loc[miss,sm].to_numpy()@np.array([wm[k] for k in sm])+meta[\"b_miss\"]
y=d.y.to_numpy()
def r(a): return float(np.sqrt(np.mean((a-y)**2)))
print(\"base\",r(p))
air=(d.airport_trip==1).to_numpy()&(~miss)
flat=np.array([45.0,49.57,49.8,52.0,56.8,57.33,57.54])
for th in [0.5,1.0,1.5,2.0,3.0,5.0]:
    q=p.copy(); diff=np.abs(q[:,None]-flat[None,:]); j=diff.argmin(1); best=flat[j]; md=diff.min(1)
    m=air&(md<th); q[m]=best[m]
    print(\"snap airport th\",th,\"n\",int(m.sum()),\"rmse\",round(r(np.clip(q,2.5,200)),5))
# also snap all rows with th
for th in [0.3,0.5,1.0]:
    q=p.copy(); diff=np.abs(q[:,None]-flat[None,:]); j=diff.argmin(1); best=flat[j]; md=diff.min(1)
    m=md<th; q[m]=best[m]
    print(\"snap all th\",th,\"n\",int(m.sum()),\"rmse\",round(r(np.clip(q,2.5,200)),5))
"'
