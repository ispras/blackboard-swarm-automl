    X = np.column_stack([X, np.sin(2*np.pi*hf/24), np.cos(2*np.pi*hf/24)]).astype(np.float32)
    V = np.column_stack([V, np.sin(2*np.pi*Vhf/24), np.cos(2*np.pi*Vhf/24)]).astype(np.float32)
