import pandas as pd,numpy as np
from scipy.optimize import nnls
B=\"/download_job_code/payload/sandbox/\"
H=pd.read_parquet(B+\"workspaces/arcturus_upsilon/runs/holdout_flags.parquet\").rename(columns={\"fare_amount\":\"y\"}); H[\"key\"]=H.key.astype(str)
VAL={\"xgb_le\":\"workspaces/antares_omicron/runs/xgb_le_val.parquet\",\"xgb_te\":\"workspaces/antares_omicron/runs/xgb_te_val.parquet\",\"xgb_lg\":\"workspaces/antares_omicron/runs/xgb_lg_val.parquet\",\"cat\":\"workspaces/antares_omicron/runs/cat_val.parquet\",\"alkaid_v2lgb\":\"workspaces/alkaid_phi/v2lgb_val.parquet\",\"lgb30m\":\"workspaces/arcturus_upsilon/runs/lgb30m_val.parquet\",\"lgb20m\":\"workspaces/arcturus_upsilon/runs/lgb20m_1023_val.parquet\",\"nn\":\"workspaces/antares_omicron/runs/nn_val.parquet\"}
def loadp(p):
    d=pd.read_parquet(B+p); pc=next(c for c in (\"pred\",\"fare_amount\") if c in d.columns)
    d=d[[\"key\",pc]].rename(columns={pc:\"pred\"}); d[\"key\"]=d.key.astype(str); return d.drop_duplicates(\"key\")
d=H[[\"key\",\"y\",\"has_pickup\",\"has_dropoff\"]].copy()
for k,p in VAL.items(): d=d.merge(loadp(p).rename(columns={\"pred\":k}),on=\"key\",how=\"inner\")
miss=((d.has_pickup==0)|(d.has_dropoff==0)).to_numpy(); nm=[k for k in VAL if k!=\"nn\"]
def blendfit(d,cols):
    fn=~miss & np.isfinite(d[cols].to_numpy(float)).all(1)
    A=np.column_stack([d.loc[fn,cols].to_numpy(float),np.ones(fn.sum())]); w,_=nnls(A,d.loc[fn,\"y\"].to_numpy(float))
    p=np.full(len(d),np.nan); p[fn]=A@w
    fm=miss & np.isfinite(d[cols].to_numpy(float)).all(1)
    A2=np.column_stack([d.loc[fm,cols].to_numpy(float),np.ones(fm.sum())]); w2,_=nnls(A2,d.loc[fm,\"y\"].to_numpy(float))
    p[fm]=A2@w2
    return np.clip(p,2.5,200)
pA=blendfit(d,nm); pB=blendfit(d,nm+[\"nn\"])
y=d.y.to_numpy()
def r(p,m): 
    e=p[m]-y[m]; e=e[np.isfinite(e)]; return float(np.sqrt(np.mean(e**2)))
print(\"final blend all\",round(r(pA,np.ones(len(y),bool)),4),\" +nn\",round(r(pB,np.ones(len(y),bool)),4))
rng=np.random.default_rng(0); n=len(d); bA=[]; bB=[]
for _ in range(500):
    idx=rng.integers(0,n,n)
    bA.append(np.sqrt(np.nanmean((pA[idx]-y[idx])**2))); bB.append(np.sqrt(np.nanmean((pB[idx]-y[idx])**2)))
bA=np.array(bA); bB=np.array(bB)
print(\"bootstrap final mean\",round(float(bA.mean()),4),\"sd\",round(float(bA.std()),4),\"| +nn mean\",round(float(bB.mean()),4),\"sd\",round(float(bB.std()),4),\"| P(+nn better)\",round(float((bB<bA).mean()),3))
"'
