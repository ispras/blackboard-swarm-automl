import numpy as np, librosa, tensorflow as tf, time
from scipy.ndimage import median_filter
from huggingface_hub import hf_hub_download
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm=d['Y'],d['train_mask']; Ytr=Y[tm]
from sklearn.metrics import roc_auc_score
wavs=np.load(f'{ROOT}/wavs_48k.npy')
def denoise(w, alpha, size=51, n_fft=2048, hop=512):
    S=librosa.stft(w,n_fft=n_fft,hop_length=hop); mag,ph=np.abs(S),np.angle(S)
    noise=median_filter(mag,size=(1,size))
    mag2=np.maximum(mag-alpha*noise,0.0); return librosa.istft(mag2*np.exp(1j*ph),hop_length=hop,length=len(w)).astype(np.float32)
p=hf_hub_download('sammlapp/BirdNET_v2.4','V2.4/BirdNET_GLOBAL_6K_V2.4_Model_FP32.tflite',cache_dir=f'{ROOT}/hf_cache')
lp=hf_hub_download('sammlapp/BirdNET_v2.4','V2.4/BirdNET_GLOBAL_6K_V2.4_Labels.txt',cache_dir=f'{ROOT}/hf_cache')
commons=[l.strip().split('_',1)[1] for l in open(lp).read().splitlines() if l.strip()]
want=['Brown Creeper','Pacific Wren','Pacific-slope Flycatcher','Red-breasted Nuthatch','Dark-eyed Junco','Olive-sided Flycatcher','Hermit Thrush','Chestnut-backed Chickadee','Varied Thrush','Hermit Warbler',"Swainson's Thrush","Hammond's Flycatcher",'Western Tanager','Black-headed Grosbeak','Golden-crowned Kinglet','Warbling Vireo',"MacGillivray's Warbler","Steller's Jay",'Common Nighthawk']
idx=[commons.index(w) for w in want]
it=tf.lite.Interpreter(model_path=p,num_threads=8); it.allocate_tensors()
inp=it.get_input_details()[0]; out=it.get_output_details()[0]
starts=[i*0.5 for i in range(15)]
for alpha,size in [(1.0,51),(1.5,51),(2.0,51),(1.0,101)]:
    t0=time.time(); D=np.stack([denoise(w,alpha,size) for w in wavs]); sel=[]
    for w in D:
        win=[]
        for s in starts:
            a=int(s*48000); x=w[a:a+144000][None,:]
            it.set_tensor(inp['index'],x.astype(np.float32)); it.invoke()
            win.append(it.get_tensor(out['index'])[0][idx])
        sel.append(win)
    A=np.array(sel); pr=1/(1+np.exp(-A))
    print('median alpha',alpha,'size',size,'raw AUC',round(roc_auc_score(Ytr.ravel(),pr.max(1)[tm].ravel()),4),f'{time.time()-t0:.0f}s',flush=True)
    np.save(f'{ROOT}/birdnet_median_a{alpha}_s{size}.npy',A)
