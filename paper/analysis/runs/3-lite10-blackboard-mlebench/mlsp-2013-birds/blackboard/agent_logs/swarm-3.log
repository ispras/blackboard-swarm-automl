def train(X,Yt,epochs=70,seed=0):
    torch.manual_seed(seed); m=MLP(X.shape[1]).to(dev)
    opt=torch.optim.AdamW(m.parameters(),lr=1.5e-3,weight_decay=2e-3)
    sch=torch.optim.lr_scheduler.OneCycleLR(opt,max_lr=1.5e-3,total_steps=epochs*max(1,(len(X)-1)//32))
    lf=nn.BCEWithLogitsLoss()
    Xt=torch.tensor(X); Ytt=torch.tensor(Yt)
    for ep in range(epochs):
        m.train(); perm=torch.randperm(len(X))
        for i in range(0,len(X)-1,32):
            idx=perm[i:i+32]
            if len(idx)<2: continue
            xb=Xt[idx].to(dev); yb=Ytt[idx].to(dev)
            if np.random.rand()<0.5:
                lam=np.random.beta(0.5,0.5); pi=torch.randperm(len(idx))
                xb=lam*xb+(1-lam)*xb[pi]; yb=torch.maximum(yb,yb[pi])
            loss=lf(m(xb),yb); opt.zero_grad(); loss.backward(); opt.step(); sch.step()
    return m
