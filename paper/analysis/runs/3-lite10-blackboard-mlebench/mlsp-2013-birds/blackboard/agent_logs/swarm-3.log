import numpy as np, itertools, glob, os
from sklearn.metrics import roc_auc_score
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm=d['Y'],d['train_mask']; Ytr=Y[tm]
folds=np.load(f'{SB}/workspaces/altair_gamma/folds_5x_seed42.npy')
EPS=1e-6
def logit(p): p=np.clip(p,EPS,1-EPS); return np.log(p/(1-p))
# (agent, name, is_prob)
M=[('pollux_epsilon','lr_multiast_bndn',0),('pollux_epsilon','lr_bnemb_only',0),('pollux_epsilon','spcond_bnemb',0),
   ('pollux_epsilon','lr_multiast_bnemb',0),('pollux_epsilon','bn_union_only_c01',0),('pollux_epsilon','mil_gru',0),
   ('pollux_epsilon','seg_mil',0),('pollux_epsilon','lr_perche_only',0),('pollux_epsilon','lr_bndn_union',0),
   ('pollux_epsilon','lgb_union',0),('pollux_epsilon','rawbirdnet_avg',1),('pollux_epsilon','rawbirdnet_denoised',1),
   ('pollux_epsilon','rawbirdnet_denoised25',1),('pollux_epsilon','rawbn_calibrated',1),
   ('altair_gamma','lgb_bnall',0),('altair_gamma','lgb_bn_stats',0),('altair_gamma','et_bn_stats',0),
   ('altair_gamma','et_emb64log',0),('altair_gamma','lgb_emb64log',0),
   ('pollux_beta','mil_attn2',0),('pollux_beta','mil_attn2b',0),('pollux_beta','mil_attn3',0),('pollux_beta','mlp_rich_mixup',0),
   ('pollux_beta','mlp_bn_mixup',0),('pollux_beta','mlp_multilabel',0)]
L={}
for a,n,p in M:
    f=f'{SB}/workspaces/{a}/preds/oof_{n}.npy'
    if not os.path.exists(f): continue
    o=np.load(f)
    if o.shape!=(258,19) or not np.isfinite(o).all(): continue
    L[f'{a[:3]}:{n}']=logit(o) if p else logit(o)
keys=list(L)
print('n models',len(keys))
def st(ks):
    z=sum(L[k] for k in ks); Pv=1/(1+np.exp(-z))
    pf=[roc_auc_score(Ytr[folds==f].ravel(),Pv[folds==f].ravel()) for f in range(5)]
    return roc_auc_score(Ytr.ravel(),Pv.ravel()),min(pf),pf
# anchor v10 members
v10=[k for k in keys if k.split(':')[1] in ('lgb_bnall','mil_attn2','dn3_max','mlp_rich_mixup')]
print('v10 keys',v10, 'score', round(st(v10)[0],5), 'min', round(st(v10)[1],5))
rows=[]
for n in range(3,7):
    for ks in itertools.combinations(keys,n):
        a,mn,pf=st(ks); rows.append((a,mn,ks,pf))
rows.sort(reverse=True)
print('TOP pooled:')
for r in rows[:10]: print(f'  {r[0]:.5f} min={r[1]:.5f} {r[2]}')
rows2=sorted(rows,key=lambda r:(r[1],r[0]),reverse=True)
print('TOP min:')
for r in rows2[:5]: print(f'  min={r[1]:.5f} pooled={r[0]:.5f} {r[2]}')
EOF
