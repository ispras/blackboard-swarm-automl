print('lgb_union OOF',round(roc_auc_score(Ytr.ravel(),P.ravel()),4),flush=True)
np.save(f'{ROOT}/preds/oof_lgb_union.npy',P)
Xtr=np.hstack([BASE[tr],neigh_feats(tr,tr,self_ref=True)]); Xte=np.hstack([BASE[te],neigh_feats(te,tr)])
