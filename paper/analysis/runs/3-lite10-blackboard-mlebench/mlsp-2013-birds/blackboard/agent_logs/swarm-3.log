import numpy as np, itertools
from sklearn.metrics import roc_auc_score
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm=d['Y'],d['train_mask']; Ytr=Y[tm]
folds=np.load(f'{SB}/workspaces/altair_gamma/folds_5x_seed42.npy')
EPS=1e-6
def logit(p): p=np.clip(p,EPS,1-EPS); return np.log(p/(1-p))
bn=np.load(f'{ROOT}/birdnet.npz'); pr=1/(1+np.exp(-bn['logits19']))
raws={'max':pr.max(1),'mean':pr.mean(1),'top2':np.sort(pr,1)[:,-2:].mean(1),'lse':np.log(np.exp(pr*4).mean(1))/4}
P={
 'multibn':f'{ROOT}/preds/oof_lr_multiast_bn_stats.npy',
 'bet_mlp':f'{SB}/workspaces/pollux_beta/preds/oof_mlp_multilabel.npy',
 'etemb':f'{SB}/workspaces/altair_gamma/preds/oof_et_emb64log.npy',
 'lgbemb':f'{SB}/workspaces/altair_gamma/preds/oof_lgb_emb64log.npy',
 'etmeta':f'{SB}/workspaces/altair_gamma/preds/oof_et_meta.npy',
 'astneigh':f'{ROOT}/preds/oof_lr_astneigh.npy',
 'multiast':f'{ROOT}/preds/oof_lr_multiastneigh.npy',
}
L={k:logit(np.load(v)) for k,v in P.items()}
base_keys=['multibn','bet_mlp','etemb','lgbemb']
for ag in raws:
    L['raw_'+ag]=logit(raws[ag][tm])
    for w in [0.5,1.0,1.5,2.0]:
        z=sum(L[k] for k in base_keys)+w*L['raw_'+ag]
        a=roc_auc_score(Ytr.ravel(),(1/(1+np.exp(-z))).ravel())
        print(f'raw_{ag} w={w} {a:.4f}',flush=True)
# best agg
best=(0,None)
for ag in raws:
    for w in [0.5,1.0,1.5,2.0,2.5]:
        z=sum(L[k] for k in base_keys)+w*L['raw_'+ag]
        a=roc_auc_score(Ytr.ravel(),(1/(1+np.exp(-z))).ravel())
        if a>best[0]: best=(a,(ag,w))
print('BEST',best,flush=True)
ag,w=best[1]
for extra in [[],['etmeta'],['astneigh'],['multiast'],['etmeta','astneigh']]:
    z=sum(L[k] for k in base_keys)+w*L['raw_'+ag]+sum(L[k] for k in extra)
    a=roc_auc_score(Ytr.ravel(),(1/(1+np.exp(-z))).ravel())
    print('extra',extra,round(a,4),flush=True)
EOF
