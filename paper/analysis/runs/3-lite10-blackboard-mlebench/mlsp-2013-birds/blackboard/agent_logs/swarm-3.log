         'pollux_beta/preds/oof_mlp_multilabel.npy','altair_gamma/preds/oof_et_emb64log.npy',
         'altair_gamma/preds/oof_lgb_emb64log.npy']
Zo=sum(logit(np.load(f'{SB}/workspaces/{p}')) for p in members)+raw_all[tm]
Zt=sum(logit(np.load(f'{SB}/workspaces/{p}'.replace('oof_','test_'))) for p in members)+raw_all[split==1]
Po=1/(1+np.exp(-Zo)); print('T1 OOF',round(roc_auc_score(Ytr.ravel(),Po.ravel()),4))
