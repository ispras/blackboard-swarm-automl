import numpy as np, warnings
warnings.filterwarnings('ignore')
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm,split,ids=d['Y'],d['train_mask'],d['split'],d['ids']
Ytr=Y[tm]; folds=np.load(f'{SB}/workspaces/altair_gamma/folds_5x_seed42.npy')
tr=np.where(tm)[0]; te=np.where(split==1)[0]
E=np.load(f'{ROOT}/birdnet_emb15.npy')  # 322,15,1024
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score
def mil_agg(feat, label, C, agg='max'):
    nw=feat.shape[1]; P=np.zeros_like(Ytr)
    for f in range(5):
        va=np.where(folds==f)[0]; trn=np.where(folds!=f)[0]
        Xw=E[tr][trn].reshape(-1,feat.shape[-1]); Yw=np.repeat(Ytr[trn],nw,axis=0)
        sc=StandardScaler().fit(Xw); A=sc.transform(Xw); B=sc.transform(E[tr][va].reshape(-1,feat.shape[-1]))
        for j in range(19):
            y=Yw[:,j]
            if y.sum()<2: continue
            m=LogisticRegression(C=C,max_iter=3000,class_weight='balanced').fit(A,y)
            pr=m.predict_proba(B)[:,1].reshape(len(va),nw)
            if agg=='max': P[va,j]=pr.max(1)
            elif agg=='mean': P[va,j]=pr.mean(1)
            else: P[va,j]=np.sort(pr,1)[:,-2:].mean(1)
    return P
for C in [0.003,0.01,0.03]:
    for agg in ['max','top2']:
        P=mil_agg(E,C,agg)
        print('MIL window C',C,agg,round(roc_auc_score(Ytr.ravel(),P.ravel()),4),flush=True)
        if C==0.01 and agg=='top2':
            np.save(f'{ROOT}/preds/oof_mil_bnemb.npy',P)
            # test
            nw=E.shape[1]; Xw=E[tr].reshape(-1,1024); Yw=np.repeat(Ytr,nw,axis=0)
            sc=StandardScaler().fit(Xw); A=sc.transform(Xw); B=sc.transform(E[te].reshape(-1,1024))
            T=np.zeros((len(te),19))
            for j in range(19):
                y=Yw[:,j]
                if y.sum()<2: continue
                m=LogisticRegression(C=0.01,max_iter=3000,class_weight='balanced').fit(A,y)
                pr=m.predict_proba(B)[:,1].reshape(len(te),nw)
                T[:,j]=np.sort(pr,1)[:,-2:].mean(1)
            np.save(f'{ROOT}/preds/test_mil_bnemb.npy',T); print('saved mil',flush=True)
