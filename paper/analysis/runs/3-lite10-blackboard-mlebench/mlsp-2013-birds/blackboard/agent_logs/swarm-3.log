import numpy as np, pandas as pd, os, json
BASE='/download_job_code/payload/sandbox/data'
ED=f'{BASE}/essential_data'
SUP=f'{BASE}/supplemental_data'
NCLASS=19

def load_labels():
    labs={}
    for line in open(f'{ED}/rec_labels_test_hidden.txt').read().splitlines()[1:]:
        p=line.split(','); rid=int(p[0]); rest=p[1:]
        labs[rid]=np.zeros(NCLASS,dtype=np.float32) if rest==['?'] else np.array([1.0 if c in map(int,rest) else 0.0 for c in range(NCLASS)],dtype=np.float32)
    Y=np.stack([labs[i] for i in range(322)])
    return Y, labs

def load_meta():
    r2f=pd.read_csv(f'{ED}/rec_id2filename.txt').sort_values('rec_id').reset_index(drop=True)
    r2f['site']=r2f.filename.str.split('_').str[0]
    r2f['date']=r2f.filename.str.split('_').str[1]
    r2f['time']=r2f.filename.str.split('_').str[2]
    r2f['sess']=r2f.site+'_'+r2f.date
    r2f['sec']=r2f.time.map(lambda t:int(t[:2])*3600+int(t[2:4])*60+int(t[4:]))
    r2f['doy']=pd.to_datetime(r2f.date,format='%Y%m%d').dt.dayofyear
    r2f['year']=r2f.date.str[:4].astype(int)
    return r2f

def load_hist():
    rows={}
    for line in open(f'{SUP}/histogram_of_segments.txt').read().splitlines()[1:]:
        p=line.split(','); rows[int(p[0])]=np.array(p[1:],dtype=np.float32)
    return np.stack([rows[i] for i in range(322)])

def load_segagg():
    segs={}
    for line in open(f'{SUP}/segment_features.txt').read().splitlines()[1:]:
        p=line.split(','); rid=int(p[0]); v=np.array(p[2:],dtype=np.float32)
        segs.setdefault(rid,[]).append(v)
    feats=[]; cnt=[]
    for i in range(322):
        s=segs.get(i,[])
        if s:
            A=np.stack(s); feats.append(np.concatenate([A.mean(0),A.std(0)]))
        else:
            feats.append(np.zeros(76,dtype=np.float32))
        cnt.append(len(s))
    return np.stack(feats), np.array(cnt,dtype=np.float32)

def make_folds(Y, rec_ids, n_splits=5, seed=42):
    """Greedy multilabel stratification. Returns array fold id aligned to rec_ids."""
    rng=np.random.RandomState(seed)
    y=Y[rec_ids]
    n=len(rec_ids)
    order=np.argsort(-y.sum(1)+rng.rand(n)*0.01)
    class_counts=np.zeros((n_splits,NCLASS))
    tot=np.zeros(n_splits)
    fold=np.full(n,-1)
    for i in order:
        labels=np.where(y[i]>0)[0]
        best=None
        for f in range(n_splits):
            # cost: sum of normalized imbalance after adding, + total size
            cost=0.0
            for c in labels:
                cost+= (class_counts[f,c]+1)/(y[:,c].sum()/n_splits+1e-9)
            cost+=0.3*tot[f]
            if best is None or cost<best[0]: best=(cost,f)
        f=best[1]; fold[i]=f
        for c in labels: class_counts[f,c]+=1
        tot[f]+=1
    return fold, class_counts

if __name__=='__main__':
    Y,labs=load_labels()
    cv=pd.read_csv(f'{ED}/CVfolds_2.txt')
    tr=sorted(cv[cv.fold==0].rec_id.tolist())
    fold,cc=make_folds(Y,np.array(tr),5,42)
    np.save('/download_job_code/payload/sandbox/workspaces/altair_gamma/folds_5x_seed42.npy',fold)
    print('train recs',len(tr))
    print('fold sizes',np.bincount(fold))
    print('per-class counts per fold:\n',cc.astype(int))
