rank=(rankdata(Zt.ravel())/Zt.size).reshape(Zt.shape)
samp=pd.read_csv(f'{SB}/data/sample_submission.csv')
sub=pd.DataFrame({'Id':np.concatenate([[int(r)*100+c for c in range(19)] for r in test_ids]),'Probability':rank.ravel()})
