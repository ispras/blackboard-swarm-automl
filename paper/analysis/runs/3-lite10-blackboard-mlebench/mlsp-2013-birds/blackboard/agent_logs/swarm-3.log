import numpy as np
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm,split=d['Y'],d['train_mask'],d['split']; Ytr=Y[tm]
tr=np.where(tm)[0]; te=np.where(split==1)[0]
folds=np.load(f'{SB}/workspaces/altair_gamma/folds_5x_seed42.npy')
EPS=1e-6
def logit(p): p=np.clip(p,EPS,1-EPS); return np.log(p/(1-p))
def sig(z): return np.where(z>=0,1/(1+np.exp(-np.abs(z))),np.exp(-np.abs(z))/(1+np.exp(-np.abs(z))))
# raw BN maxprob avg (8+15 windows), denoised 3 alphas (dn3-style) and all
P8=1/(1+np.exp(-np.load(f'{ROOT}/birdnet.npz')['logits19']))
P15=1/(1+np.exp(-np.load(f'{ROOT}/birdnet15.npz')['logits19']))
P15d=1/(1+np.exp(-np.load(f'{ROOT}/birdnet_denoised.npz.npy')))
P25=1/(1+np.exp(-np.load(f'{ROOT}/birdnet_denoised_a2.5.npy')))
P35=1/(1+np.exp(-np.load(f'{ROOT}/birdnet_denoised_a3.5.npy')))
ALL=np.concatenate([P8,P15,P15d,P25,P35],1)
raw=ALL.max(1)
Zraw=logit(raw)
# fold-safe per-class calibration
Cal_o=np.zeros_like(Ytr); Cal_t=np.zeros((64,19))
for f in range(5):
    va=np.where(folds==f)[0]; trn=np.where(folds!=f)[0]
    for j in range(19):
        y=Ytr[trn,j]
        if y.sum()<2: Cal_o[va,j]=Zraw[tr][va,j]; continue
        m=LogisticRegression(C=1.0,max_iter=1000).fit(Zraw[tr][trn,j][:,None],y)
        Cal_o[va,j]=m.decision_function(Zraw[tr][va,j][:,None])
for j in range(19):
    y=Ytr[:,j]
    if y.sum()<2: Cal_t[:,j]=Zraw[te,j]; continue
    m=LogisticRegression(C=1.0,max_iter=1000).fit(Zraw[tr][:,j][:,None],y)
    Cal_t[:,j]=m.decision_function(Zraw[te,j][:,None])
fin=f'{SB}/final_solution/preds'
V3=sum(logit(np.load(f'{fin}/oof_{n}.npy')) for n in ['lgb_bnall','mil_attn2','mlp_rich_mixup'])
def st(z):
    Pv=sig(z); return round(roc_auc_score(Ytr.ravel(),Pv.ravel()),4),[round(roc_auc_score(Ytr[folds==f].ravel(),Pv[folds==f].ravel()),4) for f in range(5)]
print('v10 (ref)', st(V3+logit(np.load(f'{fin}/oof_dn3_max.npy'))))
print('raw maxprob', round(roc_auc_score(Ytr.ravel(),raw[tr].ravel()),4))
print('calibrated raw', round(roc_auc_score(Ytr.ravel(),sig(Cal_o).ravel()),4))
print('v10 with calibrated raw', st(V3+Cal_o))
print('v10 with calibrated raw *0.5', st(V3+0.5*Cal_o))
np.save(f'{ROOT}/preds/oof_rawbn_calibrated.npy',sig(Cal_o)); np.save(f'{ROOT}/preds/test_rawbn_calibrated.npy',sig(Cal_t))
EOF
