import numpy as np
from sklearn.metrics import roc_auc_score
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm,split=d['Y'],d['train_mask'],d['split']; Ytr=Y[tm]
tr=np.where(tm)[0]; te=np.where(split==1)[0]
folds=np.load(f'{SB}/workspaces/altair_gamma/folds_5x_seed42.npy')
E=np.load(f'{ROOT}/birdnet_emb15.npy'); A=E.mean(1); A=A/(np.linalg.norm(A,axis=1,keepdims=True)+1e-8)
def proto(sim):
    P=np.zeros_like(Ytr)
    for f in range(5):
        va=np.where(folds==f)[0]; trn=np.where(folds!=f)[0]
        for j in range(19):
            pos=trn[Ytr[trn,j]>0]
            if len(pos)==0: continue
