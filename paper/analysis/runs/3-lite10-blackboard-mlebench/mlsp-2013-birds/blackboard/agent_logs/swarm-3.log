import numpy as np, pandas as pd, json, sys, warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *

Y,labs=load_labels(); meta=load_meta(); H=load_hist(); S,nseg=load_segagg()
cv=pd.read_csv(f'{ED}/CVfolds_2.txt')
tr=np.array(sorted(cv[cv.fold==0].rec_id.tolist())); te=np.array(sorted(cv[cv.fold==1].rec_id.tolist()))
folds=np.load('/download_job_code/payload/sandbox/workspaces/altair_gamma/folds_5x_seed42.npy')
sites=sorted(meta.site.unique()); s2i={s:i for i,s in enumerate(sites)}
sec=meta.sec.values; site=meta.site.values; sess=meta.sess.values; date=meta.date.values
doy=meta.doy.values; year=meta.year.values
Hn=H/(np.linalg.norm(H,axis=1,keepdims=True)+1e-8)

def meta_feats(idx):
    F=np.zeros((len(idx),len(sites)+7),dtype=np.float32)
    F[np.arange(len(idx)),[s2i[s] for s in site[idx]]]=1
    F[:,len(sites)+0]=year[idx]-2009
    F[:,len(sites)+1]=np.sin(2*np.pi*doy[idx]/365); F[:,len(sites)+2]=np.cos(2*np.pi*doy[idx]/365)
    F[:,len(sites)+3]=np.sin(2*np.pi*sec[idx]/86400); F[:,len(sites)+4]=np.cos(2*np.pi*sec[idx]/86400)
    F[:,len(sites)+5]=sec[idx]/86400
    F[:,len(sites)+6]=pd.Series(sess[idx]).map(pd.Series(sess).value_counts()).values
    return F

def base_feats(idx):
    return np.hstack([H[idx],S[idx],nseg[idx][:,None],meta_feats(idx)]).astype(np.float32)

def _blocks(q, r):
    qs=site[q][:,None]==site[r][None,:]
    return [
        sess[q][:,None]==sess[r][None,:],
        qs,
        date[q][:,None]==date[r][None,:],
        qs & (np.abs(sec[q][:,None]-sec[r][None,:])<=3600),
    ]

def neighbor_between(q, r, acoustic=False):
    R=Y[r]; nq=len(q)
    B=_blocks(q,r)
    if acoustic:
        sim=Hn[q]@Hn[r].T; B.append(sim>=0.5)
    nb=len(B); F=np.zeros((nq,nb*(NCLASS+1)),dtype=np.float32)
    for b,M in enumerate(B):
        M=M.astype(np.float32); cnt=M.sum(1)
        F[:,b*(NCLASS+1):b*(NCLASS+1)+NCLASS]= (M@R)/np.maximum(cnt,1)[:,None]
        F[:,b*(NCLASS+1)+NCLASS]=cnt
    return F

def neighbor_loo(idx, acoustic=False):
    R=Y[idx]; n=len(idx)
    B=_blocks(idx,idx)
    if acoustic:
        sim=Hn[idx]@Hn[idx].T; B.append(sim>=0.5)
    nb=len(B); F=np.zeros((n,nb*(NCLASS+1)),dtype=np.float32)
    for b,M in enumerate(B):
        M=M.astype(np.float32); np.fill_diagonal(M,0); cnt=M.sum(1)
        F[:,b*(NCLASS+1):b*(NCLASS+1)+NCLASS]= (M@R)/np.maximum(cnt,1)[:,None]
        F[:,b*(NCLASS+1)+NCLASS]=cnt
    return F

NB=4*(NCLASS+1)

def build_pair(tri,vai):
    ntr=neighbor_loo(tri); nva=neighbor_between(vai,tri)
    Xtr=np.hstack([base_feats(tri),ntr]); Xva=np.hstack([base_feats(vai),nva])
    return Xtr,Xva

def lr_fn(seed): return LogisticRegression(C=0.1,max_iter=3000,class_weight='balanced',solver='liblinear')
def lr2(seed): return LogisticRegression(C=0.03,max_iter=3000,class_weight='balanced',solver='liblinear')
def et_fn(seed): return ExtraTreesClassifier(n_estimators=500,max_depth=7,min_samples_leaf=2,class_weight='balanced',random_state=seed,n_jobs=4)

def eval_cv(model_fn,use_neighbor=True,seeds=(0,1,2),normalize=False):
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; trn=np.where(f!=k)[0]
            tri=tr[trn]; vai=tr[va]
            Xtr,Xva=build_pair(tri,vai)
            if not use_neighbor:
                Xtr=Xtr[:,:-NB]; Xva=Xva[:,:-NB]
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6
            Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=model_fn(seed*100+k*7+c); m.fit(Xtr,Y[tri,c])
                P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds)
    return roc_auc_score(Y[tr].ravel(),P.ravel()),P

if __name__=='__main__':
    mode=sys.argv[1] if len(sys.argv)>1 else 'lr'
    import time
    t=time.time()
    if mode=='lr':
        a,P=eval_cv(lr_fn); np.save('preds/oof_lr_meta.npy',P)
    elif mode=='lr2':
        a,P=eval_cv(lr2); np.save('preds/oof_lr2_meta.npy',P)
    elif mode=='et':
        a,P=eval_cv(et_fn); np.save('preds/oof_et_meta.npy',P)
    elif mode=='lr_noneigh':
        a,P=eval_cv(lr_fn,use_neighbor=False); np.save('preds/oof_lr_base.npy',P)
    elif mode=='lr_noac':
        # neighbor without acoustic block handled below
        a,P=eval_cv(lr_fn); np.save('preds/oof_lr_meta.npy',P)
    print(mode,'pooledAUC',round(a,5),'time',round(time.time()-t,1))
