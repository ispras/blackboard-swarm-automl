fin=f'{SB}/final_solution/preds'
Z=sum(logit(np.load(f'{fin}/oof_{n}.npy')) for n in ['lgb_bnall','mil_attn2','dn3_max','mlp_rich_mixup'])
# co-occurrence matrix P(k present | j present)? use log cooc
C=(Ytr.T@Ytr); np.fill_diagonal(C,0); C=C/ (Ytr.sum(0)[None,:]+1)
def feats(Z):
    n=Z.shape[0]; other=np.zeros_like(Z)
    out=[Z[...,None]]
    srt=np.sort(Z,axis=1)
    mx=srt[:,-1]; mn=srt[:,-2]
    m1=np.where(Z==mx[:,None], mn[:,None], mx[:,None])
    t3=np.where(np.argsort(-Z,1)[:,None,:3]>=0, 0,0)  # placeholder
    # top3 of others: sort desc, exclude self
    idx=np.argsort(-Z,1)
    top=[]
    for rank in range(3):
        k=idx[:,rank]; v=Z[np.arange(n),k]
        selfmask=(k==np.arange(19)[None,:])  # not right shaped
        top.append(v)
    top3mean=(np.sort(Z,1)[:,-1:]+np.sort(Z,1)[:,-2:-1]+np.sort(Z,1)[:,-3:-2])/3
    # cooc weighted score per (rec,j): sum_k C[j,k]*sig(Z_k)
    S=1/(1+np.exp(-np.clip(Z,-30,30)))
    cooc=np.einsum('jk,nk->nj', C, S)
    return np.concatenate([Z[...,None], m1[...,None], top3mean[...,None], cooc[...,None],
                           np.tile(np.eye(19)[None],(n,1,1))],2)
X=feats(Z); nf=X.shape[2]
for Creg in [0.03,0.1,0.3]:
    O=np.zeros_like(Ytr)
    for f in range(5):
        trn=np.where(folds!=f)[0]; va=np.where(folds==f)[0]
        m=LogisticRegression(C=Creg,max_iter=3000).fit(X[trn].reshape(-1,nf),Ytr[trn].ravel())
        O[va]=m.predict_proba(X[va].reshape(-1,nf))[:,1].reshape(len(va),19)
    a=roc_auc_score(Ytr.ravel(),O.ravel())
    pf=[roc_auc_score(Ytr[folds==f].ravel(),O[folds==f].ravel()) for f in range(5)]
    print('cooc stack C',Creg,round(a,4),'min',round(min(pf),4),flush=True)
EOF
