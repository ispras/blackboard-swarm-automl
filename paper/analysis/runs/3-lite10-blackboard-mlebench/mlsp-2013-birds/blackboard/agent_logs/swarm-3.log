ROOT = '/download_job_code/payload/sandbox'

# ---- segment features aggregation ----
seg = {}
for line in open(f'{ROOT}/data/supplemental_data/segment_features.txt'):
    line = line.strip()
    if line.startswith('rec_id'):
        continue
    p = line.split(',')
    rid = int(p[0])
    v = np.array([float(x) for x in p[2:] if x != ''], dtype=np.float32)
    seg.setdefault(rid, []).append(v)

order, labs = load_labels()
def rec_ids_all():
    return order

def seg_feats(rid):
    if rid not in seg:
        return np.zeros(38 * 4 + 1, dtype=np.float32)
    A = np.stack(seg[rid])  # n,38
    return np.concatenate([A.mean(0), A.std(0), A.max(0), A.min(0), [len(A)]]).astype(np.float32)

# ---- metadata from filename ----
def load_map():
    m = {}
    for line in open(f'{ROOT}/data/essential_data/rec_id2filename.txt'):
        line = line.strip()
        if line.startswith('rec_id'):
            continue
        rid, fn = line.split(',')
        m[int(rid)] = fn
    return m
fnmap = load_map()

def meta_vec(rid):
    fn = fnmap[rid]
    m = re.match(r'(PC\d+)_(\d{4})(\d{2})(\d{2})_(\d{6})', fn)
    site = int(m.group(1)[2:])
    year = int(m.group(2)); month = int(m.group(3)); day = int(m.group(4))
    hh = int(m.group(5)[:2]); mi = int(m.group(5)[2:4]); ss = int(m.group(5)[4:6])
    doy = int((np.datetime64(f'{year}-{month:02d}-{day:02d}') - np.datetime64(f'{year}-01-01')).astype(int)) + 1
    tod = hh + mi / 60 + ss / 3600
    v = []
    v += [1.0 if site == s else 0.0 for s in range(1, 19)]          # 18
    v += [1.0 if year == 2009 else 0.0]                             # 1
    v += [1.0 if month == mm else 0.0 for mm in (5, 6, 7, 8)]       # 4
    v += [np.sin(2 * np.pi * doy / 365), np.cos(2 * np.pi * doy / 365)]
    v += [np.sin(2 * np.pi * tod / 24), np.cos(2 * np.pi * tod / 24)]
    v += [doy / 365.0, tod / 24.0, hh / 24.0]
    return np.array(v, dtype=np.float32)

ids = np.array(order)
Xseg = np.stack([seg_feats(r) for r in ids])
Xmeta = np.stack([meta_vec(r) for r in ids])
np.savez_compressed(f'{ROOT}/workspaces/pollux_beta/features_seg.npz', X=Xseg, ids=ids)
