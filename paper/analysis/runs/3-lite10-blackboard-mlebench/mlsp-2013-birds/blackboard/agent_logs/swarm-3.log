f=0; va=np.where(folds==f)[0]; trn=np.where(folds!=f)[0]
dl=DataLoader(DS(tr[trn],Ytr[trn]),batch_size=16,shuffle=True,drop_last=True)
opt=torch.optim.AdamW([p for p in m.parameters() if p.requires_grad],lr=1e-3)
lf=nn.BCEWithLogitsLoss()
def pred(g,y):
    m.eval(); out=[]
    with torch.no_grad():
        for x,yy in DataLoader(DS(g,y),batch_size=32):
            out.append(torch.sigmoid(m(input_values=x.to(dev)).logits).cpu().numpy())
    return np.concatenate(out)
for ep in range(20):
    m.train()
    for x,y in dl:
        loss=lf(m(input_values=x.to(dev)).logits,y.to(dev))
        opt.zero_grad(); loss.backward(); opt.step()
    if ep%5==4:
        pv=pred(tr[va],Ytr[va]); pt=pred(tr[trn],Ytr[trn])
        print(ep,'train',round(roc_auc_score(Ytr[trn].ravel(),pt.ravel()),3),'val',round(roc_auc_score(Ytr[va].ravel(),pv.ravel()),3),'loss',round(float(loss),3),flush=True)
