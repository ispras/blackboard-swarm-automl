from sklearn.metrics import roc_auc_score
SB='/download_job_code/payload/sandbox'; ROOT=f'{SB}/workspaces/pollux_epsilon'
d=np.load(f'{ROOT}/feats.npz'); Y,tm=d['Y'],d['train_mask']; Ytr=Y[tm]
folds=np.load(f'{SB}/workspaces/altair_gamma/folds_5x_seed42.npy')
EPS=1e-6
def logit(p): p=np.clip(p,EPS,1-EPS); return np.log(p/(1-p))
P={'bndn':'pollux_epsilon/preds/oof_lr_multiast_bndn.npy','bnemb':'pollux_epsilon/preds/oof_lr_multiast_bnemb.npy',
 'bn_union':'pollux_epsilon/preds/oof_lr_multiast_bn_union.npy','bndn_only':'pollux_epsilon/preds/oof_lr_bn_denoise_only.npy',
 'bnemb_only':'pollux_epsilon/preds/oof_lr_bnemb_only.npy','spcond':'pollux_epsilon/preds/oof_spcond_bnemb.npy',
 'lgb_bn_stats':'altair_gamma/preds/oof_lgb_bn_stats.npy','et_bn_stats':'altair_gamma/preds/oof_et_bn_stats.npy',
 'mlp_rich':'pollux_beta/preds/oof_mlp_rich_mixup.npy','mlp_bn':'pollux_beta/preds/oof_mlp_bn_mixup.npy',
 'lgb_bn':'pollux_beta/preds/oof_lgb_bn.npy','etemb':'altair_gamma/preds/oof_et_emb64log.npy',
 'lgbemb':'altair_gamma/preds/oof_lgb_emb64log.npy','rawdn':'pollux_epsilon/preds/oof_rawbirdnet_denoised.npy',
 'raw':'pollux_epsilon/preds/oof_rawbirdnet_avg.npy'}
L={k:logit(np.load(f'{SB}/workspaces/{v}')) for k,v in P.items()}
keys=list(L)
subsets=[ks for n in range(3,7) for ks in itertools.combinations(keys,n)]
def auc_on(ks, idx):
    z=sum(L[k] for k in ks)
    return roc_auc_score(Ytr[idx].ravel(),(1/(1+np.exp(-z)))[idx].ravel())
# nested: select best subset on 4 folds pooled, eval held fold
held=[]
for f in range(5):
    trn=np.where(folds!=f)[0]; va=np.where(folds==f)[0]
    best=(-1,None)
    for ks in subsets:
        a=auc_on(ks,trn)
        if a>best[0]: best=(a,ks)
    held.append(auc_on(best[1],va))
    print('fold',f,'held',round(held[-1],4),'chosen',best[1],flush=True)
print('nested mean',round(np.mean(held),4))
# candidate
cand=('bnemb_only','lgb_bn_stats','mlp_rich','rawdn','raw')
z=sum(L[k] for k in cand); Pv=1/(1+np.exp(-z))
print('candidate pooled',round(roc_auc_score(Ytr.ravel(),Pv.ravel()),4),'folds',[round(roc_auc_score(Ytr[folds==f].ravel(),Pv[folds==f].ravel()),4) for f in range(5)])
np.save(f'{ROOT}/preds/oof_CAND.npy',Pv)
Zt=sum(logit(np.load(f'{SB}/workspaces/{P[k]}'.replace('oof_','test_'))) for k in cand)
Pt=1/(1+np.exp(-Zt)); np.save(f'{ROOT}/preds/test_CAND.npy',Pt); np.save(f'{ROOT}/preds/test_CAND_z.npy',Zt)
print('saved CAND', Pt.shape)
