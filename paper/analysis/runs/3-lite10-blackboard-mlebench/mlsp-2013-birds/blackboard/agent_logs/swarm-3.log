exec(src)
from sklearn.decomposition import PCA
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import roc_auc_score
e12=np.load(f'{ROOT}/ast1212.npz'); e14=np.load(f'{ROOT}/ast1414.npz')
def blk(dd): return np.hstack([dd['mean'],dd['max'],np.log1p(dd['probs'])])
MA=np.hstack([blk({'mean':a['mean'],'max':a['max'],'probs':L}),blk(e12),blk(e14),hist,mil,meta_feats(np.arange(len(ids)))])
Xtr_all,Xte_all=pair(tr,te)
# PCA fit on all rows (unsupervised, no label leak)
Xall=np.vstack([Xtr_all,Xte_all]); pca=PCA(n_components=256, random_state=0).fit(Xall)
P_=pca.transform(Xtr_all).astype(np.float32); Pt_=pca.transform(Xte_all).astype(np.float32)
dev='cuda'
class MLP(nn.Module):
    def __init__(s,d):
        super().__init__(); s.n=nn.Sequential(nn.Linear(d,512),nn.BatchNorm1d(512),nn.ReLU(),nn.Dropout(0.4),
            nn.Linear(512,128),nn.BatchNorm1d(128),nn.ReLU(),nn.Dropout(0.3),nn.Linear(128,19))
    def forward(s,x): return s.n(x)
def run(seed, trn, va, epochs=60):
    torch.manual_seed(seed)
    m=MLP(P_.shape[1]).to(dev)
    X=torch.tensor(P_[trn]); Yt=torch.tensor(Ytr[trn])
    opt=torch.optim.AdamW(m.parameters(),lr=1e-3,weight_decay=1e-3)
    sch=torch.optim.lr_scheduler.OneCycleLR(opt,max_lr=1e-3,total_steps=epochs*((len(trn)+31)//32))
    lf=nn.BCEWithLogitsLoss()
    for ep in range(epochs):
        m.train(); perm=torch.randperm(len(trn))
        for i in range(0,len(trn)-1,32):
            idx=perm[i:i+32]
            if len(idx)<2: continue
            xb=X[idx].to(dev); yb=Yt[idx].to(dev)
            if np.random.rand()<0.5:
                lam=np.random.beta(0.5,0.5); pi=torch.randperm(len(idx))
                xb=lam*xb+(1-lam)*xb[pi]; yb=torch.maximum(yb,yb[pi])
            loss=lf(m(xb),yb); opt.zero_grad(); loss.backward(); opt.step(); sch.step()
    m.eval()
    with torch.no_grad():
        pv=torch.sigmoid(m(torch.tensor(P_[va]).to(dev))).cpu().numpy()
        pt=torch.sigmoid(m(torch.tensor(P_).to(dev))).cpu().numpy()
    return pv, pt
Yo=np.zeros_like(Ytr); Yt_te=np.zeros((64,19))
for seed in range(3):
    for f in range(5):
        trn=np.where(folds!=f)[0]; va=np.where(folds==f)[0]
        pv,_=run(seed*10+f,trn,va); Yo[va]+=pv/3
    _,ptest=run(seed, np.arange(258), np.arange(258))
    # refit on all for test
    m=MLP(P_.shape[1]).to(dev)
print('MLP pca OOF', round(roc_auc_score(Ytr.ravel(),Yo.ravel()),4), flush=True)
np.save(f'{ROOT}/preds/oof_mlp_pca.npy',Yo)
# full-train preds for test
for seed in range(3):
    torch.manual_seed(seed); m=MLP(P_.shape[1]).to(dev)
    X=torch.tensor(P_); Yt=torch.tensor(Ytr)
    opt=torch.optim.AdamW(m.parameters(),lr=1e-3,weight_decay=1e-3)
    ep=60; sch=torch.optim.lr_scheduler.OneCycleLR(opt,max_lr=1e-3,total_steps=ep*9)
    lf=nn.BCEWithLogitsLoss()
    for e in range(ep):
        m.train(); perm=torch.randperm(len(P_))
        for i in range(0,len(P_)-1,32):
            idx=perm[i:i+32]
            if len(idx)<2: continue
            xb=X[idx].to(dev); yb=Yt[idx].to(dev)
            if np.random.rand()<0.5:
                lam=np.random.beta(0.5,0.5); pi=torch.randperm(len(idx))
                xb=lam*xb+(1-lam)*xb[pi]; yb=torch.maximum(yb,yb[pi])
            loss=lf(m(xb),yb); opt.zero_grad(); loss.backward(); opt.step(); sch.step()
    m.eval()
    with torch.no_grad(): Yt_te+=torch.sigmoid(m(torch.tensor(Pt_).to(dev))).cpu().numpy()/3
np.save(f'{ROOT}/preds/test_mlp_pca.npy',Yt_te); print('saved mlp', flush=True)

# kNN on AST mean cosine
An=a['mean']/(np.linalg.norm(a['mean'],axis=1,keepdims=True)+1e-8)
for k in [5,10,20]:
    P=np.zeros_like(Ytr)
    for f in range(5):
        va=np.where(folds==f)[0]; trn=np.where(folds!=f)[0]
        m=KNeighborsClassifier(n_neighbors=k, metric='cosine', weights='distance').fit(An[tr][trn],Ytr[trn])
        P[va]=m.predict_proba(An[tr][va])
    print('kNN k',k,round(roc_auc_score(Ytr.ravel(),P.ravel()),4),flush=True)
    if k==10:
        np.save(f'{ROOT}/preds/oof_knn10_ast.npy',P)
        m=KNeighborsClassifier(n_neighbors=k,metric='cosine',weights='distance').fit(An[tr],Ytr)
        np.save(f'{ROOT}/preds/test_knn10_ast.npy',m.predict_proba(An[te])); print('saved knn',flush=True)
