def agg(x, kind):
    s=np.sort(x,axis=1)
    if kind=='max': return s[:,-1]
    if kind=='top2': return s[:,-2:].mean(1)
    if kind=='top3': return s[:,-3:].mean(1)
    if kind=='mean': return x.mean(1)
    if kind=='top25pct': return s[:,-15:].mean(1)
variants={}
for kind in ['max','top2','top3','mean','top25pct']:
