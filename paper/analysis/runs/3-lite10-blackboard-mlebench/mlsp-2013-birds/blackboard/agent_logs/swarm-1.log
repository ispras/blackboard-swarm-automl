import numpy as np, sys, time, json, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'.')
import bn_model as B
import combined as C, model_meta as M
from common import *
import numpy as np
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
def run(name,model,seeds=(0,1,2)):
    Xall=np.hstack([C.B,B.EMB,B.LOGI,B.BNv['stats']]).astype(np.float32)
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; tri=tr[f!=k]; vai=tr[va]
            ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=(B.lgbm if model=='lgb' else B.et)(seed,c); m.fit(Xtr,Y[tri,c]); P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds); auc=roc_auc_score(Y[tr].ravel(),P.ravel()); np.save(f'preds/oof_{name}.npy',P)
    # test
    ntr=M.neighbor_loo(tr); nte=M.neighbor_between(te,tr)
    Xtr=np.hstack([Xall[tr],ntr]); Xte=np.hstack([Xall[te],nte]); mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xte=(Xte-mu)/sd
    Pte=np.zeros((len(te),NCLASS))
    for s in seeds:
        for c in range(NCLASS):
            m=(B.lgbm if model=='lgb' else B.et)(s,c); m.fit(Xtr,Y[tr,c]); Pte[:,c]+=m.predict_proba(Xte)[:,1]
    Pte/=len(seeds); np.save(f'preds/test_{name}.npy',Pte)
    json.dump({'auc':auc,'model':model},open(f'preds/{name}.json','w'))
    print(name,round(auc,5),flush=True)
if __name__=='__main__':
    run('lgb_bn_stats','lgb',(0,1,2))
    run('et_bn_stats','et',(0,1,2))
