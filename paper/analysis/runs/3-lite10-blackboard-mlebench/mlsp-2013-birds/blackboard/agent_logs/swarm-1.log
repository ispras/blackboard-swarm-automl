"""Extract Google Perch (Bird Vocalization Classifier v4) embeddings on 5s windows.

Model: https://tfhub.dev/google/bird-vocalization-classifier/4 (general bioacoustic checkpoint,
trained on Xeno-canto; NOT this competition). Non-commercial research license per model card.
Input: 5 s @ 32 kHz -> outputs embedding (1280) + 10932-class logits.
Windows: 6 per 10 s clip (5 s window, 1 s stride), on raw and spectrally-denoised audio.
"""
import os, time, numpy as np
os.environ['TFHUB_CACHE_DIR'] = '/download_job_code/payload/sandbox/workspaces/pollux_beta/tfhub_cache'
import tensorflow as tf
import tensorflow_hub as hub
from scipy.signal import resample_poly

R = '/download_job_code/payload/sandbox/workspaces'
OUT = f'{R}/pollux_beta'
model = hub.load('https://tfhub.dev/google/bird-vocalization-classifier/4')
f = model.signatures['serving_default']

def windows_from_48k(x48):
    x32 = resample_poly(x48.astype(np.float32), 2, 3)  # 48000 -> 32000
    W = 160000
    if len(x32) < W:
        x32 = np.pad(x32, (0, W - len(x32)))
    starts = [0, 32000, 64000, 96000, 128000, 160000]
    return np.stack([x32[s:s + W] for s in starts]).astype(np.float32)  # (6,160000)

def extract(path, tag):
    X48 = np.load(path, mmap_mode='r')
    n = X48.shape[0]
    EMB = np.zeros((n, 6, 1280), dtype=np.float32)
    t0 = time.time()
    B = 30
    for i in range(0, n, B):
        W = np.concatenate([windows_from_48k(np.asarray(X48[j])) for j in range(i, min(i + B, n))], 0)
        out = f(tf.constant(W))
        e = out['output_1'].numpy().reshape(-1, 6, 1280)
        EMB[i:i + len(e)] = e
        if i % 60 == 0:
            print(tag, i, round(time.time() - t0, 1), flush=True)
    np.save(f'{OUT}/perch_emb_{tag}.npy', EMB)
    print(tag, 'saved', EMB.shape, round(time.time() - t0, 1), flush=True)

if __name__ == '__main__':
    extract(f'{R}/pollux_epsilon/wavs_48k.npy', 'raw')
    extract(f'{R}/pollux_epsilon/wavs_48k_denoised.npy', 'dn')
