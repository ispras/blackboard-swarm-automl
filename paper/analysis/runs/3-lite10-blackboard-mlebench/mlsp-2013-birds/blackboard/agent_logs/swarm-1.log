P=np.load(f'{R}/birdnet_denoised.npz.npy')
pr=1/(1+np.exp(-P))
EST=np.hstack([E.mean(1),E.max(1),E.std(1)])
ESTp=PCA(n_components=128,random_state=0).fit_transform(StandardScaler().fit_transform(EST))
BNdn=np.concatenate([pr.mean(1),pr.max(1),pr.min(1),pr.std(1),np.sort(pr,1)[:,-1],np.sort(pr,1)[:,-2]],1).astype(np.float32)
print('EST',EST.shape,'ESTp',ESTp.shape,'BNdn',BNdn.shape)
def lgbm(seed,c): return lgb.LGBMClassifier(n_estimators=300,learning_rate=0.05,num_leaves=15,min_child_samples=5,subsample=0.8,subsample_freq=1,colsample_bytree=0.4,reg_lambda=2.0,class_weight='balanced',random_state=seed*1000+c,n_jobs=4,verbose=-1)
def cv(use_emb=True,use_p=True,seeds=(0,)):
    parts=[C.B,C.EMBp[:,:64],C.LOG[:,np.argsort(-C.LOG.std(0))[:150]]]
    if use_emb: parts.append(ESTp)
    if use_p: parts.append(BNdn)
    Xall=np.hstack(parts).astype(np.float32); P2=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; tri=tr[f!=k]; vai=tr[va]
            ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=lgbm(seed,c); m.fit(Xtr,Y[tri,c]); P2[va,c]+=m.predict_proba(Xva)[:,1]
    P2/=len(seeds); return roc_auc_score(Y[tr].ravel(),P2.ravel()),P2
if __name__=='__main__':
    for name,kw in [('emb+prob',dict()),('prob',dict(use_emb=False)),('emb',dict(use_p=False))]:
        t=time.time(); a,_=cv(**kw); print(name,round(a,5),round(time.time()-t,1),flush=True)
