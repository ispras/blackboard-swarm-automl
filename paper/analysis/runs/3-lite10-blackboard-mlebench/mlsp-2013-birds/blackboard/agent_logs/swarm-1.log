import numpy as np, pandas as pd, sys
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *
from sklearn.metrics import roc_auc_score
Y,labs=load_labels(); cv=pd.read_csv(f'{ED}/CVfolds_2.txt'); tr=np.array(sorted(cv[cv.fold==0].rec_id.tolist())); Ytr=Y[tr]
folds=np.load('workspaces/altair_gamma/folds_5x_seed42.npy'); W='/download_job_code/payload/sandbox/workspaces'
def logit(p): p=np.clip(p,1e-5,1-1e-5); return np.log(p/(1-p))
def lo(a,n): return np.load(f'{W}/{a}/preds/oof_{n}.npy')
L={'ma_union':logit(lo('pollux_epsilon','lr_multiast_bn_union')),'dn3':logit(lo('pollux_beta','dn3_max')),
'lgb':logit(lo('altair_gamma','lgb_bn_stats')),'mlpbn':logit(lo('pollux_beta','mlp_bn_mixup')),
'rawdn':logit(lo('pollux_epsilon','rawbirdnet_denoised')),'spcond':logit(lo('pollux_epsilon','spcond_bnemb')),
'bnemb':logit(lo('pollux_epsilon','lr_bnemb_only')),'rich':logit(lo('pollux_beta','mlp_rich_mixup')),
'ma_bndn':logit(lo('pollux_epsilon','lr_multiast_bndn')),'etmeta':logit(lo('altair_gamma','et_meta'))}
def met(ks):
    z=np.mean([L[k] for k in ks],0); pr=1/(1+np.exp(-z)); fa=[roc_auc_score(Ytr[folds==f].ravel(),pr[folds==f].ravel()) for f in range(5)]
    return roc_auc_score(Ytr.ravel(),pr.ravel()),min(fa),fa
S=['ma_union','dn3','lgb','mlpbn','rawdn','spcond']
sets={'S6':S,'S5_drop_rawdn':[k for k in S if k!='rawdn'],'S5_drop_spcond':[k for k in S if k!='spcond'],
'S4':['ma_union','dn3','lgb','mlpbn'],'S4b':['ma_union','dn3','lgb','rich'],'S5_bnemb':['ma_union','dn3','lgb','mlpbn','bnemb'],
'S5_rich':['ma_union','dn3','lgb','mlpbn','rich'],'S6_bnemb':S+['bnemb'],'S6_rich':S+['rich'],'S5b':['ma_union','dn3','lgb','mlpbn','spcond'],
'S6b':['dn3','lgb','mlpbn','rawdn','spcond','bnemb']}
for n,ks in sets.items(): 
    p,mn,fa=met(ks); print(f'{n:16s}',round(p,5),[round(x,3) for x in fa],'min',round(mn,3))
# A_dn3 reference
print('A_dn3',met(['dn3','bnemb','rich','lgb'])[:2])
EOF
