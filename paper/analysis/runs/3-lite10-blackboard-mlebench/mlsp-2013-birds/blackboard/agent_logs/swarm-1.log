def et(seed,c): return ExtraTreesClassifier(n_estimators=400,max_depth=8,min_samples_leaf=2,class_weight='balanced',random_state=seed*1000+c,n_jobs=4)
def cv(Bextra, model='lgb'):
    parts=[C.B]+Bextra+[C.EMBp[:,:64]]+[C.LOG[:,np.argsort(-C.LOG.std(0))[:150]]]
    Xall=np.hstack(parts).astype(np.float32); P=np.zeros((len(tr),NCLASS))
    for k in range(5):
        va=np.where(folds==k)[0]; tri=tr[folds!=k]; vai=tr[va]
        ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
        Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
        mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
        for c in range(NCLASS):
            m=lgbm(0,c) if model=='lgb' else et(0,c); m.fit(Xtr,Y[tri,c]); P[va,c]=m.predict_proba(Xva)[:,1]
    return roc_auc_score(Y[tr].ravel(),P.ravel()),P
if __name__=='__main__':
    for name,ex,mdl in [('lgb_base',[],'lgb'),('lgb+maxmin',[MX,MN],'lgb'),('lgb+max',[MX],'lgb'),('et+maxmin',[MX,MN],'et')]:
        t=time.time(); a,_=cv(ex,mdl); print(name,round(a,5),round(time.time()-t,1),flush=True)
