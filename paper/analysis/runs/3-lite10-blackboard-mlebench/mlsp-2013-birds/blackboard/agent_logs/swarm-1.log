        if m.sum()>1: out[m]=alpha*prob[m]+(1-alpha)*prob[m].mean(0,keepdims=True)
    return out
best,combo=res[0]; blend=np.mean([L[k] for k in combo],0); blendp=1/(1+np.exp(-blend))
print('best blend',combo,roc_auc_score(Ytr.ravel(),blendp.ravel()))
for al in [0.0,0.5,0.6,0.7,0.8,0.9,1.0]:
    sp=smooth(blendp,al); print('smooth alpha',al,round(roc_auc_score(Ytr.ravel(),sp.ravel()),5))
# per-class logit offset calibration coordinate ascent (nested-ish)
def fit_offsets(prob,idx):
    off=np.zeros(19); base=roc_auc_score(Ytr[idx].ravel(),prob[idx].ravel())
    lg=logit(prob)
    for it in range(4):
        for c in range(19):
            for d in [-0.5,-0.25,-0.12,0.12,0.25,0.5]:
                o=off.copy(); o[c]+=d
                s=roc_auc_score(Ytr[idx].ravel(),(lg+o)[idx].ravel())
                if s>base+1e-6: base=s; off=o
    return off,base
off,base=fit_offsets(blendp,np.arange(len(tr))); print('offset full',round(base,5),np.round(off,2))
# nested: fit offsets on 4 folds, eval on held fold
pr=np.zeros_like(blendp)
for k in range(5):
    idx=np.where(folds!=k)[0]; o,_=fit_offsets(blendp,idx); lg=logit(blendp); pr[folds==k]=(lg+o)[folds==k]
print('offset nested',round(roc_auc_score(Ytr.ravel(),pr.ravel()),5))
