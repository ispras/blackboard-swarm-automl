import numpy as np, sys, time, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'.')
import final_model as F, combined as C, model_meta as M
from common import *
from sklearn.metrics import roc_auc_score
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
meta=load_meta(); sec=meta.sec.values
sites=meta.site.values; sess=meta.sess.values; date=meta.date.values
cfg=dict(use_emb=True,use_log=True,emb_k=64,log_k=150)
Xall=F.feature_matrix(**cfg)
def fit_fold(tri):
    ntr=M.neighbor_loo(tri); Xtr=np.hstack([Xall[tri],ntr])
    mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd
    models=[]
    for c in range(NCLASS):
        m=F.get_model('lgb',0,c); m.fit(Xtr,Y[tri,c]); models.append(m)
    return models,mu,sd
def pred(models,mu,sd,idx,ref):
    n=M.neighbor_between(idx,ref); X=np.hstack([Xall[idx],n]); X=(X-mu)/sd
    P=np.zeros((len(idx),NCLASS))
    for c,m in enumerate(models): P[:,c]=m.predict_proba(X)[:,c]
    return P
# per-fold predictions for all recs
fold_preds={}
for k in range(5):
    tri=tr[folds!=k]; vai=tr[folds==k]
    models,mu,sd=fit_fold(tri)
    Pall=np.zeros((len(tr),NCLASS))
    # train-fold in-sample: use LOO neighbor features (as training)
    ntr=M.neighbor_loo(tri); Xtr=np.hstack([Xall[tri],ntr]); Xtr=(Xtr-mu)/sd
    for c,m in enumerate(models): Pall[folds!=k,c]=m.predict_proba(Xtr)[:,c]
    Pall[folds==k]=pred(models,mu,sd,vai,tri)
    fold_preds[k]=Pall
def smooth_vals(alpha, weights=None):
    out=np.zeros_like(Y[tr])
    for k in range(5):
        P=fold_preds[k]; vals=tr[folds==k]
        for i,ri in enumerate(vals):
            mates=np.where((sess[tr]==sess[ri]))[0]
            mates=mates[tr[mates]!=ri]
            if len(mates)==0: out[folds==k][i]=P[folds==k][i]; continue
            out[folds==k][i]=alpha*P[folds==k][i]+(1-alpha)*P[mates].mean(0)
    return out
for a in [1.0,0.8,0.6,0.5,0.4,0.2,0.0]:
    out=smooth_vals(a); print('alpha',a,round(roc_auc_score(Y[tr].ravel(),out.ravel()),5),flush=True)
