import numpy as np, pandas as pd, sys, glob, os, json
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *
from sklearn.metrics import roc_auc_score
Y,labs=load_labels(); cv=pd.read_csv(f'{ED}/CVfolds_2.txt')
tr=np.array(sorted(cv[cv.fold==0].rec_id.tolist())); te=np.array(sorted(cv[cv.fold==1].rec_id.tolist())); Ytr=Y[tr]
folds=np.load('workspaces/altair_gamma/folds_5x_seed42.npy')
W='/download_job_code/payload/sandbox/workspaces'
cands={
 'a_etlog':f'{W}/altair_gamma/preds/oof_et_emb64log.npy',
 'a_lgblog':f'{W}/altair_gamma/preds/oof_lgb_emb64log.npy',
 'a_lgball':f'{W}/altair_gamma/preds/oof_lgb_all.npy',
 'a_etmeta':f'{W}/altair_gamma/preds/oof_et_meta.npy',
 'e_lrastfull':f'{W}/pollux_epsilon/preds/oof_lr_astfull.npy',
 'e_etastfull':f'{W}/pollux_epsilon/preds/oof_et_astfull.npy',
 'e_lrastmean':f'{W}/pollux_epsilon/preds/oof_lr_astmean.npy',
 'b_lrastfull':f'{W}/pollux_beta/preds/oof_lr_astfull_C0.01.npy',
 'b_lrastmean':f'{W}/pollux_beta/preds/oof_lr_astmean.npy',
 'b_lrastneigh':f'{W}/pollux_beta/preds/oof_lr_astfull_base_neigh_C0.01.npy',
}
P={k:np.load(v) for k,v in cands.items() if os.path.exists(v)}
for k,v in P.items(): print(k, round(roc_auc_score(Ytr.ravel(),v.ravel()),5))
def logit(p): p=np.clip(p,1e-5,1-1e-5); return np.log(p/(1-p))
def greedy(P, idx, transform=False, steps=18, verbose=False):
    keys=list(P.keys())
    M={k:(logit(P[k]) if transform else P[k]) for k in keys}
    def sc(k): return roc_auc_score(Ytr[idx].ravel(),M[k][idx].ravel())
    base=max(keys,key=sc); sel={base:1}; cur=M[base].copy(); best=sc(base)
    wsum=1
    for s in range(steps-1):
        bk=None;bs=best
        for k in keys:
            cand=(cur*wsum+M[k])/(wsum+1)
            a=roc_auc_score(Ytr[idx].ravel(),cand[idx].ravel())
            if a>bs+1e-7: bs=a;bk=k
        if bk is None: break
        cur=(cur*wsum+M[bk])/(wsum+1); wsum+=1; sel[bk]=sel.get(bk,0)+1; best=bs
    return sel,best
for transform in [False,True]:
    sel,best=greedy(P,np.arange(len(tr)),transform)
    print('TRANSFORM' if transform else 'PROB','full-fit greedy AUC',round(best,5),sel)
    # nested by canonical fold
    pred=np.zeros(len(tr))
    for k in range(5):
        idx=np.where(folds!=k)[0]; sel2,_=greedy(P,idx,transform)
        M={kk:(logit(P[kk]) if transform else P[kk]) for kk in P}
        cur=np.zeros((len(tr),NCLASS)); ws=sum(sel2.values())
        for kk,w in sel2.items(): cur+=w*M[kk]
        cur/=ws
        pred[folds==k]=cur[folds==k]
    print('   nested blend AUC',round(roc_auc_score(Ytr.ravel(),pred.ravel()),5))
EOF
