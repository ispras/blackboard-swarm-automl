"""MLSP 2013 birds — swarm final solution (blend reproduction).

Reads the frozen per-model out-of-fold (OOF) and test predictions from ./preds,
builds the agreed equal-weight logit blend, and writes ./submission.csv.

Run:  python solution.py
Requires: numpy, pandas, scikit-learn (only for the optional AUC print).
"""
import os, json, numpy as np, pandas as pd
from sklearn.metrics import roc_auc_score

HERE = os.path.dirname(os.path.abspath(__file__))
SB = os.path.dirname(HERE)  # sandbox root (contains data/)

CORE = [
    'lr_multiastneigh',   # pollux_epsilon: LR on 3x AST embeddings + AudioSet logits + hist/mil + meta + fold-safe neighbours
    'lr_clapastneigh',    # pollux_epsilon: LR on CLAP+AST + hist/mil + meta + fold-safe neighbours
    'et_emb64log',        # altair_gamma: ET on hist/seg/meta + AST-PCA64 + AudioSet + fold-safe neighbours
    'lgb_emb64log',       # altair_gamma: LightGBM on the same feature set
    'et_meta',            # altair_gamma: ET on hist/seg/meta + fold-safe session/date neighbour labels
    'et_astneigh',        # pollux_epsilon: ET on AST + hist/mil + meta + neighbours
]
MLP = 'mlp_multilabel'    # pollux_beta: multi-label MLP (BCE) on AST+hist/mil+meta+raw-audio PCA+neighbours
MLP_W = 0.4

def logit(p):
    p = np.clip(p, 1e-6, 1 - 1e-6)
    return np.log(p / (1 - p))

def sigmoid(x):
    return 1.0 / (1.0 + np.exp(-x))

def main():
    core_oof = np.mean([logit(np.load(f'{HERE}/preds/oof_{n}.npy')) for n in CORE], axis=0)
    core_test = np.mean([logit(np.load(f'{HERE}/preds/test_{n}.npy')) for n in CORE], axis=0)
    mlp_oof = logit(np.load(f'{HERE}/preds/oof_{MLP}.npy'))
    mlp_test = logit(np.load(f'{HERE}/preds/test_{MLP}.npy'))

    oof = sigmoid((1 - MLP_W) * core_oof + MLP_W * mlp_oof)
    test = sigmoid((1 - MLP_W) * core_test + MLP_W * mlp_test)

    # honest CV report (labels come only from the provided training split)
    lab = {}
    for line in open(f'{SB}/data/essential_data/rec_labels_test_hidden.txt'):
        line = line.strip()
        if line.startswith('rec_id'):
            continue
        p = line.split(','); rid = int(p[0])
        if p[1:] != ['?']:
            lab[rid] = tuple(int(x) for x in p[1:] if x != '')
    train_ids = sorted(lab)
    Y = np.zeros((len(train_ids), 19))
    for i, r in enumerate(train_ids):
        for s in lab[r]:
            Y[i, s] = 1
    print('final blend OOF global AUC = %.4f' % roc_auc_score(Y.ravel(), oof.ravel()))

    ss = pd.read_csv(f'{SB}/data/sample_submission.csv')
    out = pd.DataFrame({'Id': ss.Id.values, 'Probability': np.clip(test.reshape(-1), 1e-6, 1 - 1e-6)})
    out.to_csv(f'{HERE}/submission.csv', index=False)
    print('wrote', f'{HERE}/submission.csv', out.shape)

if __name__ == '__main__':
    main()
