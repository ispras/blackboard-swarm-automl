import numpy as np, sys, time, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
import combined as C
import model_meta as M
from common import *
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.metrics import roc_auc_score
import lightgbm as lgb
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
# union feature blocks all 322
EMBall=C.EMB.copy()
LOG1=np.log1p(C.LOG)
B=C.B
def build_blocks(use_raw=False,raw_k=200,use_ast=True,use_log=True):
    parts=[B]
    if use_raw:
        v=C.RAW.std(0); idx=np.argsort(-v)[:raw_k]; parts.append(C.RAW[:,idx])
    if use_ast: parts.append(EMBall)
    if use_log: parts.append(LOG1)
    return np.hstack(parts).astype(np.float32)

def cv(Xall, kind, Cval=0.05, seeds=(0,), depth=8, nest=400):
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; trn=np.where(f!=k)[0]; tri=tr[trn]; vai=tr[va]
            ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                if kind=='lr': m=LogisticRegression(C=Cval,max_iter=3000,class_weight='balanced',solver='liblinear')
                elif kind=='et': m=ExtraTreesClassifier(n_estimators=nest,max_depth=depth,min_samples_leaf=2,class_weight='balanced',random_state=seed*1000+k*7+c,n_jobs=4)
                elif kind=='lgb': m=lgb.LGBMClassifier(n_estimators=300,learning_rate=0.04,num_leaves=15,min_child_samples=5,subsample=0.8,subsample_freq=1,colsample_bytree=0.3,reg_lambda=2.0,class_weight='balanced',random_state=seed*1000+c,n_jobs=4,verbose=-1)
                m.fit(Xtr,Y[tri,c]); P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds)
    return roc_auc_score(Y[tr].ravel(),P.ravel()),P

if __name__=='__main__':
    mode=sys.argv[1]
    if mode=='screen':
        X=build_blocks()
        for cv_ in [0.01,0.03,0.05,0.1,0.3]:
            t=time.time(); a,P=cv(X,'lr',Cval=cv_,seeds=(0,)); print('lr union C',cv_,round(a,5),'t',round(time.time()-t,1),flush=True)
        t=time.time(); a,P=cv(X,'lgb',seeds=(0,)); print('lgb union',round(a,5),'t',round(time.time()-t,1),flush=True)
    elif mode=='screen2':
        for name,kw in [('ast+log',dict(use_raw=False)),('ast+log+raw200',dict(use_raw=True,raw_k=200)),('logonly',dict(use_ast=False)),('astonly',dict(use_log=False))]:
            X=build_blocks(**kw); t=time.time(); a,P=cv(X,'lr',Cval=0.05,seeds=(0,)); print(name,round(a,5),'t',round(time.time()-t,1),flush=True)
EOF
