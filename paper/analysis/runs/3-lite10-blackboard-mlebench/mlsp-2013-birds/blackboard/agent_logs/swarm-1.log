import numpy as np, sys, time, warnings, os
warnings.filterwarnings('ignore')
os.environ['OMP_NUM_THREADS']='4'
sys.path.insert(0,'.')
import torch, torch.nn as nn
torch.set_num_threads(4)
import combined as C, model_meta as M
from common import *
from sklearn.metrics import roc_auc_score
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
meta=load_meta(); sec=meta.sec.values; site=meta.site.values; sess=meta.sess.values; date=meta.date.values
Xall=C.feature_matrix(use_emb=True,use_log=True,emb_k=64,log_k=150) if hasattr(C,'feature_matrix') else None
import final_model as F
Xall=F.feature_matrix(use_emb=True,use_log=True,emb_k=64,log_k=150)
class Net(nn.Module):
    def __init__(self,d):
        super().__init__()
        self.net=nn.Sequential(nn.Linear(d,256),nn.BatchNorm1d(256),nn.ReLU(),nn.Dropout(0.4),
                               nn.Linear(256,128),nn.BatchNorm1d(128),nn.ReLU(),nn.Dropout(0.3),
                               nn.Linear(128,19))
    def forward(self,x): return self.net(x)
def inner_split(tri,seed):
    yk=Y[tri].sum(1)
    rng=np.random.RandomState(seed)
    # hold out ~15% stratified by label-count
    val=[]
    for v in np.unique(yk):
        ids=np.where(yk==v)[0]
        rng.shuffle(ids); val+=list(ids[:max(1,int(round(0.15*len(ids))))])
    val=np.array(sorted(set(val))); m=np.ones(len(tri),bool); m[val]=False
    return tri[m],tri[val]
def train_one(Xtr,Ytr, Xvi,Yvi, seed, max_ep=200, patience=25):
    torch.manual_seed(seed); np.random.seed(seed)
    d=Xtr.shape[1]; net=Net(d); opt=torch.optim.AdamW(net.parameters(),lr=1e-3,weight_decay=2e-4)
    Xt=torch.tensor(Xtr,dtype=torch.float32); Yt=torch.tensor(Ytr,dtype=torch.float32)
    Xv=torch.tensor(Xvi,dtype=torch.float32)
    lossf=nn.BCEWithLogitsLoss()
    best=-1; best_state=None; bad=0; n=len(Xt)
    for ep in range(max_ep):
        net.train(); perm=torch.randperm(n)
        for i in range(0,n,32):
            b=perm[i:i+32]
            opt.zero_grad(); out=net(Xt[b]); loss=lossf(out,Yt[b]); loss.backward(); opt.step()
        net.eval()
        with torch.no_grad(): pv=torch.sigmoid(net(Xv)).numpy()
        a=roc_auc_score(Yvi.ravel(),pv.ravel())
        if a>best+1e-5: best=a; best_state={k:v.clone() for k,v in net.state_dict().items()}; bad=0
        else: bad+=1
        if bad>=patience: break
    net.load_state_dict(best_state); return net
def predict(net,X):
    net.eval()
    with torch.no_grad(): return torch.sigmoid(net(torch.tensor(X,dtype=torch.float32))).numpy()
def build(tri,vai):
    ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
    Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
    mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6
    return (Xtr-mu)/sd,(Xva-mu)/sd
def run(seeds=(0,1,2),save=None):
    P=np.zeros((len(tr),NCLASS))
    for k in range(5):
        va=np.where(folds==k)[0]; tri=tr[folds!=k]; vai=tr[va]
        Xtr,Xva=build(tri,vai)
        for s in seeds:
            itr,iva=inner_split(tri,s+100)
            # need aligned features for inner; rebuild neighbor for inner using tri only
            n_itr=M.neighbor_loo(itr); n_iva=M.neighbor_between(iva,tri)
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6
            Xi_tr=np.hstack([Xall[itr],n_itr]); Xi_va=np.hstack([Xall[iva],n_iva]); Xi_tr=(Xi_tr-mu)/sd; Xi_va=(Xi_va-mu)/sd
            net=train_one(Xi_tr,Y[itr],Xi_va,Y[iva],s*100+k)
            P[va]+=predict(net,Xva)
    P/=len(seeds); auc=roc_auc_score(Y[tr].ravel(),P.ravel())
    if save:
        np.save(f'preds/oof_{save}.npy',P)
        # test model: train on all train with inner split, predict test
        ntr=M.neighbor_loo(tr); nte=M.neighbor_between(te,tr)
        Xtr=np.hstack([Xall[tr],ntr]); Xte=np.hstack([Xall[te],nte]); mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xte=(Xte-mu)/sd
        Pte=np.zeros((len(te),NCLASS))
        for s in seeds:
            itr,iva=inner_split(tr,s+100)
            n_itr=M.neighbor_loo(itr); n_iva=M.neighbor_between(iva,tr)
            Xi_tr=np.hstack([Xall[itr],n_itr]); Xi_va=np.hstack([Xall[iva],n_iva]); Xi_tr=(Xi_tr-mu)/sd; Xi_va=(Xi_va-mu)/sd
            net=train_one(Xi_tr,Y[itr],Xi_va,Y[iva],s*100+77)
            Pte+=predict(net,Xte)
        Pte/=len(seeds); np.save(f'preds/test_{save}.npy',Pte)
    return auc,P
if __name__=='__main__':
    t=time.time(); auc,P=run(seeds=(0,1,2),save='mlp_union'); print('mlp_union AUC',round(auc,5),'t',round(time.time()-t,1))
