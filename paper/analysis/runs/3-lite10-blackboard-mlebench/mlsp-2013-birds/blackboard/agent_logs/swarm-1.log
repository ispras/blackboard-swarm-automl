import numpy as np, pandas as pd, json
from sklearn.model_selection import StratifiedKFold

ROOT = '/download_job_code/payload/sandbox'
def load_labels():
    labs = {}
    order = []
    for line in open(f'{ROOT}/data/essential_data/rec_labels_test_hidden.txt'):
        line = line.strip()
        if line.startswith('rec_id'):
            continue
        p = line.split(',')
        rid = int(p[0]); ls = p[1:]
        order.append(rid)
        if ls == ['?']:
            labs[rid] = None
        else:
            labs[rid] = tuple(int(x) for x in ls if x != '')
    return order, labs

order, labs = load_labels()
train_ids = np.array([r for r in order if labs[r] is not None])
test_ids = np.array([r for r in order if labs[r] is None])

# rarest-present-label stratify key (empty = -1)
from collections import Counter
cnt = Counter()
for r in train_ids:
    for s in labs[r]:
        cnt[s] += 1
def key(r):
    ls = labs[r]
    if len(ls) == 0:
        return -1
    return min(ls, key=lambda s: cnt[s])
y = np.array([key(r) for r in train_ids])

folds = np.full(len(train_ids), -1, dtype=int)
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
for f, (_, va) in enumerate(skf.split(train_ids, y)):
    folds[va] = f

np.save(f'{ROOT}/workspaces/pollux_beta/folds.npy', folds)
df = pd.DataFrame({'rec_id': train_ids, 'fold': folds})
df.to_csv(f'{ROOT}/workspaces/pollux_beta/folds.csv', index=False)
# sanity
for f in range(5):
    tr = set(train_ids[folds != f]); va = set(train_ids[folds == f])
    print(f'fold {f}: train {len(tr)} val {len(va)}')
missing = [s for s in range(19) if any(len(set(train_ids[(folds==f)]) & {r for r in train_ids if s in labs[r]})==0 for f in range(5))]
print('labels missing from some val fold:', missing)
print('saved folds.npy / folds.csv; test ids', len(test_ids))
