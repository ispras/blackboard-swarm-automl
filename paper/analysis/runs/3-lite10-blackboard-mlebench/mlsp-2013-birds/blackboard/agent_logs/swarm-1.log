import numpy as np, sys, time, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'.')
import combined as C, model_meta as M
from common import *
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
BLOCKS=[C.B, C.EMB, np.log1p(C.LOG)]
def cv(blocks, Cval=0.05, seeds=(0,), bscale=True):
    Xall=np.hstack(blocks).astype(np.float64)
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; trn=np.where(f!=k)[0]; tri=tr[trn]; vai=tr[va]
            ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            if bscale:
                sc=StandardScaler().fit(Xtr); Xtr=sc.transform(Xtr); Xva=sc.transform(Xva)
            else:
                mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=LogisticRegression(C=Cval,max_iter=4000,class_weight='balanced',solver='liblinear')
                m.fit(Xtr,Y[tri,c]); P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds); return roc_auc_score(Y[tr].ravel(),P.ravel()),P
if __name__=='__main__':
    for Cv in [0.003,0.01,0.03,0.1]:
        t=time.time(); a,_=cv(BLOCKS,Cval=Cv,seeds=(0,)); print('blockscaled LR C',Cv,round(a,5),round(time.time()-t,1),flush=True)
    # log-only / ast-only
    for name,bl in [('AST+log',[C.EMB,np.log1p(C.LOG)]),('B+AST+log',BLOCKS)]:
        a,_=cv(bl,Cval=0.03,seeds=(0,)); print(name,'C0.03',round(a,5),flush=True)
