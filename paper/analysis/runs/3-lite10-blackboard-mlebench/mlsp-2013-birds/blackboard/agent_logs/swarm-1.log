import numpy as np, pandas as pd, sys, json
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *
from model_meta import base_feats, neighbor_loo, neighbor_between, lr_fn, lr2, et_fn, NB, Y, tr, te
from sklearn.metrics import roc_auc_score

def fit_predict(model_fn, seeds=(0,1,2), n_estimators=None):
    Xtr=np.hstack([base_feats(tr),neighbor_loo(tr)])
    Xte=np.hstack([base_feats(te),neighbor_between(te,tr)])
    mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xte=(Xte-mu)/sd
    Ptr=np.zeros((len(tr),NCLASS)); Pte=np.zeros((len(te),NCLASS))
    for s in seeds:
        for c in range(NCLASS):
            m=model_fn(s*1000+c); m.fit(Xtr,Y[tr,c])
            Ptr[:,c]+=m.predict_proba(Xtr)[:,1]
            Pte[:,c]+=m.predict_proba(Xte)[:,1]
    return Ptr/len(seeds), Pte/len(seeds)

def make_sub(Pte, path):
    ids=np.concatenate([[r*100+c for c in range(NCLASS)] for r in te])
    sub=pd.DataFrame({'Id':ids,'Probability':Pte.reshape(-1)})
    sub=sub.set_index('Id').loc[pd.read_csv(f'{BASE}/sample_submission.csv').Id].reset_index()
    sub.to_csv(path,index=False,float_format='%.6f')
    return sub

if __name__=='__main__':
    # ET final
    Ptr,Pte=fit_predict(et_fn,seeds=(0,1,2)); np.save('preds/test_et_meta.npy',Pte); np.save('preds/oof_et_meta_full.npy',Ptr)
    print('ET insample AUC',roc_auc_score(Y[tr].ravel(),Ptr.ravel()))
    make_sub(Pte,'submission_et_meta.csv')
    Ptr2,Pte2=fit_predict(lr2,seeds=(0,1,2)); np.save('preds/test_lr2_meta.npy',Pte2); np.save('preds/oof_lr2_meta_full.npy',Ptr2)
    print('LR insample AUC',roc_auc_score(Y[tr].ravel(),Ptr2.ravel()))
    make_sub(Pte2,'submission_lr2_meta.csv')
    from scipy.stats import rankdata
    for name,pa,pb in [('avg',Ptr,Pte),('avgLR',Ptr2,Pte2)]:
        pass
    print('done')
EOF
