import numpy as np, pandas as pd, sys
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *

class NeighExt:
    def __init__(self):
        self.meta=load_meta(); self.Y,labs=load_labels()
        m=self.meta
        self.site=m.site.values; self.sess=m.sess.values; self.date=m.date.values
        self.sec=m.sec.values.astype(float); self.doy=m.doy.values.astype(float); self.year=m.year.values.astype(float)
        # absolute timestamp in hours (year via doy only + leap ignored approx)
        self.ts=(self.year-2009)*365*24 + self.doy*24 + self.sec/3600.0
        self.H=load_hist(); self.Hn=self.H/(np.linalg.norm(self.H,axis=1,keepdims=True)+1e-8)
    def blocks(self, q, r, acoustic_k=10):
        qs=self.site[q][:,None]==self.site[r][None,:]
        qd=self.date[q][:,None]==self.date[r][None,:]
        dt=np.abs(self.ts[q][:,None]-self.ts[r][None,:])
        dsec=np.abs(self.sec[q][:,None]-self.sec[r][None,:])
        B=[self.sess[q][:,None]==self.sess[r][None,:], qs, qd,
           qs&(dt<=1), qs&(dt<=24), qs&(dt<=24*7),
           qd&(dsec<=7200), qs&(dsec<=7200)]
        sim=self.Hn[q]@self.Hn[r].T
        if acoustic_k:
            k=min(acoustic_k,sim.shape[1]); idx=np.argpartition(-sim,k-1,axis=1)[:,:k]
            M=np.zeros_like(sim)
            rows=np.arange(sim.shape[0])[:,None]; M[rows,idx]=np.clip(sim[rows,idx],0,None)
            B.append(M)
        w=np.exp(-dt/6.0)*qs  # same site, 6h decay
        B.append(w)
        return B
    def between(self, q, r, acoustic_k=10):
        R=self.Y[r]; B=self.blocks(q,r,acoustic_k)
        nb=len(B); F=np.zeros((len(q),nb*(NCLASS+1)),dtype=np.float32)
        for b,M in enumerate(B):
            M=M.astype(np.float32); s=M.sum(1)
            F[:,b*(NCLASS+1):b*(NCLASS+1)+NCLASS]=(M@R)/np.maximum(s,1e-6)[:,None]
            F[:,b*(NCLASS+1)+NCLASS]=s
        return F
    def loo(self, idx, acoustic_k=10):
        R=self.Y[idx]; B=self.blocks(idx,idx,acoustic_k)
        nb=len(B); F=np.zeros((len(idx),nb*(NCLASS+1)),dtype=np.float32)
        for b,M in enumerate(B):
            M=M.astype(np.float32); np.fill_diagonal(M,0); s=M.sum(1)
            F[:,b*(NCLASS+1):b*(NCLASS+1)+NCLASS]=(M@R)/np.maximum(s,1e-6)[:,None]
            F[:,b*(NCLASS+1)+NCLASS]=s
        return F
