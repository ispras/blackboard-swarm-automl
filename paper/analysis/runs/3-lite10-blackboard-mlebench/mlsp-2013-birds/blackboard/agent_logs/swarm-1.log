from common import *
from sklearn.metrics import roc_auc_score
Y,labs=load_labels(); cv=pd.read_csv(f'{ED}/CVfolds_2.txt'); tr=np.array(sorted(cv[cv.fold==0].rec_id.tolist())); Ytr=Y[tr]
folds=np.load('workspaces/altair_gamma/folds_5x_seed42.npy'); W='/download_job_code/payload/sandbox/workspaces'
def logit(p): p=np.clip(p,1e-5,1-1e-5); return np.log(p/(1-p))
R=W+'/pollux_epsilon'; G=W+'/altair_gamma/preds'; B=W+'/pollux_beta/preds'
orig=1/(1+np.exp(-np.load(f'{R}/birdnet.npz')['logits19']))
dns=[1/(1+np.exp(-np.load(f'{R}/{f}'))) for f in ['birdnet_denoised.npz.npy','birdnet_denoised_a2.5.npy','birdnet_denoised_a3.5.npy']]
dn3=np.concatenate(dns,1); allw=np.concatenate([orig]+dns,1)
base=logit(np.load(f'{R}/preds/oof_lr_bnemb_only.npy'))+logit(np.load(f'{B}/oof_mlp_rich_mixup.npy'))+logit(np.load(f'{G}/oof_lgb_bn_stats.npy'))
def met(z):
