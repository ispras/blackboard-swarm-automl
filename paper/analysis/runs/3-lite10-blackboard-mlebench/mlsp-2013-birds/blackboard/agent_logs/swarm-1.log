    return roc_auc_score(Ytr.ravel(),pr.ravel()),min(fa)
def agg(Wd,kind):
    if kind=='max': r=Wd.max(1)
    elif kind=='mean': r=Wd.mean(1)
    elif kind=='top2': r=np.sort(Wd,1)[:,-2:].mean(1)
    elif kind=='top3': r=np.sort(Wd,1)[:,-3:].mean(1)
    return r
for name,Wd in [('dn3',dn3),('all',allw)]:
    for kind in ['max','top2','top3','mean']:
        p=agg(Wd,kind); a=roc_auc_score(Ytr.ravel(),p[tr].ravel()); bb,mm=met(base+logit(p)[tr])
        print(f'{name}_{kind:5s} raw {a:.4f} blend {bb:.5f} min {mm:.3f}')
# combos of max across alphas then average
ens=np.mean([d.max(1) for d in dns],0)
print('ens_meanmax',round(roc_auc_score(Ytr.ravel(),ens[tr].ravel()),4),met(base+logit(ens)[tr]))
# add rawbn z
rawz=np.load(f'{R}/preds/oof_rawbirdnet_avg.npy')
print('dn3max+rawz',met(base+logit(agg(dn3,'max'))[tr]+rawz))
