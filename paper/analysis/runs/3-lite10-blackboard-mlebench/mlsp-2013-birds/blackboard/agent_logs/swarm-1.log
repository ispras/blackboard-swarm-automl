import numpy as np, sys, time, json, os, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'.')
import torch, torch.nn as nn
torch.set_num_threads(4)
import combined as C, model_meta as M
import bn_model as B
from common import *
from sklearn.metrics import roc_auc_score
from sklearn.preprocessing import StandardScaler
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
X=np.hstack([C.B,C.EMB[:,:] if C.EMB.shape[1]<=64 else C.EMBp[:,:64], C.LOG[:,np.argsort(-C.LOG.std(0))[:150]], B.BNv['stats'], B.BNv['pca'][:,:128]]).astype(np.float32)
print('X',X.shape)
class Net(nn.Module):
    def __init__(self,d,h1=256,h2=128,p=0.5):
        super().__init__()
        self.net=nn.Sequential(nn.Linear(d,h1),nn.BatchNorm1d(h1),nn.GELU(),nn.Dropout(p),
                               nn.Linear(h1,h2),nn.BatchNorm1d(h2),nn.GELU(),nn.Dropout(p*0.8),nn.Linear(h2,19))
    def forward(self,x): return self.net(x)
def train_one(Xtr,ytr,Xte,seed,epochs=200,mixup=0.4):
    torch.manual_seed(seed); np.random.seed(seed)
    m=Net(Xtr.shape[1]); opt=torch.optim.AdamW(m.parameters(),lr=1.2e-3,weight_decay=3e-3)
    sch=torch.optim.lr_scheduler.CosineAnnealingLR(opt,epochs); lossf=nn.BCEWithLogitsLoss()
    Xt=torch.tensor(Xtr,dtype=torch.float32); yt=torch.tensor(ytr,dtype=torch.float32); n=len(Xt)
    for ep in range(epochs):
        m.train(); perm=torch.randperm(n)
        for i in range(0,n,32):
            idx=perm[i:i+32]; xb,yb=Xt[idx],yt[idx]
            if mixup>0 and len(idx)>3:
                lam=np.random.beta(mixup,mixup); ridx=torch.randperm(len(idx))
                xb=lam*xb+(1-lam)*xb[ridx]; yb=lam*yb+(1-lam)*yb[ridx]
            opt.zero_grad(); loss=lossf(m(xb),yb); loss.backward(); opt.step()
        sch.step()
    m.eval()
    with torch.no_grad(): return torch.sigmoid(m(torch.tensor(Xte,dtype=torch.float32))).numpy()
def run(seeds=(0,1,2)):
    P=np.zeros((len(tr),19)); T=np.zeros((len(te),19))
    for k in range(5):
        va=np.where(folds==k)[0]; tri=tr[folds!=k]; vai=tr[va]
        Xtr=np.hstack([X[tri],M.neighbor_loo(tri)]); Xva=np.hstack([X[vai],M.neighbor_between(vai,tri)])
        sc=StandardScaler().fit(Xtr); Xtr=sc.transform(Xtr); Xva=sc.transform(Xva)
        Xte=np.hstack([X[te],M.neighbor_between(te,tri)]); Xte=sc.transform(Xte)
        for s in seeds:
            P[va]+=train_one(Xtr,Y[tri],Xva,100*s+k)/len(seeds)
            T+=train_one(Xtr,Y[tri],Xte,100*s+k)/(5*len(seeds))
        print('fold',k,'done',flush=True)
    auc=roc_auc_score(Y[tr].ravel(),P.ravel()); print('mlp_bn OOF',round(auc,4),flush=True)
    np.save('preds/oof_mlp_bn.npy',P); np.save('preds/test_mlp_bn.npy',T); json.dump({'auc':auc},open('preds/mlp_bn.json','w'))
    return auc
if __name__=='__main__':
    t=time.time(); run(); print('total',round(time.time()-t,1))
