import numpy as np, pandas as pd, sys
sys.path.insert(0,'.')
from common import *
from sklearn.metrics import roc_auc_score
Y,labs=load_labels(); meta=load_meta(); cv=pd.read_csv(f'{ED}/CVfolds_2.txt')
tr=np.array(sorted(cv[cv.fold==0].rec_id.tolist())); Ytr=Y[tr]
site=meta.site.values; sess=meta.sess.values; date=meta.date.values; sec=meta.sec.values
def rate(mask_fn, name):
    P=np.zeros_like(Ytr)
    for j,ri in enumerate(tr):
        m=mask_fn(ri); m[j]=False
        if m.sum(): P[j]=Ytr[m].mean(0)
        else: P[j]=Ytr.mean(0)
    print(name,'pooledAUC',round(roc_auc_score(Ytr.ravel(),P.ravel()),4))
    return P
p_sess=rate(lambda ri:(sess[tr]==sess[ri]),'session rate')
p_site=rate(lambda ri:(site[tr]==site[ri]),'site rate')
p_date=rate(lambda ri:(date[tr]==date[ri]),'date rate')
p_time=rate(lambda ri:(site[tr]==site[ri])&(np.abs(sec[tr]-sec[ri])<=3600),'site1h rate')
p_glob=rate(lambda ri:np.ones(len(tr),bool),'global prior')
# combine simple average
comb=(p_sess+p_site+p_date+p_time)/4
print('avg 4 blocks',round(roc_auc_score(Ytr.ravel(),comb.ravel()),4))
# within-session label agreement
same=[]; diff=[]
for i in range(len(tr)):
    for j in range(i+1,len(tr)):
        if sess[tr[i]]==sess[tr[j]]: same.append((Ytr[i]*Ytr[j]).sum()/((Ytr[i]+Ytr[j]).sum()+1e-9))
print('n same-session pairs',len(same),'mean Jaccard-like',np.mean(same) if same else None)
# probability that class c present in rec given present in session mate
for c in range(19):
    num=0;den=0
    for i in range(len(tr)):
        for j in range(len(tr)):
            if i!=j and sess[tr[i]]==sess[tr[j]] and Ytr[j,c]==1:
                den+=1; num+=Ytr[i,c]
    if den: print('class',c,'P(present|mate present)=',round(num/den,3),'prior',round(Ytr[:,c].mean(),3),'n',den)
