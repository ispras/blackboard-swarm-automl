EPS = 1e-6
def logit(p): p = np.clip(p, EPS, 1-EPS); return np.log(p/(1-p))

want = ['pol:lr_astneigh', 'pol:lr_astfull', 'pol:lr_clap_ast_hm', 'pol:lr_clap',
        'pol:et_astfull', 'alt:et_emb64log', 'alt:lgb_emb64log', 'alt:et_meta', 'alt:lgb_all',
