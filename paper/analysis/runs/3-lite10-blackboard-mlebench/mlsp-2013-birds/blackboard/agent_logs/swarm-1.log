BASE=np.hstack([C.B,C.EMBp[:,:64],C.LOG[:,np.argsort(-C.LOG.std(0))[:150]],B.BNv['stats'],T.BNd]).astype(np.float32)
def cv(mode,seeds=(0,)):
    parts=[BASE]+([Ep] if mode=='perch' else [])
    Xall=np.hstack(parts).astype(np.float32); P2=np.zeros((len(tr),NCLASS))
