import numpy as np, pandas as pd, sys, time, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *
import model_meta as M
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.decomposition import PCA
from sklearn.metrics import roc_auc_score
from sklearn.preprocessing import StandardScaler

R='/download_job_code/payload/sandbox/workspaces'
tr,te=M.tr,M.te; folds=M.folds

def load_npz(f):
    d=np.load(f,allow_pickle=True)
    if 'ids' in d.files:
        ids=d['ids']; X=d['X'] if 'X' in d.files else None
        order=np.argsort(ids); return X[order]
    return d

# base
allid=np.arange(322)
B=M.base_feats(allid)
RAW=load_npz(f'{R}/pollux_beta/features_rawaudio.npz')
# AST embeddings
ae=np.load(f'{R}/pollux_epsilon/ast_emb.npz'); ids=ae['ids']; o=np.argsort(ids)
EMB=np.hstack([ae[k][o] for k in ['mean','max','std']])
LOG=np.load(f'{R}/pollux_epsilon/ast_logits.npz')['probs'][o]
print('shapes B',B.shape,'RAW',RAW.shape,'EMB',EMB.shape,'LOG',LOG.shape)
# PCA embeddings fitted on all recs (unsupervised, no labels)
pca=PCA(n_components=128,random_state=0); EMBp=pca.fit_transform(StandardScaler().fit_transform(EMB))
print('EMB pca evr',pca.explained_variance_ratio_.sum())

def build(use_raw=False,use_emb=False,use_log=False,use_neigh=True,emb_k=128,log_k=150):
    parts=[B]
    if use_raw: parts.append(RAW)
    if use_emb: parts.append(EMBp[:,:emb_k])
    if use_log:
        # select top columns by variance (unsupervised)
        v=LOG.std(0); idx=np.argsort(-v)[:log_k]; parts.append(LOG[:,idx])
    Xall=np.hstack(parts).astype(np.float32)
    trf=np.hstack([Xall[tr], M.neighbor_loo(tr) if use_neigh else np.zeros((len(tr),M.NB),dtype=np.float32)])
    Xva=[]
    return Xall,trf

def cv_et(use_raw=False,use_emb=False,use_log=False,use_neigh=True,nest=300,depth=8,seeds=(0,),emb_k=128,log_k=150):
    parts=[B]
    if use_raw: parts.append(RAW)
    if use_emb: parts.append(EMBp[:,:emb_k])
    if use_log:
        v=LOG.std(0); idx=np.argsort(-v)[:log_k]; parts.append(LOG[:,idx])
    Xall=np.hstack(parts).astype(np.float32)
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; trn=np.where(f!=k)[0]; tri=tr[trn]; vai=tr[va]
            if use_neigh:
                ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
                Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            else:
                Xtr=Xall[tri]; Xva=Xall[vai]
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=ExtraTreesClassifier(n_estimators=nest,max_depth=depth,min_samples_leaf=2,class_weight='balanced',random_state=seed*100+k*7+c,n_jobs=4)
                m.fit(Xtr,Y[tri,c]); P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds)
    return roc_auc_score(Y[tr].ravel(),P.ravel()),P

if __name__=='__main__':
    which=sys.argv[1]
    if which=='screen':
        configs=[
            ('base+neigh',dict()),
            ('+raw',dict(use_raw=True)),
            ('+emb',dict(use_emb=True)),
            ('+log',dict(use_log=True)),
            ('+raw+emb+log',dict(use_raw=True,use_emb=True,use_log=True)),
        ]
        for name,kw in configs:
            t=time.time(); a,P=cv_et(seeds=(0,),**kw); print(name,'AUC',round(a,5),'t',round(time.time()-t,1),flush=True)
