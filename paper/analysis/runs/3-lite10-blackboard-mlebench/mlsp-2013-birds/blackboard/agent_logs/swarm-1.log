print('wavs', wavs.shape, flush=True)

fe = ClapFeatureExtractor.from_pretrained('laion/clap-htsat-unfused')
model = ClapModel.from_pretrained('laion/clap-htsat-unfused').to(dev).eval()
embs = []
t0 = time.time()
with torch.no_grad():
    for i in range(0, len(wavs), 8):
        inp = fe(list(wavs[i:i+8]), sampling_rate=48000, return_tensors='pt')
        inp = {k: v.to(dev) for k, v in inp.items()}
        with torch.autocast('cuda', dtype=torch.float16):
            e = model.get_audio_features(**inp)
        embs.append(e.float().cpu().numpy())
        if i % 80 == 0: print(i, f'{time.time()-t0:.1f}s', flush=True)
E = np.concatenate(embs)
# l2 normalize for cosine-friendly downstream
En = E / (np.linalg.norm(E, axis=1, keepdims=True) + 1e-8)
np.savez_compressed(f'{ROOT}/clap_emb.npz', emb=E, emb_l2=En, ids=df.rec_id.values)
print('clap', E.shape, flush=True)
