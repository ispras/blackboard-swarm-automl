import pandas as pd, numpy as np
base='/download_job_code/payload/sandbox/data'; ed=f'{base}/essential_data'
cv=pd.read_csv(f'{ed}/CVfolds_2.txt'); r2f=pd.read_csv(f'{ed}/rec_id2filename.txt')
labs={}
for line in open(f'{ed}/rec_labels_test_hidden.txt').read().splitlines()[1:]:
    p=line.split(','); labs[int(p[0])]=[] if p[1:]==['?'] else [int(x) for x in p[1:]]
r2f['site']=r2f.filename.str.split('_').str[0]; r2f['date']=r2f.filename.str.split('_').str[1]; r2f['time']=r2f.filename.str.split('_').str[2]
r2f['sess']=r2f.site+'_'+r2f.date; r2f['nlab']=[len(labs[r]) for r in r2f.rec_id]
df=cv.merge(r2f,on='rec_id')
trs=set(df[df.fold==0].sess); tes=set(df[df.fold==1].sess)
print('n train sess',len(trs),'n test sess',len(tes),'overlap',len(trs&tes))
print('test recs in overlapping sessions', df[(df.fold==1)&df.sess.isin(trs)].shape[0],'/',(df.fold==1).sum())
print('test recs in test-only sessions', df[(df.fold==1)&~df.sess.isin(trs)].shape[0])
# time proximity: for each test rec, nearest train rec same sess, time diff
def tsec(t): return int(t[:2])*3600+int(t[2:4])*60+int(t[4:])
df['sec']=df.time.map(tsec)
rows=[]
for _,r in df[df.fold==1].iterrows():
    same=df[(df.fold==0)&(df.sess==r.sess)]
    if len(same):
        rows.append((r.rec_id, abs(same.sec-r.sec).min()))
print('test recs w/ same-session train', len(rows))
# overlap on site+date OR site match only
print('site overlap: test recs whose site has train', df[(df.fold==1)&df.site.isin(set(df[df.fold==0].site))].shape[0])
# sessions shared between folds by site only
print('per-rec label count of test unknown')
# Look at fold structure vs rec_id order
print(df.sort_values('rec_id')[['rec_id','fold','sess','nlab']].head(40).to_string())
EOF
