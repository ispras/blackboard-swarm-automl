import numpy as np, pandas as pd, os, json, warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.metrics import roc_auc_score

ROOT = '/download_job_code/payload/sandbox/workspaces/pollux_epsilon'
ED = '/download_job_code/payload/sandbox/data/essential_data'
NCLASS = 19
d = np.load(f'{ROOT}/feats.npz'); ids, hist, mil, Y, split, tm = d['ids'], d['hist'], d['mil'], d['Y'], d['split'], d['train_mask']
a = np.load(f'{ROOT}/ast_emb.npz'); L = np.load(f'{ROOT}/ast_logits.npz')['probs']
tr = np.where(tm)[0]; te = np.where(split == 1)[0]
folds = np.load('/download_job_code/payload/sandbox/workspaces/altair_gamma/folds_5x_seed42.npy')
Ytr = Y[tr]
AST = np.hstack([a['mean'], a['max'], a['std'], np.log1p(L)])

meta = pd.read_csv(f'{ED}/rec_id2filename.txt').sort_values('rec_id').reset_index(drop=True)
meta['site'] = meta.filename.str.split('_').str[0]
meta['date'] = meta.filename.str.split('_').str[1]
meta['time'] = meta.filename.str.split('_').str[2]
meta['sess'] = meta.site + '_' + meta.date
meta['sec'] = meta.time.map(lambda t: int(t[:2])*3600 + int(t[2:4])*60 + int(t[4:]))
meta['doy'] = pd.to_datetime(meta.date, format='%Y%m%d').dt.dayofyear
meta['year'] = meta.date.str[:4].astype(int)
sites = sorted(meta.site.unique()); s2i = {s: i for i, s in enumerate(sites)}
sec, site, sess, date = meta.sec.values, meta.site.values, meta.sess.values, meta.date.values
doy, year = meta.doy.values, meta.year.values
sessc = pd.Series(sess).map(pd.Series(sess).value_counts()).values

def meta_feats(idx):
    F = np.zeros((len(idx), len(sites)+7), np.float32)
    F[np.arange(len(idx)), [s2i[s] for s in site[idx]]] = 1
    F[:, len(sites)+0] = year[idx]-2009
    F[:, len(sites)+1] = np.sin(2*np.pi*doy[idx]/365); F[:, len(sites)+2] = np.cos(2*np.pi*doy[idx]/365)
    F[:, len(sites)+3] = np.sin(2*np.pi*sec[idx]/86400); F[:, len(sites)+4] = np.cos(2*np.pi*sec[idx]/86400)
    F[:, len(sites)+5] = sec[idx]/86400
    F[:, len(sites)+6] = sessc[idx]
    return F

BASE = np.hstack([AST, hist, mil, meta_feats(np.arange(len(ids)))]).astype(np.float32)
ASTn = a['mean'] / (np.linalg.norm(a['mean'], axis=1, keepdims=True)+1e-8)

def _blocks(q, r):
    qs = site[q][:, None] == site[r][None, :]
    return [sess[q][:, None] == sess[r][None, :], qs, date[q][:, None] == date[r][None, :],
            qs & (np.abs(sec[q][:, None]-sec[r][None, :]) <= 3600)]

def neigh_feats(q, r, k=10, self_ref=False):
    R = Y[r]; nq = len(q); nb = 4
    F = np.zeros((nq, nb*(NCLASS+1) + 2*NCLASS + 2), np.float32)
    B = _blocks(q, r)
    for b, M in enumerate(B):
        M = M.astype(np.float32)
        if self_ref: np.fill_diagonal(M, 0)
        cnt = M.sum(1)
        F[:, b*(NCLASS+1):b*(NCLASS+1)+NCLASS] = (M @ R)/np.maximum(cnt, 1)[:, None]
        F[:, b*(NCLASS+1)+NCLASS] = cnt
    S = ASTn[q] @ ASTn[r].T
    if self_ref: np.fill_diagonal(S, -1)
    kk = min(k, S.shape[1]-1)
    top = np.argsort(-S, axis=1)[:, :kk]
    lab = np.stack([R[t] for t in top]).astype(np.float32)
    F[:, nb*(NCLASS+1):nb*(NCLASS+1)+NCLASS] = lab.mean(1)
    o = nb*(NCLASS+1)
    F[:, o+NCLASS] = S.max(1)
    w = np.exp(5*(np.sort(S, axis=1)[:, -kk:]-1))
    F[:, o+NCLASS+1:o+2*NCLASS+1] = (lab*w[:, :, None]).sum(1)/np.maximum(w.sum(1)[:, None], 1e-9)
    F[:, o+2*NCLASS+1] = kk
    return F

def pair(tri, vai):
    Xtr = np.hstack([BASE[tri], neigh_feats(tri, tri, self_ref=True)])
    Xva = np.hstack([BASE[vai], neigh_feats(vai, tri)])
    return Xtr, Xva

def pair_noneigh(tri, vai):
    return BASE[tri], BASE[vai]

def oof_lr(C, use_neigh=True, cw=None):
    P = np.zeros_like(Ytr)
    for f in range(5):
        va = np.where(folds == f)[0]; trn = np.where(folds != f)[0]
        tri, vai = tr[trn], tr[va]
        Xtr, Xva = pair(tri, vai) if use_neigh else pair_noneigh(tri, vai)
        sc = StandardScaler().fit(Xtr); A, B = sc.transform(Xtr), sc.transform(Xva)
        for j in range(19):
            y = Ytri = Y[tri, j]
            if y.sum() == 0: continue
            P[va, j] = LogisticRegression(C=C, max_iter=4000, class_weight=cw).fit(A, y).predict_proba(B)[:, 1]
    return P

def test_lr(C, use_neigh=True, cw=None):
    Xtr, Xte = pair(tr, te) if use_neigh else pair_noneigh(tr, te)
    sc = StandardScaler().fit(Xtr); A, B = sc.transform(Xtr), sc.transform(Xte)
    P = np.zeros((len(te), 19))
    for j in range(19):
        P[:, j] = LogisticRegression(C=C, max_iter=4000, class_weight=cw).fit(A, Ytr[:, j]).predict_proba(B)[:, 1]
    return P

res = {}
best = (0, None)
for cw in [None, 'balanced']:
    for C in [0.003, 0.01, 0.03, 0.1, 0.3, 1.0]:
        P = oof_lr(C, True, cw); auc = roc_auc_score(Ytr.ravel(), P.ravel())
        print(f'neigh LR C={C} cw={cw} gAUC={auc:.4f}', flush=True); res[f'{C}_{cw}'] = auc
        if auc > best[0]: best = (auc, (C, cw))
for C in [0.01, 0.03, 0.1]:
    P = oof_lr(C, False)
    print(f'noneigh LR C={C} gAUC={roc_auc_score(Ytr.ravel(), P.ravel()):.4f}', flush=True)
print('BEST', best, flush=True)
json.dump(res, open(f'{ROOT}/combine_cv.json', 'w'), indent=1)
C, cw = best[1]
P = oof_lr(C, True, cw); np.save(f'{ROOT}/preds/oof_lr_astneigh.npy', P)
T = test_lr(C, True, cw); np.save(f'{ROOT}/preds/test_lr_astneigh.npy', T)
print('saved astneigh', best, T.shape, flush=True)
