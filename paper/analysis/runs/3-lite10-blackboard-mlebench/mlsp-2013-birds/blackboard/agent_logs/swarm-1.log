print('train nlab stats'); print(df[df.fold==0].nlab.describe())
print('nlab==0', (df[df.fold==0].nlab==0).sum())
# per class counts train
tr=df[df.fold==0]
cnt=np.zeros(19)
for r in tr.rec_id:
    for c in labs[r]: cnt[c]+=1
print('per-class train counts:', dict(enumerate(cnt.astype(int))))
print('classes with 0 train pos', [i for i in range(19) if cnt[i]==0])
# date/time
print('dates', sorted(df.date.unique()))
print('times', sorted(df.time.unique())[:10])
# describe nlab per session vs fold
print(df.groupby('sess').agg(n=('rec_id','size'), ntest=('fold','sum'), meanlab=('nlab','mean')).head(20))
