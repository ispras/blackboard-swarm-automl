# fold-stability of top 20: per-fold AUC
print('fold AUCs of top5:')
for a,c in res[:5]:
    pr=np.mean([L[k] for k in c],0)
    fa=[round(g_fold,3) for g_fold in [roc_auc_score(Ytr[folds==k].ravel(),pr[folds==k].ravel()) for k in range(5)]]
    print(' ',round(a,5),c,'folds',fa,'mean',round(np.mean(fa),4))
