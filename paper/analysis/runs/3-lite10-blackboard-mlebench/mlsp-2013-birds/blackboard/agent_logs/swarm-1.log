import numpy as np, sys, time, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'.')
import combined as C, model_meta as M
from common import *
from sklearn.metrics import roc_auc_score
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
import lightgbm as lgb
from sklearn.ensemble import ExtraTreesClassifier
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
R='/download_job_code/payload/sandbox/workspaces/pollux_epsilon'
bn=np.load(f'{R}/birdnet.npz'); lo=bn['logits19']; full=bn['full_max']
pr=1/(1+np.exp(-lo))
BN=np.concatenate([pr.mean(1),pr.max(1),pr.min(1),pr.std(1),np.sort(pr,1)[:,-1],np.sort(pr,1)[:,-2]],1).astype(np.float32)
fullp=1/(1+np.exp(-full))
PCAf=PCA(n_components=128,random_state=0).fit_transform(StandardScaler().fit_transform(fullp))
print('BN',BN.shape,'PCA',PCAf.shape)
LOGI=C.LOG[:,np.argsort(-C.LOG.std(0))[:150]]
EMB=C.EMBp[:,:64]
BNv={'stats':BN,'pca':PCAf,'both':np.hstack([BN,PCAf])}
def lgbm(seed,c): return lgb.LGBMClassifier(n_estimators=300,learning_rate=0.05,num_leaves=15,min_child_samples=5,subsample=0.8,subsample_freq=1,colsample_bytree=0.4,reg_lambda=2.0,class_weight='balanced',random_state=seed*1000+c,n_jobs=4,verbose=-1)
def et(seed,c): return ExtraTreesClassifier(n_estimators=400,max_depth=8,min_samples_leaf=2,class_weight='balanced',random_state=seed*1000+c,n_jobs=4)
def cv(bnkey='both',model='lgb',use_bn=True,seeds=(0,)):
    parts=[C.B,EMB,LOGI]
    if use_bn: parts.append(BNv[bnkey])
    Xall=np.hstack(parts).astype(np.float32); P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; tri=tr[f!=k]; vai=tr[va]
            ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=(lgbm if model=='lgb' else et)(seed,c); m.fit(Xtr,Y[tri,c]); P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds); return roc_auc_score(Y[tr].ravel(),P.ravel()),P
if __name__=='__main__':
    for name,kw in [('lgb_bn_stats',dict(bnkey='stats')),('lgb_bn_pca',dict(bnkey='pca')),('lgb_bn_both',dict(bnkey='both')),('lgb_nobn',dict(use_bn=False)),('et_bn_both',dict(bnkey='both',model='et'))]:
        t=time.time(); a,_=cv(**kw); print(name,round(a,5),round(time.time()-t,1),flush=True)
