def avg_logits(keys):
    O = np.mean([logit(models[k][0]) for k in keys], 0)
    T = np.mean([logit(models[k][1]) for k in keys], 0)
    return O, T

def report(name, O):
    print(f'{name:55s} gAUC={roc_auc_score(Ytr.ravel(), O.ravel()):.4f}', flush=True)

core3 = ['pol:lr_astneigh', 'alt:et_emb64log', 'alt:lgb_emb64log']
core4 = core3 + ['alt:et_meta']
core5 = core4 + ['pol:lr_clap']
core6 = core5 + ['pol:et_astfull']
core7 = core6 + ['pol:lr_astfull']
for nm, ks in [('core3', core3), ('core4', core4), ('core5', core5), ('core6', core6), ('core7', core7)]:
    O, T = avg_logits(ks); report(nm + ' ' + ','.join(ks), O)

# per-class Platt calibration, fold-safe
def calibrated(keys):
    Oc = np.zeros_like(Ytr, float); Tc = np.zeros((64, 19), float)
    for k in keys:
        o = logit(models[k][0]); t = logit(models[k][1])
        oc = np.zeros_like(o); tc = np.zeros_like(t)
        for j in range(19):
            for f in range(5):
                trn = np.where(folds != f)[0]; va = np.where(folds == f)[0]
                y = Ytr[trn, j]
                if y.sum() >= 2 and (1-y).sum() >= 2:
                    m = LogisticRegression(C=1.0, max_iter=1000).fit(o[trn, j][:, None], y)
                    oc[va, j] = m.decision_function(o[va, j][:, None])
                else:
                    oc[va, j] = o[va, j]
            y = Ytr[:, j]
            if y.sum() >= 2:
                m = LogisticRegression(C=1.0, max_iter=1000).fit(o[:, j][:, None], y)
                tc[:, j] = m.decision_function(t[:, j][:, None])
            else:
                tc[:, j] = t[:, j]
        Oc += oc / len(keys); Tc += tc / len(keys)
    return Oc, Tc

for nm, ks in [('cal core3', core3), ('cal core5', core5), ('cal all', list(models))]:
    Oc, Tc = calibrated(ks); report(nm, Oc)

# global stacking LR on logits + species onehot (fold-safe by rec fold)
allk = list(models)
Lo = np.stack([logit(models[k][0]) for k in allk])  # K,258,19
Lt = np.stack([logit(models[k][1]) for k in allk])
def stack_feats(L, ids):
    K, n, C = L.shape
    F = np.concatenate([L.transpose(1, 2, 0), np.tile(np.eye(C)[None], (n, 1, 1))], axis=2)
    return F.reshape(-1, K + C), ids
