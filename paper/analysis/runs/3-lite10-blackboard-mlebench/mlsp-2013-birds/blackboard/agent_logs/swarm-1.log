import numpy as np, pandas as pd, sys, time, json, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
import combined as C
from common import *
import model_meta as M
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.metrics import roc_auc_score
import lightgbm as lgb

R='/download_job_code/payload/sandbox/workspaces'
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y

def feature_matrix(use_raw=False,use_emb=False,use_log=False,emb_k=128,log_k=150,raw_k=0):
    parts=[C.B]
    if use_raw:
        if raw_k>0:
            v=C.RAW.std(0); idx=np.argsort(-v)[:raw_k]; parts.append(C.RAW[:,idx])
        else: parts.append(C.RAW)
    if use_emb: parts.append(C.EMBp[:,:emb_k])
    if use_log:
        v=C.LOG.std(0); idx=np.argsort(-v)[:log_k]; parts.append(C.LOG[:,idx])
    return np.hstack(parts).astype(np.float32)

def get_model(kind,seed,c):
    if kind=='et':
        return ExtraTreesClassifier(n_estimators=500,max_depth=8,min_samples_leaf=2,class_weight='balanced',random_state=seed*1000+c,n_jobs=4)
    if kind=='lgb':
        return lgb.LGBMClassifier(n_estimators=250,learning_rate=0.05,num_leaves=15,min_child_samples=5,subsample=0.8,subsample_freq=1,colsample_bytree=0.4,reg_lambda=2.0,class_weight='balanced',random_state=seed*1000+c,n_jobs=4,verbose=-1)
    if kind=='rf':
        from sklearn.ensemble import RandomForestClassifier
        return RandomForestClassifier(n_estimators=500,max_depth=8,min_samples_leaf=2,class_weight='balanced_subsample',random_state=seed*1000+c,n_jobs=4)

def run(kind,cfg,seeds=(0,1,2),save=None):
    Xall=feature_matrix(**cfg)
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; trn=np.where(f!=k)[0]; tri=tr[trn]; vai=tr[va]
            ntr=M.neighbor_loo(tri); nva=M.neighbor_between(vai,tri)
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
            mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
            for c in range(NCLASS):
                m=get_model(kind,seed,c); m.fit(Xtr,Y[tri,c])
                P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds)
    auc=roc_auc_score(Y[tr].ravel(),P.ravel())
    if save:
        np.save(f'preds/oof_{save}.npy',P)
        # full model -> test
        Xtr=np.hstack([Xall[tr],M.neighbor_loo(tr)]); Xte=np.hstack([Xall[te],M.neighbor_between(te,tr)])
        mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xte=(Xte-mu)/sd
        Pte=np.zeros((len(te),NCLASS))
        for s in seeds:
            for c in range(NCLASS):
                m=get_model(kind,s,c); m.fit(Xtr,Y[tr,c]); Pte[:,c]+=m.predict_proba(Xte)[:,1]
        Pte/=len(seeds); np.save(f'preds/test_{save}.npy',Pte)
        json.dump({'kind':kind,'cfg':cfg,'seeds':list(seeds),'auc':auc},open(f'preds/{save}.json','w'))
    return auc,P

if __name__=='__main__':
    mode=sys.argv[1]
    if mode=='screen_lgb':
        for name,cfg in [('lgb_baselog',dict(use_log=True,log_k=150)),
                         ('lgb_log250',dict(use_log=True,log_k=250)),
                         ('lgb_emb64log',dict(use_emb=True,use_log=True,emb_k=64)),
                         ('lgb_emb64log_raw200',dict(use_emb=True,use_log=True,emb_k=64,use_raw=True,raw_k=200))]:
            t=time.time(); a,P=run('lgb',cfg,seeds=(0,)); print(name,round(a,5),'t',round(time.time()-t,1),flush=True)
    elif mode=='screen_et':
        for name,cfg in [('et_emb64log',dict(use_emb=True,use_log=True,emb_k=64)),
                         ('et_raw200log',dict(use_raw=True,raw_k=200,use_log=True)),
                         ('et_emb64log_raw200',dict(use_emb=True,use_log=True,emb_k=64,use_raw=True,raw_k=200))]:
            t=time.time(); a,P=run('et',cfg,seeds=(0,)); print(name,round(a,5),'t',round(time.time()-t,1),flush=True)
    elif mode=='final':
        name=sys.argv[2]; kind=sys.argv[3]
        cfg=json.loads(sys.argv[4]); seeds=tuple(int(x) for x in sys.argv[5].split(',')) if len(sys.argv)>5 else (0,1,2)
        t=time.time(); a,P=run(kind,cfg,seeds=seeds,save=name); print(name,'AUC',round(a,5),'t',round(time.time()-t,1))
