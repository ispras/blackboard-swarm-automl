def logit(p): p=np.clip(p,1e-5,1-1e-5); return np.log(p/(1-p))
def LD(a,n,isl=False):
    p=np.load(f'{W}/{a}/preds/oof_{n}.npy'); return p if isl else logit(p)
L={'rawbnd':LD('pollux_epsilon','rawbirdnet_denoised'),'bnemb':LD('pollux_epsilon','lr_bnemb_only'),'ma_bndn':LD('pollux_epsilon','lr_multiast_bndn'),
'ma_bnemb':LD('pollux_epsilon','lr_multiast_bnemb'),'bn_union':LD('pollux_epsilon','lr_bn_union_only'),'bn_stats':LD('pollux_epsilon','lr_multiast_bn_stats'),
'b_rich':LD('pollux_beta','mlp_rich_mixup'),'b_mlpbn':LD('pollux_beta','mlp_bn_mixup'),'b_lgbbn':LD('pollux_beta','lgb_bn'),
'a_lgbbn':LD('altair_gamma','lgb_bn_stats'),'a_etbn':LD('altair_gamma','et_bn_stats'),'etlog':LD('altair_gamma','et_emb64log'),'lgblog':LD('altair_gamma','lgb_emb64log'),'rawbn':LD('pollux_epsilon','rawbirdnet_avg',True),'rawbnp':LD('pollux_epsilon','rawbirdnet')}
def met(ks):
    z=np.mean([L[k] for k in ks],0); pr=1/(1+np.exp(-z)); fa=[roc_auc_score(Ytr[folds==f].ravel(),pr[folds==f].ravel()) for f in range(5)]
    return roc_auc_score(Ytr.ravel(),pr.ravel()),fa
A=['rawbnd','bnemb','b_rich','a_lgbbn']
cands={'A':A}
for m in ['ma_bndn','ma_bnemb','bn_union','bn_stats','b_mlpbn','b_lgbbn','a_etbn','etlog','lgblog','rawbnp','rawbn']:
    cands['A+'+m]=A+[m]
cands['swap_bnemb->ma_bndn']=['rawbnd','ma_bndn','b_rich','a_lgbbn']
cands['swap_rich->mlpbn']=['rawbnd','bnemb','b_mlpbn','a_lgbbn']
cands['swap_lgbbn->blgbbn']=['rawbnd','bnemb','b_rich','b_lgbbn']
cands['A+ma_bndn+mlpbn']=A+['ma_bndn','b_mlpbn']
cands['ma_bndn+rich+algbbn+rawbnd+mlpbn']=['rawbnd','ma_bndn','b_rich','a_lgbbn','b_mlpbn']
cands['bnemb+ma_bndn']= ['rawbnd','bnemb','ma_bndn','b_rich','a_lgbbn']
cands['A+rawbn+A']=A+['rawbn']
for n,ks in cands.items():
    p,fa=met(ks); print(f'{n:34s}',round(p,5),[round(x,3) for x in fa],'min',round(min(fa),3))
# forward greedy from A pooled
cur=list(A); best=met(cur)[0]
while True:
    cand=None
    for m in [k for k in L if k not in cur]:
        p=met(cur+[m])[0]
        if p>best+1e-5: best=p; cand=m
    if cand is None: break
    cur.append(cand); print('greedy add',cand,'->',round(best,5),met(cur)[1])
print('GREEDY',cur,round(best,5))
