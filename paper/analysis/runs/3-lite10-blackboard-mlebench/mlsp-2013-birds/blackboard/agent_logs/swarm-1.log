import numpy as np, sys, time, warnings
warnings.filterwarnings('ignore')
sys.path.insert(0,'.')
import combined as C, final_model as F
from common import *
from neigh2 import NeighExt
from sklearn.metrics import roc_auc_score
import lightgbm as lgb
tr,te,folds,Y=C.tr,C.te,C.folds,C.Y
NE=NeighExt()
Xall=F.feature_matrix(use_emb=True,use_log=True,emb_k=64,log_k=150)
def lgbm(seed,c): return lgb.LGBMClassifier(n_estimators=250,learning_rate=0.05,num_leaves=15,min_child_samples=5,subsample=0.8,subsample_freq=1,colsample_bytree=0.4,reg_lambda=2.0,class_weight='balanced',random_state=seed*1000+c,n_jobs=4,verbose=-1)
def cv(ext=True, acoustic_k=10, use_blocks=None):
    P=np.zeros((len(tr),NCLASS))
    for k in range(5):
        va=np.where(folds==k)[0]; tri=tr[folds!=k]; vai=tr[va]
        if ext:
            ntr=NE.loo(tri,acoustic_k); nva=NE.between(vai,tri,acoustic_k)
            if use_blocks is not None:
                keep=[]
                for b in use_blocks: keep+=list(range(b*20,b*20+20))
                ntr=ntr[:,keep]; nva=nva[:,keep]
            Xtr=np.hstack([Xall[tri],ntr]); Xva=np.hstack([Xall[vai],nva])
        else:
            Xtr=Xall[tri]; Xva=Xall[vai]
        mu=Xtr.mean(0); sd=Xtr.std(0)+1e-6; Xtr=(Xtr-mu)/sd; Xva=(Xva-mu)/sd
        for c in range(NCLASS):
            m=lgbm(0,c); m.fit(Xtr,Y[tri,c]); P[va,c]=m.predict_proba(Xva)[:,1]
    return roc_auc_score(Y[tr].ravel(),P.ravel()),P
if __name__=='__main__':
    for name,kw in [('old4approx?ext_all',dict(ext=True)),
                    ('ext_blocks_0to3',dict(ext=True,use_blocks=[0,1,2,3])),
                    ('ext_0to7',dict(ext=True,use_blocks=list(range(8)))),
                    ('ext_decay_only',dict(ext=True,use_blocks=[0,1,9])),
                    ('ext_sitewin',dict(ext=True,use_blocks=[0,1,3,4,5,7,8,9])),
                    ('no_neigh',dict(ext=False))]:
        t=time.time(); a,_=cv(**kw); print(name,round(a,5),round(time.time()-t,1),flush=True)
