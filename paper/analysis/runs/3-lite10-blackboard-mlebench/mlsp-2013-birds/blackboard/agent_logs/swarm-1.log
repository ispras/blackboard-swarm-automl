import numpy as np, pandas as pd, json, sys, warnings
warnings.filterwarnings('ignore')
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import ExtraTreesClassifier, RandomForestClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score
sys.path.insert(0,'/download_job_code/payload/sandbox/workspaces/altair_gamma')
from common import *
from sklearn.model_selection import StratifiedKFold

Y,labs=load_labels(); meta=load_meta(); H=load_hist(); S,nseg=load_segagg()
cv=pd.read_csv(f'{ED}/CVfolds_2.txt')
tr=np.array(sorted(cv[cv.fold==0].rec_id.tolist())); te=np.array(sorted(cv[cv.fold==1].rec_id.tolist()))
folds=np.load('/download_job_code/payload/sandbox/workspaces/altair_gamma/folds_5x_seed42.npy')
sites=sorted(meta.site.unique()); s2i={s:i for i,s in enumerate(sites)}

def meta_feats(idx):
    m=meta.iloc[idx]
    F=np.zeros((len(idx),len(sites)+7),dtype=np.float32)
    for k,(_,r) in enumerate(m.iterrows()):
        F[k,s2i[r.site]]=1
        F[k,len(sites)+0]=r.year-2009
        F[k,len(sites)+1]=np.sin(2*np.pi*r.doy/365); F[k,len(sites)+2]=np.cos(2*np.pi*r.doy/365)
        F[k,len(sites)+3]=np.sin(2*np.pi*r.sec/86400); F[k,len(sites)+4]=np.cos(2*np.pi*r.sec/86400)
        F[k,len(sites)+5]=r.sec/86400
        F[k,len(sites)+6]=len(m[m.sess==r.sess].index)
    return F

def base_feats(idx):
    return np.hstack([H[idx],S[idx],nseg[idx][:,None],meta_feats(idx)]).astype(np.float32)

def neighbor_feats(ref_idx, qry_idx, add_global=True, ac=False):
    """LOO-safe: caller must ensure ref excludes qry if qry in ref set."""
    nq=len(qry_idx); nb=4 + (1 if ac else 0)
    F=np.zeros((nq,nb*(NCLASS+1)),dtype=np.float32)
    ref_meta=meta.iloc[ref_idx]; refY=Y[ref_idx]
    ref_sec=ref_meta.sec.values; ref_site=ref_meta.site.values; ref_sess=ref_meta.sess.values; ref_date=ref_meta.date.values
    if ac:
        R=H[ref_idx]/ (np.linalg.norm(H[ref_idx],axis=1,keepdims=True)+1e-8)
    for k,qi in enumerate(qry_idx):
        q=meta.iloc[qi]
        masks=[]
        masks.append(ref_sess==q.sess)                    # same session
        masks.append(ref_site==q.site)                    # same site
        masks.append(ref_date==q.date)                    # same date
        tdiff=np.abs(ref_sec-q.sec); masks.append((ref_site==q.site)&(tdiff<=3600))  # same site within 1h
        if ac:
            qv=H[qi]/(np.linalg.norm(H[qi])+1e-8); sim=R@qv
            masks.append(sim>=0.5)
        for b,m in enumerate(masks):
            cnt=int(m.sum())
            if cnt:
                F[k,b*(NCLASS+1):b*(NCLASS+1)+NCLASS]=refY[m].mean(0)
            F[k,b*(NCLASS+1)+NCLASS]=cnt
    return F

def build_pair(train_idx, val_idx):
    btr=base_feats(train_idx); bva=base_feats(val_idx)
    # train-side LOO neighbors (ref = train excluding self)
    ntr=np.zeros((len(train_idx),4*(NCLASS+1)),dtype=np.float32)
    for j,ri in enumerate(train_idx):
        mask=np.ones(len(train_idx),dtype=bool); mask[j]=False
        ntr[j]=neighbor_feats(train_idx[mask],np.array([ri]))[0]
    nva=neighbor_feats(train_idx,val_idx)
    Xtr=np.hstack([btr,ntr]); Xva=np.hstack([bva,nva])
    return Xtr,Xva

def eval_cv(model_fn, use_neighbor=True, seeds=(0,1,2)):
    P=np.zeros((len(tr),NCLASS))
    for rep,seed in enumerate(seeds):
        f=folds if rep==0 else make_folds(Y,tr,5,seed)[0]
        for k in range(5):
            va=np.where(f==k)[0]; trn=np.where(f!=k)[0]
            tri=tr[trn]; vai=tr[va]
            Xtr,Xva=build_pair(tri,vai)
            for c in range(NCLASS):
                m=model_fn(seed*100+k*7+c)
                m.fit(Xtr,Y[tri,c]); P[va,c]+=m.predict_proba(Xva)[:,1]
    P/=len(seeds)
    return roc_auc_score(Y[tr].ravel(),P.ravel()),P

def lr_fn(seed):
    return LogisticRegression(C=0.1,max_iter=2000,class_weight='balanced',solver='liblinear')
def lr_strong(seed):
    return LogisticRegression(C=0.03,max_iter=2000,class_weight='balanced',solver='liblinear')
def et_fn(seed):
    return ExtraTreesClassifier(n_estimators=400,max_depth=6,min_samples_leaf=2,class_weight='balanced',random_state=seed,n_jobs=4)

if __name__=='__main__':
    which=sys.argv[1] if len(sys.argv)>1 else 'all'
    res={}
    if which in ('all','lr'):
        a,P=eval_cv(lr_fn); res['lr_neigh']=a; print('LR base+neigh pooled AUC',round(a,4)); np.save('preds/oof_lr_meta.npy',P)
    if which in ('all','et'):
        a,P=eval_cv(et_fn); res['et_neigh']=a; print('ET base+neigh pooled AUC',round(a,4)); np.save('preds/oof_et_meta.npy',P)
    if which in ('all',):
        # neighbor only
        a,P=eval_cv(lr_strong)
    print(json.dumps(res))
