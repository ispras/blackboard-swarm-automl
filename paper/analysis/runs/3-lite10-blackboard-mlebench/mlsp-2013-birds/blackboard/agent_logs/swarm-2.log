POOL={n:load(n) for n in names if load(n) is not None}
print('pool',list(POOL))
# nested per-species selection: for each fold, for each species choose model with best AUC on other folds; use its prob on held fold
P=np.zeros_like(Y,dtype=float); picks=[]
for f in range(5):
    va=np.where(folds==f)[0]; rr=np.where(folds!=f)[0]
    for s in range(19):
        y=Y[rr,s]
        aucs={}
        for n,p in POOL.items():
            if y.sum()>0 and y.sum()<len(y): aucs[n]=roc_auc_score(y,p[rr,s])
        if not aucs: continue
        best=max(aucs,key=aucs.get)
        P[va,s]=POOL[best][va,s]
    picks.append({s:max(((n,roc_auc_score(Y[rr,s],POOL[n][rr,s])) for n in POOL if Y[rr,s].sum()>0 and Y[rr,s].sum()<len(rr)),key=lambda t:t[1])[0] for s in range(19)})
print('per-species nested pooled',round(roc_auc_score(Y.ravel(),P.ravel()),4))
per=[roc_auc_score(Y[folds==f].ravel(),P[folds==f].ravel()) for f in range(5)]
print('per fold',np.round(per,3),'min',round(min(per),3))
# compare v10 blend
v10=np.mean([E(load(n)) for n in ['lgb_bnall','mil_attn2','dn3_max','mlp_rich_mixup']],axis=0)
print('v10 pooled',round(roc_auc_score(Y.ravel(),v10.ravel()),4))
