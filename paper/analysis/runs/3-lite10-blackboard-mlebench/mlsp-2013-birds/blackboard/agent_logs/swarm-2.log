L=np.stack([Lall[n] for n in keep],-1)  # 258,19,m
T=np.stack([E(models[n][1]) for n in keep],-1)
def design(A):
    n,c,m=A.shape; X=A.reshape(n*c,m); sp=np.tile(np.eye(c),(n,1)); return np.hstack([X,sp])
Xa=design(L); Xt=design(T); y=Y.ravel()
