import sys,numpy as np,warnings,os; warnings.filterwarnings('ignore')
sys.path.insert(0,'workspaces/altair_gamma'); import model_meta as M
from sklearn.metrics import roc_auc_score
Y=M.Y[M.tr]; folds=M.folds; S=Y.ravel(); idx=np.arange(258*19).reshape(-1,19)
E=lambda p: np.log(np.clip(p,1e-6,1-1e-6)/(1-np.clip(p,1e-6,1-1e-6)))
def load(n):
    for ws in ['pollux_epsilon','altair_gamma','pollux_beta']:
        f=f'workspaces/{ws}/preds/oof_{n}.npy'
        if os.path.exists(f): return np.load(f)
base=np.mean([E(load(n)) for n in ['lgb_bnall','mil_attn2','dn3_max','mlp_rich_mixup']],axis=0)
v10=1/(1+np.exp(-base)); a10=roc_auc_score(S,v10.ravel())
per10=[roc_auc_score(Y[folds==f].ravel(),v10[folds==f].ravel()) for f in range(5)]
print('v10',round(a10,5),'min',round(min(per10),4))
rng=np.random.default_rng(3)
extras=['spcond_bnemb','rawbn_calibrated','rawbirdnet_denoised25','lr_bndn_union','lr_multiast_bn_union','mil_attn3','lgb_union','mlp_bn_mixup','lgb_bn_stats','lr_bnemb_only']
for n in extras:
    try: z=load(n)
    except Exception: continue
    for w in [0.2,0.3,0.4]:
        zz=(base+w*E(z))/(1+w); pr=1/(1+np.exp(-zz))
        pooled=roc_auc_score(S,pr.ravel()); per=[roc_auc_score(Y[folds==f].ravel(),pr[folds==f].ravel()) for f in range(5)]
        if pooled>a10 and min(per)>min(per10):
            # bootstrap P(>v10)
            d=[]
            for _ in range(400):
                b=rng.choice(258,258,replace=True); rows=idx[b].ravel()
                d.append(roc_auc_score(S[rows],pr.ravel()[rows])-roc_auc_score(S[rows],v10.ravel()[rows]))
            print(f'{n:24s} w={w} pooled={pooled:.5f} min={min(per):.4f} P={np.mean(np.array(d)>0):.2f} diff={np.mean(d):+.5f}')
EOF
