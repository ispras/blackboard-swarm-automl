import os, numpy as np, pandas as pd, torch, librosa, time
os.environ.setdefault('HF_HOME', '/download_job_code/payload/sandbox/workspaces/pollux_epsilon/hf_cache')
from transformers import ASTFeatureExtractor, ASTModel
ROOT = '/download_job_code/payload/sandbox'
OUT = f'{ROOT}/workspaces/pollux_epsilon'
ED = f'{ROOT}/data/essential_data'
dev = 'cuda' if torch.cuda.is_available() else 'cpu'

df = pd.read_csv(f'{ED}/rec_id2filename.txt').sort_values('rec_id').reset_index(drop=True)
wavs = []
for fn in df.filename:
    y, _ = librosa.load(f'{ED}/src_wavs/{fn}.wav', sr=16000, mono=True)
    if len(y) < 160000: y = np.pad(y, (0, 160000 - len(y)))
    wavs.append(y[:160000].astype(np.float32))
wavs = np.stack(wavs)
np.save(f'{OUT}/wavs_16k.npy', wavs)
print('wavs', wavs.shape, flush=True)

fe = ASTFeatureExtractor.from_pretrained('MIT/ast-finetuned-audioset-10-10-0.4593')
model = ASTModel.from_pretrained('MIT/ast-finetuned-audioset-10-10-0.4593').to(dev).eval()

def run(seg_list):
    inp = fe(seg_list, sampling_rate=16000, return_tensors='pt')['input_values'].to(dev)
    with torch.no_grad(), torch.autocast('cuda', dtype=torch.float16):
        out = model(inp).last_hidden_state  # B, 1024, 768
    return out.float().cpu()

emb_mean, emb_max, emb_std = [], [], []
t0 = time.time()
with torch.no_grad():
    for i in range(0, len(wavs), 8):
        batch = wavs[i:i+8]
        h = run([b for b in batch])
        emb_mean.append(h.mean(1).numpy()); emb_max.append(h.max(1).values.numpy()); emb_std.append(h.std(1).numpy())
        if i % 80 == 0: print(i, f'{time.time()-t0:.1f}s', flush=True)
emb_mean = np.concatenate(emb_mean); emb_max = np.concatenate(emb_max); emb_std = np.concatenate(emb_std)
np.savez_compressed(f'{OUT}/ast_emb.npz', mean=emb_mean, max=emb_max, std=emb_std, ids=df.rec_id.values)
print('emb', emb_mean.shape, flush=True)

# AudioSet class logits (527) from the same weights' classifier head
from transformers import ASTForAudioClassification
clf = ASTForAudioClassification.from_pretrained('MIT/ast-finetuned-audioset-10-10-0.4593').to(dev).eval()
probs = []
with torch.no_grad():
    for i in range(0, len(wavs), 8):
        inp = fe([b for b in wavs[i:i+8]], sampling_rate=16000, return_tensors='pt')['input_values'].to(dev)
        with torch.autocast('cuda', dtype=torch.float16):
            logits = clf(inp).logits
        probs.append(torch.sigmoid(logits.float()).cpu().numpy())
probs = np.concatenate(probs)
np.savez_compressed(f'{OUT}/ast_logits.npz', probs=probs, ids=df.rec_id.values)
print('logits', probs.shape, flush=True)
