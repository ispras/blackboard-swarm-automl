import os, sys, numpy as np, torch, time
os.environ.setdefault('HF_HOME', '/download_job_code/payload/sandbox/workspaces/pollux_epsilon/hf_cache')
from transformers import ASTFeatureExtractor, ASTModel, ASTForAudioClassification
ROOT = '/download_job_code/payload/sandbox/workspaces/pollux_epsilon'
dev = 'cuda'
wavs = np.load(f'{ROOT}/wavs_16k.npy')

for mid, tag in [('MIT/ast-finetuned-audioset-12-12-0.447', 'ast1212'),
                 ('MIT/ast-finetuned-audioset-14-14-0.443', 'ast1414')]:
    fe = ASTFeatureExtractor.from_pretrained(mid)
    model = ASTModel.from_pretrained(mid).to(dev).eval()
    clf = ASTForAudioClassification.from_pretrained(mid).to(dev).eval()
    ms, mx, pr = [], [], []
    t0 = time.time()
    with torch.no_grad():
        for i in range(0, len(wavs), 8):
            inp = fe(list(wavs[i:i+8]), sampling_rate=16000, return_tensors='pt')['input_values'].to(dev)
            with torch.autocast('cuda', dtype=torch.float16):
                h = model(inp).last_hidden_state
                logits = clf(inp).logits
            ms.append(h.mean(1).float().cpu().numpy()); mx.append(h.max(1).values.float().cpu().numpy())
            pr.append(torch.sigmoid(logits.float()).cpu().numpy())
    E = np.concatenate(ms); X = np.concatenate(mx); Q = np.concatenate(pr)
    np.savez_compressed(f'{ROOT}/{tag}.npz', mean=E, max=X, probs=Q)
    print(tag, E.shape, Q.shape, f'{time.time()-t0:.0f}s', flush=True)
