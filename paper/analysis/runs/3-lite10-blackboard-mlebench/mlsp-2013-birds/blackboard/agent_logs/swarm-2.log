import os, numpy as np, pandas as pd, torch, timm, time
from PIL import Image
ROOT = '/download_job_code/payload/sandbox/workspaces/pollux_epsilon'
SUP = '/download_job_code/payload/sandbox/data/supplemental_data'
dev = 'cuda'
df = pd.read_csv('/download_job_code/payload/sandbox/data/essential_data/rec_id2filename.txt').sort_values('rec_id').reset_index(drop=True)
model = timm.create_model('convnext_tiny.in12k_ft_in1k', pretrained=True, num_classes=0).to(dev).eval()
tf = timm.data.create_transform(input_size=(224, 768), is_training=False, mean=(0.5,)*3, std=(0.5,)*3)

for folder, tag in [('spectrograms', 'specimg'), ('filtered_spectrograms', 'fspecimg')]:
    feats = []; t0 = time.time()
    with torch.no_grad():
        batch = []
        for fn in df.filename:
            p = f'{SUP}/{folder}/{fn}.bmp'
            im = Image.open(p).convert('RGB')
            batch.append(tf(im))
            if len(batch) == 16:
                x = torch.stack(batch).to(dev)
                with torch.autocast('cuda', dtype=torch.float16):
                    feats.append(model(x).float().cpu().numpy())
                batch = []
        if batch:
            x = torch.stack(batch).to(dev)
            with torch.autocast('cuda', dtype=torch.float16):
                feats.append(model(x).float().cpu().numpy())
    F = np.concatenate(feats)
    np.save(f'{ROOT}/{tag}_feats.npy', F)
    print(tag, F.shape, f'{time.time()-t0:.0f}s', flush=True)
