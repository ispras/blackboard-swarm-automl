        rm=np.isin(np.repeat(np.arange(258),19),rr); vm=np.isin(np.repeat(np.arange(258),19),va)
        m=LogisticRegression(C=C,max_iter=3000).fit(Xa[rm],y[rm])
        P[vm]=m.predict_proba(Xa[vm])[:,1]
    return roc_auc_score(y,P),P
