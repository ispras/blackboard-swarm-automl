ROOT = '/download_job_code/payload/sandbox/workspaces/pollux_epsilon'
d = np.load(f'{ROOT}/feats.npz')
ids, hist, mil, Y, split, tm = (d[k] for k in ['ids','hist','mil','Y','split','train_mask'])
a = np.load(f'{ROOT}/ast_emb.npz'); lg = np.load(f'{ROOT}/ast_logits.npz')
tr = np.where(tm)[0]; te = np.where(split == 1)[0]
folds = np.load('/download_job_code/payload/sandbox/workspaces/altair_gamma/folds_5x_seed42.npy')
Ytr = Y[tr]

Amean, Amax, Astd = a['mean'], a['max'], a['std']
L = lg['probs']
def l2n(x): return x / (np.linalg.norm(x, axis=1, keepdims=True) + 1e-8)
FE = {
 'ast_mean': Amean,
 'ast_meanmaxstd': np.hstack([Amean, Amax, Astd]),
 'ast_logits': L,
 'ast_logmean': np.hstack([L, Amean]),
 'ast_histmil': np.hstack([Amean, hist, mil]),
 'ast_log_histmil': np.hstack([np.log1p(L), hist, mil]),
 'ast_full': np.hstack([Amean, Amax, Astd, np.log1p(L), hist, mil]),
}

def et(): return ExtraTreesClassifier(500, max_features='sqrt', min_samples_leaf=1, n_jobs=16, random_state=0)
def lr(C=0.05): return LogisticRegression(C=C, max_iter=3000)
def mlp(): return MLPClassifier((256,), alpha=1e-2, max_iter=600, early_stopping=False, random_state=0)

def oof(make, X, std=False):
    P = np.zeros_like(Ytr)
    for f in range(5):
        va = np.where(folds == f)[0]; trn = np.where(folds != f)[0]
        A, B = X[tr][trn], X[tr][va]
        if std:
            sc = StandardScaler().fit(A); A, B = sc.transform(A), sc.transform(B)
        for j in range(19):
            y = Ytr[trn, j]
            if y.sum() == 0: continue
            m = make(); m.fit(A, y)
            P[va, j] = m.predict_proba(B)[:, 1]
    return P

def rep(name, make, key, std=False, store=True):
    P = oof(make, FE[key], std)
    auc = roc_auc_score(Ytr.ravel(), P.ravel())
    print(f'{name:28s} {key:18s} gAUC={auc:.4f}', flush=True)
    if store:
        np.save(f'{ROOT}/preds/oof_{name}.npy', P)
    return auc, P

res = {}
res['et_mean'] = rep('et_astmean', et, 'ast_mean')[0]
res['et_full'] = rep('et_astfull', et, 'ast_full')[0]
res['et_logmean'] = rep('et_astlogmean', et, 'ast_logmean')[0]
res['et_histmil'] = rep('et_asthistmil', et, 'ast_histmil')[0]
res['lr_mean_std'] = rep('lr_astmean', lambda: lr(0.05), 'ast_mean', std=True)[0]
res['lr_full_std'] = rep('lr_astfull', lambda: lr(0.05), 'ast_full', std=True)[0]
res['lr_log_histmil'] = rep('lr_astloghistmil', lambda: lr(0.02), 'ast_log_histmil', std=True)[0]
res['mlp_mean'] = rep('mlp_astmean', mlp, 'ast_mean', std=True)[0]
res['lgbm_loghist'] = rep('lgbm_astloghistmil', lambda: lgb.LGBMClassifier(n_estimators=300, learning_rate=0.03, num_leaves=7, min_child_samples=8, subsample=0.8, colsample_bytree=0.4, reg_lambda=1.0, n_jobs=8, verbose=-1), 'ast_log_histmil')[0]
json.dump(res, open(f'{ROOT}/cv_ast.json', 'w'), indent=1)
