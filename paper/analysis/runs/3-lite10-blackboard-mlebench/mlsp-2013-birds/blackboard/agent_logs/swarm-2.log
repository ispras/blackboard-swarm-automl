A2 = np.load(f'{R}/pollux_beta/features_audio2.npz'); A2 = A2['X'][np.argsort(A2['ids'])]
P1 = PCA(64, random_state=0).fit_transform(StandardScaler().fit_transform(A1))
P2 = PCA(96, random_state=0).fit_transform(StandardScaler().fit_transform(A2))
X = np.hstack([BASE, EMBp, CLAPp, LOG[:, logidx], FULL[:, bnidx], BNS, P1, P2]).astype(np.float32)
print('X', X.shape)
'''
body='''
class MLP(nn.Module):
    def __init__(self, d, h1=384, h2=192, p=0.5):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(d, h1), nn.BatchNorm1d(h1), nn.GELU(), nn.Dropout(p),
                                 nn.Linear(h1, h2), nn.BatchNorm1d(h2), nn.GELU(), nn.Dropout(p*0.8),
                                 nn.Linear(h2, 19))
    def forward(self, x): return self.net(x)

def train_one(Xtr, ytr, Xte, seed, epochs=220, mixup=0.4):
    torch.manual_seed(seed); np.random.seed(seed)
    m = MLP(Xtr.shape[1]); opt = torch.optim.AdamW(m.parameters(), lr=1.2e-3, weight_decay=3e-3)
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, epochs); lossf = nn.BCEWithLogitsLoss()
    Xt = torch.tensor(Xtr, dtype=torch.float32); yt = torch.tensor(ytr, dtype=torch.float32); n = len(Xt)
    for ep in range(epochs):
        m.train(); perm = torch.randperm(n)
        for i in range(0, n, 32):
            idx = perm[i:i+32]; xb, yb = Xt[idx], yt[idx]
            lam = float(np.random.beta(mixup, mixup)); ridx = torch.randperm(len(idx))
            xb = lam*xb + (1-lam)*xb[ridx]; yb = lam*yb + (1-lam)*yb[ridx]
            opt.zero_grad(); loss = lossf(m(xb), yb); loss.backward(); opt.step()
        sched.step()
    m.eval()
    with torch.no_grad(): return torch.sigmoid(m(torch.tensor(Xte, dtype=torch.float32))).numpy()

def run(name, seeds=range(5)):
    P = np.zeros((len(tr), 19)); T = np.zeros((len(te), 19))
    for k in range(5):
        va = np.where(folds == k)[0]; trn = np.where(folds != k)[0]
        tri = tr[trn]; vai = tr[va]
        Xtr = np.hstack([X[tri], M.neighbor_loo(tri)]); Xva = np.hstack([X[vai], M.neighbor_between(vai, tri)])
        Xte = np.hstack([X[te], M.neighbor_between(te, tri)])
        sc = StandardScaler().fit(Xtr); Xtr = sc.transform(Xtr); Xva = sc.transform(Xva); Xte = sc.transform(Xte)
        for s in seeds: P[va] += train_one(Xtr, Y[trn], Xva, 100*s+k)/len(seeds)
        for s in seeds: T += train_one(Xtr, Y[trn], Xte, 100*s+k)/(5*len(seeds))
        print(name, 'fold', k, 'done', flush=True)
    auc = roc_auc_score(Y.ravel(), P.ravel())
    np.save(f'{R}/pollux_beta/preds/oof_{name}.npy', P); np.save(f'{R}/pollux_beta/preds/test_{name}.npy', T)
    print(name, 'OOF', round(auc, 4), flush=True); return auc

if __name__ == '__main__':
    t=time.time(); a=run('mlp_bnfull_mixup'); json.dump({'mlp_bnfull_mixup':a}, open(f'{R}/pollux_beta/preds/mlp4_meta.json','w')); print('total',time.time()-t)
'''
open('workspaces/pollux_beta/train_mlp4.py','w').write(head+body)
print('written')
