def E(p): p=np.clip(p,1e-6,1-1e-6); return np.log(p/(1-p))
def load(n):
    for ws in ['pollux_epsilon','altair_gamma','pollux_beta']:
        f=f'workspaces/{ws}/preds/oof_{n}.npy'
        if os.path.exists(f): return np.load(f)
