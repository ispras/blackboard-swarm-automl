import os, sys, glob, json
import numpy as np, pandas as pd
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import log_loss
ROOT='/download_job_code/payload/sandbox'
tr=pd.read_csv(ROOT+'/data/train.csv'); te=pd.read_csv(ROOT+'/data/test.csv')
y=tr.author.map({'EAP':0,'HPL':1,'MWS':2}).values
folds=list(StratifiedKFold(5,shuffle=True,random_state=42).split(tr,y))
OUT=ROOT+'/workspaces/achernar_kappa/preds'
tag=sys.argv[1]
oof=np.zeros((len(tr),3)); tep=np.zeros((len(te),3)); done=[]; fs={}
for k in range(5):
    f=f'{OUT}/foldpred_{tag}_{k}.npz'
    if not os.path.exists(f): continue
    d=np.load(f); ti,vi=folds[k]
    assert np.array_equal(np.sort(d['va']),np.sort(vi)), (k,'va mismatch')
    oof[vi]=d['va_pred']; tep+=d['te_pred']; done.append(k)
    fs[str(k)]=float(log_loss(y[vi],d['va_pred'],labels=[0,1,2]))
tep/=max(len(done),1)
ll=float(log_loss(y,oof,labels=[0,1,2])) if len(done)==5 else float('nan')
np.save(f'{OUT}/oof_{tag}.npy',oof); np.save(f'{OUT}/test_{tag}.npy',tep)
json.dump({'tag':tag,'folds_done':done,'fold_scores':fs,'oof_ll':ll},open(f'{OUT}/meta_{tag}.json','w'),indent=1)
print('rebuilt',tag,'done',done,'oof_ll',ll,'folds',fs)
EOF
