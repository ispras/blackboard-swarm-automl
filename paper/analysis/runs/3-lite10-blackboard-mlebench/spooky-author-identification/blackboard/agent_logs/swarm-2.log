        steps=len(tr_dl)*args.epochs
        sch=get_linear_schedule_with_warmup(opt,int(0.1*steps),steps)
        scaler=torch.cuda.amp.GradScaler(enabled=(device=='cuda'))
        best=1e9; best_o=None; best_t=None
        for ep in range(args.epochs):
