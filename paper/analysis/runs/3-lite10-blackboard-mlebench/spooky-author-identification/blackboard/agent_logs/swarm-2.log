import numpy as np, pandas as pd, glob, os, warnings
warnings.filterwarnings('ignore')
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
ROOT='/download_job_code/payload/sandbox'
TR=pd.read_csv(f'{ROOT}/data/train.csv'); TE=pd.read_csv(f'{ROOT}/data/test.csv')
y=TR['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
EXC=['dv3l_s555','bertlargec_full']
pairs={}
for f in glob.glob(f'{ROOT}/workspaces/*/preds/oof_*.npy')+glob.glob(f'{ROOT}/workspaces/*/oof_*.npy'):
    name=os.path.basename(f)[4:-4]; d=os.path.dirname(f); tf=os.path.join(d,'test_'+name+'.npy')
    if not os.path.exists(tf): continue
    if any(s in name.lower() for s in ['stack','cand','blend','submission','meta']): continue
    if any(x in name for x in EXC): continue
    agent=d.split('/workspaces/')[1].split('/')[0]; key=f'{agent}:{name}'
    o=np.load(f); t=np.load(tf)
    if o.shape!=(len(TR),3) or t.shape!=(len(TE),3): continue
    if not np.isfinite(o).all() or not np.isfinite(t).all(): continue
    if (o.sum(1)<0.5).any() or (t.sum(1)<0.5).any(): continue
    if ((o.max(1)-o.min(1))<1e-9).mean()>0.01: continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True); t=np.clip(t,1e-12,1); t=t/t.sum(1,keepdims=True)
    pairs[key]=(o,t)
scores={k:log_loss(y,o) for k,(o,t) in pairs.items()}
keys=[k for k in sorted(scores,key=scores.get) if scores[k]<0.65]
def build(ks):
    O=np.stack([pairs[k][0] for k in ks]); T=np.stack([pairs[k][1] for k in ks])
    Z=np.concatenate([np.log(O),O],axis=2).transpose(1,0,2).reshape(len(TR),-1)
    Zt=np.concatenate([np.log(T),T],axis=2).transpose(1,0,2).reshape(len(TE),-1)
    return Z,Zt
def bagged(Z,Zt,seed=7,nbag=20):
    rng=np.random.RandomState(seed); P=np.zeros((len(TE),3))
    for b in range(nbag):
        idx=rng.permutation(len(TR))[:int(0.8*len(TR))]
        P+=LogisticRegression(C=0.01,max_iter=1000).fit(Z[idx],y[idx]).predict_proba(Zt)
    P/=nbag; P=np.clip(P,1e-15,1); return P/P.sum(1,keepdims=True)
Z,Zt=build(keys); base=bagged(Z,Zt)
# nested oof for bootstrap
skf=StratifiedKFold(5,shuffle=True,random_state=100); oof=np.zeros((len(TR),3))
for ti,vi in skf.split(Z,y):
    oof[vi]=LogisticRegression(C=0.01,max_iter=1000).fit(Z[ti],y[ti]).predict_proba(Z[vi])
ls=-np.log(np.clip(oof[np.arange(len(y)),y],1e-15,1))
print('nested OOF ll=%.5f  per-sample loss mean=%.5f sd=%.5f se=%.5f'%(log_loss(y,oof),ls.mean(),ls.std(),ls.std()/np.sqrt(len(ls))))
rng=np.random.RandomState(0); boots=[ls[rng.randint(0,len(ls),1958)].mean() for _ in range(2000)]
print('bootstrap 95%% CI for 1958-row test: [%.4f, %.4f]'%(np.percentile(boots,2.5),np.percentile(boots,97.5)))
# leave-one-top-model-out test sensitivity
print('\nleave-one-out (top models): mean|dP| vs full, argmax agree')
top=keys[:8]
for k in top:
    ks2=[x for x in keys if x!=k]; Z2,Zt2=build(ks2); P2=bagged(Z2,Zt2)
    print(f'  drop {k:38s} mean|dP|={np.abs(P2-base).mean():.4f} agree={(P2.argmax(1)==base.argmax(1)).mean():.3f}')
EOF
