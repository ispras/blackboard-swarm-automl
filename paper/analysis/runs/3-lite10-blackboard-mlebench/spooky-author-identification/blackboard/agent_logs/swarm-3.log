import numpy as np, pandas as pd, glob, os, warnings
warnings.filterwarnings('ignore')
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
ROOT='/download_job_code/payload/sandbox'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
pairs={}
for f in glob.glob(f'{ROOT}/workspaces/*/preds/oof_*.npy')+glob.glob(f'{ROOT}/workspaces/*/oof_*.npy'):
    name=os.path.basename(f)[4:-4]; d=os.path.dirname(f); tf=os.path.join(d,'test_'+name+'.npy')
    if not os.path.exists(tf): continue
    if any(s in name.lower() for s in ['stack','cand','blend','submission','meta','final']): continue
    agent=d.split('/workspaces/')[1].split('/')[0]
    o=np.load(f)
    if o.shape!=(len(tr),3) or not np.isfinite(o).all(): continue
    if (o.sum(1)<0.5).any(): continue
    if ((o.max(1)-o.min(1))<1e-9).mean()>0.01: continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True); pairs[f'{agent}:{name}']=o
sc={k:log_loss(y,o) for k,o in pairs.items()}
keys=[k for k in sorted(sc,key=sc.get) if sc[k]<0.65]
O=np.stack([pairs[k] for k in keys])
Zb=np.concatenate([np.log(O),O],axis=2).transpose(1,0,2).reshape(len(tr),-1)
Zl=np.log(O).transpose(1,0,2).reshape(len(tr),-1)
Zpr=O.transpose(1,0,2).reshape(len(tr),-1)
cfgs={'b.01':(Zb,0.01),'b.03':(Zb,0.03),'l.01':(Zl,0.01),'p.3':(Zpr,0.3)}
def run(Z,C,seed):
    skf=StratifiedKFold(5,shuffle=True,random_state=seed); oof=np.zeros((len(tr),3))
    for ti,vi in skf.split(Z,y):
        m=LogisticRegression(C=C,max_iter=1000).fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
    return oof
for seed in [100,101,102]:
    oofs={n:run(Z,C,seed) for n,(Z,C) in cfgs.items()}
    base={n:log_loss(y,o) for n,o in oofs.items()}
    avg_b=log_loss(y,(oofs['b.01']+oofs['b.03'])/2)
    avg_all=log_loss(y,(oofs['b.01']+oofs['b.03']+oofs['l.01'])/3)
    print('seed',seed,{k:round(v,4) for k,v in base.items()},'bavg',round(avg_b,4),'avg3',round(avg_all,4),flush=True)
EOF
