print('pool',len(allkeys),flush=True)
def ev(keys,C,seeds=(42,100,101,102,103)):
    O=np.stack([pairs[k] for k in keys])
    Z=np.concatenate([np.log(O),O],axis=2).transpose(1,0,2).reshape(len(tr),-1)
    lls=[]
    for s in seeds:
        skf=StratifiedKFold(5,shuffle=True,random_state=s); oof=np.zeros((len(tr),3))
        for ti,vi in skf.split(Z,y):
            m=LogisticRegression(C=C,max_iter=1000).fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
        lls.append(log_loss(y,oof))
    return np.mean(lls),np.std(lls)
variants={
 'all':allkeys,
 'no_s555':[k for k in allkeys if 's555' not in k],
 'no_s555_no_bertlargec':[k for k in allkeys if 's555' not in k and 'bertlargec' not in k],
 'no_bertlargec':[k for k in allkeys if 'bertlargec' not in k],
}
for nm,keys in variants.items():
