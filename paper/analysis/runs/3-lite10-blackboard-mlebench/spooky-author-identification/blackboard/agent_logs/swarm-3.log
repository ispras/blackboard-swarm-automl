import numpy as np, pandas as pd, glob, os, warnings
warnings.filterwarnings('ignore')
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
from scipy.optimize import minimize_scalar
ROOT='/download_job_code/payload/sandbox'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
pairs={}
for f in glob.glob(f'{ROOT}/workspaces/*/preds/oof_*.npy')+glob.glob(f'{ROOT}/workspaces/*/oof_*.npy'):
    name=os.path.basename(f)[4:-4]; d=os.path.dirname(f); tf=os.path.join(d,'test_'+name+'.npy')
    if not os.path.exists(tf): continue
    if any(s in name.lower() for s in ['stack','cand','blend','submission','meta']): continue
    agent=d.split('/workspaces/')[1].split('/')[0]
    o=np.load(f)
    if o.shape!=(len(tr),3) or not np.isfinite(o).all(): continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True); pairs[f'{agent}:{name}']=o
scores={k:log_loss(y,o) for k,o in pairs.items()}
keys=[k for k in sorted(scores,key=scores.get) if scores[k]<0.65]
Z=np.log(np.stack([pairs[k] for k in keys])).transpose(1,0,2).reshape(len(tr),-1)
skf=StratifiedKFold(5,shuffle=True,random_state=100)
oof=np.zeros((len(tr),3))
for ti,vi in skf.split(Z,y):
    m=LogisticRegression(C=0.3,max_iter=1000).fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
print('base nested',round(log_loss(y,oof),4))
def temp(T):
    p=np.clip(oof,1e-15,1)**T; p/=p.sum(1,keepdims=True); return log_loss(y,p)
for T in [0.8,0.9,1.0,1.1,1.2,1.5]:
    print('T',T,round(temp(T),4))
# prior shift toward train prior
prior=np.bincount(y)/len(y)
def prior_shift(alpha):
    p=oof/prior**alpha; p/=p.sum(1,keepdims=True); return log_loss(y,p)
for a in [0,0.1,0.2,0.5]:
    print('prior alpha',a,round(prior_shift(a),4))
print('pred dist',oof.mean(0),'train prior',prior)
EOF
