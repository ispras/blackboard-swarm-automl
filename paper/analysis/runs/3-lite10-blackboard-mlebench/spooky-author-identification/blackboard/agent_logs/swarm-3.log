import numpy as np, pandas as pd, glob, os, warnings
warnings.filterwarnings('ignore')
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
ROOT='/download_job_code/payload/sandbox'; DATA=f'{ROOT}/data'
tr=pd.read_csv(f'{DATA}/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
pairs={}
for f in glob.glob(f'{ROOT}/workspaces/*/preds/oof_*.npy')+glob.glob(f'{ROOT}/workspaces/*/oof_*.npy'):
    name=os.path.basename(f)[4:-4]; d=os.path.dirname(f); tf=os.path.join(d,'test_'+name+'.npy')
    if not os.path.exists(tf): continue
    agent=d.split('/workspaces/')[1].split('/')[0]; key=f'{agent}:{name}'
    o=np.load(f); 
    if o.shape!=(len(tr),3) or not np.isfinite(o).all(): continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True)
    pairs[key]=o
scores={k:log_loss(y,o) for k,o in pairs.items()}
order=sorted(scores,key=scores.get)
def stack(keys,C=1.0,seed=42):
    Z=np.log(np.stack([pairs[k] for k in keys])).transpose(1,0,2).reshape(len(tr),-1)
    skf=StratifiedKFold(5,shuffle=True,random_state=seed); oof=np.zeros((len(tr),3))
    for ti,vi in skf.split(Z,y):
        m=LogisticRegression(C=C,max_iter=1000); m.fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
    return log_loss(y,oof), (oof.argmax(1)==y).mean()
for N in [1,3,5,8,12,20,30,len(order)]:
    keys=order[:N]; ll,acc=stack(keys)
    avg=np.mean([pairs[k] for k in keys],axis=0)
    print(f'N={N:2d} stack={ll:.4f} acc={acc:.4f} simpleavg={log_loss(y,avg):.4f}')
# seed-42 leave-base-fold-out stack with all
print('done')
EOF
