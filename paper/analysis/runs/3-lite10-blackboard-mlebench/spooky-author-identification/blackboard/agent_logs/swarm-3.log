    if mode=='log': Z=np.log(O).transpose(1,0,2).reshape(len(tr),-1)
    elif mode=='prob': Z=O.transpose(1,0,2).reshape(len(tr),-1)
    else: Z=np.concatenate([np.log(O),O],axis=2).transpose(1,0,2).reshape(len(tr),-1)
    lls=[]
    for r in range(4):
        skf=StratifiedKFold(5,shuffle=True,random_state=100+r); oof=np.zeros((len(tr),3))
        for ti,vi in skf.split(Z,y):
            m=LogisticRegression(C=C,max_iter=1000).fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
        lls.append(log_loss(y,oof))
    return np.mean(lls),np.std(lls)
for mode in ['log','both']:
    for C in [0.01,0.03,0.05,0.1]:
        mu,sd=ev(mode,C); print(f'{mode} C={C}: {mu:.4f} +- {sd:.4f}',flush=True)
