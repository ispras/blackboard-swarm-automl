    agent=d.split('/workspaces/')[1].split('/')[0]
    o=np.load(f)
    if o.shape!=(len(tr),3) or not np.isfinite(o).all(): continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True); pairs[f'{agent}:{name}']=o
scores={k:log_loss(y,o) for k,o in pairs.items()}
keys=[k for k in sorted(scores,key=scores.get) if scores[k]<0.65]
V=np.stack([pairs[k].ravel() for k in keys])
C=np.corrcoef(V)
keep=[]
for i,k in enumerate(keys):
    if all(abs(C[i,j])<0.9995 for j in keep): keep.append(i)
print('before',len(keys),'after dedupe',len(keep))
def ev(idxs,Cc):
    Z=np.log(np.stack([pairs[keys[i]] for i in idxs])).transpose(1,0,2).reshape(len(tr),-1)
    lls=[]
    for r in range(3):
        skf=StratifiedKFold(5,shuffle=True,random_state=100+r); oof=np.zeros((len(tr),3))
        for ti,vi in skf.split(Z,y):
            m=LogisticRegression(C=Cc,max_iter=1000).fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
        lls.append(log_loss(y,oof))
    return np.mean(lls)
print('all C.05',round(ev(list(range(len(keys))),0.05),4))
print('dedupe C.05',round(ev(keep,0.05),4))
print('dedupe C.1',round(ev(keep,0.1),4))
EOF
