import numpy as np, pandas as pd, string
tr=pd.read_csv('data/train.csv'); te=pd.read_csv('data/test.csv')
stops=set('a an the and or but if while of to in on at by for with as is are was were be been being it its this that these those he she they him her them his hers their i you we my your our not no so do does did have has had from there here what which who whom will would can could may might must shall should about into over under than then them such other more most some any all'.split())
def style(t):
    words=t.split(); nw=len(words); nc=len(t); low=t.lower(); ws=[len(w) for w in words] or [0]
    f=[nw,nc,np.mean(ws),max(ws),len(set(low.split()))/max(nw,1),sum(w in stops for w in low.split())/max(nw,1),
       sum(c.isupper() for c in t)/max(nc,1),sum(c.isdigit() for c in t)/max(nc,1),sum(c in string.punctuation for c in t)/max(nc,1)]
    for ch in [',',';',':','!','?','"',"'",'-','.']: f.append(t.count(ch)/max(nc,1))
    f+=[(t.count('"')+t.count("'"))/max(nw,1),t.count(',')/max(nw,1),t.count(';')/max(nw,1),t.count('!')/max(nw,1),
        sum(w.isupper() and len(w)>1 for w in words)/max(nw,1),sum(x>15 for x in ws)/max(nw,1)]
    return f
np.save('workspaces/aldebaran_xi/style_train.npy',np.array([style(t) for t in tr['text']],dtype=np.float32))
np.save('workspaces/aldebaran_xi/style_test.npy',np.array([style(t) for t in te['text']],dtype=np.float32))
print('saved')
EOF
