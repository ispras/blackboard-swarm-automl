import numpy as np, pandas as pd, glob, os, warnings
warnings.filterwarnings('ignore')
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
ROOT='/download_job_code/payload/sandbox'
tr=pd.read_csv(f'{ROOT}/data/train.csv'); y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
pairs={}
for f in glob.glob(f'{ROOT}/workspaces/*/preds/oof_*.npy')+glob.glob(f'{ROOT}/workspaces/*/oof_*.npy'):
    name=os.path.basename(f)[4:-4]; d=os.path.dirname(f); tf=os.path.join(d,'test_'+name+'.npy')
    if not os.path.exists(tf): continue
    if any(s in name.lower() for s in ['stack','cand','blend','submission','meta','final']): continue
    agent=d.split('/workspaces/')[1].split('/')[0]
    o=np.load(f)
    if o.shape!=(len(tr),3) or not np.isfinite(o).all(): continue
