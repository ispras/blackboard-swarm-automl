import numpy as np, pandas as pd, glob, os, warnings, sys
warnings.filterwarnings('ignore')
from sklearn.metrics import log_loss
from sklearn.model_selection import StratifiedKFold
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
ROOT='/download_job_code/payload/sandbox'; DATA=f'{ROOT}/data'
tr=pd.read_csv(f'{DATA}/train.csv'); te=pd.read_csv(f'{DATA}/test.csv')
y=tr['author'].map({'EAP':0,'HPL':1,'MWS':2}).values
pairs={}
for f in glob.glob(f'{ROOT}/workspaces/*/preds/oof_*.npy')+glob.glob(f'{ROOT}/workspaces/*/oof_*.npy'):
    name=os.path.basename(f)[4:-4]; d=os.path.dirname(f); tf=os.path.join(d,'test_'+name+'.npy')
    if not os.path.exists(tf): continue
    agent=d.split('/workspaces/')[1].split('/')[0]; key=f'{agent}:{name}'
    o=np.load(f); t=np.load(tf)
    if o.shape!=(len(tr),3) or t.shape!=(len(te),3) or not np.isfinite(o).all() or not np.isfinite(t).all(): continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True); t=np.clip(t,1e-12,1); t=t/t.sum(1,keepdims=True)
    pairs[key]=(o,t)
scores={k:log_loss(y,o) for k,(o,t) in pairs.items()}
order=sorted(scores,key=scores.get)
S=np.load(f'{ROOT}/workspaces/aldebaran_xi/style_train.npy'); St=np.load(f'{ROOT}/workspaces/aldebaran_xi/style_test.npy')
sc=StandardScaler().fit(S); S=sc.transform(S); St=sc.transform(St)
print('pool',len(order),flush=True)

def feats(keys,mode):
    O=np.stack([pairs[k][0] for k in keys]); T=np.stack([pairs[k][1] for k in keys])
    Zl=np.log(O).transpose(1,0,2).reshape(len(tr),-1); Ztl=np.log(T).transpose(1,0,2).reshape(len(te),-1)
    if mode=='log': return Zl,Ztl
    if mode=='log+style': return np.hstack([Zl,S]),np.hstack([Ztl,St])
    if mode=='log+style+len': return np.hstack([Zl,S]),np.hstack([Ztl,St])

def nested(Z,C,reps=2):
    lls=[]
    for r in range(reps):
        skf=StratifiedKFold(5,shuffle=True,random_state=100+r); oof=np.zeros((len(tr),3))
        for ti,vi in skf.split(Z,y):
            m=LogisticRegression(C=C,max_iter=1000).fit(Z[ti],y[ti]); oof[vi]=m.predict_proba(Z[vi])
        lls.append(log_loss(y,oof))
    return float(np.mean(lls)),float(np.std(lls))

for cutoff in [0.55,0.65,9.9]:
    keys=[k for k in order if scores[k]<cutoff]
    for mode in ['log','log+style']:
        Z,Zt=feats(keys,mode)
        for C in [0.3,1.0]:
            mu,sd=nested(Z,C)
            print(f'cut={cutoff} n={len(keys)} mode={mode} C={C}: {mu:.4f} +- {sd:.4f}',flush=True)
EOF
