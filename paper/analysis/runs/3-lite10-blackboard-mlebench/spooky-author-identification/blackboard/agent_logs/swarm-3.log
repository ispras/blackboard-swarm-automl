    if ((o.max(1)-o.min(1))<1e-9).mean()>0.01: continue
    o=np.clip(o,1e-12,1); o=o/o.sum(1,keepdims=True); pairs[f'{agent}:{name}']=o
sc={k:log_loss(y,o) for k,o in pairs.items()}
